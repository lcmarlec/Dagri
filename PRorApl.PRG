      DO GX_CSC01
      IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P04049" , @HStmt_P04049 )
         Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PRORAPL","P04049","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P04049) ,  ,  ,  , CS_SQLSRV ,  )
