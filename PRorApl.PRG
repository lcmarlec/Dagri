         cmdbuf = cmdbuf + "  [DcCRORNro], [DcCRORULin]) VALUES (?, ?, ?, ' ', convert(int, 0), convert(int, 0), "
         cmdbuf = cmdbuf + "  convert(int, 0)) "
         Gx_err = GX_DB_Set_StmtCmdText( HStmt_P04048,cmdbuf)
         GX_DB_BindParmP04048_01 ()
      ENDIF
      Gx_err = GX_DB_SetInt( HStmt_P04048,1,@R2EmpCod,0)
      Gx_err = GX_DB_SetDouble( HStmt_P04048,2,@R346DcCNro,0)
