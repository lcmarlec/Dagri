         cmdbuf = cmdbuf + "  = ? "
         Gx_err = GX_DB_Set_StmtCmdText( HStmt_P04049,cmdbuf)
         GX_DB_BindParmP04049_01 ()
      ENDIF
      Gx_err = GX_DB_SetStr( HStmt_P04049,1,R348DcCTip,4,0)
