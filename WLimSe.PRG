      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00712" , @HStmt_W00712 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLIMSE","W00712","",GX_CURSOR_TYPE_READONLY,@HStmt_W00712) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[BcoCod], T1.[BcoCta], T1.[BcoSld], T1.[BcoMax], T1.[BcoFHa], T1.[BcoFDe], "
                  cmdbuf = cmdbuf + "  T2.[BcoDir], T2.[BcoSuc], T3.[BcoDsc] FROM (([BANCOS2] T1 (NOLOCK) LEFT JOIN [CTAS] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[BcoCta] = T1.[BcoCta]) LEFT JOIN [BANCOS] T3 (NOLOCK) ON T3.[BcoCod] "
                  cmdbuf = cmdbuf + "  = T2.[BcoCod]) WHERE T1.[BcoCta] = ? and T1.[BcoFDe] >= ? ORDER BY T1.[BcoCta]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00712,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00712,14)
                  THISFORM.GX_DB_BindColsW00712_01 ()
                  THISFORM.GX_DB_BindParmW00712_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00712,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxAV11Desde = THISFORM.AV11Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00712,2,@AuxAV11Desde,0)
               THISFORM.AV11Desde = AuxAV11Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00712) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00712 = Gx_err
               THISFORM.GX_DB_GetW00712_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV21Pgmnam = "WLimSe"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00712 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00712) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00712 = Gx_err
                  THISFORM.GX_DB_GetW00712_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00712 <> 101
               BRKV1Z2 = .F.
               THISFORM.AV16Difere = 0.00
               THISFORM.A85BcoSld = THISFORM.Buf_W00712_85BcoSld
               THISFORM.A84BcoMax = THISFORM.Buf_W00712_84BcoMax
               THISFORM.A83BcoFHa = THISFORM.Buf_W00712_83BcoFHa
               THISFORM.A82BcoFDe = THISFORM.Buf_W00712_82BcoFDe
               THISFORM.A79BcoDir = THISFORM.Buf_W00712_79BcoDir
               THISFORM.A78BcoSuc = THISFORM.Buf_W00712_78BcoSuc
               THISFORM.A87BcoDsc = THISFORM.Buf_W00712_87BcoDsc
               THISFORM.A79BcoDir = THISFORM.Buf_W00712_79BcoDir
               THISFORM.A78BcoSuc = THISFORM.Buf_W00712_78BcoSuc
               THISFORM.A87BcoDsc = THISFORM.Buf_W00712_87BcoDsc
               GX_SFLOAD = 0
               THISFORM.U17V1Z2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00712) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00712 = Gx_err
               THISFORM.GX_DB_GetW00712_01 ()
            ENDDO
         ENDIF
      ENDPROC
