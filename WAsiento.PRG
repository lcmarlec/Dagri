      PROCEDURE CreateTemp
         LOCAL SCW438S11
         SCW438S11 = ""
         IF USED( "SCW438S11" )
            SELECT SCW438S11
            SCW438S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW438S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA1345AsiN"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1347AsiT"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1348AsiF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1360AsiD"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 14
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA1361AsiH"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 14
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "sA1352AsiE"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA1344AsiC"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 3
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW438S11 = GETE('z:\temp') + '\' + SCW438S11
            ENDIF
            CREATE DBF (SCW438S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW438S11) EXCLUSIVE ALIAS SCW438S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW438S11
         THIS.GX_SfAlias = "SCW438S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04382" , @HStmt_W04382 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WASIENTO","W04382","",GX_CURSOR_TYPE_READONLY,@HStmt_W04382) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AsiNroInt], [EmpCod], [EjeNro], [AsiCod], [AsiEst], [AsiFch], [AsiTit], [AsiNro] "
                  cmdbuf = cmdbuf + "  FROM [ASIEN] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EjeNro] = ? and [AsiNro] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([AsiCod] = ? or ? = 999) AND ([AsiFch] >= ?) AND ([AsiFch] <= ? or ? "
                  cmdbuf = cmdbuf + "  = convert( DATETIME, '17530101', 112 )) ORDER BY [EmpCod], [EjeNro], [AsiNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04382,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04382,13)
                  THISFORM.GX_DB_BindColsW04382_01 ()
                  THISFORM.GX_DB_BindParmW04382_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04382,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA548EjeNro = THISFORM.A548EjeNro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04382,2,@AuxA548EjeNro,0)
               THISFORM.A548EjeNro = AuxA548EjeNro
               AuxAV21Asient = THISFORM.AV21Asient
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04382,3,@AuxAV21Asient,0)
               THISFORM.AV21Asient = AuxAV21Asient
               AuxAV26Tipo = THISFORM.AV26Tipo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04382,4,@AuxAV26Tipo,0)
               THISFORM.AV26Tipo = AuxAV26Tipo
               AuxAV26Tipo = THISFORM.AV26Tipo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04382,5,@AuxAV26Tipo,0)
               THISFORM.AV26Tipo = AuxAV26Tipo
               AuxAV27Asifch = THISFORM.AV27Asifch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04382,6,@AuxAV27Asifch,0)
               THISFORM.AV27Asifch = AuxAV27Asifch
               AuxAV28Asifch = THISFORM.AV28Asifch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04382,7,@AuxAV28Asifch,0)
               THISFORM.AV28Asifch = AuxAV28Asifch
               AuxAV28Asifch = THISFORM.AV28Asifch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04382,8,@AuxAV28Asifch,0)
               THISFORM.AV28Asifch = AuxAV28Asifch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04382) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04382 = Gx_err
               THISFORM.GX_DB_GetW04382_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV37Pgmnam = "WAsiento"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04382 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04382) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04382 = Gx_err
                  THISFORM.GX_DB_GetW04382_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04382 <> 101
               BRKVC62 = .F.
               THISFORM.A1346AsiNr = THISFORM.Buf_W04382_1346AsiNroInt
               THISFORM.A1344AsiCo = THISFORM.Buf_W04382_1344AsiCod
               THISFORM.A1352AsiEs = THISFORM.Buf_W04382_1352AsiEst
               THISFORM.A1348AsiFc = THISFORM.Buf_W04382_1348AsiFch
               THISFORM.A1347AsiTi = THISFORM.Buf_W04382_1347AsiTit
               THISFORM.A1345AsiNr = THISFORM.Buf_W04382_1345AsiNro
               THISFORM.VEVC61361 ( THISFORM.A2EmpCod , THISFORM.A548EjeNro , THISFORM.A1344AsiCo , THISFORM.A1346AsiNr )
               GX_SFLOAD = 0
               THISFORM.U20VC62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04382) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04382 = Gx_err
               THISFORM.GX_DB_GetW04382_01 ()
            ENDDO
         ENDIF
      ENDPROC
