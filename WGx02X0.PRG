               THISFORM.A2199acoCo = THISFORM.Buf_W05012_2199acoCod
               THISFORM.A1216RutCh = THISFORM.Buf_W05012_1216RutChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W05012_966RutCod
               THISFORM.A2EmpCod = THISFORM.Buf_W05012_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VDX2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05012) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05012 = Gx_err
               THISFORM.GX_DB_GetW05012_01 ()
            ENDDO
         ENDIF
