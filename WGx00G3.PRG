      PROCEDURE CreateTemp
         LOCAL SCW198S20
         SCW198S20 = ""
         IF USED( "SCW198S20" )
            SELECT SCW198S20
            SCW198S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW198S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA176EntLg"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA177EntLg"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA179EntLg"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA180EntLg"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA182EntLg"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW198S20 = GETE('z:\temp') + '\' + SCW198S20
            ENDIF
            CREATE DBF (SCW198S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW198S20) EXCLUSIVE ALIAS SCW198S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW198S20
         THIS.GX_SfAlias = "SCW198S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01982" , @HStmt_W01982 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00G3","W01982","",GX_CURSOR_TYPE_READONLY,@HStmt_W01982) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntLgCont], [EntLgTel], [EntLgMunCo], [EntLgPciCo], "
                  cmdbuf = cmdbuf + "  [EntLgPaiCo], [EntLgDsc], [EntLgCod] FROM [CLTES] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? and [EntLgCod] >= ?) AND ([EntLgDsc] like "
                  cmdbuf = cmdbuf + "  ?) AND ([EntLgCont] like ?) AND ([EntLgTel] like ?) ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod], [EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01982,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01982,9)
                  THISFORM.GX_DB_BindColsW01982_01 ()
                  THISFORM.GX_DB_BindParmW01982_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01982,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01982,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01982,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxAV5C176 = THISFORM.AV5C176
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01982,4,@AuxAV5C176,0)
               THISFORM.AV5C176 = AuxAV5C176
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01982,5,PADR( TRIM(THISFORM.AV6C177),30, '%'),LEN(PADR( TRIM(THISFORM.AV6C177),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01982,6,PADR( TRIM(THISFORM.AV7C185),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C185),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01982,7,PADR( TRIM(THISFORM.AV8C186),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C186),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01982 = Gx_err
               THISFORM.GX_DB_GetW01982_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01982 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01982) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01982 = Gx_err
                  THISFORM.GX_DB_GetW01982_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01982 <> 101
               BRKV5I2 = .F.
               THISFORM.A185EntLgC = THISFORM.Buf_W01982_185EntLgCont
               THISFORM.A186EntLgT = THISFORM.Buf_W01982_186EntLgTel
               THISFORM.A182EntLgM = THISFORM.Buf_W01982_182EntLgMunCo
               THISFORM.A180EntLgP = THISFORM.Buf_W01982_180EntLgPciCo
               THISFORM.A179EntLgP = THISFORM.Buf_W01982_179EntLgPaiCo
               THISFORM.A177EntLgD = THISFORM.Buf_W01982_177EntLgDsc
               THISFORM.A176EntLgC = THISFORM.Buf_W01982_176EntLgCod
               GX_SFLOAD = 0
               THISFORM.U12V5I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01982 = Gx_err
               THISFORM.GX_DB_GetW01982_01 ()
            ENDDO
         ENDIF
      ENDPROC
