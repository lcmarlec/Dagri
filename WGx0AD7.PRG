      PROCEDURE CreateTemp
         LOCAL SCW1102S20
         SCW1102S20 = ""
         IF USED( "SCW1102S20" )
            SELECT SCW1102S20
            SCW1102S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1102S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 1 , 4]

            GX_STRUCT[ 1 ,1]= "sA176EntLg"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1102S20 = GETE('z:\temp') + '\' + SCW1102S20
            ENDIF
            CREATE DBF (SCW1102S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1102S20) EXCLUSIVE ALIAS SCW1102S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1102S20
         THIS.GX_SfAlias = "SCW1102S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11022" , @HStmt_W11022 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0AD7","W11022","",GX_CURSOR_TYPE_READONLY,@HStmt_W11022) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [bonfde], [bonfam], [bonfams], [bonartcod], "
                  cmdbuf = cmdbuf + "  [EntLgCod] FROM [BONIFIC1] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [EntGruTip] "
                  cmdbuf = cmdbuf + "  = ? and [EntCod] = ? and [bonfde] = ? and [bonfam] = ? and [bonfams] = ? and [bonartcod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], [bonfde], [bonfam], [bonfams], [bonartcod], "
                  cmdbuf = cmdbuf + "  [EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11022,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11022,9)
                  THISFORM.GX_DB_BindColsW11022_01 ()
                  THISFORM.GX_DB_BindParmW11022_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11022,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11022,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11022,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA3247bonfd = THISFORM.A3247bonfd
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11022,4,@AuxA3247bonfd,0)
               THISFORM.A3247bonfd = AuxA3247bonfd
               AuxA3248bonfa = THISFORM.A3248bonfa
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11022,5,@AuxA3248bonfa,0)
               THISFORM.A3248bonfa = AuxA3248bonfa
               AuxA3249bonfa = THISFORM.A3249bonfa
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11022,6,@AuxA3249bonfa,0)
               THISFORM.A3249bonfa = AuxA3249bonfa
               AuxA3250bonar = THISFORM.A3250bonar
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11022,7,@AuxA3250bonar,0)
               THISFORM.A3250bonar = AuxA3250bonar
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11022 = Gx_err
               THISFORM.GX_DB_GetW11022_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11022 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11022) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11022 = Gx_err
                  THISFORM.GX_DB_GetW11022_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11022 <> 101
               BRKVUM2 = .F.
               THISFORM.A176EntLgC = THISFORM.Buf_W11022_176EntLgCod
               GX_SFLOAD = 0
               THISFORM.U12VUM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11022 = Gx_err
               THISFORM.GX_DB_GetW11022_01 ()
            ENDDO
         ENDIF
      ENDPROC
