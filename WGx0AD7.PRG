            RETURN
         ENDIF
         SELECT ( THISFORM.cCW1102S20 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
