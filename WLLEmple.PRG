               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W10372,2,@AuxAV25Llefch,0)
               THISFORM.AV25Llefch = AuxAV25Llefch
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10372,3,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               AuxAV28Tracod = THISFORM.AV28Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10372,4,@AuxAV28Tracod,0)
               THISFORM.AV28Tracod = AuxAV28Tracod
               AuxAV28Tracod = THISFORM.AV28Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10372,5,@AuxAV28Tracod,0)
               THISFORM.AV28Tracod = AuxAV28Tracod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10372 = Gx_err
               THISFORM.GX_DB_GetW10372_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WLLEmple"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10372 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10372) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10372 = Gx_err
                  THISFORM.GX_DB_GetW10372_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10372 <> 101
               BRKVST2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W10372_2EmpCod
               THISFORM.A3086LLeMs = THISFORM.Buf_W10372_3086LLeMsj
               THISFORM.A3167LleFR = THISFORM.Buf_W10372_3167LleFR
               THISFORM.A564TraNom = THISFORM.Buf_W10372_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W10372_561TraCod
               THISFORM.A3083LLeFc = THISFORM.Buf_W10372_3083LLeFch
               THISFORM.A564TraNom = THISFORM.Buf_W10372_564TraNom
               GX_SFLOAD = 0
               THISFORM.U18VST2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10372 = Gx_err
               THISFORM.GX_DB_GetW10372_01 ()
            ENDDO
         ENDIF
      ENDPROC
