      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
               IF .T.
                  THISFORM.SaveTblPos()
                  Aux1 = THISFORM.A120EntCod
                  Aux2 = THISFORM.A2EmpCod
                  Aux3 = THISFORM.AV7Fechasi
                  Aux4 = THISFORM.AV17Usuari
                  DO TCliente WITH "UPD" , Aux1 , Aux2 , Aux3 , Aux4
                  THISFORM.A120EntCod = Aux1
                  THISFORM.A2EmpCod = Aux2
                  THISFORM.AV7Fechasi = Aux3
                  THISFORM.AV17Usuari = Aux4
                  THISFORM. cCT17A120 .Refresh()
                  THISFORM. cCT17A2 .Refresh()
                  THISFORM. cCT17V7 .Refresh()
                  THISFORM. cCT17V17 .Refresh()
               ENDIF
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
