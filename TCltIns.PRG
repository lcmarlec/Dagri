       BackColor = GetSysColor(5)
       DisabledForeColor= RGB(127,127,127)
       DisabledBackColor = GetSysColor(5)
       FontName = "Courier New"
       FontSize = 9
       FontBold = .F.
       BackStyle = 0
      BorderStyle = 0
      Alignment = 1
      HelpContextId = 327682
      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.A2EmpCod
         THIS.SetTabOrder
         THIS.GX_OldValue = THISFORM.A2EmpCod
         THIS.GX_Level = 15
      ENDPROC
      PROCEDURE InitLevel
         LPARAMETER gxILvl
         LOCAL gx_oMode
         IF gxILvl != 15
            RETURN .T.
         ENDIF
         GX_lastvld = 0
         THISFORM.gx_lastvld = THIS.GxObjOrder-1
         RETURN .T.
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl = 15
            IF ! THISFORM. gx_15insert
               THISFORM.SetLevel( 15 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 15
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 15 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00173) , "TCLTINS" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00172) , "TCLTINS" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00174) , "TCLTINS" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT17A167 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 15
            IF ! THISFORM. gx_15insert
               THISFORM.SetLevel( 15 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_15insert
            THISFORM. gx_15insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 15 )
            THISFORM. cCT17A2 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         gx_old_mode = THISFORM.GX_Mode
         IF THISFORM.GX_Mode = "DSP"
            THISFORM.GX_Mode = "UPD"
         ENDIF
         THISFORM.GX_Mode = gx_old_mode
         IF THISFORM.GX_last_fld_lvl != 15
            THISFORM.SetLevel( 15 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT17A2 .InitLevel( 15 )
            THISFORM.GX_last_fld_lvl = 15
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2EmpCod"
         THIS.GXGotFocus()
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM.Gx_Curr_Level = 15  .and. THISFORM.GX_1_accepted
            IF .not. THISFORM. GXInLvl15
               RETURN .T.
            ENDIF
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
      RETURN .T.
      ENDPROC
