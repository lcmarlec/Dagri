            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT17V17 .Refresh()
         ENDIF
         IF .T. .AND. THISFORM.AV20Entcod <= THISFORM.A120EntCod
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A2EmpCod
            Aux3 = THISFORM.A120EntCod
            DO PSkNro WITH Aux0 , "CLT" , 0 , Aux3 , 2
            THISFORM.A2EmpCod = Aux0
            THISFORM.A120EntCod = Aux3
            THISFORM. cCT17A2 .Refresh()
            THISFORM. cCT17A120 .Refresh()
