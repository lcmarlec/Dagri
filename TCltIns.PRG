            THISFORM.A120EntCod = AuxA120EntCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00173) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00173 = Gx_err
