      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S908RVtNro
         LOCAL S928RVtLin
         S2EmpCod = THISFORM.A2EmpCod
         S908RVtNro = THISFORM.A908RVtNro
         S928RVtLin = THISFORM.A928RVtLin
         THISFORM.A928RVtLin = THISFORM.M928RVtLin
         THISFORM. cCT95S20 .SaveTemp()
         THISFORM. cCT95S20 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT95S20 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT95S20 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT95S20 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S908RVtNro = THISFORM.A908RVtNro .AND. S928RVtLin = THISFORM.A928RVtLin
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT95S20 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT95S20 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S908RVtNro = THISFORM.A908RVtNro .AND. S928RVtLin = THISFORM.A928RVtLin
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT95S20 .Refresh()
               THISFORM. cCT95S20 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A908RVtNro = S908RVtNro
               THISFORM.A928RVtLin = S928RVtLin
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT95S20 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT95S20 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S908RVtNro = THISFORM.A908RVtNro .AND. S928RVtLin = THISFORM.A928RVtLin
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT95S20 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S908RVtNro = THISFORM.A908RVtNro .AND. S928RVtLin = THISFORM.A928RVtLin
            ENDDO
            IF sf_err != 0
               THISFORM. cCT95S20 .AppendRow()
               THISFORM. cCT95S20 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A908RVtNro = S908RVtNro
               THISFORM.A928RVtLin = S928RVtLin
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A908RVtNro = S908RVtNro
         THISFORM.A928RVtLin = S928RVtLin
         RETURN .F.
      ENDFUNC
      FUNCTION SF_INSERT()
         LOCAL gxO_Area
         gxO_Area = SELECT()
         IF EMPTY(THISFORM. cCT95S20 .GX_SfAlias)
            RETURN
         ENDIF
         SELECT (THISFORM. cCT95S20 .GX_SfAlias)
