               THISFORM.GX_DB_GetT009518_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T009518 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009518) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T009518 = Gx_err
                  THISFORM.GX_DB_GetT009518_01 ()
