                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TREMVTA","T009518","",GX_CURSOR_TYPE_READONLY,@HStmt_T009518) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [RVtNroInt], [RVtLin], [FamCod], [FamSubCod], [ArtCod], [RVtCnt], "
                  cmdbuf = cmdbuf + "  [RVtPrc], [RVtPrcReal], [RvtOfe], [RvtOfeNro], [RVtLes], [RVtLugCod] AS RVtLugCod, "
                  cmdbuf = cmdbuf + "  [RVtLotNro], [RVtLObs], [RvtArtInd], [RvtCntOri], [RvtMotdif], [RvtArtFx], [RvtPrcOri] "
                  cmdbuf = cmdbuf + "  FROM [REMVTA1] (NOLOCK) WHERE [EmpCod] = ? AND [RVtNroInt] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [RVtNroInt], [RVtLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T009518,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T009518,14)
                  THISFORM.GX_DB_BindColsT009518_01 ()
                  THISFORM.GX_DB_BindParmT009518_01 ()
