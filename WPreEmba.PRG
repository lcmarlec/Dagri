      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11062" , @HStmt_W11062 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPREEMBA","W11062","",GX_CURSOR_TYPE_READONLY,@HStmt_W11062) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PedEst], T1.[PedEmbOrd], T1.[PedEmbCB], T1.[PedNro], T1.[PedGruTip] AS "
                  cmdbuf = cmdbuf + "  PedGruTip, T1.[EmpCod], T1.[PedSec], T1.[PedFch], T1.[PedEmbFch], T1.[PedNroFac], "
                  cmdbuf = cmdbuf + "  T1.[PedSucFac], T1.[PedNroRto], T1.[PedSucRto], T2.[Entlgloc], T2.[EntLgDsc], T1.[PedSucCod] "
                  cmdbuf = cmdbuf + "  AS PedSucCod, T1.[PedEntCod] AS PedEntCod FROM ([PEDIDO1] T1 (NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [CLTES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[PedGruTip] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[PedFch] = ?) AND (T1.[PedNro] = ?) AND (T1.[PedEst] >= 1) AND (T1.[PedEst] "
                  cmdbuf = cmdbuf + "  < 9) AND (T1.[PedEmbOrd] = ' ') AND (SUBSTRING(T1.[PedEmbCB], 2, 1) <> '0' and SUBSTRING(T1.[PedEmbCB], "
                  cmdbuf = cmdbuf + "  2, 1) <> '1' and SUBSTRING(T1.[PedEmbCB], 2, 1) <> '2' and SUBSTRING(T1.[PedEmbCB], "
                  cmdbuf = cmdbuf + "  2, 1) <> '3' and SUBSTRING(T1.[PedEmbCB], 2, 1) <> '4' and SUBSTRING(T1.[PedEmbCB], "
                  cmdbuf = cmdbuf + "  2, 1) <> '5' and SUBSTRING(T1.[PedEmbCB], 2, 1) <> '6' and SUBSTRING(T1.[PedEmbCB], "
                  cmdbuf = cmdbuf + "  2, 1) <> '7' and SUBSTRING(T1.[PedEmbCB], 2, 1) <> '8' and SUBSTRING(T1.[PedEmbCB], "
                  cmdbuf = cmdbuf + "  2, 1) <> '9') ORDER BY T1.[EmpCod], T1.[PedFch], T1.[PedGruTip], T1.[PedEntCod], "
                  cmdbuf = cmdbuf + "  T1.[PedSucCod], T1.[PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11062,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11062,15)
                  THISFORM.GX_DB_BindColsW11062_01 ()
                  THISFORM.GX_DB_BindParmW11062_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11062,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV15Fecdes = THISFORM.AV15Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11062,2,@AuxAV15Fecdes,0)
               THISFORM.AV15Fecdes = AuxAV15Fecdes
               AuxAV19Pednro = THISFORM.AV19Pednro
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11062,3,@AuxAV19Pednro,0)
               THISFORM.AV19Pednro = AuxAV19Pednro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11062 = Gx_err
               THISFORM.GX_DB_GetW11062_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV34Pgmnam = "WPreEmba"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11062 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11062) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11062 = Gx_err
                  THISFORM.GX_DB_GetW11062_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11062 <> 101
               BRKVUQ2 = .F.
               THISFORM.AV14Sel = 0
               THISFORM.A826PedEst = THISFORM.Buf_W11062_826PedEst
               THISFORM.A2513PedEm = THISFORM.Buf_W11062_2513PedEmbOrd
               THISFORM.A3282PedEm = THISFORM.Buf_W11062_3282PedEmbCB
               THISFORM.A796PedNro = THISFORM.Buf_W11062_796PedNro
               THISFORM.A797PedGru = THISFORM.Buf_W11062_797PedGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W11062_2EmpCod
               THISFORM.A809PedSec = THISFORM.Buf_W11062_809PedSec
               THISFORM.A795PedFch = THISFORM.Buf_W11062_795PedFch
               THISFORM.A1218PedEm = THISFORM.Buf_W11062_1218PedEmbFch
               THISFORM.A829PedNro = THISFORM.Buf_W11062_829PedNroFac
               THISFORM.A828PedSuc = THISFORM.Buf_W11062_828PedSucFac
               THISFORM.A831PedNro = THISFORM.Buf_W11062_831PedNroRto
               THISFORM.A830PedSuc = THISFORM.Buf_W11062_830PedSucRto
               THISFORM.A1076Entlg = THISFORM.Buf_W11062_1076Entlgloc
               THISFORM.A177EntLgD = THISFORM.Buf_W11062_177EntLgDsc
               THISFORM.A802PedSuc = THISFORM.Buf_W11062_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W11062_798PedEntCod
               THISFORM.A1076Entlg = THISFORM.Buf_W11062_1076Entlgloc
               THISFORM.A177EntLgD = THISFORM.Buf_W11062_177EntLgDsc
               X7990 = SPACE(40)
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A797PedGru
               Aux2 = THISFORM.A798PedEnt
               DO RPedEntr WITH Aux0 , Aux1 , Aux2 , X7990
               THISFORM.A2EmpCod = Aux0
               THISFORM.A797PedGru = Aux1
               THISFORM.A798PedEnt = Aux2
               THISFORM. cCW1106S22 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.A799PedEnt = X7990
               GX_SFLOAD = 0
               THISFORM.U17VUQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11062 = Gx_err
               THISFORM.GX_DB_GetW11062_01 ()
            ENDDO
         ENDIF
