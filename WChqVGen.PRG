      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW303V23.ISVALID" )
         THISFORM.AV33GXLvl8 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03032" , @HStmt_W03032 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCHQVGEN","W03032","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W03032) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[BcoCta], T1.[BcoDir], T1.[BcoCtaNro], T1.[BcoAut], T1.[BcoCod], T2.[BcoDsc], "
            cmdbuf = cmdbuf + "  T3.[MonDsc] AS BcoMonDsc, T1.[BcoMonCod] AS BcoMonCod, T1.[BcoNroUlt] FROM (([CTAS] "
            cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[BcoCod]) LEFT JOIN "
            cmdbuf = cmdbuf + "  [MONEDA] T3 (NOLOCK) ON T3.[Moncod] = T1.[BcoMonCod]) WHERE T1.[BcoCta] = ? ORDER "
            cmdbuf = cmdbuf + "  BY T1.[BcoCta]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03032,cmdbuf)
            THISFORM.GX_DB_BindColsW03032_01 ()
            THISFORM.GX_DB_BindParmW03032_01 ()
         ENDIF
         AuxAV23Ctacod = THISFORM.AV23Ctacod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03032,1,@AuxAV23Ctacod,0)
         THISFORM.AV23Ctacod = AuxAV23Ctacod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03032) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W03032 = Gx_err
         THISFORM.GX_DB_GetW03032_01 ()
         DO WHILE THISFORM.W03032 <> 101
            THISFORM.A76BcoCta = THISFORM.Buf_W03032_76BcoCta
            THISFORM.A79BcoDir = THISFORM.Buf_W03032_79BcoDir
            THISFORM.A77BcoCtaN = THISFORM.Buf_W03032_77BcoCtaNro
            THISFORM.A80BcoAut = THISFORM.Buf_W03032_80BcoAut
            THISFORM.A86BcoCod = THISFORM.Buf_W03032_86BcoCod
            THISFORM.A87BcoDsc = THISFORM.Buf_W03032_87BcoDsc
            THISFORM.A234BcoMon = THISFORM.Buf_W03032_234BcoMonDsc
            THISFORM.A233BcoMon = THISFORM.Buf_W03032_233BcoMonCod
            THISFORM.A81BcoNroU = THISFORM.Buf_W03032_81BcoNroUlt
            THISFORM.A87BcoDsc = THISFORM.Buf_W03032_87BcoDsc
            THISFORM.A234BcoMon = THISFORM.Buf_W03032_234BcoMonDsc
            THISFORM.AV33GXLvl8 = 1
            THISFORM.AV24Ctanro = THISFORM.A77BcoCtaN
            IF THISFORM.AV29Mcocod = 2
               THISFORM.AV25Bcoaut = THISFORM.A80BcoAut
            ELSE
               THISFORM.AV25Bcoaut = "N"
            ENDIF
            THISFORM.AV12Bcocod = THISFORM.A86BcoCod
            THISFORM.AV22Bcodsc = THISFORM.A87BcoDsc
            THISFORM.AV26Moneda = THISFORM.A234BcoMon
            THISFORM.AV27Codmon = THISFORM.A233BcoMon
            IF THISFORM.AV25Bcoaut = "S"
               THISFORM.AV20Nrodeb = THISFORM.A81BcoNroU + 1
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W03032) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV33GXLvl8 = 0
            THISFORM.Refresh()
            DO GX_ERRMW WITH "Código de Cuenta Inexistente "
            THISFORM.cCW303V23.GXSetFocus( )
         ENDIF
         IF EMPTY( THISFORM.AV27Codmon )
            THISFORM.AV27Codmon = 1
         ENDIF
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV27Codmon
         Aux1 = THISFORM.AV5Fechasi
         Aux2 = THISFORM.AV28Cotiz
         DO Rcotiz WITH Aux0 , Aux1 , Aux2
         THISFORM.AV27Codmon = Aux0
         THISFORM.AV5Fechasi = Aux1
         THISFORM.AV28Cotiz = Aux2
         GX_rploop = .T.
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

