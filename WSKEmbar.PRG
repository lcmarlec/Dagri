      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07882" , @HStmt_W07882 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKEMBAR","W07882","",GX_CURSOR_TYPE_READONLY,@HStmt_W07882) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DceDcNroIn] AS DceDcNroIn, T1.[DcEDesCod] AS DcEDesCod, T2.[EntGruTip], "
                  cmdbuf = cmdbuf + "  T2.[EntCod], T1.[EmpCod], T1.[DceNI], T1.[DcECarNro], T3.[DesRaz] AS DcEDesRaz, "
                  cmdbuf = cmdbuf + "  T1.[DcENroDC], T1.[DcENroReg], T1.[DcEGruTip], T1.[DcENroAd], T1.[DcENroAn], T1.[DcEEmbFch] "
                  cmdbuf = cmdbuf + "  FROM (([DCDESPA1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[DcCNroInt] = T1.[DceDcNroIn]) LEFT JOIN [DSPCHANT] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[DesCod] = T1.[DcEDesCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[DcEEmbFch] >= ?) AND (T2.[EntGruTip] = ?) AND (T2.[EntCod] = ?) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[DceNI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07882,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07882,12)
                  THISFORM.GX_DB_BindColsW07882_01 ()
                  THISFORM.GX_DB_BindParmW07882_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07882,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV17Desde = THISFORM.AV17Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07882,2,@AuxAV17Desde,0)
               THISFORM.AV17Desde = AuxAV17Desde
               AuxAV19Entgru = THISFORM.AV19Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07882,3,AuxAV19Entgru,2,0)
               THISFORM.AV19Entgru = AuxAV19Entgru
               AuxAV20Entcod = THISFORM.AV20Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07882,4,@AuxAV20Entcod,0)
               THISFORM.AV20Entcod = AuxAV20Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07882) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07882 = Gx_err
               THISFORM.GX_DB_GetW07882_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WSKEmbar"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07882 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07882) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07882 = Gx_err
                  THISFORM.GX_DB_GetW07882_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07882 <> 101
               BRKVLW2 = .F.
               THISFORM.A2384DceDc = THISFORM.Buf_W07882_2384DceDcNroIn
               THISFORM.A2356DcEDe = THISFORM.Buf_W07882_2356DcEDesCod
               THISFORM.A150EntGru = THISFORM.Buf_W07882_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W07882_120EntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W07882_2EmpCod
               THISFORM.A3022DceNI = THISFORM.Buf_W07882_3022DceNI
               THISFORM.A2358DcECa = THISFORM.Buf_W07882_2358DcECarNro
               THISFORM.A2357DcEDe = THISFORM.Buf_W07882_2357DcEDesRaz
               THISFORM.A2353DcENr = THISFORM.Buf_W07882_2353DcENroDC
               THISFORM.A2352DcENr = THISFORM.Buf_W07882_2352DcENroReg
               THISFORM.A2365DcEGr = THISFORM.Buf_W07882_2365DcEGruTip
               THISFORM.A2350DcENr = THISFORM.Buf_W07882_2350DcENroAd
               THISFORM.A2349DcENr = THISFORM.Buf_W07882_2349DcENroAn
               THISFORM.A2355DcEEm = THISFORM.Buf_W07882_2355DcEEmbFch
               THISFORM.A150EntGru = THISFORM.Buf_W07882_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W07882_120EntCod
               THISFORM.A2357DcEDe = THISFORM.Buf_W07882_2357DcEDesRaz
               GX_SFLOAD = 0
               THISFORM.U14VLW2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07882) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07882 = Gx_err
               THISFORM.GX_DB_GetW07882_01 ()
            ENDDO
         ENDIF
      ENDPROC
