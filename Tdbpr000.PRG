            THISFORM.T00302 = Gx_err
            THISFORM.GX_DB_GetT00302_01 ()
            IF .NOT. THISFORM.T00302 <> 103
               DO GX_ERRMW WITH "DBPR0000 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00302 = 101 .OR. THISFORM.Z279PrRazP <> THISFORM.Buf_T00302_279PrRazPro
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z284PrCuiP <> THISFORM.Buf_T00302_284PrCuiPro
               Gx_longc = .T.
