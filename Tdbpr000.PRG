      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00304" , @HStmt_T00304 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBPR000","T00304","",GX_CURSOR_TYPE_READONLY,@HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [PrCodPro], [PrRazPro], [PrDomPro], [PrCPoPro], [PrTelPro], [PrFaxPro], [PrCuiPro], "
            cmdbuf = cmdbuf + "  [PrPlazop], [PrOrden], [PrIvaPro], [PrRetGan], [PrPrvPro], [PrCodIns] FROM [DBPR0000] "
            cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE [PrCodPro] >= ? ORDER BY [PrCodPro]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00304,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00304,100)
            THISFORM.GX_DB_BindColsT00304_01 ()
            THISFORM.GX_DB_BindParmT00304_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A278PrCodP = 0
               ENDIF
               AuxA278PrCodP = THISFORM.A278PrCodP
               Gx_err = GX_DB_SetLong( HStmt_T00304,1,@AuxA278PrCodP,0)
               THISFORM.A278PrCodP = AuxA278PrCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00304 = Gx_err
               THISFORM.GX_DB_GetT00304_01 ()
               Gx_fcond = THISFORM.T00304 <> 101
            CASE GXOP = 2 && Next record
               AuxA278PrCodP = THISFORM.A278PrCodP
               Gx_err = GX_DB_SetLong( HStmt_T00304,1,@AuxA278PrCodP,0)
               THISFORM.A278PrCodP = AuxA278PrCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00304 = Gx_err
               THISFORM.GX_DB_GetT00304_01 ()
               DO WHILE THISFORM.T00304 = 0 .AND. THISFORM.A278PrCodP >= THISFORM.Buf_T00304_278PrCodPro
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00304 = Gx_err
                  THISFORM.GX_DB_GetT00304_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00304 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A278PrCodP = 0
               AuxA278PrCodP = THISFORM.A278PrCodP
               Gx_err = GX_DB_SetLong( HStmt_T00304,1,@AuxA278PrCodP,0)
               THISFORM.A278PrCodP = AuxA278PrCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00304 = Gx_err
               THISFORM.GX_DB_GetT00304_01 ()
               DO WHILE THISFORM.T00304 = 0
                  THISFORM.A278PrCodP = THISFORM.Buf_T00304_278PrCodPro
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00304 = Gx_err
                  THISFORM.GX_DB_GetT00304_01 ()
               ENDDO
               AuxA278PrCodP = THISFORM.A278PrCodP
               Gx_err = GX_DB_SetLong( HStmt_T00304,1,@AuxA278PrCodP,0)
               THISFORM.A278PrCodP = AuxA278PrCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00304) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00304 = Gx_err
               THISFORM.GX_DB_GetT00304_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A278PrCodP = THISFORM.Buf_T00304_278PrCodPro
               THISFORM.A279PrRazP = THISFORM.Buf_T00304_279PrRazPro
               THISFORM.A280PrDomP = THISFORM.Buf_T00304_280PrDomPro
               THISFORM.A281PrCPoP = THISFORM.Buf_T00304_281PrCPoPro
               THISFORM.A282PrTelP = THISFORM.Buf_T00304_282PrTelPro
               THISFORM.A283PrFaxP = THISFORM.Buf_T00304_283PrFaxPro
               THISFORM.A284PrCuiP = THISFORM.Buf_T00304_284PrCuiPro
               THISFORM.A285PrPlaz = THISFORM.Buf_T00304_285PrPlazop
               THISFORM.A286PrOrde = THISFORM.Buf_T00304_286PrOrden
               THISFORM.A287PrIvaP = THISFORM.Buf_T00304_287PrIvaPro
               THISFORM.A288PrRetG = THISFORM.Buf_T00304_288PrRetGan
               THISFORM.A289PrPrvP = THISFORM.Buf_T00304_289PrPrvPro
               THISFORM.A290PrCodI = THISFORM.Buf_T00304_290PrCodIns
         ENDCASE
         Gx_fcond = THISFORM.T00304 <> 101 .AND. THISFORM.T00304 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

