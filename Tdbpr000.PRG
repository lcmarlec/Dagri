      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 27
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT30A278 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 27
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA278PrCodP = THISFORM.A278PrCodP
                  Gx_err = GX_DB_SetLong( HStmt_T00303,1,@AuxA278PrCodP,0)
                  THISFORM.A278PrCodP = AuxA278PrCodP
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00303) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00303 = Gx_err
                  THISFORM.GX_DB_GetT00303_01 ()
                  THISFORM. cCT30A278 . ZM0U27 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0U27 ()
               THISFORM. cCT30A278 . ZM0U27 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0U27 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT30A288 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0U27 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0U27 ()
                  RETURN
               ENDIF
               THISFORM.cCT30A278.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00303) , "TDBPR000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00302) , "TDBPR000" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT30A288 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT30A278 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

