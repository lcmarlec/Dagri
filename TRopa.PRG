      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T04092,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA3FamCod = THISFORM.A3FamCod
            Gx_err = GX_DB_SetInt( HStmt_T04092,2,@AuxA3FamCod,0)
            THISFORM.A3FamCod = AuxA3FamCod
