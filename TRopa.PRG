                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T04097) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T04097 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04097) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04098" , @HStmt_T04098 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TROPA","T04098","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04098) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ROPA]  WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] "
                  cmdbuf = cmdbuf + "  = ? AND [ArtTalle] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04098,cmdbuf)
                  THISFORM.GX_DB_BindParmT04098_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T04098,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T04098,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T04098,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T04098,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA3801ArtTa = THISFORM.A3801ArtTa
               Gx_err = GX_DB_SetStr( HStmt_T04098,5,AuxA3801ArtTa,4,0)
               THISFORM.A3801ArtTa = AuxA3801ArtTa
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T04098) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T04098 = Gx_err
               THISFORM.T04092 = iif( THISFORM.T04098 = 0 , 104 , THISFORM.T04098 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04098) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A3FamCod , 4 ) + " " + str( THISFORM.A4FamSubCo , 4 ) + " " + str( THISFORM.A5ArtCod , 4 )
         ENDIF
         IF .T.
            THISFORM.AV22Audobs = "Alta de Talle de Artículo " + ALLTRIM( THISFORM.A3801ArtTa )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "TABL" , Aux1 , "ARTI" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT409V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 426 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
