            Gx_err = GX_DB_SetInt( HStmt_T04092,4,@AuxA5ArtCod,0)
            THISFORM.A5ArtCod = AuxA5ArtCod
            AuxA3801ArtTa = THISFORM.A3801ArtTa
            Gx_err = GX_DB_SetStr( HStmt_T04092,5,AuxA3801ArtTa,4,0)
            THISFORM.A3801ArtTa = AuxA3801ArtTa
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T04092) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T04092 = Gx_err
            THISFORM.GX_DB_GetT04092_01 ()
            IF .NOT. THISFORM.T04092 <> 103
               DO GX_ERRMW WITH "ROPA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T04092 = 101 .OR. THISFORM.Z3802ArtRo <> THISFORM.Buf_T04092_3802ArtRopExis
               DO GX_ERRMW WITH "ROPA fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04096" , @HStmt_T04096 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TROPA","T04096","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04096) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ROPA] ([EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtTalle], [ArtRopExis]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04096,cmdbuf)
                  THISFORM.GX_DB_BindParmT04096_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T04096,1,@AuxA2EmpCod,0)
