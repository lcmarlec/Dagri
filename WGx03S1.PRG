      PROCEDURE CreateTemp
         LOCAL SCW374S20
         SCW374S20 = ""
         IF USED( "SCW374S20" )
            SELECT SCW374S20
            SCW374S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW374S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA795PedFc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA797PedGr"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA798PedEn"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA802PedSu"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA796PedNr"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW374S20 = GETE('z:\temp') + '\' + SCW374S20
            ENDIF
            CREATE DBF (SCW374S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW374S20) EXCLUSIVE ALIAS SCW374S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW374S20
         THIS.GX_SfAlias = "SCW374S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03742" , @HStmt_W03742 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX03S1","W03742","",GX_CURSOR_TYPE_READONLY,@HStmt_W03742) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PedSec], [PedNro], [PedSucCod], [PedEntCod], [PedGruTip], [PedFch] "
                  cmdbuf = cmdbuf + "  FROM [PEDIDO1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [PedFch] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([PedGruTip] like ?) AND ([PedEntCod] >= ?) AND ([PedSucCod] >= ?) AND ([PedSec] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PedNro] >= ?) ORDER BY [EmpCod], [PedFch], [PedGruTip], [PedEntCod], "
                  cmdbuf = cmdbuf + "  [PedSucCod], [PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03742,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03742,9)
                  THISFORM.GX_DB_BindColsW03742_01 ()
                  THISFORM.GX_DB_BindParmW03742_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03742,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C795 = THISFORM.AV5C795
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03742,2,@AuxAV5C795,0)
               THISFORM.AV5C795 = AuxAV5C795
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03742,3,PADR( TRIM(THISFORM.AV6C797),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C797),2, '%')),0)
               AuxAV7C798 = THISFORM.AV7C798
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03742,4,@AuxAV7C798,0)
               THISFORM.AV7C798 = AuxAV7C798
               AuxAV8C802 = THISFORM.AV8C802
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03742,5,@AuxAV8C802,0)
               THISFORM.AV8C802 = AuxAV8C802
               AuxAV9C809 = THISFORM.AV9C809
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03742,6,@AuxAV9C809,0)
               THISFORM.AV9C809 = AuxAV9C809
               AuxAV10C796 = THISFORM.AV10C796
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03742,7,@AuxAV10C796,0)
               THISFORM.AV10C796 = AuxAV10C796
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03742 = Gx_err
               THISFORM.GX_DB_GetW03742_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03742 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03742) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03742 = Gx_err
                  THISFORM.GX_DB_GetW03742_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03742 <> 101
               BRKVAE2 = .F.
               THISFORM.A809PedSec = THISFORM.Buf_W03742_809PedSec
               THISFORM.A796PedNro = THISFORM.Buf_W03742_796PedNro
               THISFORM.A802PedSuc = THISFORM.Buf_W03742_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W03742_798PedEntCod
               THISFORM.A797PedGru = THISFORM.Buf_W03742_797PedGruTip
               THISFORM.A795PedFch = THISFORM.Buf_W03742_795PedFch
               GX_SFLOAD = 0
               THISFORM.U12VAE2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03742 = Gx_err
               THISFORM.GX_DB_GetW03742_01 ()
            ENDDO
         ENDIF
      ENDPROC
