      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03933" , @HStmt_W03933 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WECHANU1","W03933","",GX_CURSOR_TYPE_READONLY,@HStmt_W03933) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[Moncod], T1.[EmpCod], T1.[ECHNroInt], T1.[EchMonCot], T1.[EchMOnImp], "
                  cmdbuf = cmdbuf + "  T2.[MonDsc], T1.[EchMonCod] FROM ([ENTCHE3] T1 (NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[Moncod] = T1.[EchMonCod]) WHERE T1.[EmpCod] = ? and T1.[ECHNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[ECHNroInt], T1.[EchMonCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03933,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03933,5)
                  THISFORM.GX_DB_BindColsW03933_01 ()
                  THISFORM.GX_DB_BindParmW03933_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03933,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV37Echnro = THISFORM.AV37Echnro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03933,2,@AuxAV37Echnro,0)
               THISFORM.AV37Echnro = AuxAV37Echnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03933) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03933 = Gx_err
               THISFORM.GX_DB_GetW03933_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV48Pgmnam = "WEchAnu1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03933 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03933) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03933 = Gx_err
                  THISFORM.GX_DB_GetW03933_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03933 <> 101
               BRKVAX6 = .F.
               THISFORM.A193Moncod = THISFORM.Buf_W03933_193Moncod
               THISFORM.A2EmpCod = THISFORM.Buf_W03933_2EmpCod
               THISFORM.A1083ECHNr = THISFORM.Buf_W03933_1083ECHNroInt
               THISFORM.A1256EchMo = THISFORM.Buf_W03933_1256EchMonCot
               THISFORM.A1255EchMO = THISFORM.Buf_W03933_1255EchMOnImp
               THISFORM.A194MonDsc = THISFORM.Buf_W03933_194MonDsc
               THISFORM.A1253EchMo = THISFORM.Buf_W03933_1253EchMonCod
               GX_SFLOAD = 0
               THISFORM.cCW393Tb31.cCW393Pg52Tb31.cCW393S53.Load ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03933) ,  ,  ,  , CS_SQLSRV ,  )
