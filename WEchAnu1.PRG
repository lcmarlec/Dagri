      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03937" , @HStmt_W03937 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WECHANU1","W03937","",GX_CURSOR_TYPE_READONLY,@HStmt_W03937) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ECHNroInt], [EmpCod], [EchMcoCot], [EchMcoImp], [EchMcoFch], [echmcoMon], "
                  cmdbuf = cmdbuf + "  [EchMcoCta], [EchMcoCod] FROM [ENTCHE4] (NOLOCK) WHERE [EmpCod] = ? and [ECHNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [ECHNroInt], [EchMcoCod], [EchMcoCta], [EchMcoFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03937,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03937,6)
                  THISFORM.GX_DB_BindColsW03937_01 ()
                  THISFORM.GX_DB_BindParmW03937_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03937,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV37Echnro = THISFORM.AV37Echnro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03937,2,@AuxAV37Echnro,0)
               THISFORM.AV37Echnro = AuxAV37Echnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03937) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03937 = Gx_err
               THISFORM.GX_DB_GetW03937_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV48Pgmnam = "WEchAnu1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03937 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03937) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03937 = Gx_err
                  THISFORM.GX_DB_GetW03937_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03937 <> 101
               BRKVAX3 = .F.
               THISFORM.A1083ECHNr = THISFORM.Buf_W03937_1083ECHNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W03937_2EmpCod
               THISFORM.A1800EchMc = THISFORM.Buf_W03937_1800EchMcoCot
               THISFORM.A1797EchMc = THISFORM.Buf_W03937_1797EchMcoImp
               THISFORM.A1796EchMc = THISFORM.Buf_W03937_1796EchMcoFch
               THISFORM.A1798echmc = THISFORM.Buf_W03937_1798echmcoMon
               THISFORM.A1794EchMc = THISFORM.Buf_W03937_1794EchMcoCta
               THISFORM.A1792EchMc = THISFORM.Buf_W03937_1792EchMcoCod
               GX_SFLOAD = 0
               THISFORM.cCW393Tb31.cCW393Pg59Tb31.cCW393S60.Load ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03937) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03937 = Gx_err
               THISFORM.GX_DB_GetW03937_01 ()
            ENDDO
         ENDIF
