               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07872,3,AuxAV19Entgru,2,0)
               THISFORM.AV19Entgru = AuxAV19Entgru
               AuxAV20Entcod = THISFORM.AV20Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07872,4,@AuxAV20Entcod,0)
               THISFORM.AV20Entcod = AuxAV20Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07872) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07872 = Gx_err
               THISFORM.GX_DB_GetW07872_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WSKFcE"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07872 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07872) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07872 = Gx_err
                  THISFORM.GX_DB_GetW07872_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07872 <> 101
               BRKVLV2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W07872_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W07872_120EntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W07872_2EmpCod
