      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07872" , @HStmt_W07872 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKFCE","W07872","",GX_CURSOR_TYPE_READONLY,@HStmt_W07872) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntGruTip], [EntCod], [EmpCod], [DccENI], [DccTotOri], [DcCNroInt], [DcCTot], "
                  cmdbuf = cmdbuf + "  [DcCNro], [DcCSuc], [DccSer], [DccTipRed], [DcCFec] FROM [DCCOM] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ?) AND ([DcCNro] = ?) AND ([EntGruTip] = ?) AND ([EntCod] = ?) "
                  cmdbuf = cmdbuf + "  AND ([DccTipRed] = 'FC') AND ([DccSer] = 'E') AND ([DccENI] = convert(int, 0)) ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07872,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07872,6)
                  THISFORM.GX_DB_BindColsW07872_01 ()
                  THISFORM.GX_DB_BindParmW07872_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07872,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV17Desde = THISFORM.AV17Desde
