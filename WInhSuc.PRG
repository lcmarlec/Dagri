      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06252" , @HStmt_W06252 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WINHSUC","W06252","",GX_CURSOR_TYPE_READONLY,@HStmt_W06252) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[EntGruTip], T1.[EntCod], T1.[entLgInhMo], T2.[EntRaz], T1.[EntLgInhab], "
                  cmdbuf = cmdbuf + "  T1.[EntLgDom], T1.[EntLgDsc], T1.[EntLgCod] FROM ([CLTES] T1 (NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] = ? and T1.[EntGruTip] = ? and "
                  cmdbuf = cmdbuf + "  T1.[EntCod] = ?) AND (T1.[EntLgDsc] like ?) ORDER BY T1.[EmpCod], T1.[EntGruTip], "
                  cmdbuf = cmdbuf + "  T1.[EntCod], T1.[EntLgDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06252,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06252,15)
                  THISFORM.GX_DB_BindColsW06252_01 ()
                  THISFORM.GX_DB_BindParmW06252_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06252,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06252,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06252,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06252,4,PADR( TRIM(THISFORM.AV18Desraz),40, '%'),LEN(PADR( TRIM(THISFORM.AV18Desraz),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06252 = Gx_err
               THISFORM.GX_DB_GetW06252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WInhSuc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06252 = Gx_err
                  THISFORM.GX_DB_GetW06252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06252 <> 101
               BRKVHD2 = .F.
               THISFORM.AV23Entlgi = SPACE(1)
               THISFORM.AV24Entlgi = SPACE(30)
               THISFORM.A1887entLg = THISFORM.Buf_W06252_1887entLgInhMo
               THISFORM.A153EntRaz = THISFORM.Buf_W06252_153EntRaz
               THISFORM.A1886EntLg = THISFORM.Buf_W06252_1886EntLgInhab
               THISFORM.A178EntLgD = THISFORM.Buf_W06252_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W06252_177EntLgDsc
               THISFORM.A176EntLgC = THISFORM.Buf_W06252_176EntLgCod
               THISFORM.A153EntRaz = THISFORM.Buf_W06252_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U15VHD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06252 = Gx_err
               THISFORM.GX_DB_GetW06252_01 ()
            ENDDO
         ENDIF
      ENDPROC
