            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW625S14 = GETE('z:\temp') + '\' + SCW625S14
            ENDIF
            CREATE DBF (SCW625S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW625S14) EXCLUSIVE ALIAS SCW625S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW625S14
