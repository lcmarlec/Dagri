         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER OCW560.EnterKey
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
