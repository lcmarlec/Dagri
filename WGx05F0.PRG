               THISFORM.AV7C1708 = AuxAV7C1708
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05602,4,PADR( TRIM(THISFORM.AV8C1709),2, '%'),LEN(PADR( TRIM(THISFORM.AV8C1709),2, '%')),0)
               AuxAV9C1710 = THISFORM.AV9C1710
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05602,5,@AuxAV9C1710,0)
               THISFORM.AV9C1710 = AuxAV9C1710
               AuxAV10C1711 = THISFORM.AV10C1711
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05602,6,@AuxAV10C1711,0)
               THISFORM.AV10C1711 = AuxAV10C1711
               AuxAV11C1712 = THISFORM.AV11C1712
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05602,7,@AuxAV11C1712,0)
               THISFORM.AV11C1712 = AuxAV11C1712
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05602 = Gx_err
               THISFORM.GX_DB_GetW05602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05602 = Gx_err
                  THISFORM.GX_DB_GetW05602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05602 <> 101
               BRKVFK2 = .F.
               THISFORM.A1711tRcvN = THISFORM.Buf_W05602_1711tRcvNro
               THISFORM.A1710tRcvS = THISFORM.Buf_W05602_1710tRcvSuc
               THISFORM.A1709tRCVT = THISFORM.Buf_W05602_1709tRCVTip
               THISFORM.A1712tRcvL = THISFORM.Buf_W05602_1712tRcvLin
               THISFORM.A1708tRcvF = THISFORM.Buf_W05602_1708tRcvFch
               THISFORM.A1707tRcvN = THISFORM.Buf_W05602_1707tRcvNroi
               THISFORM.A2EmpCod = THISFORM.Buf_W05602_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VFK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05602 = Gx_err
               THISFORM.GX_DB_GetW05602_01 ()
            ENDDO
         ENDIF
      ENDPROC
