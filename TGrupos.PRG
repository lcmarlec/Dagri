               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 58
            IF ! THISFORM. gx_58insert
               THISFORM.SetLevel( 58 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_58insert
            THISFORM. gx_58insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 58 )
            THISFORM. cCT55A610 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 58
            THISFORM.SetLevel( 58 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT55A2 .InitLevel( 58 )
            THISFORM.GX_last_fld_lvl = 58
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A611GruDsc"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl58
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         THISFORM.AV18Audobs = "Actualización de datos de " + THISFORM.A610GruCod + " " + THISFORM.A611GruDsc
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_58insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_58insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_58insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_58insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT55A610 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_58insert = .F.
               THISFORM.gx_insert = THISFORM. gx_58insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T00552,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA609GruTip = THISFORM.A609GruTip
            Gx_err = GX_DB_SetStr( HStmt_T00552,2,AuxA609GruTip,2,0)
            THISFORM.A609GruTip = AuxA609GruTip
            AuxA610GruCod = THISFORM.A610GruCod
            Gx_err = GX_DB_SetStr( HStmt_T00552,3,AuxA610GruCod,3,0)
            THISFORM.A610GruCod = AuxA610GruCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00552) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00552 = Gx_err
            THISFORM.GX_DB_GetT00552_01 ()
            IF .NOT. THISFORM.T00552 <> 103
               DO GX_ERRMW WITH "GRUPO reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00552 = 101 .OR. THISFORM.Z611GruDsc <> THISFORM.Buf_T00552_611GruDsc
               DO GX_ERRMW WITH "GRUPO fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00555" , @HStmt_T00555 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TGRUPOS","T00555","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00555) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [GRUPO] ([GruTip], [EmpCod], [GruCod], [GruDsc], [GruNim], [ActCod]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ' ', convert(int, 0)) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00555,cmdbuf)
                  THISFORM.GX_DB_BindParmT00555_01 ()
               ENDIF
               AuxA609GruTip = THISFORM.A609GruTip
               Gx_err = GX_DB_SetStr( HStmt_T00555,1,AuxA609GruTip,2,0)
               THISFORM.A609GruTip = AuxA609GruTip
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00555,2,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA610GruCod = THISFORM.A610GruCod
               Gx_err = GX_DB_SetStr( HStmt_T00555,3,AuxA610GruCod,3,0)
               THISFORM.A610GruCod = AuxA610GruCod
               AuxA611GruDsc = THISFORM.A611GruDsc
               Gx_err = GX_DB_SetStr( HStmt_T00555,4,AuxA611GruDsc,40,0)
               THISFORM.A611GruDsc = AuxA611GruDsc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00555) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00555 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00555) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00555 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00556" , @HStmt_T00556 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TGRUPOS","T00556","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00556) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [GRUPO] SET [GruDsc]=?  WHERE [EmpCod] = ? AND [GruTip] = ? AND [GruCod] = "
                  cmdbuf = cmdbuf + "  ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00556,cmdbuf)
                  THISFORM.GX_DB_BindParmT00556_01 ()
               ENDIF
               AuxA611GruDsc = THISFORM.A611GruDsc
               Gx_err = GX_DB_SetStr( HStmt_T00556,1,AuxA611GruDsc,40,0)
               THISFORM.A611GruDsc = AuxA611GruDsc
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00556,2,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA609GruTip = THISFORM.A609GruTip
               Gx_err = GX_DB_SetStr( HStmt_T00556,3,AuxA609GruTip,2,0)
               THISFORM.A609GruTip = AuxA609GruTip
               AuxA610GruCod = THISFORM.A610GruCod
               Gx_err = GX_DB_SetStr( HStmt_T00556,4,AuxA610GruCod,3,0)
               THISFORM.A610GruCod = AuxA610GruCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00556) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00556 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00556) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00557" , @HStmt_T00557 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TGRUPOS","T00557","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00557) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [GRUPO]  WHERE [EmpCod] = ? AND [GruTip] = ? AND [GruCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00557,cmdbuf)
                  THISFORM.GX_DB_BindParmT00557_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00557,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA609GruTip = THISFORM.A609GruTip
               Gx_err = GX_DB_SetStr( HStmt_T00557,2,AuxA609GruTip,2,0)
               THISFORM.A609GruTip = AuxA609GruTip
               AuxA610GruCod = THISFORM.A610GruCod
               Gx_err = GX_DB_SetStr( HStmt_T00557,3,AuxA610GruCod,3,0)
               THISFORM.A610GruCod = AuxA610GruCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00557) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00557 = Gx_err
               THISFORM.T00552 = iif( THISFORM.T00557 = 0 , 104 , THISFORM.T00557 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00557) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = THISFORM.A609GruTip + THISFORM.A610GruCod
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "TABL" , Aux1 , "GRUP" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT55V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 58 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
