            Gx_err = GX_DB_SetInt( HStmt_T00832,6,@AuxA749OPrSLt,0)
            THISFORM.A749OPrSLt = AuxA749OPrSLt
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00832) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00832 = Gx_err
            THISFORM.GX_DB_GetT00832_01 ()
            IF .NOT. THISFORM.T00832 <> 103
               DO GX_ERRMW WITH "OPROD reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00832 = 101 .OR. THISFORM.Z756OprPri <> THISFORM.Buf_T00832_756OprPri
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z757OPrRes <> THISFORM.Buf_T00832_757OPrRes
               DO GX_ERRMW WITH "OPROD fue modificada."
               RETURN .F.
            ENDIF
