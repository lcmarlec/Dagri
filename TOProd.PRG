      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T00832,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA745OPrFam = THISFORM.A745OPrFam
            Gx_err = GX_DB_SetInt( HStmt_T00832,2,@AuxA745OPrFam,0)
            THISFORM.A745OPrFam = AuxA745OPrFam
            AuxA746OprFam = THISFORM.A746OprFam
            Gx_err = GX_DB_SetInt( HStmt_T00832,3,@AuxA746OprFam,0)
            THISFORM.A746OprFam = AuxA746OprFam
