      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06552" , @HStmt_W06552 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WNOFACOK","W06552","",GX_CURSOR_TYPE_READONLY,@HStmt_W06552) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntNoFac], [EntDom], [EntCont], [EntFan], [EntCui], [EntRaz], [EntCod], "
                  cmdbuf = cmdbuf + "  [EntGruTip] FROM [ENTID] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND ([EntNoFac] "
                  cmdbuf = cmdbuf + "  = 1) AND ([EntCod] >= ?) AND ([EntCont] like ?) AND ([EntCui] = ? or ? = 0) AND "
                  cmdbuf = cmdbuf + "  ([EntDom] like ?) AND ([EntFan] like ?) AND ([EntRaz] like ?) AND ([EntGruTip] = "
                  cmdbuf = cmdbuf + "  'CL' and ? > 0 or [EntGruTip] = 'PR' and ? > 0) ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06552,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06552,13)
                  THISFORM.GX_DB_BindColsW06552_01 ()
                  THISFORM.GX_DB_BindParmW06552_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06552,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV13Entcod = THISFORM.AV13Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06552,2,@AuxAV13Entcod,0)
               THISFORM.AV13Entcod = AuxAV13Entcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06552,3,PADR( TRIM(THISFORM.AV17Entcon),40, '%'),LEN(PADR( TRIM(THISFORM.AV17Entcon),40, '%')),0)
               AuxAV16Entcui = THISFORM.AV16Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06552,4,@AuxAV16Entcui,0)
               THISFORM.AV16Entcui = AuxAV16Entcui
               AuxAV16Entcui = THISFORM.AV16Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06552,5,@AuxAV16Entcui,0)
               THISFORM.AV16Entcui = AuxAV16Entcui
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06552,6,PADR( TRIM(THISFORM.AV18Entdom),40, '%'),LEN(PADR( TRIM(THISFORM.AV18Entdom),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06552,7,PADR( TRIM(THISFORM.AV15Entfan),40, '%'),LEN(PADR( TRIM(THISFORM.AV15Entfan),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06552,8,PADR( TRIM(THISFORM.AV14Entraz),40, '%'),LEN(PADR( TRIM(THISFORM.AV14Entraz),40, '%')),0)
               AuxAV22Nivcli = THISFORM.AV22Nivcli
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06552,9,@AuxAV22Nivcli,0)
               THISFORM.AV22Nivcli = AuxAV22Nivcli
               AuxAV23Nivprv = THISFORM.AV23Nivprv
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06552,10,@AuxAV23Nivprv,0)
               THISFORM.AV23Nivprv = AuxAV23Nivprv
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06552) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06552 = Gx_err
               THISFORM.GX_DB_GetW06552_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WNoFacOk"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06552 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06552) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06552 = Gx_err
                  THISFORM.GX_DB_GetW06552_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06552 <> 101
               BRKVI72 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W06552_2EmpCod
               THISFORM.A1963EntNo = THISFORM.Buf_W06552_1963EntNoFac
               THISFORM.A156EntDom = THISFORM.Buf_W06552_156EntDom
               THISFORM.A155EntCon = THISFORM.Buf_W06552_155EntCont
               THISFORM.A154EntFan = THISFORM.Buf_W06552_154EntFan
               THISFORM.A166EntCui = THISFORM.Buf_W06552_166EntCui
               THISFORM.A153EntRaz = THISFORM.Buf_W06552_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W06552_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W06552_150EntGruTip
               GX_SFLOAD = 0
               THISFORM.U17VI72 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06552) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06552 = Gx_err
               THISFORM.GX_DB_GetW06552_01 ()
            ENDDO
         ENDIF
