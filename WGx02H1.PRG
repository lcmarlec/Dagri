         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A210PCtaDe"
         THISFORM.cCW233S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW233S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW233S20 .GX_lastkey = 9.or. THISFORM.cCW233S20 .GX_lastkey = 13)
