            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW233S20 = GETE('z:\temp') + '\' + SCW233S20
            ENDIF
            CREATE DBF (SCW233S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW233S20) EXCLUSIVE ALIAS SCW233S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW233S20
         THIS.GX_SfAlias = "SCW233S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02332" , @HStmt_W02332 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02H1","W02332","",GX_CURSOR_TYPE_READONLY,@HStmt_W02332) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PCtaPGA], [PCtaPGE], [PCtaPGN], [PCtaREI], [PCtaRPT], [PCtaDes], "
                  cmdbuf = cmdbuf + "  [PCtaNro] FROM [PCTA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [PCtaNro] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([PCtaPGA] like ?) AND ([PCtaPGE] like ?) AND ([PCtaPGN] >= ?) AND ([PCtaREI] "
                  cmdbuf = cmdbuf + "  like ?) AND ([PCtaRPT] like ?) ORDER BY [EmpCod], [PCtaNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02332,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02332,9)
                  THISFORM.GX_DB_BindColsW02332_01 ()
                  THISFORM.GX_DB_BindParmW02332_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02332,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C198 = THISFORM.AV5C198
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02332,2,@AuxAV5C198,0)
               THISFORM.AV5C198 = AuxAV5C198
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02332,3,PADR( TRIM(THISFORM.AV6C211),12, '%'),LEN(PADR( TRIM(THISFORM.AV6C211),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02332,4,PADR( TRIM(THISFORM.AV7C212),12, '%'),LEN(PADR( TRIM(THISFORM.AV7C212),12, '%')),0)
               AuxAV8C788 = THISFORM.AV8C788
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02332,5,@AuxAV8C788,0)
               THISFORM.AV8C788 = AuxAV8C788
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02332,6,PADR( TRIM(THISFORM.AV9C213),12, '%'),LEN(PADR( TRIM(THISFORM.AV9C213),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02332,7,PADR( TRIM(THISFORM.AV10C214),12, '%'),LEN(PADR( TRIM(THISFORM.AV10C214),12, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02332 = Gx_err
               THISFORM.GX_DB_GetW02332_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02332 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02332) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02332 = Gx_err
                  THISFORM.GX_DB_GetW02332_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02332 <> 101
               BRKV6H2 = .F.
               THISFORM.A211PCtaPG = THISFORM.Buf_W02332_211PCtaPGA
               THISFORM.A212PCtaPG = THISFORM.Buf_W02332_212PCtaPGE
               THISFORM.A788PCtaPG = THISFORM.Buf_W02332_788PCtaPGN
               THISFORM.A213PCtaRE = THISFORM.Buf_W02332_213PCtaREI
               THISFORM.A214PCtaRP = THISFORM.Buf_W02332_214PCtaRPT
               THISFORM.A210PCtaDe = THISFORM.Buf_W02332_210PCtaDes
               THISFORM.A198PCtaNr = THISFORM.Buf_W02332_198PCtaNro
               GX_SFLOAD = 0
               THISFORM.U12V6H2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02332 = Gx_err
               THISFORM.GX_DB_GetW02332_01 ()
            ENDDO
         ENDIF
      ENDPROC
