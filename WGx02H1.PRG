         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW233S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA198PCtaN"
