                  cmdbuf = cmdbuf + "  [bonCArtCod], [bonCfamS], [bonCfam] FROM [BONIFIC2] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? and [EntGruTip] = ? and [EntCod] = ? and [bonfde] = ? and [bonfam] "
                  cmdbuf = cmdbuf + "  = ? and [bonfams] = ? and [bonartcod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [bonfde], [bonfam], [bonfams], [bonartcod], [bonCfam], [bonCfamS], [bonCArtCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11032,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11032,9)
                  THISFORM.GX_DB_BindColsW11032_01 ()
                  THISFORM.GX_DB_BindParmW11032_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
