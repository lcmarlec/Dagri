               THISFORM.A3248bonfa = AuxA3248bonfa
               AuxA3249bonfa = THISFORM.A3249bonfa
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11032,6,@AuxA3249bonfa,0)
               THISFORM.A3249bonfa = AuxA3249bonfa
               AuxA3250bonar = THISFORM.A3250bonar
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11032,7,@AuxA3250bonar,0)
               THISFORM.A3250bonar = AuxA3250bonar
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11032 = Gx_err
               THISFORM.GX_DB_GetW11032_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11032 = Gx_err
                  THISFORM.GX_DB_GetW11032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11032 <> 101
               BRKVUN2 = .F.
               THISFORM.A3257bonCA = THISFORM.Buf_W11032_3257bonCArtCod
