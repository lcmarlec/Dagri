            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "VAV27Reser"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 14
            GX_STRUCT[ 6 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW1108S15 = GETE('z:\temp') + '\' + SCW1108S15
            ENDIF
            CREATE DBF (SCW1108S15) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1108S15) EXCLUSIVE ALIAS SCW1108S15
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1108S15
         THIS.GX_SfAlias = "SCW1108S15"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV27Reserv = 0.00
               GX_SFLOAD = 0
               THISFORM.U14VUS2 ()
