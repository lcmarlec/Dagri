         IF USED( "SCW1108S15" )
            SELECT SCW1108S15
            SCW1108S15 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1108S15
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "VAV21Artco"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV30Artco"
