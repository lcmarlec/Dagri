            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03642) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03642 = Gx_err
            THISFORM.GX_DB_GetT03642_01 ()
            IF .NOT. THISFORM.T03642 <> 103
               DO GX_ERRMW WITH "RECIBOS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03642 = 101 .OR. THISFORM.Z859RCVFch <> THISFORM.Buf_T03642_859RCVFch
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1468RCVOb <> THISFORM.Buf_T03642_1468RCVObs
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1213RcvFc <> THISFORM.Buf_T03642_1213RcvFchCli
               DO GX_ERRMW WITH "RECIBOS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
