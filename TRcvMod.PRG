               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_96insert
            THISFORM. gx_96insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 96 )
            THISFORM. cCT364V9 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 96
            THISFORM.SetLevel( 96 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT364V9 .InitLevel( 96 )
            THISFORM.GX_last_fld_lvl = 96
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
