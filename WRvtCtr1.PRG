      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08313" , @HStmt_W08313 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTCTR1","W08313","",GX_CURSOR_TYPE_READONLY,@HStmt_W08313) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[RVtEntLgCo] AS RVtEntLgCo, T1.[EmpCod], T1.[RVtNroInt], T2.[RVtPedNro], "
                  cmdbuf = cmdbuf + "  T2.[RVtSuc], T2.[RVtNro], T2.[RVtEntGruT] AS RVtEntGruT, T2.[RVtEntCod] AS RVtEntCod, "
                  cmdbuf = cmdbuf + "  T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T5.[ArtDsc], T1.[RVtPrc], T1.[RVtPrcReal], "
                  cmdbuf = cmdbuf + "  T1.[RVtLin], T1.[RvtCntOri], T1.[RVtCnt], T4.[EntLgDom], T2.[RVtEst], T2.[RVtFch], "
                  cmdbuf = cmdbuf + "  T3.[EntRaz] AS RVtEntRaz FROM (((([REMVTA1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [REMVTA] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[RVtNroInt] = T1.[RVtNroInt]) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T2.[RVtEntGruT] "
                  cmdbuf = cmdbuf + "  AND T3.[EntCod] = T2.[RVtEntCod]) LEFT JOIN [CLTES] T4 (NOLOCK) ON T4.[EmpCod] = "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] AND T4.[EntGruTip] = T2.[RVtEntGruT] AND T4.[EntCod] = T2.[RVtEntCod] "
                  cmdbuf = cmdbuf + "  AND T4.[EntLgCod] = T2.[RVtEntLgCo]) LEFT JOIN [ARTICS] T5 (NOLOCK) ON T5.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T5.[FamCod] = T1.[FamCod] AND T5.[FamSubCod] = T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  AND T5.[ArtCod] = T1.[ArtCod]) WHERE T1.[EmpCod] = ? and T1.[RVtNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[RVtNroInt], T1.[RVtLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08313,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08313,11)
                  THISFORM.GX_DB_BindColsW08313_01 ()
                  THISFORM.GX_DB_BindParmW08313_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08313,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Ni = THISFORM.AV19Ni
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08313,2,@AuxAV19Ni,0)
               THISFORM.AV19Ni = AuxAV19Ni
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08313) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08313 = Gx_err
               THISFORM.GX_DB_GetW08313_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV57Pgmnam = "WRvtCtr1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08313 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08313 <> 101
               BRKVN32 = .F.
               THISFORM.AV48Famcod = 0
               THISFORM.AV49Famsub = 0
               THISFORM.AV50Artcod = 0
               THISFORM.AV51Artdsc = SPACE(50)
               THISFORM.AV29Rvtcnt = 0.0000
               THISFORM.AV52Artvta = 0.0000
               THISFORM.AV53Artvta = 0.0000
               THISFORM.AV46Difmot = 0
               THISFORM.A912RVtEnt = THISFORM.Buf_W08313_912RVtEntLgCo
               THISFORM.A2EmpCod = THISFORM.Buf_W08313_2EmpCod
               THISFORM.A908RVtNro = THISFORM.Buf_W08313_908RVtNroInt
               THISFORM.A921RVtPed = THISFORM.Buf_W08313_921RVtPedNro
               THISFORM.A913RVtSuc = THISFORM.Buf_W08313_913RVtSuc
               THISFORM.A914RVtNro = THISFORM.Buf_W08313_914RVtNro
               THISFORM.A909RVtEnt = THISFORM.Buf_W08313_909RVtEntGruT
               THISFORM.A910RVtEnt = THISFORM.Buf_W08313_910RVtEntCod
               THISFORM.A5ArtCod = THISFORM.Buf_W08313_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W08313_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W08313_3FamCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W08313_6ArtDsc
               THISFORM.A930RVtPrc = THISFORM.Buf_W08313_930RVtPrc
               THISFORM.A1332RVtPr = THISFORM.Buf_W08313_1332RVtPrcReal
               THISFORM.A928RVtLin = THISFORM.Buf_W08313_928RVtLin
               THISFORM.A2577RvtCn = THISFORM.Buf_W08313_2577RvtCntOri
               THISFORM.A929RVtCnt = THISFORM.Buf_W08313_929RVtCnt
               THISFORM.A178EntLgD = THISFORM.Buf_W08313_178EntLgDom
               THISFORM.A917RVtEst = THISFORM.Buf_W08313_917RVtEst
               THISFORM.A915RVtFch = THISFORM.Buf_W08313_915RVtFch
               THISFORM.A911RVtEnt = THISFORM.Buf_W08313_911RVtEntRaz
               THISFORM.A912RVtEnt = THISFORM.Buf_W08313_912RVtEntLgCo
               THISFORM.A921RVtPed = THISFORM.Buf_W08313_921RVtPedNro
               THISFORM.A913RVtSuc = THISFORM.Buf_W08313_913RVtSuc
               THISFORM.A914RVtNro = THISFORM.Buf_W08313_914RVtNro
               THISFORM.A909RVtEnt = THISFORM.Buf_W08313_909RVtEntGruT
               THISFORM.A910RVtEnt = THISFORM.Buf_W08313_910RVtEntCod
               THISFORM.A917RVtEst = THISFORM.Buf_W08313_917RVtEst
               THISFORM.A915RVtFch = THISFORM.Buf_W08313_915RVtFch
               THISFORM.A911RVtEnt = THISFORM.Buf_W08313_911RVtEntRaz
               THISFORM.A178EntLgD = THISFORM.Buf_W08313_178EntLgDom
               THISFORM.A6ArtDsc = THISFORM.Buf_W08313_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U16VN32 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKVN32
                  BRKVN32 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08313) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08313 = Gx_err
                  THISFORM.GX_DB_GetW08313_01 ()
               ENDIF
            ENDDO
         ENDIF
