               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT305V15 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         THISFORM. cCT305S2 .GX_focusInGrid = .T.
         IF THISFORM.GX_Mode != "INS"
            THISFORM. cCT305S2 . AfterRowColChange1()
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 337
            THISFORM.SetLevel( 337 )
            THISFORM.SetMode("", "1" )
            THISFORM. cCT305V11 .InitLevel( 337 )
            THISFORM.GX_last_fld_lvl = 337
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2915McoFc"
         THISFORM.cCT305S2 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCT305S2 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCT305S2 .GX_lastkey = 9.or. THISFORM.cCT305S2 .GX_lastkey = 13)
