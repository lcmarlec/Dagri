         SELECT (THIS.GX_SfAlias)
         REPLACE sA2911McoT WITH THISFORM.cCT305S2.Columns(1).Ctrl1.ValToText(THISFORM.M2911McoTi)
         REPLACE sA2912McoS WITH THISFORM.cCT305S2.Columns(2).Ctrl1.ValToText(THISFORM.M2912McoSe)
         REPLACE sA2913McoS WITH THISFORM.M2913McoSu
         REPLACE sA2914McoN WITH THISFORM.M2914McoNr
         REPLACE sA2915McoF WITH THISFORM.M2915McoFc
         THIS.Column1.Ctrl1.Value = THISFORM.cCT305S2.Columns(1).Ctrl1.ValToText(THISFORM.M2911McoTi)
         THIS.Column2.Ctrl1.Value = THISFORM.cCT305S2.Columns(2).Ctrl1.ValToText(THISFORM.M2912McoSe)
         THIS.Column3.Ctrl1.Value = THISFORM.M2913McoSu
         THIS.Column4.Ctrl1.Value = THISFORM.M2914McoNr
         THIS.Column5.Ctrl1.Value = THISFORM.M2915McoFc
      ENDPROC
      PROCEDURE GXRefreshSf
         LOCAL gx_old_mode
         gx_old_mode = THISFORM.GX_Mode
         THISFORM.GX_Mode = "UPD"
         THIS.LoadSf(0)
         THIS.SaveKey()
         THISFORM.GX_Mode = GX_old_mode
      ENDPROC
      PROCEDURE ClearOutCtrls
         * Clear sf atts outside grid
      ENDPROC
   ENDDEFINE
