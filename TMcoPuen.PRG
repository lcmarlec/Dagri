      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03059" , @HStmt_T03059 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TMCOPUEN","T03059","",GX_CURSOR_TYPE_READONLY,@HStmt_T03059) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [McoNI], [MCoCod], [McoCli], [McoCuit], [McoTip], [McoSer], [McoSuc], "
                  cmdbuf = cmdbuf + "  [McoNro], [McoFch], [McoImp], [McoPMon], [Mcocotiz], [McoImpOri], [McoPrv], [McoFchReg], "
                  cmdbuf = cmdbuf + "  [McoNReg] FROM [MCOPUENT] (NOLOCK) WHERE ([EmpCod] = ? AND [McoNI] = ? AND [MCoCod] "
                  cmdbuf = cmdbuf + "  = ? AND [McoCuit] = ?) AND ([McoCli] = ?) ORDER BY [EmpCod], [McoNI], [MCoCod], "
                  cmdbuf = cmdbuf + "  [McoCuit], [McoTip], [McoSer], [McoSuc], [McoNro], [McoFch]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03059,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T03059,11)
                  THISFORM.GX_DB_BindColsT03059_01 ()
                  THISFORM.GX_DB_BindParmT03059_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03059,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2919McoNI = THISFORM.A2919McoNI
               Gx_err = GX_DB_SetDouble( HStmt_T03059,2,@AuxA2919McoNI,0)
               THISFORM.A2919McoNI = AuxA2919McoNI
               AuxA619MCoCod = THISFORM.A619MCoCod
               Gx_err = GX_DB_SetInt( HStmt_T03059,3,@AuxA619MCoCod,0)
               THISFORM.A619MCoCod = AuxA619MCoCod
               AuxA2910McoCu = THISFORM.A2910McoCu
               Gx_err = GX_DB_SetDouble( HStmt_T03059,4,@AuxA2910McoCu,0)
               THISFORM.A2910McoCu = AuxA2910McoCu
               AuxA2917McoCl = THISFORM.A2917McoCl
               Gx_err = GX_DB_SetLong( HStmt_T03059,5,@AuxA2917McoCl,0)
               THISFORM.A2917McoCl = AuxA2917McoCl
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03059) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03059 = Gx_err
               THISFORM.GX_DB_GetT03059_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T03059 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03059) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03059 = Gx_err
                  THISFORM.GX_DB_GetT03059_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T03059 <> 101
               BRK8H337 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT305S2.Columns(5).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T03059_2910McoCuit = THISFORM.A2910McoCu .AND. THISFORM.Buf_T03059_2917McoCli = THISFORM.A2917McoCl .AND. THISFORM.Buf_T03059_619MCoCod = THISFORM.A619MCoCod .AND. THISFORM.Buf_T03059_2919McoNI = THISFORM.A2919McoNI .AND. THISFORM.Buf_T03059_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03059) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03059 = Gx_err
               THISFORM.GX_DB_GetT03059_01 ()
            ENDDO
         ENDIF
      ENDPROC
