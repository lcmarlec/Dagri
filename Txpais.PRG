         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2095xPaiD"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl354
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_354insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_354insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_354insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_354insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT318A2080 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_354insert = .F.
               THISFORM.gx_insert = THISFORM. gx_354insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2080xPaiC = THISFORM.A2080xPaiC
            Gx_err = GX_DB_SetStr( HStmt_T03182,1,AuxA2080xPaiC,4,0)
            THISFORM.A2080xPaiC = AuxA2080xPaiC
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03182) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03182 = Gx_err
            THISFORM.GX_DB_GetT03182_01 ()
            IF .NOT. THISFORM.T03182 <> 103
               DO GX_ERRMW WITH "PAISES reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03182 = 101 .OR. THISFORM.Z2095xPaiD <> THISFORM.Buf_T03182_2095xPaiDsc
               DO GX_ERRMW WITH "PAISES fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03185" , @HStmt_T03185 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TXPAIS","T03185","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03185) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [paises] ([paicod], [paidsc]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03185,cmdbuf)
                  THISFORM.GX_DB_BindParmT03185_01 ()
               ENDIF
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T03185,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               AuxA2095xPaiD = THISFORM.A2095xPaiD
               Gx_err = GX_DB_SetStr( HStmt_T03185,2,AuxA2095xPaiD,40,0)
               THISFORM.A2095xPaiD = AuxA2095xPaiD
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03185) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03185 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03185) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03185 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03186" , @HStmt_T03186 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TXPAIS","T03186","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03186) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [paises] SET [paidsc]=?  WHERE [paicod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03186,cmdbuf)
                  THISFORM.GX_DB_BindParmT03186_01 ()
               ENDIF
               AuxA2095xPaiD = THISFORM.A2095xPaiD
               Gx_err = GX_DB_SetStr( HStmt_T03186,1,AuxA2095xPaiD,40,0)
               THISFORM.A2095xPaiD = AuxA2095xPaiD
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T03186,2,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03186) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03186 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03186) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03187" , @HStmt_T03187 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TXPAIS","T03187","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03187) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [paises]  WHERE [paicod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03187,cmdbuf)
                  THISFORM.GX_DB_BindParmT03187_01 ()
               ENDIF
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T03187,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03187) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03187 = Gx_err
               THISFORM.T03182 = iif( THISFORM.T03187 = 0 , 104 , THISFORM.T03187 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03187) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
