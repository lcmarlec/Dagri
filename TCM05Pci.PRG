      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T031511" , @HStmt_T031511 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCM05PCI","T031511","",GX_CURSOR_TYPE_READONLY,@HStmt_T031511) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EntCui], [EmpCod], [PaiCod], [CMAnio], [PciCod], [cmcoef] FROM [CM052] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [EntCui] = ? AND [CMAnio] = ? AND [PaiCod] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [EntCui], [CMAnio], [PaiCod], [PciCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T031511,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T031511,16)
                  THISFORM.GX_DB_BindColsT031511_01 ()
                  THISFORM.GX_DB_BindParmT031511_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T031511,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T031511,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               AuxA3011CMAni = THISFORM.A3011CMAni
               Gx_err = GX_DB_SetInt( HStmt_T031511,3,@AuxA3011CMAni,0)
               THISFORM.A3011CMAni = AuxA3011CMAni
               AuxA631PaiCod = THISFORM.A631PaiCod
               Gx_err = GX_DB_SetStr( HStmt_T031511,4,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T031511) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031511 = Gx_err
               THISFORM.GX_DB_GetT031511_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T031511 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031511) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T031511 = Gx_err
                  THISFORM.GX_DB_GetT031511_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T031511 <> 101
               BRK8R347 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT315S10.Columns(5).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T031511_3011CMAnio = THISFORM.A3011CMAni .AND. THISFORM.Buf_T031511_631PaiCod = THISFORM.A631PaiCod .AND. THISFORM.Buf_T031511_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T031511_166EntCui = THISFORM.A166EntCui
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031511) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031511 = Gx_err
               THISFORM.GX_DB_GetT031511_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A633PciCod"
            THISFORM.A633PciCod = THISFORM.Buf_T031511_633PciCod
