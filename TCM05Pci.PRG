               THISFORM.A633PciCod = S633PciCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT315S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT315S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S3011CMAni = THISFORM.A3011CMAni .AND. S631PaiCod = THISFORM.A631PaiCod .AND. S633PciCod = THISFORM.A633PciCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT315S10 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S3011CMAni = THISFORM.A3011CMAni .AND. S631PaiCod = THISFORM.A631PaiCod .AND. S633PciCod = THISFORM.A633PciCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT315S10 .AppendRow()
               THISFORM. cCT315S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A166EntCui = S166EntCui
               THISFORM.A3011CMAni = S3011CMAni
               THISFORM.A631PaiCod = S631PaiCod
               THISFORM.A633PciCod = S633PciCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A166EntCui = S166EntCui
         THISFORM.A3011CMAni = S3011CMAni
         THISFORM.A631PaiCod = S631PaiCod
