            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_203insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_203insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_203insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_203insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT191A1746 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_203insert = .F.
               THISFORM.gx_insert = THISFORM. gx_203insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T01912,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA150EntGru = THISFORM.A150EntGru
            Gx_err = GX_DB_SetStr( HStmt_T01912,2,AuxA150EntGru,2,0)
            THISFORM.A150EntGru = AuxA150EntGru
            AuxA120EntCod = THISFORM.A120EntCod
            Gx_err = GX_DB_SetLong( HStmt_T01912,3,@AuxA120EntCod,0)
            THISFORM.A120EntCod = AuxA120EntCod
            AuxA1746EntNr = THISFORM.A1746EntNr
            Gx_err = GX_DB_SetDouble( HStmt_T01912,4,@AuxA1746EntNr,0)
            THISFORM.A1746EntNr = AuxA1746EntNr
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01912) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01912 = Gx_err
            THISFORM.GX_DB_GetT01912_01 ()
            IF .NOT. THISFORM.T01912 <> 103
               DO GX_ERRMW WITH "PRVOBS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01912 = 101
               DO GX_ERRMW WITH "PRVOBS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01916" , @HStmt_T01916 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTOBSV","T01916","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01916) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [PRVOBS] ([EmpCod], [EntGruTip], [EntCod], [EntNroI], [EntFchHor], [EntObsusu], "
                  cmdbuf = cmdbuf + "  [EntObsAla], [EntObsFAI], [EntObsFAF]) VALUES (?, ?, ?, ?, convert( DATETIME, '17530101', "
                  cmdbuf = cmdbuf + "  112 ), ' ', convert(int, 0), convert( DATETIME, '17530101', 112 ), convert( DATETIME, "
                  cmdbuf = cmdbuf + "  '17530101', 112 )) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01916,cmdbuf)
                  THISFORM.GX_DB_BindParmT01916_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01916,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T01916,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T01916,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA1746EntNr = THISFORM.A1746EntNr
               Gx_err = GX_DB_SetDouble( HStmt_T01916,4,@AuxA1746EntNr,0)
               THISFORM.A1746EntNr = AuxA1746EntNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01916) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01916 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01916) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T01916 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01917" , @HStmt_T01917 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTOBSV","T01917","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01917) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [PRVOBS]  WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? AND "
                  cmdbuf = cmdbuf + "  [EntNroI] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01917,cmdbuf)
                  THISFORM.GX_DB_BindParmT01917_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01917,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T01917,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T01917,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA1746EntNr = THISFORM.A1746EntNr
               Gx_err = GX_DB_SetDouble( HStmt_T01917,4,@AuxA1746EntNr,0)
               THISFORM.A1746EntNr = AuxA1746EntNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01917) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01917 = Gx_err
               THISFORM.T01912 = iif( THISFORM.T01917 = 0 , 104 , THISFORM.T01917 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01917) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
