      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03755" , @HStmt_T03755 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVMAIL","T03755","",GX_CURSOR_TYPE_READONLY,@HStmt_T03755) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntMId], [EntMCon], [EntMTpo], [EntMail] "
            cmdbuf = cmdbuf + "  FROM [CLTEMAIL] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [EntGruTip] = ? and "
            cmdbuf = cmdbuf + "  [EntCod] = ? and [EntMId] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], [EntMId] "
            cmdbuf = cmdbuf + "   "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03755,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T03755,100)
            THISFORM.GX_DB_BindColsT03755_01 ()
            THISFORM.GX_DB_BindParmT03755_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
