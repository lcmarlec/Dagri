      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03752,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA150EntGru = THISFORM.A150EntGru
            Gx_err = GX_DB_SetStr( HStmt_T03752,2,AuxA150EntGru,2,0)
            THISFORM.A150EntGru = AuxA150EntGru
            AuxA120EntCod = THISFORM.A120EntCod
            Gx_err = GX_DB_SetLong( HStmt_T03752,3,@AuxA120EntCod,0)
            THISFORM.A120EntCod = AuxA120EntCod
            AuxA3223EntMI = THISFORM.A3223EntMI
            Gx_err = GX_DB_SetInt( HStmt_T03752,4,@AuxA3223EntMI,0)
            THISFORM.A3223EntMI = AuxA3223EntMI
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03752) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03752 = Gx_err
            THISFORM.GX_DB_GetT03752_01 ()
            IF .NOT. THISFORM.T03752 <> 103
               DO GX_ERRMW WITH "CLTEMAIL reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03752 = 101 .OR. THISFORM.Z3224EntMC <> THISFORM.Buf_T03752_3224EntMCon
               DO GX_ERRMW WITH "CLTEMAIL fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03756" , @HStmt_T03756 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVMAIL","T03756","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03756) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CLTEMAIL] ([EmpCod], [EntGruTip], [EntCod], [EntMId], [EntMCon], [EntMTpo], "
                  cmdbuf = cmdbuf + "  [EntMail]) VALUES (?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03756,cmdbuf)
                  THISFORM.GX_DB_BindParmT03756_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03756,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T03756,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T03756,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA3223EntMI = THISFORM.A3223EntMI
               Gx_err = GX_DB_SetInt( HStmt_T03756,4,@AuxA3223EntMI,0)
               THISFORM.A3223EntMI = AuxA3223EntMI
               AuxA3224EntMC = THISFORM.A3224EntMC
               Gx_err = GX_DB_SetStr( HStmt_T03756,5,AuxA3224EntMC,40,0)
               THISFORM.A3224EntMC = AuxA3224EntMC
               AuxA3304EntMT = THISFORM.A3304EntMT
               Gx_err = GX_DB_SetStr( HStmt_T03756,6,AuxA3304EntMT,1,0)
               THISFORM.A3304EntMT = AuxA3304EntMT
               AuxA3225EntMa = THISFORM.A3225EntMa
               Gx_err = GX_DB_SetStr( HStmt_T03756,7,AuxA3225EntMa,100,0)
               THISFORM.A3225EntMa = AuxA3225EntMa
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03756) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03756 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03756) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03756 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03757" , @HStmt_T03757 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVMAIL","T03757","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03757) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [CLTEMAIL] SET [EntMCon]=?, [EntMTpo]=?, [EntMail]=?  WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [EntGruTip] = ? AND [EntCod] = ? AND [EntMId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03757,cmdbuf)
                  THISFORM.GX_DB_BindParmT03757_01 ()
               ENDIF
               AuxA3224EntMC = THISFORM.A3224EntMC
               Gx_err = GX_DB_SetStr( HStmt_T03757,1,AuxA3224EntMC,40,0)
               THISFORM.A3224EntMC = AuxA3224EntMC
               AuxA3304EntMT = THISFORM.A3304EntMT
               Gx_err = GX_DB_SetStr( HStmt_T03757,2,AuxA3304EntMT,1,0)
               THISFORM.A3304EntMT = AuxA3304EntMT
               AuxA3225EntMa = THISFORM.A3225EntMa
               Gx_err = GX_DB_SetStr( HStmt_T03757,3,AuxA3225EntMa,100,0)
               THISFORM.A3225EntMa = AuxA3225EntMa
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03757,4,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T03757,5,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T03757,6,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA3223EntMI = THISFORM.A3223EntMI
               Gx_err = GX_DB_SetInt( HStmt_T03757,7,@AuxA3223EntMI,0)
               THISFORM.A3223EntMI = AuxA3223EntMI
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03757) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03757 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03757) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03758" , @HStmt_T03758 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVMAIL","T03758","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03758) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CLTEMAIL]  WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? AND "
                  cmdbuf = cmdbuf + "  [EntMId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03758,cmdbuf)
                  THISFORM.GX_DB_BindParmT03758_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03758,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T03758,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T03758,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA3223EntMI = THISFORM.A3223EntMI
               Gx_err = GX_DB_SetInt( HStmt_T03758,4,@AuxA3223EntMI,0)
               THISFORM.A3223EntMI = AuxA3223EntMI
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03758) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03758 = Gx_err
               THISFORM.T03752 = iif( THISFORM.T03758 = 0 , 104 , THISFORM.T03758 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03758) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A120EntCod , 6 ) + "/" + str( THISFORM.A3223EntMI , 3 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "MAES" , Aux1 , "MAILPR" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT375V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 368 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
