                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[DcVEntGruT] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntCod] AND T3.[EntLgCod] = T1.[DcVEntLgCo]) WHERE (T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[DcVFch] >= ?) AND (T1.[DcvSegEst] >= ?) AND (T1.[DcvSegEst] > 0 or ? = 0) AND "
                  cmdbuf = cmdbuf + "  (T1.[DcvSegEst] = ? or ( ? = -1 and T1.[DcvSegEst] > 0)) AND (T1.[DcVEst] > 0) AND "
                  cmdbuf = cmdbuf + "  (T1.[DcVEst] < 9) AND (T1.[DcVNro] >= ?) AND (T1.[DcVSuc] = ? or ? = 0) AND (T1.[DcvTipRed] "
                  cmdbuf = cmdbuf + "  = 'FC') AND (T1.[DcVSer] <> 'B') AND (T1.[DcVFch] <= ?) ORDER BY T1.[EmpCod], T1.[DcVFch], "
                  cmdbuf = cmdbuf + "  T1.[DcVSer], T1.[DcVSuc], T1.[DcVNro], T1.[DcVTip]  "
