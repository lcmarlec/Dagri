      PROCEDURE KeyPress
         LPARAMETERS gxKeyCode, gxShiftCtrlAlt
         THISFORM.gx_frmReadkey = gxKeyCode
         DO CASE
            CASE gxKeyCode = 29   && First
               THIS. DoFirst()
            CASE gxKeyCode = 31   && Previous
               THIS. DoPrevious()
            CASE gxKeyCode = 30   && Next
               THIS. DoNext()
            CASE gxKeyCode = 23   && Last
               THIS. DoLast()
            CASE gxKeyCode = 27   && Escape
               IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
                  RETURN
               ENDIF
               gx_a_trn = .F.
               IF THISFORM.GX_after_trn != 0
                  Response = .T.
                  DO GX_CONFW WITH 'Confirma la transacción?' , Response
                  Gx_ucfrm  = .T.
                  IF .NOT. Response
                     * Rollback TRANSACTION
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01233) , "TCHQ3MOD" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01232) , "TCHQ3MOD" )
