            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl = 14
            IF ! THISFORM. gx_14insert
               THISFORM.SetLevel( 14 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
