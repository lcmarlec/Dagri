                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01237) , "TCHQ3MOD" )
                     IF TYPE( "HConn_Default" ) = "N"
                        IF GXCONNECTED
                           Gx_Err = Gx_odbc_mrc( GX_DB_ConnRollback(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                        ENDIF
                     ENDIF
                  ELSE
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01233) , "TCHQ3MOD" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01232) , "TCHQ3MOD" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01234) , "TCHQ3MOD" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01235) , "TCHQ3MOD" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01236) , "TCHQ3MOD" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01237) , "TCHQ3MOD" )
                     IF TYPE( "HConn_Default" ) = "N"
                        IF GXCONNECTED
                           Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                        ENDIF
                     ENDIF
                     THISFORM. cCT123A2806 .AfterTrn()
                     DO CASE
                        CASE THISFORM.GX_Mode = "INS"
                           THISFORM.ReleaseAll()
                        CASE THISFORM.GX_Mode = "UPD"
                           THISFORM.ReleaseAll()
                        CASE THISFORM.GX_Mode = "DLT"
                           THISFORM.ReleaseAll()
                     ENDCASE
                  ENDIF
                  IF THISFORM.GX_Exit_GotFocus
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
