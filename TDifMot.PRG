                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01575,cmdbuf)
                  THISFORM.GX_DB_BindParmT01575_01 ()
               ENDIF
               AuxA1565DifMo = THISFORM.A1565DifMo
               Gx_err = GX_DB_SetInt( HStmt_T01575,1,@AuxA1565DifMo,0)
               THISFORM.A1565DifMo = AuxA1565DifMo
               AuxA1566DifMo = THISFORM.A1566DifMo
