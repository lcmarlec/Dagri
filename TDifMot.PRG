            Gx_longc = .F.
            IF THISFORM.T01572 = 101 .OR. THISFORM.Z1566DifMo <> THISFORM.Buf_T01572_1566DifMotDsc
               DO GX_ERRMW WITH "DIFMOT fue modificada."
               RETURN .F.
