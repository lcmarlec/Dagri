               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01576) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01577" , @HStmt_T01577 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDIFMOT","T01577","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01577) ,  ,  ,  , CS_SQLSRV , 0 )
