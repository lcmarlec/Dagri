               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01575) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01575 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01575) ,  ,  ,  , CS_SQLSRV , 0 )
