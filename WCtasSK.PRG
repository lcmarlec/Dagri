      PROCEDURE CreateTemp
         LOCAL SCW26S8
         SCW26S8 = ""
         IF USED( "SCW26S8" )
            SELECT SCW26S8
            SCW26S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW26S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA76BcoCta"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA77BcoCta"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA87BcoDsc"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA78BcoSuc"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW26S8 = GETE('z:\temp') + '\' + SCW26S8
            ENDIF
            CREATE DBF (SCW26S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW26S8) EXCLUSIVE ALIAS SCW26S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW26S8
         THIS.GX_SfAlias = "SCW26S8"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00262" , @HStmt_W00262 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCTASSK","W00262","",GX_CURSOR_TYPE_READONLY,@HStmt_W00262) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[BcoCod], T1.[BcoSuc], T2.[BcoDsc], T1.[BcoCtaNro], T1.[BcoCta] FROM ([CTAS] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[BcoCod]) "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[BcoCta]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00262,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00262,15)
                  THISFORM.GX_DB_BindColsW00262_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00262 = Gx_err
               THISFORM.GX_DB_GetW00262_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV15Pgmnam = "WCtasSK"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00262 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00262) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00262 = Gx_err
                  THISFORM.GX_DB_GetW00262_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00262 <> 101
               BRKV0Q2 = .F.
               THISFORM.A86BcoCod = THISFORM.Buf_W00262_86BcoCod
               THISFORM.A78BcoSuc = THISFORM.Buf_W00262_78BcoSuc
               THISFORM.A87BcoDsc = THISFORM.Buf_W00262_87BcoDsc
               THISFORM.A77BcoCtaN = THISFORM.Buf_W00262_77BcoCtaNro
               THISFORM.A76BcoCta = THISFORM.Buf_W00262_76BcoCta
               THISFORM.A87BcoDsc = THISFORM.Buf_W00262_87BcoDsc
               GX_SFLOAD = 0
               THISFORM.U14V0Q2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00262 = Gx_err
               THISFORM.GX_DB_GetW00262_01 ()
            ENDDO
         ENDIF
      ENDPROC
