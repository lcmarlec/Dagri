         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2926IMpEx"
            THISFORM.A2926IMpEx = THISFORM.Buf_T005713_2926IMpExcObs
         ENDIF
      ENDPROC
