      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T005713" , @HStmt_T005713 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TIMPUES","T005713","",GX_CURSOR_TYPE_READONLY,@HStmt_T005713) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [ImpCod], [ImpExcDde], [ImpExcHta], [IMpExcObs] FROM [IMPUES1] (NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [ImpCod] = ? ORDER BY [ImpCod], [ImpExcDde]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T005713,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T005713,9)
                  THISFORM.GX_DB_BindColsT005713_01 ()
                  THISFORM.GX_DB_BindParmT005713_01 ()
               ENDIF
               AuxA613ImpCod = THISFORM.A613ImpCod
               Gx_err = GX_DB_SetStr( HStmt_T005713,1,AuxA613ImpCod,6,0)
               THISFORM.A613ImpCod = AuxA613ImpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T005713) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T005713 = Gx_err
               THISFORM.GX_DB_GetT005713_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T005713 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T005713) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T005713 = Gx_err
                  THISFORM.GX_DB_GetT005713_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T005713 <> 101
               BRK1L338 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT57S26.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T005713) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T005713 = Gx_err
               THISFORM.GX_DB_GetT005713_01 ()
            ENDDO
         ENDIF
      ENDPROC
