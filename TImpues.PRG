      PROCEDURE CreateTemp
         LOCAL SCT57S26
         SCT57S26 = ""
         IF USED( "SCT57S26" )
            SELECT SCT57S26
            SCT57S26 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT57S26
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2924ImpE"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2925ImpE"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2926IMpE"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 100
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT57S26 = GETE('z:\temp') + '\' + SCT57S26
            ENDIF
            CREATE DBF (SCT57S26) FROM ARRAY GX_STRUCT
            USE
            USE (SCT57S26) EXCLUSIVE ALIAS SCT57S26
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT57S26
         THIS.GX_SfAlias = "SCT57S26"
      ENDPROC
