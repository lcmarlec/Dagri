       DisabledForeColor= RGB(127,127,127)
       DisabledBackColor = GetSysColor(5)
       FontName = "Courier New"
       FontSize = 9
       FontBold = .F.
      SpecialEffect = 0
      BackStyle = 1
      Alignment = 1
      HelpContextId = 262156
      GX_CUPOS = 0
      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.AV10Vpreci
         CGXTextBox ::Init
         THIS.GX_OldValue = THISFORM.AV10Vpreci
         THIS.GX_Level = 2
      ENDPROC
      PROCEDURE InitLevel
         LPARAMETER gxILvl
         LOCAL gx_oMode
         IF gxILvl != 2
            RETURN .T.
         ENDIF
         THISFORM.AV16Pgmnam = "WCampre"
         THISFORM.Gx_err = 0
         THISFORM.gx_lastvld = THIS.GxObjOrder-1
         RETURN .T.
      ENDPROC
      PROCEDURE GotFocus
         CGXTextBox ::GotFocus
         THIS.GXGotFocus()
         IF THISFORM.GX_NewLastVld > - 1
            THISFORM.GX_lastvld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         SET TOPIC TO Vprecio
         THISFORM.Gx_cursor = "THISFORM.AV10Vpreci"
         THISFORM.SetFKeys()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
   ENDDEFINE
