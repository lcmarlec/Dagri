         THIS.GX_SfName = SCW887S21
         THIS.GX_SfAlias = "SCW887S21"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08872" , @HStmt_W08872 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPOLIZAS","W08872","",GX_CURSOR_TYPE_READONLY,@HStmt_W08872) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PolFDde], T1.[PolAse], T1.[PolNro], T1.[PolFVig], T2.[CamDsc], "
                  cmdbuf = cmdbuf + "  T1.[CamPat] FROM ([CAMPOL] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CAMION] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[CamPat] = T1.[CamPat]) WHERE (T1.[EmpCod] = "
                  cmdbuf = cmdbuf + "  ?) AND (T1.[CamPat] = ? or ? = ' ') ORDER BY T1.[EmpCod], T1.[CamPat], T1.[PolFVig] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08872,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08872,8)
                  THISFORM.GX_DB_BindColsW08872_01 ()
                  THISFORM.GX_DB_BindParmW08872_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08872,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV23Campat = THISFORM.AV23Campat
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08872,2,AuxAV23Campat,8,0)
               THISFORM.AV23Campat = AuxAV23Campat
               AuxAV23Campat = THISFORM.AV23Campat
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08872,3,AuxAV23Campat,8,0)
               THISFORM.AV23Campat = AuxAV23Campat
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08872) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08872 = Gx_err
               THISFORM.GX_DB_GetW08872_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WPolizas"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08872 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08872) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08872 = Gx_err
                  THISFORM.GX_DB_GetW08872_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08872 <> 101
               BRKVON2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W08872_2EmpCod
               THISFORM.A2691PolFD = THISFORM.Buf_W08872_2691PolFDde
               THISFORM.A2692PolAs = THISFORM.Buf_W08872_2692PolAse
               THISFORM.A2690PolNr = THISFORM.Buf_W08872_2690PolNro
               THISFORM.A2689PolFV = THISFORM.Buf_W08872_2689PolFVig
               THISFORM.A1665CamDs = THISFORM.Buf_W08872_1665CamDsc
               THISFORM.A1664CamPa = THISFORM.Buf_W08872_1664CamPat
               THISFORM.A1665CamDs = THISFORM.Buf_W08872_1665CamDsc
               GX_SFLOAD = 0
               THISFORM.U16VON2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08872) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08872 = Gx_err
               THISFORM.GX_DB_GetW08872_01 ()
            ENDDO
         ENDIF
      ENDPROC
