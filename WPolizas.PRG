      PROCEDURE CreateTemp
         LOCAL SCW887S21
         SCW887S21 = ""
         IF USED( "SCW887S21" )
            SELECT SCW887S21
            SCW887S21 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW887S21
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1664CamP"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1665CamD"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2689PolF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2690PolN"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 15
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2692PolA"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2691PolF"
            GX_STRUCT[ 6 ,2]= "D"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW887S21 = GETE('z:\temp') + '\' + SCW887S21
            ENDIF
            CREATE DBF (SCW887S21) FROM ARRAY GX_STRUCT
            USE
            USE (SCW887S21) EXCLUSIVE ALIAS SCW887S21
