      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T010118" , @HStmt_T010118 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTCHQS","T010118","",GX_CURSOR_TYPE_READONLY,@HStmt_T010118) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TChqNroI], [TChqLin], [TChqFchIng], [TChqBcoCod] AS TChqBcoCod, "
                  cmdbuf = cmdbuf + "  [TChqSuc], [TChqNro], [TChqTit], [TChqImp], [TChqFchDeb], [TChqCliGrT] AS TChqCliGrT, "
                  cmdbuf = cmdbuf + "  [TChqCliCod] AS TChqCliCod, [TChqEst], [TChqNroReg], [TChqPrvGrT] AS TChqPrvGrT, "
                  cmdbuf = cmdbuf + "  [TChqPrvCod] AS TChqPrvCod, [TChqFchEgr], [TChqBcoDeC] AS TChqBcoDeC, [TChqBcoCta] "
                  cmdbuf = cmdbuf + "  FROM [TCHQS1] (NOLOCK) WHERE [EmpCod] = ? AND [TChqNroI] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [TChqNroI], [TChqLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T010118,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T010118,9)
                  THISFORM.GX_DB_BindColsT010118_01 ()
                  THISFORM.GX_DB_BindParmT010118_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T010118,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA98TChqNro = THISFORM.A98TChqNro
               Gx_err = GX_DB_SetDouble( HStmt_T010118,2,@AuxA98TChqNro,0)
               THISFORM.A98TChqNro = AuxA98TChqNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T010118) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010118 = Gx_err
               THISFORM.GX_DB_GetT010118_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T010118 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T010118) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T010118 = Gx_err
                  THISFORM.GX_DB_GetT010118_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T010118 <> 101
               BRK2T13 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT101S10.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
