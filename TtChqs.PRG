         THISFORM.A101TChqLi = THISFORM.M101TChqLi
         THISFORM. cCT101S10 .SaveTemp()
         THISFORM. cCT101S10 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT101S10 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT101S10 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT101S10 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT101S10 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT101S10 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT101S10 .Refresh()
               THISFORM. cCT101S10 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A98TChqNro = S98TChqNro
               THISFORM.A101TChqLi = S101TChqLi
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT101S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT101S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT101S10 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
            ENDDO
            IF sf_err != 0
               THISFORM. cCT101S10 .AppendRow()
               THISFORM. cCT101S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A98TChqNro = S98TChqNro
               THISFORM.A101TChqLi = S101TChqLi
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A98TChqNro = S98TChqNro
         THISFORM.A101TChqLi = S101TChqLi
         RETURN .F.
      ENDFUNC
