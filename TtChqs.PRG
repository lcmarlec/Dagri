            Gx_err = GX_DB_SetInt( HStmt_T01018,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA98TChqNro = THISFORM.A98TChqNro
            Gx_err = GX_DB_SetDouble( HStmt_T01018,2,@AuxA98TChqNro,0)
