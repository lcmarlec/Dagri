      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S98TChqNro
         LOCAL S101TChqLi
         S2EmpCod = THISFORM.A2EmpCod
