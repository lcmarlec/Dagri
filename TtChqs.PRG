               AuxA98TChqNro = THISFORM.A98TChqNro
               Gx_err = GX_DB_SetDouble( HStmt_T010114,2,@AuxA98TChqNro,0)
               THISFORM.A98TChqNro = AuxA98TChqNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T010114) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010114 = Gx_err
               THISFORM.T01018 = iif( THISFORM.T010114 = 0 , 104 , THISFORM.T010114 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T010114) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
