            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01018) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01018 = Gx_err
            THISFORM.GX_DB_GetT01018_01 ()
            IF .NOT. THISFORM.T01018 <> 103
               DO GX_ERRMW WITH "TCHQS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01018 = 101 .OR. THISFORM.Z99TchqULi <> THISFORM.Buf_T01018_99TchqULin
               DO GX_ERRMW WITH "TCHQS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T010112" , @HStmt_T010112 )
