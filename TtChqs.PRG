               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T010112) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010112 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T010112) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T010112 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T010113" , @HStmt_T010113 )
