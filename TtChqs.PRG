                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T010112,cmdbuf)
                  THISFORM.GX_DB_BindParmT010112_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
