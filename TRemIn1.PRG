            ENDIF
            IF Gx_longc .OR. THISFORM.Z5ArtCod <> THISFORM.Buf_T03162_5ArtCod
               DO GX_ERRMW WITH "REMINT1 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

