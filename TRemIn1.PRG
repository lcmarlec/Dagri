         THISFORM. GXInLvl150 = .T.
         IF THISFORM.GX_last_fld_lvl = 150
            IF ! THISFORM. gx_150insert
               THISFORM.SetLevel( 150 )
               THISFORM.SetMode("EOF", "N" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
