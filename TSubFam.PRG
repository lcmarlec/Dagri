               THISFORM. cCT100S14 .Refresh()
               THISFORM. cCT100S14 .AfterRowColChange1()
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT100S14 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT100S14 .LoadRec(2, @sf_err)
            Gx_fcond = S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT100S14 .LoadRec(2, @sf_err)
