            IF .NOT. THISFORM.T01002 <> 103
               DO GX_ERRMW WITH "SUBFAM reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01002 = 101 .OR. THISFORM.Z16FamSubD <> THISFORM.Buf_T01002_16FamSubDsc
               DO GX_ERRMW WITH "SUBFAM fue modificada."
               RETURN .F.
            ENDIF
