      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01008" , @HStmt_T01008 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSUBFAM","T01008","",GX_CURSOR_TYPE_READONLY,@HStmt_T01008) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [FamCod], [FamSubCod], [FamSubDsc] FROM [SUBFAM] (NOLOCK) WHERE [FamCod] = "
                  cmdbuf = cmdbuf + "  ? ORDER BY [FamCod], [FamSubCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01008,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T01008,12)
                  THISFORM.GX_DB_BindColsT01008_01 ()
                  THISFORM.GX_DB_BindParmT01008_01 ()
               ENDIF
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T01008,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01008) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01008 = Gx_err
               THISFORM.GX_DB_GetT01008_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T01008 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T01008) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T01008 = Gx_err
                  THISFORM.GX_DB_GetT01008_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T01008 <> 101
               BRK2S107 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT100S14.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T01008_3FamCod = THISFORM.A3FamCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T01008) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01008 = Gx_err
               THISFORM.GX_DB_GetT01008_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A4FamSubCo"
            THISFORM.A4FamSubCo = THISFORM.Buf_T01008_4FamSubCod
