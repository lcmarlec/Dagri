            IF sf_err != 0
               THISFORM. cCT100S14 .AppendRow()
               THISFORM. cCT100S14 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               RETURN .T.
            ENDIF
         ENDIF
