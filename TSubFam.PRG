               THISFORM.A4FamSubCo = AuxA4FamSubCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01007) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01007 = Gx_err
               THISFORM.T01002 = iif( THISFORM.T01007 = 0 , 104 , THISFORM.T01007 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01007) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
         SELECT (THISFORM. cCT100S14 .GX_SfAlias)
