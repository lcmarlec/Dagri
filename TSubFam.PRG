      PROCEDURE CreateTemp
         LOCAL SCT100S14
         SCT100S14 = ""
         IF USED( "SCT100S14" )
            SELECT SCT100S14
            SCT100S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT100S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA4FamSubC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA16FamSub"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA15FamDsc"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV18Audob"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 60
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV19Numer"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 20
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV22Pgmna"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "VGx_mode"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 3
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT100S14 = GETE('z:\temp') + '\' + SCT100S14
            ENDIF
            CREATE DBF (SCT100S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCT100S14) EXCLUSIVE ALIAS SCT100S14
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT100S14
         THIS.GX_SfAlias = "SCT100S14"
      ENDPROC
