         LOCAL S4FamSubCo
         S3FamCod = THISFORM.A3FamCod
         S4FamSubCo = THISFORM.A4FamSubCo
         THISFORM.A4FamSubCo = THISFORM.M4FamSubCo
         THISFORM. cCT100S14 .SaveTemp()
         THISFORM. cCT100S14 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT100S14 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT100S14 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT100S14 .SF( 3, @sf_err)     && Read
         Gx_fcond = S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
