                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSUBFAM","T01007","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01007) ,  ,  ,  , CS_SQLSRV , 0 )
