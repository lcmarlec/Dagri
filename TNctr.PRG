                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00687) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00687 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00687) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00688" , @HStmt_T00688 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNCTR","T00688","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00688) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [NCTR]  WHERE [EmpCod] = ? AND [NCtPer] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00688,cmdbuf)
                  THISFORM.GX_DB_BindParmT00688_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00688,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA661NCtPer = THISFORM.A661NCtPer
               Gx_err = GX_DB_SetStr( HStmt_T00688,2,AuxA661NCtPer,6,0)
               THISFORM.A661NCtPer = AuxA661NCtPer
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00688) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00688 = Gx_err
               THISFORM.T00682 = iif( THISFORM.T00688 = 0 , 104 , THISFORM.T00688 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00688) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 68 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
