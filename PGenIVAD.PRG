   GXToBeDone = ""
   DO CASE
      CASE Key_read <> 7 .AND. Key_read <> 8
         RETURN
      CASE Key_read = 8
         SET TOPIC TO  [PGenIVAD]
         HELP
      OTHERWISE
         SET TOPIC TO  [PGenIVAD]
         HELP
   ENDCASE
RETURN
