      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12392" , @HStmt_W12392 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WISUSABM","W12392","",GX_CURSOR_TYPE_READONLY,@HStmt_W12392) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ISNombre], [ISId] FROM [ISUSUARI] (FASTFIRSTROW NOLOCK) WHERE [ISNombre] "
                  cmdbuf = cmdbuf + "  like ? ORDER BY [ISId]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12392,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12392,7)
                  THISFORM.GX_DB_BindColsW12392_01 ()
                  THISFORM.GX_DB_BindParmW12392_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12392,1,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12392) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12392 = Gx_err
               THISFORM.GX_DB_GetW12392_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WISUSAbm"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12392 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12392) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12392 = Gx_err
                  THISFORM.GX_DB_GetW12392_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12392 <> 101
               BRKVYF2 = .F.
               THISFORM.A3608ISNom = THISFORM.Buf_W12392_3608ISNombre
               THISFORM.A3607ISId = THISFORM.Buf_W12392_3607ISId
