      PROCEDURE CreateTemp
         LOCAL SCW177S20
         SCW177S20 = ""
         IF USED( "SCW177S20" )
            SELECT SCW177S20
            SCW177S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW177S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA46AudSis"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA47AudEmp"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA48AudFch"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA49Audtim"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA51AudCod"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA52AudUsu"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW177S20 = GETE('z:\temp') + '\' + SCW177S20
            ENDIF
            CREATE DBF (SCW177S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW177S20) EXCLUSIVE ALIAS SCW177S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW177S20
         THIS.GX_SfAlias = "SCW177S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01772" , @HStmt_W01772 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0040","W01772","",GX_CURSOR_TYPE_READONLY,@HStmt_W01772) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AudNro], [AudUsu], [AudCodObj], [Audtime], [AudFch], [AudEmpCod], [AudSist] "
                  cmdbuf = cmdbuf + "  FROM [AUDIT] (FASTFIRSTROW NOLOCK) WHERE ([AudSist] like ?) AND ([AudEmpCod] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([AudFch] >= ?) AND ([Audtime] like ?) AND ([AudCodObj] like ?) AND ([AudNro] "
                  cmdbuf = cmdbuf + "  like ?) AND ([AudUsu] like ?) ORDER BY [AudSist], [AudEmpCod], [AudFch], [Audtime], "
                  cmdbuf = cmdbuf + "  [AudCodObj], [AudNro], [AudUsu]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01772,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01772,9)
                  THISFORM.GX_DB_BindColsW01772_01 ()
                  THISFORM.GX_DB_BindParmW01772_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01772,1,PADR( TRIM(THISFORM.AV5C46),4, '%'),LEN(PADR( TRIM(THISFORM.AV5C46),4, '%')),0)
               AuxAV6C47 = THISFORM.AV6C47
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01772,2,@AuxAV6C47,0)
               THISFORM.AV6C47 = AuxAV6C47
               AuxAV7C48 = THISFORM.AV7C48
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01772,3,@AuxAV7C48,0)
               THISFORM.AV7C48 = AuxAV7C48
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01772,4,PADR( TRIM(THISFORM.AV8C49),8, '%'),LEN(PADR( TRIM(THISFORM.AV8C49),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01772,5,PADR( TRIM(THISFORM.AV9C51),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C51),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01772,6,PADR( TRIM(THISFORM.AV10C14),30, '%'),LEN(PADR( TRIM(THISFORM.AV10C14),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01772,7,PADR( TRIM(THISFORM.AV11C52),10, '%'),LEN(PADR( TRIM(THISFORM.AV11C52),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01772) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01772 = Gx_err
               THISFORM.GX_DB_GetW01772_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01772 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01772) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01772 = Gx_err
                  THISFORM.GX_DB_GetW01772_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01772 <> 101
               BRKV4X2 = .F.
               THISFORM.A14AudNro = THISFORM.Buf_W01772_14AudNro
               THISFORM.A52AudUsu = THISFORM.Buf_W01772_52AudUsu
               THISFORM.A51AudCodO = THISFORM.Buf_W01772_51AudCodObj
               THISFORM.A49Audtime = THISFORM.Buf_W01772_49Audtime
               THISFORM.A48AudFch = THISFORM.Buf_W01772_48AudFch
               THISFORM.A47AudEmpC = THISFORM.Buf_W01772_47AudEmpCod
               THISFORM.A46AudSist = THISFORM.Buf_W01772_46AudSist
               GX_SFLOAD = 0
               THISFORM.U12V4X2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01772) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01772 = Gx_err
               THISFORM.GX_DB_GetW01772_01 ()
            ENDDO
         ENDIF
      ENDPROC
