                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENVIOS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EnvClt] = T1.[EnvClt] AND T2.[EnvFch] = T1.[EnvFch]) LEFT JOIN [ARTICS] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] AND T3.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) WHERE (T1.[EmpCod] = ? and T1.[EnvClt] "
                  cmdbuf = cmdbuf + "  = ? and T1.[EnvFch] = ?) AND (T1.[ArtCntPed] <> 0 or T1.[ArtCntEnv] <> 0) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[EnvClt], T1.[EnvFch], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod] "
                  cmdbuf = cmdbuf + "   "
