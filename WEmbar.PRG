            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2EmpCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW366S11 = GETE('z:\temp') + '\' + SCW366S11
            ENDIF
            CREATE DBF (SCW366S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW366S11) EXCLUSIVE ALIAS SCW366S11
         ENDIF
