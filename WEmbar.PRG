      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03662" , @HStmt_W03662 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMBAR","W03662","",GX_CURSOR_TYPE_READONLY,@HStmt_W03662) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RutChfCod] AS RutChfCod, T1.[RutCod], T2.[ChfNom] AS RutChfNom "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[ChfCod] = T1.[RutChfCod]) WHERE T1.[EmpCod] = ? and T1.[RutCod] "
                  cmdbuf = cmdbuf + "  >= ? ORDER BY T1.[EmpCod], T1.[RutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03662,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03662,13)
                  THISFORM.GX_DB_BindColsW03662_01 ()
                  THISFORM.GX_DB_BindParmW03662_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03662,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV25Rutcod = THISFORM.AV25Rutcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03662,2,@AuxAV25Rutcod,0)
               THISFORM.AV25Rutcod = AuxAV25Rutcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03662 = Gx_err
               THISFORM.GX_DB_GetW03662_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WEmbar"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03662 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03662 <> 101
               BRKVA62 = .F.
               THISFORM.AV21Chfcod = 0
               THISFORM.AV22Chfnom = SPACE(40)
               THISFORM.A2EmpCod = THISFORM.Buf_W03662_2EmpCod
               THISFORM.A1216RutCh = THISFORM.Buf_W03662_1216RutChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W03662_966RutCod
               THISFORM.A1217RutCh = THISFORM.Buf_W03662_1217RutChfNom
               THISFORM.A1217RutCh = THISFORM.Buf_W03662_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U15VA62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKVA62
                  BRKVA62 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03662) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03662 = Gx_err
                  THISFORM.GX_DB_GetW03662_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
