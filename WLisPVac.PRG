      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "Enter" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VWR2()
            RETURN .T.
         ENDIF
         IF UPPER( "Sistemas" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU18VWR2()
            RETURN .T.
         ENDIF
         IF UPPER( "Salir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VWR2()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VWR2()
            RETURN .T.
         ENDIF
         IF UPPER( "SkEmpleado" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VWR2()
            RETURN .T.
         ENDIF
         IF UPPER( "SkEmpladz" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VWR2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_FIRST"
            THISFORM.DoFirst
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_PREV"
            THISFORM.DoPrevious
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_NEXT"
            THISFORM.DoNext
            RETURN .T.
