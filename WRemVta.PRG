      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01302" , @HStmt_W01302 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREMVTA","W01302","",GX_CURSOR_TYPE_READONLY,@HStmt_W01302) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T4.[RVtEntGruT] AS RVtEntGruT, T1.[EmpCod], T1.[RVtNroInt], T1.[RVtLin], T4.[RVtFch], "
                  cmdbuf = cmdbuf + "  T4.[RVtNro], T4.[RVtSuc], T5.[EntRaz] AS RVtEntRaz, T4.[RVtEntCod] AS RVtEntCod, "
                  cmdbuf = cmdbuf + "  T1.[RVtLObs], T3.[LugDsc] AS RVtLugDsc, T1.[RVtLugCod] AS RVtLugCod, T1.[RVtLotNro], "
                  cmdbuf = cmdbuf + "  T1.[RVtCnt], T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod] FROM (((([REMVTA1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] "
                  cmdbuf = cmdbuf + "  = T1.[ArtCod]) LEFT JOIN [LUGALM] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[LugCod] "
                  cmdbuf = cmdbuf + "  = T1.[RVtLugCod]) LEFT JOIN [REMVTA] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T4.[RVtNroInt] = T1.[RVtNroInt]) LEFT JOIN [ENTID] T5 (NOLOCK) ON T5.[EmpCod] = "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] AND T5.[EntGruTip] = T4.[RVtEntGruT] AND T5.[EntCod] = T4.[RVtEntCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[RVtNroInt] = ?) AND (T1.[RVtCnt] <> 0) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[RVtNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01302,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01302,14)
                  THISFORM.GX_DB_BindColsW01302_01 ()
                  THISFORM.GX_DB_BindParmW01302_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01302,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA908RVtNro = THISFORM.A908RVtNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01302,2,@AuxA908RVtNro,0)
               THISFORM.A908RVtNro = AuxA908RVtNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01302) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01302 = Gx_err
               THISFORM.GX_DB_GetW01302_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01302 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01302) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01302 = Gx_err
                  THISFORM.GX_DB_GetW01302_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01302 <> 101
               BRKV3M2 = .F.
               THISFORM.A909RVtEnt = THISFORM.Buf_W01302_909RVtEntGruT
               THISFORM.A928RVtLin = THISFORM.Buf_W01302_928RVtLin
               THISFORM.A915RVtFch = THISFORM.Buf_W01302_915RVtFch
               THISFORM.A914RVtNro = THISFORM.Buf_W01302_914RVtNro
               THISFORM.A913RVtSuc = THISFORM.Buf_W01302_913RVtSuc
               THISFORM.A911RVtEnt = THISFORM.Buf_W01302_911RVtEntRaz
               THISFORM.A910RVtEnt = THISFORM.Buf_W01302_910RVtEntCod
               THISFORM.A936RVtLOb = THISFORM.Buf_W01302_936RVtLObs
               THISFORM.A934RVtLug = THISFORM.Buf_W01302_934RVtLugDsc
               THISFORM.A933RVtLug = THISFORM.Buf_W01302_933RVtLugCod
               THISFORM.A935RVtLot = THISFORM.Buf_W01302_935RVtLotNro
               THISFORM.A929RVtCnt = THISFORM.Buf_W01302_929RVtCnt
               THISFORM.A6ArtDsc = THISFORM.Buf_W01302_6ArtDsc
