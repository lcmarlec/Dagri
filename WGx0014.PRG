               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01732" , @HStmt_W01732 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0014","W01732","",GX_CURSOR_TYPE_READONLY,@HStmt_W01732) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCprArt], [ArtCprPrc], [ArtCprCod], "
                  cmdbuf = cmdbuf + "  [ArtCprGrT] FROM [ARTICS1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [FamCod] "
                  cmdbuf = cmdbuf + "  = ? and [FamSubCod] = ? and [ArtCod] = ?) AND ([ArtCprGrT] like ?) AND ([ArtCprCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ArtCprArt] like ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], "
                  cmdbuf = cmdbuf + "  [ArtCprGrT], [ArtCprCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01732,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01732,9)
                  THISFORM.GX_DB_BindColsW01732_01 ()
                  THISFORM.GX_DB_BindParmW01732_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01732,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
