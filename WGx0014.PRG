               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01732,5,PADR( TRIM(THISFORM.AV5C7),2, '%'),LEN(PADR( TRIM(THISFORM.AV5C7),2, '%')),0)
               AuxAV6C8 = THISFORM.AV6C8
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01732,6,@AuxAV6C8,0)
               THISFORM.AV6C8 = AuxAV6C8
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01732,7,PADR( TRIM(THISFORM.AV7C10),12, '%'),LEN(PADR( TRIM(THISFORM.AV7C10),12, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01732 = Gx_err
               THISFORM.GX_DB_GetW01732_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01732 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01732) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01732 = Gx_err
                  THISFORM.GX_DB_GetW01732_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01732 <> 101
               BRKV4T2 = .F.
               THISFORM.A10ArtCprA = THISFORM.Buf_W01732_10ArtCprArt
