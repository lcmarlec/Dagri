      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA631PaiCod = THISFORM.A631PaiCod
            Gx_err = GX_DB_SetStr( HStmt_T00852,1,AuxA631PaiCod,4,0)
            THISFORM.A631PaiCod = AuxA631PaiCod
            AuxA633PciCod = THISFORM.A633PciCod
            Gx_err = GX_DB_SetStr( HStmt_T00852,2,AuxA633PciCod,4,0)
            THISFORM.A633PciCod = AuxA633PciCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00852) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00852 = Gx_err
            THISFORM.GX_DB_GetT00852_01 ()
            IF .NOT. THISFORM.T00852 <> 103
               DO GX_ERRMW WITH "PCIAS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00852 = 101 .OR. THISFORM.Buf_T00852_634PciDsc <> THISFORM.Z634PciDsc .OR. THISFORM.Buf_T00852_785PciIbr <> THISFORM.Z785PciIbr .OR. THISFORM.Buf_T00852_786PciDGI <> THISFORM.Z786PciDGI .OR. THISFORM.Buf_T00852_787PciCoU <> THISFORM.Z787PciCoU .OR. THISFORM.Buf_T00852_1895PciCo2 <> THISFORM.Z1895PciCo
               DO GX_ERRMW WITH "PCIAS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
