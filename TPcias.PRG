      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00856" , @HStmt_T00856 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPCIAS","T00856","",1,@HStmt_T00856) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO PCIAS (PaiCod, PciCod, PciDsc, PciIbr, PciDGI, PciCoU, PciCo2) VALUES "
                  cmdbuf = cmdbuf + "  (?, ?, ?, ?, ?, ?, ?) "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_T00856,cmdbuf) ,  ,  ,  , CS_SQLSRV , 0 )
                  THISFORM.GX_DB_BindParmT00856_01 ( HStmt_T00856 )
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               Gx_err = GX_DB_SetStr( HStmt_T00856,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               AuxA633PciCod = THISFORM.A633PciCod
               Gx_err = GX_DB_SetStr( HStmt_T00856,2,AuxA633PciCod,4,0)
               THISFORM.A633PciCod = AuxA633PciCod
               AuxA634PciDsc = THISFORM.A634PciDsc
               Gx_err = GX_DB_SetStr( HStmt_T00856,3,AuxA634PciDsc,40,0)
               THISFORM.A634PciDsc = AuxA634PciDsc
               AuxA785PciIbr = THISFORM.A785PciIbr
               Gx_err = GX_DB_SetDouble( HStmt_T00856,4,@AuxA785PciIbr,0)
               THISFORM.A785PciIbr = AuxA785PciIbr
               AuxA786PciDGI = THISFORM.A786PciDGI
               Gx_err = GX_DB_SetInt( HStmt_T00856,5,@AuxA786PciDGI,0)
               THISFORM.A786PciDGI = AuxA786PciDGI
               AuxA787PciCoU = THISFORM.A787PciCoU
               Gx_err = GX_DB_SetDouble( HStmt_T00856,6,@AuxA787PciCoU,0)
               THISFORM.A787PciCoU = AuxA787PciCoU
