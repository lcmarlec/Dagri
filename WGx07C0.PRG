            GX_STRUCT[ 4 ,1]= "sA2333AleV"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW780S16 = GETE('z:\temp') + '\' + SCW780S16
            ENDIF
            CREATE DBF (SCW780S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW780S16) EXCLUSIVE ALIAS SCW780S16
         ENDIF
