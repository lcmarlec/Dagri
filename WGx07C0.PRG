      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07802" , @HStmt_W07802 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07C0","W07802","",GX_CURSOR_TYPE_READONLY,@HStmt_W07802) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AleCer], [AleVto], [AleExp], [AleDsc], [ALeCod] FROM [ARTLEG] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([ALeCod] >= ?) AND ([AleDsc] like ?) AND ([AleExp] like ?) AND ([AleCer] "
                  cmdbuf = cmdbuf + "  like ?) AND ([AleVto] >= ?) ORDER BY [ALeCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07802,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07802,9)
                  THISFORM.GX_DB_BindColsW07802_01 ()
                  THISFORM.GX_DB_BindParmW07802_01 ()
               ENDIF
               AuxAV5C2329 = THISFORM.AV5C2329
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07802,1,@AuxAV5C2329,0)
               THISFORM.AV5C2329 = AuxAV5C2329
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07802,2,PADR( TRIM(THISFORM.AV6C2330),30, '%'),LEN(PADR( TRIM(THISFORM.AV6C2330),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07802,3,PADR( TRIM(THISFORM.AV7C2331),15, '%'),LEN(PADR( TRIM(THISFORM.AV7C2331),15, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07802,4,PADR( TRIM(THISFORM.AV8C2332),15, '%'),LEN(PADR( TRIM(THISFORM.AV8C2332),15, '%')),0)
               AuxAV9C2333 = THISFORM.AV9C2333
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07802,5,@AuxAV9C2333,0)
               THISFORM.AV9C2333 = AuxAV9C2333
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07802 = Gx_err
               THISFORM.GX_DB_GetW07802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07802 = Gx_err
                  THISFORM.GX_DB_GetW07802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07802 <> 101
               BRKVLO2 = .F.
               THISFORM.A2332AleCe = THISFORM.Buf_W07802_2332AleCer
               THISFORM.A2333AleVt = THISFORM.Buf_W07802_2333AleVto
               THISFORM.A2331AleEx = THISFORM.Buf_W07802_2331AleExp
               THISFORM.A2330AleDs = THISFORM.Buf_W07802_2330AleDsc
               THISFORM.A2329ALeCo = THISFORM.Buf_W07802_2329ALeCod
               GX_SFLOAD = 0
               THISFORM.U12VLO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07802 = Gx_err
               THISFORM.GX_DB_GetW07802_01 ()
            ENDDO
         ENDIF
