      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04492" , @HStmt_W04492 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WACTIVID","W04492","",GX_CURSOR_TYPE_READONLY,@HStmt_W04492) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ActIIBBPor], [ActIIBBMin], [ActDsc], [ActCod] FROM [ACTIVIDA] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ?) AND ([ActDsc] like ?) ORDER BY [EmpCod], [ActCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04492,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04492,11)
                  THISFORM.GX_DB_BindColsW04492_01 ()
                  THISFORM.GX_DB_BindParmW04492_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04492,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04492,2,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04492 = Gx_err
               THISFORM.GX_DB_GetW04492_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WActivid"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04492 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04492) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04492 = Gx_err
                  THISFORM.GX_DB_GetW04492_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04492 <> 101
               BRKVCH2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W04492_2EmpCod
               THISFORM.A1437ActII = THISFORM.Buf_W04492_1437ActIIBBPor
               THISFORM.A1436ActII = THISFORM.Buf_W04492_1436ActIIBBMin
               THISFORM.A1435ActDs = THISFORM.Buf_W04492_1435ActDsc
               THISFORM.A1434ActCo = THISFORM.Buf_W04492_1434ActCod
               GX_SFLOAD = 0
               THISFORM.U18VCH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04492 = Gx_err
               THISFORM.GX_DB_GetW04492_01 ()
            ENDDO
         ENDIF
      ENDPROC
