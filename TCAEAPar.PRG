      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 275
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT251A2 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 275
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA2EmpCod = THISFORM.A2EmpCod
                  Gx_err = GX_DB_SetInt( HStmt_T02513,1,@AuxA2EmpCod,0)
                  THISFORM.A2EmpCod = AuxA2EmpCod
                  AuxA2449param = THISFORM.A2449param
                  Gx_err = GX_DB_SetStr( HStmt_T02513,2,AuxA2449param,50,0)
                  THISFORM.A2449param = AuxA2449param
                  AuxA2450ParIn = THISFORM.A2450ParIn
                  Gx_err = GX_DB_SetStr( HStmt_T02513,3,AuxA2450ParIn,50,0)
                  THISFORM.A2450ParIn = AuxA2450ParIn
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02513) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02513 = Gx_err
                  THISFORM.GX_DB_GetT02513_01 ()
                  THISFORM. cCT251A2450 . ZM6Z275 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC6Z275 ()
               THISFORM. cCT251A2450 . ZM6Z275 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC6Z275 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT251A2451 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE6Z275 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC6Z275 ()
                  RETURN
               ENDIF
               THISFORM.cCT251A2450.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02513) , "TCAEAPAR" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02512) , "TCAEAPAR" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02514) , "TCAEAPAR" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT251A2451 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT251A2 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

