      PROCEDURE CreateTemp
         LOCAL SCW732S20
         SCW732S20 = ""
         IF USED( "SCW732S20" )
            SELECT SCW732S20
            SCW732S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW732S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2177tInf"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2178tInd"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 10
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2179tInd"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2180tInd"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2181tInd"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2182tInd"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW732S20 = GETE('z:\temp') + '\' + SCW732S20
            ENDIF
            CREATE DBF (SCW732S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW732S20) EXCLUSIVE ALIAS SCW732S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW732S20
         THIS.GX_SfAlias = "SCW732S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07322" , @HStmt_W07322 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0710","W07322","",GX_CURSOR_TYPE_READONLY,@HStmt_W07322) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [tval1], [tInd5], [tInd4], [tInd3], [tInd2], [tInd1], [tInfNI] FROM [TINF] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([tInfNI] >= ?) AND ([tInd1] like ?) AND ([tInd2] like "
                  cmdbuf = cmdbuf + "  ?) AND ([tInd3] like ?) AND ([tInd4] like ?) AND ([tInd5] like ?) AND ([tval1] >= "
                  cmdbuf = cmdbuf + "  ?) ORDER BY [tInfNI], [tInd1], [tInd2], [tInd3], [tInd4], [tInd5]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07322,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07322,9)
                  THISFORM.GX_DB_BindColsW07322_01 ()
                  THISFORM.GX_DB_BindParmW07322_01 ()
               ENDIF
               AuxAV5C2177 = THISFORM.AV5C2177
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07322,1,@AuxAV5C2177,0)
               THISFORM.AV5C2177 = AuxAV5C2177
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07322,2,PADR( TRIM(THISFORM.AV6C2178),10, '%'),LEN(PADR( TRIM(THISFORM.AV6C2178),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07322,3,PADR( TRIM(THISFORM.AV7C2179),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C2179),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07322,4,PADR( TRIM(THISFORM.AV8C2180),10, '%'),LEN(PADR( TRIM(THISFORM.AV8C2180),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07322,5,PADR( TRIM(THISFORM.AV9C2181),10, '%'),LEN(PADR( TRIM(THISFORM.AV9C2181),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07322,6,PADR( TRIM(THISFORM.AV10C2182),10, '%'),LEN(PADR( TRIM(THISFORM.AV10C2182),10, '%')),0)
               AuxAV11C2188 = THISFORM.AV11C2188
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07322,7,@AuxAV11C2188,0)
               THISFORM.AV11C2188 = AuxAV11C2188
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07322 = Gx_err
               THISFORM.GX_DB_GetW07322_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07322 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07322) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07322 = Gx_err
                  THISFORM.GX_DB_GetW07322_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07322 <> 101
               BRKVKC2 = .F.
               THISFORM.A2188tval1 = THISFORM.Buf_W07322_2188tval1
               THISFORM.A2182tInd5 = THISFORM.Buf_W07322_2182tInd5
               THISFORM.A2181tInd4 = THISFORM.Buf_W07322_2181tInd4
               THISFORM.A2180tInd3 = THISFORM.Buf_W07322_2180tInd3
               THISFORM.A2179tInd2 = THISFORM.Buf_W07322_2179tInd2
               THISFORM.A2178tInd1 = THISFORM.Buf_W07322_2178tInd1
               THISFORM.A2177tInfN = THISFORM.Buf_W07322_2177tInfNI
               GX_SFLOAD = 0
               THISFORM.U12VKC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07322 = Gx_err
               THISFORM.GX_DB_GetW07322_01 ()
            ENDDO
         ENDIF
      ENDPROC
