               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02312,5,PADR( TRIM(THISFORM.AV17C542),12, '%'),LEN(PADR( TRIM(THISFORM.AV17C542),12, '%')),0)
               AuxAV16C543 = THISFORM.AV16C543
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02312,6,@AuxAV16C543,0)
               THISFORM.AV16C543 = AuxAV16C543
               AuxAV15C544 = THISFORM.AV15C544
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02312,7,@AuxAV15C544,0)
               THISFORM.AV15C544 = AuxAV15C544
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02312 = Gx_err
               THISFORM.GX_DB_GetW02312_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02312 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02312) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02312 = Gx_err
                  THISFORM.GX_DB_GetW02312_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02312 <> 101
               BRKV6F2 = .F.
               THISFORM.A543V12Fec = THISFORM.Buf_W02312_543V12FecImp
               THISFORM.A542V12Num = THISFORM.Buf_W02312_542V12NumImp
               THISFORM.A541V12Tip = THISFORM.Buf_W02312_541V12TipImp
               THISFORM.A544V12Imp = THISFORM.Buf_W02312_544V12Import
               THISFORM.A540V12Fec = THISFORM.Buf_W02312_540V12FecRec
               THISFORM.A539V12Num = THISFORM.Buf_W02312_539V12NumRec
               THISFORM.A538V12Tip = THISFORM.Buf_W02312_538V12TipRec
               GX_SFLOAD = 0
               THISFORM.U12V6F2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02312 = Gx_err
               THISFORM.GX_DB_GetW02312_01 ()
            ENDDO
         ENDIF
      ENDPROC
