      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07262" , @HStmt_W07262 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCONSART","W07262","",GX_CURSOR_TYPE_READONLY,@HStmt_W07262) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ArtCodBar], [ArtCpr], [ArtVta], [ArtDsc], [ArtCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [FamCod] FROM [ARTICS] (NOLOCK) WHERE ([EmpCod] = ?) AND ([ArtCodBar] = ?) AND ([ArtVta] "
                  cmdbuf = cmdbuf + "  = ? or [ArtCpr] = ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07262,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07262,7)
                  THISFORM.GX_DB_BindColsW07262_01 ()
                  THISFORM.GX_DB_BindParmW07262_01 ()
               ENDIF
               AuxAV11Emprco = THISFORM.AV11Emprco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07262,1,@AuxAV11Emprco,0)
               THISFORM.AV11Emprco = AuxAV11Emprco
               AuxAV24Artcod = THISFORM.AV24Artcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07262,2,AuxAV24Artcod,15,0)
               THISFORM.AV24Artcod = AuxAV24Artcod
               AuxAV25Artvta = THISFORM.AV25Artvta
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07262,3,AuxAV25Artvta,1,0)
               THISFORM.AV25Artvta = AuxAV25Artvta
               AuxAV26Artcpr = THISFORM.AV26Artcpr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07262,4,AuxAV26Artcpr,1,0)
               THISFORM.AV26Artcpr = AuxAV26Artcpr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07262 = Gx_err
               THISFORM.GX_DB_GetW07262_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WConsArt"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07262 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07262) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07262 = Gx_err
                  THISFORM.GX_DB_GetW07262_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07262 <> 101
               BRKVK62 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W07262_2EmpCod
               THISFORM.A1464ArtCo = THISFORM.Buf_W07262_1464ArtCodBar
               THISFORM.A24ArtCpr = THISFORM.Buf_W07262_24ArtCpr
               THISFORM.A28ArtVta = THISFORM.Buf_W07262_28ArtVta
               THISFORM.A6ArtDsc = THISFORM.Buf_W07262_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W07262_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W07262_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W07262_3FamCod
               GX_SFLOAD = 0
               THISFORM.U18VK62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07262 = Gx_err
               THISFORM.GX_DB_GetW07262_01 ()
            ENDDO
         ENDIF
      ENDPROC
