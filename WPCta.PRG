      PROCEDURE CreateTemp
         LOCAL SCW117S11
         SCW117S11 = ""
         IF USED( "SCW117S11" )
            SELECT SCW117S11
            SCW117S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW117S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA198PCtaN"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA210PCtaD"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW117S11 = GETE('z:\temp') + '\' + SCW117S11
            ENDIF
            CREATE DBF (SCW117S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW117S11) EXCLUSIVE ALIAS SCW117S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW117S11
         THIS.GX_SfAlias = "SCW117S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01172" , @HStmt_W01172 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPCTA","W01172","",GX_CURSOR_TYPE_READONLY,@HStmt_W01172) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PCtaDes], [PCtaNro] FROM [PCTA] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01172,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01172,8)
                  THISFORM.GX_DB_BindColsW01172_01 ()
                  THISFORM.GX_DB_BindParmW01172_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01172,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01172 = Gx_err
               THISFORM.GX_DB_GetW01172_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WPCta"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01172 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01172) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01172 = Gx_err
                  THISFORM.GX_DB_GetW01172_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01172 <> 101
               BRKV392 = .F.
               THISFORM.A210PCtaDe = THISFORM.Buf_W01172_210PCtaDes
               THISFORM.A198PCtaNr = THISFORM.Buf_W01172_198PCtaNro
               GX_SFLOAD = 0
               THISFORM.U19V392 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01172 = Gx_err
               THISFORM.GX_DB_GetW01172_01 ()
            ENDDO
         ENDIF
      ENDPROC
