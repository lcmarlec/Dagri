      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04982" , @HStmt_W04982 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLLACTR","W04982","",GX_CURSOR_TYPE_READONLY,@HStmt_W04982) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [LlaDir], [LlaTel2], [EmpCod], [LlaNroI], [LlaLinU], [LlaTip], [LlaEst], [LlaApe], "
                  cmdbuf = cmdbuf + "  [LLaNom], [LlaTel1], [LlaHor], [LlaFch], [LlaNro] FROM [LLANVO] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ?) AND ([LlaNroI] <> ?) AND (( [LLaNom] like ? and Not (? = ' ')) "
                  cmdbuf = cmdbuf + "  or ( [LlaApe] like ? and Not (? = ' ')) or ( [LlaApe] like ? and Not (? = ' ')) "
                  cmdbuf = cmdbuf + "  or ( [LLaNom] like ? and Not (? = ' ')) or ( [LlaTel1] = ? and Not ([LlaTel1] = "
                  cmdbuf = cmdbuf + "  ' ')) or ( [LlaTel2] = ? and Not ([LlaTel2] = ' ')) or [LlaDir] like ? and Not (? "
                  cmdbuf = cmdbuf + "  = ' ')) ORDER BY [EmpCod], [LlaNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04982,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04982,7)
                  THISFORM.GX_DB_BindColsW04982_01 ()
                  THISFORM.GX_DB_BindParmW04982_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04982,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV29Llanro = THISFORM.AV29Llanro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04982,2,@AuxAV29Llanro,0)
               THISFORM.AV29Llanro = AuxAV29Llanro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,3,PADR( TRIM(THISFORM.AV23Nombre),30, '%'),LEN(PADR( TRIM(THISFORM.AV23Nombre),30, '%')),0)
               AuxAV23Nombre = THISFORM.AV23Nombre
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,4,AuxAV23Nombre,30,0)
               THISFORM.AV23Nombre = AuxAV23Nombre
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,5,PADR( TRIM(THISFORM.AV24Apelli),30, '%'),LEN(PADR( TRIM(THISFORM.AV24Apelli),30, '%')),0)
               AuxAV24Apelli = THISFORM.AV24Apelli
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,6,AuxAV24Apelli,30,0)
               THISFORM.AV24Apelli = AuxAV24Apelli
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,7,PADR( TRIM(THISFORM.AV23Nombre),30, '%'),LEN(PADR( TRIM(THISFORM.AV23Nombre),30, '%')),0)
               AuxAV23Nombre = THISFORM.AV23Nombre
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,8,AuxAV23Nombre,30,0)
               THISFORM.AV23Nombre = AuxAV23Nombre
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,9,PADR( TRIM(THISFORM.AV24Apelli),30, '%'),LEN(PADR( TRIM(THISFORM.AV24Apelli),30, '%')),0)
               AuxAV24Apelli = THISFORM.AV24Apelli
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,10,AuxAV24Apelli,30,0)
               THISFORM.AV24Apelli = AuxAV24Apelli
               AuxAV26Llatel = THISFORM.AV26Llatel
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,11,AuxAV26Llatel,14,0)
               THISFORM.AV26Llatel = AuxAV26Llatel
               AuxAV26Llatel = THISFORM.AV26Llatel
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,12,AuxAV26Llatel,14,0)
               THISFORM.AV26Llatel = AuxAV26Llatel
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,13,PADR( TRIM(THISFORM.AV28Lladir),80, '%'),LEN(PADR( TRIM(THISFORM.AV28Lladir),80, '%')),0)
               AuxAV28Lladir = THISFORM.AV28Lladir
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04982,14,AuxAV28Lladir,80,0)
               THISFORM.AV28Lladir = AuxAV28Lladir
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04982 = Gx_err
               THISFORM.GX_DB_GetW04982_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WLlaCtr"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04982 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04982) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04982 = Gx_err
                  THISFORM.GX_DB_GetW04982_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04982 <> 101
               BRKVDU2 = .F.
               THISFORM.A1521LlaDi = THISFORM.Buf_W04982_1521LlaDir
               THISFORM.A1497LlaTe = THISFORM.Buf_W04982_1497LlaTel2
               THISFORM.A2EmpCod = THISFORM.Buf_W04982_2EmpCod
               THISFORM.A1525LlaNr = THISFORM.Buf_W04982_1525LlaNroI
               THISFORM.A1511LlaLi = THISFORM.Buf_W04982_1511LlaLinU
               THISFORM.A2666LlaTi = THISFORM.Buf_W04982_2666LlaTip
               THISFORM.A1516LlaEs = THISFORM.Buf_W04982_1516LlaEst
               THISFORM.A1500LlaAp = THISFORM.Buf_W04982_1500LlaApe
               THISFORM.A1499LLaNo = THISFORM.Buf_W04982_1499LLaNom
               THISFORM.A1492LlaTe = THISFORM.Buf_W04982_1492LlaTel1
               THISFORM.A1494LlaHo = THISFORM.Buf_W04982_1494LlaHor
               THISFORM.A1493LlaFc = THISFORM.Buf_W04982_1493LlaFch
               THISFORM.A1520LlaNr = THISFORM.Buf_W04982_1520LlaNro
               GX_SFLOAD = 0
               THISFORM.U16VDU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04982 = Gx_err
               THISFORM.GX_DB_GetW04982_01 ()
            ENDDO
         ENDIF
      ENDPROC
