                  cmdbuf = " SELECT T1.[DcCRORNroI], T2.[EntGruTip], T1.[EmpCod], T1.[DcCNroInt], T1.[DcCRORLin], "
                  cmdbuf = cmdbuf + "  T1.[DcCObsLin], T1.[DcCPrc], T2.[DccSer], T2.[DcCNro], T2.[DcCSuc], T2.[DcCTip], "
                  cmdbuf = cmdbuf + "  T2.[DcCFec], T3.[EntRaz], T2.[EntCod], T2.[DcCNroCtr] FROM (([DCCOM2] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[DcCNroInt] "
                  cmdbuf = cmdbuf + "  = T1.[DcCNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[EntGruTip] = T2.[EntGruTip] AND T3.[EntCod] = T2.[EntCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[DcCNroInt] = ? ORDER BY T1.[EmpCod], T1.[DcCNroInt], T1.[DcCRORNroI], "
                  cmdbuf = cmdbuf + "  T1.[DcCRORLin]  "
