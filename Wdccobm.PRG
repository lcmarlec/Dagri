            THISFORM. cCW680S8 .GX_LastVld1 = THISFORM. cCW680S8.Columns(1).Ctrl1 .GXColumnNo - 1
            GX_rploop = .T.
            IF Gx_fel_sel
               THISFORM.cCW680S8 .RestoreGridPos()
               THISFORM.cCW680S8.SF (4, @GX_SFERR)
               THISFORM.cCW680S8.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW680S8 .ResetSavedGridPos()
         SELECT( THISFORM.cCW680S8 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW680S8.SF (3, @GX_SFERR)
