         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW680S8 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW680S8.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW680S8.SF (3, @GX_SFERR)
            THISFORM.cCW680S8 .SaveGridPos()
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV8Emprcod
            Aux1 = THISFORM.AV6Fechasi
            Aux2 = THISFORM.AV29Dccnro
            Aux3 = THISFORM.AV26Dccobs
            Aux4 = THISFORM.AV28Dccprc
