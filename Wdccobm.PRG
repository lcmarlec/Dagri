            Aux6 = THISFORM.AV24Usuari
            DO Pdccobm WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux0
            THISFORM.AV6Fechasi = Aux1
            THISFORM.AV29Dccnro = Aux2
            THISFORM.AV26Dccobs = Aux3
            THISFORM.AV28Dccprc = Aux4
