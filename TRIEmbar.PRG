      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T033119" , @HStmt_T033119 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TRIEMBAR","T033119","",GX_CURSOR_TYPE_READONLY,@HStmt_T033119) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [RINroInt], [RILin], [RiLotFch], [RiLotNro], [RiLotVnc], [RicntIng], "
                  cmdbuf = cmdbuf + "  [FamCod], [FamSubCod], [ArtCod], [RIPrvcod], [RICnt], [RITraz] FROM [REMINT1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [RINroInt] = ? ORDER BY [EmpCod], [RINroInt], [RILin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T033119,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T033119,12)
                  THISFORM.GX_DB_BindColsT033119_01 ()
                  THISFORM.GX_DB_BindParmT033119_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T033119,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1306RINro = THISFORM.A1306RINro
               Gx_err = GX_DB_SetDouble( HStmt_T033119,2,@AuxA1306RINro,0)
               THISFORM.A1306RINro = AuxA1306RINro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T033119) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T033119 = Gx_err
               THISFORM.GX_DB_GetT033119_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T033119 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T033119) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T033119 = Gx_err
                  THISFORM.GX_DB_GetT033119_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T033119 <> 101
               BRK97150 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT331S27.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T033119_1306RINroInt = THISFORM.A1306RINro .AND. THISFORM.Buf_T033119_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T033119) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T033119 = Gx_err
               THISFORM.GX_DB_GetT033119_01 ()
            ENDDO
         ENDIF
      ENDPROC
