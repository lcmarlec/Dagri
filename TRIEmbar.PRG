         LOCAL S2EmpCod
         LOCAL S1306RINro
         LOCAL S1316RILin
         S2EmpCod = THISFORM.A2EmpCod
         S1306RINro = THISFORM.A1306RINro
         S1316RILin = THISFORM.A1316RILin
         THISFORM.A1316RILin = THISFORM.M1316RILin
         THISFORM. cCT331S27 .SaveTemp()
         THISFORM. cCT331S27 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT331S27 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT331S27 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT331S27 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1306RINro = THISFORM.A1306RINro .AND. S1316RILin = THISFORM.A1316RILin
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT331S27 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT331S27 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1306RINro = THISFORM.A1306RINro .AND. S1316RILin = THISFORM.A1316RILin
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT331S27 .Refresh()
               THISFORM. cCT331S27 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1306RINro = S1306RINro
               THISFORM.A1316RILin = S1316RILin
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT331S27 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT331S27 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1306RINro = THISFORM.A1306RINro .AND. S1316RILin = THISFORM.A1316RILin
            DO WHILE sf_err = 0 .and. !GX_fcond
