      PROCEDURE CreateTemp
         LOCAL SCW72S11
         SCW72S11 = ""
         IF USED( "SCW72S11" )
            SELECT SCW72S11
            SCW72S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW72S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA82BcoFDe"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA83BcoFHa"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA84BcoMax"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "VAV16Difer"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA85BcoSld"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW72S11 = GETE('z:\temp') + '\' + SCW72S11
            ENDIF
            CREATE DBF (SCW72S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW72S11) EXCLUSIVE ALIAS SCW72S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW72S11
         THIS.GX_SfAlias = "SCW72S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00722" , @HStmt_W00722 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLIMSEV","W00722","",GX_CURSOR_TYPE_READONLY,@HStmt_W00722) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[BcoCod], T1.[BcoCta], T2.[BcoCtaNro], T1.[BcoSld], T1.[BcoMax], T1.[BcoFHa], "
                  cmdbuf = cmdbuf + "  T1.[BcoFDe], T3.[BcoDsc] FROM (([BANCOS2] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CTAS] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[BcoCta] = T1.[BcoCta]) LEFT JOIN [BANCOS] T3 (NOLOCK) ON T3.[BcoCod] "
                  cmdbuf = cmdbuf + "  = T2.[BcoCod]) WHERE (T1.[BcoCta] = ?) AND (T1.[BcoFHa] >= ?) ORDER BY T1.[BcoCta] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00722,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00722,14)
                  THISFORM.GX_DB_BindColsW00722_01 ()
                  THISFORM.GX_DB_BindParmW00722_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00722,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxAV11Desde = THISFORM.AV11Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00722,2,@AuxAV11Desde,0)
               THISFORM.AV11Desde = AuxAV11Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00722) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00722 = Gx_err
               THISFORM.GX_DB_GetW00722_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV19Pgmnam = "WLimSeV"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00722 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00722) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00722 = Gx_err
                  THISFORM.GX_DB_GetW00722_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00722 <> 101
               BRKV202 = .F.
               THISFORM.AV16Difere = 0.00
               THISFORM.A77BcoCtaN = THISFORM.Buf_W00722_77BcoCtaNro
               THISFORM.A85BcoSld = THISFORM.Buf_W00722_85BcoSld
               THISFORM.A84BcoMax = THISFORM.Buf_W00722_84BcoMax
               THISFORM.A83BcoFHa = THISFORM.Buf_W00722_83BcoFHa
               THISFORM.A82BcoFDe = THISFORM.Buf_W00722_82BcoFDe
               THISFORM.A87BcoDsc = THISFORM.Buf_W00722_87BcoDsc
               THISFORM.A77BcoCtaN = THISFORM.Buf_W00722_77BcoCtaNro
               THISFORM.A87BcoDsc = THISFORM.Buf_W00722_87BcoDsc
               GX_SFLOAD = 0
               THISFORM.U14V202 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00722) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00722 = Gx_err
               THISFORM.GX_DB_GetW00722_01 ()
            ENDDO
         ENDIF
      ENDPROC
