               ENDDO
               THISFORM.T03834 = Gx_err
               THISFORM.GX_DB_GetT03834_01 ()
               DO WHILE THISFORM.T03834 = 0 .AND. THISFORM.A3549pppcu >= THISFORM.Buf_T03834_3549pppcuit
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03834) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
