      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 402
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT383A3549 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 402
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3549pppcu = THISFORM.A3549pppcu
                  Gx_err = GX_DB_SetDouble( HStmt_T03833,1,@AuxA3549pppcu,0)
                  THISFORM.A3549pppcu = AuxA3549pppcu
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03833) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03833 = Gx_err
                  THISFORM.GX_DB_GetT03833_01 ()
                  THISFORM. cCT383A3549 . ZMAN402 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCAN402 ()
               THISFORM. cCT383A3549 . ZMAN402 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAN402 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT383A3552 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEAN402 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAN402 ()
                  RETURN
               ENDIF
               THISFORM.cCT383A3549.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03833) , "TPRPOCO" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03832) , "TPRPOCO" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT383A3552 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT383A3549 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

