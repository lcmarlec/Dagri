                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03834) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03834 = Gx_err
               THISFORM.GX_DB_GetT03834_01 ()
            CASE GXOP = 6 && Get cursor fields
