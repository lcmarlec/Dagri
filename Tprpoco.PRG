         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl402
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_402insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_402insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_402insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_402insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT383A3549 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_402insert = .F.
               THISFORM.gx_insert = THISFORM. gx_402insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXEditBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA3549pppcu = THISFORM.A3549pppcu
            Gx_err = GX_DB_SetDouble( HStmt_T03832,1,@AuxA3549pppcu,0)
            THISFORM.A3549pppcu = AuxA3549pppcu
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03832) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03832 = Gx_err
            THISFORM.GX_DB_GetT03832_01 ()
            IF .NOT. THISFORM.T03832 <> 103
               DO GX_ERRMW WITH "PRPOCO reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03832 = 101 .OR. THISFORM.Z3550PPPFC <> THISFORM.Buf_T03832_3550PPPFC
               DO GX_ERRMW WITH "PRPOCO fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03835" , @HStmt_T03835 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRPOCO","T03835","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03835) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [PRPOCO] ([pppcuit], [PPPFC], [PPPFP], [PPPDesc]) VALUES (?, ?, ?, ?) "
                  cmdbuf = cmdbuf + "  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03835,cmdbuf)
                  THISFORM.GX_DB_BindParmT03835_01 ()
               ENDIF
               AuxA3549pppcu = THISFORM.A3549pppcu
               Gx_err = GX_DB_SetDouble( HStmt_T03835,1,@AuxA3549pppcu,0)
               THISFORM.A3549pppcu = AuxA3549pppcu
               AuxA3550PPPFC = THISFORM.A3550PPPFC
               Gx_err = GX_DB_SetDate( HStmt_T03835,2,@AuxA3550PPPFC,0)
               THISFORM.A3550PPPFC = AuxA3550PPPFC
               AuxA3551PPPFP = THISFORM.A3551PPPFP
               Gx_err = GX_DB_SetDate( HStmt_T03835,3,@AuxA3551PPPFP,0)
               THISFORM.A3551PPPFP = AuxA3551PPPFP
               AuxA3552PPPDe = THISFORM.A3552PPPDe
               Gx_err = GX_DB_SetStr( HStmt_T03835,4,AuxA3552PPPDe,200,0)
               THISFORM.A3552PPPDe = AuxA3552PPPDe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03835) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03835 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03835) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03835 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03836" , @HStmt_T03836 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRPOCO","T03836","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03836) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [PRPOCO] SET [PPPFC]=?, [PPPFP]=?, [PPPDesc]=?  WHERE [pppcuit] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03836,cmdbuf)
                  THISFORM.GX_DB_BindParmT03836_01 ()
               ENDIF
               AuxA3550PPPFC = THISFORM.A3550PPPFC
               Gx_err = GX_DB_SetDate( HStmt_T03836,1,@AuxA3550PPPFC,0)
               THISFORM.A3550PPPFC = AuxA3550PPPFC
               AuxA3551PPPFP = THISFORM.A3551PPPFP
               Gx_err = GX_DB_SetDate( HStmt_T03836,2,@AuxA3551PPPFP,0)
               THISFORM.A3551PPPFP = AuxA3551PPPFP
               AuxA3552PPPDe = THISFORM.A3552PPPDe
               Gx_err = GX_DB_SetStr( HStmt_T03836,3,AuxA3552PPPDe,200,0)
               THISFORM.A3552PPPDe = AuxA3552PPPDe
               AuxA3549pppcu = THISFORM.A3549pppcu
               Gx_err = GX_DB_SetDouble( HStmt_T03836,4,@AuxA3549pppcu,0)
               THISFORM.A3549pppcu = AuxA3549pppcu
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03836) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03836 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03836) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03837" , @HStmt_T03837 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRPOCO","T03837","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03837) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [PRPOCO]  WHERE [pppcuit] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03837,cmdbuf)
                  THISFORM.GX_DB_BindParmT03837_01 ()
               ENDIF
               AuxA3549pppcu = THISFORM.A3549pppcu
               Gx_err = GX_DB_SetDouble( HStmt_T03837,1,@AuxA3549pppcu,0)
               THISFORM.A3549pppcu = AuxA3549pppcu
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03837) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03837 = Gx_err
               THISFORM.T03832 = iif( THISFORM.T03837 = 0 , 104 , THISFORM.T03837 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03837) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 402 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
