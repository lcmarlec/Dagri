               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03812,3,PADR( TRIM(THISFORM.AV5C1230),12, '%'),LEN(PADR( TRIM(THISFORM.AV5C1230),12, '%')),0)
               AuxAV6C1232 = THISFORM.AV6C1232
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03812,4,@AuxAV6C1232,0)
               THISFORM.AV6C1232 = AuxAV6C1232
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03812) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03812 = Gx_err
               THISFORM.GX_DB_GetW03812_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03812 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03812) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03812 = Gx_err
                  THISFORM.GX_DB_GetW03812_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03812 <> 101
               BRKVAL2 = .F.
               THISFORM.A1232ExtCt = THISFORM.Buf_W03812_1232ExtCtaImp
               THISFORM.A1230ExtCt = THISFORM.Buf_W03812_1230ExtCtaCod
               GX_SFLOAD = 0
               THISFORM.U12VAL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03812) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03812 = Gx_err
               THISFORM.GX_DB_GetW03812_01 ()
            ENDDO
         ENDIF
      ENDPROC
