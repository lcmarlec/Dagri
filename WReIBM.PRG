         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08634" , @HStmt_W08634 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREIBM","W08634","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W08634) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [ReINroI], [ReIRoI], [EmpCod], [ReINro] FROM [REINCID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [ReIRoI] = ? and [ReINroI] = ? ORDER BY [EmpCod], [ReIRoI], [ReINroI]  "
