      PROCEDURE CreateTemp
         LOCAL SCW186S16
         SCW186S16 = ""
         IF USED( "SCW186S16" )
            SELECT SCW186S16
            SCW186S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW186S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA82BcoFDe"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA83BcoFHa"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW186S16 = GETE('z:\temp') + '\' + SCW186S16
            ENDIF
            CREATE DBF (SCW186S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW186S16) EXCLUSIVE ALIAS SCW186S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW186S16
         THIS.GX_SfAlias = "SCW186S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01862" , @HStmt_W01862 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0081","W01862","",GX_CURSOR_TYPE_READONLY,@HStmt_W01862) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [BcoCta], [BcoMax], [BcoSld], [BcoFHa], [BcoFDe] FROM [BANCOS2] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([BcoCta] = ? and [BcoFDe] >= ?) AND ([BcoFHa] >= ?) AND ([BcoMax] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([BcoSld] >= ?) ORDER BY [BcoCta], [BcoFDe]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01862,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01862,8)
                  THISFORM.GX_DB_BindColsW01862_01 ()
                  THISFORM.GX_DB_BindParmW01862_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01862,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxAV18C82 = THISFORM.AV18C82
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01862,2,@AuxAV18C82,0)
               THISFORM.AV18C82 = AuxAV18C82
               AuxAV17C83 = THISFORM.AV17C83
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01862,3,@AuxAV17C83,0)
               THISFORM.AV17C83 = AuxAV17C83
               AuxAV16C84 = THISFORM.AV16C84
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01862,4,@AuxAV16C84,0)
               THISFORM.AV16C84 = AuxAV16C84
               AuxAV15C85 = THISFORM.AV15C85
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01862,5,@AuxAV15C85,0)
               THISFORM.AV15C85 = AuxAV15C85
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01862) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01862 = Gx_err
               THISFORM.GX_DB_GetW01862_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01862 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01862) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01862 = Gx_err
                  THISFORM.GX_DB_GetW01862_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01862 <> 101
               BRKV562 = .F.
               THISFORM.A84BcoMax = THISFORM.Buf_W01862_84BcoMax
               THISFORM.A85BcoSld = THISFORM.Buf_W01862_85BcoSld
               THISFORM.A83BcoFHa = THISFORM.Buf_W01862_83BcoFHa
               THISFORM.A82BcoFDe = THISFORM.Buf_W01862_82BcoFDe
               GX_SFLOAD = 0
               THISFORM.U12V562 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01862) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01862 = Gx_err
               THISFORM.GX_DB_GetW01862_01 ()
            ENDDO
         ENDIF
      ENDPROC
