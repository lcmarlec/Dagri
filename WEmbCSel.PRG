            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_LAST"
            THISFORM.DoLast
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_DELREC"
            THISFORM.DoDelete
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_REFRESH"
            THISFORM.DoRefresh
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_SELECT"
            THISFORM.DoPrompt
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_COPY"
            THISFORM.ActiveControl.GetSelected()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CUT"
            THISFORM.ActiveControl.CutSelected()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_PASTE"
            THISFORM.ActiveControl.PutSelected()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_DELETE"
