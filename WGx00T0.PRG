      PROCEDURE CreateTemp
         LOCAL SCW211S20
         SCW211S20 = ""
         IF USED( "SCW211S20" )
            SELECT SCW211S20
            SCW211S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW211S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA291C10FE"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA292C10TI"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA293C10NU"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 13
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA294C10CO"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA318C11CO"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW211S20 = GETE('z:\temp') + '\' + SCW211S20
            ENDIF
            CREATE DBF (SCW211S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW211S20) EXCLUSIVE ALIAS SCW211S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW211S20
         THIS.GX_SfAlias = "SCW211S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02112" , @HStmt_W02112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00T0","W02112","",GX_CURSOR_TYPE_READONLY,@HStmt_W02112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [C11CANCAJ], [C11UNXCAJ], [C11CODART], [C10CODPRO], [C10NUMDOC], [C10TIPDOC], "
                  cmdbuf = cmdbuf + "  [C10FECDOC] FROM [DC1100] (FASTFIRSTROW NOLOCK) WHERE ([C10FECDOC] >= ? and [C10TIPDOC] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([C10NUMDOC] like ?) AND ([C10CODPRO] >= ?) AND ([C11CODART] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([C11CANCAJ] >= ?) AND ([C11UNXCAJ] >= ?) ORDER BY [C10FECDOC], [C10TIPDOC], [C10NUMDOC], "
                  cmdbuf = cmdbuf + "  [C10CODPRO], [C11CODART]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02112,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02112,8)
                  THISFORM.GX_DB_BindColsW02112_01 ()
                  THISFORM.GX_DB_BindParmW02112_01 ()
               ENDIF
               AuxAV21C291 = THISFORM.AV21C291
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02112,1,@AuxAV21C291,0)
               THISFORM.AV21C291 = AuxAV21C291
               AuxAV20C292 = THISFORM.AV20C292
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02112,2,@AuxAV20C292,0)
               THISFORM.AV20C292 = AuxAV20C292
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02112,3,PADR( TRIM(THISFORM.AV19C293),13, '%'),LEN(PADR( TRIM(THISFORM.AV19C293),13, '%')),0)
               AuxAV18C294 = THISFORM.AV18C294
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02112,4,@AuxAV18C294,0)
               THISFORM.AV18C294 = AuxAV18C294
               AuxAV17C318 = THISFORM.AV17C318
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02112,5,@AuxAV17C318,0)
               THISFORM.AV17C318 = AuxAV17C318
               AuxAV16C319 = THISFORM.AV16C319
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02112,6,@AuxAV16C319,0)
               THISFORM.AV16C319 = AuxAV16C319
               AuxAV15C320 = THISFORM.AV15C320
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02112,7,@AuxAV15C320,0)
               THISFORM.AV15C320 = AuxAV15C320
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02112 = Gx_err
               THISFORM.GX_DB_GetW02112_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02112) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02112 = Gx_err
                  THISFORM.GX_DB_GetW02112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02112 <> 101
               BRKV5V2 = .F.
               THISFORM.A319C11CAN = THISFORM.Buf_W02112_319C11CANCAJ
               THISFORM.A320C11UNX = THISFORM.Buf_W02112_320C11UNXCAJ
               THISFORM.A318C11COD = THISFORM.Buf_W02112_318C11CODART
               THISFORM.A294C10COD = THISFORM.Buf_W02112_294C10CODPRO
               THISFORM.A293C10NUM = THISFORM.Buf_W02112_293C10NUMDOC
               THISFORM.A292C10TIP = THISFORM.Buf_W02112_292C10TIPDOC
               THISFORM.A291C10FEC = THISFORM.Buf_W02112_291C10FECDOC
               GX_SFLOAD = 0
               THISFORM.U12V5V2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02112 = Gx_err
               THISFORM.GX_DB_GetW02112_01 ()
            ENDDO
         ENDIF
      ENDPROC
