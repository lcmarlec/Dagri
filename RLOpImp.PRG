      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R08103) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R08103 = Gx_err
      GX_DB_GetR08103_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08103) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL3 = .F.
   Gxline = "<tr><td></td><td></td><td></td><td></td><td>Total Gral.</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td>" + str( RV31Totale , 12 , 2 ) + "</td><td>" + str( RV39Totalo , 12 , 2 ) + "</td></tr>"
   * User Code
   fputs(gxArch, gxline)
   * User Code
   fclose(gxArch)
   RV34E = opendocument( Gxarchivo )
   DO EPMI0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

