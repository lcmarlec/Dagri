                  THISFORM.GX_DB_BindColsW01022_01 ()
                  THISFORM.GX_DB_BindParmW01022_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01022,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
