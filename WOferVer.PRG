               ENDDO
               THISFORM.W01022 = Gx_err
               THISFORM.GX_DB_GetW01022_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV20Pgmnam = "WOferVer"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01022 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01022) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01022 = Gx_err
                  THISFORM.GX_DB_GetW01022_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
