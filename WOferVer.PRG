               THISFORM.A1868OfvPr = THISFORM.Buf_W01022_1868OfvPrc
               THISFORM.A1867OfvFH = THISFORM.Buf_W01022_1867OfvFHa
               GX_SFLOAD = 0
               THISFORM.U13V2U2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01022) ,  ,  ,  , CS_SQLSRV ,  )
