      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01022" , @HStmt_W01022 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFERVER","W01022","",GX_CURSOR_TYPE_READONLY,@HStmt_W01022) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T4.[EntLgVdrCo] AS EntLgVdrCo, T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[OfvFDe], T1.[EntGruTip], T1.[EntCod], T1.[GrpOf], T6.[OfvUsu], T6.[OfvFch], "
                  cmdbuf = cmdbuf + "  T4.[EntLgDom], T4.[EntLgDsc], T1.[EntLgCod], T6.[OfvPrc], T3.[EntRaz], T2.[ArtDsc], "
                  cmdbuf = cmdbuf + "  T6.[OfvFHa] FROM ((((([OFVTA1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T3.[EntGruTip] = T1.[EntGruTip] AND T3.[EntCod] = T1.[EntCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CLTES] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip] AND T4.[EntCod] = T1.[EntCod] AND T4.[EntLgCod] = T1.[EntLgCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [VEND] T5 (NOLOCK) ON T5.[EmpCod] = T1.[EmpCod] AND T5.[VdrCod] = T4.[EntLgVdrCo]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [OFVTA] T6 (NOLOCK) ON T6.[EmpCod] = T1.[EmpCod] AND T6.[FamCod] = T1.[FamCod] "
                  cmdbuf = cmdbuf + "  AND T6.[FamSubCod] = T1.[FamSubCod] AND T6.[ArtCod] = T1.[ArtCod] AND T6.[OfvFDe] "
                  cmdbuf = cmdbuf + "  = T1.[OfvFDe] AND T6.[EntGruTip] = T1.[EntGruTip] AND T6.[EntCod] = T1.[EntCod] "
                  cmdbuf = cmdbuf + "  AND T6.[GrpOf] = T1.[GrpOf]) WHERE T1.[EmpCod] = ? and T1.[FamCod] = ? and T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[ArtCod] = ? and T1.[OfvFDe] = ? and T1.[EntGruTip] = ? and T1.[EntCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[GrpOf] = ? ORDER BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[OfvFDe], T1.[EntGruTip], T1.[EntCod], T1.[GrpOf]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01022,cmdbuf)
