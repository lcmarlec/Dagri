      PROCEDURE CreateTemp
         LOCAL SCW216S20
         SCW216S20 = ""
         IF USED( "SCW216S20" )
            SELECT SCW216S20
            SCW216S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW216S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA354DcCRO"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA355DcCRO"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 1
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA356DcCRO"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 5
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA357DcCRO"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA358DcCRO"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW216S20 = GETE('z:\temp') + '\' + SCW216S20
            ENDIF
            CREATE DBF (SCW216S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW216S20) EXCLUSIVE ALIAS SCW216S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW216S20
         THIS.GX_SfAlias = "SCW216S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02162" , @HStmt_W02162 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00Y2","W02162","",GX_CURSOR_TYPE_READONLY,@HStmt_W02162) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DcCNroInt], [DcCRORULin], [DcCRORNro], [DcCRORSuc], [DcCRORTip], "
                  cmdbuf = cmdbuf + "  [DcCRORNroI] FROM [DCCOM1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [DcCNroInt] "
                  cmdbuf = cmdbuf + "  = ? and [DcCRORNroI] >= ?) AND ([DcCRORTip] like ?) AND ([DcCRORSuc] >= ?) AND ([DcCRORNro] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([DcCRORULin] >= ?) ORDER BY [EmpCod], [DcCNroInt], [DcCRORNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02162,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02162,9)
                  THISFORM.GX_DB_BindColsW02162_01 ()
                  THISFORM.GX_DB_BindParmW02162_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02162,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02162,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               AuxAV5C354 = THISFORM.AV5C354
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02162,3,@AuxAV5C354,0)
               THISFORM.AV5C354 = AuxAV5C354
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02162,4,PADR( TRIM(THISFORM.AV6C355),1, '%'),LEN(PADR( TRIM(THISFORM.AV6C355),1, '%')),0)
               AuxAV7C356 = THISFORM.AV7C356
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02162,5,@AuxAV7C356,0)
               THISFORM.AV7C356 = AuxAV7C356
               AuxAV8C357 = THISFORM.AV8C357
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02162,6,@AuxAV8C357,0)
               THISFORM.AV8C357 = AuxAV8C357
               AuxAV9C358 = THISFORM.AV9C358
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02162,7,@AuxAV9C358,0)
               THISFORM.AV9C358 = AuxAV9C358
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02162 = Gx_err
               THISFORM.GX_DB_GetW02162_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02162 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02162) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02162 = Gx_err
                  THISFORM.GX_DB_GetW02162_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02162 <> 101
               BRKV602 = .F.
               THISFORM.A358DcCROR = THISFORM.Buf_W02162_358DcCRORULin
               THISFORM.A357DcCROR = THISFORM.Buf_W02162_357DcCRORNro
               THISFORM.A356DcCROR = THISFORM.Buf_W02162_356DcCRORSuc
               THISFORM.A355DcCROR = THISFORM.Buf_W02162_355DcCRORTip
               THISFORM.A354DcCROR = THISFORM.Buf_W02162_354DcCRORNroI
               GX_SFLOAD = 0
               THISFORM.U12V602 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02162 = Gx_err
               THISFORM.GX_DB_GetW02162_01 ()
            ENDDO
         ENDIF
      ENDPROC
