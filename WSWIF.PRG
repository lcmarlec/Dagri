            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA2394OpaS"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 15
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2395OpaM"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 240
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2398OpaC"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 4

            GX_STRUCT[ 7 ,1]= "sA2396OpaI"
