      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07953" , @HStmt_W07953 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSWIF","W07953","",GX_CURSOR_TYPE_READONLY,@HStmt_W07953) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [OpaEntCod], [OPaNroI], [OpaImpOri], [OpaCotiz], [OpaMon], [OpaSwif], "
                  cmdbuf = cmdbuf + "  [OpaTot], [OpaFch], [OPaNro] FROM [OPAGOS] (FASTFIRSTROW NOLOCK) WHERE ([OpaEntCod] "
                  cmdbuf = cmdbuf + "  = ?) AND ([OpaFch] >= ?) AND (( [OpaSwif] IS NULL and ? = 0) or ( [OpaSwif] = ' ' "
                  cmdbuf = cmdbuf + "  and ? = 0) or ( [OpaSwif] <> ' ' and ? = 1) or ? = 9) ORDER BY [EmpCod], [OPaNroI] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07953,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07953,12)
                  THISFORM.GX_DB_BindColsW07953_01 ()
                  THISFORM.GX_DB_BindParmW07953_01 ()
               ENDIF
               AuxAV21Prvdes = THISFORM.AV21Prvdes
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07953,1,@AuxAV21Prvdes,0)
               THISFORM.AV21Prvdes = AuxAV21Prvdes
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07953,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               AuxAV22Conswi = THISFORM.AV22Conswi
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07953,3,@AuxAV22Conswi,0)
               THISFORM.AV22Conswi = AuxAV22Conswi
               AuxAV22Conswi = THISFORM.AV22Conswi
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07953,4,@AuxAV22Conswi,0)
               THISFORM.AV22Conswi = AuxAV22Conswi
               AuxAV22Conswi = THISFORM.AV22Conswi
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07953,5,@AuxAV22Conswi,0)
               THISFORM.AV22Conswi = AuxAV22Conswi
               AuxAV22Conswi = THISFORM.AV22Conswi
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07953,6,@AuxAV22Conswi,0)
               THISFORM.AV22Conswi = AuxAV22Conswi
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07953) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07953 = Gx_err
               THISFORM.GX_DB_GetW07953_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WSWIF"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07953 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07953) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07953 = Gx_err
                  THISFORM.GX_DB_GetW07953_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07953 <> 101
               BRKVM32 = .F.
               THISFORM.A713OpaEnt = THISFORM.Buf_W07953_713OpaEntCod
               THISFORM.A708OPaNro = THISFORM.Buf_W07953_708OPaNroI
               THISFORM.A2396OpaIm = THISFORM.Buf_W07953_2396OpaImpOri
               THISFORM.A2398OpaCo = THISFORM.Buf_W07953_2398OpaCotiz
               THISFORM.A2395OpaMo = THISFORM.Buf_W07953_2395OpaMon
               THISFORM.A2394OpaSw = THISFORM.Buf_W07953_2394OpaSwif
               THISFORM.A729OpaTot = THISFORM.Buf_W07953_729OpaTot
               THISFORM.A709OpaFch = THISFORM.Buf_W07953_709OpaFch
               THISFORM.A718OPaNro = THISFORM.Buf_W07953_718OPaNro
               GX_SFLOAD = 0
               THISFORM.U17VM32 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07953) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07953 = Gx_err
               THISFORM.GX_DB_GetW07953_01 ()
            ENDDO
         ENDIF
      ENDPROC
