            GX_STRUCT[ 8 ,1]= "sA708OPaNr"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW795S22 = GETE('z:\temp') + '\' + SCW795S22
            ENDIF
            CREATE DBF (SCW795S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW795S22) EXCLUSIVE ALIAS SCW795S22
         ENDIF
