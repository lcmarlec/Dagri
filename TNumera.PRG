               ENDDO
               Gx_fcond = THISFORM.T00727 <> 101 .AND. THISFORM.Buf_T00727_2EmpCod = THISFORM.A2EmpCod
               DO WHILE Gx_fcond
                  Gx_fcond = THISFORM.Buf_T00727_2EmpCod = THISFORM.A2EmpCod
                  IF Gx_fcond
                     EXIT
                  ELSE
                     Gx_eop = 1
                     DO WHILE Gx_eop != 0
                        Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00727) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDDO
                     THISFORM.T00727 = Gx_err
