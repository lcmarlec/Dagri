      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S677NumCod
         LOCAL S679NumSuc
         S2EmpCod = THISFORM.A2EmpCod
         S677NumCod = THISFORM.A677NumCod
         S679NumSuc = THISFORM.A679NumSuc
         THISFORM.A679NumSuc = THISFORM.M679NumSuc
         THISFORM. cCT72S10 .SaveTemp()
         THISFORM. cCT72S10 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT72S10 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT72S10 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT72S10 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S677NumCod = THISFORM.A677NumCod .AND. S679NumSuc = THISFORM.A679NumSuc
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT72S10 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT72S10 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S677NumCod = THISFORM.A677NumCod .AND. S679NumSuc = THISFORM.A679NumSuc
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT72S10 .Refresh()
               THISFORM. cCT72S10 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A677NumCod = S677NumCod
               THISFORM.A679NumSuc = S679NumSuc
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT72S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT72S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S677NumCod = THISFORM.A677NumCod .AND. S679NumSuc = THISFORM.A679NumSuc
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT72S10 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S677NumCod = THISFORM.A677NumCod .AND. S679NumSuc = THISFORM.A679NumSuc
            ENDDO
            IF sf_err != 0
               THISFORM. cCT72S10 .AppendRow()
               THISFORM. cCT72S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A677NumCod = S677NumCod
               THISFORM.A679NumSuc = S679NumSuc
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A677NumCod = S677NumCod
         THISFORM.A679NumSuc = S679NumSuc
         RETURN .F.
      ENDFUNC
      FUNCTION SF_INSERT()
         LOCAL gxO_Area
         gxO_Area = SELECT()
         IF EMPTY(THISFORM. cCT72S10 .GX_SfAlias)
            RETURN
         ENDIF
         SELECT (THISFORM. cCT72S10 .GX_SfAlias)
