                  THISFORM.A677NumCod = AuxA677NumCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00725) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00725 = Gx_err
                  THISFORM.GX_DB_GetT00725_01 ()
                  THISFORM. cCT72A677 . ZM2072 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC2072 ()
               THISFORM. cCT72A677 . ZM2072 ( 0 )
               DO GX_CONFW WITH "Eliminar toda la informacion en " + " Numera1 ?", Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC2072 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT72A2508 .CheckTables()
                  RETURN .F.
               ENDIF
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T007215" , @HStmt_T007215 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNUMERA","T007215","",GX_CURSOR_TYPE_READONLY,@HStmt_T007215) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [NumCod], [NumSuc] FROM [NUMERA] (NOLOCK) WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [NumCod] = ? ORDER BY [EmpCod], [NumCod], [NumSuc]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007215,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007215,100)
                  THISFORM.GX_DB_BindColsT007215_01 ()
                  THISFORM.GX_DB_BindParmT007215_01 ()
               ENDIF
               AuxBuf_T00725_2EmpCod = THISFORM.Buf_T00725_2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T007215,1,@AuxBuf_T00725_2EmpCod,0)
               THISFORM.Buf_T00725_2EmpCod = AuxBuf_T00725_2EmpCod
               AuxBuf_T00725_677NumCod = THISFORM.Buf_T00725_677NumCod
               Gx_err = GX_DB_SetStr( HStmt_T007215,2,AuxBuf_T00725_677NumCod,LEN(AuxBuf_T00725_677NumCod),0)
               THISFORM.Buf_T00725_677NumCod = AuxBuf_T00725_677NumCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007215) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007215 = Gx_err
               THISFORM.GX_DB_GetT007215_01 ()
               DO WHILE THISFORM.T007215 <> 101 .AND. THISFORM.Buf_T007215_2EmpCod=THISFORM.Buf_T00725_2EmpCod .AND. THISFORM.Buf_T007215_677NumCod=THISFORM.Buf_T00725_677NumCod
                  THISFORM.A2EmpCod = THISFORM.Buf_T007215_2EmpCod
