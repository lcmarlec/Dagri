      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00727" , @HStmt_T00727 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNUMERA","T00727","",GX_CURSOR_TYPE_READONLY,@HStmt_T00727) ,  ,  ,  , CS_SQLSRV , 0 )
