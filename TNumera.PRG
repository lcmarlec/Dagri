      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T007214" , @HStmt_T007214 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNUMERA","T007214","",GX_CURSOR_TYPE_READONLY,@HStmt_T007214) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [NumCod], [NumSuc], [NumUlt], [NumPre], [NumEle], [NumCnt] FROM "
                  cmdbuf = cmdbuf + "  [NUMERA] (NOLOCK) WHERE [EmpCod] = ? AND [NumCod] = ? ORDER BY [EmpCod], [NumCod], "
                  cmdbuf = cmdbuf + "  [NumSuc]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007214,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007214,14)
                  THISFORM.GX_DB_BindColsT007214_01 ()
                  THISFORM.GX_DB_BindParmT007214_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T007214,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA677NumCod = THISFORM.A677NumCod
               Gx_err = GX_DB_SetStr( HStmt_T007214,2,AuxA677NumCod,3,0)
               THISFORM.A677NumCod = AuxA677NumCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007214) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007214 = Gx_err
               THISFORM.GX_DB_GetT007214_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T007214 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007214) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T007214 = Gx_err
                  THISFORM.GX_DB_GetT007214_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T007214 <> 101
               BRK2073 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT72S10.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T007214_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007214) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007214 = Gx_err
               THISFORM.GX_DB_GetT007214_01 ()
            ENDDO
         ENDIF
      ENDPROC
