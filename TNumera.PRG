                  ENDIF
                  Gx_fcond = THISFORM.T00727 <> 101 .AND. THISFORM.Buf_T00727_2EmpCod = THISFORM.A2EmpCod
               ENDDO
            CASE GXOP = 2 && Next record
               M677NumCod = THISFORM.A677NumCod
               THISFORM.A677NumCod = SPACE(3)
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00727,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA677NumCod = THISFORM.A677NumCod
               Gx_err = GX_DB_SetStr( HStmt_T00727,2,AuxA677NumCod,3,0)
               THISFORM.A677NumCod = AuxA677NumCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00727) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00727 = Gx_err
               THISFORM.GX_DB_GetT00727_01 ()
               THISFORM.A677NumCod = M677NumCod
               DO WHILE THISFORM.T00727 = 0 .AND. THISFORM.A2EmpCod = THISFORM.Buf_T00727_2EmpCod .AND. THISFORM.A677NumCod >= THISFORM.Buf_T00727_677NumCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00727) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00727 = Gx_err
