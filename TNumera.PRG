               DO CASE
                  CASE THISFORM.GX_Curr_Level = 72
                     THISFORM.SaveMode( "DLT" ,"")
                  CASE THISFORM.GX_Curr_Level = 73
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA2EmpCod = THISFORM.A2EmpCod
                  Gx_err = GX_DB_SetInt( HStmt_T00725,1,@AuxA2EmpCod,0)
