            GX_STRUCT[ 4 ,1]= "sA3148NumP"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2505NumC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV11Numer"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 20
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "VGx_mode"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 3
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT72S10 = GETE('z:\temp') + '\' + SCT72S10
            ENDIF
            CREATE DBF (SCT72S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCT72S10) EXCLUSIVE ALIAS SCT72S10
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT72S10
