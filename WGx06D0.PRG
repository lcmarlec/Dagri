               AuxAV8C1974 = THISFORM.AV8C1974
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W06592,4,@AuxAV8C1974,0)
               THISFORM.AV8C1974 = AuxAV8C1974
               AuxAV9C1975 = THISFORM.AV9C1975
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06592,5,@AuxAV9C1975,0)
               THISFORM.AV9C1975 = AuxAV9C1975
               AuxAV10C1976 = THISFORM.AV10C1976
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06592,6,@AuxAV10C1976,0)
               THISFORM.AV10C1976 = AuxAV10C1976
               AuxAV11C1977 = THISFORM.AV11C1977
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06592,7,@AuxAV11C1977,0)
               THISFORM.AV11C1977 = AuxAV11C1977
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06592 = Gx_err
               THISFORM.GX_DB_GetW06592_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06592 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06592) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06592 = Gx_err
                  THISFORM.GX_DB_GetW06592_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06592 <> 101
               BRKVIB2 = .F.
               THISFORM.A1975CtrCa = THISFORM.Buf_W06592_1975CtrCaiAno
               THISFORM.A1976CtrCa = THISFORM.Buf_W06592_1976CtrCaiMes
               THISFORM.A1977CtrCa = THISFORM.Buf_W06592_1977CtrCaiDde
               THISFORM.A1974CtrCa = THISFORM.Buf_W06592_1974CtrCaifch
               THISFORM.A1973CtrCa = THISFORM.Buf_W06592_1973CtrCaiUsu
               THISFORM.A1972CtrCa = THISFORM.Buf_W06592_1972CtrCaiTpo
               THISFORM.A2EmpCod = THISFORM.Buf_W06592_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VIB2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06592 = Gx_err
               THISFORM.GX_DB_GetW06592_01 ()
            ENDDO
         ENDIF
      ENDPROC
