      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         THISFORM. GXInLvl165 = .T.
         IF THISFORM.GX_last_fld_lvl = 165
            IF ! THISFORM. gx_165insert
               THISFORM.SetLevel( 165 )
               THISFORM.SetMode("EOF", "1" )
               CGXCheckBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 165
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 165 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01393) , "TCAIPROV" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01392) , "TCAIPROV" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01394) , "TCAIPROV" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT139A1827 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 165
            IF ! THISFORM. gx_165insert
               THISFORM.SetLevel( 165 )
               THISFORM.SetMode("EOF", "1" )
               CGXCheckBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_165insert
            THISFORM. gx_165insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 165 )
            THISFORM. cCT139A1417 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXCheckBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 165
            THISFORM.SetLevel( 165 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT139A2 .InitLevel( 165 )
            THISFORM.GX_last_fld_lvl = 165
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A1827ComCA"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
