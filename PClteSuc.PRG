         Gx_err = GX_DB_SetStr( HStmt_P05014,17,R1439EntLg,1,0)
         Gx_err = GX_DB_SetInt( HStmt_P05014,18,@R1845EntLg,0)
         Gx_err = GX_DB_SetStr( HStmt_P05014,19,R1886EntLg,1,0)
         Gx_err = GX_DB_SetStr( HStmt_P05014,20,R1887entLg,30,0)
         Gx_err = GX_DB_SetStr( HStmt_P05014,21,R1917EntLg,15,0)
         Gx_err = GX_DB_SetStr( HStmt_P05014,22,R1926EntLg,1,0)
         Gx_err = GX_DB_SetStr( HStmt_P05014,23,R2009EntLg,10,0)
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P05014) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P05014 = Gx_err
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P05014) ,  ,  ,  , CS_SQLSRV ,  )
         IF P05014 = 1
            Gx_err = 1
            Gx_emsg = "Ya existe el registro"
         ELSE
            Gx_err = 0
            Gx_emsg = ""
         ENDIF
         * End Insert
         LEVEL4 = .F.
         DO TClteSuc WITH "UPD" , 1 , AV8Empcod , AV11Fechas , AV12Usuari , R2EmpCod , R150EntGru , R120EntCod
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      * Exiting from a For First loop.
      EXIT
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P05012) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   IF TYPE( "HConn_Default" ) = "N"
      IF GXCONNECTED
         Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
      ENDIF
   ENDIF
   DO EPDX0
   RETURN
   DO EPDX0
   RETURN
   GX_retp = 0
* End Program

