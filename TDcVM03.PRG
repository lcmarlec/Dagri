      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T004417" , @HStmt_T004417 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCVM03","T004417","",GX_CURSOR_TYPE_READONLY,@HStmt_T004417) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TDVNroInt], [TDVImpCod] AS TDVImpCod, [TDVNim], [TDVImpCnt] FROM "
                  cmdbuf = cmdbuf + "  [TDVABM] (NOLOCK) WHERE [EmpCod] = ? AND [TDVNroInt] = ? ORDER BY [EmpCod], [TDVNroInt], "
                  cmdbuf = cmdbuf + "  [TDVImpCod], [TDVNim]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T004417,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T004417,9)
                  THISFORM.GX_DB_BindColsT004417_01 ()
                  THISFORM.GX_DB_BindParmT004417_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T004417,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA473TDVNro = THISFORM.A473TDVNro
               Gx_err = GX_DB_SetDouble( HStmt_T004417,2,@AuxA473TDVNro,0)
               THISFORM.A473TDVNro = AuxA473TDVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T004417) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T004417 = Gx_err
               THISFORM.GX_DB_GetT004417_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T004417 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T004417) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T004417 = Gx_err
                  THISFORM.GX_DB_GetT004417_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T004417 <> 101
               BRK1847 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT44S15.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T004417_473TDVNroInt = THISFORM.A473TDVNro .AND. THISFORM.Buf_T004417_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T004417) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T004417 = Gx_err
               THISFORM.GX_DB_GetT004417_01 ()
            ENDDO
         ENDIF
      ENDPROC
