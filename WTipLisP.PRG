      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06902" , @HStmt_W06902 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WTIPLISP","W06902","",GX_CURSOR_TYPE_READONLY,@HStmt_W06902) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[TEntTLprc], T2.[EntRaz] AS TEntRaz, T1.[TEntCod] AS TEntCod, "
                  cmdbuf = cmdbuf + "  T1.[TEntGruTip] AS TEntGruTip, T1.[TcliNI] FROM ([TCLIENTE] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[TEntGruTip] AND T2.[EntCod] = T1.[TEntCod]) WHERE (T1.[EmpCod] = ? and T1.[TcliNI] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[TEntTLprc] = ? or ? = 'T') ORDER BY T1.[EmpCod], T1.[TcliNI], T1.[TEntGruTip], "
                  cmdbuf = cmdbuf + "  T1.[TEntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06902,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06902,10)
                  THISFORM.GX_DB_BindColsW06902_01 ()
                  THISFORM.GX_DB_BindParmW06902_01 ()
               ENDIF
               AuxAV10Empcod = THISFORM.AV10Empcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06902,1,@AuxAV10Empcod,0)
               THISFORM.AV10Empcod = AuxAV10Empcod
               AuxAV13Tclini = THISFORM.AV13Tclini
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06902,2,@AuxAV13Tclini,0)
               THISFORM.AV13Tclini = AuxAV13Tclini
               AuxAV21Entinh = THISFORM.AV21Entinh
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06902,3,AuxAV21Entinh,1,0)
               THISFORM.AV21Entinh = AuxAV21Entinh
               AuxAV21Entinh = THISFORM.AV21Entinh
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06902,4,AuxAV21Entinh,1,0)
               THISFORM.AV21Entinh = AuxAV21Entinh
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06902) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06902 = Gx_err
               THISFORM.GX_DB_GetW06902_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WTipLisP"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06902 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06902) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06902 = Gx_err
                  THISFORM.GX_DB_GetW06902_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06902 <> 101
               BRKVJ62 = .F.
               THISFORM.AV8Selecio = SPACE(1)
               THISFORM.A2EmpCod = THISFORM.Buf_W06902_2EmpCod
               THISFORM.A2129TEntT = THISFORM.Buf_W06902_2129TEntTLprc
               THISFORM.A2128TEntR = THISFORM.Buf_W06902_2128TEntRaz
               THISFORM.A2127TEntC = THISFORM.Buf_W06902_2127TEntCod
               THISFORM.A2126TEntG = THISFORM.Buf_W06902_2126TEntGruTip
               THISFORM.A2141TcliN = THISFORM.Buf_W06902_2141TcliNI
               THISFORM.A2128TEntR = THISFORM.Buf_W06902_2128TEntRaz
               GX_SFLOAD = 0
               THISFORM.U17VJ62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06902) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06902 = Gx_err
               THISFORM.GX_DB_GetW06902_01 ()
            ENDDO
         ENDIF
