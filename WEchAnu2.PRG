      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03942" , @HStmt_W03942 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WECHANU2","W03942","",GX_CURSOR_TYPE_READONLY,@HStmt_W03942) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EChLin], T1.[EmpCod], T1.[ECHNroInt], T1.[EChFchDeb], T1.[EChImp], T1.[EchOrden], "
                  cmdbuf = cmdbuf + "  T1.[EchSuc], T2.[BcoDsc] AS EchBcoDsc, T1.[EchBco] AS EchBco, T1.[EchNroReg], T1.[EchNroCh], "
                  cmdbuf = cmdbuf + "  T1.[EchCtaChNr], T1.[EchCtaCh], T1.[EchTip], T3.[EchEst], T3.[EchObs], T3.[EchMotDsc], "
                  cmdbuf = cmdbuf + "  T3.[ECHMotCod], T3.[ECHFch] FROM (([ENTCHE1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[EchBco]) LEFT JOIN [ENTCHE] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[ECHNroInt] = T1.[ECHNroInt]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[ECHNroInt] = ? ORDER BY T1.[EmpCod], T1.[ECHNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03942,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03942,10)
                  THISFORM.GX_DB_BindColsW03942_01 ()
                  THISFORM.GX_DB_BindParmW03942_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03942,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03942,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03942) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03942 = Gx_err
               THISFORM.GX_DB_GetW03942_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WEchAnu2"
               THISFORM.Gx_err = 0
               THISFORM.VEVAY1101 ( THISFORM.A2EmpCod , THISFORM.A1083ECHNr )
               THISFORM. cCW394A1101 .Refresh()
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03942 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03942) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03942 = Gx_err
                  THISFORM.GX_DB_GetW03942_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03942 <> 101
               BRKVAY2 = .F.
               THISFORM.A1098EChFc = THISFORM.Buf_W03942_1098EChFchDeb
               THISFORM.A1097EChIm = THISFORM.Buf_W03942_1097EChImp
               THISFORM.A1096EchOr = THISFORM.Buf_W03942_1096EchOrden
               THISFORM.A1131EchSu = THISFORM.Buf_W03942_1131EchSuc
               THISFORM.A1130EchBc = THISFORM.Buf_W03942_1130EchBcoDsc
               THISFORM.A1129EchBc = THISFORM.Buf_W03942_1129EchBco
               THISFORM.A1095EchNr = THISFORM.Buf_W03942_1095EchNroReg
               THISFORM.A1094EchNr = THISFORM.Buf_W03942_1094EchNroCh
               THISFORM.A1099EchCt = THISFORM.Buf_W03942_1099EchCtaChNr
               THISFORM.A1093EchCt = THISFORM.Buf_W03942_1093EchCtaCh
               THISFORM.A1090EchTi = THISFORM.Buf_W03942_1090EchTip
               THISFORM.A1265EchEs = THISFORM.Buf_W03942_1265EchEst
               THISFORM.A1087EchOb = THISFORM.Buf_W03942_1087EchObs
               THISFORM.A1086EchMo = THISFORM.Buf_W03942_1086EchMotDsc
               THISFORM.A1085ECHMo = THISFORM.Buf_W03942_1085ECHMotCod
               THISFORM.A1139ECHFc = THISFORM.Buf_W03942_1139ECHFch
               THISFORM.A1130EchBc = THISFORM.Buf_W03942_1130EchBcoDsc
               THISFORM.A1265EchEs = THISFORM.Buf_W03942_1265EchEst
               THISFORM.A1087EchOb = THISFORM.Buf_W03942_1087EchObs
               THISFORM.A1086EchMo = THISFORM.Buf_W03942_1086EchMotDsc
               THISFORM.A1085ECHMo = THISFORM.Buf_W03942_1085ECHMotCod
               THISFORM.A1139ECHFc = THISFORM.Buf_W03942_1139ECHFch
               GX_SFLOAD = 0
               THISFORM.U13VAY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
