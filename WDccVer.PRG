      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00323" , @HStmt_W00323 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCVER","W00323","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00323) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[DcCNroInt], T1.[DccTipRed], T1.[DcCCaiFv], T1.[DcCEst], T1.[EntGruTip], "
                  cmdbuf = cmdbuf + "  T1.[DcCNro], T1.[DccLeye], T1.[DcCTip], T1.[DccMoncod], T1.[DccTotOri], T1.[DccCotiz], "
                  cmdbuf = cmdbuf + "  T1.[DccNroPro], T1.[DcCFecOri], T1.[DccGruCod], T1.[DccCuoId], T2.[EntCuoId], T1.[DccCuoNro], "
                  cmdbuf = cmdbuf + "  T1.[DccCuoAni], T1.[DccAniHta], T1.[DccAniDDe], T1.[DccMesHta], T1.[DccMesDde], "
                  cmdbuf = cmdbuf + "  T1.[DccArtTot], T1.[DCCUsu], T1.[DccObs], T1.[DcCTotSld], T1.[DcCNroCtr], T1.[DcCCtaCte], "
                  cmdbuf = cmdbuf + "  T1.[DcCTot], T1.[DccSer], T1.[DcCFV], T1.[DcCSuc], T1.[DcCFec], T2.[EntRaz], T1.[EntCod] "
                  cmdbuf = cmdbuf + "  FROM ([DCCOM] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[DcCNroInt] = ? ORDER BY T1.[EmpCod], T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00323,cmdbuf)
                  THISFORM.GX_DB_BindColsW00323_01 ()
                  THISFORM.GX_DB_BindParmW00323_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00323,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00323,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00323) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00323 = Gx_err
               THISFORM.GX_DB_GetW00323_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV41Pgmnam = "WDccVer"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00323 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00323) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00323 = Gx_err
                  THISFORM.GX_DB_GetW00323_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00323 <> 101
               BRKV0W2 = .F.
               THISFORM.A1322DccTi = THISFORM.Buf_W00323_1322DccTipRed
               THISFORM.A1221DcCCa = THISFORM.Buf_W00323_1221DcCCaiFv
               THISFORM.A373DcCEst = THISFORM.Buf_W00323_373DcCEst
               THISFORM.A150EntGru = THISFORM.Buf_W00323_150EntGruTip
               THISFORM.A352DcCNro = THISFORM.Buf_W00323_352DcCNro
               THISFORM.A3265DccLe = THISFORM.Buf_W00323_3265DccLeye
               THISFORM.A348DcCTip = THISFORM.Buf_W00323_348DcCTip
               THISFORM.A2382DccMo = THISFORM.Buf_W00323_2382DccMoncod
               THISFORM.A2383DccTo = THISFORM.Buf_W00323_2383DccTotOri
               THISFORM.A2220DccCo = THISFORM.Buf_W00323_2220DccCotiz
               THISFORM.A2828DccNr = THISFORM.Buf_W00323_2828DccNroPro
               THISFORM.A2278DcCFe = THISFORM.Buf_W00323_2278DcCFecOri
               THISFORM.A351DccGru = THISFORM.Buf_W00323_351DccGruCod
               THISFORM.A1811DccCu = THISFORM.Buf_W00323_1811DccCuoId
               THISFORM.A1809EntCu = THISFORM.Buf_W00323_1809EntCuoId
               THISFORM.A1807DccCu = THISFORM.Buf_W00323_1807DccCuoNro
               THISFORM.A1808DccCu = THISFORM.Buf_W00323_1808DccCuoAni
               THISFORM.A1680DccAn = THISFORM.Buf_W00323_1680DccAniHta
               THISFORM.A1678DccAn = THISFORM.Buf_W00323_1678DccAniDDe
               THISFORM.A1679DccMe = THISFORM.Buf_W00323_1679DccMesHta
               THISFORM.A1677DccMe = THISFORM.Buf_W00323_1677DccMesDde
               THISFORM.A1263DccAr = THISFORM.Buf_W00323_1263DccArtTot
               THISFORM.A1737DCCUs = THISFORM.Buf_W00323_1737DCCUsu
               THISFORM.A1591DccOb = THISFORM.Buf_W00323_1591DccObs
               THISFORM.A377DcCTot = THISFORM.Buf_W00323_377DcCTotSld
               THISFORM.A353DcCNro = THISFORM.Buf_W00323_353DcCNroCtr
               THISFORM.A374DcCCta = THISFORM.Buf_W00323_374DcCCtaCte
               THISFORM.A371DcCTot = THISFORM.Buf_W00323_371DcCTot
               THISFORM.A349DccSer = THISFORM.Buf_W00323_349DccSer
               THISFORM.A372DcCFV = THISFORM.Buf_W00323_372DcCFV
               THISFORM.A350DcCSuc = THISFORM.Buf_W00323_350DcCSuc
               THISFORM.A347DcCFec = THISFORM.Buf_W00323_347DcCFec
               THISFORM.A153EntRaz = THISFORM.Buf_W00323_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W00323_120EntCod
               THISFORM.A1809EntCu = THISFORM.Buf_W00323_1809EntCuoId
               THISFORM.A153EntRaz = THISFORM.Buf_W00323_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U17V0W2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
