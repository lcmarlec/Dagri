      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03272" , @HStmt_W03272 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLABADEL","W03272","",GX_CURSOR_TYPE_READONLY,@HStmt_W03272) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [LabaNroInt], [EmpCod], [LabaEntGru], [LabaEntCod], [LabaLgCod], [LabaTot], "
                  cmdbuf = cmdbuf + "  [LabaFNro], [LabaFSuc], [LabaFSer], [LabaFTip], [LabaFFch] FROM [LABAS1] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [LabaNroInt] = ?) AND ([LabaFTip] = ?) AND ([LabaFSuc] "
                  cmdbuf = cmdbuf + "  = ?) AND ([LabaFNro] = ?) ORDER BY [EmpCod], [LabaNroInt], [LabaEntGru], [LabaEntCod], "
                  cmdbuf = cmdbuf + "  [LabaLgCod], [LabaFFch], [LabaFTip], [LabaFSer], [LabaFSuc], [LabaFNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03272,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03272,4)
                  THISFORM.GX_DB_BindColsW03272_01 ()
                  THISFORM.GX_DB_BindParmW03272_01 ()
               ENDIF
               AuxAV5Emprcod = THISFORM.AV5Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03272,1,@AuxAV5Emprcod,0)
               THISFORM.AV5Emprcod = AuxAV5Emprcod
               AuxAV6Ni = THISFORM.AV6Ni
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03272,2,@AuxAV6Ni,0)
               THISFORM.AV6Ni = AuxAV6Ni
               AuxAV7Tipo = THISFORM.AV7Tipo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03272,3,AuxAV7Tipo,4,0)
               THISFORM.AV7Tipo = AuxAV7Tipo
               AuxAV8Suc = THISFORM.AV8Suc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03272,4,@AuxAV8Suc,0)
               THISFORM.AV8Suc = AuxAV8Suc
               AuxAV9Nro = THISFORM.AV9Nro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03272,5,@AuxAV9Nro,0)
               THISFORM.AV9Nro = AuxAV9Nro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03272 = Gx_err
               THISFORM.GX_DB_GetW03272_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03272 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03272) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03272 = Gx_err
                  THISFORM.GX_DB_GetW03272_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03272 <> 101
               BRKV932 = .F.
               THISFORM.A1140LabaN = THISFORM.Buf_W03272_1140LabaNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W03272_2EmpCod
               THISFORM.A1149LabaE = THISFORM.Buf_W03272_1149LabaEntGru
               THISFORM.A1150LabaE = THISFORM.Buf_W03272_1150LabaEntCod
               THISFORM.A1151LabaL = THISFORM.Buf_W03272_1151LabaLgCod
               THISFORM.A1152LabaT = THISFORM.Buf_W03272_1152LabaTot
               THISFORM.A1148LabaF = THISFORM.Buf_W03272_1148LabaFNro
               THISFORM.A1147LabaF = THISFORM.Buf_W03272_1147LabaFSuc
               THISFORM.A1146LabaF = THISFORM.Buf_W03272_1146LabaFSer
               THISFORM.A1145LabaF = THISFORM.Buf_W03272_1145LabaFTip
               THISFORM.A1153LabaF = THISFORM.Buf_W03272_1153LabaFFch
               GX_SFLOAD = 0
               THISFORM.U12V932 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03272 = Gx_err
               THISFORM.GX_DB_GetW03272_01 ()
            ENDDO
         ENDIF
      ENDPROC
