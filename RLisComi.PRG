      IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R08584" , @HStmt_R08584 )
         Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RLISCOMI","R08584","",GX_CURSOR_TYPE_READONLY_NOTNESTED,@HStmt_R08584) ,  ,  ,  , CS_SQLSRV ,  )
         cmdbuf = " SELECT T1.[EmpCod], T1.[ComFch], T1.[ComFcSer], T1.[ComFcSuc], T1.[ComFcNro], T1.[TraCod], "
         cmdbuf = cmdbuf + "  T1.[ComTraFch], T2.[TraNom], T1.[ComTraObs] FROM ([COMIDA1] T1 (NOLOCK) LEFT JOIN "
         cmdbuf = cmdbuf + "  [EMPLEADO] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TraCod] = T1.[TraCod]) "
         cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[ComFch] = ? and T1.[ComFcSer] = ? and T1.[ComFcSuc] "
         cmdbuf = cmdbuf + "  = ? and T1.[ComFcNro] = ? and T1.[TraCod] >= ? and T1.[ComTraFch] >= ?) AND (T1.[ComTraFch] "
         cmdbuf = cmdbuf + "  <= ?) AND (T1.[TraCod] <= ?) ORDER BY T1.[EmpCod], T1.[ComFch], T1.[ComFcSer], T1.[ComFcSuc], "
         cmdbuf = cmdbuf + "  T1.[ComFcNro]  "
         Gx_err = GX_DB_Set_StmtCmdText( HStmt_R08584,cmdbuf)
         Gx_err = GX_DB_Set_StmtFetchSize( HStmt_R08584,100)
         GX_DB_BindColsR08584_01 ()
         GX_DB_BindParmR08584_01 ()
      ENDIF
      Gx_err = GX_DB_SetInt( HStmt_R08584,1,@R2EmpCod,0)
      Gx_err = GX_DB_SetDate( HStmt_R08584,2,@R2899ComFc,0)
