      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08583) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL3 = .F.
   RV22Fila = RV22Fila + 2
