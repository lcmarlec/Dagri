         R2905ComTr = Buf_R08584_2905ComTraFch
         R564TraNom = Buf_R08584_564TraNom
         R2907ComTr = Buf_R08584_2907ComTraObs
         R564TraNom = Buf_R08584_564TraNom
         IF RV87Tracod <> R561TraCod
            RV22Fila = RV22Fila + 1
            RV87Tracod = R561TraCod
         ENDIF
         RV90Docexc.cells(RV22Fila,2).Number = R561TraCod
         RV90Docexc.cells(RV22Fila,3).Text = ALLTRIM( R564TraNom )
         RV46J = 1
         DO WHILE RV46J <= RV27I
            IF R2905ComTr = RV25Fechas[RV46J]
               RV84K = RV46J + 3
               RV90Docexc.cells(RV22Fila,RV84K).Number = 1
            ENDIF
            RV46J = RV46J + 1
            IF UserCancel
               EXIT
            ENDIF
         ENDDO
         RV84K = RV27I + 4
         RV86Factur = "FC" + R2900ComFc + " " + substr( str( R2901ComFc + 10000 , 5 ) , 2 , 4 ) + "-" + substr( str( R2902ComFc + 100000000 , 9 ) , 2 , 8 )
         RV90Docexc.cells(RV22Fila,RV84K).Text = ALLTRIM( RV86Factur )
         RV84K = RV84K + 1
         RV90Docexc.cells(RV22Fila,RV84K).Date = R2899ComFc
         RV84K = RV84K + 1
         RV90Docexc.cells(RV22Fila,RV84K).Text = ALLTRIM( R2906ComOb )
         RV84K = RV84K + 1
         RV90Docexc.cells(RV22Fila,RV84K).Text = ALLTRIM( R2907ComTr )
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R08584) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         R08584 = Gx_err
         GX_DB_GetR08584_01 ()
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08584) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL4 = .F.
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R08583) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R08583 = Gx_err
      GX_DB_GetR08583_01 ()
      IF UserCancel
