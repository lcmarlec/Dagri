      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09082" , @HStmt_W09082 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX08U7","W09082","",GX_CURSOR_TYPE_READONLY,@HStmt_W09082) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DspNroAn], [DspNroAd], [DspNroTip], [DspNroReg], [DspNroDC], [DcVNroInt], "
                  cmdbuf = cmdbuf + "  [DspDvTot], [DcvNroII] FROM [DSPVTA2] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  [DspNroAn] = ? and [DspNroAd] = ? and [DspNroTip] = ? and [DspNroReg] = ? and [DspNroDC] "
                  cmdbuf = cmdbuf + "  = ? and [DcVNroInt] = ? ORDER BY [EmpCod], [DspNroAn], [DspNroAd], [DspNroTip], "
                  cmdbuf = cmdbuf + "  [DspNroReg], [DspNroDC], [DcVNroInt], [DcvNroII]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09082,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09082,9)
                  THISFORM.GX_DB_BindColsW09082_01 ()
                  THISFORM.GX_DB_BindParmW09082_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09082,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2783DspNr = THISFORM.A2783DspNr
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09082,2,@AuxA2783DspNr,0)
               THISFORM.A2783DspNr = AuxA2783DspNr
               AuxA2784DspNr = THISFORM.A2784DspNr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09082,3,AuxA2784DspNr,3,0)
               THISFORM.A2784DspNr = AuxA2784DspNr
               AuxA2785DspNr = THISFORM.A2785DspNr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09082,4,AuxA2785DspNr,4,0)
               THISFORM.A2785DspNr = AuxA2785DspNr
               AuxA2786DspNr = THISFORM.A2786DspNr
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09082,5,@AuxA2786DspNr,0)
               THISFORM.A2786DspNr = AuxA2786DspNr
               AuxA2807DspNr = THISFORM.A2807DspNr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09082,6,AuxA2807DspNr,1,0)
               THISFORM.A2807DspNr = AuxA2807DspNr
               AuxA415DcVNro = THISFORM.A415DcVNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09082,7,@AuxA415DcVNro,0)
               THISFORM.A415DcVNro = AuxA415DcVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09082 = Gx_err
               THISFORM.GX_DB_GetW09082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09082 = Gx_err
                  THISFORM.GX_DB_GetW09082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09082 <> 101
               BRKVP82 = .F.
               THISFORM.A2791DspDv = THISFORM.Buf_W09082_2791DspDvTot
               THISFORM.A2789DcvNr = THISFORM.Buf_W09082_2789DcvNroII
               GX_SFLOAD = 0
               THISFORM.U12VP82 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09082 = Gx_err
               THISFORM.GX_DB_GetW09082_01 ()
            ENDDO
         ENDIF
