               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06362,5,@AuxAV9C1856,0)
               THISFORM.AV9C1856 = AuxAV9C1856
               AuxAV10C1857 = THISFORM.AV10C1857
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06362,6,@AuxAV10C1857,0)
               THISFORM.AV10C1857 = AuxAV10C1857
               AuxAV11C1858 = THISFORM.AV11C1858
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06362,7,@AuxAV11C1858,0)
               THISFORM.AV11C1858 = AuxAV11C1858
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06362) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06362 = Gx_err
               THISFORM.GX_DB_GetW06362_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06362 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06362) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06362 = Gx_err
                  THISFORM.GX_DB_GetW06362_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06362 <> 101
               BRKVHO2 = .F.
               THISFORM.A1856LpvRe = THISFORM.Buf_W06362_1856LpvRet1
               THISFORM.A1857LpvRe = THISFORM.Buf_W06362_1857LpvRet2
               THISFORM.A1858LpvRe = THISFORM.Buf_W06362_1858LpvRet
               THISFORM.A1855LpvFc = THISFORM.Buf_W06362_1855LpvFch
               THISFORM.A837PlVEnt = THISFORM.Buf_W06362_837PlVEntCod
               THISFORM.A836PlVGru = THISFORM.Buf_W06362_836PlVGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W06362_2EmpCod
               IF GX_CSLKE(THISFORM.A836PlVGru, TRIM(THISFORM.AV6C836)+[%])
                  IF THISFORM.A837PlVEnt >= THISFORM.AV7C837
                     IF THISFORM.A1855LpvFc >= THISFORM.AV8C1855
                        IF THISFORM.A1856LpvRe >= THISFORM.AV9C1856
                           IF THISFORM.A1857LpvRe >= THISFORM.AV10C1857
                              IF THISFORM.A1858LpvRe >= THISFORM.AV11C1858
                                 GX_SFLOAD = 0
                                 THISFORM.U12VHO2 ()
                                 THIS.GX_CUPOS = 0
                                 DO CASE
                                    CASE GX_SFLOAD = 1
                                       GX_CUERR = 0
                                       EXIT
                                    CASE GX_SFLOAD = 2
                                       GX_CUERR = 100
                                       EXIT
                                 ENDCASE
                                 IF UserCancel
                                    EXIT
                                 ENDIF
                              ENDIF
                           ENDIF
                        ENDIF
                     ENDIF
                  ENDIF
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06362) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06362 = Gx_err
               THISFORM.GX_DB_GetW06362_01 ()
            ENDDO
         ENDIF
      ENDPROC
