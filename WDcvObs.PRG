      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08142" , @HStmt_W08142 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCVOBS","W08142","",GX_CURSOR_TYPE_READONLY,@HStmt_W08142) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DcVNroInt], [DcVEntGruT], [DcVEntLgCo], [DcVEst], [DcVEntCod], [EmpCod], "
                  cmdbuf = cmdbuf + "  [DCvOrd12], [DcVSegObs2], [DcVSegObs1], [DcVTot], [DcVFch], [DcVNro], [DcVSuc], "
                  cmdbuf = cmdbuf + "  [DcVSer], [DcvTipRed] FROM [DCVENT] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  [DcVEntCod] = ? and [DcVFch] >= ?) AND ([DcVEntGruT] = ?) AND ([DcVEntLgCo] = ?) "
                  cmdbuf = cmdbuf + "  AND ([DcVEst] > 0) AND ([DcVFch] <= ?) ORDER BY [EmpCod], [DcVEntCod], [DcVFch] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08142,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08142,4)
                  THISFORM.GX_DB_BindColsW08142_01 ()
                  THISFORM.GX_DB_BindParmW08142_01 ()
               ENDIF
               AuxAV8Empcod = THISFORM.AV8Empcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08142,1,@AuxAV8Empcod,0)
               THISFORM.AV8Empcod = AuxAV8Empcod
               AuxAV10Entcod = THISFORM.AV10Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08142,2,@AuxAV10Entcod,0)
               THISFORM.AV10Entcod = AuxAV10Entcod
               AuxAV12Fch1 = THISFORM.AV12Fch1
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08142,3,@AuxAV12Fch1,0)
               THISFORM.AV12Fch1 = AuxAV12Fch1
               AuxAV9Entgrut = THISFORM.AV9Entgrut
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08142,4,AuxAV9Entgrut,2,0)
               THISFORM.AV9Entgrut = AuxAV9Entgrut
               AuxAV11Entlgc = THISFORM.AV11Entlgc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08142,5,@AuxAV11Entlgc,0)
               THISFORM.AV11Entlgc = AuxAV11Entlgc
               AuxAV13Fch2 = THISFORM.AV13Fch2
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08142,6,@AuxAV13Fch2,0)
               THISFORM.AV13Fch2 = AuxAV13Fch2
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08142 = Gx_err
               THISFORM.GX_DB_GetW08142_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV19Pgmnam = "WDcvObs"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08142 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08142) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08142 = Gx_err
                  THISFORM.GX_DB_GetW08142_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08142 <> 101
               BRKVMM2 = .F.
               THISFORM.A416DcVEnt = THISFORM.Buf_W08142_416DcVEntGruT
               THISFORM.A419DcVEnt = THISFORM.Buf_W08142_419DcVEntLgCo
               THISFORM.A466DcVEst = THISFORM.Buf_W08142_466DcVEst
               THISFORM.A417DcVEnt = THISFORM.Buf_W08142_417DcVEntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W08142_2EmpCod
               THISFORM.A2496DCvOr = THISFORM.Buf_W08142_2496DCvOrd12
               THISFORM.A1597DcVSe = Gx_lvchar_to_char( THISFORM.Buf_W08142_1597DcVSegObs2 )
               THISFORM.A1596DcVSe = THISFORM.Buf_W08142_1596DcVSegObs1
               THISFORM.A464DcVTot = THISFORM.Buf_W08142_464DcVTot
               THISFORM.A421DcVFch = THISFORM.Buf_W08142_421DcVFch
               THISFORM.A425DcVNro = THISFORM.Buf_W08142_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W08142_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W08142_423DcVSer
               THISFORM.A1208DcvTi = THISFORM.Buf_W08142_1208DcvTipRed
               IF THISFORM.A1596DcVSe <> SPACE(40) .OR. THISFORM.A1597DcVSe <> SPACE(4029)
                  GX_SFLOAD = 0
                  THISFORM.U14VMM2 ()
                  THIS.GX_CUPOS = 0
                  DO CASE
                     CASE GX_SFLOAD = 1
                        GX_CUERR = 0
                        EXIT
                     CASE GX_SFLOAD = 2
                        GX_CUERR = 100
                        EXIT
                  ENDCASE
                  IF UserCancel
                     EXIT
                  ENDIF
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08142 = Gx_err
               THISFORM.GX_DB_GetW08142_01 ()
            ENDDO
         ENDIF
      ENDPROC
