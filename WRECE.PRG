               ENDIF
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV7Emprcod
               Aux1 = THISFORM.A415DcVNro
               Aux5 = THISFORM.AV35Vernet
               DO RImpRCV WITH Aux0 , Aux1 , "SCR" , "N" , 1 , Aux5
