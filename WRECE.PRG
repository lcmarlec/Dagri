                  cmdbuf = " SELECT T1.[DcVEst], T1.[EmpCod], T1.[DcvCAEVto], T1.[DcVTip], T1.[DcVEntGruT] AS "
                  cmdbuf = cmdbuf + "  DcVEntGruT, T1.[DcVNroInt], T1.[DcVFaturo], T1.[DcVTot], T2.[EntRaz] AS DcVEntRaz, "
                  cmdbuf = cmdbuf + "  T1.[DcVEntCod] AS DcVEntCod, T1.[DcVNro], T1.[DcVSuc], T1.[DcVSer], T1.[DcvTipRed], "
                  cmdbuf = cmdbuf + "  T1.[DcVFch] FROM ([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntCod]) WHERE (T1.[EmpCod] = ? and T1.[DcVSer] = ? and T1.[DcVSuc] = ?) "
                  cmdbuf = cmdbuf + "  AND (T1.[DcVEst] > 0) AND (T1.[DcvCAEVto] = convert( DATETIME, '17530101', 112 )) "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[DcVSer], T1.[DcVSuc], T1.[DcvCAEVto], T1.[DcVNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07832,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07832,16)
                  THISFORM.GX_DB_BindColsW07832_01 ()
                  THISFORM.GX_DB_BindParmW07832_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07832,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV34Dcvser = THISFORM.AV34Dcvser
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07832,2,AuxAV34Dcvser,1,0)
               THISFORM.AV34Dcvser = AuxAV34Dcvser
               AuxAV18Dessuc = THISFORM.AV18Dessuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07832,3,@AuxAV18Dessuc,0)
               THISFORM.AV18Dessuc = AuxAV18Dessuc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07832) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07832 = Gx_err
               THISFORM.GX_DB_GetW07832_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV38Pgmnam = "WRECE"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07832 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07832) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07832 = Gx_err
                  THISFORM.GX_DB_GetW07832_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07832 <> 101
               BRKVLR2 = .F.
               THISFORM.AV11Estado = SPACE(20)
               THISFORM.A466DcVEst = THISFORM.Buf_W07832_466DcVEst
               THISFORM.A2EmpCod = THISFORM.Buf_W07832_2EmpCod
               THISFORM.A2314DcvCA = THISFORM.Buf_W07832_2314DcvCAEVto
               THISFORM.A422DcVTip = THISFORM.Buf_W07832_422DcVTip
               THISFORM.A416DcVEnt = THISFORM.Buf_W07832_416DcVEntGruT
               THISFORM.A415DcVNro = THISFORM.Buf_W07832_415DcVNroInt
               THISFORM.A444DcVFat = THISFORM.Buf_W07832_444DcVFaturo
               THISFORM.A464DcVTot = THISFORM.Buf_W07832_464DcVTot
               THISFORM.A418DcVEnt = THISFORM.Buf_W07832_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W07832_417DcVEntCod
               THISFORM.A425DcVNro = THISFORM.Buf_W07832_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W07832_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W07832_423DcVSer
               THISFORM.A1208DcvTi = THISFORM.Buf_W07832_1208DcvTipRed
               THISFORM.A421DcVFch = THISFORM.Buf_W07832_421DcVFch
               THISFORM.A418DcVEnt = THISFORM.Buf_W07832_418DcVEntRaz
               GX_SFLOAD = 0
               THISFORM.U16VLR2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07832) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07832 = Gx_err
               THISFORM.GX_DB_GetW07832_01 ()
            ENDDO
         ENDIF
      ENDPROC
