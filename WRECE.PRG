               THISFORM.AV7Emprcod = Aux0
               THISFORM.A415DcVNro = Aux1
               THISFORM.AV12Usuari = Aux2
               THISFORM.AV5Fechasi = Aux3
               THISFORM.AV13Objeto = Aux4
               THISFORM. cCW783S11 .RestoreGridPos()
               GX_rploop = .T.
            OTHERWISE
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV7Emprcod
               Aux1 = THISFORM.A415DcVNro
               Aux2 = THISFORM.AV12Usuari
               Aux3 = THISFORM.AV5Fechasi
               Aux4 = THISFORM.AV13Objeto
               DO WDVVer3 WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4
               THISFORM.AV7Emprcod = Aux0
               THISFORM.A415DcVNro = Aux1
               THISFORM.AV12Usuari = Aux2
               THISFORM.AV5Fechasi = Aux3
               THISFORM.AV13Objeto = Aux4
               THISFORM. cCW783S11 .RestoreGridPos()
               GX_rploop = .T.
         ENDCASE
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
