      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05462" , @HStmt_W05462 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAMION","W05462","",GX_CURSOR_TYPE_READONLY,@HStmt_W05462) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CamTRu], [CamSeg], [CamVTV], [CamVde], [CamHab], [CamDsc], [CamPat] "
                  cmdbuf = cmdbuf + "  FROM [CAMION] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [CamPat] >= ? ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod], [CamPat]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05462,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05462,14)
                  THISFORM.GX_DB_BindColsW05462_01 ()
                  THISFORM.GX_DB_BindParmW05462_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05462,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05462,2,AuxAV20Desde,8,0)
               THISFORM.AV20Desde = AuxAV20Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05462 = Gx_err
               THISFORM.GX_DB_GetW05462_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WCamion"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05462 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05462) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05462 = Gx_err
                  THISFORM.GX_DB_GetW05462_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05462 <> 101
               BRKVF62 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W05462_2EmpCod
               THISFORM.A1669CamTR = THISFORM.Buf_W05462_1669CamTRu
               THISFORM.A1668CamSe = THISFORM.Buf_W05462_1668CamSeg
               THISFORM.A1666CamVT = THISFORM.Buf_W05462_1666CamVTV
               THISFORM.A1670CamVd = THISFORM.Buf_W05462_1670CamVde
               THISFORM.A1667CamHa = THISFORM.Buf_W05462_1667CamHab
               THISFORM.A1665CamDs = THISFORM.Buf_W05462_1665CamDsc
               THISFORM.A1664CamPa = THISFORM.Buf_W05462_1664CamPat
               GX_SFLOAD = 0
               THISFORM.U19VF62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05462 = Gx_err
               THISFORM.GX_DB_GetW05462_01 ()
            ENDDO
         ENDIF
