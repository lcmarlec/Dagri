      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl19
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF .T. .AND. THISFORM.A222CtaGrT = 3
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A223CtaGrN
            Aux1 = THISFORM.AV20Enccta
            DO Rbsctagr WITH Aux0 , Aux1
            THISFORM.A223CtaGrN = Aux0
            THISFORM.AV20Enccta = Aux1
            THISFORM. cCT21A223 .Refresh()
         ENDIF
         IF THISFORM.AV20Enccta = 0 .AND. .T. .AND. THISFORM.A222CtaGrT = 3
            DO GX_ERRMW WITH "No existe la cuenta asociada !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF THISFORM.AV20Enccta = 2 .AND. .T. .AND. THISFORM.A222CtaGrT = 3
            DO GX_ERRMW WITH "La cuenta asociada no debe ser un título !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF .T. .AND. THISFORM.A217CtaGrN = THISFORM.A223CtaGrN
            DO GX_ERRMW WITH "La cuenta asociada debe ser distinta a la cuenta que ajusta !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_19insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_19insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_19insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_19insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT21A217 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_19insert = .F.
               THISFORM.gx_insert = THISFORM. gx_19insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
