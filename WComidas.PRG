      PROCEDURE CreateTemp
         LOCAL SCW954S17
         SCW954S17 = ""
         IF USED( "SCW954S17" )
            SELECT SCW954S17
            SCW954S17 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW954S17
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2903ComP"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2904ComP"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2899ComF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2900ComF"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2901ComF"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2902ComF"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW954S17 = GETE('z:\temp') + '\' + SCW954S17
            ENDIF
            CREATE DBF (SCW954S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCW954S17) EXCLUSIVE ALIAS SCW954S17
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW954S17
         THIS.GX_SfAlias = "SCW954S17"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09542" , @HStmt_W09542 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCOMIDAS","W09542","",GX_CURSOR_TYPE_READONLY,@HStmt_W09542) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ComFcNro], [ComFcSuc], [ComFcSer], [ComFch], [ComPerHta], [ComPerDde] "
                  cmdbuf = cmdbuf + "  FROM [COMIDA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND ([ComPerHta] >= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY [EmpCod], [ComFch], [ComFcSer], [ComFcSuc], [ComFcNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09542,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09542,13)
                  THISFORM.GX_DB_BindColsW09542_01 ()
                  THISFORM.GX_DB_BindParmW09542_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09542,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09542,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09542 = Gx_err
               THISFORM.GX_DB_GetW09542_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WComidas"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09542 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09542) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09542 = Gx_err
                  THISFORM.GX_DB_GetW09542_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09542 <> 101
               BRKVQI2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W09542_2EmpCod
               THISFORM.A2902ComFc = THISFORM.Buf_W09542_2902ComFcNro
               THISFORM.A2901ComFc = THISFORM.Buf_W09542_2901ComFcSuc
               THISFORM.A2900ComFc = THISFORM.Buf_W09542_2900ComFcSer
               THISFORM.A2899ComFc = THISFORM.Buf_W09542_2899ComFch
               THISFORM.A2904ComPe = THISFORM.Buf_W09542_2904ComPerHta
               THISFORM.A2903ComPe = THISFORM.Buf_W09542_2903ComPerDde
               GX_SFLOAD = 0
               THISFORM.U17VQI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09542 = Gx_err
               THISFORM.GX_DB_GetW09542_01 ()
            ENDDO
         ENDIF
      ENDPROC
