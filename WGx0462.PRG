      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04152" , @HStmt_W04152 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0462","W04152","",GX_CURSOR_TYPE_READONLY,@HStmt_W04152) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [RINroInt], [RiLotFch], [RiLotNro], [RICnt], [ArtCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [FamCod], [RILin] FROM [REMINT1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [RINroInt] "
                  cmdbuf = cmdbuf + "  = ? and [RILin] >= ?) AND ([FamCod] >= ?) AND ([FamSubCod] >= ?) AND ([ArtCod] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([RICnt] >= ?) ORDER BY [EmpCod], [RINroInt], [RILin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04152,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04152,9)
                  THISFORM.GX_DB_BindColsW04152_01 ()
                  THISFORM.GX_DB_BindParmW04152_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04152,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1306RINro = THISFORM.A1306RINro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04152,2,@AuxA1306RINro,0)
               THISFORM.A1306RINro = AuxA1306RINro
               AuxAV5C1316 = THISFORM.AV5C1316
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04152,3,@AuxAV5C1316,0)
               THISFORM.AV5C1316 = AuxAV5C1316
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04152,4,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04152,5,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               AuxAV8C5 = THISFORM.AV8C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04152,6,@AuxAV8C5,0)
               THISFORM.AV8C5 = AuxAV8C5
               AuxAV9C1321 = THISFORM.AV9C1321
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04152,7,@AuxAV9C1321,0)
               THISFORM.AV9C1321 = AuxAV9C1321
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04152) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04152 = Gx_err
               THISFORM.GX_DB_GetW04152_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04152 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04152) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04152 = Gx_err
                  THISFORM.GX_DB_GetW04152_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04152 <> 101
               BRKVBJ2 = .F.
               THISFORM.A1482RiLot = THISFORM.Buf_W04152_1482RiLotFch
               THISFORM.A1481RiLot = THISFORM.Buf_W04152_1481RiLotNro
               THISFORM.A1321RICnt = THISFORM.Buf_W04152_1321RICnt
               THISFORM.A5ArtCod = THISFORM.Buf_W04152_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W04152_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W04152_3FamCod
               THISFORM.A1316RILin = THISFORM.Buf_W04152_1316RILin
               GX_SFLOAD = 0
               THISFORM.U12VBJ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04152) ,  ,  ,  , CS_SQLSRV ,  )
