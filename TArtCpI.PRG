                  Gx_err = GX_DB_SetInt( HStmt_T00013,2,@AuxA3FamCod,0)
                  THISFORM.A3FamCod = AuxA3FamCod
                  AuxA4FamSubCo = THISFORM.A4FamSubCo
                  Gx_err = GX_DB_SetInt( HStmt_T00013,3,@AuxA4FamSubCo,0)
                  THISFORM.A4FamSubCo = AuxA4FamSubCo
                  AuxA5ArtCod = THISFORM.A5ArtCod
                  Gx_err = GX_DB_SetInt( HStmt_T00013,4,@AuxA5ArtCod,0)
                  THISFORM.A5ArtCod = AuxA5ArtCod
                  AuxA7ArtCprGr = THISFORM.A7ArtCprGr
                  Gx_err = GX_DB_SetStr( HStmt_T00013,5,AuxA7ArtCprGr,2,0)
                  THISFORM.A7ArtCprGr = AuxA7ArtCprGr
                  AuxA8ArtCprCo = THISFORM.A8ArtCprCo
                  Gx_err = GX_DB_SetLong( HStmt_T00013,6,@AuxA8ArtCprCo,0)
                  THISFORM.A8ArtCprCo = AuxA8ArtCprCo
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00013) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00013 = Gx_err
                  THISFORM.GX_DB_GetT00013_01 ()
                  THISFORM. cCT1A5 . ZM011 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC011 ()
               THISFORM. cCT1A5 . ZM011 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC011 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT1A11 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE011 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC011 ()
                  RETURN
               ENDIF
               THISFORM.cCT1A5.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00013) , "TARTCPI" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00012) , "TARTCPI" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00014) , "TARTCPI" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00015) , "TARTCPI" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT1A11 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT1A8 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

