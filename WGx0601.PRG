      PROCEDURE CreateTemp
         LOCAL SCW619S20
         SCW619S20 = ""
         IF USED( "SCW619S20" )
            SELECT SCW619S20
            SCW619S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW619S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA836PlVGr"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA837PlVEn"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1855LpvF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1856LpvR"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA1857LpvR"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('c:\temp')
               SCW619S20 = GETE('c:\temp') + '\' + SCW619S20
            ENDIF
            CREATE DBF (SCW619S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW619S20) EXCLUSIVE ALIAS SCW619S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW619S20
         THIS.GX_SfAlias = "SCW619S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06192" , @HStmt_W06192 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0601","W06192","",0,@HStmt_W06192) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT EmpCod, LpvRet, LpvRet2, LpvRet1, LpvFch, PlVEntCod, PlVGruTip  FROM LPVCLT "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE (EmpCod = ?) AND (( PlVGruTip LIKE ? ) AND ( PlVEntCod "
                  cmdbuf = cmdbuf + "  >= ? ) AND ( LpvFch >= ? ) AND ( LpvRet1 >= ? ) AND ( LpvRet2 >= ? ) AND ( LpvRet "
                  cmdbuf = cmdbuf + "  >= ? )) ORDER BY EmpCod, PlVGruTip, PlVEntCod, LpvFch   "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_W06192,cmdbuf) ,  ,  ,  , CS_SQLSRV ,  )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtFetchSize( HStmt_W06192,8) ,  ,  ,  , CS_SQLSRV ,  )
                  THISFORM.GX_DB_BindColsW06192_01 ( HStmt_W06192 )
                  THISFORM.GX_DB_BindParmW06192_01 ( HStmt_W06192 )
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06192,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06192,2,PADR( TRIM(THISFORM.AV20C836),2, '%'),LEN(PADR( TRIM(THISFORM.AV20C836),2, '%')),0)
               AuxAV19C837 = THISFORM.AV19C837
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06192,3,@AuxAV19C837,0)
               THISFORM.AV19C837 = AuxAV19C837
               AuxAV18C1855 = THISFORM.AV18C1855
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06192,4,@AuxAV18C1855,0)
               THISFORM.AV18C1855 = AuxAV18C1855
               AuxAV17C1856 = THISFORM.AV17C1856
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06192,5,@AuxAV17C1856,0)
               THISFORM.AV17C1856 = AuxAV17C1856
               AuxAV16C1857 = THISFORM.AV16C1857
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06192,6,@AuxAV16C1857,0)
               THISFORM.AV16C1857 = AuxAV16C1857
               AuxAV15C1858 = THISFORM.AV15C1858
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06192,7,@AuxAV15C1858,0)
               THISFORM.AV15C1858 = AuxAV15C1858
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06192 = Gx_err
               THISFORM.GX_DB_GetW06192_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06192 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06192) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06192 = Gx_err
                  THISFORM.GX_DB_GetW06192_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06192 <> 101
               BRKVH72 = .F.
               THISFORM.A1858LpvRe = THISFORM.Buf_W06192_1858LpvRet
               THISFORM.A1857LpvRe = THISFORM.Buf_W06192_1857LpvRet2
               THISFORM.A1856LpvRe = THISFORM.Buf_W06192_1856LpvRet1
               THISFORM.A1855LpvFc = THISFORM.Buf_W06192_1855LpvFch
               THISFORM.A837PlVEnt = THISFORM.Buf_W06192_837PlVEntCod
               THISFORM.A836PlVGru = THISFORM.Buf_W06192_836PlVGruTip
               IF GX_CSLKE(THISFORM.A836PlVGru, TRIM(THISFORM.AV20C836)+[%])
                  IF THISFORM.A837PlVEnt >= THISFORM.AV19C837
                     IF THISFORM.A1855LpvFc >= THISFORM.AV18C1855
                        IF THISFORM.A1856LpvRe >= THISFORM.AV17C1856
                           IF THISFORM.A1857LpvRe >= THISFORM.AV16C1857
                              IF THISFORM.A1858LpvRe >= THISFORM.AV15C1858
                                 GX_SFLOAD = 0
                                 THISFORM.U12VH72 ()
                                 THIS.GX_CUPOS = 0
                                 DO CASE
                                    CASE GX_SFLOAD = 1
                                       GX_CUERR = 0
                                       EXIT
                                    CASE GX_SFLOAD = 2
                                       GX_CUERR = 100
                                       EXIT
                                 ENDCASE
                                 IF UserCancel
                                    EXIT
                                 ENDIF
                              ENDIF
                           ENDIF
                        ENDIF
                     ENDIF
                  ENDIF
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06192 = Gx_err
               THISFORM.GX_DB_GetW06192_01 ()
            ENDDO
         ENDIF
      ENDPROC
