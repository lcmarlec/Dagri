      PROCEDURE CreateTemp
         LOCAL SCW282S20
         SCW282S20 = ""
         IF USED( "SCW282S20" )
            SELECT SCW282S20
            SCW282S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW282S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA120EntCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA176EntLg"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA150EntGr"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA967RutPr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA968RutHa"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW282S20 = GETE('z:\temp') + '\' + SCW282S20
            ENDIF
            CREATE DBF (SCW282S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW282S20) EXCLUSIVE ALIAS SCW282S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW282S20
         THIS.GX_SfAlias = "SCW282S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02822" , @HStmt_W02822 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02Y2","W02822","",GX_CURSOR_TYPE_READONLY,@HStmt_W02822) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [RutCod], [RutHab], [RutPri], [EntGruTip], [EntLgCod], [EntCod] "
                  cmdbuf = cmdbuf + "  FROM [RUTVTA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [RutCod] = ? and [EntCod] "
                  cmdbuf = cmdbuf + "  >= ? and [EntLgCod] >= ?) AND ([EntGruTip] like ?) AND ([RutPri] >= ?) AND ([RutHab] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [EmpCod], [RutCod], [EntCod], [EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02822,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02822,9)
                  THISFORM.GX_DB_BindColsW02822_01 ()
                  THISFORM.GX_DB_BindParmW02822_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02822,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA966RutCod = THISFORM.A966RutCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02822,2,@AuxA966RutCod,0)
               THISFORM.A966RutCod = AuxA966RutCod
               AuxAV5C120 = THISFORM.AV5C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02822,3,@AuxAV5C120,0)
               THISFORM.AV5C120 = AuxAV5C120
               AuxAV6C176 = THISFORM.AV6C176
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02822,4,@AuxAV6C176,0)
               THISFORM.AV6C176 = AuxAV6C176
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02822,5,PADR( TRIM(THISFORM.AV7C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV7C150),2, '%')),0)
               AuxAV8C967 = THISFORM.AV8C967
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02822,6,@AuxAV8C967,0)
               THISFORM.AV8C967 = AuxAV8C967
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02822,7,PADR( TRIM(THISFORM.AV9C968),1, '%'),LEN(PADR( TRIM(THISFORM.AV9C968),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02822 = Gx_err
               THISFORM.GX_DB_GetW02822_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02822 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02822) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02822 = Gx_err
                  THISFORM.GX_DB_GetW02822_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02822 <> 101
               BRKV7U2 = .F.
               THISFORM.A968RutHab = THISFORM.Buf_W02822_968RutHab
               THISFORM.A967RutPri = THISFORM.Buf_W02822_967RutPri
               THISFORM.A150EntGru = THISFORM.Buf_W02822_150EntGruTip
               THISFORM.A176EntLgC = THISFORM.Buf_W02822_176EntLgCod
               THISFORM.A120EntCod = THISFORM.Buf_W02822_120EntCod
               GX_SFLOAD = 0
               THISFORM.U12V7U2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02822 = Gx_err
               THISFORM.GX_DB_GetW02822_01 ()
            ENDDO
         ENDIF
      ENDPROC
