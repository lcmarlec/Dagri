         THISFORM.A401TdcImp = THISFORM.M401TdcImp
         THISFORM.A403TdcImp = THISFORM.M403TdcImp
         THISFORM.A402TdcNim = THISFORM.M402TdcNim
         THISFORM. cCT102S78 .SaveTemp()
         THISFORM. cCT102S78 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT102S78 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT102S78 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT102S78 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S401TdcImp = THISFORM.A401TdcImp .AND. S402TdcNim = THISFORM.A402TdcNim
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT102S78 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT102S78 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S401TdcImp = THISFORM.A401TdcImp .AND. S402TdcNim = THISFORM.A402TdcNim
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT102S78 .Refresh()
               THISFORM. cCT102S78 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A380TdcNro = S380TdcNro
               THISFORM.A401TdcImp = S401TdcImp
               THISFORM.A402TdcNim = S402TdcNim
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT102S78 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT102S78 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S401TdcImp = THISFORM.A401TdcImp .AND. S402TdcNim = THISFORM.A402TdcNim
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT102S78 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S401TdcImp = THISFORM.A401TdcImp .AND. S402TdcNim = THISFORM.A402TdcNim
            ENDDO
            IF sf_err != 0
               THISFORM. cCT102S78 .AppendRow()
               THISFORM. cCT102S78 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
