       FontSize = 9
       FontBold = .F.
      SpecialEffect = 0
      BackStyle = 1
      Alignment = 1
      HelpContextId = 262774
      GX_CUPOS = 0
      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.AV27Cajimp
         CGXTextBox ::Init
         THIS.GX_OldValue = THISFORM.AV27Cajimp
         THIS.GX_Level = 2
      ENDPROC
      PROCEDURE GotFocus
         CGXTextBox ::GotFocus
         THIS.GXGotFocus()
         IF THISFORM.GX_NewLastVld > - 1
            THISFORM.GX_lastvld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THIS.GX_noacc_cond = .F.
         IF THISFORM.AV24Modo <> "INS"
            THIS.GX_noacc_cond = .T.
         ENDIF
         IF THIS.GX_noacc_cond
            IF ! THIS.ValidObj()
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled( THIS.TabIndex, -1, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               THISFORM.gx_lastvld = THIS.GxObjOrder
            ENDIF
         ENDIF
         SET TOPIC TO Cajimp
         THISFORM.Gx_cursor = "THISFORM.AV27Cajimp"
         THISFORM.SetFKeys()
         IF THIS.GX_noacc_cond
            NODEFAULT
            IF LASTKEY() = 19 .or. LASTKEY() = 15
               THISFORM.SetFocusEnabled( THIS.TabIndex, -1,-1, .T., .T., .F.)
            ELSE
               THISFORM.SetFocusEnabled( THIS.TabIndex, +1,+1, .T., .T., .F.)
            ENDIF
         ENDIF
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
   ENDDEFINE
