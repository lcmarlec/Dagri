         IF USED( "SCW667S16" )
            SELECT SCW667S16
            SCW667S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW667S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1994AuxC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1995AuxN"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1998AuxD"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 50
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2005auxc"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 11
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1996AuxT"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1997AuxO"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 50
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW667S16 = GETE('z:\temp') + '\' + SCW667S16
            ENDIF
            CREATE DBF (SCW667S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW667S16) EXCLUSIVE ALIAS SCW667S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW667S16
         THIS.GX_SfAlias = "SCW667S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06672" , @HStmt_W06672 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKENTCH","W06672","",GX_CURSOR_TYPE_READONLY,@HStmt_W06672) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [AuxObs], [AuxTel], [auxcuit], [AuxDir], [AuxNom], [AuxCod] FROM "
                  cmdbuf = cmdbuf + "  [ENTRCHQ] (FASTFIRSTROW NOLOCK) ORDER BY [EmpCod], [AuxCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06672,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06672,14)
                  THISFORM.GX_DB_BindColsW06672_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06672) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06672 = Gx_err
               THISFORM.GX_DB_GetW06672_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WSkEntCh"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06672 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06672) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06672 = Gx_err
                  THISFORM.GX_DB_GetW06672_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06672 <> 101
               BRKVIJ2 = .F.
               THISFORM.A1997AuxOb = THISFORM.Buf_W06672_1997AuxObs
               THISFORM.A1996AuxTe = THISFORM.Buf_W06672_1996AuxTel
               THISFORM.A2005auxcu = THISFORM.Buf_W06672_2005auxcuit
               THISFORM.A1998AuxDi = THISFORM.Buf_W06672_1998AuxDir
               THISFORM.A1995AuxNo = THISFORM.Buf_W06672_1995AuxNom
               THISFORM.A1994AuxCo = THISFORM.Buf_W06672_1994AuxCod
               GX_SFLOAD = 0
               THISFORM.U14VIJ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06672) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06672 = Gx_err
               THISFORM.GX_DB_GetW06672_01 ()
            ENDDO
         ENDIF
      ENDPROC
