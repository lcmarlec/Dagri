      PROCEDURE CreateTemp
         LOCAL SCW507S12
         SCW507S12 = ""
         IF USED( "SCW507S12" )
            SELECT SCW507S12
            SCW507S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW507S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "VAV19Docum"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 20
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV32Dcvfc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV26Remit"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 13
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV21Difcl"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV22Difcl"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV24Difto"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "VAV23Difni"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "VAV27Dcvnr"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW507S12 = GETE('z:\temp') + '\' + SCW507S12
            ENDIF
            CREATE DBF (SCW507S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW507S12) EXCLUSIVE ALIAS SCW507S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW507S12
         THIS.GX_SfAlias = "SCW507S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV32Dcvfch = CTOD("  /  /  ")
               GX_SFLOAD = 0
               THISFORM.U17VE32 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
