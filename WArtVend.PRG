      ***********************
      PROCEDURE cCW950V56.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW950V56.ISVALID" )
         THISFORM.AV65GXLvl5 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09503" , @HStmt_W09503 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WARTVEND","W09503","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W09503) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtDsc] FROM [ARTICS] (NOLOCK) "
            cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [FamCod] = ? and [FamSubCod] = ? and [ArtCod] = ? ORDER BY "
            cmdbuf = cmdbuf + "  [EmpCod], [FamCod], [FamSubCod], [ArtCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09503,cmdbuf)
            THISFORM.GX_DB_BindColsW09503_01 ()
            THISFORM.GX_DB_BindParmW09503_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09503,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV58Desfam = THISFORM.AV58Desfam
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09503,2,@AuxAV58Desfam,0)
         THISFORM.AV58Desfam = AuxAV58Desfam
         AuxAV59Dessfa = THISFORM.AV59Dessfa
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09503,3,@AuxAV59Dessfa,0)
         THISFORM.AV59Dessfa = AuxAV59Dessfa
         AuxAV56Descod = THISFORM.AV56Descod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09503,4,@AuxAV56Descod,0)
         THISFORM.AV56Descod = AuxAV56Descod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09503) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W09503 = Gx_err
         THISFORM.GX_DB_GetW09503_01 ()
         DO WHILE THISFORM.W09503 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W09503_2EmpCod
            THISFORM.A3FamCod = THISFORM.Buf_W09503_3FamCod
            THISFORM.A4FamSubCo = THISFORM.Buf_W09503_4FamSubCod
            THISFORM.A5ArtCod = THISFORM.Buf_W09503_5ArtCod
            THISFORM.A6ArtDsc = THISFORM.Buf_W09503_6ArtDsc
            THISFORM.AV65GXLvl5 = 1
            THISFORM.AV57Desdes = THISFORM.A6ArtDsc
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W09503) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV65GXLvl5 = 0
            IF THISFORM.AV56Descod = 0
               THISFORM.AV57Desdes = "Todos "
            ELSE
               THISFORM.AV57Desdes = "Articulo Inexistente "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

