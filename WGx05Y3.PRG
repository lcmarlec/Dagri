            DO GX_SFNM WITH SCW613S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA1845EntL"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1852EntL"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW613S16 = GETE('z:\temp') + '\' + SCW613S16
            ENDIF
            CREATE DBF (SCW613S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW613S16) EXCLUSIVE ALIAS SCW613S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW613S16
         THIS.GX_SfAlias = "SCW613S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06132" , @HStmt_W06132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX05Y3","W06132","",GX_CURSOR_TYPE_READONLY,@HStmt_W06132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntLgGrpNo], [EntLgGrpOf] FROM [CLTEGRP] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EntGruTip] = ? and [EntCod] = ? and "
                  cmdbuf = cmdbuf + "  [EntLgGrpOf] >= ?) AND ([EntLgGrpNo] like ?) ORDER BY [EmpCod], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [EntLgGrpOf]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06132,9)
                  THISFORM.GX_DB_BindColsW06132_01 ()
                  THISFORM.GX_DB_BindParmW06132_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06132,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06132,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06132,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxAV5C1845 = THISFORM.AV5C1845
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06132,4,@AuxAV5C1845,0)
               THISFORM.AV5C1845 = AuxAV5C1845
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06132,5,PADR( TRIM(THISFORM.AV6C1852),20, '%'),LEN(PADR( TRIM(THISFORM.AV6C1852),20, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06132 = Gx_err
               THISFORM.GX_DB_GetW06132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06132 = Gx_err
                  THISFORM.GX_DB_GetW06132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06132 <> 101
               BRKVH12 = .F.
               THISFORM.A1852EntLg = THISFORM.Buf_W06132_1852EntLgGrpNo
               THISFORM.A1845EntLg = THISFORM.Buf_W06132_1845EntLgGrpOf
               GX_SFLOAD = 0
               THISFORM.U12VH12 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06132 = Gx_err
               THISFORM.GX_DB_GetW06132_01 ()
            ENDDO
         ENDIF
      ENDPROC
