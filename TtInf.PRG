                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02253) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02253 = Gx_err
                  THISFORM.GX_DB_GetT02253_01 ()
                  THISFORM. cCT225A2182 . ZM69253 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC69253 ()
               THISFORM. cCT225A2182 . ZM69253 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC69253 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT225A2197 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE69253 ()
                  THISFORM.SaveMode( "UPD" ,"")
