      PROCEDURE CreateTemp
         LOCAL SCW1247S28
         SCW1247S28 = ""
         IF USED( "SCW1247S28" )
            SELECT SCW1247S28
            SCW1247S28 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1247S28
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "VAV29Opafc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV30Opaen"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV31Opaen"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV32Opanr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV33Opato"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "VAV34Entma"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 100
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "VAV43Opafe"
            GX_STRUCT[ 7 ,2]= "D"
            GX_STRUCT[ 7 ,3]= 8
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "VAV25Impri"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 1
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "VAV28Opanr"
            GX_STRUCT[ 9 ,2]= "N"
            GX_STRUCT[ 9 ,3]= 12
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1247S28 = GETE('z:\temp') + '\' + SCW1247S28
            ENDIF
            CREATE DBF (SCW1247S28) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1247S28) EXCLUSIVE ALIAS SCW1247S28
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1247S28
         THIS.GX_SfAlias = "SCW1247S28"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV34Entmai = SPACE(100)
               THISFORM.AV25Imprim = 0
               GX_SFLOAD = 0
               THISFORM.U18VYN2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
