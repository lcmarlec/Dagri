      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S415DcVNro
         LOCAL S445DcVLIn
         S2EmpCod = THISFORM.A2EmpCod
         S415DcVNro = THISFORM.A415DcVNro
         S445DcVLIn = THISFORM.A445DcVLIn
         THISFORM.A445DcVLIn = THISFORM.M445DcVLIn
         THISFORM. cCT41S176 .SaveTemp()
         THISFORM. cCT41S176 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT41S176 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT41S176 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT41S176 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S445DcVLIn = THISFORM.A445DcVLIn
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT41S176 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT41S176 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S445DcVLIn = THISFORM.A445DcVLIn
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT41S176 .Refresh()
               THISFORM. cCT41S176 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A415DcVNro = S415DcVNro
               THISFORM.A445DcVLIn = S445DcVLIn
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT41S176 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT41S176 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S445DcVLIn = THISFORM.A445DcVLIn
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT41S176 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S445DcVLIn = THISFORM.A445DcVLIn
            ENDDO
            IF sf_err != 0
               THISFORM. cCT41S176 .AppendRow()
               THISFORM. cCT41S176 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A415DcVNro = S415DcVNro
               THISFORM.A445DcVLIn = S445DcVLIn
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A415DcVNro = S415DcVNro
         THISFORM.A445DcVLIn = S445DcVLIn
         RETURN .F.
      ENDFUNC
