      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T004125" , @HStmt_T004125 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCVENT","T004125","",GX_CURSOR_TYPE_READONLY,@HStmt_T004125) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [DcVNroInt], [DcVLIn], [FamCod], [FamSubCod], [ArtCod], [DcVCnt], "
                  cmdbuf = cmdbuf + "  [DcVPrc], [DcvPrcOri], [DcVPrcReal], [DcVOfe], [DcVOfeNro], [DcVLugCod], [DcVLugDsc], "
                  cmdbuf = cmdbuf + "  [DcVLotNro], [DcVLobs], [DcVRvtNi], [DcVPedFch], [DcVPedNro], [DcvArtInd], [DcvArtfx] "
                  cmdbuf = cmdbuf + "  FROM [DCVENT1] (NOLOCK) WHERE [EmpCod] = ? AND [DcVNroInt] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [DcVNroInt], [DcVLIn]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T004125,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T004125,9)
                  THISFORM.GX_DB_BindColsT004125_01 ()
                  THISFORM.GX_DB_BindParmT004125_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T004125,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA415DcVNro = THISFORM.A415DcVNro
               Gx_err = GX_DB_SetDouble( HStmt_T004125,2,@AuxA415DcVNro,0)
               THISFORM.A415DcVNro = AuxA415DcVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T004125) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T004125 = Gx_err
               THISFORM.GX_DB_GetT004125_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T004125 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T004125) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T004125 = Gx_err
                  THISFORM.GX_DB_GetT004125_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T004125 <> 101
               BRK1543 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT41S176.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T004125) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T004125 = Gx_err
               THISFORM.GX_DB_GetT004125_01 ()
            ENDDO
         ENDIF
