         THISFORM.A457DcVImp = THISFORM.M457DcVImp
         THISFORM.A458DcVNim = THISFORM.M458DcVNim
         THISFORM. cCT41S199 .SaveTemp()
         THISFORM. cCT41S199 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT41S199 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT41S199 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT41S199 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S456DcVImp = THISFORM.A456DcVImp .AND. S458DcVNim = THISFORM.A458DcVNim
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT41S199 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT41S199 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S456DcVImp = THISFORM.A456DcVImp .AND. S458DcVNim = THISFORM.A458DcVNim
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT41S199 .Refresh()
               THISFORM. cCT41S199 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A415DcVNro = S415DcVNro
               THISFORM.A456DcVImp = S456DcVImp
               THISFORM.A458DcVNim = S458DcVNim
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT41S199 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT41S199 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S456DcVImp = THISFORM.A456DcVImp .AND. S458DcVNim = THISFORM.A458DcVNim
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT41S199 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S456DcVImp = THISFORM.A456DcVImp .AND. S458DcVNim = THISFORM.A458DcVNim
            ENDDO
            IF sf_err != 0
               THISFORM. cCT41S199 .AppendRow()
               THISFORM. cCT41S199 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A415DcVNro = S415DcVNro
               THISFORM.A456DcVImp = S456DcVImp
               THISFORM.A458DcVNim = S458DcVNim
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A415DcVNro = S415DcVNro
