         THISFORM.A1188dcVch = THISFORM.M1188dcVch
         THISFORM. cCT41S209 .SaveTemp()
         THISFORM. cCT41S209 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT41S209 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT41S209 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT41S209 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S1188dcVch = THISFORM.A1188dcVch
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT41S209 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT41S209 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S1188dcVch = THISFORM.A1188dcVch
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT41S209 .Refresh()
               THISFORM. cCT41S209 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A415DcVNro = S415DcVNro
               THISFORM.A1188dcVch = S1188dcVch
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT41S209 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT41S209 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S1188dcVch = THISFORM.A1188dcVch
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT41S209 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S415DcVNro = THISFORM.A415DcVNro .AND. S1188dcVch = THISFORM.A1188dcVch
            ENDDO
            IF sf_err != 0
               THISFORM. cCT41S209 .AppendRow()
               THISFORM. cCT41S209 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A415DcVNro = S415DcVNro
               THISFORM.A1188dcVch = S1188dcVch
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A415DcVNro = S415DcVNro
         THISFORM.A1188dcVch = S1188dcVch
         RETURN .F.
      ENDFUNC
