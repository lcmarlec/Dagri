      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S415DcVNro
         LOCAL S456DcVImp
         LOCAL S458DcVNim
         S2EmpCod = THISFORM.A2EmpCod
         S415DcVNro = THISFORM.A415DcVNro
         S456DcVImp = THISFORM.A456DcVImp
         S458DcVNim = THISFORM.A458DcVNim
