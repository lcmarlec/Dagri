            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03352 = 101 .OR. THISFORM.Z3206CIFch <> THISFORM.Buf_T03352_3206CIFch
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1664CamPa <> THISFORM.Buf_T03352_1664CamPat
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z3212CIUsu <> THISFORM.Buf_T03352_3212CIUsu
               DO GX_ERRMW WITH "CIMOV fue modificada."
               RETURN .F.
            ENDIF
