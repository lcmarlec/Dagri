               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03352) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03352 = Gx_err
            THISFORM.GX_DB_GetT03352_01 ()
            IF .NOT. THISFORM.T03352 <> 103
               DO GX_ERRMW WITH "CIMOV reservado por otro"
