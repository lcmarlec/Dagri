      PROCEDURE cCT335B2.GotFocus
         THISFORM.gx_over_OK = .F.
         IF ! MDOWN() .and. (THISFORM.gx_frmReadkey = 9 .or. THISFORM.gx_frmReadkey = 13)
            gx_val_ret = THISFORM.validobj2( THISFORM.GX_lastvld, THIS.GxObjOrder , THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .F., .F., .F.)
               RETURN
            ELSE
               NODEFAULT
               IF gx_val_ret = -2
                  RETURN
               ENDIF
               IF THISFORM.GX_Curr_Level = 367
                  THISFORM.GX_lastvld = 0
               ENDIF
               IF THISFORM.gx_manual_setfocus
                  THISFORM.gx_manual_setfocus = .F.
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 367
                     THISFORM.SetFocusEnabled( THISFORM. cCT335A2 .TabIndex, 0, +1, .F., .T., .F. )
                  OTHERWISE
                     RETURN
               ENDCASE
            ENDIF
         ENDIF
