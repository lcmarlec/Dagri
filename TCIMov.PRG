                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03353) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03353 = Gx_err
                  THISFORM.GX_DB_GetT03353_01 ()
                  THISFORM. cCT335A3205 . ZM9B367 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC9B367 ()
               THISFORM. cCT335A3205 . ZM9B367 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC9B367 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT335A3222 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE9B367 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC9B367 ()
                  RETURN
               ENDIF
               THISFORM.cCT335A3205.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03353) , "TCIMOV" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03352) , "TCIMOV" )
