      Gx_err = GX_DB_SetDate( HStmt_R08514,1,@RV28Vuelve,0)
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R08514) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R08514 = Gx_err
      GX_DB_GetR08514_01 ()
      DO WHILE R08514 <> 101
         R2824FerFc = Buf_R08514_2824FerFch
         RV42GXLvl8 = 1
         RV28Vuelve = RV28Vuelve + 1
         * Check if program is canceled.
         IF gxPrnObj.GxIsAliveDoc( GxHDC ) = 0
            UserCancel = .T.
         ENDIF
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         * Exiting from a For First loop.
         EXIT
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08514) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL4 = .F.
      IF RV42GXLvl8 = 0
         RV30Ok = 1
      ENDIF
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
RETURN

***********************
PROCEDURE HNN0
***********************

   PARAMETERS Gx_out, P_lines, Gx_line, Gx_inc, GX_footer, GX_inc_test

   Gx_line = Gx_line + Gx_inc
   IF Gx_line + GX_inc_test > P_lines
      IF Gx_page > 0
         Gx_line = P_lines
         IF Gx_dvc = "PRN" .and. Gx_pg_started
            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
         GXPrn_Flag = GXAuxPrn_Flag
         Gx_pg_started = .T.
      ENDIF
   ENDIF
RETURN
