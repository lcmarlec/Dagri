               THISFORM.AV9C861 = AuxAV9C861
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02732,6,PADR( TRIM(THISFORM.AV10C862),2, '%'),LEN(PADR( TRIM(THISFORM.AV10C862),2, '%')),0)
               AuxAV11C863 = THISFORM.AV11C863
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02732,7,@AuxAV11C863,0)
               THISFORM.AV11C863 = AuxAV11C863
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02732 = Gx_err
               THISFORM.GX_DB_GetW02732_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02732 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02732) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02732 = Gx_err
                  THISFORM.GX_DB_GetW02732_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02732 <> 101
               BRKV7L2 = .F.
               THISFORM.A861RCVEst = THISFORM.Buf_W02732_861RCVEst
               THISFORM.A862RCVEnt = THISFORM.Buf_W02732_862RCVEntGruT
               THISFORM.A863RCVEnt = THISFORM.Buf_W02732_863RCVEntCod
               THISFORM.A860RCVFch = THISFORM.Buf_W02732_860RCVFchCon
               THISFORM.A859RCVFch = THISFORM.Buf_W02732_859RCVFch
               THISFORM.A858RCVNro = THISFORM.Buf_W02732_858RCVNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W02732_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V7L2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02732 = Gx_err
               THISFORM.GX_DB_GetW02732_01 ()
            ENDDO
         ENDIF
      ENDPROC
