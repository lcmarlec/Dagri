         * Search in Sub-File
         SELECT (THISFORM. cCT98S18 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT98S18 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT98S18 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S963RGNPer = THISFORM.A963RGNPer .AND. S1582RGNAc = THISFORM.A1582RGNAc
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT98S18 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT98S18 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S963RGNPer = THISFORM.A963RGNPer .AND. S1582RGNAc = THISFORM.A1582RGNAc
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
