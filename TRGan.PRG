               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00987) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00987 = Gx_err
               THISFORM.GX_DB_GetT00987_01 ()
               Gx_fcond = THISFORM.T00987 <> 101
            CASE GXOP = 2 && Next record
               M150EntGru = THISFORM.A150EntGru
