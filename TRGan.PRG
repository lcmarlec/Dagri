               ENDDO
               THISFORM.T00987 = Gx_err
               THISFORM.GX_DB_GetT00987_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2EmpCod = THISFORM.Buf_T00987_2EmpCod
               THISFORM.A150EntGru = THISFORM.Buf_T00987_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_T00987_120EntCod
