               DO WHILE THISFORM.T00987 = 0 .AND. THISFORM.A2EmpCod >= THISFORM.Buf_T00987_2EmpCod .AND. THISFORM.A150EntGru >= THISFORM.Buf_T00987_150EntGruTip .AND. THISFORM.A120EntCod >= THISFORM.Buf_T00987_120EntCod .AND. THISFORM.A963RGNPer >= THISFORM.Buf_T00987_963RGNPer
