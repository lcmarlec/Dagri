            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT98S18 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT98S18 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S963RGNPer = THISFORM.A963RGNPer .AND. S1582RGNAc = THISFORM.A1582RGNAc
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT98S18 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S963RGNPer = THISFORM.A963RGNPer .AND. S1582RGNAc = THISFORM.A1582RGNAc
            ENDDO
            IF sf_err != 0
               THISFORM. cCT98S18 .AppendRow()
               THISFORM. cCT98S18 .GX_all_loaded = .T.
            ENDIF
