      PROCEDURE CreateTemp
         LOCAL SCT98S18
         SCT98S18 = ""
         IF USED( "SCT98S18" )
            SELECT SCT98S18
            SCT98S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT98S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1582RGNA"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA964RGNAc"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 10
            GX_STRUCT[ 2 ,4]= 2

            GX_STRUCT[ 3 ,1]= "sA965RGNPa"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT98S18 = GETE('z:\temp') + '\' + SCT98S18
            ENDIF
            CREATE DBF (SCT98S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCT98S18) EXCLUSIVE ALIAS SCT98S18
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT98S18
         THIS.GX_SfAlias = "SCT98S18"
      ENDPROC
