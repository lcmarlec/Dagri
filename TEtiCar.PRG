               THISFORM.A2970EtALi = S2970EtALi
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT310S14 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT310S14 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2969EtAFc = THISFORM.A2969EtAFc .AND. S2867LiPrC = THISFORM.A2867LiPrC .AND. S2970EtALi = THISFORM.A2970EtALi
