      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T031015" , @HStmt_T031015 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TETICAR","T031015","",GX_CURSOR_TYPE_READONLY,@HStmt_T031015) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EtAFch], [LiPrCod], [EtALin], [EtaElab], [EtAVenc], [EtADoc], [EtAUsu], "
                  cmdbuf = cmdbuf + "  [EtAFH], [FamCod], [FamSubCod], [ArtCod], [EtALote], [EtACnt] FROM [ETIART1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [EtAFch] = ? AND [LiPrCod] = ? ORDER BY [EmpCod], [EtAFch], "
                  cmdbuf = cmdbuf + "  [LiPrCod], [EtALin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T031015,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T031015,13)
                  THISFORM.GX_DB_BindColsT031015_01 ()
                  THISFORM.GX_DB_BindParmT031015_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T031015,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2969EtAFc = THISFORM.A2969EtAFc
               Gx_err = GX_DB_SetDate( HStmt_T031015,2,@AuxA2969EtAFc,0)
               THISFORM.A2969EtAFc = AuxA2969EtAFc
               AuxA2867LiPrC = THISFORM.A2867LiPrC
               Gx_err = GX_DB_SetStr( HStmt_T031015,3,AuxA2867LiPrC,4,0)
               THISFORM.A2867LiPrC = AuxA2867LiPrC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T031015) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031015 = Gx_err
               THISFORM.GX_DB_GetT031015_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T031015 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031015) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T031015 = Gx_err
                  THISFORM.GX_DB_GetT031015_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T031015 <> 101
               BRK8M342 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT310S14.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T031015_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031015) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031015 = Gx_err
               THISFORM.GX_DB_GetT031015_01 ()
            ENDDO
         ENDIF
      ENDPROC
