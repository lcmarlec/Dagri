         * Search in Sub-File
         SELECT (THISFORM. cCT310S14 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT310S14 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT310S14 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2969EtAFc = THISFORM.A2969EtAFc .AND. S2867LiPrC = THISFORM.A2867LiPrC .AND. S2970EtALi = THISFORM.A2970EtALi
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT310S14 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT310S14 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2969EtAFc = THISFORM.A2969EtAFc .AND. S2867LiPrC = THISFORM.A2867LiPrC .AND. S2970EtALi = THISFORM.A2970EtALi
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT310S14 .Refresh()
               THISFORM. cCT310S14 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A2969EtAFc = S2969EtAFc
