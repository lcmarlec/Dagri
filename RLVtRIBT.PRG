            RV44Cuit11 = str( R166EntCui , 11 )
            Gxlinea = str( RV42Pcidgi , 3 )
            Gxlinea = Gxlinea + substr( RV44Cuit11 , 1 , 2 ) + "-" + substr( RV44Cuit11 , 3 , 8 ) + "-" + substr( RV44Cuit11 , 11 , 1 )
            Gxlinea = Gxlinea + substr( GXDTOC( R938RetFch ) , 1 , 6 ) + str( year( R938RetFch ) , 4 )
            Gxlinea = Gxlinea + "0000"
