         LOCAL SCW91S20
         SCW91S20 = ""
         IF USED( "SCW91S20" )
            SELECT SCW91S20
            SCW91S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW91S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA193Monco"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA194MonDs"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA195MonSi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW91S20 = GETE('z:\temp') + '\' + SCW91S20
            ENDIF
            CREATE DBF (SCW91S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW91S20) EXCLUSIVE ALIAS SCW91S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW91S20
         THIS.GX_SfAlias = "SCW91S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00912" , @HStmt_W00912 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WMONEDA","W00912","",GX_CURSOR_TYPE_READONLY,@HStmt_W00912) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [MonSim], [MonDsc], [Moncod] FROM [MONEDA] (FASTFIRSTROW NOLOCK) WHERE [MonDsc] "
                  cmdbuf = cmdbuf + "  like ? ORDER BY [Moncod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00912,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00912,13)
                  THISFORM.GX_DB_BindColsW00912_01 ()
                  THISFORM.GX_DB_BindParmW00912_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00912,1,PADR( TRIM(THISFORM.AV20Desde),20, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),20, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00912 = Gx_err
               THISFORM.GX_DB_GetW00912_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WMoneda"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00912 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00912) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00912 = Gx_err
                  THISFORM.GX_DB_GetW00912_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00912 <> 101
               BRKV2J2 = .F.
               THISFORM.A195MonSim = THISFORM.Buf_W00912_195MonSim
               THISFORM.A194MonDsc = THISFORM.Buf_W00912_194MonDsc
               THISFORM.A193Moncod = THISFORM.Buf_W00912_193Moncod
               GX_SFLOAD = 0
               THISFORM.U18V2J2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00912 = Gx_err
               THISFORM.GX_DB_GetW00912_01 ()
            ENDDO
         ENDIF
      ENDPROC
