      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03912" , @HStmt_W03912 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDEPANU1","W03912","",GX_CURSOR_TYPE_READONLY,@HStmt_W03912) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[TesLin], T1.[EmpCod], T1.[TesNroI], T1.[TesSerDoc], T1.[TesTipDoc], T1.[TesImp], "
                  cmdbuf = cmdbuf + "  T1.[TesFchDeb], T1.[TesNro], T1.[TesBcoCta], T2.[BcoDsc] AS TesBcoDsc, T1.[TesBcoCod] "
                  cmdbuf = cmdbuf + "  AS TesBcoCod, T3.[MCoDsc] AS TesMedDsc, T1.[TesMedCod] AS TesMedCod FROM (([TESCYP] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[TesBcoCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [MEDCOB] T3 (NOLOCK) ON T3.[MCoCod] = T1.[TesMedCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[TesNroI] = ?) AND (T1.[TesSerDoc] = ?) ORDER BY T1.[EmpCod], T1.[TesNroI] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03912,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03912,12)
                  THISFORM.GX_DB_BindColsW03912_01 ()
                  THISFORM.GX_DB_BindParmW03912_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03912,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA985TesNro = THISFORM.A985TesNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03912,2,@AuxA985TesNro,0)
               THISFORM.A985TesNro = AuxA985TesNro
               AuxA999TesSer = THISFORM.A999TesSer
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03912,3,AuxA999TesSer,1,0)
               THISFORM.A999TesSer = AuxA999TesSer
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03912 = Gx_err
               THISFORM.GX_DB_GetW03912_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV35Pgmnam = "WDepAnu1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03912 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03912) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03912 = Gx_err
                  THISFORM.GX_DB_GetW03912_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03912 <> 101
               BRKVAV2 = .F.
               THISFORM.A998TesTip = THISFORM.Buf_W03912_998TesTipDoc
               THISFORM.A996TesImp = THISFORM.Buf_W03912_996TesImp
               THISFORM.A997TesFch = THISFORM.Buf_W03912_997TesFchDeb
               THISFORM.A994TesNro = THISFORM.Buf_W03912_994TesNro
               THISFORM.A993TesBco = THISFORM.Buf_W03912_993TesBcoCta
               THISFORM.A992TesBco = THISFORM.Buf_W03912_992TesBcoDsc
               THISFORM.A991TesBco = THISFORM.Buf_W03912_991TesBcoCod
               THISFORM.A990TesMed = THISFORM.Buf_W03912_990TesMedDsc
               THISFORM.A989TesMed = THISFORM.Buf_W03912_989TesMedCod
               THISFORM.A992TesBco = THISFORM.Buf_W03912_992TesBcoDsc
               THISFORM.A990TesMed = THISFORM.Buf_W03912_990TesMedDsc
               GX_SFLOAD = 0
               THISFORM.U15VAV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03912 = Gx_err
               THISFORM.GX_DB_GetW03912_01 ()
            ENDDO
         ENDIF
      ENDPROC
