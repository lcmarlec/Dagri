                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WAUSENMO","W07742","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W07742) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[AusFch], T1.[CAuCod], T1.[TraCod], T1.[EmpCod], T1.[AusObC], T1.[AusOb1], "
                  cmdbuf = cmdbuf + "  T1.[AusObs], T3.[CauObs], T1.[AMApe], T1.[AMClin], T1.[AMEsp], T1.[AMMatE], T1.[AMMatN], "
                  cmdbuf = cmdbuf + "  T1.[AMMatP], T1.[AMNom], T1.[AusAbo], T1.[AMApoc], T1.[AusBorrar], T1.[AusSin], "
                  cmdbuf = cmdbuf + "  T3.[CauDiasART], T1.[AusAlMod], T1.[Austem], T1.[AusVal], T1.[AusCnt], T3.[CAuDsc], "
                  cmdbuf = cmdbuf + "  T2.[TraNom] FROM (([AUSENTIS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EMPLEADO] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TraCod] = T1.[TraCod]) LEFT JOIN [CAUSENTI] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[CAuCod] = T1.[CAuCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[TraCod] = ? and T1.[CAuCod] = ? and T1.[AusFch] = ? ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[TraCod], T1.[CAuCod], T1.[AusFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07742,cmdbuf)
