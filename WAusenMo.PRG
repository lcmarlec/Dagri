               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07742,3,AuxAV10Caucod,4,0)
               THISFORM.AV10Caucod = AuxAV10Caucod
               AuxAV9Ausfch = THISFORM.AV9Ausfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07742,4,@AuxAV9Ausfch,0)
               THISFORM.AV9Ausfch = AuxAV9Ausfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07742 = Gx_err
               THISFORM.GX_DB_GetW07742_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV59Pgmnam = "WAusenMo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07742 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07742) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07742 = Gx_err
                  THISFORM.GX_DB_GetW07742_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07742 <> 101
               BRKVLI2 = .F.
               THISFORM.AV25Docume = SPACE(100)
               THISFORM.AV29Ver = 0
               THISFORM.A2272AusFc = THISFORM.Buf_W07742_2272AusFch
