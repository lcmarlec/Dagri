      ***********************
      PROCEDURE U13VMQ2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'ENTER'" )
         * 'Enter' Routine
         IF THISFORM.AV36Sldtip = ""
            THISFORM.Refresh()
            DO GX_ERRMW WITH "Debe Seleccionar el tipo de Envio"
         ELSE
            IF THISFORM.AV38Aniova = 0 .AND. THISFORM.AV36Sldtip = "V"
               THISFORM.Refresh()
               DO GX_ERRMW WITH "Ingrese a que Periodo de Vacaciones Corresponde"
            ELSE
               THISFORM.AV25Sldepe = THISFORM.AV30Anio * 100 + THISFORM.AV31Mes
               THISFORM.AV29Sldsec = 1
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08183" , @HStmt_W08183 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSLDNVO","W08183","",GX_CURSOR_TYPE_READONLY,@HStmt_W08183) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [BcoCta], [SldEPer], [SldSec] FROM [SLDENVIO] (NOLOCK) WHERE [EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [BcoCta] = ? and [SldEPer] = ? ORDER BY [EmpCod], [BcoCta], [SldEPer], [SldSec] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08183,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08183,100)
                  THISFORM.GX_DB_BindColsW08183_01 ()
                  THISFORM.GX_DB_BindParmW08183_01 ()
               ENDIF
               AuxAV11Emprco = THISFORM.AV11Emprco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08183,1,@AuxAV11Emprco,0)
               THISFORM.AV11Emprco = AuxAV11Emprco
               AuxAV23Bcocta = THISFORM.AV23Bcocta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08183,2,@AuxAV23Bcocta,0)
               THISFORM.AV23Bcocta = AuxAV23Bcocta
               AuxAV25Sldepe = THISFORM.AV25Sldepe
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08183,3,@AuxAV25Sldepe,0)
               THISFORM.AV25Sldepe = AuxAV25Sldepe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08183) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08183 = Gx_err
               THISFORM.GX_DB_GetW08183_01 ()
               DO WHILE THISFORM.W08183 <> 101
                  THISFORM.A2EmpCod = THISFORM.Buf_W08183_2EmpCod
                  THISFORM.A76BcoCta = THISFORM.Buf_W08183_76BcoCta
                  THISFORM.A2543SldEP = THISFORM.Buf_W08183_2543SldEPer
                  THISFORM.A2544SldSe = THISFORM.Buf_W08183_2544SldSec
                  THISFORM.AV29Sldsec = THISFORM.A2544SldSe + 1
                  * Check if program is canceled.
                  DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
                  IF UserCancel
                     EXIT
                  ENDIF
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08183) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08183 = Gx_err
                  THISFORM.GX_DB_GetW08183_01 ()
               ENDDO
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W08183) ,  ,  ,  , CS_SQLSRV ,  )
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV11Emprco
               Aux1 = THISFORM.AV23Bcocta
               Aux2 = THISFORM.AV25Sldepe
               Aux3 = THISFORM.AV29Sldsec
               Aux4 = THISFORM.AV26Sldobs
               Aux5 = THISFORM.AV27Archiv
               Aux6 = THISFORM.AV36Sldtip
               Aux7 = THISFORM.AV38Aniova
               Aux8 = THISFORM.AV19Usuari
               Aux9 = THISFORM.AV33Ok
               DO PSldNvo WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7 , Aux8 , Aux9
               THISFORM.AV11Emprco = Aux0
               THISFORM.AV23Bcocta = Aux1
               THISFORM.AV25Sldepe = Aux2
               THISFORM.AV29Sldsec = Aux3
               THISFORM.AV26Sldobs = Aux4
               THISFORM.AV27Archiv = Aux5
               THISFORM.AV36Sldtip = Aux6
               THISFORM.AV38Aniova = Aux7
               THISFORM.AV19Usuari = Aux8
               THISFORM.AV33Ok = Aux9
               GX_rploop = .T.
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

