                  cmdbuf = " SELECT T1.[RetCoV], T1.[RetEntGruT] AS RetEntGruT, T1.[EmpCod], T1.[RetNroI], T1.[RetSer], "
                  cmdbuf = cmdbuf + "  T1.[RetEst], T1.[RetTot], T1.[RetFch], T2.[EntRaz] AS RetEntRaz, T1.[RetEntCod] "
                  cmdbuf = cmdbuf + "  AS RetEntCod, T1.[RetNro], T1.[RetTip] FROM ([RETEN] T1 (FASTFIRSTROW NOLOCK) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[RetEntGruT] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[RetEntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[RetNro] >= ?) "
                  cmdbuf = cmdbuf + "  AND (T1.[RetEntCod] = ? or ? = 0) AND (T1.[RetTip] = ? or ? = 'ALL') AND (T1.[RetEntGruT] "
                  cmdbuf = cmdbuf + "  = 'CL') AND (T1.[RetCoV] = 'V') AND (T1.[RetFch] >= ?) ORDER BY T1.[EmpCod], T1.[RetNroI] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04793,cmdbuf)
