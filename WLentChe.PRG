      PROCEDURE NextInStructure
         LPARAMETER gx_FLvl
         DO CASE
            CASE gx_FLvl = 2
               gx_FLvlO = 1
            CASE gx_FLvl = 4
               gx_FLvlO = 3
            CASE gx_FLvl = 3
