            cmdbuf = cmdbuf + "  [EmpCod] = ? and [PenMotCod] = ? ORDER BY [EmpCod], [PenMotCod], [PenPCtaCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03852,cmdbuf)
