         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03852,2,@AuxAV23Motcod,0)
         THISFORM.AV23Motcod = AuxAV23Motcod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03852) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W03852 = Gx_err
         THISFORM.GX_DB_GetW03852_01 ()
         DO WHILE THISFORM.W03852 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W03852_2EmpCod
            THISFORM.A1078PenMo = THISFORM.Buf_W03852_1078PenMotCod
            THISFORM.A1079PenMo = THISFORM.Buf_W03852_1079PenMotDsc
            THISFORM.AV34GXLvl1 = 1
            THISFORM.AV24Motdsc = THISFORM.A1079PenMo
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03852) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W03852 = Gx_err
            THISFORM.GX_DB_GetW03852_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W03852) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV34GXLvl1 = 0
            THISFORM.AV24Motdsc = "Todos "
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
