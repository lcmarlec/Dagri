            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T. .AND. THISFORM.Gx_mode = "INS"
            THISFORM.A2139RemEs = 1
         ENDIF
         IF .T.
            THISFORM.AV14Numero = str( THISFORM.A2130RemNI , 8 )
         ENDIF
         IF THISFORM.Gx_mode = 'INS' .AND. .T.
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A2EmpCod
            Aux2 = THISFORM.A2133RemSu
            Aux3 = THISFORM.A2134RemNr
            DO PSkNro WITH Aux0 , "RT" , Aux2 , Aux3 , 1
            THISFORM.A2EmpCod = Aux0
            THISFORM.A2133RemSu = Aux2
            THISFORM.A2134RemNr = Aux3
            THISFORM. cCT221A2 .Refresh()
            THISFORM. cCT221A2133 .Refresh()
            THISFORM. cCT221A2134 .Refresh()
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV14Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV12Audobs
            Aux6 = THISFORM.AV10Usuari
            DO PAuditor WITH "VTAS" , Aux1 , "REMMBT" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV14Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV12Audobs = Aux5
            THISFORM.AV10Usuari = Aux6
            THISFORM. cCT221V10 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 237 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.U14652 ()
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
