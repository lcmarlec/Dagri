      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01632" , @HStmt_W01632 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WUSU001","W01632","",GX_CURSOR_TYPE_READONLY,@HStmt_W01632) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [UsuNombre], [UsuCod] FROM [USU002] (FASTFIRSTROW NOLOCK) WHERE [UsuNombre] "
                  cmdbuf = cmdbuf + "  like ? ORDER BY [UsuCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01632,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01632,12)
                  THISFORM.GX_DB_BindColsW01632_01 ()
                  THISFORM.GX_DB_BindParmW01632_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01632,1,PADR( TRIM(THISFORM.AV6Usunom),30, '%'),LEN(PADR( TRIM(THISFORM.AV6Usunom),30, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01632) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01632 = Gx_err
               THISFORM.GX_DB_GetW01632_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV21Pgmnam = "WUsu001"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01632 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01632) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01632 = Gx_err
                  THISFORM.GX_DB_GetW01632_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01632 <> 101
               BRKV4J2 = .F.
               THISFORM.A65UsuNomb = THISFORM.Buf_W01632_65UsuNombre
               THISFORM.A64UsuCod = THISFORM.Buf_W01632_64UsuCod
               GX_SFLOAD = 0
               THISFORM.U19V4J2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01632) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01632 = Gx_err
               THISFORM.GX_DB_GetW01632_01 ()
            ENDDO
         ENDIF
      ENDPROC
