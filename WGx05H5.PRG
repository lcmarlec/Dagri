               AuxA1346AsiNr = THISFORM.A1346AsiNr
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06622,4,@AuxA1346AsiNr,0)
               THISFORM.A1346AsiNr = AuxA1346AsiNr
               AuxA1353AsiIt = THISFORM.A1353AsiIt
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06622,5,@AuxA1353AsiIt,0)
               THISFORM.A1353AsiIt = AuxA1353AsiIt
               AuxAV5C1388 = THISFORM.AV5C1388
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06622,6,@AuxAV5C1388,0)
               THISFORM.AV5C1388 = AuxAV5C1388
               AuxAV6C1715 = THISFORM.AV6C1715
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06622,7,@AuxAV6C1715,0)
               THISFORM.AV6C1715 = AuxAV6C1715
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06622 = Gx_err
               THISFORM.GX_DB_GetW06622_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06622 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06622) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06622 = Gx_err
                  THISFORM.GX_DB_GetW06622_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06622 <> 101
               BRKVIE2 = .F.
               THISFORM.A1715AsiGe = THISFORM.Buf_W06622_1715AsiGesLin
               THISFORM.A1388AsiGe = THISFORM.Buf_W06622_1388AsiGesNI
