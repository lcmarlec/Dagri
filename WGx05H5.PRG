         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06622" , @HStmt_W06622 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX05H5","W06622","",GX_CURSOR_TYPE_READONLY,@HStmt_W06622) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EjeNro], [AsiCod], [AsiNroInt], [AsiItNro], [AsiGesLin], [AsiGesNI] "
                  cmdbuf = cmdbuf + "  FROM [ASIEN2] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [EjeNro] = ? and [AsiCod] "
                  cmdbuf = cmdbuf + "  = ? and [AsiNroInt] = ? and [AsiItNro] = ? and [AsiGesNI] >= ? and [AsiGesLin] >= "
                  cmdbuf = cmdbuf + "  ? ORDER BY [EmpCod], [EjeNro], [AsiCod], [AsiNroInt], [AsiItNro], [AsiGesNI], [AsiGesLin] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06622,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06622,9)
                  THISFORM.GX_DB_BindColsW06622_01 ()
                  THISFORM.GX_DB_BindParmW06622_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06622,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
