               THISFORM.W11142 = Gx_err
               THISFORM.GX_DB_GetW11142_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV37Pgmnam = "WEDAfip"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11142 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11142) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11142 = Gx_err
                  THISFORM.GX_DB_GetW11142_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11142 <> 101
               BRKVUY2 = .F.
               THISFORM.A3299CAYa = THISFORM.Buf_W11142_3299CAYa
               THISFORM.A3296CATot = THISFORM.Buf_W11142_3296CATot
               THISFORM.A3289CACAE = THISFORM.Buf_W11142_3289CACAE
               THISFORM.A3287CANro = THISFORM.Buf_W11142_3287CANro
               THISFORM.A3286CASuc = THISFORM.Buf_W11142_3286CASuc
               THISFORM.A3285CATip = THISFORM.Buf_W11142_3285CATipo
               THISFORM.A3284CACUI = THISFORM.Buf_W11142_3284CACUIT
               GX_SFLOAD = 0
               THISFORM.U13VUY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11142 = Gx_err
               THISFORM.GX_DB_GetW11142_01 ()
            ENDDO
         ENDIF
      ENDPROC
