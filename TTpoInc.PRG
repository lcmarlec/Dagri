               ENDDO
               THISFORM.T02744 = Gx_err
               THISFORM.GX_DB_GetT02744_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2626TpICo = THISFORM.Buf_T02744_2626TpICod
               THISFORM.A2641TpIDs = THISFORM.Buf_T02744_2641TpIDsc
         ENDCASE
         Gx_fcond = THISFORM.T02744 <> 101 .AND. THISFORM.T02744 <> 101
         IF .NOT. Gx_fcond
