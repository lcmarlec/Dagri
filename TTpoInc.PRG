      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02744" , @HStmt_T02744 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTPOINC","T02744","",GX_CURSOR_TYPE_READONLY,@HStmt_T02744) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [TpICod], [TpIDsc] FROM [TPOINC] (FASTFIRSTROW NOLOCK) WHERE [TpICod] >= ? "
            cmdbuf = cmdbuf + "  ORDER BY [TpICod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02744,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02744,100)
            THISFORM.GX_DB_BindColsT02744_01 ()
            THISFORM.GX_DB_BindParmT02744_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2626TpICo = 0
               ENDIF
               AuxA2626TpICo = THISFORM.A2626TpICo
               Gx_err = GX_DB_SetInt( HStmt_T02744,1,@AuxA2626TpICo,0)
               THISFORM.A2626TpICo = AuxA2626TpICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02744) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02744 = Gx_err
               THISFORM.GX_DB_GetT02744_01 ()
               Gx_fcond = THISFORM.T02744 <> 101
            CASE GXOP = 2 && Next record
               AuxA2626TpICo = THISFORM.A2626TpICo
               Gx_err = GX_DB_SetInt( HStmt_T02744,1,@AuxA2626TpICo,0)
               THISFORM.A2626TpICo = AuxA2626TpICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02744) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02744 = Gx_err
               THISFORM.GX_DB_GetT02744_01 ()
               DO WHILE THISFORM.T02744 = 0 .AND. THISFORM.A2626TpICo >= THISFORM.Buf_T02744_2626TpICod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02744) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02744 = Gx_err
                  THISFORM.GX_DB_GetT02744_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02744 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2626TpICo = 0
               AuxA2626TpICo = THISFORM.A2626TpICo
               Gx_err = GX_DB_SetInt( HStmt_T02744,1,@AuxA2626TpICo,0)
               THISFORM.A2626TpICo = AuxA2626TpICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02744) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02744 = Gx_err
               THISFORM.GX_DB_GetT02744_01 ()
               DO WHILE THISFORM.T02744 = 0
                  THISFORM.A2626TpICo = THISFORM.Buf_T02744_2626TpICod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02744) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02744 = Gx_err
                  THISFORM.GX_DB_GetT02744_01 ()
               ENDDO
               AuxA2626TpICo = THISFORM.A2626TpICo
               Gx_err = GX_DB_SetInt( HStmt_T02744,1,@AuxA2626TpICo,0)
               THISFORM.A2626TpICo = AuxA2626TpICo
               Gx_eop = 1
