               Gx_err = GX_DB_SetStr( HStmt_T02745,2,AuxA2641TpIDs,30,0)
               THISFORM.A2641TpIDs = AuxA2641TpIDs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02745) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02745 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02745) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02745 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02746" , @HStmt_T02746 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTPOINC","T02746","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02746) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [TPOINC] SET [TpIDsc]=?  WHERE [TpICod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02746,cmdbuf)
                  THISFORM.GX_DB_BindParmT02746_01 ()
               ENDIF
               AuxA2641TpIDs = THISFORM.A2641TpIDs
               Gx_err = GX_DB_SetStr( HStmt_T02746,1,AuxA2641TpIDs,30,0)
               THISFORM.A2641TpIDs = AuxA2641TpIDs
               AuxA2626TpICo = THISFORM.A2626TpICo
               Gx_err = GX_DB_SetInt( HStmt_T02746,2,@AuxA2626TpICo,0)
               THISFORM.A2626TpICo = AuxA2626TpICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02746) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02746 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02746) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02747" , @HStmt_T02747 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTPOINC","T02747","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02747) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [TPOINC]  WHERE [TpICod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02747,cmdbuf)
                  THISFORM.GX_DB_BindParmT02747_01 ()
               ENDIF
               AuxA2626TpICo = THISFORM.A2626TpICo
               Gx_err = GX_DB_SetInt( HStmt_T02747,1,@AuxA2626TpICo,0)
               THISFORM.A2626TpICo = AuxA2626TpICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02747) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02747 = Gx_err
               THISFORM.T02742 = iif( THISFORM.T02747 = 0 , 104 , THISFORM.T02747 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02747) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A2626TpICo , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "MAES" , Aux1 , "TPOINC" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT274V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 303 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
