         * Navigation
         THISFORM.A816PedTot = 0.00
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01213" , @HStmt_W01213 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPEDIDO","W01213","",GX_CURSOR_TYPE_READONLY,@HStmt_W01213) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [PedFch], [PedGruTip] AS PedGruTip, [PedEntCod] AS PedEntCod, [PedSucCod] "
            cmdbuf = cmdbuf + "  AS PedSucCod, [PedSec], [PedInd], [FamCod], [FamSubCod], [ArtCod], [PedCnt], [PedVPrc] "
            cmdbuf = cmdbuf + "  FROM [PEDIDO3] (NOLOCK) WHERE [EmpCod] = ? AND [PedFch] = ? AND [PedGruTip] = ? "
            cmdbuf = cmdbuf + "  AND [PedEntCod] = ? AND [PedSucCod] = ? AND [PedSec] = ? ORDER BY [EmpCod], [PedFch], "
            cmdbuf = cmdbuf + "  [PedGruTip], [PedEntCod], [PedSucCod], [PedSec]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01213,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01213,100)
            THISFORM.GX_DB_BindColsW01213_01 ()
            THISFORM.GX_DB_BindParmW01213_01 ()
         ENDIF
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01213,1,@A2EmpCod,0)
         THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01213,2,@A795PedFch,0)
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01213,3,A797PedGru,2,0)
