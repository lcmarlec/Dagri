         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01213,6,@A809PedSec,0)
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01213) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W01213 = Gx_err
         THISFORM.GX_DB_GetW01213_01 ()
         DO WHILE THISFORM.W01213 <> 101 .AND. THISFORM.Buf_W01213_2EmpCod=A2EmpCod .AND. THISFORM.Buf_W01213_795PedFch=A795PedFch .AND. THISFORM.Buf_W01213_797PedGruTip=A797PedGru .AND. THISFORM.Buf_W01213_798PedEntCod=A798PedEnt
            IF .NOT. ( THISFORM.Buf_W01213_802PedSucCod=A802PedSuc .AND. THISFORM.Buf_W01213_809PedSec=A809PedSec )
               EXIT
            ENDIF
            THISFORM.A811PedLin = THISFORM.Buf_W01213_813PedVPrc * THISFORM.Buf_W01213_810PedCnt
            THISFORM.A816PedTot = THISFORM.A816PedTot + THISFORM.A811PedLin
