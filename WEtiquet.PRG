      PROCEDURE CreateTemp
         LOCAL SCW1255S11
         SCW1255S11 = ""
         IF USED( "SCW1255S11" )
            SELECT SCW1255S11
            SCW1255S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1255S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA3646EtiT"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 30
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3647EtiF"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3648EtiH"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3660EtiL"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1464ArtC"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 15
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA5ArtCod"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA6ArtDsc"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 50
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "VAV19Impri"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 1
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1255S11 = GETE('z:\temp') + '\' + SCW1255S11
            ENDIF
            CREATE DBF (SCW1255S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1255S11) EXCLUSIVE ALIAS SCW1255S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1255S11
         THIS.GX_SfAlias = "SCW1255S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12553" , @HStmt_W12553 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WETIQUET","W12553","",GX_CURSOR_TYPE_READONLY,@HStmt_W12553) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[FamCod], T1.[FamSubCod], T1.[EmpCod], T2.[ArtDsc], T1.[ArtCod], T2.[ArtCodBar], "
                  cmdbuf = cmdbuf + "  T1.[EtiLotNro], T1.[EtiHor], T1.[EtiFch], T1.[EtiTraz] FROM ([Etiquetas] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] "
                  cmdbuf = cmdbuf + "  = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ?) AND (T1.[EtiTraz] like ?) ORDER BY T1.[EmpCod], T1.[EtiTraz] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12553,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12553,16)
                  THISFORM.GX_DB_BindColsW12553_01 ()
                  THISFORM.GX_DB_BindParmW12553_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12553,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12553,2,PADR( TRIM(THISFORM.AV17Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV17Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12553) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12553 = Gx_err
               THISFORM.GX_DB_GetW12553_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WEtiquet"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12553 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12553) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12553 = Gx_err
                  THISFORM.GX_DB_GetW12553_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12553 <> 101
               BRKVYV2 = .F.
               THISFORM.AV19Imprim = 0
               THISFORM.A3FamCod = THISFORM.Buf_W12553_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W12553_4FamSubCod
               THISFORM.A2EmpCod = THISFORM.Buf_W12553_2EmpCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W12553_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W12553_5ArtCod
               THISFORM.A1464ArtCo = THISFORM.Buf_W12553_1464ArtCodBar
               THISFORM.A3660EtiLo = THISFORM.Buf_W12553_3660EtiLotNro
               THISFORM.A3648EtiHo = THISFORM.Buf_W12553_3648EtiHor
               THISFORM.A3647EtiFc = THISFORM.Buf_W12553_3647EtiFch
               THISFORM.A3646EtiTr = THISFORM.Buf_W12553_3646EtiTraz
               THISFORM.A6ArtDsc = THISFORM.Buf_W12553_6ArtDsc
               THISFORM.A1464ArtCo = THISFORM.Buf_W12553_1464ArtCodBar
               GX_SFLOAD = 0
               THISFORM.U14VYV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12553) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12553 = Gx_err
               THISFORM.GX_DB_GetW12553_01 ()
            ENDDO
         ENDIF
      ENDPROC
