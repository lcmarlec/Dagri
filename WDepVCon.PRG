      PROCEDURE CreateTemp
         LOCAL SCW1192S18
         SCW1192S18 = ""
         IF USED( "SCW1192S18" )
            SELECT SCW1192S18
            SCW1192S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1192S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "VAV31Testi"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV36Tesnr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV37Tesfc"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV38Tesen"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV39Tesen"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV34Impor"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 15
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "VAV35Tesnr"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1192S18 = GETE('z:\temp') + '\' + SCW1192S18
            ENDIF
            CREATE DBF (SCW1192S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1192S18) EXCLUSIVE ALIAS SCW1192S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1192S18
         THIS.GX_SfAlias = "SCW1192S18"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U14VX42 ()
