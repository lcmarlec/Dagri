      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12542" , @HStmt_W12542 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESPA","W12542","",GX_CURSOR_TYPE_READONLY,@HStmt_W12542) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CarNro], [EmpCod], [CarTip], [CarHor], [CarFch], [CarRut] FROM [CARGA] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ?) AND ([CarRut] >= ?) AND ([CarFch] >= ?) AND ([CarFch] "
                  cmdbuf = cmdbuf + "  <= ?) AND ([CarRut] > 0) AND ([CarNro] like '%' + RTRIM(?) + '%') ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [CarNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12542,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12542,13)
                  THISFORM.GX_DB_BindColsW12542_01 ()
                  THISFORM.GX_DB_BindParmW12542_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12542,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV25Rutcod = THISFORM.AV25Rutcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12542,2,@AuxAV25Rutcod,0)
               THISFORM.AV25Rutcod = AuxAV25Rutcod
               AuxAV29Carfch = THISFORM.AV29Carfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12542,3,@AuxAV29Carfch,0)
               THISFORM.AV29Carfch = AuxAV29Carfch
               AuxAV37Carfch = THISFORM.AV37Carfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12542,4,@AuxAV37Carfch,0)
               THISFORM.AV37Carfch = AuxAV37Carfch
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12542,5,PADR( TRIM(THISFORM.AV36Carnro),15, '%'),LEN(PADR( TRIM(THISFORM.AV36Carnro),15, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12542 = Gx_err
               THISFORM.GX_DB_GetW12542_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV40Pgmnam = "WDespa"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12542 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12542) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12542 = Gx_err
                  THISFORM.GX_DB_GetW12542_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12542 <> 101
               BRKVYU2 = .F.
               THISFORM.A3356CarNr = THISFORM.Buf_W12542_3356CarNro
               THISFORM.A2EmpCod = THISFORM.Buf_W12542_2EmpCod
               THISFORM.A3688CarTi = THISFORM.Buf_W12542_3688CarTip
               THISFORM.A3670CarHo = THISFORM.Buf_W12542_3670CarHor
               THISFORM.A3357CarFc = THISFORM.Buf_W12542_3357CarFch
               THISFORM.A3359CarRu = THISFORM.Buf_W12542_3359CarRut
               GX_SFLOAD = 0
               THISFORM.U17VYU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12542 = Gx_err
               THISFORM.GX_DB_GetW12542_01 ()
            ENDDO
         ENDIF
      ENDPROC
