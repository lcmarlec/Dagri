         LOCAL gx_old_event
         THISFORM.SetEvent( "START" )
         * Start Routine
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV8Emprcod
         Aux1 = THISFORM.AV9Emprnom
         DO RLeeEmp WITH Aux0 , Aux1
         THISFORM.AV8Emprcod = Aux0
         THISFORM.AV9Emprnom = Aux1
         THISFORM. cCW500S11 .RestoreGridPos()
         GX_rploop = .T.
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV20Usuari
         Aux2 = THISFORM.AV8Emprcod
         Aux3 = THISFORM.AV24Nivel
         DO RNivAcc WITH Aux0 , "RVTSEG" , Aux2 , Aux3
         THISFORM.AV20Usuari = Aux0
         THISFORM.AV8Emprcod = Aux2
         THISFORM.AV24Nivel = Aux3
         THISFORM. cCW500S11 .RestoreGridPos()
         GX_rploop = .T.
         THISFORM.AV63GXLvl3 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05004" , @HStmt_W05004 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTSEG1","W05004","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05004) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [DcVNroInt], [DcVSuc], [DcVSer], [DcvTipRed], [DcVNro] FROM [DCVENT] "
            cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? and [DcVNroInt] = ? ORDER BY [EmpCod], [DcVNroInt]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05004,cmdbuf)
            THISFORM.GX_DB_BindColsW05004_01 ()
            THISFORM.GX_DB_BindParmW05004_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05004,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV19Ni = THISFORM.AV19Ni
         THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05004,2,@AuxAV19Ni,0)
         THISFORM.AV19Ni = AuxAV19Ni
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05004) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05004 = Gx_err
         THISFORM.GX_DB_GetW05004_01 ()
         DO WHILE THISFORM.W05004 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W05004_2EmpCod
            THISFORM.A415DcVNro = THISFORM.Buf_W05004_415DcVNroInt
            THISFORM.A424DcVSuc = THISFORM.Buf_W05004_424DcVSuc
            THISFORM.A423DcVSer = THISFORM.Buf_W05004_423DcVSer
            THISFORM.A1208DcvTi = THISFORM.Buf_W05004_1208DcvTipRed
            THISFORM.A425DcVNro = THISFORM.Buf_W05004_425DcVNro
            THISFORM.AV63GXLvl3 = 1
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A424DcVSuc
            Aux3 = THISFORM.Gx_msg
            DO RStrZero WITH Aux0 , 4 , 0 , Aux3
            THISFORM.A424DcVSuc = Aux0
            THISFORM.Gx_msg = Aux3
            THISFORM. cCW500S11 .RestoreGridPos()
            GX_rploop = .T.
            THISFORM.AV30Remito = THISFORM.A1208DcvTi + " " + THISFORM.A423DcVSer + " " + ALLTRIM( THISFORM.Gx_msg ) + "-"
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A425DcVNro
            Aux3 = THISFORM.Gx_msg
            DO RStrZero WITH Aux0 , 8 , 0 , Aux3
            THISFORM.A425DcVNro = Aux0
            THISFORM.Gx_msg = Aux3
            THISFORM. cCW500S11 .RestoreGridPos()
            GX_rploop = .T.
            THISFORM.AV30Remito = ALLTRIM( THISFORM.AV30Remito ) + ALLTRIM( THISFORM.Gx_msg )
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05004) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV63GXLvl3 = 0
            THISFORM.AV30Remito = SPACE(18)
         ENDIF
         THISFORM.AV49Opcion = " "
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

