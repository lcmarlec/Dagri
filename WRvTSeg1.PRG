      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05003" , @HStmt_W05003 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTSEG1","W05003","",GX_CURSOR_TYPE_READONLY,@HStmt_W05003) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[RVtEntLgCo] AS RVtEntLgCo, T1.[EmpCod], T1.[RVtNroInt], T2.[RVtPedNro], "
                  cmdbuf = cmdbuf + "  T2.[RVtSuc], T2.[RVtNro], T2.[RVtEntGruT] AS RVtEntGruT, T2.[RVtEntCod] AS RVtEntCod, "
                  cmdbuf = cmdbuf + "  T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T5.[ArtDsc], T1.[RVtPrc], T2.[RvtDesc], "
                  cmdbuf = cmdbuf + "  T2.[RvtDes1], T2.[RvtDes2], T2.[RvtDes3], T1.[RVtPrcReal], T1.[RvtPrcOri], T1.[RVtLin], "
                  cmdbuf = cmdbuf + "  T5.[ArtVtaBlt], T5.[ArtVtaBltC], T1.[RVtCnt], T4.[EntLgDom], T2.[RVtEst], T2.[RVtFch], "
                  cmdbuf = cmdbuf + "  T3.[EntRaz] AS RVtEntRaz, T1.[RvtCntOri] FROM (((([REMVTA1] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [REMVTA] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[RVtNroInt] = "
                  cmdbuf = cmdbuf + "  T1.[RVtNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T2.[RVtEntGruT] AND T3.[EntCod] = T2.[RVtEntCod]) LEFT JOIN [CLTES] T4 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T4.[EmpCod] = T1.[EmpCod] AND T4.[EntGruTip] = T2.[RVtEntGruT] AND T4.[EntCod] "
                  cmdbuf = cmdbuf + "  = T2.[RVtEntCod] AND T4.[EntLgCod] = T2.[RVtEntLgCo]) LEFT JOIN [ARTICS] T5 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T5.[EmpCod] = T1.[EmpCod] AND T5.[FamCod] = T1.[FamCod] AND T5.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod] AND T5.[ArtCod] = T1.[ArtCod]) WHERE T1.[EmpCod] = ? and T1.[RVtNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[RVtNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05003,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05003,11)
                  THISFORM.GX_DB_BindColsW05003_01 ()
                  THISFORM.GX_DB_BindParmW05003_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05003,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Ni = THISFORM.AV19Ni
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05003,2,@AuxAV19Ni,0)
               THISFORM.AV19Ni = AuxAV19Ni
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05003) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05003 = Gx_err
               THISFORM.GX_DB_GetW05003_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV65Pgmnam = "WRvTSeg1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05003 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05003 <> 101
               BRKVDW2 = .F.
               THISFORM.AV31Cntctr = 0.0000
