      PROCEDURE CreateTemp
         LOCAL SCW1219S21
         SCW1219S21 = ""
         IF USED( "SCW1219S21" )
            SELECT SCW1219S21
            SCW1219S21 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1219S21
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "VAV40Ausfc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV43Ausfc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV39Ausim"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "VAV41Ausfp"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV42Auspc"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1219S21 = GETE('z:\temp') + '\' + SCW1219S21
            ENDIF
            CREATE DBF (SCW1219S21) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1219S21) EXCLUSIVE ALIAS SCW1219S21
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1219S21
         THIS.GX_SfAlias = "SCW1219S21"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U17VXV2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
