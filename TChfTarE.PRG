                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCHFTARE","T017922","",0,@HStmt_T017922) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT EmpCod, ChfEntGruT, ChfEntCod, chTKgHta, chTKgPaiCo, chTKgPciCo, chTKgMunCo, "
                  cmdbuf = cmdbuf + "  ChTTarifa1  FROM CHFTAR2 (NOLOCK) WHERE EmpCod = ? AND ChfEntGruT = ? AND ChfEntCod "
                  cmdbuf = cmdbuf + "  = ? AND chTKgHta = ? AND chTKgPaiCo = ? AND chTKgPciCo = ? ORDER BY EmpCod, ChfEntGruT, "
                  cmdbuf = cmdbuf + "  ChfEntCod, chTKgHta, chTKgPaiCo, chTKgPciCo, chTKgMunCo   "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_T017922,cmdbuf) ,  ,  ,  , CS_SQLSRV , 0 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtFetchSize( HStmt_T017922,9) ,  ,  ,  , CS_SQLSRV , 0 )
                  THISFORM.GX_DB_BindColsT01792_01 ( HStmt_T017922 )
                  THISFORM.GX_DB_BindParmT017922_01 ( HStmt_T017922 )
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T017922,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1549ChfEn = THISFORM.A1549ChfEn
               Gx_err = GX_DB_SetStr( HStmt_T017922,2,AuxA1549ChfEn,2,0)
               THISFORM.A1549ChfEn = AuxA1549ChfEn
               AuxA1550ChfEn = THISFORM.A1550ChfEn
               Gx_err = GX_DB_SetLong( HStmt_T017922,3,@AuxA1550ChfEn,0)
               THISFORM.A1550ChfEn = AuxA1550ChfEn
               AuxA1817chTKg = THISFORM.A1817chTKg
               Gx_err = GX_DB_SetDouble( HStmt_T017922,4,@AuxA1817chTKg,0)
               THISFORM.A1817chTKg = AuxA1817chTKg
               AuxA1819chTKg = THISFORM.A1819chTKg
               Gx_err = GX_DB_SetStr( HStmt_T017922,5,AuxA1819chTKg,4,0)
               THISFORM.A1819chTKg = AuxA1819chTKg
               AuxA1820chTKg = THISFORM.A1820chTKg
               Gx_err = GX_DB_SetStr( HStmt_T017922,6,AuxA1820chTKg,4,0)
               THISFORM.A1820chTKg = AuxA1820chTKg
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T017922) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T017922 = Gx_err
               THISFORM.GX_DB_GetT017922_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T017922 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T017922) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T017922 = Gx_err
                  THISFORM.GX_DB_GetT017922_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T017922 <> 101
               BRK4Z211 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT179S30.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T017922) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T017922 = Gx_err
               THISFORM.GX_DB_GetT017922_01 ()
            ENDDO
         ENDIF
      ENDPROC
