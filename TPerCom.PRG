      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S2870PCNro
         LOCAL S2875PcPgL
         S2EmpCod = THISFORM.A2EmpCod
         S2870PCNro = THISFORM.A2870PCNro
         S2875PcPgL = THISFORM.A2875PcPgL
         THISFORM.A2875PcPgL = THISFORM.M2875PcPgL
         THISFORM. cCT298S24 .SaveTemp()
         THISFORM. cCT298S24 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT298S24 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT298S24 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT298S24 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2870PCNro = THISFORM.A2870PCNro .AND. S2875PcPgL = THISFORM.A2875PcPgL
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT298S24 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT298S24 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2870PCNro = THISFORM.A2870PCNro .AND. S2875PcPgL = THISFORM.A2875PcPgL
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT298S24 .Refresh()
               THISFORM. cCT298S24 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A2870PCNro = S2870PCNro
               THISFORM.A2875PcPgL = S2875PcPgL
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT298S24 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT298S24 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2870PCNro = THISFORM.A2870PCNro .AND. S2875PcPgL = THISFORM.A2875PcPgL
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT298S24 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2870PCNro = THISFORM.A2870PCNro .AND. S2875PcPgL = THISFORM.A2875PcPgL
            ENDDO
            IF sf_err != 0
               THISFORM. cCT298S24 .AppendRow()
               THISFORM. cCT298S24 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A2870PCNro = S2870PCNro
               THISFORM.A2875PcPgL = S2875PcPgL
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A2870PCNro = S2870PCNro
         THISFORM.A2875PcPgL = S2875PcPgL
         RETURN .F.
      ENDFUNC
