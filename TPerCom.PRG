                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T029819) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T029819 = Gx_err
               THISFORM.GX_DB_GetT029819_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T029819 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T029819) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T029819 = Gx_err
                  THISFORM.GX_DB_GetT029819_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T029819 <> 101
               BRK8A329 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT298S24.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T029819_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T029819_2870PCNroInt = THISFORM.A2870PCNro
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T029819) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T029819 = Gx_err
               THISFORM.GX_DB_GetT029819_01 ()
            ENDDO
         ENDIF
      ENDPROC
