      ***********************
      PROCEDURE U12VSA2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         THISFORM.AV11Ok = 0
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.A2EmpCod
         Aux1 = THISFORM.A121ChqNro
         Aux2 = THISFORM.A122ChqLin
         Aux3 = THISFORM.A123ChqTip
         Aux4 = THISFORM.A124ChqCta
         Aux5 = THISFORM.A129ChqNro
         Aux6 = THISFORM.AV6Fechasi
         Aux7 = THISFORM.AV7Usuario
         Aux8 = THISFORM.AV17Chqfch
         Aux9 = THISFORM.AV10Chqre
         Aux10 = THISFORM.AV11Ok
         DO PReinChq WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7 , Aux8 , Aux9 , Aux10
         THISFORM.A2EmpCod = Aux0
         THISFORM.A121ChqNro = Aux1
         THISFORM.A122ChqLin = Aux2
         THISFORM.A123ChqTip = Aux3
         THISFORM.A124ChqCta = Aux4
         THISFORM.A129ChqNro = Aux5
         THISFORM.AV6Fechasi = Aux6
         THISFORM.AV7Usuario = Aux7
         THISFORM.AV17Chqfch = Aux8
         THISFORM.AV10Chqre = Aux9
         THISFORM.AV11Ok = Aux10
         GX_rploop = .T.
         IF THISFORM.AV11Ok = 1
            THISFORM.Refresh()
            DO GX_ERRMW WITH "El Cheque fue reingresado exitosamente."
            THISFORM.AV16Numero = ALLTRIM( str( THISFORM.A2EmpCod ) ) + " " + ALLTRIM( str( THISFORM.A121ChqNro ) ) + " " + ALLTRIM( str( THISFORM.A122ChqLin ) ) + " P " + ALLTRIM( str( THISFORM.A124ChqCta ) )
            THISFORM.AV15Audobs = "Reingreso exitoso del cheque:" + THISFORM.AV16Numero
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV13Emprco
            Aux3 = THISFORM.AV16Numero
            Aux5 = THISFORM.AV15Audobs
            Aux6 = THISFORM.AV7Usuario
            DO PAuditor WITH "BCOS" , Aux1 , "CHQS" , Aux3 , "INS" , Aux5 , Aux6
            THISFORM.AV13Emprco = Aux1
            THISFORM.AV16Numero = Aux3
            THISFORM.AV15Audobs = Aux5
            THISFORM.AV7Usuario = Aux6
            GX_rploop = .T.
            THISFORM.ReleaseAll()
            RETURN
         ELSE
            IF THISFORM.AV11Ok = 0
               THISFORM.Refresh()
               DO GX_ERRMW WITH "No se pudo reingresar el cheque. Verifique que no se haya reingresado anteriormente."
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

