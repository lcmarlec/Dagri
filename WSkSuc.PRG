      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01622" , @HStmt_W01622 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKSUC","W01622","",GX_CURSOR_TYPE_READONLY,@HStmt_W01622) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[EntGruTip], T1.[EntCod], T1.[EntLgInhab], T1.[EntLgCont], "
                  cmdbuf = cmdbuf + "  T1.[EntLgTel], T1.[EntLgDom], T1.[EntLgDsc], T1.[EntLgCod], T2.[EntRaz] FROM ([CLTES] "
                  cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] = ? and T1.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = ? and T1.[EntCod] = ?) AND (T1.[EntLgDsc] like ?) AND (T1.[EntLgInhab] <> 'S' "
                  cmdbuf = cmdbuf + "  or ? = 'S') ORDER BY T1.[EmpCod], T1.[EntGruTip], T1.[EntCod], T1.[EntLgDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01622,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01622,15)
                  THISFORM.GX_DB_BindColsW01622_01 ()
                  THISFORM.GX_DB_BindParmW01622_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01622,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01622,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01622,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01622,4,PADR( TRIM(THISFORM.AV18Desraz),40, '%'),LEN(PADR( TRIM(THISFORM.AV18Desraz),40, '%')),0)
               AuxAV23Entinh = THISFORM.AV23Entinh
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01622,5,AuxAV23Entinh,1,0)
               THISFORM.AV23Entinh = AuxAV23Entinh
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01622 = Gx_err
               THISFORM.GX_DB_GetW01622_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WSkSuc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01622 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01622) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01622 = Gx_err
                  THISFORM.GX_DB_GetW01622_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01622 <> 101
               BRKV4I2 = .F.
               THISFORM.A1886EntLg = THISFORM.Buf_W01622_1886EntLgInhab
               THISFORM.A185EntLgC = THISFORM.Buf_W01622_185EntLgCont
               THISFORM.A186EntLgT = THISFORM.Buf_W01622_186EntLgTel
               THISFORM.A178EntLgD = THISFORM.Buf_W01622_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W01622_177EntLgDsc
               THISFORM.A176EntLgC = THISFORM.Buf_W01622_176EntLgCod
               THISFORM.A153EntRaz = THISFORM.Buf_W01622_153EntRaz
               THISFORM.A153EntRaz = THISFORM.Buf_W01622_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U15V4I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01622 = Gx_err
               THISFORM.GX_DB_GetW01622_01 ()
            ENDDO
