      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07992" , @HStmt_W07992 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKDREL","W07992","",GX_CURSOR_TYPE_READONLY,@HStmt_W07992) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntGruTip], [EntCod], [EmpCod], [DccTotOri], [DcCNroInt], [DcCTot], [DcCNro], "
                  cmdbuf = cmdbuf + "  [DcCSuc], [DccSer], [DccTipRed], [DcCFec] FROM [DCCOM] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([EmpCod] = ?) AND ([DcCFec] >= ?) AND ([EntGruTip] = ?) AND ([EntCod] = ? or ? "
                  cmdbuf = cmdbuf + "  = convert(int, 0)) AND ([DccTipRed] = ? or ? = ' ') AND ([DccSer] = ? or ? = ' ') "
                  cmdbuf = cmdbuf + "  AND ([DcCSuc] = ? or ? = convert(int, 0)) AND ([DcCNro] >= ?) ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07992,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07992,12)
                  THISFORM.GX_DB_BindColsW07992_01 ()
                  THISFORM.GX_DB_BindParmW07992_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07992,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV17Desde = THISFORM.AV17Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07992,2,@AuxAV17Desde,0)
               THISFORM.AV17Desde = AuxAV17Desde
               AuxAV19Entgru = THISFORM.AV19Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07992,3,AuxAV19Entgru,2,0)
               THISFORM.AV19Entgru = AuxAV19Entgru
               AuxAV20Entcod = THISFORM.AV20Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07992,4,@AuxAV20Entcod,0)
               THISFORM.AV20Entcod = AuxAV20Entcod
               AuxAV20Entcod = THISFORM.AV20Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07992,5,@AuxAV20Entcod,0)
               THISFORM.AV20Entcod = AuxAV20Entcod
               AuxAV27Dcctip = THISFORM.AV27Dcctip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07992,6,AuxAV27Dcctip,2,0)
               THISFORM.AV27Dcctip = AuxAV27Dcctip
               AuxAV27Dcctip = THISFORM.AV27Dcctip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07992,7,AuxAV27Dcctip,2,0)
               THISFORM.AV27Dcctip = AuxAV27Dcctip
               AuxAV28Dccser = THISFORM.AV28Dccser
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07992,8,AuxAV28Dccser,1,0)
               THISFORM.AV28Dccser = AuxAV28Dccser
               AuxAV28Dccser = THISFORM.AV28Dccser
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07992,9,AuxAV28Dccser,1,0)
               THISFORM.AV28Dccser = AuxAV28Dccser
               AuxAV29Dccsuc = THISFORM.AV29Dccsuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07992,10,@AuxAV29Dccsuc,0)
               THISFORM.AV29Dccsuc = AuxAV29Dccsuc
               AuxAV29Dccsuc = THISFORM.AV29Dccsuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07992,11,@AuxAV29Dccsuc,0)
               THISFORM.AV29Dccsuc = AuxAV29Dccsuc
               AuxAV30Dccnro = THISFORM.AV30Dccnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07992,12,@AuxAV30Dccnro,0)
               THISFORM.AV30Dccnro = AuxAV30Dccnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07992) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07992 = Gx_err
               THISFORM.GX_DB_GetW07992_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV35Pgmnam = "WSKDRel"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07992 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07992) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07992 = Gx_err
                  THISFORM.GX_DB_GetW07992_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07992 <> 101
               BRKVM72 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W07992_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W07992_120EntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W07992_2EmpCod
               THISFORM.A2383DccTo = THISFORM.Buf_W07992_2383DccTotOri
               THISFORM.A346DcCNro = THISFORM.Buf_W07992_346DcCNroInt
               THISFORM.A371DcCTot = THISFORM.Buf_W07992_371DcCTot
               THISFORM.A352DcCNro = THISFORM.Buf_W07992_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W07992_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W07992_349DccSer
               THISFORM.A1322DccTi = THISFORM.Buf_W07992_1322DccTipRed
               THISFORM.A347DcCFec = THISFORM.Buf_W07992_347DcCFec
               GX_SFLOAD = 0
               THISFORM.U15VM72 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07992) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07992 = Gx_err
               THISFORM.GX_DB_GetW07992_01 ()
            ENDDO
         ENDIF
      ENDPROC
