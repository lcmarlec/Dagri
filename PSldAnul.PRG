            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PSLDANUL","P07439","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P07439) ,  ,  ,  , CS_SQLSRV ,  )
