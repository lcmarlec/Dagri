      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02762,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA2655PrcCo = THISFORM.A2655PrcCo
            Gx_err = GX_DB_SetInt( HStmt_T02762,2,@AuxA2655PrcCo,0)
            THISFORM.A2655PrcCo = AuxA2655PrcCo
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02762) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02762 = Gx_err
            THISFORM.GX_DB_GetT02762_01 ()
            IF .NOT. THISFORM.T02762 <> 103
               DO GX_ERRMW WITH "PROCED reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02762 = 101 .OR. THISFORM.Z2656PrcNo <> THISFORM.Buf_T02762_2656PrcNom
               DO GX_ERRMW WITH "PROCED fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02766" , @HStmt_T02766 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPROCED","T02766","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02766) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [PROCED] ([EmpCod], [PrcCod], [PrcNom], [PrcDet]) VALUES (?, ?, ?, ?) "
                  cmdbuf = cmdbuf + "  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02766,cmdbuf)
                  THISFORM.GX_DB_BindParmT02766_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02766,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2655PrcCo = THISFORM.A2655PrcCo
