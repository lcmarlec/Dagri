               AuxA2655PrcCo = THISFORM.A2655PrcCo
               Gx_err = GX_DB_SetInt( HStmt_T02765,2,@AuxA2655PrcCo,0)
               THISFORM.A2655PrcCo = AuxA2655PrcCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02765) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02765 = Gx_err
               THISFORM.GX_DB_GetT02765_01 ()
               DO WHILE THISFORM.T02765 = 0
                  THISFORM.A2EmpCod = THISFORM.Buf_T02765_2EmpCod
                  THISFORM.A2655PrcCo = THISFORM.Buf_T02765_2655PrcCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02765) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02765 = Gx_err
                  THISFORM.GX_DB_GetT02765_01 ()
               ENDDO
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02765,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
