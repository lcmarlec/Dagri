            cmdbuf = cmdbuf + "  WHERE [EmpCod] >= ? and [PrcCod] >= ? ORDER BY [EmpCod], [PrcCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02765,cmdbuf)
