                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02768) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02768 = Gx_err
               THISFORM.T02762 = iif( THISFORM.T02768 = 0 , 104 , THISFORM.T02768 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02768) ,  ,  ,  , CS_SQLSRV , 0 )
