                  ENDDO
                  THISFORM.T02765 = Gx_err
                  THISFORM.GX_DB_GetT02765_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02765 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2EmpCod = 0
               THISFORM.A2655PrcCo = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02765,1,@AuxA2EmpCod,0)
