      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10712" , @HStmt_W10712 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCHQPEN","W10712","",GX_CURSOR_TYPE_READONLY,@HStmt_W10712) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ChqNroI], T1.[ChqLin], T1.[AuxCod], T1.[ChqBcoCod] AS ChqBcoCod, T1.[ChqEst], "
                  cmdbuf = cmdbuf + "  T1.[ChqCta], T1.[EmpCod], T3.[AuxNom], T1.[ChqImp], T1.[ChqTip], T1.[ChqNro], T2.[BcoDsc] "
                  cmdbuf = cmdbuf + "  AS ChqBcoDsc, T1.[ChqCliGrT], T1.[ChqCliCod], T1.[ChqFchDeb], T1.[chqrecibo], T1.[ChqNroReg] "
                  cmdbuf = cmdbuf + "  FROM (([CHQS] T1 (NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[ChqBcoCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTRCHQ] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[AuxCod] = T1.[AuxCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ?) AND (T1.[ChqTip] = 'T' or T1.[ChqTip] = 'E') AND (T1.[ChqCta] "
                  cmdbuf = cmdbuf + "  = 0) AND (T1.[ChqEst] = 0) ORDER BY T1.[EmpCod], T1.[ChqNroI], T1.[ChqLin], T1.[ChqTip], "
                  cmdbuf = cmdbuf + "  T1.[ChqCta]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10712,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10712,10)
                  THISFORM.GX_DB_BindColsW10712_01 ()
                  THISFORM.GX_DB_BindParmW10712_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10712,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10712) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10712 = Gx_err
               THISFORM.GX_DB_GetW10712_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV23Pgmnam = "WChqPen"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10712 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10712) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10712 = Gx_err
                  THISFORM.GX_DB_GetW10712_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10712 <> 101
               BRKVTR2 = .F.
               THISFORM.A1994AuxCo = THISFORM.Buf_W10712_1994AuxCod
               THISFORM.A126ChqBco = THISFORM.Buf_W10712_126ChqBcoCod
               THISFORM.A136ChqEst = THISFORM.Buf_W10712_136ChqEst
               THISFORM.A124ChqCta = THISFORM.Buf_W10712_124ChqCta
               THISFORM.A2EmpCod = THISFORM.Buf_W10712_2EmpCod
               THISFORM.A1995AuxNo = THISFORM.Buf_W10712_1995AuxNom
               THISFORM.A131ChqImp = THISFORM.Buf_W10712_131ChqImp
               THISFORM.A123ChqTip = THISFORM.Buf_W10712_123ChqTip
               THISFORM.A129ChqNro = THISFORM.Buf_W10712_129ChqNro
               THISFORM.A127ChqBco = THISFORM.Buf_W10712_127ChqBcoDsc
               THISFORM.A133ChqCli = THISFORM.Buf_W10712_133ChqCliGrT
               THISFORM.A134ChqCli = THISFORM.Buf_W10712_134ChqCliCod
               THISFORM.A132ChqFch = THISFORM.Buf_W10712_132ChqFchDeb
               THISFORM.A2007chqre = THISFORM.Buf_W10712_2007chqrecibo
               THISFORM.A137ChqNro = THISFORM.Buf_W10712_137ChqNroReg
               THISFORM.A127ChqBco = THISFORM.Buf_W10712_127ChqBcoDsc
               THISFORM.A1995AuxNo = THISFORM.Buf_W10712_1995AuxNom
               X1350 = SPACE(40)
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A133ChqCli
               Aux2 = THISFORM.A134ChqCli
               DO RProvNFR WITH Aux0 , Aux1 , Aux2 , X1350
               THISFORM.A2EmpCod = Aux0
               THISFORM.A133ChqCli = Aux1
               THISFORM.A134ChqCli = Aux2
               GX_rploop = .T.
               THISFORM.A135ChqCli = X1350
               GX_SFLOAD = 0
               THISFORM.U13VTR2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10712) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10712 = Gx_err
               THISFORM.GX_DB_GetW10712_01 ()
            ENDDO
         ENDIF
      ENDPROC
