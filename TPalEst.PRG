               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04016) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04017" , @HStmt_T04017 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPALEST","T04017","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04017) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [PalEst]  WHERE [PalEstId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04017,cmdbuf)
                  THISFORM.GX_DB_BindParmT04017_01 ()
               ENDIF
               AuxA3766PalEs = THISFORM.A3766PalEs
               Gx_err = GX_DB_SetInt( HStmt_T04017,1,@AuxA3766PalEs,0)
               THISFORM.A3766PalEs = AuxA3766PalEs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T04017) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T04017 = Gx_err
               THISFORM.T04012 = iif( THISFORM.T04017 = 0 , 104 , THISFORM.T04017 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04017) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 423 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
