      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 423
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT401A3766 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 423
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3766PalEs = THISFORM.A3766PalEs
                  Gx_err = GX_DB_SetInt( HStmt_T04013,1,@AuxA3766PalEs,0)
                  THISFORM.A3766PalEs = AuxA3766PalEs
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T04013) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T04013 = Gx_err
                  THISFORM.GX_DB_GetT04013_01 ()
                  THISFORM. cCT401A3766 . ZMB5423 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCB5423 ()
               THISFORM. cCT401A3766 . ZMB5423 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCB5423 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT401A3771 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEB5423 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCB5423 ()
                  RETURN
               ENDIF
               THISFORM.cCT401A3766.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04013) , "TPALEST" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04012) , "TPALEST" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT401A3771 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT401A3766 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

