***********************
PROCEDURE U115P3
***********************

   * 'TESCYP' Routine
   LEVEL4 = .T.
   DO GX_CSC01
   IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R02053" , @HStmt_R02053 )
      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RLISPACN","R02053","",GX_CURSOR_TYPE_READONLY,@HStmt_R02053) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT [TesLin], [EmpCod], [TesNroI], [TesMedCod], [TesMonCod], [TesImp] FROM [TESCYP] "
      cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? and [TesNroI] = ? ORDER BY [EmpCod], [TesNroI], [TesLin] "
      cmdbuf = cmdbuf + "   "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_R02053,cmdbuf)
      Gx_err = GX_DB_Set_StmtFetchSize( HStmt_R02053,100)
      GX_DB_BindColsR02053_01 ()
      GX_DB_BindParmR02053_01 ()
