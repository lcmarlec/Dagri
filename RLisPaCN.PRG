   Gx_err = GX_DB_SetDouble( HStmt_R02053,2,@RV34Dccnro,0)
   Gx_eop = 1
   DO WHILE Gx_eop != 0
      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R02053) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   R02053 = Gx_err
   GX_DB_GetR02053_01 ()
   DO WHILE R02053 <> 101
      R2EmpCod = Buf_R02053_2EmpCod
      R985TesNro = Buf_R02053_985TesNroI
      R989TesMed = Buf_R02053_989TesMedCod
      R1007TesMo = Buf_R02053_1007TesMonCod
      R996TesImp = Buf_R02053_996TesImp
      DO CASE
         CASE R989TesMed = 1 .OR. R989TesMed = 50 .OR. R989TesMed = 101
            DO CASE
               CASE R1007TesMo = 1 .OR. R1007TesMo = 0
                  RV30Import[1] = RV30Import[1] + R996TesImp * RV35Dccsig
               CASE R1007TesMo = 3
                  RV30Import[2] = RV30Import[2] + R996TesImp * RV35Dccsig
               CASE R1007TesMo = 4
                  RV30Import[3] = RV30Import[3] + R996TesImp * RV35Dccsig
               CASE R1007TesMo = 5
                  RV30Import[4] = RV30Import[4] + R996TesImp * RV35Dccsig
               OTHERWISE
                  RV30Import[5] = RV30Import[5] + R996TesImp * RV35Dccsig
            ENDCASE
         CASE R989TesMed = 4 .OR. R989TesMed = 18
            RV30Import[11] = RV30Import[11] + R996TesImp * RV35Dccsig
         CASE R989TesMed = 5 .OR. R989TesMed = 11 .OR. R989TesMed = 60
            RV30Import[12] = RV30Import[12] + R996TesImp * RV35Dccsig
         CASE R989TesMed = 6 .OR. R989TesMed = 13
            RV30Import[13] = RV30Import[13] + R996TesImp * RV35Dccsig
         CASE R989TesMed = 7 .OR. R989TesMed = 14
            RV30Import[14] = RV30Import[14] + R996TesImp * RV35Dccsig
         CASE R989TesMed = 17
            RV30Import[16] = RV30Import[16] + R996TesImp * RV35Dccsig
         CASE R989TesMed = 12 .OR. R989TesMed = 44
            RV30Import[17] = RV30Import[17] + R996TesImp * RV35Dccsig
         OTHERWISE
      ENDCASE
      RV30Import[15] = RV30Import[15] + R996TesImp * RV35Dccsig
      * Check if program is canceled.
      IF gxPrnObj.GxIsAliveDoc( GxHDC ) = 0
         UserCancel = .T.
      ENDIF
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R02053) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R02053 = Gx_err
      GX_DB_GetR02053_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R02053) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL4 = .F.
RETURN

