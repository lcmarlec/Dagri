      PROCEDURE CreateTemp
         LOCAL SCW25S16
         SCW25S16 = ""
         IF USED( "SCW25S16" )
            SELECT SCW25S16
            SCW25S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW25S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA76BcoCta"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA78BcoSuc"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA79BcoDir"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA80BcoAut"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA81BcoNro"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW25S16 = GETE('z:\temp') + '\' + SCW25S16
            ENDIF
            CREATE DBF (SCW25S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW25S16) EXCLUSIVE ALIAS SCW25S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW25S16
         THIS.GX_SfAlias = "SCW25S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00252" , @HStmt_W00252 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCTAS","W00252","",GX_CURSOR_TYPE_READONLY,@HStmt_W00252) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [BcoCod], [BcoNroUlt], [BcoAut], [BcoDir], [BcoSuc], [BcoCta] FROM [CTAS] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE [BcoCod] = ? ORDER BY [BcoCta]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00252,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00252,14)
                  THISFORM.GX_DB_BindColsW00252_01 ()
                  THISFORM.GX_DB_BindParmW00252_01 ()
               ENDIF
               AuxAV14Bcocod = THISFORM.AV14Bcocod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00252,1,@AuxAV14Bcocod,0)
               THISFORM.AV14Bcocod = AuxAV14Bcocod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00252 = Gx_err
               THISFORM.GX_DB_GetW00252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV19Pgmnam = "WCtas"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00252 = Gx_err
                  THISFORM.GX_DB_GetW00252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00252 <> 101
               BRKV0P2 = .F.
               THISFORM.A86BcoCod = THISFORM.Buf_W00252_86BcoCod
               THISFORM.A81BcoNroU = THISFORM.Buf_W00252_81BcoNroUlt
               THISFORM.A80BcoAut = THISFORM.Buf_W00252_80BcoAut
               THISFORM.A79BcoDir = THISFORM.Buf_W00252_79BcoDir
               THISFORM.A78BcoSuc = THISFORM.Buf_W00252_78BcoSuc
               THISFORM.A76BcoCta = THISFORM.Buf_W00252_76BcoCta
               GX_SFLOAD = 0
               THISFORM.U17V0P2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00252 = Gx_err
               THISFORM.GX_DB_GetW00252_01 ()
            ENDDO
         ENDIF
      ENDPROC
