                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKPLANT","W09292","",GX_CURSOR_TYPE_READONLY,@HStmt_W09292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PlaDsc], [PlaCod], [EmpCod] FROM [PLANTA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND ([PlaDsc] like ?) ORDER BY [EmpCod], [PlaCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09292,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09292,14)
                  THISFORM.GX_DB_BindColsW09292_01 ()
                  THISFORM.GX_DB_BindParmW09292_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09292,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09292,2,PADR( TRIM(THISFORM.AV22Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV22Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09292 = Gx_err
               THISFORM.GX_DB_GetW09292_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WSkPlant"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09292 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09292) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09292 = Gx_err
                  THISFORM.GX_DB_GetW09292_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09292 <> 101
               BRKVPT2 = .F.
               THISFORM.A2733PlaDs = THISFORM.Buf_W09292_2733PlaDsc
               THISFORM.A2732PlaCo = THISFORM.Buf_W09292_2732PlaCod
               THISFORM.A2EmpCod = THISFORM.Buf_W09292_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U15VPT2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09292 = Gx_err
               THISFORM.GX_DB_GetW09292_01 ()
            ENDDO
         ENDIF
      ENDPROC
