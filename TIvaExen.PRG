      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03718" , @HStmt_T03718 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TIVAEXEN","T03718","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03718) ,  ,  ,  , CS_SQLSRV , 0 )
