                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03718,cmdbuf)
                  THISFORM.GX_DB_BindParmT03718_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03718,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T03718,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03718) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03718 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03718) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03718 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03719" , @HStmt_T03719 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TIVAEXEN","T03719","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03719) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [IBESP]  WHERE [EmpCod] = ? AND [EntCui] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03719,cmdbuf)
                  THISFORM.GX_DB_BindParmT03719_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03719,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T03719,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03719) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03719 = Gx_err
               THISFORM.T03714 = iif( THISFORM.T03719 = 0 , 104 , THISFORM.T03719 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03719) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
