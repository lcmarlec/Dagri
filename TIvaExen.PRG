               DO GX_ERRMW WITH "IBESP reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03714 = 101
               DO GX_ERRMW WITH "IBESP fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
