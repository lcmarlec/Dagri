         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2538IBEPo"
            THISFORM.A2538IBEPo = THISFORM.Buf_T037113_2538IBEPor
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2537IBEHt"
            THISFORM.A2537IBEHt = THISFORM.Buf_T037113_2537IBEHta
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3470IBExe"
            THISFORM.A3470IBExe = THISFORM.Buf_T037113_3470IBExe
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3471IBObs"
            THISFORM.A3471IBObs = THISFORM.Buf_T037113_3471IBObs
         ENDIF
