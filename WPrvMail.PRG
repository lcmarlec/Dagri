      ***********************
      PROCEDURE U17VXL2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'ID'" )
         * 'ID' Routine
         THISFORM.AV21Entmid = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12093" , @HStmt_W12093 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPRVMAIL","W12093","",GX_CURSOR_TYPE_READONLY,@HStmt_W12093) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntMail], [EntMId] FROM [CLTEMAIL] (FASTFIRSTROW "
            cmdbuf = cmdbuf + "  NOLOCK) WHERE [EmpCod] = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], "
            cmdbuf = cmdbuf + "  [EntGruTip], [EntCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12093,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12093,8)
            THISFORM.GX_DB_BindColsW12093_01 ()
            THISFORM.GX_DB_BindParmW12093_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12093,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA150EntGru = THISFORM.A150EntGru
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12093,2,AuxA150EntGru,2,0)
         THISFORM.A150EntGru = AuxA150EntGru
         AuxA120EntCod = THISFORM.A120EntCod
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12093,3,@AuxA120EntCod,0)
         THISFORM.A120EntCod = AuxA120EntCod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12093) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W12093 = Gx_err
         THISFORM.GX_DB_GetW12093_01 ()
         DO WHILE THISFORM.W12093 <> 101
            THISFORM.A3225EntMa = THISFORM.Buf_W12093_3225EntMail
            THISFORM.A3223EntMI = THISFORM.Buf_W12093_3223EntMId
            THISFORM.AV21Entmid = THISFORM.A3223EntMI
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12093) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W12093 = Gx_err
            THISFORM.GX_DB_GetW12093_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W12093) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.AV21Entmid = THISFORM.AV21Entmid + 1
         THISFORM.EndEvent()
      ENDPROC

