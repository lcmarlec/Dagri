      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12092" , @HStmt_W12092 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPRVMAIL","W12092","",GX_CURSOR_TYPE_READONLY,@HStmt_W12092) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[EntGruTip], T1.[EntCod], T1.[EntMail], T1.[EntMCon], T1.[EntMTpo], "
                  cmdbuf = cmdbuf + "  T1.[EntMId], T2.[EntRaz] FROM ([CLTEMAIL] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[EntCod]) WHERE T1.[EmpCod] = ? and T1.[EntGruTip] = ? and T1.[EntCod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[EntGruTip], T1.[EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12092,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12092,8)
                  THISFORM.GX_DB_BindColsW12092_01 ()
                  THISFORM.GX_DB_BindParmW12092_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12092,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12092,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12092,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12092 = Gx_err
               THISFORM.GX_DB_GetW12092_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WPrvMail"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12092 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12092) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12092 = Gx_err
                  THISFORM.GX_DB_GetW12092_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12092 <> 101
               BRKVXL2 = .F.
               THISFORM.A3225EntMa = THISFORM.Buf_W12092_3225EntMail
               THISFORM.A3224EntMC = THISFORM.Buf_W12092_3224EntMCon
               THISFORM.A3304EntMT = THISFORM.Buf_W12092_3304EntMTpo
               THISFORM.A3223EntMI = THISFORM.Buf_W12092_3223EntMId
               THISFORM.A153EntRaz = THISFORM.Buf_W12092_153EntRaz
               THISFORM.A153EntRaz = THISFORM.Buf_W12092_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U16VXL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12092 = Gx_err
               THISFORM.GX_DB_GetW12092_01 ()
            ENDDO
         ENDIF
      ENDPROC
