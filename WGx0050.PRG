      PROCEDURE CreateTemp
         LOCAL SCW178S20
         SCW178S20 = ""
         IF USED( "SCW178S20" )
            SELECT SCW178S20
            SCW178S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW178S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA54AudLot"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA58AudArt"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW178S20 = GETE('z:\temp') + '\' + SCW178S20
            ENDIF
            CREATE DBF (SCW178S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW178S20) EXCLUSIVE ALIAS SCW178S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW178S20
         THIS.GX_SfAlias = "SCW178S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01782" , @HStmt_W01782 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0050","W01782","",GX_CURSOR_TYPE_READONLY,@HStmt_W01782) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AudArtUsu], [AudArtFch], [AudLugCod], [AudPrvCod], [AudArtHora], [AudLotNro], "
                  cmdbuf = cmdbuf + "  [ArtCod], [FamSubCod], [FamCod], [EmpCod] FROM [AUDSTK] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([EmpCod] >= ? and [FamCod] >= ? and [FamSubCod] >= ? and [ArtCod] >= ?) AND ([AudLotNro] "
                  cmdbuf = cmdbuf + "  like ?) AND ([AudPrvCod] >= ?) AND ([AudLugCod] >= ?) ORDER BY [EmpCod], [FamCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod], [ArtCod], [AudLotNro], [AudPrvCod], [AudLugCod], [AudArtFch], [AudArtHora], "
                  cmdbuf = cmdbuf + "  [AudArtUsu]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01782,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01782,9)
                  THISFORM.GX_DB_BindColsW01782_01 ()
                  THISFORM.GX_DB_BindParmW01782_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01782,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01782,2,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01782,3,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               AuxAV8C5 = THISFORM.AV8C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01782,4,@AuxAV8C5,0)
               THISFORM.AV8C5 = AuxAV8C5
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01782,5,PADR( TRIM(THISFORM.AV9C54),10, '%'),LEN(PADR( TRIM(THISFORM.AV9C54),10, '%')),0)
               AuxAV10C55 = THISFORM.AV10C55
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01782,6,@AuxAV10C55,0)
               THISFORM.AV10C55 = AuxAV10C55
               AuxAV11C56 = THISFORM.AV11C56
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01782,7,@AuxAV11C56,0)
               THISFORM.AV11C56 = AuxAV11C56
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01782) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01782 = Gx_err
               THISFORM.GX_DB_GetW01782_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01782 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01782) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01782 = Gx_err
                  THISFORM.GX_DB_GetW01782_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01782 <> 101
               BRKV4Y2 = .F.
               THISFORM.A59AudArtU = THISFORM.Buf_W01782_59AudArtUsu
               THISFORM.A57AudArtF = THISFORM.Buf_W01782_57AudArtFch
               THISFORM.A56AudLugC = THISFORM.Buf_W01782_56AudLugCod
               THISFORM.A55AudPrvC = THISFORM.Buf_W01782_55AudPrvCod
               THISFORM.A58AudArtH = THISFORM.Buf_W01782_58AudArtHora
               THISFORM.A54AudLotN = THISFORM.Buf_W01782_54AudLotNro
               THISFORM.A5ArtCod = THISFORM.Buf_W01782_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01782_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01782_3FamCod
               THISFORM.A2EmpCod = THISFORM.Buf_W01782_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V4Y2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01782) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01782 = Gx_err
               THISFORM.GX_DB_GetW01782_01 ()
            ENDDO
         ENDIF
      ENDPROC
