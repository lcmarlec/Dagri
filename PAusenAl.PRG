               cmdbuf = cmdbuf + "  ?, ?, ?, ?, ?, ?, ?, ?, convert(int, 0), ' ', convert(int, 0), convert(int, 0), "
               cmdbuf = cmdbuf + "  convert(int, 0), ' ', ' ', convert(int, 0), convert(int, 0), ' ', ' ', convert(int, "
               cmdbuf = cmdbuf + "  0), ' ', ' ', ' ', ' ', convert(int, 0), ' ', convert(int, 0), convert( DATETIME, "
               cmdbuf = cmdbuf + "  '17530101', 112 ), convert( DATETIME, '17530101', 112 ), ' ', ' ', ' ', convert(int, "
               cmdbuf = cmdbuf + "  0), convert(int, 0)) "
