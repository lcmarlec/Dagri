               GX_DB_BindParmP07305_01 ()
            ENDIF
            Gx_err = GX_DB_SetInt( HStmt_P07305,1,@R2EmpCod,0)
            Gx_err = GX_DB_SetLong( HStmt_P07305,2,@R561TraCod,0)
            Gx_err = GX_DB_SetStr( HStmt_P07305,3,R2266CAuCo,4,0)
            Gx_err = GX_DB_SetDate( HStmt_P07305,4,@R2272AusFc,0)
            Gx_err = GX_DB_SetStr( HStmt_P07305,5,R2273AusOb,9000,0)
            Gx_err = GX_DB_SetDouble( HStmt_P07305,6,@R2274AusCn,0)
            Gx_err = GX_DB_SetDouble( HStmt_P07305,7,@R2275AusVa,0)
            Gx_err = GX_DB_SetInt( HStmt_P07305,8,@R2279Auste,0)
            Gx_err = GX_DB_SetStr( HStmt_P07305,9,R2511AusOb,100,0)
            Gx_err = GX_DB_SetInt( HStmt_P07305,10,@R2309CauOr,0)
            Gx_eop = 1
