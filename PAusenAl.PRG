            ENDDO
            P07305 = Gx_err
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P07305) ,  ,  ,  , CS_SQLSRV ,  )
            IF P07305 = 1
               Gx_err = 1
               Gx_emsg = "Ya existe el registro"
            ELSE
               Gx_err = 0
               Gx_emsg = ""
            ENDIF
            R2EmpCod = W2EmpCod
            * End Insert
            LEVEL5 = .F.
            RV20Audobs = "Alta  " + AV9Caucod + "      "
            RV21Numero = "Legajo:" + str( R561TraCod , 6 ) + " Fecha " + GXDTOC( RV19Fecha )
            DO PAuditor WITH "MAES" , AV11Emprco , "AUSENTI" , RV21Numero , "INS" , RV20Audobs , AV14Usuari
         ENDIF
         R2EmpCod = W2EmpCod
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_P07303) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P07303 = Gx_err
         GX_DB_GetP07303_01 ()
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P07303) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL3 = .F.
      RV19Fecha = RV19Fecha + 1
      IF UserCancel
