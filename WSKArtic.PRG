               AuxAV18Artcod = THISFORM.AV18Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01422,8,@AuxAV18Artcod,0)
               THISFORM.AV18Artcod = AuxAV18Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01422) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01422 = Gx_err
               THISFORM.GX_DB_GetW01422_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV21Pgmnam = "WSKArtic"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01422 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01422) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01422 = Gx_err
                  THISFORM.GX_DB_GetW01422_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01422 <> 101
               BRKV3Y2 = .F.
               THISFORM.A1461ArtCo = THISFORM.Buf_W01422_1461ArtCodS
               THISFORM.A1463FamSu = THISFORM.Buf_W01422_1463FamSubCodS
               THISFORM.A1462FamCo = THISFORM.Buf_W01422_1462FamCodS
               THISFORM.A28ArtVta = THISFORM.Buf_W01422_28ArtVta
               THISFORM.A24ArtCpr = THISFORM.Buf_W01422_24ArtCpr
               THISFORM.A1460ArtIn = THISFORM.Buf_W01422_1460ArtInhab
               THISFORM.A6ArtDsc = THISFORM.Buf_W01422_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W01422_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01422_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01422_3FamCod
               GX_SFLOAD = 0
               THISFORM.U14V3Y2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01422) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01422 = Gx_err
               THISFORM.GX_DB_GetW01422_01 ()
            ENDDO
         ENDIF
      ENDPROC
