                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01728) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01728 = Gx_err
               THISFORM.T01722 = iif( THISFORM.T01728 = 0 , 104 , THISFORM.T01728 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01728) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 203 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.U134S2 ()
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
