      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06042" , @HStmt_W06042 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOCOAUT","W06042","",GX_CURSOR_TYPE_READONLY,@HStmt_W06042) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[OcoEntGruT] AS OcoEntGruT, T1.[OCoNroInt], T1.[OcoAutHor], "
                  cmdbuf = cmdbuf + "  T1.[OcoAutFch], T1.[OCoEst], T1.[OCoSuc], T1.[OcoAut], T2.[EntRaz] AS OcoEntRaz, "
                  cmdbuf = cmdbuf + "  T1.[OcoEntCod] AS OcoEntCod, T1.[OcoTip], T1.[OCoFch], T1.[OCoNro] FROM ([OCOMPN] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[OcoEntGruT] AND T2.[EntCod] = T1.[OcoEntCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OCoEst] >= 0 and T1.[OCoSuc] = 0 and T1.[OCoNro] > 0) AND (T1.[OCoNro] "
                  cmdbuf = cmdbuf + "  >= ? and T1.[OCoNro] <= ?) AND (T1.[OCoFch] >= ? and T1.[OCoFch] <= ?) AND (T1.[OCoEst] "
                  cmdbuf = cmdbuf + "  = ? or ( T1.[OCoEst] < 3 and ? = 3) or ? = 8) AND (T1.[OcoEntCod] = ? or ? = 0) "
                  cmdbuf = cmdbuf + "  AND (T1.[OcoTip] = ? or ? = 'T') AND (( (T1.[OcoAut] = ' ') and ? = 0) or ( Not "
                  cmdbuf = cmdbuf + "  (T1.[OcoAut] = ' ') and ? = 1)) ORDER BY T1.[EmpCod], T1.[OCoEst], T1.[OCoSuc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06042,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06042,13)
                  THISFORM.GX_DB_BindColsW06042_01 ()
                  THISFORM.GX_DB_BindParmW06042_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06042,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV14Desnro = THISFORM.AV14Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06042,2,@AuxAV14Desnro,0)
               THISFORM.AV14Desnro = AuxAV14Desnro
               AuxAV21Hasnro = THISFORM.AV21Hasnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06042,3,@AuxAV21Hasnro,0)
