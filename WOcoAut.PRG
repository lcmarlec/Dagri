               THISFORM.A685OcoEnt = THISFORM.Buf_W06042_685OcoEntRaz
               GX_SFLOAD = 0
               THISFORM.U20VGS2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06042) ,  ,  ,  , CS_SQLSRV ,  )
