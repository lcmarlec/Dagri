               AuxAV24Ocoest = THISFORM.AV24Ocoest
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06042,6,@AuxAV24Ocoest,0)
               THISFORM.AV24Ocoest = AuxAV24Ocoest
               AuxAV24Ocoest = THISFORM.AV24Ocoest
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06042,7,@AuxAV24Ocoest,0)
               THISFORM.AV24Ocoest = AuxAV24Ocoest
               AuxAV24Ocoest = THISFORM.AV24Ocoest
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06042,8,@AuxAV24Ocoest,0)
               THISFORM.AV24Ocoest = AuxAV24Ocoest
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06042,9,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06042,10,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV20Ocotip = THISFORM.AV20Ocotip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06042,11,AuxAV20Ocotip,1,0)
               THISFORM.AV20Ocotip = AuxAV20Ocotip
               AuxAV20Ocotip = THISFORM.AV20Ocotip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06042,12,AuxAV20Ocotip,1,0)
               THISFORM.AV20Ocotip = AuxAV20Ocotip
               AuxAV25Autori = THISFORM.AV25Autori
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06042,13,@AuxAV25Autori,0)
               THISFORM.AV25Autori = AuxAV25Autori
