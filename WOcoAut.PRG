      ***********************
      PROCEDURE U16VGS2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'CONFIRMAR'" )
         * 'confirmar' Routine
         IF THISFORM.AV27Nivel < 1
            DO GX_ERRMW WITH "No tiene Permiso para Autorizar O/C"
         ELSE
            THISFORM.AV28Hora = SUBSTR(TIME(), 1, 8)
            Response = .T.
            DO GX_CONFW WITH 'Confirma Autorizacion de O/C Seleccionadas ?' , Response
            IF Response
               LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
               GX_SFERR = 0
               Gx_fel_sel = .T.
               gxO_Rec = 0
               SELECT( THISFORM.cCW604S11 .GX_SfAlias)
               gxO_Rec1 = IIF(EOF(), 0, RECNO())
               THISFORM.cCW604S11.SF (8, @GX_SFERR)
               DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
                  THISFORM.cCW604S11.SF (3, @GX_SFERR)
                  THISFORM.cCW604S11 .SaveGridPos()
                  IF THISFORM.AV26Sel = 1
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.A2EmpCod
                     Aux1 = THISFORM.A682OCoNro
                     Aux2 = THISFORM.AV16Usuari
                     Aux3 = THISFORM.AV6Fechasi
                     Aux4 = THISFORM.AV28Hora
                     DO POcoAut WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4
                     THISFORM.A2EmpCod = Aux0
                     THISFORM.A682OCoNro = Aux1
                     THISFORM.AV16Usuari = Aux2
                     THISFORM.AV6Fechasi = Aux3
                     THISFORM.AV28Hora = Aux4
                     THISFORM. cCW604S11 .RestoreGridPos()
                     GX_rploop = .T.
                  ENDIF
                  IF Gx_fel_sel
                     THISFORM.cCW604S11 .RestoreGridPos()
                     THISFORM.cCW604S11.SF (4, @GX_SFERR)
                     THISFORM.cCW604S11.SF (9, @GX_SFERR)
                  ENDIF
               ENDDO
               THISFORM.cCW604S11 .ResetSavedGridPos()
               SELECT( THISFORM.cCW604S11 .GX_SfAlias)
               IF gxO_Rec1 != 0
                  GOTO (gxO_Rec1)
                  THISFORM.cCW604S11.SF (3, @GX_SFERR)
               ENDIF
               THISFORM.GX_Refresh = 1   &&& Refresh
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

