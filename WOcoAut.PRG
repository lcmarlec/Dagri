               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06042,14,@AuxAV25Autori,0)
               THISFORM.AV25Autori = AuxAV25Autori
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06042 = Gx_err
               THISFORM.GX_DB_GetW06042_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV34Pgmnam = "WOcoAut"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06042 = 101
