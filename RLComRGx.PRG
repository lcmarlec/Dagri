         Gxline = Gxline + "<td>" + str( R166EntCui , 11 ) + "</td><td>" + str( RV21Opanro , 8 ) + "</td><td>" + str( R958RetTot , 10 , 2 ) + "</td></tr>"
         * User Code
         fputs(gxArch, gxline)
         RV19Total = RV19Total + R958RetTot
      ELSE
         Gxline = "<tr><td>" + GXDTOC( R938RetFch ) + "</td><td>" + R945RetSer + "</td><td>" + str( R947RetNro , 8 ) + "</td><td>" + "Anulada" + "</td><td>" + str( RV21Opanro , 8 ) + "</td></tr>"
         * User Code
         fputs(gxArch, gxline)
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R05582) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R05582 = Gx_err
      GX_DB_GetR05582_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R05582) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   * User Code
   fclose(gxArch)
   RV22E = opendocument( Gxarchivo )
   DO EPFI0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

