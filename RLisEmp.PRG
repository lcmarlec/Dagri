***********************
PROCEDURE U12N22
***********************

   * 'CTA' Routine
   RV71GXLvl1 = 0
   LEVEL3 = .T.
   DO GX_CSC01
   IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R08303" , @HStmt_R08303 )
      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RLISEMP","R08303","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_R08303) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT [BcoCta], [BcoCtaNro] FROM [CTAS] (NOLOCK) WHERE [BcoCta] = ? ORDER BY [BcoCta] "
      cmdbuf = cmdbuf + "   "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_R08303,cmdbuf)
      GX_DB_BindColsR08303_01 ()
      GX_DB_BindParmR08303_01 ()
   ENDIF
   Gx_err = GX_DB_SetInt( HStmt_R08303,1,@RV65Tractv,0)
   Gx_eop = 1
   DO WHILE Gx_eop != 0
      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R08303) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   R08303 = Gx_err
   GX_DB_GetR08303_01 ()
   DO WHILE R08303 <> 101
      R76BcoCta = Buf_R08303_76BcoCta
      R77BcoCtaN = Buf_R08303_77BcoCtaNro
      RV71GXLvl1 = 1
      RV66Bcocta = R77BcoCtaN
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      * Exiting from a For First loop.
      EXIT
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08303) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL3 = .F.
   IF RV71GXLvl1 = 0
      RV66Bcocta = SPACE(12)
   ENDIF
RETURN
