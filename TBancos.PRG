            THISFORM.A82BcoFDe = THIS.Column1.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 2
            THISFORM.A83BcoFHa = THIS.Column2.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 3
            THISFORM.A84BcoMax = THIS.Column3.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 4
            THISFORM.A85BcoSld = THIS.Column4.Ctrl1.Value
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
