         THISFORM.A82BcoFDe = CTOD("  /  /  ")
         THISFORM.A83BcoFHa = CTOD("  /  /  ")
         THISFORM.A84BcoMax = 0.00
         THISFORM.A85BcoSld = 0.00
         THIS.SaveTemp()
