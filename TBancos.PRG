               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T001013) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T001013 = Gx_err
                  THISFORM.GX_DB_GetT001013_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T001013 <> 101
               BRK0A8 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT10S22.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T001013) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T001013 = Gx_err
               THISFORM.GX_DB_GetT001013_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A82BcoFDe"
            THISFORM.A82BcoFDe = THISFORM.Buf_T001013_82BcoFDe
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A83BcoFHa"
            THISFORM.A83BcoFHa = THISFORM.Buf_T001013_83BcoFHa
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A84BcoMax"
            THISFORM.A84BcoMax = THISFORM.Buf_T001013_84BcoMax
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A85BcoSld"
            THISFORM.A85BcoSld = THISFORM.Buf_T001013_85BcoSld
         ENDIF
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA82BcoFDe WITH THISFORM.A82BcoFDe
         REPLACE sA83BcoFHa WITH THISFORM.A83BcoFHa
         REPLACE sA84BcoMax WITH THISFORM.A84BcoMax
         REPLACE sA85BcoSld WITH THISFORM.A85BcoSld
