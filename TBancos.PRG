               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCT10S22 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCT10S22 .gx_can_changerow = .T.
