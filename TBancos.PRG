                  THISFORM.GX_DB_BindColsT001013_01 ()
                  THISFORM.GX_DB_BindParmT001013_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T001013,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
