            THISFORM.SetLevel( 8 )
            THISFORM.SetMode("", "N" )
            THISFORM. cCT10S22.Columns(1).Ctrl1 .InitLevel( 8 )
            THISFORM.GX_last_fld_lvl = 8
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A85BcoSld"
         THISFORM.cCT10S22 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCT10S22 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCT10S22 .GX_lastkey = 9.or. THISFORM.cCT10S22 .GX_lastkey = 13)
