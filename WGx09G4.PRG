      PROCEDURE CreateTemp
         LOCAL SCW973S20
         SCW973S20 = ""
         IF USED( "SCW973S20" )
            SELECT SCW973S20
            SCW973S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW973S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2954LprI"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2955ArtL"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 11
            GX_STRUCT[ 5 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW973S20 = GETE('z:\temp') + '\' + SCW973S20
            ENDIF
            CREATE DBF (SCW973S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW973S20) EXCLUSIVE ALIAS SCW973S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW973S20
         THIS.GX_SfAlias = "SCW973S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09732" , @HStmt_W09732 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09G4","W09732","",GX_CURSOR_TYPE_READONLY,@HStmt_W09732) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [lprfch], [ArtLprPrc], [ArtCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [FamCod], [LprInd] FROM [LPRVENT1] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  [EntGruTip] = ? and [EntCod] = ? and [lprfch] = ? and [LprInd] >= ? and [FamCod] "
                  cmdbuf = cmdbuf + "  >= ? and [FamSubCod] >= ? ORDER BY [EmpCod], [EntGruTip], [EntCod], [lprfch], [LprInd], "
                  cmdbuf = cmdbuf + "  [FamCod], [FamSubCod], [ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09732,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09732,9)
                  THISFORM.GX_DB_BindColsW09732_01 ()
                  THISFORM.GX_DB_BindParmW09732_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09732,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09732,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09732,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA2953lprfc = THISFORM.A2953lprfc
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09732,4,@AuxA2953lprfc,0)
               THISFORM.A2953lprfc = AuxA2953lprfc
               AuxAV5C2954 = THISFORM.AV5C2954
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09732,5,@AuxAV5C2954,0)
               THISFORM.AV5C2954 = AuxAV5C2954
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09732,6,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09732,7,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09732 = Gx_err
               THISFORM.GX_DB_GetW09732_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09732 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09732) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09732 = Gx_err
                  THISFORM.GX_DB_GetW09732_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09732 <> 101
               BRKVR12 = .F.
               THISFORM.A2955ArtLp = THISFORM.Buf_W09732_2955ArtLprPrc
               THISFORM.A5ArtCod = THISFORM.Buf_W09732_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W09732_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W09732_3FamCod
               THISFORM.A2954LprIn = THISFORM.Buf_W09732_2954LprInd
               GX_SFLOAD = 0
               THISFORM.U12VR12 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09732 = Gx_err
               THISFORM.GX_DB_GetW09732_01 ()
            ENDDO
         ENDIF
      ENDPROC
