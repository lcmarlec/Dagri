               THISFORM.GX_DB_GetW02892_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WNDP01"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02892 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02892) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02892 = Gx_err
                  THISFORM.GX_DB_GetW02892_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02892 <> 101
               BRKV812 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W02892_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W02892_2EmpCod
               THISFORM.A380TdcNro = THISFORM.Buf_W02892_380TdcNroInt
               THISFORM.A386TdcGru = THISFORM.Buf_W02892_386TdcGruCod
               THISFORM.A383TdcSer = THISFORM.Buf_W02892_383TdcSer
               THISFORM.A1595TdcAO = THISFORM.Buf_W02892_1595TdcAObs
               THISFORM.A2165Tdc2D = THISFORM.Buf_W02892_2165Tdc2Desc
               THISFORM.A394TdcPrc = THISFORM.Buf_W02892_394TdcPrcFc
               THISFORM.A393TdcCnt = THISFORM.Buf_W02892_393TdcCntFc
               THISFORM.A391TDcArt = THISFORM.Buf_W02892_391TDcArtDsc
               THISFORM.A390TDcArt = THISFORM.Buf_W02892_390TDcArtCod
               THISFORM.A389TDcFam = THISFORM.Buf_W02892_389TDcFamSubC
               THISFORM.A388TDcFam = THISFORM.Buf_W02892_388TDcFamCod
               THISFORM.A387TdcFV = THISFORM.Buf_W02892_387TdcFV
               THISFORM.A385TdcNro = THISFORM.Buf_W02892_385TdcNro
               THISFORM.A384TdcSuc = THISFORM.Buf_W02892_384TdcSuc
               THISFORM.A382TdcTip = THISFORM.Buf_W02892_382TdcTip
               THISFORM.A381TdcFec = THISFORM.Buf_W02892_381TdcFec
               THISFORM.A153EntRaz = THISFORM.Buf_W02892_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W02892_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W02892_150EntGruTip
               THISFORM.A386TdcGru = THISFORM.Buf_W02892_386TdcGruCod
               THISFORM.A383TdcSer = THISFORM.Buf_W02892_383TdcSer
               THISFORM.A387TdcFV = THISFORM.Buf_W02892_387TdcFV
               THISFORM.A385TdcNro = THISFORM.Buf_W02892_385TdcNro
               THISFORM.A384TdcSuc = THISFORM.Buf_W02892_384TdcSuc
               THISFORM.A382TdcTip = THISFORM.Buf_W02892_382TdcTip
               THISFORM.A381TdcFec = THISFORM.Buf_W02892_381TdcFec
               THISFORM.A120EntCod = THISFORM.Buf_W02892_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W02892_153EntRaz
               THISFORM.A391TDcArt = THISFORM.Buf_W02892_391TDcArtDsc
               THISFORM.A396TdcTot = THISFORM.A393TdcCnt * ( THISFORM.A394TdcPrc - THISFORM.A394TdcPrc * THISFORM.A2165Tdc2D / 100 )
               GX_SFLOAD = 0
               THISFORM.U15V812 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02892) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02892 = Gx_err
               THISFORM.GX_DB_GetW02892_01 ()
            ENDDO
         ENDIF
