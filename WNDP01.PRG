                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WNDP01","W02892","",GX_CURSOR_TYPE_READONLY,@HStmt_W02892) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntGruTip], T1.[EmpCod], T1.[TdcNroInt], T2.[TdcGruCod], T2.[TdcSer], "
                  cmdbuf = cmdbuf + "  T1.[TdcAObs], T1.[Tdc2Desc], T1.[TdcPrcFc], T1.[TdcCntFc], T4.[ArtDsc] AS TDcArtDsc, "
                  cmdbuf = cmdbuf + "  T1.[TDcArtCod] AS TDcArtCod, T1.[TDcFamSubC] AS TDcFamSubC, T1.[TDcFamCod] AS TDcFamCod, "
                  cmdbuf = cmdbuf + "  T2.[TdcFV], T2.[TdcNro], T2.[TdcSuc], T2.[TdcTip], T2.[TdcFec], T3.[EntRaz], T2.[EntCod] "
                  cmdbuf = cmdbuf + "  FROM ((([DCOI02] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [TDCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[TdcNroInt] = T1.[TdcNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T2.[EntGruTip] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T2.[EntCod]) LEFT JOIN [ARTICS] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[FamCod] "
                  cmdbuf = cmdbuf + "  = T1.[TDcFamCod] AND T4.[FamSubCod] = T1.[TDcFamSubC] AND T4.[ArtCod] = T1.[TDcArtCod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[TdcNroInt] = ? ORDER BY T1.[EmpCod], T1.[TdcNroInt], "
                  cmdbuf = cmdbuf + "  T1.[TDcFamCod], T1.[TDcFamSubC], T1.[TDcArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02892,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02892,13)
                  THISFORM.GX_DB_BindColsW02892_01 ()
                  THISFORM.GX_DB_BindParmW02892_01 ()
               ENDIF
               AuxAV11Emprco = THISFORM.AV11Emprco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02892,1,@AuxAV11Emprco,0)
               THISFORM.AV11Emprco = AuxAV11Emprco
