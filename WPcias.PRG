         THISFORM. cCW116S21 .RestoreGridPos()
         GX_rploop = .T.
         IF THISFORM.AV18Nivel < 4
            THISFORM.cCW116B8.Enabled = 0
         ENDIF
         IF THISFORM.AV18Nivel < 3
