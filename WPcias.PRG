      PROCEDURE CreateTemp
         LOCAL SCW116S21
         SCW116S21 = ""
         IF USED( "SCW116S21" )
            SELECT SCW116S21
            SCW116S21 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW116S21
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA633PciCo"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA634PciDs"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA631PaiCo"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA786PciDG"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA787PciCo"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA785PciIb"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 5
            GX_STRUCT[ 6 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW116S21 = GETE('z:\temp') + '\' + SCW116S21
            ENDIF
            CREATE DBF (SCW116S21) FROM ARRAY GX_STRUCT
            USE
            USE (SCW116S21) EXCLUSIVE ALIAS SCW116S21
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW116S21
         THIS.GX_SfAlias = "SCW116S21"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01162" , @HStmt_W01162 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPCIAS","W01162","",GX_CURSOR_TYPE_READONLY,@HStmt_W01162) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PciIbr], [PciCoU], [PciDGI], [PaiCod], [PciDsc], [PciCod] FROM [PCIAS] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([PciDsc] like ?) AND ([PaiCod] = ?) ORDER BY [PciDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01162,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01162,13)
                  THISFORM.GX_DB_BindColsW01162_01 ()
                  THISFORM.GX_DB_BindParmW01162_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01162,1,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               AuxAV21Paicod = THISFORM.AV21Paicod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01162,2,AuxAV21Paicod,4,0)
               THISFORM.AV21Paicod = AuxAV21Paicod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01162 = Gx_err
               THISFORM.GX_DB_GetW01162_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WPcias"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01162 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01162) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01162 = Gx_err
                  THISFORM.GX_DB_GetW01162_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01162 <> 101
               BRKV382 = .F.
               THISFORM.A785PciIbr = THISFORM.Buf_W01162_785PciIbr
               THISFORM.A787PciCoU = THISFORM.Buf_W01162_787PciCoU
               THISFORM.A786PciDGI = THISFORM.Buf_W01162_786PciDGI
               THISFORM.A631PaiCod = THISFORM.Buf_W01162_631PaiCod
               THISFORM.A634PciDsc = THISFORM.Buf_W01162_634PciDsc
               THISFORM.A633PciCod = THISFORM.Buf_W01162_633PciCod
               GX_SFLOAD = 0
               THISFORM.U19V382 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01162 = Gx_err
               THISFORM.GX_DB_GetW01162_01 ()
            ENDDO
         ENDIF
      ENDPROC
