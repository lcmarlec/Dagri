                  cmdbuf = cmdbuf + "  T1.[DcCRORCnt], T1.[DcCRORPrcO], T2.[DccCotiz], T1.[DccMon], T1.[DcCCnt], T1.[DcCPrc], "
                  cmdbuf = cmdbuf + "  T1.[DcCRORNroI], T4.[DcCRORNro], T4.[DcCRORSuc], T4.[DcCRORTip], T1.[ArtCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[FamCod], T2.[DcCCtaCte], T2.[DccObs], T2.[DcCNet], T2.[DccSer], T2.[DcCFV], "
                  cmdbuf = cmdbuf + "  T2.[DcCNro], T2.[DcCSuc], T2.[DcCTip], T2.[DcCFec], T3.[EntRaz], T2.[EntCod] FROM "
                  cmdbuf = cmdbuf + "  ((([DCCOM2] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[DcCNroInt] = T1.[DcCNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T2.[EntGruTip] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T2.[EntCod]) LEFT JOIN [DCCOM1] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[DcCNroInt] "
                  cmdbuf = cmdbuf + "  = T1.[DcCNroInt] AND T4.[DcCRORNroI] = T1.[DcCRORNroI]) WHERE T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[DcCNroInt] = ? ORDER BY T1.[EmpCod], T1.[DcCNroInt], T1.[FamCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00283,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00283,13)
