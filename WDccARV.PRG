      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW28S22 .GX_SfAlias)
            GO TOP
            THISFORM.cCW28S22 .Refresh()
         ENDIF
         THISFORM. cCW28S22 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW28S22 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
