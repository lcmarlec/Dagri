         SELECT (THIS.GX_SfAlias)
         REPLACE VAV15Fam WITH THISFORM.AV15Fam
         REPLACE VAV16Famsu WITH THISFORM.AV16Famsub
         REPLACE VAV17Artco WITH THISFORM.AV17Artcod
         REPLACE VAV18Artds WITH THISFORM.AV18Artdsc
         REPLACE VAV27Artcn WITH THISFORM.AV27Artcnt
         REPLACE VAV28Artpr WITH THISFORM.AV28Artprc
         REPLACE VAV30Prcpe WITH THISFORM.AV30Prcpes
         REPLACE VAV19Artcn WITH THISFORM.AV19Artcnt
         REPLACE VAV20Artpr WITH THISFORM.AV20Artprc
         REPLACE VAV21Artto WITH THISFORM.AV21Arttot
         REPLACE VAV26Dccro WITH THISFORM.AV26Dccror
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV15Fam = VAV15Fam
         THISFORM.AV16Famsub = VAV16Famsu
         THISFORM.AV17Artcod = VAV17Artco
         THISFORM.AV18Artdsc = VAV18Artds
         THISFORM.AV27Artcnt = VAV27Artcn
         THISFORM.AV28Artprc = VAV28Artpr
         THISFORM.AV30Prcpes = VAV30Prcpe
         THISFORM.AV19Artcnt = VAV19Artcn
         THISFORM.AV20Artprc = VAV20Artpr
         THISFORM.AV21Arttot = VAV21Artto
         THISFORM.AV26Dccror = VAV26Dccro
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 7
            THISFORM.AV30Prcpes = THIS.Column7.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 9
            THISFORM.AV20Artprc = THIS.Column9.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 10
            THISFORM.AV21Arttot = THIS.Column10.Ctrl1.Value
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV15Fam = 0
         THISFORM.AV16Famsub = 0
         THISFORM.AV17Artcod = 0
         THISFORM.AV18Artdsc = SPACE(50)
         THISFORM.AV27Artcnt = 0.0000
         THISFORM.AV28Artprc = 0.0000
         THISFORM.AV30Prcpes = 0.00
         THISFORM.AV19Artcnt = 0.0000
         THISFORM.AV20Artprc = 0.0000
         THISFORM.AV21Arttot = 0.00
         THISFORM.AV26Dccror = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
