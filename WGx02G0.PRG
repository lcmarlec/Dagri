               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05822,4,@AuxAV8C786,0)
               THISFORM.AV8C786 = AuxAV8C786
               AuxAV9C787 = THISFORM.AV9C787
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05822,5,@AuxAV9C787,0)
               THISFORM.AV9C787 = AuxAV9C787
               AuxAV10C1895 = THISFORM.AV10C1895
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05822,6,@AuxAV10C1895,0)
               THISFORM.AV10C1895 = AuxAV10C1895
               AuxAV11C2242 = THISFORM.AV11C2242
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05822,7,@AuxAV11C2242,0)
               THISFORM.AV11C2242 = AuxAV11C2242
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05822 = Gx_err
               THISFORM.GX_DB_GetW05822_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05822 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05822) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05822 = Gx_err
                  THISFORM.GX_DB_GetW05822_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05822 <> 101
               BRKVG62 = .F.
               THISFORM.A787PciCoU = THISFORM.Buf_W05822_787PciCoU
               THISFORM.A1895PciCo = THISFORM.Buf_W05822_1895PciCo2
               THISFORM.A2242PciIb = THISFORM.Buf_W05822_2242PciIbB
               THISFORM.A786PciDGI = THISFORM.Buf_W05822_786PciDGI
               THISFORM.A785PciIbr = THISFORM.Buf_W05822_785PciIbr
               THISFORM.A633PciCod = THISFORM.Buf_W05822_633PciCod
               THISFORM.A631PaiCod = THISFORM.Buf_W05822_631PaiCod
               GX_SFLOAD = 0
               THISFORM.U12VG62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05822 = Gx_err
               THISFORM.GX_DB_GetW05822_01 ()
            ENDDO
         ENDIF
      ENDPROC
