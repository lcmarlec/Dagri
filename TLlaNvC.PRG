      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. AV8Emprcod = PAV8Emprcod
         THISFORM. GX_1Lvl_mode = PGx_mode
         THISFORM. Gx_mode = PGx_mode
         THISFORM. AV27Llanro = PAV27Llanro
         THISFORM. AV22Llaobs = PAV22Llaobs
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV17Usuari = PAV17Usuari
         THISFORM. AV20Ok = PAV20Ok
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02782" , @HStmt_T02782 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLLANVC","T02782","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02782) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [LlaNroI], [LlaFch], [LlaHor], [LlaFchInc], [LlaRecep], [LlaEst], "
            cmdbuf = cmdbuf + "  [LlaEntGru], [LlaTip], [LlaPrd], [LLaNom], [LlaDir], [LlaLoc], [LlaNro], [LlaEntCod], "
            cmdbuf = cmdbuf + "  [LlaentLg], [LlaTel1], [LLaTT1], [LlaTel2], [LlaTT2], [LlaApe], [LlaMarCod], [LlaLote], "
            cmdbuf = cmdbuf + "  [LlaVnc], [LlaLocal], [LlaLinU], [LlaTReCod], [FamCod], [FamSubCod], [ArtCod], [LlaCnt], "
            cmdbuf = cmdbuf + "  [LlaMues], [LlaMedCom], [LlaNotif], [LlaCau], [LlaAcc], [LlaAcP], [LlaACOK], [LlaAcNok], "
            cmdbuf = cmdbuf + "  [LlaAcF], [LlaAcEv], [LlaAPOk], [LlaAPNok], [LlaAPF], [LlaAPEv], [LlaAcSol], [LlaAcSF], "
            cmdbuf = cmdbuf + "  [LlaAcRe], [LlaApSiNo], [LlaApDon], [LlaIno], [LLaEmi], [LlaRes], [LlaAut] FROM "
            cmdbuf = cmdbuf + "  [LLANVO] (UPDLOCK) WHERE [EmpCod] = ? AND [LlaNroI] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02782,cmdbuf)
            THISFORM.GX_DB_BindColsT02782_01 ()
            THISFORM.GX_DB_BindParmT02782_01 ()
