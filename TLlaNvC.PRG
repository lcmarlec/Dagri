            cmdbuf = " SELECT [EmpCod], [LlaNroI], [LlaFch], [LlaHor], [LlaFchInc], [LlaRecep], [LlaEst], "
            cmdbuf = cmdbuf + "  [LlaEntGru], [LlaTip], [LlaPrd], [LLaNom], [LlaDir], [LlaLoc], [LlaNro], [LlaEntCod], "
