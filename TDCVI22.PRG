      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011823" , @HStmt_T011823 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCVI22","T011823","",GX_CURSOR_TYPE_READONLY,@HStmt_T011823) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TDVNroInt], [tDVFLin], [tdvGrv], [tDVFObs], [tDVFImp] FROM [TDVABM1] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [TDVNroInt] = ? ORDER BY [EmpCod], [TDVNroInt], "
                  cmdbuf = cmdbuf + "  [tDVFLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011823,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011823,10)
                  THISFORM.GX_DB_BindColsT011823_01 ()
                  THISFORM.GX_DB_BindParmT011823_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011823,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA473TDVNro = THISFORM.A473TDVNro
               Gx_err = GX_DB_SetDouble( HStmt_T011823,2,@AuxA473TDVNro,0)
               THISFORM.A473TDVNro = AuxA473TDVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011823) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011823 = Gx_err
               THISFORM.GX_DB_GetT011823_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011823 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011823) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011823 = Gx_err
                  THISFORM.GX_DB_GetT011823_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011823 <> 101
               BRK3A67 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT118Tb28.cCT118Pg40Tb28.cCT118S41.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T011823_473TDVNroInt = THISFORM.A473TDVNro .AND. THISFORM.Buf_T011823_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011823) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011823 = Gx_err
               THISFORM.GX_DB_GetT011823_01 ()
            ENDDO
         ENDIF
      ENDPROC
