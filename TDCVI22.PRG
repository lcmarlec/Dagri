      PROCEDURE CreateTemp
         LOCAL SCT118S41
         SCT118S41 = ""
         IF USED( "SCT118S41" )
            SELECT SCT118S41
            SCT118S41 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT118S41
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA657tDVFL"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA658tDVFO"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 60
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA659tDVFI"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA660tdvGr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT118S41 = GETE('z:\temp') + '\' + SCT118S41
            ENDIF
            CREATE DBF (SCT118S41) FROM ARRAY GX_STRUCT
            USE
            USE (SCT118S41) EXCLUSIVE ALIAS SCT118S41
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT118S41
