   DEFINE CLASS CW906S20A2 AS CGXTextBoxSf
      GXColumnNo = 1
      BorderStyle = 0
      InputMask = "999"
      Format = "K"
      Century = 0
      HelpContextId = 327682
      PROCEDURE ValidObj
         IF .not. THISFORM. cCW906S20 .Gx_rec_modif
            RETURN .T.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE InteractiveChange
         IF .not. THISFORM. cCW906S20 .GX_rec_modif
            THISFORM. cCW906S20 .Gx_rec_modif = .T.
            THISFORM. cCW906S20 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW906S20 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW906S20 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW906S20 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.A2EmpCod = THIS.Value
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW906S20 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER OCW906.EnterKey
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
         ELSE
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            IF ! THISFORM.InRoutine("ISVALID")
               THISFORM.FormRefresh( .T. , .F. )
            ENDIF
         ENDIF
         IF gx_val_ret >= 0
            IF THIS.GX_Mouse
               THIS.GotMouseDown()
            ENDIF
            NODEFAULT
            IF gx_val_ret >= 0
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
            RETURN
         ELSE
            IF gx_val_ret = -2
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM.GX_NewLastVld != -1
            THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THISFORM. cCW906S20 .GX_focusInGrid = .T.
         THISFORM. cCW906S20 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW906V5 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2EmpCod"
         THISFORM.cCW906S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW906S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW906S20 .GX_lastkey = 9.or. THISFORM.cCW906S20 .GX_lastkey = 13)
            IF ! THISFORM.cCW906S20 .GridValidObj( THISFORM.cCW906S20 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW906S20 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW906S20 .gx_can_changerow = .T.
         CGXTextBoxSf ::GotFocus
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE RefreshSfAtt
         LOCAL gxO_Area
         IF .not. THISFORM.Gx_Refresh_grid_Att
            RETURN
         ENDIF
         gxO_Area = SELECT()
         SELECT (THISFORM. cCW906S20 .GX_SfAlias)
         REPLACE sA2EmpCod WITH THISFORM.A2EmpCod
         SELECT (gxO_Area)
         THIS.Refresh()
