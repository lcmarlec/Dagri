      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02022" , @HStmt_W02022 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00J1","W02022","",GX_CURSOR_TYPE_READONLY,@HStmt_W02022) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PCtaGrNro], [CtaGrSecBa], [CtaGrToC], [CtaGrNiv], [CtaGrTipAj], [CtaGrDes], "
                  cmdbuf = cmdbuf + "  [CtaGrNro] FROM [CTAGR] (FASTFIRSTROW NOLOCK) WHERE ([PCtaGrNro] = ?) AND ([CtaGrNro] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CtaGrDes] like ?) AND ([CtaGrSecBa] >= ?) AND ([CtaGrToC] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([CtaGrNiv] >= ?) AND ([CtaGrTipAj] >= ?) ORDER BY [PCtaGrNro], [CtaGrNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02022,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02022,8)
                  THISFORM.GX_DB_BindColsW02022_01 ()
                  THISFORM.GX_DB_BindParmW02022_01 ()
               ENDIF
               AuxA215PCtaGr = THISFORM.A215PCtaGr
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02022,1,@AuxA215PCtaGr,0)
               THISFORM.A215PCtaGr = AuxA215PCtaGr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02022,2,PADR( TRIM(THISFORM.AV20C217),12, '%'),LEN(PADR( TRIM(THISFORM.AV20C217),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02022,3,PADR( TRIM(THISFORM.AV19C218),40, '%'),LEN(PADR( TRIM(THISFORM.AV19C218),40, '%')),0)
               AuxAV18C219 = THISFORM.AV18C219
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02022,4,@AuxAV18C219,0)
               THISFORM.AV18C219 = AuxAV18C219
               AuxAV17C220 = THISFORM.AV17C220
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02022,5,@AuxAV17C220,0)
               THISFORM.AV17C220 = AuxAV17C220
               AuxAV16C221 = THISFORM.AV16C221
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02022,6,@AuxAV16C221,0)
               THISFORM.AV16C221 = AuxAV16C221
               AuxAV15C222 = THISFORM.AV15C222
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02022,7,@AuxAV15C222,0)
               THISFORM.AV15C222 = AuxAV15C222
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02022 = Gx_err
               THISFORM.GX_DB_GetW02022_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02022 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02022) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02022 = Gx_err
                  THISFORM.GX_DB_GetW02022_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02022 <> 101
               BRKV5M2 = .F.
               THISFORM.A219CtaGrS = THISFORM.Buf_W02022_219CtaGrSecBa
               THISFORM.A220CtaGrT = THISFORM.Buf_W02022_220CtaGrToC
               THISFORM.A221CtaGrN = THISFORM.Buf_W02022_221CtaGrNiv
               THISFORM.A222CtaGrT = THISFORM.Buf_W02022_222CtaGrTipAj
               THISFORM.A218CtaGrD = THISFORM.Buf_W02022_218CtaGrDes
               THISFORM.A217CtaGrN = THISFORM.Buf_W02022_217CtaGrNro
               GX_SFLOAD = 0
               THISFORM.U12V5M2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
