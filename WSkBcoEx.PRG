      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV19Parcod = SPACE(10)
               THISFORM.AV21Pardsc = SPACE(1024)
               GX_SFLOAD = 0
               THISFORM.U14VLQ2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
      PROCEDURE LoadFromTbl
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV19Parco WITH THISFORM.AV19Parcod
         REPLACE VAV21Pards WITH THISFORM.AV21Pardsc
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV19Parcod = VAV19Parco
         THISFORM.AV21Pardsc = VAV21Pards
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 1
            THISFORM.AV19Parcod = THIS.Column1.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 2
            THISFORM.AV21Pardsc = THIS.Column2.Ctrl1.Value
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV19Parcod = SPACE(10)
         THISFORM.AV21Pardsc = SPACE(1024)
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
      PROCEDURE BeforeRowChange
      ENDPROC
      PROCEDURE AfterRowChange
      ENDPROC
      PROCEDURE DblClick
         THISFORM.U12VLQ2 ()
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE Click
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE CallRefreshEvent
         THISFORM.cCW782S13.GXRefreshEvt ()
      ENDPROC
      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW782S13 .GX_SfAlias)
            GO TOP
            THISFORM.cCW782S13 .Refresh()
         ENDIF
         THISFORM. cCW782S13 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW782S13 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
