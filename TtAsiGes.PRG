      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T013614" , @HStmt_T013614 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTASIGES","T013614","",GX_CURSOR_TYPE_READONLY,@HStmt_T013614) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TAGNi], [TAGAsiTip], [TAGAsiNI], [TAGAsiItNr], [TAGAsiCTaN], [TAGAsiItFc], "
                  cmdbuf = cmdbuf + "  [TAGAsiItDs], [TAGAsiDebe], [TAGAsiHabe], [TAGASIdOh] FROM [TASIGES1] (NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? AND [TAGNi] = ? AND [TAGAsiTip] = ? AND [TAGAsiNI] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [TAGNi], [TAGAsiTip], [TAGAsiNI], [TAGAsiItNr], [TAGAsiCTaN]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T013614,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T013614,9)
                  THISFORM.GX_DB_BindColsT013614_01 ()
                  THISFORM.GX_DB_BindParmT013614_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T013614,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1380TAGNi = THISFORM.A1380TAGNi
               Gx_err = GX_DB_SetDouble( HStmt_T013614,2,@AuxA1380TAGNi,0)
               THISFORM.A1380TAGNi = AuxA1380TAGNi
               AuxA1381TAGAs = THISFORM.A1381TAGAs
               Gx_err = GX_DB_SetInt( HStmt_T013614,3,@AuxA1381TAGAs,0)
               THISFORM.A1381TAGAs = AuxA1381TAGAs
               AuxA1382TAGAs = THISFORM.A1382TAGAs
               Gx_err = GX_DB_SetDouble( HStmt_T013614,4,@AuxA1382TAGAs,0)
               THISFORM.A1382TAGAs = AuxA1382TAGAs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T013614) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013614 = Gx_err
               THISFORM.GX_DB_GetT013614_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T013614 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013614) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T013614 = Gx_err
                  THISFORM.GX_DB_GetT013614_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T013614 <> 101
               BRK3S159 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT136S24.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013614) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013614 = Gx_err
               THISFORM.GX_DB_GetT013614_01 ()
            ENDDO
         ENDIF
      ENDPROC
