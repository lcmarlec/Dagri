            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09415) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W09415 = Gx_err
         THISFORM.GX_DB_GetW09415_01 ()
         DO WHILE THISFORM.W09415 <> 101 .AND. THISFORM.Buf_W09415_2EmpCod=A2EmpCod .AND. THISFORM.Buf_W09415_2870PCNroInt=A2870PCNro
            THISFORM.A2878PcPgt = THISFORM.A2878PcPgt + THISFORM.Buf_W09415_2876PcPgImp
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09415) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W09415 = Gx_err
            THISFORM.GX_DB_GetW09415_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W09415) ,  ,  ,  , CS_SQLSRV ,  )
      RETURN

