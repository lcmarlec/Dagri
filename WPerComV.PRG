         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09414" , @HStmt_W09414 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPERCOMV","W09414","",GX_CURSOR_TYPE_READONLY,@HStmt_W09414) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntGruTip], T1.[EmpCod], T1.[PCNroInt], T2.[PcMot], T2.[SecCod], T2.[PcDocAso], "
                  cmdbuf = cmdbuf + "  T2.[PcEst], T1.[PcPgImp], T1.[PcPgDet], T1.[PcPgLin], T2.[Moncod], T2.[PCObs], T2.[PCtotal], "
                  cmdbuf = cmdbuf + "  T3.[EntRaz], T2.[EntCod], T2.[PCNro], T2.[PCFch] FROM (([PERCOM1] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [PERCOM] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[PCNroInt] "
                  cmdbuf = cmdbuf + "  = T1.[PCNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[EntGruTip] = T2.[EntGruTip] AND T3.[EntCod] = T2.[EntCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[PCNroInt] = ? ORDER BY T1.[EmpCod], T1.[PCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09414,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09414,6)
                  THISFORM.GX_DB_BindColsW09414_01 ()
                  THISFORM.GX_DB_BindParmW09414_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09414,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2870PCNro = THISFORM.A2870PCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09414,2,@AuxA2870PCNro,0)
               THISFORM.A2870PCNro = AuxA2870PCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09414) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09414 = Gx_err
               THISFORM.GX_DB_GetW09414_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV13Pgmnam = "WPerComV"
               THISFORM.Gx_err = 0
               THISFORM.VEVQ52878 ( THISFORM.A2EmpCod , THISFORM.A2870PCNro )
               THISFORM. cCW941A2878 .Refresh()
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09414 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09414) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09414 = Gx_err
                  THISFORM.GX_DB_GetW09414_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09414 <> 101
               BRKVQ52 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W09414_150EntGruTip
               THISFORM.A2883PcMot = THISFORM.Buf_W09414_2883PcMot
               THISFORM.A2651SecCo = THISFORM.Buf_W09414_2651SecCod
               THISFORM.A2880PcDoc = THISFORM.Buf_W09414_2880PcDocAso
               THISFORM.A2879PcEst = THISFORM.Buf_W09414_2879PcEst
               THISFORM.A2876PcPgI = THISFORM.Buf_W09414_2876PcPgImp
               THISFORM.A2882PcPgD = THISFORM.Buf_W09414_2882PcPgDet
               THISFORM.A2875PcPgL = THISFORM.Buf_W09414_2875PcPgLin
               THISFORM.A193Moncod = THISFORM.Buf_W09414_193Moncod
               THISFORM.A2874PCObs = Gx_lvchar_to_char( THISFORM.Buf_W09414_2874PCObs )
               THISFORM.A2873PCtot = THISFORM.Buf_W09414_2873PCtotal
               THISFORM.A153EntRaz = THISFORM.Buf_W09414_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W09414_120EntCod
               THISFORM.A2872PCNro = THISFORM.Buf_W09414_2872PCNro
               THISFORM.A2871PCFch = THISFORM.Buf_W09414_2871PCFch
               THISFORM.A150EntGru = THISFORM.Buf_W09414_150EntGruTip
               THISFORM.A2883PcMot = THISFORM.Buf_W09414_2883PcMot
               THISFORM.A2651SecCo = THISFORM.Buf_W09414_2651SecCod
               THISFORM.A2880PcDoc = THISFORM.Buf_W09414_2880PcDocAso
               THISFORM.A2879PcEst = THISFORM.Buf_W09414_2879PcEst
               THISFORM.A193Moncod = THISFORM.Buf_W09414_193Moncod
               THISFORM.A2874PCObs = Gx_lvchar_to_char( THISFORM.Buf_W09414_2874PCObs )
               THISFORM.A2873PCtot = THISFORM.Buf_W09414_2873PCtotal
               THISFORM.A120EntCod = THISFORM.Buf_W09414_120EntCod
               THISFORM.A2872PCNro = THISFORM.Buf_W09414_2872PCNro
               THISFORM.A2871PCFch = THISFORM.Buf_W09414_2871PCFch
               THISFORM.A153EntRaz = THISFORM.Buf_W09414_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U15VQ52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09414) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09414 = Gx_err
               THISFORM.GX_DB_GetW09414_01 ()
            ENDDO
         ENDIF
      ENDPROC
