      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11962" , @HStmt_W11962 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFEGL","W11962","",GX_CURSOR_TYPE_READONLY,@HStmt_W11962) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [lpvind], [PlVGruTip], [PlVEntCod], [LpvFch], [FamCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [ArtCod], [LpvPrcReal], [LpvPrc] FROM [LPVClt1] (NOLOCK) WHERE ([PlVGruTip] = ?) "
                  cmdbuf = cmdbuf + "  AND ([PlVEntCod] = ?) AND ([LpvFch] = ?) ORDER BY [EmpCod], [PlVGruTip], [PlVEntCod], "
                  cmdbuf = cmdbuf + "  [LpvFch], [lpvind], [FamCod], [FamSubCod], [ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11962,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11962,13)
                  THISFORM.GX_DB_BindColsW11962_01 ()
                  THISFORM.GX_DB_BindParmW11962_01 ()
               ENDIF
               AuxA2103xPlVG = THISFORM.A2103xPlVG
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11962,1,AuxA2103xPlVG,2,0)
               THISFORM.A2103xPlVG = AuxA2103xPlVG
               AuxA2104xPlVE = THISFORM.A2104xPlVE
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11962,2,@AuxA2104xPlVE,0)
               THISFORM.A2104xPlVE = AuxA2104xPlVE
               AuxA2105xLpvF = THISFORM.A2105xLpvF
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11962,3,@AuxA2105xLpvF,0)
               THISFORM.A2105xLpvF = AuxA2105xLpvF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11962 = Gx_err
               THISFORM.GX_DB_GetW11962_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV47Pgmnam = "WOfeGL"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11962 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11962) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11962 = Gx_err
                  THISFORM.GX_DB_GetW11962_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11962 <> 101
               BRKVX82 = .F.
               THISFORM.AV40Op = SPACE(1)
               THISFORM.A2106xFamC = THISFORM.Buf_W11962_2106xFamCod
               THISFORM.A2107xFamS = THISFORM.Buf_W11962_2107xFamSubCod
               THISFORM.A2108xArtC = THISFORM.Buf_W11962_2108xArtCod
               THISFORM.A2119xLpvP = THISFORM.Buf_W11962_2119xLpvPrcRe
               THISFORM.A2109xLpvP = THISFORM.Buf_W11962_2109xLpvPrc
               GX_SFLOAD = 0
               THISFORM.U17VX82 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11962 = Gx_err
               THISFORM.GX_DB_GetW11962_01 ()
            ENDDO
         ENDIF
