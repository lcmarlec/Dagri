               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01642,3,@AuxAV20Usuact,0)
               THISFORM.AV20Usuact = AuxAV20Usuact
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01642) ,  ,  ,  , CS_SQLSRV ,  )
