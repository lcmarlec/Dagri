               THISFORM.W01642 = Gx_err
               THISFORM.GX_DB_GetW01642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WUsu002"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
