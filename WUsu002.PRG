      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01642" , @HStmt_W01642 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WUSU002","W01642","",GX_CURSOR_TYPE_READONLY,@HStmt_W01642) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [UsuActivo], [UsuNombre], [UsuCod] FROM [USU002] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([UsuNombre] like ?) AND ([UsuActivo] = ? or ? = 9) ORDER BY [UsuCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01642,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01642,11)
                  THISFORM.GX_DB_BindColsW01642_01 ()
                  THISFORM.GX_DB_BindParmW01642_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01642,1,PADR( TRIM(THISFORM.AV6Usunom),30, '%'),LEN(PADR( TRIM(THISFORM.AV6Usunom),30, '%')),0)
               AuxAV20Usuact = THISFORM.AV20Usuact
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01642,2,@AuxAV20Usuact,0)
