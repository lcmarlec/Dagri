         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01642 <> 101
               BRKV4K2 = .F.
               THISFORM.A3008UsuAc = THISFORM.Buf_W01642_3008UsuActivo
               THISFORM.A65UsuNomb = THISFORM.Buf_W01642_65UsuNombre
