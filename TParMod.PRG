      PROCEDURE DEBE220
      ***********************

         * After confirm
         IF .T.
            THISFORM.AV13Numero = str( THISFORM.A2EmpCod , 3 )
         ENDIF
         IF .T.
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV12Emprco
            Aux3 = THISFORM.AV13Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV10Audobs
            Aux6 = THISFORM.AV9Usuario
            DO PAuditor WITH "TABL" , Aux1 , "PARM" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV12Emprco = Aux1
            THISFORM.AV13Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV10Audobs = Aux5
            THISFORM.AV9Usuario = Aux6
            THISFORM. cCT410V9 .Refresh()
         ENDIF
         * Locks
         DO WHILE .NOT. THISFORM.T04102 <> 103
            DO GX_ERRMW WITH "PARAM   reservado por otro"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T04102,1,@AuxA2EmpCod,0)
