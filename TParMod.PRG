      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 220
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT410V7 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT410V7 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 220
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA2EmpCod = THISFORM.A2EmpCod
                  Gx_err = GX_DB_SetInt( HStmt_T04103,1,@AuxA2EmpCod,0)
                  THISFORM.A2EmpCod = AuxA2EmpCod
                  AuxA1888ParCo = THISFORM.A1888ParCo
                  Gx_err = GX_DB_SetStr( HStmt_T04103,2,AuxA1888ParCo,10,0)
                  THISFORM.A1888ParCo = AuxA1888ParCo
                  AuxA1889ParSC = THISFORM.A1889ParSC
                  Gx_err = GX_DB_SetStr( HStmt_T04103,3,AuxA1889ParSC,10,0)
                  THISFORM.A1889ParSC = AuxA1889ParSC
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T04103) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T04103 = Gx_err
                  THISFORM.GX_DB_GetT04103_01 ()
                  THISFORM. cCT410V7 . ZMBE220 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCBE220 ()
               THISFORM. cCT410V7 . ZMBE220 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCBE220 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT410A2215 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEBE220 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCBE220 ()
                  RETURN
               ENDIF
               THISFORM.cCT410V7.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04103) , "TPARMOD" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04102) , "TPARMOD" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04104) , "TPARMOD" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT410A2215 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT410V7 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

