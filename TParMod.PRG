            AuxA1889ParSC = THISFORM.A1889ParSC
            Gx_err = GX_DB_SetStr( HStmt_T04102,3,AuxA1889ParSC,10,0)
            THISFORM.A1889ParSC = AuxA1889ParSC
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T04102) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T04102 = Gx_err
