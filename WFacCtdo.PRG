      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12782" , @HStmt_W12782 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFACCTDO","W12782","",GX_CURSOR_TYPE_READONLY,@HStmt_W12782) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T2.[EntLgCIvCo], T1.[pedle], T1.[PedFac], T1.[PedNro], T1.[PedGruTip] "
                  cmdbuf = cmdbuf + "  AS PedGruTip, T1.[PedObs], T1.[PedFVT], T1.[PedFPrc], T1.[PedEst], T2.[EntLgTel] "
                  cmdbuf = cmdbuf + "  AS PedSucTel, T1.[PedOrd12], T1.[PedPri], T1.[PedSec], T1.[PedFch], T2.[EntLgDsc], "
                  cmdbuf = cmdbuf + "  T1.[PedSucCod] AS PedSucCod, T1.[PedEntCod] AS PedEntCod FROM ([PEDIDO1] T1 (NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CLTES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[PedGruTip] AND T2.[EntCod] = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ?) AND (T1.[PedEst] = 1) AND (T1.[PedFch] >= ?) AND (T1.[PedFch] "
                  cmdbuf = cmdbuf + "  <= ?) AND (( T1.[PedFVT] = 'FF')) AND (T2.[EntLgCIvCo] = 0 or T2.[EntLgCIvCo] = "
                  cmdbuf = cmdbuf + "  5 or T2.[EntLgCIvCo] >= 80) ORDER BY T1.[EmpCod], T1.[PedNro], T1.[PedFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12782,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12782,15)
                  THISFORM.GX_DB_BindColsW12782_01 ()
                  THISFORM.GX_DB_BindParmW12782_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12782,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV15Fecdes = THISFORM.AV15Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12782,2,@AuxAV15Fecdes,0)
               THISFORM.AV15Fecdes = AuxAV15Fecdes
               AuxAV16Fechas = THISFORM.AV16Fechas
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12782,3,@AuxAV16Fechas,0)
               THISFORM.AV16Fechas = AuxAV16Fechas
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12782) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
