         THISFORM. cCW1278S19 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW1278V8 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A807PedObs"
         THISFORM.cCW1278S19 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW1278S19 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW1278S19 .GX_lastkey = 9.or. THISFORM.cCW1278S19 .GX_lastkey = 13)
