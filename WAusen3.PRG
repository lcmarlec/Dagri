      ***********************
      PROCEDURE U16VMK2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'MOTIVO'" )
         * 'MOTIVO' Routine
         THISFORM.AV46GXLvl4 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08123" , @HStmt_W08123 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WAUSEN3","W08123","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W08123) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [CAuCod], [CAuDsc] FROM [CAUSENTI] (NOLOCK) WHERE [EmpCod] = ? and "
            cmdbuf = cmdbuf + "  [CAuCod] = ? ORDER BY [EmpCod], [CAuCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08123,cmdbuf)
            THISFORM.GX_DB_BindColsW08123_01 ()
            THISFORM.GX_DB_BindParmW08123_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08123,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV22Caucod = THISFORM.AV22Caucod
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08123,2,AuxAV22Caucod,4,0)
         THISFORM.AV22Caucod = AuxAV22Caucod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08123) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W08123 = Gx_err
         THISFORM.GX_DB_GetW08123_01 ()
         DO WHILE THISFORM.W08123 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W08123_2EmpCod
            THISFORM.A2266CAuCo = THISFORM.Buf_W08123_2266CAuCod
            THISFORM.A2267CAuDs = THISFORM.Buf_W08123_2267CAuDsc
            THISFORM.AV46GXLvl4 = 1
            THISFORM.AV37Caudsc = THISFORM.A2267CAuDs
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W08123) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV46GXLvl4 = 0
            THISFORM.AV22Caucod = SPACE(4)
            THISFORM.AV37Caudsc = "Motivo inexistente"
         ENDIF
         THISFORM.EndEvent()
      ENDPROC

