      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T024519" , @HStmt_T024519 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCDESAR","T024519","",GX_CURSOR_TYPE_READONLY,@HStmt_T024519) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [DceNI], [DceArtLiin], [DcePos1], [DcePos2], [DcePos3], [DcePos4], "
                  cmdbuf = cmdbuf + "  [FamCod], [FamSubCod], [ArtCod], [DceArtCnt], [DceArtPrc] FROM [DCDESART] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [DceNI] = ? ORDER BY [EmpCod], [DceNI], [DceArtLiin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T024519,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T024519,10)
                  THISFORM.GX_DB_BindColsT024519_01 ()
                  THISFORM.GX_DB_BindParmT024519_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T024519,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3022DceNI = THISFORM.A3022DceNI
               Gx_err = GX_DB_SetDouble( HStmt_T024519,2,@AuxA3022DceNI,0)
               THISFORM.A3022DceNI = AuxA3022DceNI
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T024519) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T024519 = Gx_err
               THISFORM.GX_DB_GetT024519_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T024519 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T024519) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T024519 = Gx_err
                  THISFORM.GX_DB_GetT024519_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T024519 <> 101
               BRK6T350 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT245A2570 .LoadObj(2)
