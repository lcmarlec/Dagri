         IF (RECCOUNT() - THIS.GX_del_rec) <= 0
            gx_val_ret = THISFORM.validobj2( THISFORM.GX_lastvld, THIS.GxObjOrder , THIS.GxObjOrder)
            IF gx_val_ret >= 0
               THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .F., .F., .F.)
               RETURN
            ELSE
               IF gx_val_ret = -2
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 350
            THIS.gx_old_row = -1
         ENDIF
