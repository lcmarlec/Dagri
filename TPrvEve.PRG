      PROCEDURE CreateTemp
         LOCAL SCT374S43
         SCT374S43 = ""
         IF USED( "SCT374S43" )
            SELECT SCT374S43
            SCT374S43 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT374S43
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA854EntIm"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA855EntIm"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA856EntIm"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA857EntIm"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT374S43 = GETE('z:\temp') + '\' + SCT374S43
            ENDIF
            CREATE DBF (SCT374S43) FROM ARRAY GX_STRUCT
            USE
            USE (SCT374S43) EXCLUSIVE ALIAS SCT374S43
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT374S43
         THIS.GX_SfAlias = "SCT374S43"
      ENDPROC
