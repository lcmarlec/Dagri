                  cmdbuf = cmdbuf + "  like ?) AND ([RemSuc] >= ?) ORDER BY [EmpCod], [RemNI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07022,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07022,9)
                  THISFORM.GX_DB_BindColsW07022_01 ()
                  THISFORM.GX_DB_BindParmW07022_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07022,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C2130 = THISFORM.AV5C2130
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07022,2,@AuxAV5C2130,0)
               THISFORM.AV5C2130 = AuxAV5C2130
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07022,3,PADR( TRIM(THISFORM.AV6C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C150),2, '%')),0)
               AuxAV7C120 = THISFORM.AV7C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07022,4,@AuxAV7C120,0)
               THISFORM.AV7C120 = AuxAV7C120
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07022,5,PADR( TRIM(THISFORM.AV8C2131),4, '%'),LEN(PADR( TRIM(THISFORM.AV8C2131),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07022,6,PADR( TRIM(THISFORM.AV9C2132),1, '%'),LEN(PADR( TRIM(THISFORM.AV9C2132),1, '%')),0)
               AuxAV10C2133 = THISFORM.AV10C2133
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07022,7,@AuxAV10C2133,0)
               THISFORM.AV10C2133 = AuxAV10C2133
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07022 = Gx_err
               THISFORM.GX_DB_GetW07022_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07022 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07022) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07022 = Gx_err
                  THISFORM.GX_DB_GetW07022_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07022 <> 101
               BRKVJI2 = .F.
               THISFORM.A2139RemEs = THISFORM.Buf_W07022_2139RemEst
               THISFORM.A2134RemNr = THISFORM.Buf_W07022_2134RemNro
               THISFORM.A2133RemSu = THISFORM.Buf_W07022_2133RemSuc
               THISFORM.A2132RemSe = THISFORM.Buf_W07022_2132RemSer
               THISFORM.A2131RemTi = THISFORM.Buf_W07022_2131RemTip
               THISFORM.A120EntCod = THISFORM.Buf_W07022_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W07022_150EntGruTip
               THISFORM.A2130RemNI = THISFORM.Buf_W07022_2130RemNI
               GX_SFLOAD = 0
               THISFORM.U12VJI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07022 = Gx_err
               THISFORM.GX_DB_GetW07022_01 ()
            ENDDO
         ENDIF
      ENDPROC
