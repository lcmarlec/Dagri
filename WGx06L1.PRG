            THISFORM. cCW702S20 .Gx_rec_modif = .T.
            THISFORM. cCW702S20 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW702S20 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW702S20 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW702S20 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.A2130RemNI = THIS.Value
