      PROCEDURE CreateTemp
         LOCAL SCW534S18
         SCW534S18 = ""
         IF USED( "SCW534S18" )
            SELECT SCW534S18
            SCW534S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW534S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA1652CPCo"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1653CPLo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1654CPCl"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 240
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1659CPPc"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW534S18 = GETE('z:\temp') + '\' + SCW534S18
            ENDIF
            CREATE DBF (SCW534S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW534S18) EXCLUSIVE ALIAS SCW534S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW534S18
         THIS.GX_SfAlias = "SCW534S18"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05342" , @HStmt_W05342 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCODPOS","W05342","",GX_CURSOR_TYPE_READONLY,@HStmt_W05342) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[PaiCod], T2.[PciCod], T1.[CPPciCod], T1.[CPPaiCod], T1.[EmpCod], T2.[PciDsc], "
                  cmdbuf = cmdbuf + "  T1.[CPClear], T1.[CPLocal], T1.[CPCod] FROM ([CODPOS] T1 (FASTFIRSTROW NOLOCK) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [PCIAS] T2 (NOLOCK) ON T2.[PaiCod] = T1.[CPPaiCod] AND T2.[PciCod] = T1.[CPPciCod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[CPLocal] like ? ORDER BY T1.[EmpCod], T1.[CPCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05342,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05342,14)
                  THISFORM.GX_DB_BindColsW05342_01 ()
                  THISFORM.GX_DB_BindParmW05342_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05342,1,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05342 = Gx_err
               THISFORM.GX_DB_GetW05342_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WCodPos"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05342 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05342) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05342 = Gx_err
                  THISFORM.GX_DB_GetW05342_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05342 <> 101
               BRKVEU2 = .F.
               THISFORM.A631PaiCod = THISFORM.Buf_W05342_631PaiCod
               THISFORM.A633PciCod = THISFORM.Buf_W05342_633PciCod
               THISFORM.A1658CPPci = THISFORM.Buf_W05342_1658CPPciCod
               THISFORM.A1656CPPai = THISFORM.Buf_W05342_1656CPPaiCod
               THISFORM.A2EmpCod = THISFORM.Buf_W05342_2EmpCod
               THISFORM.A634PciDsc = THISFORM.Buf_W05342_634PciDsc
               THISFORM.A1654CPCle = THISFORM.Buf_W05342_1654CPClear
               THISFORM.A1653CPLoc = THISFORM.Buf_W05342_1653CPLocal
               THISFORM.A1652CPCod = THISFORM.Buf_W05342_1652CPCod
               GX_SFLOAD = 0
               THISFORM.U17VEU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05342 = Gx_err
               THISFORM.GX_DB_GetW05342_01 ()
            ENDDO
         ENDIF
      ENDPROC
