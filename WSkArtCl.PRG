      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03502" , @HStmt_W03502 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKARTCL","W03502","",GX_CURSOR_TYPE_READONLY,@HStmt_W03502) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PlVGruTip] AS PlVGruTip, T2.[EntRaz] AS PlVEntRaz, T1.[PlVEntCod] "
                  cmdbuf = cmdbuf + "  AS PlVEntCod, T3.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod] FROM (([PLAVTA1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[PlVGruTip] AND T2.[EntCod] = T1.[PlVEntCod]) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] "
                  cmdbuf = cmdbuf + "  AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[PlVGruTip] = ? and T1.[PlVEntCod] = ? ORDER BY T1.[EmpCod], T1.[PlVGruTip], "
                  cmdbuf = cmdbuf + "  T1.[PlVEntCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03502,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03502,15)
                  THISFORM.GX_DB_BindColsW03502_01 ()
                  THISFORM.GX_DB_BindParmW03502_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03502,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV18Entgru = THISFORM.AV18Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03502,2,AuxAV18Entgru,2,0)
               THISFORM.AV18Entgru = AuxAV18Entgru
               AuxAV15Entcod = THISFORM.AV15Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03502,3,@AuxAV15Entcod,0)
               THISFORM.AV15Entcod = AuxAV15Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03502 = Gx_err
               THISFORM.GX_DB_GetW03502_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WSkArtCl"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03502 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03502) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03502 = Gx_err
                  THISFORM.GX_DB_GetW03502_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03502 <> 101
               BRKV9Q2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W03502_2EmpCod
               THISFORM.A836PlVGru = THISFORM.Buf_W03502_836PlVGruTip
               THISFORM.A838PlVEnt = THISFORM.Buf_W03502_838PlVEntRaz
               THISFORM.A837PlVEnt = THISFORM.Buf_W03502_837PlVEntCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W03502_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W03502_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W03502_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W03502_3FamCod
               THISFORM.A838PlVEnt = THISFORM.Buf_W03502_838PlVEntRaz
               THISFORM.A6ArtDsc = THISFORM.Buf_W03502_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U14V9Q2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03502 = Gx_err
               THISFORM.GX_DB_GetW03502_01 ()
            ENDDO
         ENDIF
      ENDPROC
