            THISFORM.AV6Fechasi = Aux4
            THISFORM.AV19Usuari = Aux5
            THISFORM.AV29Ok = Aux6
            THISFORM. cCW890S24 .RestoreGridPos()
            GX_rploop = .T.
            IF THISFORM.AV29Ok = "S"
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A1525LlaNr
               Aux1 = THISFORM.AV28Llaobs
               DO PLlaObs WITH Aux0 , Aux1
               THISFORM.A1525LlaNr = Aux0
               THISFORM.AV28Llaobs = Aux1
               THISFORM. cCW890S24 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.AV30Numero = str( THISFORM.A1520LlaNr , 8 )
               THISFORM.AV32Audobs = "Atencion a Clte. Directo"
               THISFORM.SaveTblPos()
               Aux1 = THISFORM.AV8Emprcod
               Aux3 = THISFORM.AV30Numero
               Aux5 = THISFORM.AV32Audobs
               Aux6 = THISFORM.AV19Usuari
               DO PAuditor WITH "CALL" , Aux1 , "CALCEN" , Aux3 , "UPD" , Aux5 , Aux6
               THISFORM.AV8Emprcod = Aux1
               THISFORM.AV30Numero = Aux3
               THISFORM.AV32Audobs = Aux5
               THISFORM.AV19Usuari = Aux6
               THISFORM. cCW890S24 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.A1520LlaNr
               DO RLlaCImp WITH Aux0 , Aux1 , "PRN" , 1
               THISFORM.AV8Emprcod = Aux0
               THISFORM.A1520LlaNr = Aux1
               THISFORM. cCW890S24 .RestoreGridPos()
               THISFORM. cCW890S24.Columns(1).Ctrl1 .RefreshSfAtt()
