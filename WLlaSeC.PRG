            THISFORM.AV6Fechasi = Aux4
            THISFORM.AV19Usuari = Aux5
            THISFORM. cCW890S24 .RestoreGridPos()
            GX_rploop = .T.
         ELSE
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08905" , @HStmt_W08905 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLLASEC","W08905","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W08905) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [LlaNroI], [LlaLin], [LlaObs] FROM [LLAITEM] (NOLOCK) WHERE [EmpCod] "
               cmdbuf = cmdbuf + "  = ? and [LlaNroI] = ? and [LlaLin] = 1 ORDER BY [EmpCod], [LlaNroI]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08905,cmdbuf)
               THISFORM.GX_DB_BindColsW08905_01 ()
               THISFORM.GX_DB_BindParmW08905_01 ()
            ENDIF
            AuxA2EmpCod = THISFORM.A2EmpCod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08905,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA1525LlaNr = THISFORM.A1525LlaNr
            THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08905,2,@AuxA1525LlaNr,0)
            THISFORM.A1525LlaNr = AuxA1525LlaNr
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08905) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W08905 = Gx_err
            THISFORM.GX_DB_GetW08905_01 ()
            DO WHILE THISFORM.W08905 <> 101
               THISFORM.A1512LlaLi = THISFORM.Buf_W08905_1512LlaLin
               THISFORM.A1515LlaOb = Gx_lvchar_to_char( THISFORM.Buf_W08905_1515LlaObs )
               THISFORM.AV28Llaobs = THISFORM.A1515LlaOb
               * Exit For each command. Update data (if necessary), close cursors & exit.
               EXIT
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W08905) ,  ,  ,  , CS_SQLSRV ,  )
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV8Emprcod
            Aux2 = THISFORM.A1525LlaNr
            Aux3 = THISFORM.AV28Llaobs
            Aux4 = THISFORM.AV6Fechasi
            Aux5 = THISFORM.AV19Usuari
            Aux6 = THISFORM.AV29Ok
