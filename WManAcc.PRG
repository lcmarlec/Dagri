               ENDDO
               THISFORM.W00882 = Gx_err
               THISFORM.GX_DB_GetW00882_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WManAcc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00882 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00882) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00882 = Gx_err
                  THISFORM.GX_DB_GetW00882_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00882 <> 101
               BRKV2G2 = .F.
               THISFORM.AV21Acceso = 0
               THISFORM.A66ObjCodA = THISFORM.Buf_W00882_66ObjCodAut
               THISFORM.A69ObjDsc = THISFORM.Buf_W00882_69ObjDsc
               THISFORM.A64UsuCod = THISFORM.Buf_W00882_64UsuCod
               THISFORM.A74AutNive = THISFORM.Buf_W00882_74AutNivel
               THISFORM.A69ObjDsc = THISFORM.Buf_W00882_69ObjDsc
               GX_SFLOAD = 0
               THISFORM.U15V2G2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00882) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00882 = Gx_err
               THISFORM.GX_DB_GetW00882_01 ()
            ENDDO
         ENDIF
      ENDPROC
