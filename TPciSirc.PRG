      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S631PaiCod
         LOCAL S2231SirAn
         LOCAL S2232SirMe
         LOCAL S633PciCod
         S631PaiCod = THISFORM.A631PaiCod
         S2231SirAn = THISFORM.A2231SirAn
         S2232SirMe = THISFORM.A2232SirMe
         S633PciCod = THISFORM.A633PciCod
         THISFORM.A633PciCod = THISFORM.M633PciCod
         THISFORM. cCT227S13 .SaveTemp()
         THISFORM. cCT227S13 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT227S13 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT227S13 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT227S13 .SF( 3, @sf_err)     && Read
         Gx_fcond = S631PaiCod = THISFORM.A631PaiCod .AND. S2231SirAn = THISFORM.A2231SirAn .AND. S2232SirMe = THISFORM.A2232SirMe .AND. S633PciCod = THISFORM.A633PciCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT227S13 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT227S13 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S631PaiCod = THISFORM.A631PaiCod .AND. S2231SirAn = THISFORM.A2231SirAn .AND. S2232SirMe = THISFORM.A2232SirMe .AND. S633PciCod = THISFORM.A633PciCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT227S13 .Refresh()
               THISFORM. cCT227S13 .AfterRowColChange1()
               THISFORM.A631PaiCod = S631PaiCod
               THISFORM.A2231SirAn = S2231SirAn
               THISFORM.A2232SirMe = S2232SirMe
               THISFORM.A633PciCod = S633PciCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT227S13 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT227S13 .LoadRec(2, @sf_err)
            Gx_fcond = S631PaiCod = THISFORM.A631PaiCod .AND. S2231SirAn = THISFORM.A2231SirAn .AND. S2232SirMe = THISFORM.A2232SirMe .AND. S633PciCod = THISFORM.A633PciCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT227S13 .LoadRec(2, @sf_err)
               Gx_fcond = S631PaiCod = THISFORM.A631PaiCod .AND. S2231SirAn = THISFORM.A2231SirAn .AND. S2232SirMe = THISFORM.A2232SirMe .AND. S633PciCod = THISFORM.A633PciCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT227S13 .AppendRow()
               THISFORM. cCT227S13 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A631PaiCod = S631PaiCod
               THISFORM.A2231SirAn = S2231SirAn
               THISFORM.A2232SirMe = S2232SirMe
               THISFORM.A633PciCod = S633PciCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A631PaiCod = S631PaiCod
         THISFORM.A2231SirAn = S2231SirAn
         THISFORM.A2232SirMe = S2232SirMe
         THISFORM.A633PciCod = S633PciCod
