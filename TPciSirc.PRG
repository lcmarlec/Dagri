      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T022714" , @HStmt_T022714 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPCISIRC","T022714","",GX_CURSOR_TYPE_READONLY,@HStmt_T022714) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [PaiCod], [SirAnio], [SirMes], [PciCod], [SirCoef], [TACCoef] FROM [PCISIRCR] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [PaiCod] = ? AND [SirAnio] = ? AND [SirMes] = ? ORDER BY [PaiCod], "
                  cmdbuf = cmdbuf + "  [SirAnio], [SirMes], [PciCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T022714,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T022714,15)
                  THISFORM.GX_DB_BindColsT022714_01 ()
                  THISFORM.GX_DB_BindParmT022714_01 ()
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               Gx_err = GX_DB_SetStr( HStmt_T022714,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               AuxA2231SirAn = THISFORM.A2231SirAn
               Gx_err = GX_DB_SetInt( HStmt_T022714,2,@AuxA2231SirAn,0)
               THISFORM.A2231SirAn = AuxA2231SirAn
               AuxA2232SirMe = THISFORM.A2232SirMe
               Gx_err = GX_DB_SetInt( HStmt_T022714,3,@AuxA2232SirMe,0)
               THISFORM.A2232SirMe = AuxA2232SirMe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T022714) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T022714 = Gx_err
               THISFORM.GX_DB_GetT022714_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T022714 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T022714) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T022714 = Gx_err
                  THISFORM.GX_DB_GetT022714_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T022714 <> 101
               BRK6B255 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT227S13.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T022714) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T022714 = Gx_err
               THISFORM.GX_DB_GetT022714_01 ()
            ENDDO
         ENDIF
      ENDPROC
