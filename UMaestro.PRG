      PROCEDURE CreateTemp
         LOCAL SCW87S4
         SCW87S4 = ""
         IF USED( "SCW87S4" )
            SELECT SCW87S4
            SCW87S4 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW87S4
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "VAV12Objet"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV8Titulo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW87S4 = GETE('z:\temp') + '\' + SCW87S4
            ENDIF
            CREATE DBF (SCW87S4) FROM ARRAY GX_STRUCT
            USE
            USE (SCW87S4) EXCLUSIVE ALIAS SCW87S4
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW87S4
         THIS.GX_SfAlias = "SCW87S4"
      ENDPROC
