      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. GX_1Lvl_mode = PGx_mode
         THISFORM. Gx_mode = PGx_mode
         THISFORM. AV20Campat = PAV20Campat
         THISFORM. AV8Emprcod = PAV8Emprcod
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV17Usuari = PAV17Usuari
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01622" , @HStmt_T01622 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMION","T01622","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01622) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [CamPat], [CamDsc], [CamVTV], [CamHab], [CamSeg], [CamTRu], [CamVde], "
            cmdbuf = cmdbuf + "  [CamCarga], [CamMunic], [CamObs], [CamChfCod] AS CamChfCod, [CamAnio], [CamMar], "
            cmdbuf = cmdbuf + "  [CamMod], [CamMotNro], [CamChanro], [CamCol], [CamSegCha], [CamSegFur], [CamSegEqf], "
            cmdbuf = cmdbuf + "  [CamFacSuc], [CamFacNro], [CamFacFch], [CamFacPas], [CamVTVR], [CamTRuR], [CamSegR], "
            cmdbuf = cmdbuf + "  [CamHabR], [CamVdeR], [CamCarR], [CamMunR], [CamNro], [CamPatVto], [CamPatRen], "
            cmdbuf = cmdbuf + "  [CamHabCaba], [CamHabCR], [CamPall] FROM [CAMION] (UPDLOCK) WHERE [EmpCod] = ? AND "
            cmdbuf = cmdbuf + "  [CamPat] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01622,cmdbuf)
            THISFORM.GX_DB_BindColsT01622_01 ()
            THISFORM.GX_DB_BindParmT01622_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01623" , @HStmt_T01623 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMION","T01623","",GX_CURSOR_TYPE_READONLY,@HStmt_T01623) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [CamPat], [CamDsc], [CamVTV], [CamHab], [CamSeg], [CamTRu], [CamVde], "
            cmdbuf = cmdbuf + "  [CamCarga], [CamMunic], [CamObs], [CamChfCod] AS CamChfCod, [CamAnio], [CamMar], "
            cmdbuf = cmdbuf + "  [CamMod], [CamMotNro], [CamChanro], [CamCol], [CamSegCha], [CamSegFur], [CamSegEqf], "
            cmdbuf = cmdbuf + "  [CamFacSuc], [CamFacNro], [CamFacFch], [CamFacPas], [CamVTVR], [CamTRuR], [CamSegR], "
            cmdbuf = cmdbuf + "  [CamHabR], [CamVdeR], [CamCarR], [CamMunR], [CamNro], [CamPatVto], [CamPatRen], "
            cmdbuf = cmdbuf + "  [CamHabCaba], [CamHabCR], [CamPall] FROM [CAMION] (NOLOCK) WHERE [EmpCod] = ? AND "
            cmdbuf = cmdbuf + "  [CamPat] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01623,cmdbuf)
            THISFORM.GX_DB_BindColsT01623_01 ()
            THISFORM.GX_DB_BindParmT01623_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01624" , @HStmt_T01624 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMION","T01624","",GX_CURSOR_TYPE_READONLY,@HStmt_T01624) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [ChfNom] AS CamChfNom FROM [CHOFER] (NOLOCK) WHERE [EmpCod] = ? AND [ChfCod] "
