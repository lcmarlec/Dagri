            Gx_err = GX_DB_SetStr( HStmt_P00089,5,R66ObjCodA,8,0)
            Gx_err = GX_DB_SetInt( HStmt_P00089,6,@R2EmpCod,0)
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P00089) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            P00089 = Gx_err
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P00089) ,  ,  ,  , CS_SQLSRV ,  )
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
            IF UserCancel
               EXIT
            ENDIF
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P00087) ,  ,  ,  , CS_SQLSRV ,  )
         LEVEL6 = .F.
      ENDIF
   ENDIF
   DO EP080
   RETURN
   GX_retp = 0
* End Program

