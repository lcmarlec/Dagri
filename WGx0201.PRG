               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02512) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02512 = Gx_err
               THISFORM.GX_DB_GetW02512_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02512 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02512) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02512 = Gx_err
                  THISFORM.GX_DB_GetW02512_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02512 <> 101
               BRKV6Z2 = .F.
               THISFORM.A2508NUmCR = THISFORM.Buf_W02512_2508NUmCR
               THISFORM.A678NumDsc = THISFORM.Buf_W02512_678NumDsc
               THISFORM.A677NumCod = THISFORM.Buf_W02512_677NumCod
               GX_SFLOAD = 0
               THISFORM.U12V6Z2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02512) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02512 = Gx_err
               THISFORM.GX_DB_GetW02512_01 ()
            ENDDO
         ENDIF
      ENDPROC
