      PROCEDURE CreateTemp
         LOCAL SCW193S20
         SCW193S20 = ""
         IF USED( "SCW193S20" )
            SELECT SCW193S20
            SCW193S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW193S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA150EntGr"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA120EntCo"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA151EntGr"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA157EntPa"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA175EntFV"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 240
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW193S20 = GETE('z:\temp') + '\' + SCW193S20
            ENDIF
            CREATE DBF (SCW193S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW193S20) EXCLUSIVE ALIAS SCW193S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW193S20
         THIS.GX_SfAlias = "SCW193S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01932" , @HStmt_W01932 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00F0","W01932","",GX_CURSOR_TYPE_READONLY,@HStmt_W01932) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntFan], [EntCont], [EntDom], [EntFVt], [EntPaiCod], [EntGruCod], [EntCod], "
                  cmdbuf = cmdbuf + "  [EntGruTip], [EmpCod] FROM [ENTID] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([EntGruTip] like ?) AND ([EntCod] >= ?) AND ([EntGruCod] like ?) AND ([EntFan] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EntCont] like ?) AND ([EntDom] like ?) ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01932,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01932,9)
                  THISFORM.GX_DB_BindColsW01932_01 ()
                  THISFORM.GX_DB_BindParmW01932_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01932,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01932,2,PADR( TRIM(THISFORM.AV6C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C150),2, '%')),0)
               AuxAV7C120 = THISFORM.AV7C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01932,3,@AuxAV7C120,0)
               THISFORM.AV7C120 = AuxAV7C120
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01932,4,PADR( TRIM(THISFORM.AV8C151),3, '%'),LEN(PADR( TRIM(THISFORM.AV8C151),3, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01932,5,PADR( TRIM(THISFORM.AV9C154),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C154),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01932,6,PADR( TRIM(THISFORM.AV10C155),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C155),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01932,7,PADR( TRIM(THISFORM.AV11C156),40, '%'),LEN(PADR( TRIM(THISFORM.AV11C156),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01932) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01932 = Gx_err
               THISFORM.GX_DB_GetW01932_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01932 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01932) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01932 = Gx_err
                  THISFORM.GX_DB_GetW01932_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01932 <> 101
               BRKV5D2 = .F.
               THISFORM.A154EntFan = THISFORM.Buf_W01932_154EntFan
               THISFORM.A155EntCon = THISFORM.Buf_W01932_155EntCont
               THISFORM.A156EntDom = THISFORM.Buf_W01932_156EntDom
               THISFORM.A175EntFVt = THISFORM.Buf_W01932_175EntFVt
               THISFORM.A157EntPai = THISFORM.Buf_W01932_157EntPaiCod
               THISFORM.A151EntGru = THISFORM.Buf_W01932_151EntGruCod
               THISFORM.A120EntCod = THISFORM.Buf_W01932_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W01932_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W01932_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V5D2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01932) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01932 = Gx_err
               THISFORM.GX_DB_GetW01932_01 ()
            ENDDO
         ENDIF
      ENDPROC
