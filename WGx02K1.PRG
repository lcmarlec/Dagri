               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02692" , @HStmt_W02692 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02K1","W02692","",GX_CURSOR_TYPE_READONLY,@HStmt_W02692) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PlVRet2], [PlVRet1], [PlVRet], [PlVEntCod], [PlVGruTip] FROM [PLAVTA] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND ([PlVGruTip] like ?) AND ([PlVEntCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PlVRet] >= ?) AND ([PlVRet1] >= ?) AND ([PlVRet2] >= ?) ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [PlVGruTip], [PlVEntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02692,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02692,8)
                  THISFORM.GX_DB_BindColsW02692_01 ()
                  THISFORM.GX_DB_BindParmW02692_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02692,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02692,2,PADR( TRIM(THISFORM.AV19C836),2, '%'),LEN(PADR( TRIM(THISFORM.AV19C836),2, '%')),0)
               AuxAV18C837 = THISFORM.AV18C837
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02692,3,@AuxAV18C837,0)
               THISFORM.AV18C837 = AuxAV18C837
               AuxAV17C1645 = THISFORM.AV17C1645
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02692,4,@AuxAV17C1645,0)
               THISFORM.AV17C1645 = AuxAV17C1645
               AuxAV16C1850 = THISFORM.AV16C1850
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02692,5,@AuxAV16C1850,0)
               THISFORM.AV16C1850 = AuxAV16C1850
               AuxAV15C1851 = THISFORM.AV15C1851
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02692,6,@AuxAV15C1851,0)
               THISFORM.AV15C1851 = AuxAV15C1851
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02692) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02692 = Gx_err
               THISFORM.GX_DB_GetW02692_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02692 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02692) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02692 = Gx_err
                  THISFORM.GX_DB_GetW02692_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02692 <> 101
               BRKV7H2 = .F.
               THISFORM.A1851PlVRe = THISFORM.Buf_W02692_1851PlVRet2
               THISFORM.A1850PlVRe = THISFORM.Buf_W02692_1850PlVRet1
               THISFORM.A1645PlVRe = THISFORM.Buf_W02692_1645PlVRet
               THISFORM.A837PlVEnt = THISFORM.Buf_W02692_837PlVEntCod
               THISFORM.A836PlVGru = THISFORM.Buf_W02692_836PlVGruTip
               GX_SFLOAD = 0
               THISFORM.U12V7H2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02692) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02692 = Gx_err
               THISFORM.GX_DB_GetW02692_01 ()
            ENDDO
         ENDIF
      ENDPROC
