               THISFORM.A2052HCamC = THISFORM.Buf_W07292_2052HCamChaN
               THISFORM.A2051HCamM = THISFORM.Buf_W07292_2051HCamMotN
               THISFORM.A2047HCamC = THISFORM.Buf_W07292_2047HCamChfN
               THISFORM.A2046HCamC = THISFORM.Buf_W07292_2046HCamChfC
               THISFORM.A2045HCamO = Gx_lvchar_to_char( THISFORM.Buf_W07292_2045HCamObs )
               THISFORM.A2035HCamP = THISFORM.Buf_W07292_2035HCamPat
               GX_SFLOAD = 1
               THISFORM.U17VK92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
