               THISFORM.A2058HCamF = THISFORM.Buf_W07292_2058HCamFacN
               THISFORM.A2057HCamF = THISFORM.Buf_W07292_2057HCamFacS
               THISFORM.A2053HCamC = THISFORM.Buf_W07292_2053HCamCol
               THISFORM.A2049HCamM = THISFORM.Buf_W07292_2049HCamMar
