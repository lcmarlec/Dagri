      PROCEDURE cCW729B2.GotFocus
         THISFORM.gx_over_OK = .F.
         IF ! MDOWN() .and. (THISFORM.gx_frmReadkey = 9 .or. THISFORM.gx_frmReadkey = 13)
            gx_val_ret = THISFORM.validobj2( THISFORM.GX_lastvld, THIS.GxObjOrder , THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .F., .F., .F.)
