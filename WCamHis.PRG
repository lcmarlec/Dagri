      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VK92()
            RETURN .T.
         ENDIF
         IF UPPER( "Primero" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VK92()
            RETURN .T.
         ENDIF
