      PROCEDURE NextInStructure
         LPARAMETER gx_FLvl
         DO CASE
            CASE gx_FLvl = 2
               gx_FLvlO = 1
            OTHERWISE
               gx_FLvlO = 0
         ENDCASE
         RETURN gx_FLvlO
      ENDPROC
