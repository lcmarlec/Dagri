      PROCEDURE LoadObj(LoadType)
         * Default load for WKP
         GX_CUOPER = 1
         GX_CUERR = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07292" , @HStmt_W07292 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAMHIS","W07292","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W07292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [HCamHabCab], [HCamPatRen], [HCamPatVto], [HCamHabCR], [HCamFch], "
                  cmdbuf = cmdbuf + "  [HCamUsu], [HCamAnio], [HCamDsc], [HCamNro], [HCamVTVR], [HCamMunR], [HCamTRuR], "
                  cmdbuf = cmdbuf + "  [HCamSegR], [HCamHabR], [HCamVdeR], [HCamCarR], [HCamMun], [HCamTRu], [HCamSeg], "
                  cmdbuf = cmdbuf + "  [HCamHab], [HCamVde], [HCamCarg], [HCamSegE], [HCamSegF], [HCamSegC], [HCamVTV], "
                  cmdbuf = cmdbuf + "  [HCamFacP], [HCamFacF], [HCamFacN], [HCamFacS], [HCamCol], [HCamMar], [HCamMod], "
                  cmdbuf = cmdbuf + "  [HCamChaN], [HCamMotN], [HCamChfN], [HCamChfC], [HCamObs], [HCamPat] FROM [CAMHIS] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [HCamPat] = ? and [HCamFch] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [HCamPat], [HCamFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07292,cmdbuf)
                  THISFORM.GX_DB_BindColsW07292_01 ()
                  THISFORM.GX_DB_BindParmW07292_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07292,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV9Hcampat = THISFORM.AV9Hcampat
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07292,2,AuxAV9Hcampat,8,0)
               THISFORM.AV9Hcampat = AuxAV9Hcampat
               AuxAV10Hcamfc = THISFORM.AV10Hcamfc
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W07292,3,@AuxAV10Hcamfc,0)
               THISFORM.AV10Hcamfc = AuxAV10Hcamfc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07292 = Gx_err
               THISFORM.GX_DB_GetW07292_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV13Pgmnam = "WCamHis"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07292 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07292) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07292 = Gx_err
                  THISFORM.GX_DB_GetW07292_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07292 <> 101
               BRKVK92 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W07292_2EmpCod
               THISFORM.A2770HCamH = THISFORM.Buf_W07292_2770HCamHabCab
               THISFORM.A2773HCamP = THISFORM.Buf_W07292_2773HCamPatRen
