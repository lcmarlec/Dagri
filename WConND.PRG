         LOCAL gx_old_event
         THISFORM.SetEvent( "'ENTER'" )
         * 'Enter' Routine
         IF THISFORM.AV12Fecha > THISFORM.AV23Fechah
            THISFORM.SaveTblPos()
            DO Werrores WITH "Rango de Fechas inválido " , "R"
            GX_rploop = .T.
         ELSE
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV54Parval
            DO RParam WITH Aux0 , "TEMP" , "CARPETA" , Aux3
            THISFORM.AV8Emprcod = Aux0
            THISFORM.AV54Parval = Aux3
            GX_rploop = .T.
            THISFORM.AV44Planil = ALLTRIM( THISFORM.AV54Parval ) + "ContNDoc" + substr( time( ) , 1 , 2 ) + substr( time( ) , 4 , 2 ) + substr( time( ) , 7 , 2 ) + ".xls"
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV8Emprcod
            Aux1 = THISFORM.AV12Fecha
            Aux2 = THISFORM.AV23Fechah
            Aux3 = THISFORM.AV55Tipo
            Aux4 = THISFORM.AV56Serie
            Aux5 = THISFORM.AV57Sucurs
            Aux6 = THISFORM.AV58Todos
            Aux7 = THISFORM.AV6Fechasi
            Aux8 = THISFORM.AV44Planil
            DO PConNDX WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7 , Aux8
            THISFORM.AV8Emprcod = Aux0
            THISFORM.AV12Fecha = Aux1
            THISFORM.AV23Fechah = Aux2
            THISFORM.AV55Tipo = Aux3
            THISFORM.AV56Serie = Aux4
            THISFORM.AV57Sucurs = Aux5
            THISFORM.AV58Todos = Aux6
            THISFORM.AV6Fechasi = Aux7
            THISFORM.AV44Planil = Aux8
