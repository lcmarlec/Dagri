            THISFORM.DoU17VA72()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver Pedido " ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VA72()
            RETURN .T.
         ENDIF
         IF UPPER( "Imprimir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VA72()
            RETURN .T.
         ENDIF
