                  cmdbuf = cmdbuf + "  T1.[PedFch], T1.[EmpCod], T1.[PedEmbFch], T1.[PedNroFac], T1.[PedSucFac], T1.[PedNroRto], "
                  cmdbuf = cmdbuf + "  T1.[PedSucRto], T2.[Entlgloc], T2.[EntLgDsc], T1.[PedSucCod] AS PedSucCod, T1.[PedEntCod] "
                  cmdbuf = cmdbuf + "  AS PedEntCod FROM ([PEDIDO1] T1 (NOLOCK) LEFT JOIN [CLTES] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[EntGruTip] = T1.[PedGruTip] AND T2.[EntCod] = T1.[PedEntCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntLgCod] = T1.[PedSucCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[PedNro] = ?) "
                  cmdbuf = cmdbuf + "  AND (T1.[PedEst] >= 1) AND (T1.[PedEmbFch] = ?) AND (T1.[PedEst] < 9) AND (T1.[PedEmbOrd] "
                  cmdbuf = cmdbuf + "  = ? or ? = ' ') ORDER BY T1.[EmpCod], T1.[PedFch], T1.[PedGruTip], T1.[PedEntCod], "
