      PROCEDURE CreateTemp
         LOCAL SCW715S20
         SCW715S20 = ""
         IF USED( "SCW715S20" )
            SELECT SCW715S20
            SCW715S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW715S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2103xPlV"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2104xPlV"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2105xLpv"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2122xLpv"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA2123xLpv"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW715S20 = GETE('z:\temp') + '\' + SCW715S20
            ENDIF
            CREATE DBF (SCW715S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW715S20) EXCLUSIVE ALIAS SCW715S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW715S20
         THIS.GX_SfAlias = "SCW715S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07152" , @HStmt_W07152 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06J1","W07152","",GX_CURSOR_TYPE_READONLY,@HStmt_W07152) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [empcod], [lpvret], [lpvret2], [lpvret1], [lpvfch], [plventcod], [plvgrutip] "
                  cmdbuf = cmdbuf + "  FROM [lpvclt] (FASTFIRSTROW NOLOCK) WHERE ([empcod] = ?) AND ([plvgrutip] like ?) "
                  cmdbuf = cmdbuf + "  AND ([plventcod] >= ?) AND ([lpvfch] >= ?) AND ([lpvret1] >= ?) AND ([lpvret2] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([lpvret] >= ?) ORDER BY [empcod], [plvgrutip], [plventcod], [lpvfch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07152,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07152,9)
                  THISFORM.GX_DB_BindColsW07152_01 ()
                  THISFORM.GX_DB_BindParmW07152_01 ()
               ENDIF
               AuxA2113xEmpC = THISFORM.A2113xEmpC
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07152,1,@AuxA2113xEmpC,0)
               THISFORM.A2113xEmpC = AuxA2113xEmpC
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07152,2,PADR( TRIM(THISFORM.AV5C2103),2, '%'),LEN(PADR( TRIM(THISFORM.AV5C2103),2, '%')),0)
               AuxAV6C2104 = THISFORM.AV6C2104
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07152,3,@AuxAV6C2104,0)
               THISFORM.AV6C2104 = AuxAV6C2104
               AuxAV7C2105 = THISFORM.AV7C2105
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07152,4,@AuxAV7C2105,0)
               THISFORM.AV7C2105 = AuxAV7C2105
               AuxAV8C2122 = THISFORM.AV8C2122
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07152,5,@AuxAV8C2122,0)
               THISFORM.AV8C2122 = AuxAV8C2122
               AuxAV9C2123 = THISFORM.AV9C2123
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07152,6,@AuxAV9C2123,0)
               THISFORM.AV9C2123 = AuxAV9C2123
               AuxAV10C2124 = THISFORM.AV10C2124
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07152,7,@AuxAV10C2124,0)
               THISFORM.AV10C2124 = AuxAV10C2124
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07152) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07152 = Gx_err
               THISFORM.GX_DB_GetW07152_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07152 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07152) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07152 = Gx_err
                  THISFORM.GX_DB_GetW07152_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07152 <> 101
               BRKVJV2 = .F.
               THISFORM.A2124xLpvR = THISFORM.Buf_W07152_2124xLpvRet
               THISFORM.A2123xLpvR = THISFORM.Buf_W07152_2123xLpvRet2
               THISFORM.A2122xLpvR = THISFORM.Buf_W07152_2122xLpvRet1
               THISFORM.A2105xLpvF = THISFORM.Buf_W07152_2105xLpvFch
               THISFORM.A2104xPlVE = THISFORM.Buf_W07152_2104xPlVEntCod
               THISFORM.A2103xPlVG = THISFORM.Buf_W07152_2103xPlVGruTip
               GX_SFLOAD = 0
               THISFORM.U12VJV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07152) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07152 = Gx_err
               THISFORM.GX_DB_GetW07152_01 ()
            ENDDO
         ENDIF
      ENDPROC
