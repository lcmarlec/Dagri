      PROCEDURE LoadObj(LoadType)
         * Default load for WKP
         GX_CUOPER = 1
         GX_CUERR = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 1
               THISFORM.U25V0K2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
         IF GX_CUERR != 0
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
      RETURN .T.
      ENDPROC
