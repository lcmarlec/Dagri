      PROCEDURE CreateTemp
         LOCAL SCW6S2
         SCW6S2 = ""
         IF USED( "SCW6S2" )
            SELECT SCW6S2
            SCW6S2 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW6S2
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 10 , 4]

            GX_STRUCT[ 1 ,1]= "sA47AudEmp"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA46AudSis"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA51AudCod"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA50AudCod"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA48AudFch"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA14AudNro"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 30
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA13AudObs"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 60
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA49Audtim"
            GX_STRUCT[ 8 ,2]= "C"
            GX_STRUCT[ 8 ,3]= 8
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "sA52AudUsu"
            GX_STRUCT[ 9 ,2]= "C"
            GX_STRUCT[ 9 ,3]= 10
            GX_STRUCT[ 9 ,4]= 0

            GX_STRUCT[ 10 ,1]= "sA53AudWrk"
            GX_STRUCT[ 10 ,2]= "C"
            GX_STRUCT[ 10 ,3]= 10
            GX_STRUCT[ 10 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW6S2 = GETE('z:\temp') + '\' + SCW6S2
            ENDIF
            CREATE DBF (SCW6S2) FROM ARRAY GX_STRUCT
            USE
            USE (SCW6S2) EXCLUSIVE ALIAS SCW6S2
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW6S2
         THIS.GX_SfAlias = "SCW6S2"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00062" , @HStmt_W00062 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WAUDIT","W00062","",GX_CURSOR_TYPE_READONLY,@HStmt_W00062) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AudWrk], [AudUsu], [Audtime], [AudObs], [AudNro], [AudFch], [AudCodAct], "
                  cmdbuf = cmdbuf + "  [AudCodObj], [AudSist], [AudEmpCod] FROM [AUDIT] (FASTFIRSTROW NOLOCK) ORDER BY "
                  cmdbuf = cmdbuf + "  [AudSist], [AudEmpCod], [AudFch], [Audtime], [AudCodObj], [AudNro], [AudUsu]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00062,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00062,22)
                  THISFORM.GX_DB_BindColsW00062_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00062 = Gx_err
               THISFORM.GX_DB_GetW00062_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00062 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00062) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00062 = Gx_err
                  THISFORM.GX_DB_GetW00062_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00062 <> 101
               BRKV062 = .F.
               THISFORM.A53AudWrk = THISFORM.Buf_W00062_53AudWrk
               THISFORM.A52AudUsu = THISFORM.Buf_W00062_52AudUsu
               THISFORM.A49Audtime = THISFORM.Buf_W00062_49Audtime
               THISFORM.A13AudObs = THISFORM.Buf_W00062_13AudObs
               THISFORM.A14AudNro = THISFORM.Buf_W00062_14AudNro
               THISFORM.A48AudFch = THISFORM.Buf_W00062_48AudFch
               THISFORM.A50AudCodA = THISFORM.Buf_W00062_50AudCodAct
               THISFORM.A51AudCodO = THISFORM.Buf_W00062_51AudCodObj
               THISFORM.A46AudSist = THISFORM.Buf_W00062_46AudSist
               THISFORM.A47AudEmpC = THISFORM.Buf_W00062_47AudEmpCod
               GX_SFLOAD = 0
               THISFORM.U11V062 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00062 = Gx_err
               THISFORM.GX_DB_GetW00062_01 ()
            ENDDO
         ENDIF
      ENDPROC
