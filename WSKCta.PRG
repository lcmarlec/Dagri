         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW145S15
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA86BcoCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA87BcoDsc"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA76BcoCta"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA82BcoFDe"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA83BcoFHa"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV15Saldo"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "sA80BcoAut"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 1
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW145S15 = GETE('z:\temp') + '\' + SCW145S15
            ENDIF
            CREATE DBF (SCW145S15) FROM ARRAY GX_STRUCT
            USE
            USE (SCW145S15) EXCLUSIVE ALIAS SCW145S15
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW145S15
         THIS.GX_SfAlias = "SCW145S15"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01452" , @HStmt_W01452 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKCTA","W01452","",GX_CURSOR_TYPE_READONLY,@HStmt_W01452) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[BcoCtaNro], T1.[BcoFDe], T1.[BcoCta], T2.[BcoCod], T3.[BcoDsc], T2.[BcoNroUlt], "
                  cmdbuf = cmdbuf + "  T1.[BcoSld], T2.[BcoAut], T1.[BcoFHa] FROM (([BANCOS2] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CTAS] T2 (NOLOCK) ON T2.[BcoCta] = T1.[BcoCta]) LEFT JOIN [BANCOS] T3 "
                  cmdbuf = cmdbuf + "  (NOLOCK) ON T3.[BcoCod] = T2.[BcoCod]) ORDER BY T1.[BcoCta], T1.[BcoFDe]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01452,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01452,13)
                  THISFORM.GX_DB_BindColsW01452_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01452) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01452 = Gx_err
               THISFORM.GX_DB_GetW01452_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01452 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01452 <> 101
               BRKV412 = .F.
               THISFORM.A77BcoCtaN = THISFORM.Buf_W01452_77BcoCtaNro
               THISFORM.A82BcoFDe = THISFORM.Buf_W01452_82BcoFDe
               THISFORM.A76BcoCta = THISFORM.Buf_W01452_76BcoCta
               THISFORM.A86BcoCod = THISFORM.Buf_W01452_86BcoCod
               THISFORM.A87BcoDsc = THISFORM.Buf_W01452_87BcoDsc
               THISFORM.A81BcoNroU = THISFORM.Buf_W01452_81BcoNroUlt
               THISFORM.A85BcoSld = THISFORM.Buf_W01452_85BcoSld
               THISFORM.A80BcoAut = THISFORM.Buf_W01452_80BcoAut
               THISFORM.A83BcoFHa = THISFORM.Buf_W01452_83BcoFHa
               THISFORM.A77BcoCtaN = THISFORM.Buf_W01452_77BcoCtaNro
               THISFORM.A86BcoCod = THISFORM.Buf_W01452_86BcoCod
               THISFORM.A81BcoNroU = THISFORM.Buf_W01452_81BcoNroUlt
               THISFORM.A80BcoAut = THISFORM.Buf_W01452_80BcoAut
               THISFORM.A87BcoDsc = THISFORM.Buf_W01452_87BcoDsc
               GX_SFLOAD = 0
               THISFORM.U13V412 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKV412
                  BRKV412 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01452) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01452 = Gx_err
                  THISFORM.GX_DB_GetW01452_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
