                  THISFORM.GX_DB_GetW08822_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08822 <> 101
               BRKVOI2 = .F.
               THISFORM.A2304AreDs = THISFORM.Buf_W08822_2304AreDsc
               THISFORM.A2292AreCo = THISFORM.Buf_W08822_2292AreCod
               GX_SFLOAD = 0
               THISFORM.U15VOI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08822 = Gx_err
               THISFORM.GX_DB_GetW08822_01 ()
            ENDDO
         ENDIF
      ENDPROC
