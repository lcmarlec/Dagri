            THISFORM. cCW291S11 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW291S11 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW291S11 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.AV23Fecnva = THIS.Value
         ENDIF
