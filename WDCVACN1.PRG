      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02912" , @HStmt_W02912 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCVACN1","W02912","",GX_CURSOR_TYPE_READONLY,@HStmt_W02912) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVEntLgCo] AS DcVEntLgCo, T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[DcVNroInt], T1.[DcVTot], T3.[EntLgDom] AS DcVEntLgDo, T2.[EntRaz] AS DcVEntRaz, "
                  cmdbuf = cmdbuf + "  T1.[DcVEntCod] AS DcVEntCod, T1.[DcVFch], T1.[DcVNro], T1.[DcVSuc], T1.[DcVSer], "
                  cmdbuf = cmdbuf + "  T1.[DcVTip] FROM (([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[EntGruTip] = T1.[DcVEntGruT] AND T3.[EntCod] = T1.[DcVEntCod] AND T3.[EntLgCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntLgCo]) WHERE (T1.[EmpCod] = ?) AND (T1.[DcVFch] >= ?) AND (T1.[DcVTip] "
                  cmdbuf = cmdbuf + "  = 'FC01' or T1.[DcVTip] = 'NCDE' or T1.[DcVTip] = 'NCSO' or T1.[DcVTip] = 'NCFA' "
                  cmdbuf = cmdbuf + "  or T1.[DcVTip] = 'NCVA' or T1.[DcVTip] = 'NDVA' or T1.[DcVTip] = 'NDSA' or T1.[DcVTip] "
                  cmdbuf = cmdbuf + "  = 'NDCH' or T1.[DcVTip] = 'NCAF') AND (T1.[DcVSuc] = ?) AND (T1.[DcVNro] >= ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[DcVNro] <= ?) ORDER BY T1.[EmpCod], T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02912,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02912,15)
                  THISFORM.GX_DB_BindColsW02912_01 ()
                  THISFORM.GX_DB_BindParmW02912_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02912,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV13Fecha = THISFORM.AV13Fecha
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02912,2,@AuxAV13Fecha,0)
               THISFORM.AV13Fecha = AuxAV13Fecha
               AuxAV14Sucori = THISFORM.AV14Sucori
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02912,3,@AuxAV14Sucori,0)
               THISFORM.AV14Sucori = AuxAV14Sucori
               AuxAV15Nroori = THISFORM.AV15Nroori
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02912,4,@AuxAV15Nroori,0)
               THISFORM.AV15Nroori = AuxAV15Nroori
               AuxAV16Nroori = THISFORM.AV16Nroori
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02912,5,@AuxAV16Nroori,0)
               THISFORM.AV16Nroori = AuxAV16Nroori
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02912 = Gx_err
               THISFORM.GX_DB_GetW02912_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WDCVACN1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02912 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02912) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02912 = Gx_err
                  THISFORM.GX_DB_GetW02912_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02912 <> 101
               BRKV832 = .F.
               THISFORM.AV20Nvosuc = 0
               THISFORM.AV21Nvonro = 0
               THISFORM.AV23Fecnva = CTOD("  /  /  ")
               THISFORM.A416DcVEnt = THISFORM.Buf_W02912_416DcVEntGruT
               THISFORM.A419DcVEnt = THISFORM.Buf_W02912_419DcVEntLgCo
               THISFORM.A2EmpCod = THISFORM.Buf_W02912_2EmpCod
               THISFORM.A415DcVNro = THISFORM.Buf_W02912_415DcVNroInt
               THISFORM.A464DcVTot = THISFORM.Buf_W02912_464DcVTot
               THISFORM.A420DcVEnt = THISFORM.Buf_W02912_420DcVEntLgDo
               THISFORM.A418DcVEnt = THISFORM.Buf_W02912_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W02912_417DcVEntCod
               THISFORM.A421DcVFch = THISFORM.Buf_W02912_421DcVFch
               THISFORM.A425DcVNro = THISFORM.Buf_W02912_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W02912_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W02912_423DcVSer
               THISFORM.A422DcVTip = THISFORM.Buf_W02912_422DcVTip
               THISFORM.A418DcVEnt = THISFORM.Buf_W02912_418DcVEntRaz
               THISFORM.A420DcVEnt = THISFORM.Buf_W02912_420DcVEntLgDo
               GX_SFLOAD = 0
               THISFORM.U15V832 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02912 = Gx_err
               THISFORM.GX_DB_GetW02912_01 ()
            ENDDO
         ENDIF
      ENDPROC
