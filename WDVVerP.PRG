      PROCEDURE CreateTemp
         LOCAL SCW48S8
         SCW48S8 = ""
         IF USED( "SCW48S8" )
            SELECT SCW48S8
            SCW48S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW48S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA859RCVFc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA865RCVTi"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA866RCVSe"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA867RCVSu"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA868RCVNr"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA875RCVIm"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "sA861RCVEs"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 240
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA858RCVNr"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW48S8 = GETE('z:\temp') + '\' + SCW48S8
            ENDIF
            CREATE DBF (SCW48S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW48S8) EXCLUSIVE ALIAS SCW48S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW48S8
         THIS.GX_SfAlias = "SCW48S8"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00482" , @HStmt_W00482 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVVERP","W00482","",GX_CURSOR_TYPE_READONLY,@HStmt_W00482) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RCVNroLin], T1.[RCVNroIImp], T1.[EmpCod], T1.[RCVNroI], T2.[RCVEst], T1.[RCVImpImp], "
                  cmdbuf = cmdbuf + "  T2.[RCVNro], T2.[RCVSuc], T2.[RCVSer], T2.[RCVTip], T2.[RCVFch] FROM ([RECIBOS1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [RECIBOS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[RCVNroI] = T1.[RCVNroI]) WHERE (T1.[EmpCod] = ? and T1.[RCVNroIImp] = ?) "
                  cmdbuf = cmdbuf + "  AND (T2.[RCVTip] <> 'RCFX' or ? = 1) ORDER BY T1.[EmpCod], T1.[RCVNroIImp]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00482,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00482,9)
                  THISFORM.GX_DB_BindColsW00482_01 ()
                  THISFORM.GX_DB_BindParmW00482_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00482,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxA870RCVNro = THISFORM.A870RCVNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00482,2,@AuxA870RCVNro,0)
               THISFORM.A870RCVNro = AuxA870RCVNro
               AuxAV25Factor = THISFORM.AV25Factor
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00482,3,@AuxAV25Factor,0)
               THISFORM.AV25Factor = AuxAV25Factor
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00482) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00482 = Gx_err
               THISFORM.GX_DB_GetW00482_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WDVVerP"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00482 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00482) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00482 = Gx_err
                  THISFORM.GX_DB_GetW00482_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00482 <> 101
               BRKV1C2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W00482_2EmpCod
               THISFORM.A858RCVNro = THISFORM.Buf_W00482_858RCVNroI
               THISFORM.A861RCVEst = THISFORM.Buf_W00482_861RCVEst
               THISFORM.A875RCVImp = THISFORM.Buf_W00482_875RCVImpImp
               THISFORM.A868RCVNro = THISFORM.Buf_W00482_868RCVNro
               THISFORM.A867RCVSuc = THISFORM.Buf_W00482_867RCVSuc
               THISFORM.A866RCVSer = THISFORM.Buf_W00482_866RCVSer
               THISFORM.A865RCVTip = THISFORM.Buf_W00482_865RCVTip
               THISFORM.A859RCVFch = THISFORM.Buf_W00482_859RCVFch
               THISFORM.A861RCVEst = THISFORM.Buf_W00482_861RCVEst
               THISFORM.A868RCVNro = THISFORM.Buf_W00482_868RCVNro
               THISFORM.A867RCVSuc = THISFORM.Buf_W00482_867RCVSuc
               THISFORM.A866RCVSer = THISFORM.Buf_W00482_866RCVSer
               THISFORM.A865RCVTip = THISFORM.Buf_W00482_865RCVTip
               THISFORM.A859RCVFch = THISFORM.Buf_W00482_859RCVFch
               GX_SFLOAD = 0
               THISFORM.U15V1C2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00482) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00482 = Gx_err
               THISFORM.GX_DB_GetW00482_01 ()
            ENDDO
         ENDIF
      ENDPROC
