      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05143" , @HStmt_W05143 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCVSEG1","W05143","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05143) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntLgCo] AS DcVEntLgCo, T1.[DcVNroInt], T1.[EmpCod], T1.[DcVEntGruT] "
                  cmdbuf = cmdbuf + "  AS DcVEntGruT, T1.[DcVSegObs1], T1.[DcVDesc], T1.[DcvDes1], T1.[DcvDes2], T1.[DcvDes3], "
                  cmdbuf = cmdbuf + "  T1.[DcVSer], T3.[EntLgDom] AS DcVEntLgDo, T1.[DcVEst], T1.[DcVFch], T2.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVNro], T1.[DcVSuc] FROM (([DCVENT] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[DcVEntGruT] AND T2.[EntCod] = T1.[DcVEntCod]) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [CLTES] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[DcVEntGruT] "
                  cmdbuf = cmdbuf + "  AND T3.[EntCod] = T1.[DcVEntCod] AND T3.[EntLgCod] = T1.[DcVEntLgCo]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[DcVNroInt] = ? ORDER BY T1.[EmpCod], T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05143,cmdbuf)
                  THISFORM.GX_DB_BindColsW05143_01 ()
                  THISFORM.GX_DB_BindParmW05143_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05143,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Ni = THISFORM.AV19Ni
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05143,2,@AuxAV19Ni,0)
               THISFORM.AV19Ni = AuxAV19Ni
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05143) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05143 = Gx_err
               THISFORM.GX_DB_GetW05143_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV69Pgmnam = "WDcVSeg1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05143 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05143) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05143 = Gx_err
                  THISFORM.GX_DB_GetW05143_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05143 <> 101
               BRKVEA2 = .F.
               THISFORM.AV31Cntctr = 0.0000
               THISFORM.AV37Difmot = 0
               THISFORM.AV48Dcvped = 0
               THISFORM.AV54Artvta = 0.0000
               THISFORM.AV53Artvta = 0.0000
               THISFORM.AV56Difobs = SPACE(400)
               THISFORM.A419DcVEnt = THISFORM.Buf_W05143_419DcVEntLgCo
               THISFORM.A415DcVNro = THISFORM.Buf_W05143_415DcVNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W05143_2EmpCod
               THISFORM.A416DcVEnt = THISFORM.Buf_W05143_416DcVEntGruT
               THISFORM.A1596DcVSe = THISFORM.Buf_W05143_1596DcVSegObs1
               THISFORM.A437DcVDes = THISFORM.Buf_W05143_437DcVDesc
               THISFORM.A3272DcvDe = THISFORM.Buf_W05143_3272DcvDes1
               THISFORM.A3409DcvDe = THISFORM.Buf_W05143_3409DcvDes2
               THISFORM.A3410DcvDe = THISFORM.Buf_W05143_3410DcvDes3
               THISFORM.A423DcVSer = THISFORM.Buf_W05143_423DcVSer
               THISFORM.A420DcVEnt = THISFORM.Buf_W05143_420DcVEntLgDo
               THISFORM.A466DcVEst = THISFORM.Buf_W05143_466DcVEst
               THISFORM.A421DcVFch = THISFORM.Buf_W05143_421DcVFch
               THISFORM.A418DcVEnt = THISFORM.Buf_W05143_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W05143_417DcVEntCod
               THISFORM.A425DcVNro = THISFORM.Buf_W05143_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W05143_424DcVSuc
               THISFORM.A418DcVEnt = THISFORM.Buf_W05143_418DcVEntRaz
               THISFORM.A420DcVEnt = THISFORM.Buf_W05143_420DcVEntLgDo
               GX_SFLOAD = 0
               THISFORM.U19VEA2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
