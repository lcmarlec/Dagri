         IF THISFORM.GX_last_fld_lvl = 3
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 3
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 3 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00053) , "TARTSTKB" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00052) , "TARTSTKB" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00054) , "TARTSTKB" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00055) , "TARTSTKB" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT5V9 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 3
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM. gx_3insert
            THISFORM. gx_3insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 3 )
            THISFORM. cCT5A38 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 3
            THISFORM.SetLevel( 3 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT5V17 .InitLevel( 3 )
            THISFORM.GX_last_fld_lvl = 3
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         SET TOPIC TO Emprnomb
         THISFORM.Gx_cursor = "THISFORM.AV9Emprnom"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl3
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_3insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_3insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_3insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_3insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT5A38 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_3insert = .F.
               THISFORM.gx_insert = THISFORM. gx_3insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T00052,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA3FamCod = THISFORM.A3FamCod
            Gx_err = GX_DB_SetInt( HStmt_T00052,2,@AuxA3FamCod,0)
            THISFORM.A3FamCod = AuxA3FamCod
            AuxA4FamSubCo = THISFORM.A4FamSubCo
            Gx_err = GX_DB_SetInt( HStmt_T00052,3,@AuxA4FamSubCo,0)
            THISFORM.A4FamSubCo = AuxA4FamSubCo
            AuxA5ArtCod = THISFORM.A5ArtCod
            Gx_err = GX_DB_SetInt( HStmt_T00052,4,@AuxA5ArtCod,0)
            THISFORM.A5ArtCod = AuxA5ArtCod
            AuxA34LugCod = THISFORM.A34LugCod
            Gx_err = GX_DB_SetInt( HStmt_T00052,5,@AuxA34LugCod,0)
            THISFORM.A34LugCod = AuxA34LugCod
            AuxA37PrvCod = THISFORM.A37PrvCod
            Gx_err = GX_DB_SetLong( HStmt_T00052,6,@AuxA37PrvCod,0)
            THISFORM.A37PrvCod = AuxA37PrvCod
            AuxA38LotNro = THISFORM.A38LotNro
            Gx_err = GX_DB_SetStr( HStmt_T00052,7,AuxA38LotNro,12,0)
            THISFORM.A38LotNro = AuxA38LotNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00052) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00052 = Gx_err
            THISFORM.GX_DB_GetT00052_01 ()
            IF .NOT. THISFORM.T00052 <> 103
               DO GX_ERRMW WITH "ARTSTKB reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00052 = 101
               DO GX_ERRMW WITH "ARTSTKB fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00057" , @HStmt_T00057 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTSTKB","T00057","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00057) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ARTSTKB] ([EmpCod], [FamCod], [FamSubCod], [ArtCod], [LugCod], [PrvCod], "
                  cmdbuf = cmdbuf + "  [LotNro]) VALUES (?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00057,cmdbuf)
                  THISFORM.GX_DB_BindParmT00057_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00057,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00057,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T00057,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T00057,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA34LugCod = THISFORM.A34LugCod
               Gx_err = GX_DB_SetInt( HStmt_T00057,5,@AuxA34LugCod,0)
               THISFORM.A34LugCod = AuxA34LugCod
               AuxA37PrvCod = THISFORM.A37PrvCod
               Gx_err = GX_DB_SetLong( HStmt_T00057,6,@AuxA37PrvCod,0)
               THISFORM.A37PrvCod = AuxA37PrvCod
               AuxA38LotNro = THISFORM.A38LotNro
               Gx_err = GX_DB_SetStr( HStmt_T00057,7,AuxA38LotNro,12,0)
               THISFORM.A38LotNro = AuxA38LotNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00057) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00057 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00057) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00057 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00058" , @HStmt_T00058 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTSTKB","T00058","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00058) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ARTSTKB]  WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND "
                  cmdbuf = cmdbuf + "  [ArtCod] = ? AND [LugCod] = ? AND [PrvCod] = ? AND [LotNro] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00058,cmdbuf)
                  THISFORM.GX_DB_BindParmT00058_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00058,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00058,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T00058,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T00058,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA34LugCod = THISFORM.A34LugCod
               Gx_err = GX_DB_SetInt( HStmt_T00058,5,@AuxA34LugCod,0)
               THISFORM.A34LugCod = AuxA34LugCod
               AuxA37PrvCod = THISFORM.A37PrvCod
               Gx_err = GX_DB_SetLong( HStmt_T00058,6,@AuxA37PrvCod,0)
               THISFORM.A37PrvCod = AuxA37PrvCod
               AuxA38LotNro = THISFORM.A38LotNro
               Gx_err = GX_DB_SetStr( HStmt_T00058,7,AuxA38LotNro,12,0)
               THISFORM.A38LotNro = AuxA38LotNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00058) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00058 = Gx_err
               THISFORM.T00052 = iif( THISFORM.T00058 = 0 , 104 , THISFORM.T00058 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00058) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
