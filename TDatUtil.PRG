                  ENDDO
                  THISFORM.T02013 = Gx_err
                  THISFORM.GX_DB_GetT02013_01 ()
                  THISFORM. cCT201A1965 . ZM5L228 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC5L228 ()
               THISFORM. cCT201A1965 . ZM5L228 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
