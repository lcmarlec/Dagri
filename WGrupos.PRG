      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00642" , @HStmt_W00642 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGRUPOS","W00642","",GX_CURSOR_TYPE_READONLY,@HStmt_W00642) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [GruTip], [EmpCod], [GruDsc], [GruCod] FROM [GRUPO] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ? and [GruTip] = ?) AND ([GruDsc] like ?) ORDER BY [EmpCod], [GruTip], "
                  cmdbuf = cmdbuf + "  [GruCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00642,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00642,7)
                  THISFORM.GX_DB_BindColsW00642_01 ()
                  THISFORM.GX_DB_BindParmW00642_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00642,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Grutip = THISFORM.AV21Grutip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00642,2,AuxAV21Grutip,2,0)
               THISFORM.AV21Grutip = AuxAV21Grutip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00642,3,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00642 = Gx_err
               THISFORM.GX_DB_GetW00642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WGrupos"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00642 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00642) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00642 = Gx_err
                  THISFORM.GX_DB_GetW00642_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00642 <> 101
               BRKV1S2 = .F.
               THISFORM.A609GruTip = THISFORM.Buf_W00642_609GruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W00642_2EmpCod
               THISFORM.A611GruDsc = THISFORM.Buf_W00642_611GruDsc
               THISFORM.A610GruCod = THISFORM.Buf_W00642_610GruCod
               GX_SFLOAD = 0
               THISFORM.U16V1S2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00642 = Gx_err
               THISFORM.GX_DB_GetW00642_01 ()
            ENDDO
         ENDIF
