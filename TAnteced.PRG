      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2861AntTD = THISFORM.A2861AntTD
            Gx_err = GX_DB_SetInt( HStmt_T02962,1,@AuxA2861AntTD,0)
            THISFORM.A2861AntTD = AuxA2861AntTD
            AuxA2862AntND = THISFORM.A2862AntND
            Gx_err = GX_DB_SetLong( HStmt_T02962,2,@AuxA2862AntND,0)
            THISFORM.A2862AntND = AuxA2862AntND
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02962) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02962 = Gx_err
            THISFORM.GX_DB_GetT02962_01 ()
            IF .NOT. THISFORM.T02962 <> 103
               DO GX_ERRMW WITH "ANTECEDE reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02962 = 101 .OR. THISFORM.Z2863AntNo <> THISFORM.Buf_T02962_2863AntNom
               DO GX_ERRMW WITH "ANTECEDE fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02965" , @HStmt_T02965 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TANTECED","T02965","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02965) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ANTECEDE] ([AntTDoc], [AntNDoc], [AntNom], [AntTObs], [AntObs]) VALUES "
                  cmdbuf = cmdbuf + "  (?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02965,cmdbuf)
                  THISFORM.GX_DB_BindParmT02965_01 ()
               ENDIF
               AuxA2861AntTD = THISFORM.A2861AntTD
               Gx_err = GX_DB_SetInt( HStmt_T02965,1,@AuxA2861AntTD,0)
               THISFORM.A2861AntTD = AuxA2861AntTD
               AuxA2862AntND = THISFORM.A2862AntND
               Gx_err = GX_DB_SetLong( HStmt_T02965,2,@AuxA2862AntND,0)
               THISFORM.A2862AntND = AuxA2862AntND
               AuxA2863AntNo = THISFORM.A2863AntNo
               Gx_err = GX_DB_SetStr( HStmt_T02965,3,AuxA2863AntNo,40,0)
               THISFORM.A2863AntNo = AuxA2863AntNo
               AuxA2864AntTO = THISFORM.A2864AntTO
               Gx_err = GX_DB_SetInt( HStmt_T02965,4,@AuxA2864AntTO,0)
               THISFORM.A2864AntTO = AuxA2864AntTO
               AuxA2865AntOb = THISFORM.A2865AntOb
               Gx_err = GX_DB_SetStr( HStmt_T02965,5,AuxA2865AntOb,1000,0)
               THISFORM.A2865AntOb = AuxA2865AntOb
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02965) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02965 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02965) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02965 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02966" , @HStmt_T02966 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TANTECED","T02966","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02966) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [ANTECEDE] SET [AntNom]=?, [AntTObs]=?, [AntObs]=?  WHERE [AntTDoc] = ? AND "
                  cmdbuf = cmdbuf + "  [AntNDoc] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02966,cmdbuf)
                  THISFORM.GX_DB_BindParmT02966_01 ()
               ENDIF
               AuxA2863AntNo = THISFORM.A2863AntNo
               Gx_err = GX_DB_SetStr( HStmt_T02966,1,AuxA2863AntNo,40,0)
               THISFORM.A2863AntNo = AuxA2863AntNo
               AuxA2864AntTO = THISFORM.A2864AntTO
               Gx_err = GX_DB_SetInt( HStmt_T02966,2,@AuxA2864AntTO,0)
               THISFORM.A2864AntTO = AuxA2864AntTO
               AuxA2865AntOb = THISFORM.A2865AntOb
               Gx_err = GX_DB_SetStr( HStmt_T02966,3,AuxA2865AntOb,1000,0)
               THISFORM.A2865AntOb = AuxA2865AntOb
               AuxA2861AntTD = THISFORM.A2861AntTD
               Gx_err = GX_DB_SetInt( HStmt_T02966,4,@AuxA2861AntTD,0)
               THISFORM.A2861AntTD = AuxA2861AntTD
               AuxA2862AntND = THISFORM.A2862AntND
               Gx_err = GX_DB_SetLong( HStmt_T02966,5,@AuxA2862AntND,0)
               THISFORM.A2862AntND = AuxA2862AntND
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02966) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02966 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02966) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02967" , @HStmt_T02967 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TANTECED","T02967","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02967) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ANTECEDE]  WHERE [AntTDoc] = ? AND [AntNDoc] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02967,cmdbuf)
                  THISFORM.GX_DB_BindParmT02967_01 ()
               ENDIF
               AuxA2861AntTD = THISFORM.A2861AntTD
               Gx_err = GX_DB_SetInt( HStmt_T02967,1,@AuxA2861AntTD,0)
               THISFORM.A2861AntTD = AuxA2861AntTD
               AuxA2862AntND = THISFORM.A2862AntND
               Gx_err = GX_DB_SetLong( HStmt_T02967,2,@AuxA2862AntND,0)
               THISFORM.A2862AntND = AuxA2862AntND
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02967) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02967 = Gx_err
               THISFORM.T02962 = iif( THISFORM.T02967 = 0 , 104 , THISFORM.T02967 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02967) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
