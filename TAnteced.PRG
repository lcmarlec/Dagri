               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2865AntOb"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXEditBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl326
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_326insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_326insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_326insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_326insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT296A2862 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_326insert = .F.
               THISFORM.gx_insert = THISFORM. gx_326insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
