         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T005416" , @HStmt_T005416 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TFORPRO","T005416","",GX_CURSOR_TYPE_READONLY,@HStmt_T005416) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [ForFamCod] AS ForFamCod, [ForFamSubC] AS ForFamSubC, [ForArtCod] "
                  cmdbuf = cmdbuf + "  AS ForArtCod, [ForNro], [For1FamCod], [For1FamSub], [For1ArtCod], [For1PrvTip], "
                  cmdbuf = cmdbuf + "  [For1Por], [For1Asi], [For1Mer], [For1Ctr], [For1PrvCod] FROM [FORPRO1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [ForFamCod] = ? AND [ForFamSubC] = ? AND [ForArtCod] = ? "
                  cmdbuf = cmdbuf + "  AND [ForNro] = ? ORDER BY [EmpCod], [ForFamCod], [ForFamSubC], [ForArtCod], [ForNro], "
                  cmdbuf = cmdbuf + "  [For1FamCod], [For1FamSub], [For1ArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T005416,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T005416,13)
                  THISFORM.GX_DB_BindColsT005416_01 ()
                  THISFORM.GX_DB_BindParmT005416_01 ()
