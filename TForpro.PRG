         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 57
            IF THIS.gx_ret > 0
               gx_val_ret = THIS.gx_ret
            ELSE
               gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            ENDIF
            IF gx_val_ret >= 0
               IF THIS.GX_Mouse
                  THIS.GotMouseDown()
               ENDIF
               NODEFAULT
               IF gx_val_ret >= 0
                  IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                     THISFORM.ReleaseAll()
                  ENDIF
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
            IF THISFORM.GX_NewLastVld != -1
               THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
               THISFORM.GX_NewLastVld = -1
               NODEFAULT
               RETURN
            ENDIF
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 57 )
