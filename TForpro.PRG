      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S586ForFam
         LOCAL S587ForFam
         LOCAL S588ForArt
         LOCAL S590ForNro
         LOCAL S595For1Fa
         LOCAL S596For1Fa
         LOCAL S597For1Ar
         S2EmpCod = THISFORM.A2EmpCod
         S586ForFam = THISFORM.A586ForFam
         S587ForFam = THISFORM.A587ForFam
         S588ForArt = THISFORM.A588ForArt
         S590ForNro = THISFORM.A590ForNro
         S595For1Fa = THISFORM.A595For1Fa
         S596For1Fa = THISFORM.A596For1Fa
         S597For1Ar = THISFORM.A597For1Ar
         THISFORM.A595For1Fa = THISFORM.M595For1Fa
         THISFORM.A596For1Fa = THISFORM.M596For1Fa
         THISFORM.A597For1Ar = THISFORM.M597For1Ar
         THISFORM. cCT54S24 .SaveTemp()
         THISFORM. cCT54S24 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT54S24 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT54S24 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT54S24 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S586ForFam = THISFORM.A586ForFam .AND. S587ForFam = THISFORM.A587ForFam .AND. S588ForArt = THISFORM.A588ForArt .AND. S590ForNro = THISFORM.A590ForNro
         Gx_fcond = Gx_fcond .AND. S595For1Fa = THISFORM.A595For1Fa .AND. S596For1Fa = THISFORM.A596For1Fa .AND. S597For1Ar = THISFORM.A597For1Ar
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT54S24 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT54S24 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S586ForFam = THISFORM.A586ForFam .AND. S587ForFam = THISFORM.A587ForFam .AND. S588ForArt = THISFORM.A588ForArt .AND. S590ForNro = THISFORM.A590ForNro
            Gx_fcond = Gx_fcond .AND. S595For1Fa = THISFORM.A595For1Fa .AND. S596For1Fa = THISFORM.A596For1Fa .AND. S597For1Ar = THISFORM.A597For1Ar
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT54S24 .Refresh()
               THISFORM. cCT54S24 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A586ForFam = S586ForFam
               THISFORM.A587ForFam = S587ForFam
               THISFORM.A588ForArt = S588ForArt
               THISFORM.A590ForNro = S590ForNro
               THISFORM.A595For1Fa = S595For1Fa
               THISFORM.A596For1Fa = S596For1Fa
               THISFORM.A597For1Ar = S597For1Ar
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT54S24 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT54S24 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S586ForFam = THISFORM.A586ForFam .AND. S587ForFam = THISFORM.A587ForFam .AND. S588ForArt = THISFORM.A588ForArt .AND. S590ForNro = THISFORM.A590ForNro
            Gx_fcond = Gx_fcond .AND. S595For1Fa = THISFORM.A595For1Fa .AND. S596For1Fa = THISFORM.A596For1Fa .AND. S597For1Ar = THISFORM.A597For1Ar
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT54S24 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S586ForFam = THISFORM.A586ForFam .AND. S587ForFam = THISFORM.A587ForFam .AND. S588ForArt = THISFORM.A588ForArt .AND. S590ForNro = THISFORM.A590ForNro
               Gx_fcond = Gx_fcond .AND. S595For1Fa = THISFORM.A595For1Fa .AND. S596For1Fa = THISFORM.A596For1Fa .AND. S597For1Ar = THISFORM.A597For1Ar
            ENDDO
            IF sf_err != 0
               THISFORM. cCT54S24 .AppendRow()
               THISFORM. cCT54S24 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A586ForFam = S586ForFam
               THISFORM.A587ForFam = S587ForFam
               THISFORM.A588ForArt = S588ForArt
               THISFORM.A590ForNro = S590ForNro
               THISFORM.A595For1Fa = S595For1Fa
               THISFORM.A596For1Fa = S596For1Fa
               THISFORM.A597For1Ar = S597For1Ar
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A586ForFam = S586ForFam
         THISFORM.A587ForFam = S587ForFam
         THISFORM.A588ForArt = S588ForArt
         THISFORM.A590ForNro = S590ForNro
         THISFORM.A595For1Fa = S595For1Fa
         THISFORM.A596For1Fa = S596For1Fa
         THISFORM.A597For1Ar = S597For1Ar
         RETURN .F.
      ENDFUNC
