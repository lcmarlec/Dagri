                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T005416) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T005416 = Gx_err
               THISFORM.GX_DB_GetT005416_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
