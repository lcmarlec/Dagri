            IF THISFORM.T02932 = 101 .OR. THISFORM.Z2830DRDsc <> THISFORM.Buf_T02932_2830DRDsc
               DO GX_ERRMW WITH "DOCREQ fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02935" , @HStmt_T02935 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDOCREQ","T02935","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02935) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [DOCREQ] ([DRCod], [DRDsc]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02935,cmdbuf)
                  THISFORM.GX_DB_BindParmT02935_01 ()
               ENDIF
               AuxA2829DRCod = THISFORM.A2829DRCod
               Gx_err = GX_DB_SetInt( HStmt_T02935,1,@AuxA2829DRCod,0)
               THISFORM.A2829DRCod = AuxA2829DRCod
               AuxA2830DRDsc = THISFORM.A2830DRDsc
               Gx_err = GX_DB_SetStr( HStmt_T02935,2,AuxA2830DRDsc,30,0)
               THISFORM.A2830DRDsc = AuxA2830DRDsc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02935) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02935 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02935) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02935 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02936" , @HStmt_T02936 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDOCREQ","T02936","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02936) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [DOCREQ] SET [DRDsc]=?  WHERE [DRCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02936,cmdbuf)
                  THISFORM.GX_DB_BindParmT02936_01 ()
               ENDIF
               AuxA2830DRDsc = THISFORM.A2830DRDsc
               Gx_err = GX_DB_SetStr( HStmt_T02936,1,AuxA2830DRDsc,30,0)
               THISFORM.A2830DRDsc = AuxA2830DRDsc
               AuxA2829DRCod = THISFORM.A2829DRCod
               Gx_err = GX_DB_SetInt( HStmt_T02936,2,@AuxA2829DRCod,0)
               THISFORM.A2829DRCod = AuxA2829DRCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02936) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02936 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02936) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02937" , @HStmt_T02937 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDOCREQ","T02937","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02937) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [DOCREQ]  WHERE [DRCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02937,cmdbuf)
                  THISFORM.GX_DB_BindParmT02937_01 ()
               ENDIF
               AuxA2829DRCod = THISFORM.A2829DRCod
               Gx_err = GX_DB_SetInt( HStmt_T02937,1,@AuxA2829DRCod,0)
               THISFORM.A2829DRCod = AuxA2829DRCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02937) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02937 = Gx_err
               THISFORM.T02932 = iif( THISFORM.T02937 = 0 , 104 , THISFORM.T02937 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02937) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A2829DRCod , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "MAES" , Aux1 , "DOCREQ" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT293V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 320 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
