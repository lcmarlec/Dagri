               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00962,1,PADR( TRIM(THISFORM.AV6Objcod),8, '%'),LEN(PADR( TRIM(THISFORM.AV6Objcod),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00962,2,PADR( TRIM(THISFORM.AV5Objdsc),25, '%'),LEN(PADR( TRIM(THISFORM.AV5Objdsc),25, '%')),0)
               AuxAV20Modulo = THISFORM.AV20Modulo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00962,3,AuxAV20Modulo,10,0)
               THISFORM.AV20Modulo = AuxAV20Modulo
               AuxAV20Modulo = THISFORM.AV20Modulo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00962,4,AuxAV20Modulo,10,0)
               THISFORM.AV20Modulo = AuxAV20Modulo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00962 = Gx_err
               THISFORM.GX_DB_GetW00962_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV23Pgmnam = "WObj002"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00962 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00962) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00962 = Gx_err
                  THISFORM.GX_DB_GetW00962_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00962 <> 101
               BRKV2O2 = .F.
               THISFORM.A681ObjMod = THISFORM.Buf_W00962_681ObjMod
               THISFORM.A69ObjDsc = THISFORM.Buf_W00962_69ObjDsc
               THISFORM.A680ObjCod = THISFORM.Buf_W00962_680ObjCod
               GX_SFLOAD = 0
               THISFORM.U17V2O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00962 = Gx_err
               THISFORM.GX_DB_GetW00962_01 ()
            ENDDO
         ENDIF
      ENDPROC
