      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01082" , @HStmt_W01082 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODI2","W01082","",GX_CURSOR_TYPE_READONLY,@HStmt_W01082) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PrvCod], T1.[LotNro], T1.[lotraz], T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[ArtCod], T2.[LugHab], T1.[ArtStkAct], T2.[LugDsc], T1.[LugCod], T3.[ArtDsc] "
                  cmdbuf = cmdbuf + "  FROM (([ARTSTK] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [LUGALM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[LugCod] = T1.[LugCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] AND T3.[FamSubCod] = T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  AND T3.[ArtCod] = T1.[ArtCod]) WHERE (T1.[EmpCod] = ? and T1.[FamCod] = ? and T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[ArtCod] = ?) AND (T2.[LugHab] = 'S') AND (T1.[ArtStkAct] > 0) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01082,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01082,9)
                  THISFORM.GX_DB_BindColsW01082_01 ()
                  THISFORM.GX_DB_BindParmW01082_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01082,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01082,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01082,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01082,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01082 = Gx_err
               THISFORM.GX_DB_GetW01082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV16Pgmnam = "WOProdI2"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01082 = Gx_err
                  THISFORM.GX_DB_GetW01082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01082 <> 101
               BRKV302 = .F.
               THISFORM.AV11Cantid = 0.0000
               THISFORM.A36LugHab = THISFORM.Buf_W01082_36LugHab
               THISFORM.A44ArtStkA = THISFORM.Buf_W01082_44ArtStkAct
               THISFORM.A35LugDsc = THISFORM.Buf_W01082_35LugDsc
               THISFORM.A34LugCod = THISFORM.Buf_W01082_34LugCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W01082_6ArtDsc
               THISFORM.A36LugHab = THISFORM.Buf_W01082_36LugHab
               THISFORM.A35LugDsc = THISFORM.Buf_W01082_35LugDsc
               THISFORM.A6ArtDsc = THISFORM.Buf_W01082_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U14V302 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01082 = Gx_err
               THISFORM.GX_DB_GetW01082_01 ()
            ENDDO
         ENDIF
      ENDPROC
