         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW1001S18 .GX_SfAlias)
            GO TOP
            THISFORM.cCW1001S18 .Refresh()
         ENDIF
         THISFORM. cCW1001S18 .GXSetRepos( .F. )
