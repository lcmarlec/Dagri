      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV10Cmcoef = 0.0000
               THISFORM.AV18Inscri = 0
               GX_SFLOAD = 0
               THISFORM.cCW1001S18.Load ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
      PROCEDURE LoadFromTbl
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV7Pcicod WITH THISFORM.AV7Pcicod
         REPLACE VAV8Pcidgi WITH THISFORM.AV8Pcidgi
         REPLACE VAV9Pcidsc WITH THISFORM.AV9Pcidsc
         REPLACE VAV10Cmcoe WITH THISFORM.AV10Cmcoef
         REPLACE VAV18Inscr WITH THISFORM.cCW1001S18.Columns(5).Ctrl1.ValToText(THISFORM.AV18Inscri)
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV7Pcicod = VAV7Pcicod
         THISFORM.AV8Pcidgi = VAV8Pcidgi
         THISFORM.AV9Pcidsc = VAV9Pcidsc
         THISFORM.AV10Cmcoef = VAV10Cmcoe
         THISFORM.AV18Inscri = THISFORM.cCW1001S18.Columns(5).Ctrl1.TextToVal(VAV18Inscr,"int",1)
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 4
            THISFORM.AV10Cmcoef = THIS.Column4.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 5
            THISFORM.AV18Inscri = THISFORM.cCW1001S18.Columns(5).Ctrl1.TextToVal(THIS.Column5.Ctrl1.Value,"int",1)
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV7Pcicod = SPACE(4)
         THISFORM.AV8Pcidgi = 0
         THISFORM.AV9Pcidsc = SPACE(40)
         THISFORM.AV10Cmcoef = 0.0000
         THISFORM.AV18Inscri = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
