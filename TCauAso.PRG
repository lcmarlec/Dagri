      PROCEDURE CreateTemp
         LOCAL SCT330S12
         SCT330S12 = ""
         IF USED( "SCT330S12" )
            SELECT SCT330S12
            SCT330S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT330S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA3145Cauc"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3146CauD"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 50
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT330S12 = GETE('z:\temp') + '\' + SCT330S12
            ENDIF
            CREATE DBF (SCT330S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCT330S12) EXCLUSIVE ALIAS SCT330S12
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT330S12
         THIS.GX_SfAlias = "SCT330S12"
      ENDPROC
