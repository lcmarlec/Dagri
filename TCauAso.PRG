      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T033013" , @HStmt_T033013 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAUASO","T033013","",GX_CURSOR_TYPE_READONLY,@HStmt_T033013) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [CAuCod], [CaucodAs] FROM [CAUASO] (NOLOCK) WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [CAuCod] = ? ORDER BY [EmpCod], [CAuCod], [CaucodAs]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T033013,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T033013,8)
                  THISFORM.GX_DB_BindColsT033013_01 ()
                  THISFORM.GX_DB_BindParmT033013_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T033013,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2266CAuCo = THISFORM.A2266CAuCo
               Gx_err = GX_DB_SetStr( HStmt_T033013,2,AuxA2266CAuCo,4,0)
               THISFORM.A2266CAuCo = AuxA2266CAuCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T033013) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T033013 = Gx_err
               THISFORM.GX_DB_GetT033013_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T033013 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T033013) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T033013 = Gx_err
                  THISFORM.GX_DB_GetT033013_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T033013 <> 101
               BRK96364 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT330S12.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T033013_2266CAuCod = THISFORM.A2266CAuCo .AND. THISFORM.Buf_T033013_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T033013) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T033013 = Gx_err
               THISFORM.GX_DB_GetT033013_01 ()
            ENDDO
         ENDIF
      ENDPROC
