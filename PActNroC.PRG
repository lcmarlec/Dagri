      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P00012) ,  ,  ,  , CS_SQLSRV ,  )
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P00013) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   DO EP010
