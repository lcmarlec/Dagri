      cmdbuf = cmdbuf + "  >= ?) AND ([TesFchDeb] <= ? or ? = convert( DATETIME, '17530101', 112 )) ORDER BY "
      cmdbuf = cmdbuf + "  [EmpCod], [TesNroI], [TesLin]  "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_P120210,cmdbuf)
      Gx_err = GX_DB_Set_StmtFetchSize( HStmt_P120210,100)
