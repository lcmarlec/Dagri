      R996TesImp = Buf_P120210_996TesImp
      R986TesLin = Buf_P120210_986TesLin
      IF R989TesMed = AV102Mcoco
         RV77Col = RV77Col + 1
         RV94Docexc.cells(RV76Fila,RV77Col).Text = "Liquidado"
         RV77Col = RV77Col + 1
         RV94Docexc.cells(RV76Fila,RV77Col).Date = R997TesFch
         RV105Bcoct = R1006TesCt
         GX_retp = 0
         DO U14XE1
