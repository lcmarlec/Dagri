         RV94Docexc.cells(RV76Fila,RV77Col).Text = "Diferencia Cambio"
         RV77Col = RV77Col + 1
         RV94Docexc.cells(RV76Fila,RV77Col).Date = R997TesFch
         RV105Bcoct = R1006TesCt
         GX_retp = 0
         DO U14XE1
         IF GX_retp = 1
