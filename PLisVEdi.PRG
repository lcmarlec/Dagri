         RV77Col = RV77Col + 1
         RV94Docexc.cells(RV76Fila,RV77Col).Number = R1010TesCo
         RV77Col = RV77Col + 1
         RV94Docexc.cells(RV76Fila,RV77Col).Number = R996TesImp
      ELSE
