      PROCEDURE CreateTemp
         LOCAL SCW1126S21
         SCW1126S21 = ""
         IF USED( "SCW1126S21" )
            SELECT SCW1126S21
            SCW1126S21 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1126S21
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA3325PciE"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3324PciE"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3326PciE"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3327PciE"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 3

            GX_STRUCT[ 5 ,1]= "sA3329PciE"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3330PciE"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 6
            GX_STRUCT[ 6 ,4]= 3

            GX_STRUCT[ 7 ,1]= "sA3328PciE"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 100
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA2EmpCod"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 4
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "sA166EntCu"
            GX_STRUCT[ 9 ,2]= "N"
            GX_STRUCT[ 9 ,3]= 11
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1126S21 = GETE('z:\temp') + '\' + SCW1126S21
            ENDIF
            CREATE DBF (SCW1126S21) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1126S21) EXCLUSIVE ALIAS SCW1126S21
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1126S21
         THIS.GX_SfAlias = "SCW1126S21"
