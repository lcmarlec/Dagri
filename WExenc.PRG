      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11262" , @HStmt_W11262 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEXENC","W11262","",GX_CURSOR_TYPE_READONLY,@HStmt_W11262) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PciCod], [PaiCod], [PciExObs], [PciExRat], [PciExeR], [PciExPAt], [PciExeP], "
                  cmdbuf = cmdbuf + "  [PciExFH], [PciExD], [EntCui], [EmpCod] FROM [EXENCION] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([EmpCod] = ? and [EntCui] = ? and [PaiCod] = ? and [PciCod] = ?) AND ([PciExFH] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [EntCui], [PaiCod], [PciCod], [PciExFH] DESC  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11262,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11262,13)
                  THISFORM.GX_DB_BindColsW11262_01 ()
                  THISFORM.GX_DB_BindParmW11262_01 ()
               ENDIF
               AuxAV11Emprco = THISFORM.AV11Emprco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11262,1,@AuxAV11Emprco,0)
               THISFORM.AV11Emprco = AuxAV11Emprco
               AuxAV5Entcui = THISFORM.AV5Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W11262,2,@AuxAV5Entcui,0)
               THISFORM.AV5Entcui = AuxAV5Entcui
               AuxAV15Paicod = THISFORM.AV15Paicod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11262,3,AuxAV15Paicod,4,0)
               THISFORM.AV15Paicod = AuxAV15Paicod
               AuxAV7Pcicod = THISFORM.AV7Pcicod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11262,4,AuxAV7Pcicod,4,0)
               THISFORM.AV7Pcicod = AuxAV7Pcicod
               AuxAV19Fecha = THISFORM.AV19Fecha
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11262,5,@AuxAV19Fecha,0)
               THISFORM.AV19Fecha = AuxAV19Fecha
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11262 = Gx_err
               THISFORM.GX_DB_GetW11262_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WExenc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11262 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11262) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11262 = Gx_err
                  THISFORM.GX_DB_GetW11262_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11262 <> 101
               BRKVVA2 = .F.
               THISFORM.A633PciCod = THISFORM.Buf_W11262_633PciCod
               THISFORM.A631PaiCod = THISFORM.Buf_W11262_631PaiCod
               THISFORM.A3328PciEx = THISFORM.Buf_W11262_3328PciExObs
               THISFORM.A3330PciEx = THISFORM.Buf_W11262_3330PciExRat
               THISFORM.A3329PciEx = THISFORM.Buf_W11262_3329PciExeR
               THISFORM.A3327PciEx = THISFORM.Buf_W11262_3327PciExPAt
               THISFORM.A3326PciEx = THISFORM.Buf_W11262_3326PciExeP
               THISFORM.A3324PciEx = THISFORM.Buf_W11262_3324PciExFH
               THISFORM.A3325PciEx = THISFORM.Buf_W11262_3325PciExD
               THISFORM.A166EntCui = THISFORM.Buf_W11262_166EntCui
               THISFORM.A2EmpCod = THISFORM.Buf_W11262_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U16VVA2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11262 = Gx_err
               THISFORM.GX_DB_GetW11262_01 ()
            ENDDO
         ENDIF
      ENDPROC
