      PROCEDURE CreateTemp
         LOCAL SCW406S23
         SCW406S23 = ""
         IF USED( "SCW406S23" )
            SELECT SCW406S23
            SCW406S23 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW406S23
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA1294SLEE"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1299SLEE"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1295SLEN"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1296SLED"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA150EntGr"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 2
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW406S23 = GETE('z:\temp') + '\' + SCW406S23
            ENDIF
            CREATE DBF (SCW406S23) FROM ARRAY GX_STRUCT
            USE
            USE (SCW406S23) EXCLUSIVE ALIAS SCW406S23
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW406S23
         THIS.GX_SfAlias = "SCW406S23"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04062" , @HStmt_W04062 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSLESTAD","W04062","",GX_CURSOR_TYPE_READONLY,@HStmt_W04062) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntCod], T1.[EmpCod], T1.[SLEEntGruT], T2.[EntGruTip], T1.[SLEDsc], T1.[SLENro], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz], T1.[SLEEntCod] FROM ([SLESTADO] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[SLEEntGruT] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[SLEEntCod]) WHERE (T1.[EmpCod] = ? and T1.[SLEEntCod] >= ?) "
                  cmdbuf = cmdbuf + "  AND (T1.[SLEEntGruT] = 'CL') ORDER BY T1.[EmpCod], T1.[SLEEntCod], T1.[SLENro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04062,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04062,15)
                  THISFORM.GX_DB_BindColsW04062_01 ()
                  THISFORM.GX_DB_BindParmW04062_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04062,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04062,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04062 = Gx_err
               THISFORM.GX_DB_GetW04062_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WSLEstad"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04062 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04062) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04062 = Gx_err
                  THISFORM.GX_DB_GetW04062_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04062 <> 101
               BRKVBA2 = .F.
               THISFORM.A120EntCod = THISFORM.Buf_W04062_120EntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W04062_2EmpCod
               THISFORM.A1293SLEEn = THISFORM.Buf_W04062_1293SLEEntGruT
               THISFORM.A150EntGru = THISFORM.Buf_W04062_150EntGruTip
               THISFORM.A1296SLEDs = THISFORM.Buf_W04062_1296SLEDsc
               THISFORM.A1295SLENr = THISFORM.Buf_W04062_1295SLENro
               THISFORM.A153EntRaz = THISFORM.Buf_W04062_153EntRaz
               THISFORM.A1294SLEEn = THISFORM.Buf_W04062_1294SLEEntCod
               GX_SFLOAD = 0
               THISFORM.U17VBA2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04062 = Gx_err
               THISFORM.GX_DB_GetW04062_01 ()
            ENDDO
         ENDIF
      ENDPROC
