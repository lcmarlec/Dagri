               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09405) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09405 = Gx_err
                  THISFORM.GX_DB_GetW09405_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09405 <> 101
               BRKVQ42 = .F.
               THISFORM.A2870PCNro = THISFORM.Buf_W09405_2870PCNroInt
               THISFORM.A2880PcDoc = THISFORM.Buf_W09405_2880PcDocAso
               THISFORM.A2874PCObs = Gx_lvchar_to_char( THISFORM.Buf_W09405_2874PCObs )
               THISFORM.A2879PcEst = THISFORM.Buf_W09405_2879PcEst
               THISFORM.A193Moncod = THISFORM.Buf_W09405_193Moncod
               THISFORM.A2873PCtot = THISFORM.Buf_W09405_2873PCtotal
               THISFORM.A2651SecCo = THISFORM.Buf_W09405_2651SecCod
               THISFORM.A153EntRaz = THISFORM.Buf_W09405_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W09405_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W09405_150EntGruTip
               THISFORM.A2872PCNro = THISFORM.Buf_W09405_2872PCNro
               THISFORM.A2871PCFch = THISFORM.Buf_W09405_2871PCFch
               THISFORM.A2EmpCod = THISFORM.Buf_W09405_2EmpCod
               THISFORM.A153EntRaz = THISFORM.Buf_W09405_153EntRaz
               THISFORM.VEVQ42878 ( THISFORM.A2EmpCod , THISFORM.A2870PCNro )
               GX_SFLOAD = 0
               THISFORM.U20VQ42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09405) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09405 = Gx_err
               THISFORM.GX_DB_GetW09405_01 ()
            ENDDO
         ENDIF
      ENDPROC
