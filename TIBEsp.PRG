               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025811" , @HStmt_T025811 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TIBESP","T025811","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T025811) ,  ,  ,  , CS_SQLSRV , 0 )
