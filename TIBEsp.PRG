               THISFORM.A2535IBETp = AuxA2535IBETp
               AuxA2537IBEHt = THISFORM.A2537IBEHt
               Gx_err = GX_DB_SetDate( HStmt_T025810,5,@AuxA2537IBEHt,0)
               THISFORM.A2537IBEHt = AuxA2537IBEHt
               AuxA2538IBEPo = THISFORM.A2538IBEPo
               Gx_err = GX_DB_SetDouble( HStmt_T025810,6,@AuxA2538IBEPo,0)
               THISFORM.A2538IBEPo = AuxA2538IBEPo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T025810) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
