      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02587" , @HStmt_T02587 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TIBESP","T02587","",GX_CURSOR_TYPE_READONLY,@HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EntCui] FROM [IBESP] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] >= ? "
            cmdbuf = cmdbuf + "  and [EntCui] >= ? ORDER BY [EmpCod], [EntCui]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02587,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02587,100)
            THISFORM.GX_DB_BindColsT02587_01 ()
            THISFORM.GX_DB_BindParmT02587_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2EmpCod = 0
                  THISFORM.A166EntCui = 0
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02587,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T02587,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02587 = Gx_err
               THISFORM.GX_DB_GetT02587_01 ()
               Gx_fcond = THISFORM.T02587 <> 101
            CASE GXOP = 2 && Next record
               M166EntCui = THISFORM.A166EntCui
               THISFORM.A166EntCui = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02587,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T02587,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02587 = Gx_err
               THISFORM.GX_DB_GetT02587_01 ()
               THISFORM.A166EntCui = M166EntCui
               DO WHILE THISFORM.T02587 = 0 .AND. THISFORM.A2EmpCod >= THISFORM.Buf_T02587_2EmpCod .AND. THISFORM.A166EntCui >= THISFORM.Buf_T02587_166EntCui
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02587 = Gx_err
                  THISFORM.GX_DB_GetT02587_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02587 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2EmpCod = 0
               THISFORM.A166EntCui = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02587,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T02587,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02587 = Gx_err
               THISFORM.GX_DB_GetT02587_01 ()
               DO WHILE THISFORM.T02587 = 0
                  THISFORM.A2EmpCod = THISFORM.Buf_T02587_2EmpCod
                  THISFORM.A166EntCui = THISFORM.Buf_T02587_166EntCui
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02587 = Gx_err
                  THISFORM.GX_DB_GetT02587_01 ()
               ENDDO
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02587,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T02587,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02587) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02587 = Gx_err
               THISFORM.GX_DB_GetT02587_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2EmpCod = THISFORM.Buf_T02587_2EmpCod
               THISFORM.A166EntCui = THISFORM.Buf_T02587_166EntCui
         ENDCASE
         Gx_fcond = THISFORM.T02587 <> 101 .AND. THISFORM.T02587 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

