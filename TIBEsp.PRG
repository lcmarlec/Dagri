      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025810" , @HStmt_T025810 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TIBESP","T025810","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T025810) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [IBESP1] ([EmpCod], [EntCui], [IBEDde], [IBETpo], [IBEHta], [IBEPor], "
                  cmdbuf = cmdbuf + "  [IBExe], [IBObs]) VALUES (?, ?, ?, ?, ?, ?, convert(int, 0), ' ') "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T025810,cmdbuf)
                  THISFORM.GX_DB_BindParmT025810_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T025810,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T025810,2,@AuxA166EntCui,0)
