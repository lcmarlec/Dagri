            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 240
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2537IBEH"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2538IBEP"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT258S12 = GETE('z:\temp') + '\' + SCT258S12
            ENDIF
            CREATE DBF (SCT258S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCT258S12) EXCLUSIVE ALIAS SCT258S12
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
