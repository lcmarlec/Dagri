      PROCEDURE CreateTemp
         LOCAL SCW411S14
         SCW411S14 = ""
         IF USED( "SCW411S14" )
            SELECT SCW411S14
            SCW411S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW411S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1318CRIC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1319CRID"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW411S14 = GETE('z:\temp') + '\' + SCW411S14
            ENDIF
            CREATE DBF (SCW411S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW411S14) EXCLUSIVE ALIAS SCW411S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW411S14
         THIS.GX_SfAlias = "SCW411S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04112" , @HStmt_W04112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0470","W04112","",GX_CURSOR_TYPE_READONLY,@HStmt_W04112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CRITiMo], [CRIDsc], [CRICod], [EmpCod] FROM [CRINTERN] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] >= ? and [CRICod] >= ?) AND ([CRIDsc] like ?) AND ([CRITiMo] like "
                  cmdbuf = cmdbuf + "  ?) ORDER BY [EmpCod], [CRICod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04112,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04112,8)
                  THISFORM.GX_DB_BindColsW04112_01 ()
                  THISFORM.GX_DB_BindParmW04112_01 ()
               ENDIF
               AuxAV20C2 = THISFORM.AV20C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04112,1,@AuxAV20C2,0)
               THISFORM.AV20C2 = AuxAV20C2
               AuxAV19C1318 = THISFORM.AV19C1318
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04112,2,@AuxAV19C1318,0)
               THISFORM.AV19C1318 = AuxAV19C1318
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04112,3,PADR( TRIM(THISFORM.AV18C1319),40, '%'),LEN(PADR( TRIM(THISFORM.AV18C1319),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04112,4,PADR( TRIM(THISFORM.AV17C1320),1, '%'),LEN(PADR( TRIM(THISFORM.AV17C1320),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04112 = Gx_err
               THISFORM.GX_DB_GetW04112_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04112) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04112 = Gx_err
                  THISFORM.GX_DB_GetW04112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04112 <> 101
               BRKVBF2 = .F.
               THISFORM.A1320CRITi = THISFORM.Buf_W04112_1320CRITiMo
               THISFORM.A1319CRIDs = THISFORM.Buf_W04112_1319CRIDsc
               THISFORM.A1318CRICo = THISFORM.Buf_W04112_1318CRICod
               THISFORM.A2EmpCod = THISFORM.Buf_W04112_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VBF2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04112 = Gx_err
               THISFORM.GX_DB_GetW04112_01 ()
            ENDDO
         ENDIF
      ENDPROC
