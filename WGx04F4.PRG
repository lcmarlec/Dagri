            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW433S20 = GETE('z:\temp') + '\' + SCW433S20
            ENDIF
            CREATE DBF (SCW433S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW433S20) EXCLUSIVE ALIAS SCW433S20
         ENDIF
