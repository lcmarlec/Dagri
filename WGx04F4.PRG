      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04332" , @HStmt_W04332 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04F4","W04332","",GX_CURSOR_TYPE_READONLY,@HStmt_W04332) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TAGNi], [TAGAsiTip], [TAGAsiNI], [TAGAsiItFc], [TAGAsiHabe], [TAGAsiDebe], "
                  cmdbuf = cmdbuf + "  [TAGAsiCTaN], [TAGAsiItNr] FROM [TASIGES1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [TAGNi] = ? and [TAGAsiTip] = ? and [TAGAsiNI] = ? and [TAGAsiItNr] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([TAGAsiCTaN] like ?) AND ([TAGAsiDebe] >= ?) ORDER BY [EmpCod], [TAGNi], [TAGAsiTip], "
                  cmdbuf = cmdbuf + "  [TAGAsiNI], [TAGAsiItNr], [TAGAsiCTaN]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04332,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04332,9)
                  THISFORM.GX_DB_BindColsW04332_01 ()
                  THISFORM.GX_DB_BindParmW04332_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04332,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1380TAGNi = THISFORM.A1380TAGNi
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04332,2,@AuxA1380TAGNi,0)
               THISFORM.A1380TAGNi = AuxA1380TAGNi
               AuxA1381TAGAs = THISFORM.A1381TAGAs
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04332,3,@AuxA1381TAGAs,0)
               THISFORM.A1381TAGAs = AuxA1381TAGAs
               AuxA1382TAGAs = THISFORM.A1382TAGAs
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04332,4,@AuxA1382TAGAs,0)
               THISFORM.A1382TAGAs = AuxA1382TAGAs
               AuxAV5C1384 = THISFORM.AV5C1384
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04332,5,@AuxAV5C1384,0)
               THISFORM.AV5C1384 = AuxAV5C1384
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04332,6,PADR( TRIM(THISFORM.AV6C1385),12, '%'),LEN(PADR( TRIM(THISFORM.AV6C1385),12, '%')),0)
               AuxAV7C1386 = THISFORM.AV7C1386
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04332,7,@AuxAV7C1386,0)
               THISFORM.AV7C1386 = AuxAV7C1386
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04332 = Gx_err
               THISFORM.GX_DB_GetW04332_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04332 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04332) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04332 = Gx_err
                  THISFORM.GX_DB_GetW04332_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04332 <> 101
               BRKVC12 = .F.
               THISFORM.A1392TAGAs = THISFORM.Buf_W04332_1392TAGAsiItFc
               THISFORM.A1387TAGAs = THISFORM.Buf_W04332_1387TAGAsiHabe
               THISFORM.A1386TAGAs = THISFORM.Buf_W04332_1386TAGAsiDebe
               THISFORM.A1385TAGAs = THISFORM.Buf_W04332_1385TAGAsiCTaN
               THISFORM.A1384TAGAs = THISFORM.Buf_W04332_1384TAGAsiItNr
               GX_SFLOAD = 0
               THISFORM.U12VC12 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04332 = Gx_err
               THISFORM.GX_DB_GetW04332_01 ()
            ENDDO
         ENDIF
      ENDPROC
