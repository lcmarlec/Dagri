      PROCEDURE SetMode(gxType,gxLvl)
         gxO_Rec = 0
         IF THISFORM.GX_Curr_Level = 10
            THISFORM.SaveMode( THISFORM.GX_1Lvl_mode, "EOF")
            RETURN
         ENDIF
         DO CASE
            CASE THISFORM.GX_Curr_Level = 10
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T001210" , @HStmt_T001210 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCATIVA","T001210","",GX_CURSOR_TYPE_READONLY,@HStmt_T001210) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [CIvCod], [CIvDsc], [CIvNor], [CIvSta], [CivIBMin], [CIVIIBB] FROM [CATIVA] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [CIvCod] = ?  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T001210,cmdbuf)
                  THISFORM.GX_DB_BindColsT001210_01 ()
                  THISFORM.GX_DB_BindParmT001210_01 ()
               ENDIF
               AuxA88CIvCod = THISFORM.A88CIvCod
               Gx_err = GX_DB_SetInt( HStmt_T001210,1,@AuxA88CIvCod,0)
               THISFORM.A88CIvCod = AuxA88CIvCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T001210) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T001210 = Gx_err
               THISFORM.GX_DB_GetT001210_01 ()
               gx_NewMode = "UPD"
               IF .not. THISFORM.T001210 <> 101
                  gx_NewMode = "INS"
               ENDIF
               IF THIS.AMode
                  THISFORM.SaveMode(gx_NewMode, "")
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T001210) ,  ,  ,  , CS_SQLSRV , 0 )
               RETURN
         ENDCASE
         GXForm::SetMode(gxType,gxLvl)
         IF gxO_Rec != 0
            GOTO (gxO_Rec)
         ENDIF
