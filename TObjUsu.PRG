      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         LOCAL gxTName
         gxTName = THISFORM.cCT75S8.GX_SfAlias
         IF THISFORM.Gx_mode <> "INS"
