            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA66ObjCod"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA64UsuCod"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA65UsuNom"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 30
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA74AutNiv"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA680ObjCo"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "VAV20Pgmna"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 8
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT75S8 = GETE('z:\temp') + '\' + SCT75S8
            ENDIF
            CREATE DBF (SCT75S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCT75S8) EXCLUSIVE ALIAS SCT75S8
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT75S8
