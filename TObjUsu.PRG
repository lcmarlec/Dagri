            THISFORM.A66ObjCodA = AuxA66ObjCodA
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T00752,3,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00752) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00752 = Gx_err
            THISFORM.GX_DB_GetT00752_01 ()
            IF .NOT. THISFORM.T00752 <> 103
               DO GX_ERRMW WITH "AUT001 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00752 = 101 .OR. THISFORM.Z74AutNive <> THISFORM.Buf_T00752_74AutNivel
               DO GX_ERRMW WITH "AUT001 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00757" , @HStmt_T00757 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOBJUSU","T00757","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00757) ,  ,  ,  , CS_SQLSRV , 0 )
