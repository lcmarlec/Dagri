      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T007510" , @HStmt_T007510 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOBJUSU","T007510","",GX_CURSOR_TYPE_READONLY,@HStmt_T007510) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [UsuCod], [ObjCodAut], [EmpCod], [AutNivel] FROM [AUT001] (NOLOCK) ORDER BY "
                  cmdbuf = cmdbuf + "  [UsuCod], [ObjCodAut], [EmpCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007510,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007510,13)
                  THISFORM.GX_DB_BindColsT007510_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007510) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007510 = Gx_err
               THISFORM.GX_DB_GetT007510_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T007510 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007510) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T007510 = Gx_err
                  THISFORM.GX_DB_GetT007510_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T007510 <> 101
               BRK236 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT75S8.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007510) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007510 = Gx_err
               THISFORM.GX_DB_GetT007510_01 ()
            ENDDO
         ENDIF
      ENDPROC
