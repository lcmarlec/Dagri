         SELECT (THISFORM. cCT75S8 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT75S8 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT75S8 .SF( 3, @sf_err)     && Read
         Gx_fcond = S64UsuCod = THISFORM.A64UsuCod .AND. S66ObjCodA = THISFORM.A66ObjCodA .AND. S2EmpCod = THISFORM.A2EmpCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT75S8 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT75S8 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S64UsuCod = THISFORM.A64UsuCod .AND. S66ObjCodA = THISFORM.A66ObjCodA .AND. S2EmpCod = THISFORM.A2EmpCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT75S8 .Refresh()
               THISFORM. cCT75S8 .AfterRowColChange1()
               THISFORM.A64UsuCod = S64UsuCod
               THISFORM.A66ObjCodA = S66ObjCodA
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT75S8 .GX_all_loaded  && If aready loaded -> Not found
