      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl6 .or. .not. THISFORM. cCT75S8 .Gx_rec_modif
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         THISFORM. cCT75S8 .SaveTemp()
         Response = .T.
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  RETURN .F.
               ENDIF
               THISFORM. cCT75S8 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               RETURN .F.
            ENDIF
            IF THISFORM.Gx_mode = "INS"
               THISFORM. cCT75S8 .AppendRow()
               THISFORM. cCT75S8 .Refresh()
               THISFORM. cCT75S8 .AfterRowColChange1()
            ENDIF
            THISFORM.cCT75S8 .gx_rec_modif = .F.
            THISFORM.cCT75S8 .gx_key_modif = .F.
            THISFORM.cCT75S8 .gx_ctrl_modif = .F.
         ELSE
            RETURN .F.
         ENDIF
