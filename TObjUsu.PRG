               THISFORM. cCT75S8 .AppendRow()
               THISFORM. cCT75S8 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A64UsuCod = S64UsuCod
               THISFORM.A66ObjCodA = S66ObjCodA
               THISFORM.A2EmpCod = S2EmpCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A64UsuCod = S64UsuCod
         THISFORM.A66ObjCodA = S66ObjCodA
         THISFORM.A2EmpCod = S2EmpCod
         RETURN .F.
      ENDFUNC
