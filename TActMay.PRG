      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 393
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT369A3443 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT369A3443 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 393
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3443ActMa = THISFORM.A3443ActMa
                  Gx_err = GX_DB_SetDouble( HStmt_T03693,1,@AuxA3443ActMa,0)
                  THISFORM.A3443ActMa = AuxA3443ActMa
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03693) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03693 = Gx_err
                  THISFORM.GX_DB_GetT03693_01 ()
                  THISFORM. cCT369A3443 . ZMA9393 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCA9393 ()
               THISFORM. cCT369A3443 . ZMA9393 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCA9393 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT369A3444 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEA9393 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCA9393 ()
                  RETURN
               ENDIF
               THISFORM.cCT369A3443.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03693) , "TACTMAY" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03692) , "TACTMAY" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT369A3444 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT369A3443 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

