      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S1525LlaNr
         LOCAL S1504LlaFa
         LOCAL S1505LlaFa
         LOCAL S1506LLaAr
         S2EmpCod = THISFORM.A2EmpCod
         S1525LlaNr = THISFORM.A1525LlaNr
         S1504LlaFa = THISFORM.A1504LlaFa
         S1505LlaFa = THISFORM.A1505LlaFa
         S1506LLaAr = THISFORM.A1506LLaAr
         THISFORM.A1506LLaAr = THISFORM.M1506LLaAr
         THISFORM.A1504LlaFa = THISFORM.M1504LlaFa
         THISFORM.A1505LlaFa = THISFORM.M1505LlaFa
         THISFORM. cCT153S10 .SaveTemp()
         THISFORM. cCT153S10 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT153S10 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT153S10 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT153S10 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1504LlaFa = THISFORM.A1504LlaFa .AND. S1505LlaFa = THISFORM.A1505LlaFa .AND. S1506LLaAr = THISFORM.A1506LLaAr
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT153S10 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT153S10 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1504LlaFa = THISFORM.A1504LlaFa .AND. S1505LlaFa = THISFORM.A1505LlaFa .AND. S1506LLaAr = THISFORM.A1506LLaAr
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT153S10 .Refresh()
               THISFORM. cCT153S10 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1525LlaNr = S1525LlaNr
               THISFORM.A1504LlaFa = S1504LlaFa
               THISFORM.A1505LlaFa = S1505LlaFa
               THISFORM.A1506LLaAr = S1506LLaAr
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT153S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT153S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1504LlaFa = THISFORM.A1504LlaFa .AND. S1505LlaFa = THISFORM.A1505LlaFa .AND. S1506LLaAr = THISFORM.A1506LLaAr
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT153S10 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1504LlaFa = THISFORM.A1504LlaFa .AND. S1505LlaFa = THISFORM.A1505LlaFa .AND. S1506LLaAr = THISFORM.A1506LLaAr
            ENDDO
            IF sf_err != 0
               THISFORM. cCT153S10 .AppendRow()
               THISFORM. cCT153S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1525LlaNr = S1525LlaNr
               THISFORM.A1504LlaFa = S1504LlaFa
               THISFORM.A1505LlaFa = S1505LlaFa
               THISFORM.A1506LLaAr = S1506LLaAr
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1525LlaNr = S1525LlaNr
         THISFORM.A1504LlaFa = S1504LlaFa
         THISFORM.A1505LlaFa = S1505LlaFa
         THISFORM.A1506LLaAr = S1506LLaAr
         RETURN .F.
      ENDFUNC
