      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T015314" , @HStmt_T015314 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLLARES","T015314","",GX_CURSOR_TYPE_READONLY,@HStmt_T015314) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [LlaNroI], [LlaFamCod], [LlaFamSubC], [LLaArtCod], [LlaUsuE], [LlaRtoSuc], "
                  cmdbuf = cmdbuf + "  [LlaRtoFch], [LlaArtCnt], [LlaRtoNro] FROM [LLAMADO] (NOLOCK) WHERE [EmpCod] = ? "
                  cmdbuf = cmdbuf + "  AND [LlaNroI] = ? ORDER BY [EmpCod], [LlaNroI], [LlaFamCod], [LlaFamSubC], [LLaArtCod] "
                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T015314,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T015314,6)
                  THISFORM.GX_DB_BindColsT015314_01 ()
                  THISFORM.GX_DB_BindParmT015314_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T015314,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1525LlaNr = THISFORM.A1525LlaNr
               Gx_err = GX_DB_SetDouble( HStmt_T015314,2,@AuxA1525LlaNr,0)
               THISFORM.A1525LlaNr = AuxA1525LlaNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T015314) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T015314 = Gx_err
               THISFORM.GX_DB_GetT015314_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T015314 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T015314) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T015314 = Gx_err
                  THISFORM.GX_DB_GetT015314_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T015314 <> 101
               BRK49175 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT153S10.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T015314_1525LlaNroI = THISFORM.A1525LlaNr .AND. THISFORM.Buf_T015314_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T015314) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T015314 = Gx_err
               THISFORM.GX_DB_GetT015314_01 ()
            ENDDO
         ENDIF
      ENDPROC
