      PROCEDURE CreateTemp
         LOCAL SCT43S17
         SCT43S17 = ""
         IF USED( "SCT43S17" )
            SELECT SCT43S17
            SCT43S17 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT43S17
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA483TDVIm"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA484TDVIm"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA485TDVNi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA486TDVIm"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT43S17 = GETE('z:\temp') + '\' + SCT43S17
            ENDIF
            CREATE DBF (SCT43S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCT43S17) EXCLUSIVE ALIAS SCT43S17
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT43S17
         THIS.GX_SfAlias = "SCT43S17"
      ENDPROC
