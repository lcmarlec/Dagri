         * Search in Sub-File
         SELECT (THISFORM. cCT43S17 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT43S17 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT43S17 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S483TDVImp = THISFORM.A483TDVImp .AND. S485TDVNim = THISFORM.A485TDVNim
