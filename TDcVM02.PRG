            THISFORM. cCT43S17 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT43S17 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S483TDVImp = THISFORM.A483TDVImp .AND. S485TDVNim = THISFORM.A485TDVNim
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT43S17 .Refresh()
               THISFORM. cCT43S17 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
               THISFORM.A483TDVImp = S483TDVImp
               THISFORM.A485TDVNim = S485TDVNim
               THISFORM.SaveMode( "UPD" ,"")
