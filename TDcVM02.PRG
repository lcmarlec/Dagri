            ENDDO
            IF sf_err != 0
               THISFORM. cCT43S17 .AppendRow()
               THISFORM. cCT43S17 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
