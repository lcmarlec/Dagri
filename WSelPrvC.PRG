         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11132" , @HStmt_W11132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSELPRVC","W11132","",GX_CURSOR_TYPE_READONLY,@HStmt_W11132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntInd], [EntLocDsc], [EntFan], [EntTel], [EntCui], "
                  cmdbuf = cmdbuf + "  [EntRaz], [EntCod] FROM [ENTID] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EntGruTip] "
                  cmdbuf = cmdbuf + "  = ?) AND ([EntCui] = ?) AND ([EntCui] > 0) ORDER BY [EmpCod], [EntGruTip], [EntCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11132,10)
