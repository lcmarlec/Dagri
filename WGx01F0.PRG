               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04252 = Gx_err
               THISFORM.GX_DB_GetW04252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04252 = Gx_err
                  THISFORM.GX_DB_GetW04252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04252 <> 101
               BRKVBT2 = .F.
               THISFORM.A549EjeDes = THISFORM.Buf_W04252_549EjeDes
               THISFORM.A198PCtaNr = THISFORM.Buf_W04252_198PCtaNro
               THISFORM.A552EjeNro = THISFORM.Buf_W04252_552EjeNroInt
               THISFORM.A551EjeFin = THISFORM.Buf_W04252_551EjeFin
               THISFORM.A550EjeIni = THISFORM.Buf_W04252_550EjeIni
               THISFORM.A548EjeNro = THISFORM.Buf_W04252_548EjeNro
               THISFORM.A2EmpCod = THISFORM.Buf_W04252_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VBT2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04252 = Gx_err
               THISFORM.GX_DB_GetW04252_01 ()
            ENDDO
         ENDIF
      ENDPROC
