      PROCEDURE CreateTemp
         LOCAL SCW254S20
         SCW254S20 = ""
         IF USED( "SCW254S20" )
            SELECT SCW254S20
            SCW254S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW254S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA695OCoLi"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA697OCoFE"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA700OCoLE"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW254S20 = GETE('z:\temp') + '\' + SCW254S20
            ENDIF
            CREATE DBF (SCW254S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW254S20) EXCLUSIVE ALIAS SCW254S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW254S20
         THIS.GX_SfAlias = "SCW254S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02542" , @HStmt_W02542 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0252","W02542","",GX_CURSOR_TYPE_READONLY,@HStmt_W02542) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [OCoNroInt], [OCoLEs], [OCoFEn], [ArtCod], [FamSubCod], [FamCod], "
                  cmdbuf = cmdbuf + "  [OCoLin] FROM [OCOMPN1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [OCoNroInt] "
                  cmdbuf = cmdbuf + "  = ? and [OCoLin] >= ?) AND ([FamCod] >= ?) AND ([FamSubCod] >= ?) AND ([ArtCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([OCoFEn] >= ?) ORDER BY [EmpCod], [OCoNroInt], [OCoLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02542,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02542,9)
                  THISFORM.GX_DB_BindColsW02542_01 ()
                  THISFORM.GX_DB_BindParmW02542_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02542,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA682OCoNro = THISFORM.A682OCoNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02542,2,@AuxA682OCoNro,0)
               THISFORM.A682OCoNro = AuxA682OCoNro
               AuxAV5C695 = THISFORM.AV5C695
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02542,3,@AuxAV5C695,0)
               THISFORM.AV5C695 = AuxAV5C695
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02542,4,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02542,5,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               AuxAV8C5 = THISFORM.AV8C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02542,6,@AuxAV8C5,0)
               THISFORM.AV8C5 = AuxAV8C5
               AuxAV9C697 = THISFORM.AV9C697
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02542,7,@AuxAV9C697,0)
               THISFORM.AV9C697 = AuxAV9C697
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02542 = Gx_err
               THISFORM.GX_DB_GetW02542_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02542 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02542) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02542 = Gx_err
                  THISFORM.GX_DB_GetW02542_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02542 <> 101
               BRKV722 = .F.
               THISFORM.A700OCoLEs = THISFORM.Buf_W02542_700OCoLEs
               THISFORM.A697OCoFEn = THISFORM.Buf_W02542_697OCoFEn
               THISFORM.A5ArtCod = THISFORM.Buf_W02542_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W02542_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W02542_3FamCod
               THISFORM.A695OCoLin = THISFORM.Buf_W02542_695OCoLin
               GX_SFLOAD = 0
               THISFORM.U12V722 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02542 = Gx_err
               THISFORM.GX_DB_GetW02542_01 ()
            ENDDO
         ENDIF
      ENDPROC
