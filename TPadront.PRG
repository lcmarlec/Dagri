      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 408
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT386A3571 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 408
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3571ptCUI = THISFORM.A3571ptCUI
                  Gx_err = GX_DB_SetDouble( HStmt_T03863,1,@AuxA3571ptCUI,0)
                  THISFORM.A3571ptCUI = AuxA3571ptCUI
                  AuxA3572ptfec = THISFORM.A3572ptfec
                  Gx_err = GX_DB_SetLong( HStmt_T03863,2,@AuxA3572ptfec,0)
                  THISFORM.A3572ptfec = AuxA3572ptfec
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03863) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03863 = Gx_err
                  THISFORM.GX_DB_GetT03863_01 ()
                  THISFORM. cCT386A3572 . ZMAQ408 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCAQ408 ()
               THISFORM. cCT386A3572 . ZMAQ408 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAQ408 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT386A3576 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEAQ408 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAQ408 ()
                  RETURN
               ENDIF
               THISFORM.cCT386A3572.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03863) , "TPADRONT" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03862) , "TPADRONT" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT386A3576 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT386A3571 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
