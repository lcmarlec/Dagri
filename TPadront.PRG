               AuxA3572ptfec = THISFORM.A3572ptfec
               Gx_err = GX_DB_SetLong( HStmt_T03864,2,@AuxA3572ptfec,0)
               THISFORM.A3572ptfec = AuxA3572ptfec
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03864) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03864 = Gx_err
               THISFORM.GX_DB_GetT03864_01 ()
               Gx_fcond = THISFORM.T03864 <> 101
            CASE GXOP = 2 && Next record
               M3572ptfec = THISFORM.A3572ptfec
               THISFORM.A3572ptfec = 0
               AuxA3571ptCUI = THISFORM.A3571ptCUI
               Gx_err = GX_DB_SetDouble( HStmt_T03864,1,@AuxA3571ptCUI,0)
               THISFORM.A3571ptCUI = AuxA3571ptCUI
               AuxA3572ptfec = THISFORM.A3572ptfec
               Gx_err = GX_DB_SetLong( HStmt_T03864,2,@AuxA3572ptfec,0)
               THISFORM.A3572ptfec = AuxA3572ptfec
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03864) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03864 = Gx_err
               THISFORM.GX_DB_GetT03864_01 ()
               THISFORM.A3572ptfec = M3572ptfec
               DO WHILE THISFORM.T03864 = 0 .AND. THISFORM.A3571ptCUI >= THISFORM.Buf_T03864_3571ptCUIT .AND. THISFORM.A3572ptfec >= THISFORM.Buf_T03864_3572ptfecha
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03864) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03864 = Gx_err
                  THISFORM.GX_DB_GetT03864_01 ()
               ENDDO
               Gx_fcond = THISFORM.T03864 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A3571ptCUI = 0
               THISFORM.A3572ptfec = 0
               AuxA3571ptCUI = THISFORM.A3571ptCUI
               Gx_err = GX_DB_SetDouble( HStmt_T03864,1,@AuxA3571ptCUI,0)
               THISFORM.A3571ptCUI = AuxA3571ptCUI
               AuxA3572ptfec = THISFORM.A3572ptfec
               Gx_err = GX_DB_SetLong( HStmt_T03864,2,@AuxA3572ptfec,0)
               THISFORM.A3572ptfec = AuxA3572ptfec
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03864) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03864 = Gx_err
               THISFORM.GX_DB_GetT03864_01 ()
               DO WHILE THISFORM.T03864 = 0
