            THISFORM.GX_DB_BindParmT03864_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A3571ptCUI = 0
                  THISFORM.A3572ptfec = 0
