      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03864" , @HStmt_T03864 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPADRONT","T03864","",GX_CURSOR_TYPE_READONLY,@HStmt_T03864) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [ptCUIT], [ptfecha], [ptlinea], [ptInsert] FROM [PADRONTX] (FASTFIRSTROW NOLOCK) "
            cmdbuf = cmdbuf + "  WHERE [ptCUIT] >= ? and [ptfecha] >= ? ORDER BY [ptCUIT], [ptfecha]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03864,cmdbuf)
