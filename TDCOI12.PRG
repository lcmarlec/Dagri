               Gx_err = GX_DB_SetDouble( HStmt_T014624,2,@AuxA380TdcNro,0)
               THISFORM.A380TdcNro = AuxA380TdcNro
               AuxA406TdcROR = THISFORM.A406TdcROR
               Gx_err = GX_DB_SetDouble( HStmt_T014624,3,@AuxA406TdcROR,0)
               THISFORM.A406TdcROR = AuxA406TdcROR
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T014624) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T014624 = Gx_err
               THISFORM.GX_DB_GetT014624_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T014624 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T014624) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T014624 = Gx_err
                  THISFORM.GX_DB_GetT014624_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T014624 <> 101
               BRK4241 = .F.
               THISFORM.GX_Refresh = 0
