      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T014624" , @HStmt_T014624 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCOI12","T014624","",GX_CURSOR_TYPE_READONLY,@HStmt_T014624) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin], [TdcTotLiA], [TdcCnt], [TdcObsLin], "
                  cmdbuf = cmdbuf + "  [TdcPrc] FROM [TDCOM2] (NOLOCK) WHERE [EmpCod] = ? AND [TdcNroInt] = ? AND [TdcRORNroI] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T014624,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T014624,8)
                  THISFORM.GX_DB_BindColsT014624_01 ()
                  THISFORM.GX_DB_BindParmT014624_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T014624,1,@AuxA2EmpCod,0)
