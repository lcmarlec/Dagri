      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S380TdcNro
         LOCAL S406TdcROR
         LOCAL S408TdcROR
         S2EmpCod = THISFORM.A2EmpCod
         S380TdcNro = THISFORM.A380TdcNro
         S406TdcROR = THISFORM.A406TdcROR
         S408TdcROR = THISFORM.A408TdcROR
         THISFORM.A408TdcROR = THISFORM.M408TdcROR
         THISFORM. cCT146S19 .SaveTemp()
         THISFORM. cCT146S19 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT146S19 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT146S19 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT146S19 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S406TdcROR = THISFORM.A406TdcROR .AND. S408TdcROR = THISFORM.A408TdcROR
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT146S19 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT146S19 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S406TdcROR = THISFORM.A406TdcROR .AND. S408TdcROR = THISFORM.A408TdcROR
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT146S19 .Refresh()
               THISFORM. cCT146S19 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A380TdcNro = S380TdcNro
               THISFORM.A406TdcROR = S406TdcROR
               THISFORM.A408TdcROR = S408TdcROR
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT146S19 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT146S19 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S406TdcROR = THISFORM.A406TdcROR .AND. S408TdcROR = THISFORM.A408TdcROR
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT146S19 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S406TdcROR = THISFORM.A406TdcROR .AND. S408TdcROR = THISFORM.A408TdcROR
            ENDDO
            IF sf_err != 0
               THISFORM. cCT146S19 .AppendRow()
               THISFORM. cCT146S19 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A380TdcNro = S380TdcNro
               THISFORM.A406TdcROR = S406TdcROR
               THISFORM.A408TdcROR = S408TdcROR
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A380TdcNro = S380TdcNro
         THISFORM.A406TdcROR = S406TdcROR
         THISFORM.A408TdcROR = S408TdcROR
         RETURN .F.
      ENDFUNC
