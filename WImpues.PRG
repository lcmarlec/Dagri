      PROCEDURE CreateTemp
         LOCAL SCW66S22
         SCW66S22 = ""
         IF USED( "SCW66S22" )
            SELECT SCW66S22
            SCW66S22 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW66S22
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA613ImpCo"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA614ImpDs"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA615ImpNi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA616ImpPo"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA617ImpBa"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW66S22 = GETE('z:\temp') + '\' + SCW66S22
            ENDIF
            CREATE DBF (SCW66S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW66S22) EXCLUSIVE ALIAS SCW66S22
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW66S22
         THIS.GX_SfAlias = "SCW66S22"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00662" , @HStmt_W00662 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WIMPUES","W00662","",GX_CURSOR_TYPE_READONLY,@HStmt_W00662) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ImpBas], [ImpPor], [ImpNim], [ImpDsc], [ImpCod] FROM [IMPUES] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE [ImpDsc] like ? ORDER BY [ImpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00662,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00662,15)
                  THISFORM.GX_DB_BindColsW00662_01 ()
                  THISFORM.GX_DB_BindParmW00662_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00662,1,PADR( TRIM(THISFORM.AV20Desde),20, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),20, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00662 = Gx_err
               THISFORM.GX_DB_GetW00662_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WImpues"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00662 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00662) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00662 = Gx_err
                  THISFORM.GX_DB_GetW00662_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00662 <> 101
               BRKV1U2 = .F.
               THISFORM.A617ImpBas = THISFORM.Buf_W00662_617ImpBas
               THISFORM.A616ImpPor = THISFORM.Buf_W00662_616ImpPor
               THISFORM.A615ImpNim = THISFORM.Buf_W00662_615ImpNim
               THISFORM.A614ImpDsc = THISFORM.Buf_W00662_614ImpDsc
               THISFORM.A613ImpCod = THISFORM.Buf_W00662_613ImpCod
               GX_SFLOAD = 0
               THISFORM.U17V1U2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00662 = Gx_err
               THISFORM.GX_DB_GetW00662_01 ()
            ENDDO
         ENDIF
      ENDPROC
