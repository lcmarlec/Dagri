            cmdbuf = " SELECT [EmpCod], [LPedNI], [PedSucFac], [PedNroFac], [PedSucRto], [PedNroRto], [PedFch], "
            cmdbuf = cmdbuf + "  [PedGruTip] AS PedGruTip, [PedEntCod] AS PedEntCod, [PedSucCod] AS PedSucCod, [PedSec] "
            cmdbuf = cmdbuf + "  FROM [LPEDART] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] >= ? and [LPedNI] >= ? and [PedSucFac] "
            cmdbuf = cmdbuf + "  >= ? and [PedNroFac] >= ? and [PedSucRto] >= ? and [PedNroRto] >= ? ORDER BY [EmpCod], "
            cmdbuf = cmdbuf + "  [LPedNI], [PedSucFac], [PedNroFac], [PedSucRto], [PedNroRto]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01226,cmdbuf)
