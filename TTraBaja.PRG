      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S3555TraBa
         LOCAL S3567TraCe
         S2EmpCod = THISFORM.A2EmpCod
         S3555TraBa = THISFORM.A3555TraBa
         S3567TraCe = THISFORM.A3567TraCe
         THISFORM.A3567TraCe = THISFORM.M3567TraCe
         THISFORM. cCT384S30 .SaveTemp()
         THISFORM. cCT384S30 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT384S30 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT384S30 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT384S30 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3555TraBa = THISFORM.A3555TraBa .AND. S3567TraCe = THISFORM.A3567TraCe
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT384S30 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT384S30 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3555TraBa = THISFORM.A3555TraBa .AND. S3567TraCe = THISFORM.A3567TraCe
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT384S30 .Refresh()
               THISFORM. cCT384S30 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3555TraBa = S3555TraBa
               THISFORM.A3567TraCe = S3567TraCe
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT384S30 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT384S30 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3555TraBa = THISFORM.A3555TraBa .AND. S3567TraCe = THISFORM.A3567TraCe
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT384S30 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3555TraBa = THISFORM.A3555TraBa .AND. S3567TraCe = THISFORM.A3567TraCe
            ENDDO
            IF sf_err != 0
               THISFORM. cCT384S30 .AppendRow()
               THISFORM. cCT384S30 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3555TraBa = S3555TraBa
               THISFORM.A3567TraCe = S3567TraCe
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A3555TraBa = S3555TraBa
         THISFORM.A3567TraCe = S3567TraCe
         RETURN .F.
      ENDFUNC
