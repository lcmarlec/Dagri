               THISFORM.A1727TalCh = S1727TalCh
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT168S24 .GX_all_loaded  && If aready loaded -> Not found
