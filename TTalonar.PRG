            GX_STRUCT[ 4 ,1]= "sA1731TalC"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT168S24 = GETE('z:\temp') + '\' + SCT168S24
            ENDIF
            CREATE DBF (SCT168S24) FROM ARRAY GX_STRUCT
            USE
            USE (SCT168S24) EXCLUSIVE ALIAS SCT168S24
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
