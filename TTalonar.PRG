            THISFORM. cCT168S24 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1721TalBc = THISFORM.A1721TalBc .AND. S1723TalNr = THISFORM.A1723TalNr .AND. S1727TalCh = THISFORM.A1727TalCh
