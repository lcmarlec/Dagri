      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T016815" , @HStmt_T016815 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTALONAR","T016815","",GX_CURSOR_TYPE_READONLY,@HStmt_T016815) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TalBcoCta] AS TalBcoCta, [TalNroDde], [TalChqNro], [TalChqEst], "
                  cmdbuf = cmdbuf + "  [TalChqFch] FROM [TALONAR1] (NOLOCK) WHERE [EmpCod] = ? AND [TalBcoCta] = ? AND "
                  cmdbuf = cmdbuf + "  [TalNroDde] = ? ORDER BY [EmpCod], [TalBcoCta], [TalNroDde], [TalChqNro]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T016815,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T016815,9)
                  THISFORM.GX_DB_BindColsT016815_01 ()
                  THISFORM.GX_DB_BindParmT016815_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T016815,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1721TalBc = THISFORM.A1721TalBc
               Gx_err = GX_DB_SetInt( HStmt_T016815,2,@AuxA1721TalBc,0)
               THISFORM.A1721TalBc = AuxA1721TalBc
               AuxA1723TalNr = THISFORM.A1723TalNr
               Gx_err = GX_DB_SetDouble( HStmt_T016815,3,@AuxA1723TalNr,0)
               THISFORM.A1723TalNr = AuxA1723TalNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T016815) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T016815 = Gx_err
               THISFORM.GX_DB_GetT016815_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T016815 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T016815) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T016815 = Gx_err
                  THISFORM.GX_DB_GetT016815_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T016815 <> 101
               BRK4O202 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT168S24.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T016815) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T016815 = Gx_err
               THISFORM.GX_DB_GetT016815_01 ()
            ENDDO
         ENDIF
      ENDPROC
