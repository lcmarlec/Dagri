            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 201
            THISFORM.SetLevel( 201 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT168V6 .InitLevel( 201 )
            THISFORM.GX_last_fld_lvl = 201
