         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1721TalBc = THISFORM.A1721TalBc .AND. S1723TalNr = THISFORM.A1723TalNr .AND. S1727TalCh = THISFORM.A1727TalCh
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT168S24 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT168S24 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1721TalBc = THISFORM.A1721TalBc .AND. S1723TalNr = THISFORM.A1723TalNr .AND. S1727TalCh = THISFORM.A1727TalCh
         ENDDO
         THISFORM.LockScreen = .f.
