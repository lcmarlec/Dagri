            IF gx_ORec <> RECNO()
               THISFORM. cCT168S24 .Refresh()
               THISFORM. cCT168S24 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1721TalBc = S1721TalBc
