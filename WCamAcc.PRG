      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05442" , @HStmt_W05442 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAMACC","W05442","",GX_CURSOR_TYPE_READONLY,@HStmt_W05442) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CamAccObs], [CamAct], [CamFch], [CamTip], [CamPat] FROM [CAMACC] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND ([CamPat] = ? or ? = ' ') AND ([CamTip] "
                  cmdbuf = cmdbuf + "  = ?) AND ([CamAct] like ?) ORDER BY [EmpCod], [CamPat], [CamTip], [CamFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05442,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05442,8)
                  THISFORM.GX_DB_BindColsW05442_01 ()
                  THISFORM.GX_DB_BindParmW05442_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05442,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV23Campat = THISFORM.AV23Campat
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05442,2,AuxAV23Campat,8,0)
               THISFORM.AV23Campat = AuxAV23Campat
               AuxAV23Campat = THISFORM.AV23Campat
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05442,3,AuxAV23Campat,8,0)
               THISFORM.AV23Campat = AuxAV23Campat
               AuxAV22Camtip = THISFORM.AV22Camtip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05442,4,AuxAV22Camtip,2,0)
               THISFORM.AV22Camtip = AuxAV22Camtip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05442,5,PADR( TRIM(THISFORM.AV25Camact),20, '%'),LEN(PADR( TRIM(THISFORM.AV25Camact),20, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05442 = Gx_err
               THISFORM.GX_DB_GetW05442_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WCamAcc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05442 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05442) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05442 = Gx_err
                  THISFORM.GX_DB_GetW05442_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05442 <> 101
               BRKVF42 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W05442_2EmpCod
               THISFORM.A1674CamAc = Gx_lvchar_to_char( THISFORM.Buf_W05442_1674CamAccObs )
               THISFORM.A2447CamAc = THISFORM.Buf_W05442_2447CamAct
               THISFORM.A1673CamFc = THISFORM.Buf_W05442_1673CamFch
               THISFORM.A1672CamTi = THISFORM.Buf_W05442_1672CamTip
               THISFORM.A1664CamPa = THISFORM.Buf_W05442_1664CamPat
               GX_SFLOAD = 0
               THISFORM.U17VF42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05442 = Gx_err
               THISFORM.GX_DB_GetW05442_01 ()
            ENDDO
         ENDIF
