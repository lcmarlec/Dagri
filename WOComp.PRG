      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00973" , @HStmt_W00973 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOCOMP","W00973","",GX_CURSOR_TYPE_READONLY,@HStmt_W00973) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[OCoNroInt], T3.[OcoTip], T3.[Moncod], T3.[OcoDesc], T3.[OcoObs], "
                  cmdbuf = cmdbuf + "  T3.[OcoSucOpe], T3.[OcoNroOpe], T3.[OCoNro], T4.[EntRaz] AS OcoEntRaz, T3.[OcoEntGruT] "
                  cmdbuf = cmdbuf + "  AS OcoEntGruT, T3.[OcoEntCod] AS OcoEntCod, T3.[OCoEst], T3.[OCoSuc], T3.[OCoFch], "
                  cmdbuf = cmdbuf + "  T1.[OcoLObs], T1.[OCoLEs], T1.[OCoPrc], T1.[OCoFEn], T1.[OCoCntEnt], T1.[OCoCnt], "
                  cmdbuf = cmdbuf + "  T1.[OcoArtCpr], T1.[OCOLInea], T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], "
                  cmdbuf = cmdbuf + "  T1.[OCoLin] FROM ((([OCOMPN1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [OCOMPN] T3 (NOLOCK) ON "
                  cmdbuf = cmdbuf + "  T3.[EmpCod] = T1.[EmpCod] AND T3.[OCoNroInt] = T1.[OCoNroInt]) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[EntGruTip] = T3.[OcoEntGruT] AND "
                  cmdbuf = cmdbuf + "  T4.[EntCod] = T3.[OcoEntCod]) WHERE (T1.[EmpCod] = ? and T1.[OCoNroInt] = ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[OCoCnt] <> 0 or Not (T1.[OCoFEn] = convert( DATETIME, '17530101', 112 ))) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[OCoNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00973,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00973,11)
                  THISFORM.GX_DB_BindColsW00973_01 ()
                  THISFORM.GX_DB_BindParmW00973_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00973,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA682OCoNro = THISFORM.A682OCoNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00973,2,@AuxA682OCoNro,0)
               THISFORM.A682OCoNro = AuxA682OCoNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00973) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00973 = Gx_err
               THISFORM.GX_DB_GetW00973_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00973 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00973) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00973 = Gx_err
                  THISFORM.GX_DB_GetW00973_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00973 <> 101
