      PROCEDURE CreateTemp
         LOCAL SCW927S20
         SCW927S20 = ""
         IF USED( "SCW927S20" )
            SELECT SCW927S20
            SCW927S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW927S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2847HTra"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 240
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2848Htra"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 240
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2849HTra"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2851HTra"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2852HTra"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW927S20 = GETE('z:\temp') + '\' + SCW927S20
            ENDIF
            CREATE DBF (SCW927S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW927S20) EXCLUSIVE ALIAS SCW927S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW927S20
         THIS.GX_SfAlias = "SCW927S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09272" , @HStmt_W09272 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0913","W09272","",GX_CURSOR_TYPE_READONLY,@HStmt_W09272) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TraCod], [HTraFch], [HTraFNom], [HTraFEC], [HTraFFNa], [HTraFNDoc], "
                  cmdbuf = cmdbuf + "  [HtraFTD], [HTraFtip] FROM [HEMPLEA1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? "
                  cmdbuf = cmdbuf + "  and [TraCod] = ? and [HTraFch] = ? and [HTraFtip] >= ? and [HtraFTD] >= ? and [HTraFNDoc] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([HTraFNom] like ?) ORDER BY [EmpCod], [TraCod], [HTraFch], [HTraFtip], "
                  cmdbuf = cmdbuf + "  [HtraFTD], [HTraFNDoc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09272,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09272,9)
                  THISFORM.GX_DB_BindColsW09272_01 ()
                  THISFORM.GX_DB_BindParmW09272_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09272,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09272,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               AuxA2452HTraF = THISFORM.A2452HTraF
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W09272,3,@AuxA2452HTraF,0)
               THISFORM.A2452HTraF = AuxA2452HTraF
               AuxAV5C2847 = THISFORM.AV5C2847
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09272,4,@AuxAV5C2847,0)
               THISFORM.AV5C2847 = AuxAV5C2847
               AuxAV6C2848 = THISFORM.AV6C2848
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09272,5,@AuxAV6C2848,0)
               THISFORM.AV6C2848 = AuxAV6C2848
               AuxAV7C2849 = THISFORM.AV7C2849
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09272,6,@AuxAV7C2849,0)
               THISFORM.AV7C2849 = AuxAV7C2849
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09272,7,PADR( TRIM(THISFORM.AV8C2850),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C2850),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09272 = Gx_err
               THISFORM.GX_DB_GetW09272_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09272 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09272) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09272 = Gx_err
                  THISFORM.GX_DB_GetW09272_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09272 <> 101
               BRKVPR2 = .F.
               THISFORM.A2850HTraF = THISFORM.Buf_W09272_2850HTraFNom
               THISFORM.A2852HTraF = THISFORM.Buf_W09272_2852HTraFEC
               THISFORM.A2851HTraF = THISFORM.Buf_W09272_2851HTraFFNa
               THISFORM.A2849HTraF = THISFORM.Buf_W09272_2849HTraFNDoc
               THISFORM.A2848HtraF = THISFORM.Buf_W09272_2848HtraFTD
               THISFORM.A2847HTraF = THISFORM.Buf_W09272_2847HTraFtip
               GX_SFLOAD = 0
               THISFORM.U12VPR2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09272 = Gx_err
               THISFORM.GX_DB_GetW09272_01 ()
            ENDDO
         ENDIF
      ENDPROC
