      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01892" , @HStmt_W01892 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00B1","W01892","",GX_CURSOR_TYPE_READONLY,@HStmt_W01892) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ChfDir], [ChfTel], [ChfObs], [ChfCui], [ChfEntGruT], [ChfNom], "
                  cmdbuf = cmdbuf + "  [ChfCod] FROM [CHOFER] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [ChfCod] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([ChfDir] like ?) AND ([ChfTel] like ?) AND ([ChfObs] like ?) AND ([ChfCui] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ChfEntGruT] like ?) ORDER BY [EmpCod], [ChfCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01892,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01892,9)
                  THISFORM.GX_DB_BindColsW01892_01 ()
                  THISFORM.GX_DB_BindParmW01892_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01892,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C92 = THISFORM.AV5C92
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01892,2,@AuxAV5C92,0)
               THISFORM.AV5C92 = AuxAV5C92
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01892,3,PADR( TRIM(THISFORM.AV6C94),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C94),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01892,4,PADR( TRIM(THISFORM.AV7C95),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C95),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01892,5,PADR( TRIM(THISFORM.AV8C96),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C96),40, '%')),0)
               AuxAV9C97 = THISFORM.AV9C97
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01892,6,@AuxAV9C97,0)
               THISFORM.AV9C97 = AuxAV9C97
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01892,7,PADR( TRIM(THISFORM.AV10C1549),2, '%'),LEN(PADR( TRIM(THISFORM.AV10C1549),2, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01892) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01892 = Gx_err
               THISFORM.GX_DB_GetW01892_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01892 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01892) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01892 = Gx_err
                  THISFORM.GX_DB_GetW01892_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01892 <> 101
               BRKV592 = .F.
               THISFORM.A94ChfDir = THISFORM.Buf_W01892_94ChfDir
               THISFORM.A95ChfTel = THISFORM.Buf_W01892_95ChfTel
               THISFORM.A96ChfObs = THISFORM.Buf_W01892_96ChfObs
               THISFORM.A97ChfCui = THISFORM.Buf_W01892_97ChfCui
               THISFORM.A1549ChfEn = THISFORM.Buf_W01892_1549ChfEntGruT
               THISFORM.A93ChfNom = THISFORM.Buf_W01892_93ChfNom
               THISFORM.A92ChfCod = THISFORM.Buf_W01892_92ChfCod
               GX_SFLOAD = 0
               THISFORM.U12V592 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01892) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
