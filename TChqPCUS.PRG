                  THISFORM.AV21Chqnro = Aux3
                  THISFORM.A131ChqImp = Aux4
                  THISFORM.A129ChqNro = Aux5
                  THISFORM.A132ChqFch = Aux6
                  THISFORM. cCT161A2 .Refresh()
                  THISFORM. cCT161A121 .Refresh()
                  THISFORM. cCT161A122 .Refresh()
                  THISFORM. cCT161A131 .Refresh()
                  THISFORM. cCT161A132 .Refresh()
               ENDIF
            CASE gxmode = "DLT"   && After delete
