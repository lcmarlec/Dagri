      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
               IF .T.
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A2EmpCod
                  Aux1 = THISFORM.A121ChqNro
                  Aux2 = THISFORM.A122ChqLin
                  Aux3 = THISFORM.A123ChqTip
                  Aux4 = THISFORM.A124ChqCta
                  Aux5 = THISFORM.A129ChqNro
                  DO PChqMod WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5
                  THISFORM.A2EmpCod = Aux0
                  THISFORM.A121ChqNro = Aux1
                  THISFORM.A122ChqLin = Aux2
                  THISFORM.A123ChqTip = Aux3
                  THISFORM.A124ChqCta = Aux4
                  THISFORM.A129ChqNro = Aux5
                  THISFORM. cCT161A2 .Refresh()
                  THISFORM. cCT161A121 .Refresh()
                  THISFORM. cCT161A122 .Refresh()
                  THISFORM. cCT161A123 .Refresh()
                  THISFORM. cCT161A124 .Refresh()
               ENDIF
               IF .T.
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A2EmpCod
                  Aux1 = THISFORM.A121ChqNro
                  Aux2 = THISFORM.A122ChqLin
                  Aux3 = THISFORM.AV21Chqnro
                  Aux4 = THISFORM.A131ChqImp
                  Aux5 = THISFORM.A129ChqNro
                  Aux6 = THISFORM.A132ChqFch
                  DO PChqPMCB WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6
                  THISFORM.A2EmpCod = Aux0
                  THISFORM.A121ChqNro = Aux1
