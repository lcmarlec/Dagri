      PROCEDURE CreateTemp
         LOCAL SCW1218S12
         SCW1218S12 = ""
         IF USED( "SCW1218S12" )
            SELECT SCW1218S12
            SCW1218S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1218S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA3549pppc"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 11
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3550PPPF"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3551PPPF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1218S12 = GETE('z:\temp') + '\' + SCW1218S12
            ENDIF
            CREATE DBF (SCW1218S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1218S12) EXCLUSIVE ALIAS SCW1218S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1218S12
         THIS.GX_SfAlias = "SCW1218S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12182" , @HStmt_W12182 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0B60","W12182","",GX_CURSOR_TYPE_READONLY,@HStmt_W12182) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PPPFP], [PPPFC], [pppcuit] FROM [PRPOCO] (FASTFIRSTROW NOLOCK) WHERE ([pppcuit] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PPPFC] >= ?) AND ([PPPFP] >= ?) ORDER BY [pppcuit]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12182,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12182,9)
                  THISFORM.GX_DB_BindColsW12182_01 ()
                  THISFORM.GX_DB_BindParmW12182_01 ()
               ENDIF
               AuxAV5C3549 = THISFORM.AV5C3549
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W12182,1,@AuxAV5C3549,0)
               THISFORM.AV5C3549 = AuxAV5C3549
               AuxAV6C3550 = THISFORM.AV6C3550
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12182,2,@AuxAV6C3550,0)
               THISFORM.AV6C3550 = AuxAV6C3550
               AuxAV7C3551 = THISFORM.AV7C3551
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12182,3,@AuxAV7C3551,0)
               THISFORM.AV7C3551 = AuxAV7C3551
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12182) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12182 = Gx_err
               THISFORM.GX_DB_GetW12182_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12182 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12182) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12182 = Gx_err
                  THISFORM.GX_DB_GetW12182_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12182 <> 101
               BRKVXU2 = .F.
               THISFORM.A3551PPPFP = THISFORM.Buf_W12182_3551PPPFP
               THISFORM.A3550PPPFC = THISFORM.Buf_W12182_3550PPPFC
               THISFORM.A3549pppcu = THISFORM.Buf_W12182_3549pppcuit
               GX_SFLOAD = 0
               THISFORM.U12VXU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12182) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12182 = Gx_err
               THISFORM.GX_DB_GetW12182_01 ()
            ENDDO
         ENDIF
      ENDPROC
