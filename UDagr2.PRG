               THISFORM.A583ExeNom = THISFORM.Buf_W07352_583ExeNom
               THISFORM.A584ExeDes = THISFORM.Buf_W07352_584ExeDesc
               GX_SFLOAD = 0
               THISFORM.U14VKF2 ()
