               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03152,6,PADR( TRIM(THISFORM.AV10C1087),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C1087),40, '%')),0)
               AuxAV11C1124 = THISFORM.AV11C1124
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03152,7,@AuxAV11C1124,0)
               THISFORM.AV11C1124 = AuxAV11C1124
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03152) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03152 = Gx_err
               THISFORM.GX_DB_GetW03152_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03152 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03152) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03152 = Gx_err
                  THISFORM.GX_DB_GetW03152_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03152 <> 101
               BRKV8R2 = .F.
               THISFORM.A1086EchMo = THISFORM.Buf_W03152_1086EchMotDsc
               THISFORM.A1087EchOb = THISFORM.Buf_W03152_1087EchObs
               THISFORM.A1124EchUL = THISFORM.Buf_W03152_1124EchULin
               THISFORM.A1085ECHMo = THISFORM.Buf_W03152_1085ECHMotCod
               THISFORM.A1084ECHNr = THISFORM.Buf_W03152_1084ECHNro
               THISFORM.A1083ECHNr = THISFORM.Buf_W03152_1083ECHNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W03152_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V8R2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03152) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03152 = Gx_err
               THISFORM.GX_DB_GetW03152_01 ()
            ENDDO
         ENDIF
      ENDPROC
