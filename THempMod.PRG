               Gx_err = GX_DB_SetStr( HStmt_T03788,4,AuxA3499HTraD,40,0)
               THISFORM.A3499HTraD = AuxA3499HTraD
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03788) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03788 = Gx_err
               THISFORM.T03782 = iif( THISFORM.T03788 = 0 , 104 , THISFORM.T03788 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03788) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
