                  cmdbuf = " SELECT T1.[RVtEst], T1.[RVtEntGruT] AS RVtEntGruT, T1.[RVtNroInt], T1.[EmpCod], T1.[RVtFch], "
                  cmdbuf = cmdbuf + "  T1.[RVtNro], T1.[RVtSuc], T3.[EntLgDom], T1.[RVtEntLgCo] AS RVtEntLgCo, T2.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS RVtEntRaz, T1.[RVtEntCod] AS RVtEntCod FROM (([REMVTA] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[RVtEntGruT] AND T2.[EntCod] = T1.[RVtEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[RVtEntGruT] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[RVtEntCod] AND T3.[EntLgCod] = T1.[RVtEntLgCo]) WHERE (T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[RVtEntCod] = ?) AND (T1.[RVtEst] = 1) AND (T1.[RVtFch] >= ?) AND (T1.[RVtFch] "
                  cmdbuf = cmdbuf + "  <= ?) AND (T1.[RVtEntGruT] = 'CL') AND (T1.[RVtEntLgCo] = ? or ? = 0) AND (T1.[RVtSuc] "
                  cmdbuf = cmdbuf + "  = 1) ORDER BY T1.[EmpCod], T1.[RVtEntCod], T1.[RVtEntLgCo], T1.[RVtFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05732,cmdbuf)
