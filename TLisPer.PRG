      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 60
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT59A545 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 60
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA545LPCodC = THISFORM.A545LPCodC
                  Gx_err = GX_DB_SetInt( HStmt_T00593,1,@AuxA545LPCodC,0)
                  THISFORM.A545LPCodC = AuxA545LPCodC
                  AuxA546LPCodi = THISFORM.A546LPCodi
                  Gx_err = GX_DB_SetInt( HStmt_T00593,2,@AuxA546LPCodi,0)
                  THISFORM.A546LPCodi = AuxA546LPCodi
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00593) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00593 = Gx_err
                  THISFORM.GX_DB_GetT00593_01 ()
                  THISFORM. cCT59A546 . ZM1N60 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC1N60 ()
               THISFORM. cCT59A546 . ZM1N60 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1N60 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT59A547 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE1N60 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1N60 ()
                  RETURN
               ENDIF
               THISFORM.cCT59A546.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00593) , "TLISPER" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00592) , "TLISPER" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT59A547 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT59A545 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

