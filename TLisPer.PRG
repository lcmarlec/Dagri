            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00597" , @HStmt_T00597 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLISPER","T00597","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00597) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [LISPER]  WHERE [LPCodClie] = ? AND [LPCodigo] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00597,cmdbuf)
                  THISFORM.GX_DB_BindParmT00597_01 ()
               ENDIF
               AuxA545LPCodC = THISFORM.A545LPCodC
               Gx_err = GX_DB_SetInt( HStmt_T00597,1,@AuxA545LPCodC,0)
               THISFORM.A545LPCodC = AuxA545LPCodC
