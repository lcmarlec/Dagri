      PROCEDURE CreateTemp
         LOCAL SCT300S2
         SCT300S2 = ""
         IF USED( "SCT300S2" )
            SELECT SCT300S2
            SCT300S2 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT300S2
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2875PcPg"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2882PcPg"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2876PcPg"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT300S2 = GETE('z:\temp') + '\' + SCT300S2
            ENDIF
            CREATE DBF (SCT300S2) FROM ARRAY GX_STRUCT
            USE
            USE (SCT300S2) EXCLUSIVE ALIAS SCT300S2
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT300S2
         THIS.GX_SfAlias = "SCT300S2"
      ENDPROC
