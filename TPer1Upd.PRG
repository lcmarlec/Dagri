      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T030014" , @HStmt_T030014 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPER1UPD","T030014","",GX_CURSOR_TYPE_READONLY,@HStmt_T030014) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [PCNroInt], [PcPgLin], [PcPgDet], [PcPgImp] FROM [PERCOM1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [PCNroInt] = ? ORDER BY [EmpCod], [PCNroInt], [PcPgLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T030014,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T030014,6)
                  THISFORM.GX_DB_BindColsT030014_01 ()
                  THISFORM.GX_DB_BindParmT030014_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T030014,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2870PCNro = THISFORM.A2870PCNro
               Gx_err = GX_DB_SetDouble( HStmt_T030014,2,@AuxA2870PCNro,0)
               THISFORM.A2870PCNro = AuxA2870PCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T030014) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030014 = Gx_err
               THISFORM.GX_DB_GetT030014_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T030014 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030014) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T030014 = Gx_err
                  THISFORM.GX_DB_GetT030014_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T030014 <> 101
               BRK8C329 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT300S2.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T030014_2870PCNroInt = THISFORM.A2870PCNro .AND. THISFORM.Buf_T030014_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030014) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030014 = Gx_err
               THISFORM.GX_DB_GetT030014_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2875PcPgL"
            THISFORM.A2875PcPgL = THISFORM.Buf_T030014_2875PcPgLin
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2882PcPgD"
            THISFORM.A2882PcPgD = THISFORM.Buf_T030014_2882PcPgDet
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2876PcPgI"
            THISFORM.A2876PcPgI = THISFORM.Buf_T030014_2876PcPgImp
         ENDIF
      ENDPROC
