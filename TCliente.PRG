      PROCEDURE KeyPress
         LPARAMETERS gxKeyCode, gxShiftCtrlAlt
         THISFORM.gx_frmReadkey = gxKeyCode
         DO CASE
            CASE gxKeyCode = 29   && First
               THIS. DoFirst()
            CASE gxKeyCode = 31   && Previous
               THIS. DoPrevious()
            CASE gxKeyCode = 30   && Next
               THIS. DoNext()
            CASE gxKeyCode = 23   && Last
               THIS. DoLast()
            CASE gxKeyCode = 27   && Escape
               IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
                  RETURN
               ENDIF
               gx_a_trn = .F.
               IF THISFORM.GX_after_trn != 0
                  Response = .T.
                  DO GX_CONFW WITH 'Confirma la transacción?' , Response
                  Gx_ucfrm  = .T.
                  IF .NOT. Response
                     * Rollback TRANSACTION
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01773) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01772) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01774) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01775) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01776) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01777) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01778) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01779) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T017710) , "TCLIENTE" )
                     IF TYPE( "HConn_Default" ) = "N"
                        IF GXCONNECTED
                           Gx_Err = Gx_odbc_mrc( GX_DB_ConnRollback(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                        ENDIF
                     ENDIF
                  ELSE
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01773) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01772) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01774) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01775) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01776) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01777) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01778) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01779) , "TCLIENTE" )
                     Gx_odbc_rc( GX_DB_StmtClose( HStmt_T017710) , "TCLIENTE" )
                     IF TYPE( "HConn_Default" ) = "N"
                        IF GXCONNECTED
                           Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                        ENDIF
                     ENDIF
                     THISFORM. cCT177Tb9.cCT177Pg41Tb9.cCT177A3313 .AfterTrn()
                     DO CASE
                        CASE THISFORM.GX_Mode = "INS"
                        CASE THISFORM.GX_Mode = "UPD"
                           THISFORM.ReleaseAll()
                        CASE THISFORM.GX_Mode = "DLT"
                           THISFORM.ReleaseAll()
                     ENDCASE
                  ENDIF
                  IF THISFORM.GX_Exit_GotFocus
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
                  THISFORM. cCT177Tb9 .GXOldPage = 1
                  THISFORM. cCT177Tb9 .ActivePage = 1
                  gx_a_trn = .T.
               ENDIF
               THISFORM.ReleaseAll()
         ENDCASE
      ENDPROC
