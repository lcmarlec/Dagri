               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06162 = Gx_err
               THISFORM.GX_DB_GetW06162_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV39Pgmnam = "WLpvClt"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06162 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06162) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06162 = Gx_err
                  THISFORM.GX_DB_GetW06162_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06162 <> 101
               BRKVH42 = .F.
               THISFORM.A2104xPlVE = THISFORM.Buf_W06162_2104xPlVEntCod
               THISFORM.A2103xPlVG = THISFORM.Buf_W06162_2103xPlVGruTip
               THISFORM.A2113xEmpC = THISFORM.Buf_W06162_2113xEmpCod
               THISFORM.A2124xLpvR = THISFORM.Buf_W06162_2124xLpvRet
               THISFORM.A2123xLpvR = THISFORM.Buf_W06162_2123xLpvRet2
               THISFORM.A2122xLpvR = THISFORM.Buf_W06162_2122xLpvRet1
               THISFORM.A3128xLpvO = THISFORM.Buf_W06162_3128xLpvObs
               THISFORM.A2105xLpvF = THISFORM.Buf_W06162_2105xLpvFch
               GX_SFLOAD = 0
               THISFORM.U22VH42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06162 = Gx_err
               THISFORM.GX_DB_GetW06162_01 ()
            ENDDO
         ENDIF
      ENDPROC
