            IF ! THISFORM.InitLevels( 2 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            THISFORM.LoadMenuBar()
            THISFORM.SetLevel( 2 )
            THISFORM.U11VE22 ()
            IF TYPE( "OCW506" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
