      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05063" , @HStmt_W05063 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTSEG3","W05063","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05063) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RVtEntGruT] AS RVtEntGruT, T1.[RVtEntLgCo] AS RVtEntLgCo, T1.[RVtNroInt], "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T3.[EntLgDom], T1.[RVtEst], T1.[RVtFch], T2.[EntRaz] AS RVtEntRaz, "
                  cmdbuf = cmdbuf + "  T1.[RVtEntCod] AS RVtEntCod, T1.[RVtNro], T1.[RVtSuc] FROM (([REMVTA] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[RVtEntGruT] AND T2.[EntCod] = T1.[RVtEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[RVtEntGruT] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[RVtEntCod] AND T3.[EntLgCod] = T1.[RVtEntLgCo]) WHERE T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[RVtNroInt] = ? ORDER BY T1.[EmpCod], T1.[RVtNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05063,cmdbuf)
                  THISFORM.GX_DB_BindColsW05063_01 ()
                  THISFORM.GX_DB_BindParmW05063_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05063,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Ni = THISFORM.AV19Ni
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05063,2,@AuxAV19Ni,0)
               THISFORM.AV19Ni = AuxAV19Ni
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05063) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05063 = Gx_err
               THISFORM.GX_DB_GetW05063_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV73Pgmnam = "WRvTSeg3"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05063 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05063) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05063 = Gx_err
                  THISFORM.GX_DB_GetW05063_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05063 <> 101
               BRKVE22 = .F.
               THISFORM.AV31Cntctr = 0.0000
               THISFORM.AV44Difmot = 0
               THISFORM.AV66Difobs = SPACE(400)
               THISFORM.A909RVtEnt = THISFORM.Buf_W05063_909RVtEntGruT
               THISFORM.A912RVtEnt = THISFORM.Buf_W05063_912RVtEntLgCo
               THISFORM.A908RVtNro = THISFORM.Buf_W05063_908RVtNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W05063_2EmpCod
               THISFORM.A178EntLgD = THISFORM.Buf_W05063_178EntLgDom
               THISFORM.A917RVtEst = THISFORM.Buf_W05063_917RVtEst
               THISFORM.A915RVtFch = THISFORM.Buf_W05063_915RVtFch
               THISFORM.A911RVtEnt = THISFORM.Buf_W05063_911RVtEntRaz
               THISFORM.A910RVtEnt = THISFORM.Buf_W05063_910RVtEntCod
               THISFORM.A914RVtNro = THISFORM.Buf_W05063_914RVtNro
               THISFORM.A913RVtSuc = THISFORM.Buf_W05063_913RVtSuc
               THISFORM.A911RVtEnt = THISFORM.Buf_W05063_911RVtEntRaz
               THISFORM.A178EntLgD = THISFORM.Buf_W05063_178EntLgDom
               GX_SFLOAD = 0
               THISFORM.U14VE22 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
      ENDPROC
