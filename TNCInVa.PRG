            THISFORM. cCT67S31 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT67S31 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S657tDVFLi = THISFORM.A657tDVFLi
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT67S31 .Refresh()
               THISFORM. cCT67S31 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
               THISFORM.A657tDVFLi = S657tDVFLi
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT67S31 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT67S31 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S657tDVFLi = THISFORM.A657tDVFLi
            DO WHILE sf_err = 0 .and. !GX_fcond
