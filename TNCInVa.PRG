      PROCEDURE CreateTemp
         LOCAL SCT67S31
         SCT67S31 = ""
         IF USED( "SCT67S31" )
            SELECT SCT67S31
            SCT67S31 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT67S31
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA657tDVFL"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA658tDVFO"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 60
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA659tDVFI"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA660tdvGr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT67S31 = GETE('z:\temp') + '\' + SCT67S31
            ENDIF
            CREATE DBF (SCT67S31) FROM ARRAY GX_STRUCT
            USE
            USE (SCT67S31) EXCLUSIVE ALIAS SCT67S31
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT67S31
         THIS.GX_SfAlias = "SCT67S31"
      ENDPROC
