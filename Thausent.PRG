                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T025513,cmdbuf)
                  THISFORM.GX_DB_BindParmT025513_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T025513,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               Gx_err = GX_DB_SetLong( HStmt_T025513,2,@AuxA561TraCod,0)
