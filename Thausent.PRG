      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025514" , @HStmt_T025514 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"THAUSENT","T025514","",GX_CURSOR_TYPE_READONLY,@HStmt_T025514) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TraCod], [CAuCod], [hausFch], [HausDoc] FROM [HAUSENT1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [TraCod] = ? AND [CAuCod] = ? AND [hausFch] = ? ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod], [TraCod], [CAuCod], [hausFch], [HausDoc]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T025514,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T025514,6)
                  THISFORM.GX_DB_BindColsT025514_01 ()
                  THISFORM.GX_DB_BindParmT025514_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T025514,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               Gx_err = GX_DB_SetLong( HStmt_T025514,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               AuxA2266CAuCo = THISFORM.A2266CAuCo
               Gx_err = GX_DB_SetStr( HStmt_T025514,3,AuxA2266CAuCo,4,0)
               THISFORM.A2266CAuCo = AuxA2266CAuCo
               AuxA2489hausF = THISFORM.A2489hausF
               Gx_err = GX_DB_SetDate( HStmt_T025514,4,@AuxA2489hausF,0)
               THISFORM.A2489hausF = AuxA2489hausF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T025514) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025514 = Gx_err
               THISFORM.GX_DB_GetT025514_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T025514 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025514) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T025514 = Gx_err
                  THISFORM.GX_DB_GetT025514_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T025514 <> 101
               BRK73333 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT255S26.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025514) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025514 = Gx_err
               THISFORM.GX_DB_GetT025514_01 ()
            ENDDO
         ENDIF
