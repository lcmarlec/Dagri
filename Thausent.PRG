               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025513" , @HStmt_T025513 )
