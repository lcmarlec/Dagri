            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S561TraCod = THISFORM.A561TraCod .AND. S2266CAuCo = THISFORM.A2266CAuCo .AND. S2489hausF = THISFORM.A2489hausF .AND. S2894HausD = THISFORM.A2894HausD
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT255S26 .Refresh()
               THISFORM. cCT255S26 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A561TraCod = S561TraCod
               THISFORM.A2266CAuCo = S2266CAuCo
               THISFORM.A2489hausF = S2489hausF
               THISFORM.A2894HausD = S2894HausD
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT255S26 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT255S26 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S561TraCod = THISFORM.A561TraCod .AND. S2266CAuCo = THISFORM.A2266CAuCo .AND. S2489hausF = THISFORM.A2489hausF .AND. S2894HausD = THISFORM.A2894HausD
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT255S26 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S561TraCod = THISFORM.A561TraCod .AND. S2266CAuCo = THISFORM.A2266CAuCo .AND. S2489hausF = THISFORM.A2489hausF .AND. S2894HausD = THISFORM.A2894HausD
            ENDDO
            IF sf_err != 0
               THISFORM. cCT255S26 .AppendRow()
               THISFORM. cCT255S26 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A561TraCod = S561TraCod
               THISFORM.A2266CAuCo = S2266CAuCo
               THISFORM.A2489hausF = S2489hausF
               THISFORM.A2894HausD = S2894HausD
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A561TraCod = S561TraCod
         THISFORM.A2266CAuCo = S2266CAuCo
         THISFORM.A2489hausF = S2489hausF
