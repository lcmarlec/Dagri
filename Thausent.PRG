               Gx_err = GX_DB_SetStr( HStmt_T025512,5,AuxA2894HausD,100,0)
               THISFORM.A2894HausD = AuxA2894HausD
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T025512) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025512 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T025512) ,  ,  ,  , CS_SQLSRV , 0 )
