               Gx_err = GX_DB_SetStr( HStmt_T025513,3,AuxA2266CAuCo,4,0)
               THISFORM.A2266CAuCo = AuxA2266CAuCo
               AuxA2489hausF = THISFORM.A2489hausF
               Gx_err = GX_DB_SetDate( HStmt_T025513,4,@AuxA2489hausF,0)
               THISFORM.A2489hausF = AuxA2489hausF
               AuxA2894HausD = THISFORM.A2894HausD
               Gx_err = GX_DB_SetStr( HStmt_T025513,5,AuxA2894HausD,100,0)
               THISFORM.A2894HausD = AuxA2894HausD
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T025513) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025513 = Gx_err
               THISFORM.T02552 = iif( THISFORM.T025513 = 0 , 104 , THISFORM.T025513 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T025513) ,  ,  ,  , CS_SQLSRV , 0 )
