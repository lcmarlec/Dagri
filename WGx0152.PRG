      PROCEDURE CreateTemp
         LOCAL SCW223S20
         SCW223S20 = ""
         IF USED( "SCW223S20" )
            SELECT SCW223S20
            SCW223S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW223S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA406TdcRO"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA408TdcRO"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA410TdcCn"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 4

            GX_STRUCT[ 4 ,1]= "sA411TdcPr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 15
            GX_STRUCT[ 4 ,4]= 4

            GX_STRUCT[ 5 ,1]= "sA3FamCod"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW223S20 = GETE('z:\temp') + '\' + SCW223S20
            ENDIF
            CREATE DBF (SCW223S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW223S20) EXCLUSIVE ALIAS SCW223S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW223S20
         THIS.GX_SfAlias = "SCW223S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02232" , @HStmt_W02232 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0152","W02232","",GX_CURSOR_TYPE_READONLY,@HStmt_W02232) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TdcNroInt], [TdcObsLin], [FamCod], [TdcPrc], [TdcCnt], [TdcRORLin], "
                  cmdbuf = cmdbuf + "  [TdcRORNroI] FROM [TDCOM2] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [TdcNroInt] "
                  cmdbuf = cmdbuf + "  = ? and [TdcRORNroI] >= ? and [TdcRORLin] >= ?) AND ([TdcObsLin] like ?) AND ([TdcCnt] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([TdcPrc] >= ?) ORDER BY [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02232,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02232,9)
                  THISFORM.GX_DB_BindColsW02232_01 ()
                  THISFORM.GX_DB_BindParmW02232_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02232,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA380TdcNro = THISFORM.A380TdcNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02232,2,@AuxA380TdcNro,0)
               THISFORM.A380TdcNro = AuxA380TdcNro
               AuxAV5C406 = THISFORM.AV5C406
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02232,3,@AuxAV5C406,0)
               THISFORM.AV5C406 = AuxAV5C406
               AuxAV6C408 = THISFORM.AV6C408
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02232,4,@AuxAV6C408,0)
               THISFORM.AV6C408 = AuxAV6C408
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02232,5,PADR( TRIM(THISFORM.AV7C409),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C409),40, '%')),0)
               AuxAV8C410 = THISFORM.AV8C410
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02232,6,@AuxAV8C410,0)
               THISFORM.AV8C410 = AuxAV8C410
               AuxAV9C411 = THISFORM.AV9C411
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02232,7,@AuxAV9C411,0)
               THISFORM.AV9C411 = AuxAV9C411
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02232 = Gx_err
               THISFORM.GX_DB_GetW02232_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02232 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02232) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02232 = Gx_err
                  THISFORM.GX_DB_GetW02232_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02232 <> 101
               BRKV672 = .F.
               THISFORM.A409TdcObs = THISFORM.Buf_W02232_409TdcObsLin
               THISFORM.A3FamCod = THISFORM.Buf_W02232_3FamCod
               THISFORM.A411TdcPrc = THISFORM.Buf_W02232_411TdcPrc
               THISFORM.A410TdcCnt = THISFORM.Buf_W02232_410TdcCnt
               THISFORM.A408TdcROR = THISFORM.Buf_W02232_408TdcRORLin
               THISFORM.A406TdcROR = THISFORM.Buf_W02232_406TdcRORNroI
               GX_SFLOAD = 0
               THISFORM.U12V672 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02232 = Gx_err
               THISFORM.GX_DB_GetW02232_01 ()
            ENDDO
         ENDIF
      ENDPROC
