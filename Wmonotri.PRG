         THIS.GX_OldValue = THISFORM.AV17Actual
         THIS.AddData( "S" , "Si" )
         THIS.AddData( "N" , "No" )
         THIS.InitControl()
         CGXRadioButton ::Init
         THIS.GX_OldValue = THISFORM.AV17Actual
         THIS.GX_Level = 2
      ENDPROC
      PROCEDURE GotFocus
         CGXRadioButton ::GotFocus
         THIS.GXGotFocus()
         IF THISFORM.GX_NewLastVld > - 1
            THISFORM.GX_lastvld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         SET TOPIC TO Actualiza
         THISFORM.Gx_cursor = "THISFORM.AV17Actual"
         THISFORM.SetFKeys()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
      ENDPROC
      PROCEDURE Option1.LostFocus
         THIS.Parent.LostFocus
      ENDPROC
      PROCEDURE Option1.GotFocus
         THIS.Parent.gx_current_option = 1
         THIS.Parent.GotFocus
      ENDPROC
      PROCEDURE Option1.KeyPress(gx_key, gx_shift)
         THISFORM.gx_ctrReadkey = gx_key
         IF gx_key = 13
            NODEFAULT
            KEYBOARD "{TAB}"
         ENDIF
      ENDPROC
      PROCEDURE Option2.LostFocus
         THIS.Parent.LostFocus
      ENDPROC
      PROCEDURE Option2.GotFocus
         THIS.Parent.gx_current_option = 2
         THIS.Parent.GotFocus
      ENDPROC
      PROCEDURE Option2.KeyPress(gx_key, gx_shift)
         THISFORM.gx_ctrReadkey = gx_key
         IF gx_key = 13
            NODEFAULT
            KEYBOARD "{TAB}"
         ENDIF
      ENDPROC
      PROCEDURE LoadLocalVar
         THISFORM.AV17Actual = THIS.GetValue()
      ENDPROC
      PROCEDURE Refresh
         THIS.SetValue( THISFORM.AV17Actual )
         CGXRadioButton ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
   ENDDEFINE
