               DO GX_ERRMW WITH "Debe Ingresar un Empleado"
            CASE THISFORM.AV81Civeh = 1 .AND. THISFORM.AV78Campat = SPACE(8)
               THISFORM.Refresh()
               DO GX_ERRMW WITH "Debe Ingresar una Patente"
            OTHERWISE
               THISFORM.AV71Ciegrp = THISFORM.AV57Ciegr
               THISFORM.AV70Ciingp = THISFORM.AV60Ciing
               THISFORM.AV67Cimcod = THISFORM.AV61Cimcod
               THISFORM.AV69Ciobsp = THISFORM.AV64Ciobs
               THISFORM.AV75Cifchp = THISFORM.AV58Cifch
               THISFORM.AV77Campat = THISFORM.AV78Campat
               THISFORM.AV68Tracod = THISFORM.AV72Tracod
               DO CASE
                  CASE THISFORM.AV60Ciing = 0 .AND. THISFORM.AV57Ciegr = 0
                     THISFORM.Refresh()
                     DO GX_ERRMW WITH "Debe Ingresar un importe"
                  CASE THISFORM.AV60Ciing <> 0 .AND. THISFORM.AV57Ciegr <> 0
                     THISFORM.Refresh()
                     DO GX_ERRMW WITH "Debe Ingresar un importe de Ingreso o Egreso"
                  CASE THISFORM.AV58Cifch < THISFORM.AV76Ultcif
                     DO GX_ERRMW WITH "La fecha no puede ser anterior al  " + GXDTOC( THISFORM.AV76Ultcif )
                  OTHERWISE
                     IF THISFORM.AV60Ciing <> 0
                        THISFORM.Gx_msg = "Confirma el Ingreso por $" + ALLTRIM( str( THISFORM.AV60Ciing , 12 , 2 ) )
                     ELSE
                        THISFORM.Gx_msg = "Confirma el Egreso por $" + ALLTRIM( str( THISFORM.AV57Ciegr , 12 , 2 ) )
                     ENDIF
                     THISFORM.Refresh()
                     Response = .T.
                     DO GX_CONFW WITH THISFORM.Gx_msg , Response
                     IF Response
                        THISFORM.AV51Ok = 1
                        THISFORM.ReleaseAll()
                        RETURN
                     ENDIF
               ENDCASE
         ENDCASE
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

