            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         SET TOPIC TO Cisdo
         THISFORM.Gx_cursor = "THISFORM.AV65Cisdo"
         THISFORM.SetFKeys()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
   ENDDEFINE
