         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
