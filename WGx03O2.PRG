               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03412,5,PADR( TRIM(THISFORM.AV7C1183),20, '%'),LEN(PADR( TRIM(THISFORM.AV7C1183),20, '%')),0)
               AuxAV8C1184 = THISFORM.AV8C1184
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03412,6,@AuxAV8C1184,0)
               THISFORM.AV8C1184 = AuxAV8C1184
               AuxAV9C1185 = THISFORM.AV9C1185
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03412,7,@AuxAV9C1185,0)
               THISFORM.AV9C1185 = AuxAV9C1185
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03412) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03412 = Gx_err
               THISFORM.GX_DB_GetW03412_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03412 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03412) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03412 = Gx_err
                  THISFORM.GX_DB_GetW03412_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03412 <> 101
               BRKV9H2 = .F.
               THISFORM.A1184TdvCh = THISFORM.Buf_W03412_1184TdvChImp
               THISFORM.A1185TdvCh = THISFORM.Buf_W03412_1185TdvChNroI
               THISFORM.A1186TdvCh = THISFORM.Buf_W03412_1186TdvChLin
               THISFORM.A1183Tdvch = THISFORM.Buf_W03412_1183TdvchObs
               THISFORM.A1182TdVch = THISFORM.Buf_W03412_1182TdVchNro
               THISFORM.A1187TdVch = THISFORM.Buf_W03412_1187TdVchNroRe
               GX_SFLOAD = 0
               THISFORM.U12V9H2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03412) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03412 = Gx_err
               THISFORM.GX_DB_GetW03412_01 ()
            ENDDO
         ENDIF
      ENDPROC
