         THISFORM.LockScreen = .T.
         THISFORM. cCT109S21 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT109S21 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S380TdcNro = THISFORM.A380TdcNro .AND. S406TdcROR = THISFORM.A406TdcROR .AND. S408TdcROR = THISFORM.A408TdcROR
