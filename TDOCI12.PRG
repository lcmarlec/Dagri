      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T010922" , @HStmt_T010922 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDOCI12","T010922","",GX_CURSOR_TYPE_READONLY,@HStmt_T010922) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin], [TdcTotLiA], [TdcCnt], [TdcObsLin], "
                  cmdbuf = cmdbuf + "  [TdcPrc] FROM [TDCOM2] (NOLOCK) WHERE [EmpCod] = ? AND [TdcNroInt] = ? AND [TdcRORNroI] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T010922,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T010922,12)
                  THISFORM.GX_DB_BindColsT010922_01 ()
                  THISFORM.GX_DB_BindParmT010922_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T010922,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA380TdcNro = THISFORM.A380TdcNro
               Gx_err = GX_DB_SetDouble( HStmt_T010922,2,@AuxA380TdcNro,0)
               THISFORM.A380TdcNro = AuxA380TdcNro
               AuxA406TdcROR = THISFORM.A406TdcROR
               Gx_err = GX_DB_SetDouble( HStmt_T010922,3,@AuxA406TdcROR,0)
               THISFORM.A406TdcROR = AuxA406TdcROR
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T010922) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010922 = Gx_err
               THISFORM.GX_DB_GetT010922_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T010922 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T010922) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T010922 = Gx_err
                  THISFORM.GX_DB_GetT010922_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T010922 <> 101
               BRK3141 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT109S21.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T010922_406TdcRORNroI = THISFORM.A406TdcROR .AND. THISFORM.Buf_T010922_380TdcNroInt = THISFORM.A380TdcNro .AND. THISFORM.Buf_T010922_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T010922) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010922 = Gx_err
               THISFORM.GX_DB_GetT010922_01 ()
            ENDDO
         ENDIF
      ENDPROC
