                  THISFORM.GX_DB_BindParmT012110_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T012110,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
