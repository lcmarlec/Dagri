                  THISFORM.W08672 = Gx_err
                  THISFORM.GX_DB_GetW08672_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08672 <> 101
               BRKVO32 = .F.
               THISFORM.A2618ReIAc = THISFORM.Buf_W08672_2618ReIAccFyH
