      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08672" , @HStmt_W08672 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX08B3","W08672","",GX_CURSOR_TYPE_READONLY,@HStmt_W08672) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ReINroI], [ReIRoI], [ReIAccFyH] FROM [REINCID2] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [ReINroI] = ? and [ReIRoI] = ? and [ReIAccFyH] >= ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [ReINroI], [ReIRoI], [ReIAccFyH]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08672,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08672,9)
                  THISFORM.GX_DB_BindColsW08672_01 ()
                  THISFORM.GX_DB_BindParmW08672_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08672,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2616ReINr = THISFORM.A2616ReINr
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08672,2,@AuxA2616ReINr,0)
               THISFORM.A2616ReINr = AuxA2616ReINr
               AuxA2617ReIRo = THISFORM.A2617ReIRo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08672,3,AuxA2617ReIRo,1,0)
               THISFORM.A2617ReIRo = AuxA2617ReIRo
               AuxAV5C2618 = THISFORM.AV5C2618
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W08672,4,@AuxAV5C2618,0)
               THISFORM.AV5C2618 = AuxAV5C2618
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08672) ,  ,  ,  , CS_SQLSRV ,  )
