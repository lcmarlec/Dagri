               THISFORM.W08672 = Gx_err
               THISFORM.GX_DB_GetW08672_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08672 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
