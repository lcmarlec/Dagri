      PROCEDURE CreateTemp
         LOCAL SCW461S8
         SCW461S8 = ""
         IF USED( "SCW461S8" )
            SELECT SCW461S8
            SCW461S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW461S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "VAV21Asict"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV18Cuent"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV11Debe"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 14
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "VAV12Haber"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 14
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "VAV23Sdebe"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 14
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "VAV24Shabe"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 14
            GX_STRUCT[ 6 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW461S8 = GETE('z:\temp') + '\' + SCW461S8
            ENDIF
            CREATE DBF (SCW461S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW461S8) EXCLUSIVE ALIAS SCW461S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW461S8
         THIS.GX_SfAlias = "SCW461S8"
      ENDPROC
