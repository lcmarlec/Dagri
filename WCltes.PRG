      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00182" , @HStmt_W00182 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCLTES","W00182","",GX_CURSOR_TYPE_READONLY,@HStmt_W00182) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntGruTip], [EmpCod], [EntDom], [EntCont], [EntFan], [EntCui], [EntRaz], "
                  cmdbuf = cmdbuf + "  [EntCod] FROM [ENTID] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EntGruTip] "
                  cmdbuf = cmdbuf + "  = 'CL' and [EntCod] >= ?) AND ([EntCont] like ?) AND ([EntCui] = ? or ? = 0) AND "
                  cmdbuf = cmdbuf + "  ([EntDom] like ?) AND ([EntFan] like ?) AND ([EntRaz] like ?) ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [EntGruTip], [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00182,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00182,12)
                  THISFORM.GX_DB_BindColsW00182_01 ()
                  THISFORM.GX_DB_BindParmW00182_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00182,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV13Entcod = THISFORM.AV13Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00182,2,@AuxAV13Entcod,0)
               THISFORM.AV13Entcod = AuxAV13Entcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00182,3,PADR( TRIM(THISFORM.AV17Entcon),40, '%'),LEN(PADR( TRIM(THISFORM.AV17Entcon),40, '%')),0)
               AuxAV16Entcui = THISFORM.AV16Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00182,4,@AuxAV16Entcui,0)
               THISFORM.AV16Entcui = AuxAV16Entcui
               AuxAV16Entcui = THISFORM.AV16Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00182,5,@AuxAV16Entcui,0)
               THISFORM.AV16Entcui = AuxAV16Entcui
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00182,6,PADR( TRIM(THISFORM.AV18Entdom),40, '%'),LEN(PADR( TRIM(THISFORM.AV18Entdom),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00182,7,PADR( TRIM(THISFORM.AV15Entfan),40, '%'),LEN(PADR( TRIM(THISFORM.AV15Entfan),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00182,8,PADR( TRIM(THISFORM.AV14Entraz),40, '%'),LEN(PADR( TRIM(THISFORM.AV14Entraz),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00182) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00182 = Gx_err
               THISFORM.GX_DB_GetW00182_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WCltes"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00182 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00182) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00182 = Gx_err
                  THISFORM.GX_DB_GetW00182_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00182 <> 101
               BRKV0I2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W00182_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W00182_2EmpCod
               THISFORM.A156EntDom = THISFORM.Buf_W00182_156EntDom
               THISFORM.A155EntCon = THISFORM.Buf_W00182_155EntCont
               THISFORM.A154EntFan = THISFORM.Buf_W00182_154EntFan
               THISFORM.A166EntCui = THISFORM.Buf_W00182_166EntCui
               THISFORM.A153EntRaz = THISFORM.Buf_W00182_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W00182_120EntCod
               GX_SFLOAD = 0
               THISFORM.U29V0I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00182) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00182 = Gx_err
               THISFORM.GX_DB_GetW00182_01 ()
            ENDDO
         ENDIF
