      PROCEDURE CreateTemp
         LOCAL SCW241S20
         SCW241S20 = ""
         IF USED( "SCW241S20" )
            SELECT SCW241S20
            SCW241S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW241S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA619MCoCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA620MCoDs"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA621McoBc"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA624McoCt"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1209McoC"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW241S20 = GETE('z:\temp') + '\' + SCW241S20
            ENDIF
            CREATE DBF (SCW241S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW241S20) EXCLUSIVE ALIAS SCW241S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW241S20
         THIS.GX_SfAlias = "SCW241S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02412" , @HStmt_W02412 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01Q0","W02412","",GX_CURSOR_TYPE_READONLY,@HStmt_W02412) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [McoCtaCta], [McoTit], [McoFdi], [McoMBc], [McoCom], [McoCta], [McoBco], [MCoDsc], "
                  cmdbuf = cmdbuf + "  [MCoCod] FROM [MEDCOB] (FASTFIRSTROW NOLOCK) WHERE ([MCoCod] >= ?) AND ([McoBco] "
                  cmdbuf = cmdbuf + "  like ?) AND ([McoCta] like ?) AND ([McoCtaCta] >= ?) AND ([McoTit] like ?) AND ([McoFdi] "
                  cmdbuf = cmdbuf + "  like ?) AND ([McoMBc] like ?) ORDER BY [MCoCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02412,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02412,9)
                  THISFORM.GX_DB_BindColsW02412_01 ()
                  THISFORM.GX_DB_BindParmW02412_01 ()
               ENDIF
               AuxAV5C619 = THISFORM.AV5C619
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02412,1,@AuxAV5C619,0)
               THISFORM.AV5C619 = AuxAV5C619
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02412,2,PADR( TRIM(THISFORM.AV6C621),1, '%'),LEN(PADR( TRIM(THISFORM.AV6C621),1, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02412,3,PADR( TRIM(THISFORM.AV7C624),1, '%'),LEN(PADR( TRIM(THISFORM.AV7C624),1, '%')),0)
               AuxAV8C625 = THISFORM.AV8C625
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02412,4,@AuxAV8C625,0)
               THISFORM.AV8C625 = AuxAV8C625
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02412,5,PADR( TRIM(THISFORM.AV9C626),1, '%'),LEN(PADR( TRIM(THISFORM.AV9C626),1, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02412,6,PADR( TRIM(THISFORM.AV10C627),1, '%'),LEN(PADR( TRIM(THISFORM.AV10C627),1, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02412,7,PADR( TRIM(THISFORM.AV11C628),1, '%'),LEN(PADR( TRIM(THISFORM.AV11C628),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02412) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02412 = Gx_err
               THISFORM.GX_DB_GetW02412_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02412 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02412) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02412 = Gx_err
                  THISFORM.GX_DB_GetW02412_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02412 <> 101
               BRKV6P2 = .F.
               THISFORM.A625McoCta = THISFORM.Buf_W02412_625McoCtaCta
               THISFORM.A626McoTit = THISFORM.Buf_W02412_626McoTit
               THISFORM.A627McoFdi = THISFORM.Buf_W02412_627McoFdi
               THISFORM.A628McoMBc = THISFORM.Buf_W02412_628McoMBc
               THISFORM.A1209McoCo = THISFORM.Buf_W02412_1209McoCom
               THISFORM.A624McoCta = THISFORM.Buf_W02412_624McoCta
               THISFORM.A621McoBco = THISFORM.Buf_W02412_621McoBco
               THISFORM.A620MCoDsc = THISFORM.Buf_W02412_620MCoDsc
               THISFORM.A619MCoCod = THISFORM.Buf_W02412_619MCoCod
               GX_SFLOAD = 0
               THISFORM.U12V6P2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02412) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02412 = Gx_err
               THISFORM.GX_DB_GetW02412_01 ()
            ENDDO
         ENDIF
      ENDPROC
