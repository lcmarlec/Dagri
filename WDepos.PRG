                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00412) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00412 = Gx_err
               THISFORM.GX_DB_GetW00412_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WDepos"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00412 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00412) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00412 = Gx_err
                  THISFORM.GX_DB_GetW00412_01 ()
               ENDIF
         ENDCASE
