               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV12Nroint = THISFORM.AV12Nroint
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00412,2,@AuxAV12Nroint,0)
               THISFORM.AV12Nroint = AuxAV12Nroint
               Gx_eop = 1
