      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00412" , @HStmt_W00412 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDEPOS","W00412","",GX_CURSOR_TYPE_READONLY,@HStmt_W00412) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[TTesNroI], T3.[McoCta], T3.[McoBco], T1.[TTesLin], T1.[TTesImp], "
                  cmdbuf = cmdbuf + "  T1.[TTesFchDeb], T1.[TTesNro], T1.[TTesBcoCta], T2.[BcoDsc] AS TTesBcoDsc, T1.[TTesBcoCod] "
                  cmdbuf = cmdbuf + "  AS TTesBcoCod, T3.[MCoDsc] AS TTesMedDsc, T1.[TTesMedCod] AS TTesMedCod FROM (([TTESCYP1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[TTesBcoCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [MEDCOB] T3 (NOLOCK) ON T3.[MCoCod] = T1.[TTesMedCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[TTesNroI] = ? ORDER BY T1.[EmpCod], T1.[TTesNroI], T1.[TTesLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00412,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00412,13)
                  THISFORM.GX_DB_BindColsW00412_01 ()
                  THISFORM.GX_DB_BindParmW00412_01 ()
