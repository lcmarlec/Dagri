      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T030215" , @HStmt_T030215 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOMIDA","T030215","",GX_CURSOR_TYPE_READONLY,@HStmt_T030215) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [ComFch], [ComFcSer], [ComFcSuc], [ComFcNro], [TraCod], [ComTraFch], "
                  cmdbuf = cmdbuf + "  [ComTraObs] FROM [COMIDA1] (NOLOCK) WHERE [EmpCod] = ? AND [ComFch] = ? AND [ComFcSer] "
                  cmdbuf = cmdbuf + "  = ? AND [ComFcSuc] = ? AND [ComFcNro] = ? ORDER BY [EmpCod], [ComFch], [ComFcSer], "
                  cmdbuf = cmdbuf + "  [ComFcSuc], [ComFcNro], [TraCod], [ComTraFch]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T030215,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T030215,9)
                  THISFORM.GX_DB_BindColsT030215_01 ()
                  THISFORM.GX_DB_BindParmT030215_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T030215,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2899ComFc = THISFORM.A2899ComFc
               Gx_err = GX_DB_SetDate( HStmt_T030215,2,@AuxA2899ComFc,0)
               THISFORM.A2899ComFc = AuxA2899ComFc
               AuxA2900ComFc = THISFORM.A2900ComFc
               Gx_err = GX_DB_SetStr( HStmt_T030215,3,AuxA2900ComFc,1,0)
               THISFORM.A2900ComFc = AuxA2900ComFc
               AuxA2901ComFc = THISFORM.A2901ComFc
               Gx_err = GX_DB_SetInt( HStmt_T030215,4,@AuxA2901ComFc,0)
               THISFORM.A2901ComFc = AuxA2901ComFc
               AuxA2902ComFc = THISFORM.A2902ComFc
               Gx_err = GX_DB_SetLong( HStmt_T030215,5,@AuxA2902ComFc,0)
               THISFORM.A2902ComFc = AuxA2902ComFc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T030215) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030215 = Gx_err
               THISFORM.GX_DB_GetT030215_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T030215 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030215) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T030215 = Gx_err
                  THISFORM.GX_DB_GetT030215_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T030215 <> 101
               BRK8E335 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT302S24.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030215) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030215 = Gx_err
               THISFORM.GX_DB_GetT030215_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A561TraCod"
            THISFORM.A561TraCod = THISFORM.Buf_T030215_561TraCod
