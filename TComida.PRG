      PROCEDURE CreateTemp
         LOCAL SCT302S24
         SCT302S24 = ""
         IF USED( "SCT302S24" )
            SELECT SCT302S24
            SCT302S24 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT302S24
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA561TraCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2905ComT"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2907ComT"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 254
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT302S24 = GETE('z:\temp') + '\' + SCT302S24
            ENDIF
            CREATE DBF (SCT302S24) FROM ARRAY GX_STRUCT
            USE
            USE (SCT302S24) EXCLUSIVE ALIAS SCT302S24
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT302S24
         THIS.GX_SfAlias = "SCT302S24"
      ENDPROC
      PROCEDURE UpdObj(gxmode)
         LOCAL gxO_Area
         gxO_Area = SELECT()
         SELECT(gxO_Area)
