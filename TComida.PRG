      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03025,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA2899ComFc = THISFORM.A2899ComFc
            Gx_err = GX_DB_SetDate( HStmt_T03025,2,@AuxA2899ComFc,0)
            THISFORM.A2899ComFc = AuxA2899ComFc
            AuxA2900ComFc = THISFORM.A2900ComFc
            Gx_err = GX_DB_SetStr( HStmt_T03025,3,AuxA2900ComFc,1,0)
            THISFORM.A2900ComFc = AuxA2900ComFc
            AuxA2901ComFc = THISFORM.A2901ComFc
            Gx_err = GX_DB_SetInt( HStmt_T03025,4,@AuxA2901ComFc,0)
            THISFORM.A2901ComFc = AuxA2901ComFc
            AuxA2902ComFc = THISFORM.A2902ComFc
            Gx_err = GX_DB_SetLong( HStmt_T03025,5,@AuxA2902ComFc,0)
            THISFORM.A2902ComFc = AuxA2902ComFc
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03025) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03025 = Gx_err
            THISFORM.GX_DB_GetT03025_01 ()
            IF .NOT. THISFORM.T03025 <> 103
               DO GX_ERRMW WITH "COMIDA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03025 = 101 .OR. THISFORM.Z2903ComPe <> THISFORM.Buf_T03025_2903ComPerDde
               DO GX_ERRMW WITH "COMIDA fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03029" , @HStmt_T03029 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOMIDA","T03029","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03029) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [COMIDA] ([EmpCod], [ComFch], [ComFcSer], [ComFcSuc], [ComFcNro], [ComPerDde], "
                  cmdbuf = cmdbuf + "  [ComPerHta], [ComObs]) VALUES (?, ?, ?, ?, ?, ?, ?, ' ') "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03029,cmdbuf)
                  THISFORM.GX_DB_BindParmT03029_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03029,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2899ComFc = THISFORM.A2899ComFc
               Gx_err = GX_DB_SetDate( HStmt_T03029,2,@AuxA2899ComFc,0)
               THISFORM.A2899ComFc = AuxA2899ComFc
