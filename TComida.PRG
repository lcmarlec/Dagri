               AuxA2902ComFc = THISFORM.A2902ComFc
               Gx_err = GX_DB_SetLong( HStmt_T03029,5,@AuxA2902ComFc,0)
               THISFORM.A2902ComFc = AuxA2902ComFc
               AuxA2903ComPe = THISFORM.A2903ComPe
               Gx_err = GX_DB_SetDate( HStmt_T03029,6,@AuxA2903ComPe,0)
               THISFORM.A2903ComPe = AuxA2903ComPe
               AuxA2904ComPe = THISFORM.A2904ComPe
               Gx_err = GX_DB_SetDate( HStmt_T03029,7,@AuxA2904ComPe,0)
               THISFORM.A2904ComPe = AuxA2904ComPe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03029) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03029 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03029) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03029 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T030210" , @HStmt_T030210 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOMIDA","T030210","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T030210) ,  ,  ,  , CS_SQLSRV , 0 )
