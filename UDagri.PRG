         THISFORM.A3797msjes = THISFORM.Buf_W00273_3797msjest
         THISFORM.A3796msjfc = THISFORM.Buf_W00273_3796msjfch
         THISFORM.A3799msjde = THISFORM.Buf_W00273_3799msjdet
         THISFORM.A3798msjus = THISFORM.Buf_W00273_3798msjusude
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA3798msju WITH THISFORM.A3798msjus
         REPLACE sA3799msjd WITH THISFORM.A3799msjde
         REPLACE sA3796msjf WITH gxDtTtoC(THISFORM.A3796msjfc,8,5)
         REPLACE VAV17Leido WITH THISFORM.cCW27S8.Columns(4).Ctrl1.ValToText(THISFORM.AV17Leido)
         REPLACE sA3797msje WITH THISFORM.A3797msjes
         REPLACE sA3795msju WITH THISFORM.A3795msjus
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A3798msjus = sA3798msju
         THISFORM.A3799msjde = sA3799msjd
         THISFORM.A3796msjfc = GXDTCTOT(sA3796msjf)
         THISFORM.AV17Leido = THISFORM.cCW27S8.Columns(4).Ctrl1.TextToVal(VAV17Leido,"int",1)
         THISFORM.A3797msjes = sA3797msje
         THISFORM.A3795msjus = sA3795msju
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 4
            THISFORM.AV17Leido = THISFORM.cCW27S8.Columns(4).Ctrl1.TextToVal(THIS.Column4.Ctrl1.Value,"int",1)
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A3798msjus = SPACE(10)
         THISFORM.A3799msjde = SPACE(100)
         THISFORM.A3796msjfc = CTOT("  /  /  ")
         THISFORM.AV17Leido = 0
         THISFORM.A3797msjes = 0
         THISFORM.A3795msjus = SPACE(10)
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 4
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
