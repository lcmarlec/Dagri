      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00272" , @HStmt_W00272 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDAGRI","W00272","",GX_CURSOR_TYPE_READONLY,@HStmt_W00272) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ExeFlag], [ExeNom], [ExeDesc] FROM [EXES] (NOLOCK) WHERE ([ExeFlag] = 1) "
                  cmdbuf = cmdbuf + "  AND ([ExeNom] <> 'UREIMPRI' or ? = 9) ORDER BY [ExeNom]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00272,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00272,11)
                  THISFORM.GX_DB_BindColsW00272_01 ()
                  THISFORM.GX_DB_BindParmW00272_01 ()
               ENDIF
               AuxAV9Nivel = THISFORM.AV9Nivel
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00272,1,@AuxAV9Nivel,0)
               THISFORM.AV9Nivel = AuxAV9Nivel
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00272 = Gx_err
               THISFORM.GX_DB_GetW00272_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV22Pgmnam = "UDagri"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00272 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00272 <> 101
               BRKV0R2 = .F.
               THISFORM.A585ExeFla = THISFORM.Buf_W00272_585ExeFlag
               THISFORM.A583ExeNom = THISFORM.Buf_W00272_583ExeNom
               THISFORM.A584ExeDes = THISFORM.Buf_W00272_584ExeDesc
               GX_SFLOAD = 0
               THISFORM.cCW27S3.Load ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKV0R2
                  BRKV0R2 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00272) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00272 = Gx_err
                  THISFORM.GX_DB_GetW00272_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
