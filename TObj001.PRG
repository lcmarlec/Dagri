               ENDDO
               THISFORM.T00737 = Gx_err
               THISFORM.GX_DB_GetT00737_01 ()
               DO WHILE THISFORM.T00737 = 0 .AND. THISFORM.A680ObjCod >= THISFORM.Buf_T00737_680ObjCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00737) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00737 = Gx_err
                  THISFORM.GX_DB_GetT00737_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00737 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A680ObjCod = SPACE(8)
               AuxA680ObjCod = THISFORM.A680ObjCod
               Gx_err = GX_DB_SetStr( HStmt_T00737,1,AuxA680ObjCod,8,0)
               THISFORM.A680ObjCod = AuxA680ObjCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00737) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00737 = Gx_err
               THISFORM.GX_DB_GetT00737_01 ()
               DO WHILE THISFORM.T00737 = 0
                  THISFORM.A680ObjCod = THISFORM.Buf_T00737_680ObjCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00737) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00737 = Gx_err
                  THISFORM.GX_DB_GetT00737_01 ()
               ENDDO
               AuxA680ObjCod = THISFORM.A680ObjCod
               Gx_err = GX_DB_SetStr( HStmt_T00737,1,AuxA680ObjCod,8,0)
               THISFORM.A680ObjCod = AuxA680ObjCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00737) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00737 = Gx_err
               THISFORM.GX_DB_GetT00737_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A680ObjCod = THISFORM.Buf_T00737_680ObjCod
               THISFORM.A67ObjMax = THISFORM.Buf_T00737_67ObjMax
               THISFORM.A69ObjDsc = THISFORM.Buf_T00737_69ObjDsc
               THISFORM.A681ObjMod = THISFORM.Buf_T00737_681ObjMod
               THISFORM.A3171ObjLi = THISFORM.Buf_T00737_3171ObjLink
         ENDCASE
         Gx_fcond = THISFORM.T00737 <> 101 .AND. THISFORM.T00737 <> 101
         IF .NOT. Gx_fcond
