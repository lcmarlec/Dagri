      PROCEDURE CreateTemp
         LOCAL SCT73S14
         SCT73S14 = ""
         IF USED( "SCT73S14" )
            SELECT SCT73S14
            SCT73S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT73S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA68EmpNom"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT73S14 = GETE('z:\temp') + '\' + SCT73S14
            ENDIF
            CREATE DBF (SCT73S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCT73S14) EXCLUSIVE ALIAS SCT73S14
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT73S14
         THIS.GX_SfAlias = "SCT73S14"
      ENDPROC
