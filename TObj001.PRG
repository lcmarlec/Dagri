      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S680ObjCod
         LOCAL S2EmpCod
         S680ObjCod = THISFORM.A680ObjCod
         S2EmpCod = THISFORM.A2EmpCod
         THISFORM.A2EmpCod = THISFORM.M2EmpCod
         THISFORM. cCT73S14 .SaveTemp()
         THISFORM. cCT73S14 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT73S14 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT73S14 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT73S14 .SF( 3, @sf_err)     && Read
         Gx_fcond = S680ObjCod = THISFORM.A680ObjCod .AND. S2EmpCod = THISFORM.A2EmpCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT73S14 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT73S14 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S680ObjCod = THISFORM.A680ObjCod .AND. S2EmpCod = THISFORM.A2EmpCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT73S14 .Refresh()
               THISFORM. cCT73S14 .AfterRowColChange1()
               THISFORM.A680ObjCod = S680ObjCod
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT73S14 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT73S14 .LoadRec(2, @sf_err)
            Gx_fcond = S680ObjCod = THISFORM.A680ObjCod .AND. S2EmpCod = THISFORM.A2EmpCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT73S14 .LoadRec(2, @sf_err)
               Gx_fcond = S680ObjCod = THISFORM.A680ObjCod .AND. S2EmpCod = THISFORM.A2EmpCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT73S14 .AppendRow()
               THISFORM. cCT73S14 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A680ObjCod = S680ObjCod
               THISFORM.A2EmpCod = S2EmpCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A680ObjCod = S680ObjCod
         THISFORM.A2EmpCod = S2EmpCod
         RETURN .F.
      ENDFUNC
