         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A680ObjCod = SPACE(8)
               ENDIF
               AuxA680ObjCod = THISFORM.A680ObjCod
               Gx_err = GX_DB_SetStr( HStmt_T00737,1,AuxA680ObjCod,8,0)
