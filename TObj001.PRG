      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T007313" , @HStmt_T007313 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOBJ001","T007313","",GX_CURSOR_TYPE_READONLY,@HStmt_T007313) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [ObjCod], [EmpCod] FROM [OBJ0011] (NOLOCK) WHERE [ObjCod] = ? ORDER BY [ObjCod], "
                  cmdbuf = cmdbuf + "  [EmpCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007313,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007313,9)
                  THISFORM.GX_DB_BindColsT007313_01 ()
                  THISFORM.GX_DB_BindParmT007313_01 ()
               ENDIF
               AuxA680ObjCod = THISFORM.A680ObjCod
               Gx_err = GX_DB_SetStr( HStmt_T007313,1,AuxA680ObjCod,8,0)
               THISFORM.A680ObjCod = AuxA680ObjCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007313) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007313 = Gx_err
               THISFORM.GX_DB_GetT007313_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T007313 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007313) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T007313 = Gx_err
                  THISFORM.GX_DB_GetT007313_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T007313 <> 101
               BRK2175 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT73S14.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007313) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007313 = Gx_err
               THISFORM.GX_DB_GetT007313_01 ()
            ENDDO
         ENDIF
      ENDPROC
