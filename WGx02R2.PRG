      PROCEDURE CreateTemp
         LOCAL SCW276S20
         SCW276S20 = ""
         IF USED( "SCW276S20" )
            SELECT SCW276S20
            SCW276S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW276S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA893RORLi"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA894ROROC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3FamCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA4FamSubC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA5ArtCod"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW276S20 = GETE('z:\temp') + '\' + SCW276S20
            ENDIF
            CREATE DBF (SCW276S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW276S20) EXCLUSIVE ALIAS SCW276S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW276S20
         THIS.GX_SfAlias = "SCW276S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02762" , @HStmt_W02762 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02R2","W02762","",GX_CURSOR_TYPE_READONLY,@HStmt_W02762) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [RORNroInt], [ArtCod], [FamSubCod], [FamCod], [ROROCoNI], [RORLin] "
                  cmdbuf = cmdbuf + "  FROM [REMING1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [RORNroInt] = ? and "
                  cmdbuf = cmdbuf + "  [RORLin] >= ?) AND ([ROROCoNI] >= ?) AND ([FamCod] >= ?) AND ([FamSubCod] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([ArtCod] >= ?) ORDER BY [EmpCod], [RORNroInt], [RORLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02762,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02762,9)
                  THISFORM.GX_DB_BindColsW02762_01 ()
                  THISFORM.GX_DB_BindParmW02762_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02762,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA881RORNro = THISFORM.A881RORNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02762,2,@AuxA881RORNro,0)
               THISFORM.A881RORNro = AuxA881RORNro
               AuxAV5C893 = THISFORM.AV5C893
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02762,3,@AuxAV5C893,0)
               THISFORM.AV5C893 = AuxAV5C893
               AuxAV6C894 = THISFORM.AV6C894
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02762,4,@AuxAV6C894,0)
               THISFORM.AV6C894 = AuxAV6C894
               AuxAV7C3 = THISFORM.AV7C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02762,5,@AuxAV7C3,0)
               THISFORM.AV7C3 = AuxAV7C3
               AuxAV8C4 = THISFORM.AV8C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02762,6,@AuxAV8C4,0)
               THISFORM.AV8C4 = AuxAV8C4
               AuxAV9C5 = THISFORM.AV9C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02762,7,@AuxAV9C5,0)
               THISFORM.AV9C5 = AuxAV9C5
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02762) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02762 = Gx_err
               THISFORM.GX_DB_GetW02762_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02762 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02762) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02762 = Gx_err
                  THISFORM.GX_DB_GetW02762_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02762 <> 101
               BRKV7O2 = .F.
               THISFORM.A5ArtCod = THISFORM.Buf_W02762_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W02762_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W02762_3FamCod
               THISFORM.A894ROROCo = THISFORM.Buf_W02762_894ROROCoNI
               THISFORM.A893RORLin = THISFORM.Buf_W02762_893RORLin
               GX_SFLOAD = 0
               THISFORM.U12V7O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02762) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02762 = Gx_err
               THISFORM.GX_DB_GetW02762_01 ()
            ENDDO
         ENDIF
      ENDPROC
