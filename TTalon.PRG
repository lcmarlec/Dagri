                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01699) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01699 = Gx_err
               THISFORM.T01692 = iif( THISFORM.T01699 = 0 , 104 , THISFORM.T01699 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01699) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
               IF .T.
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A2EmpCod
                  Aux1 = THISFORM.A1721TalBc
                  Aux2 = THISFORM.A1723TalNr
                  Aux3 = THISFORM.A1724TalNr
                  DO PTalon WITH Aux0 , Aux1 , Aux2 , Aux3 , 1
                  THISFORM.A2EmpCod = Aux0
                  THISFORM.A1721TalBc = Aux1
                  THISFORM.A1723TalNr = Aux2
                  THISFORM.A1724TalNr = Aux3
                  THISFORM. cCT169A1721 .Refresh()
                  THISFORM. cCT169A1723 .Refresh()
                  THISFORM. cCT169A1724 .Refresh()
               ENDIF
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A1721TalBc , 3 ) + " " + str( THISFORM.A1723TalNr , 10 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "BCOS" , Aux1 , "TALONARIO" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT169V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 201 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
