      PROCEDURE DoNext
         LOCAL GXO_Area, gxO_Rec, GX_MVErr, GX_1stLvl
         GX_MVErr = 1
         GXO_Area = SELECT()
         gxO_Rec = 0
         GX_1stLvl = .F.
         THISFORM.LockScreen = .T.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 109
               THISFORM.SetFocusEnabled( THISFORM. cCT105A2 .TabIndex, 0, +1, .F., .T., .F. )
            OTHERWISE
               RETURN
         ENDCASE
         DO CASE
            CASE THISFORM.GX_Curr_Level = 109
               GX_1stLvl = .T.
               gxO_rec = IIF( EOF() .or. BOF(), 0, RECNO() )
               IF THISFORM.CanExitRec( 109 , "Descarta modificaciones (S/N)"  , .F. )
                  GX_MVErr = THISFORM. cCT105A1012 .MV( 2 )
                  IF GX_MVErr = 0
                     GX_MVErr = THISFORM. cCT105A1012 .MV( 6 )
                  ENDIF
               ENDIF
            OTHERWISE
               THISFORM.LockScreen = .F.
               RETURN
         ENDCASE
         IF GX_MVErr != 0
            IF (! GX_1stLvl .and. gxO_Rec != 0) .or. (GX_1stLvl .and. gxO_Rec > 0)
               IF gxO_Rec != 0
                  GOTO (gxO_Rec)
               ENDIF
            ENDIF
         ELSE
            THISFORM.LoadObj(2)
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         SELECT (GXO_Area)
         THISFORM.LockScreen = .F.
      ENDPROC
