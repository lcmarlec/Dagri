      PROCEDURE CreateTemp
         LOCAL SCW738S20
         SCW738S20 = ""
         IF USED( "SCW738S20" )
            SELECT SCW738S20
            SCW738S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW738S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA705OfeFD"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA150EntGr"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 2
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW738S20 = GETE('z:\temp') + '\' + SCW738S20
            ENDIF
            CREATE DBF (SCW738S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW738S20) EXCLUSIVE ALIAS SCW738S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW738S20
         THIS.GX_SfAlias = "SCW738S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07382" , @HStmt_W07382 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX05Z0","W07382","",GX_CURSOR_TYPE_READONLY,@HStmt_W07382) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntCod], [EntLgGrpOf], [EntGruTip], [OfeFDe], [ArtCod], [FamSubCod], [FamCod], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [OFEGRP] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [FamCod] >= "
                  cmdbuf = cmdbuf + "  ? and [FamSubCod] >= ? and [ArtCod] >= ? and [OfeFDe] >= ? and [EntLgGrpOf] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([EntGruTip] like ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfeFDe], "
                  cmdbuf = cmdbuf + "  [EntLgGrpOf], [EntGruTip], [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07382,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07382,9)
                  THISFORM.GX_DB_BindColsW07382_01 ()
                  THISFORM.GX_DB_BindParmW07382_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07382,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07382,2,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07382,3,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               AuxAV8C5 = THISFORM.AV8C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07382,4,@AuxAV8C5,0)
               THISFORM.AV8C5 = AuxAV8C5
               AuxAV9C705 = THISFORM.AV9C705
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07382,5,@AuxAV9C705,0)
               THISFORM.AV9C705 = AuxAV9C705
               AuxAV10C1845 = THISFORM.AV10C1845
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07382,6,@AuxAV10C1845,0)
               THISFORM.AV10C1845 = AuxAV10C1845
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07382,7,PADR( TRIM(THISFORM.AV11C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV11C150),2, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07382) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07382 = Gx_err
               THISFORM.GX_DB_GetW07382_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07382 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07382) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07382 = Gx_err
                  THISFORM.GX_DB_GetW07382_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07382 <> 101
               BRKVKI2 = .F.
               THISFORM.A120EntCod = THISFORM.Buf_W07382_120EntCod
               THISFORM.A1845EntLg = THISFORM.Buf_W07382_1845EntLgGrpOf
               THISFORM.A150EntGru = THISFORM.Buf_W07382_150EntGruTip
               THISFORM.A705OfeFDe = THISFORM.Buf_W07382_705OfeFDe
               THISFORM.A5ArtCod = THISFORM.Buf_W07382_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W07382_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W07382_3FamCod
               THISFORM.A2EmpCod = THISFORM.Buf_W07382_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VKI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07382) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07382 = Gx_err
               THISFORM.GX_DB_GetW07382_01 ()
            ENDDO
         ENDIF
      ENDPROC
