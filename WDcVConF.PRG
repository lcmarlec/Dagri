            THISFORM.GX_DB_BindParmW10323_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10323,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA415DcVNro = THISFORM.A415DcVNro
         THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10323,2,@AuxA415DcVNro,0)
         THISFORM.A415DcVNro = AuxA415DcVNro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10323) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W10323 = Gx_err
         THISFORM.GX_DB_GetW10323_01 ()
         DO WHILE THISFORM.W10323 <> 101
            THISFORM.A455DcVPed = THISFORM.Buf_W10323_455DcVPedNro
            IF .NOT. EMPTY( THISFORM.A1597DcVSe )
               THISFORM.AV34Obs = "*"
            ELSE
               THISFORM.AV34Obs = " "
            ENDIF
            IF THISFORM.A455DcVPed = THISFORM.AV23Ruta .OR. THISFORM.AV23Ruta = 0
               THISFORM.AV32Pednro = THISFORM.A455DcVPed
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10324" , @HStmt_W10324 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCVCONF","W10324","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W10324) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RutChfCod] AS RutChfCod, T1.[RutCod], T1.[EmpCod], T2.[ChfNom] AS RutChfNom "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ChfCod] = T1.[RutChfCod]) WHERE T1.[EmpCod] = ? and T1.[RutCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[RutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10324,cmdbuf)
                  THISFORM.GX_DB_BindColsW10324_01 ()
                  THISFORM.GX_DB_BindParmW10324_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10324,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxA455DcVPed = THISFORM.A455DcVPed
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10324,2,@AuxA455DcVPed,0)
               THISFORM.A455DcVPed = AuxA455DcVPed
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10324) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10324 = Gx_err
               THISFORM.GX_DB_GetW10324_01 ()
               DO WHILE THISFORM.W10324 <> 101
                  THISFORM.A1216RutCh = THISFORM.Buf_W10324_1216RutChfCod
                  THISFORM.A966RutCod = THISFORM.Buf_W10324_966RutCod
                  THISFORM.A2EmpCod = THISFORM.Buf_W10324_2EmpCod
                  THISFORM.A1217RutCh = THISFORM.Buf_W10324_1217RutChfNom
                  THISFORM.A1217RutCh = THISFORM.Buf_W10324_1217RutChfNom
                  THISFORM.AV30Rutchf = THISFORM.A1217RutCh
                  * Check if program is canceled.
                  DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
                  IF UserCancel
                     EXIT
                  ENDIF
                  * Exiting from a For First loop.
                  EXIT
               ENDDO
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W10324) ,  ,  ,  , CS_SQLSRV ,  )
               IF THISFORM.cCW1032S10 .GX_rec_loaded >= 10000
                  DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
                  GX_SFLOAD = 2
               ELSE
                  THISFORM.cCW1032S10 .GX_rec_loaded =  THISFORM.cCW1032S10 .GX_rec_loaded + 1
                  SELECT( THISFORM.cCW1032S10 .GX_SfAlias)
                  GX_SFLOAD = 1
                  APPEND BLANK
                  THISFORM.cCW1032S10 .SaveTemp()
               ENDIF
               * Exit For each command. Update data (if necessary), close cursors & exit.
               EXIT
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10323) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W10323 = Gx_err
            THISFORM.GX_DB_GetW10323_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W10323) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

