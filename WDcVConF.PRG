                  cmdbuf = cmdbuf + "  T1.[DcvSegEst], T1.[DcvSegFFX], T1.[DcvSegOfx], T1.[DcvSegEFX], T1.[DcvFac], T1.[DcVTot], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVNro], T1.[DcVSuc], "
                  cmdbuf = cmdbuf + "  T1.[DcVSer], T1.[DcvTipRed], T1.[DcVTip], T1.[DcVFch] FROM ([DCVENT] T1 (NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[DcVEntGruT] AND T2.[EntCod] = T1.[DcVEntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[DcVFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[DcVFch] <= ?) AND (T1.[DcVNro] >= ?) AND (T1.[DcVSer] = ? or ? = "
                  cmdbuf = cmdbuf + "  'T') AND (T1.[DcVSuc] = ? or ? = 0) AND (T1.[DcvFac] = 1) AND (T1.[DcvTipRed] = "
                  cmdbuf = cmdbuf + "  'FC') AND (T1.[DcvSegEFX] = ? or ? = -1) ORDER BY T1.[EmpCod], T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10322,cmdbuf)
