               THISFORM.gx_RefKeep = .T.
            ENDIF
            THISFORM.GX_Refresh = 0
            THISFORM. cCW1032S10 .GXRefreshSf( .F., .T.)
            THISFORM.gx_RefKeep = .F.
         ENDIF
         THISFORM. cCW1032S10 .GXSaveTempSf( GX_Ref )
