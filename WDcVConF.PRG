         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10323" , @HStmt_W10323 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCVCONF","W10323","",GX_CURSOR_TYPE_READONLY,@HStmt_W10323) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [DcVLIn], [EmpCod], [DcVNroInt], [DcVPedNro] FROM [DCVENT1] (NOLOCK) WHERE "
            cmdbuf = cmdbuf + "  [EmpCod] = ? and [DcVNroInt] = ? ORDER BY [EmpCod], [DcVNroInt]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10323,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10323,13)
