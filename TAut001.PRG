      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA64UsuCod = THISFORM.A64UsuCod
            Gx_err = GX_DB_SetStr( HStmt_T00092,1,AuxA64UsuCod,10,0)
            THISFORM.A64UsuCod = AuxA64UsuCod
