            THISFORM.A73AutHora = SUBSTR(TIME(), 1, 8)
         ENDIF
         THISFORM. cCT9A73 .Refresh()
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 6 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
