      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T000910" , @HStmt_T000910 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TAUT001","T000910","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T000910) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [AUT001] ([UsuCod], [ObjCodAut], [EmpCod], [AutFecha], [AutHora], [AutMax], "
                  cmdbuf = cmdbuf + "  [AutUsuCod], [AutNivel]) VALUES (?, ?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T000910,cmdbuf)
                  THISFORM.GX_DB_BindParmT000910_01 ()
               ENDIF
               AuxA64UsuCod = THISFORM.A64UsuCod
               Gx_err = GX_DB_SetStr( HStmt_T000910,1,AuxA64UsuCod,10,0)
               THISFORM.A64UsuCod = AuxA64UsuCod
               AuxA66ObjCodA = THISFORM.A66ObjCodA
               Gx_err = GX_DB_SetStr( HStmt_T000910,2,AuxA66ObjCodA,8,0)
               THISFORM.A66ObjCodA = AuxA66ObjCodA
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T000910,3,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA72AutFech = THISFORM.A72AutFech
               Gx_err = GX_DB_SetDate( HStmt_T000910,4,@AuxA72AutFech,0)
               THISFORM.A72AutFech = AuxA72AutFech
               AuxA73AutHora = THISFORM.A73AutHora
               Gx_err = GX_DB_SetStr( HStmt_T000910,5,AuxA73AutHora,8,0)
               THISFORM.A73AutHora = AuxA73AutHora
               AuxA70AutMax = THISFORM.A70AutMax
               Gx_err = GX_DB_SetDouble( HStmt_T000910,6,@AuxA70AutMax,0)
               THISFORM.A70AutMax = AuxA70AutMax
               AuxA71AutUsuC = THISFORM.A71AutUsuC
