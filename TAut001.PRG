      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A72AutFech = DATE()
               ENDIF
               THISFORM. cCT9A72 .Refresh()
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A73AutHora = SUBSTR(TIME(), 1, 8)
               ENDIF
               THISFORM. cCT9A73 .Refresh()
            CASE gxmode = "UPD"   && After update
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A72AutFech = DATE()
               ENDIF
               THISFORM. cCT9A72 .Refresh()
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A73AutHora = SUBSTR(TIME(), 1, 8)
               ENDIF
               THISFORM. cCT9A73 .Refresh()
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
