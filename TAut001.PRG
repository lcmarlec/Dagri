            cmdbuf = cmdbuf + "  [AutUsuCod], [AutNivel] FROM [AUT001] (FASTFIRSTROW NOLOCK) WHERE [UsuCod] >= ? "
            cmdbuf = cmdbuf + "  and [ObjCodAut] >= ? and [EmpCod] >= ? ORDER BY [UsuCod], [ObjCodAut], [EmpCod] "
            cmdbuf = cmdbuf + "   "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00099,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00099,100)
            THISFORM.GX_DB_BindColsT00099_01 ()
            THISFORM.GX_DB_BindParmT00099_01 ()
