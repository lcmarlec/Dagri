            Gx_err = GX_DB_SetInt( HStmt_T00092,3,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00092) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00092 = Gx_err
            THISFORM.GX_DB_GetT00092_01 ()
            IF .NOT. THISFORM.T00092 <> 103
               DO GX_ERRMW WITH "AUT001 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00092 = 101 .OR. THISFORM.Z72AutFech <> THISFORM.Buf_T00092_72AutFecha
               DO GX_ERRMW WITH "AUT001 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
