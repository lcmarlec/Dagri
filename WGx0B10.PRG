      PROCEDURE CreateTemp
         LOCAL SCW1210S20
         SCW1210S20 = ""
         IF USED( "SCW1210S20" )
            SELECT SCW1210S20
            SCW1210S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1210S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3483tmlf"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 16
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3496tmlf"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3484tmlu"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3485tmli"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 6
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3486tmli"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 6
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1210S20 = GETE('z:\temp') + '\' + SCW1210S20
            ENDIF
            CREATE DBF (SCW1210S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1210S20) EXCLUSIVE ALIAS SCW1210S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1210S20
         THIS.GX_SfAlias = "SCW1210S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12102" , @HStmt_W12102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0B10","W12102","",GX_CURSOR_TYPE_READONLY,@HStmt_W12102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [tmlind4], [tmlind3], [tmlind2], [tmlind1], [tmlusu], [tmlfch], [tmlfyh], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [TMPLIS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [tmlfyh] >= "
                  cmdbuf = cmdbuf + "  ? and [tmlfch] >= ?) AND ([tmlusu] like ?) AND ([tmlind1] >= ?) AND ([tmlind2] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([tmlind3] >= ?) ORDER BY [EmpCod], [tmlfyh], [tmlfch], [tmlusu], [tmlind1], "
                  cmdbuf = cmdbuf + "  [tmlind2], [tmlind3], [tmlind4]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12102,9)
                  THISFORM.GX_DB_BindColsW12102_01 ()
                  THISFORM.GX_DB_BindParmW12102_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12102,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C3483 = THISFORM.AV6C3483
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12102,2,@AuxAV6C3483,0)
               THISFORM.AV6C3483 = AuxAV6C3483
               AuxAV7C3496 = THISFORM.AV7C3496
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12102,3,@AuxAV7C3496,0)
               THISFORM.AV7C3496 = AuxAV7C3496
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12102,4,PADR( TRIM(THISFORM.AV8C3484),10, '%'),LEN(PADR( TRIM(THISFORM.AV8C3484),10, '%')),0)
               AuxAV9C3485 = THISFORM.AV9C3485
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12102,5,@AuxAV9C3485,0)
               THISFORM.AV9C3485 = AuxAV9C3485
               AuxAV10C3486 = THISFORM.AV10C3486
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12102,6,@AuxAV10C3486,0)
               THISFORM.AV10C3486 = AuxAV10C3486
               AuxAV11C3487 = THISFORM.AV11C3487
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12102,7,@AuxAV11C3487,0)
               THISFORM.AV11C3487 = AuxAV11C3487
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12102 = Gx_err
               THISFORM.GX_DB_GetW12102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12102 = Gx_err
                  THISFORM.GX_DB_GetW12102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12102 <> 101
               BRKVXM2 = .F.
               THISFORM.A3488tmlin = THISFORM.Buf_W12102_3488tmlind4
               THISFORM.A3487tmlin = THISFORM.Buf_W12102_3487tmlind3
               THISFORM.A3486tmlin = THISFORM.Buf_W12102_3486tmlind2
               THISFORM.A3485tmlin = THISFORM.Buf_W12102_3485tmlind1
               THISFORM.A3484tmlus = THISFORM.Buf_W12102_3484tmlusu
               THISFORM.A3496tmlfc = THISFORM.Buf_W12102_3496tmlfch
               THISFORM.A3483tmlfy = THISFORM.Buf_W12102_3483tmlfyh
               THISFORM.A2EmpCod = THISFORM.Buf_W12102_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VXM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12102 = Gx_err
               THISFORM.GX_DB_GetW12102_01 ()
            ENDDO
         ENDIF
      ENDPROC
