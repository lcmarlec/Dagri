      PROCEDURE CreateTemp
         LOCAL SCW248S14
         SCW248S14 = ""
         IF USED( "SCW248S14" )
            SELECT SCW248S14
            SCW248S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW248S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA666NDPNr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA667NdpEn"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA668NdpEn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW248S14 = GETE('z:\temp') + '\' + SCW248S14
            ENDIF
            CREATE DBF (SCW248S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW248S14) EXCLUSIVE ALIAS SCW248S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW248S14
         THIS.GX_SfAlias = "SCW248S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02482" , @HStmt_W02482 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01X0","W02482","",GX_CURSOR_TYPE_READONLY,@HStmt_W02482) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [NdpEntCod], [NdpEntGruT], [NDPNroInt], [EmpCod] FROM [NDPPEN] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ? and [NDPNroInt] >= ?) AND ([NdpEntGruT] like ?) AND "
                  cmdbuf = cmdbuf + "  ([NdpEntCod] >= ?) ORDER BY [EmpCod], [NDPNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02482,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02482,8)
                  THISFORM.GX_DB_BindColsW02482_01 ()
                  THISFORM.GX_DB_BindParmW02482_01 ()
               ENDIF
               AuxAV20C2 = THISFORM.AV20C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02482,1,@AuxAV20C2,0)
               THISFORM.AV20C2 = AuxAV20C2
               AuxAV19C666 = THISFORM.AV19C666
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02482,2,@AuxAV19C666,0)
               THISFORM.AV19C666 = AuxAV19C666
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02482,3,PADR( TRIM(THISFORM.AV18C667),2, '%'),LEN(PADR( TRIM(THISFORM.AV18C667),2, '%')),0)
               AuxAV17C668 = THISFORM.AV17C668
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02482,4,@AuxAV17C668,0)
               THISFORM.AV17C668 = AuxAV17C668
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02482) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02482 = Gx_err
               THISFORM.GX_DB_GetW02482_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02482 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02482) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02482 = Gx_err
                  THISFORM.GX_DB_GetW02482_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02482 <> 101
               BRKV6W2 = .F.
               THISFORM.A668NdpEnt = THISFORM.Buf_W02482_668NdpEntCod
               THISFORM.A667NdpEnt = THISFORM.Buf_W02482_667NdpEntGruT
               THISFORM.A666NDPNro = THISFORM.Buf_W02482_666NDPNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W02482_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V6W2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02482) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02482 = Gx_err
               THISFORM.GX_DB_GetW02482_01 ()
            ENDDO
         ENDIF
      ENDPROC
