               Gx_err = GX_DB_SetInt( HStmt_T00475,9,@AuxA535V11IMP,0)
               THISFORM.A535V11IMP = AuxA535V11IMP
               AuxA536V11DES = THISFORM.A536V11DES
               Gx_err = GX_DB_SetStr( HStmt_T00475,10,AuxA536V11DES,30,0)
               THISFORM.A536V11DES = AuxA536V11DES
               AuxA537V11COD = THISFORM.A537V11COD
               Gx_err = GX_DB_SetLong( HStmt_T00475,11,@AuxA537V11COD,0)
