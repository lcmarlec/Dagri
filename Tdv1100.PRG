               AuxA537V11COD = THISFORM.A537V11COD
               Gx_err = GX_DB_SetLong( HStmt_T00476,7,@AuxA537V11COD,0)
               THISFORM.A537V11COD = AuxA537V11COD
               AuxA494V10FEC = THISFORM.A494V10FEC
               Gx_err = GX_DB_SetDate( HStmt_T00476,8,@AuxA494V10FEC,0)
               THISFORM.A494V10FEC = AuxA494V10FEC
               AuxA495V10TIP = THISFORM.A495V10TIP
               Gx_err = GX_DB_SetInt( HStmt_T00476,9,@AuxA495V10TIP,0)
               THISFORM.A495V10TIP = AuxA495V10TIP
               AuxA497V10NUM = THISFORM.A497V10NUM
               Gx_err = GX_DB_SetStr( HStmt_T00476,10,AuxA497V10NUM,12,0)
               THISFORM.A497V10NUM = AuxA497V10NUM
               AuxA530V11COD = THISFORM.A530V11COD
               Gx_err = GX_DB_SetLong( HStmt_T00476,11,@AuxA530V11COD,0)
               THISFORM.A530V11COD = AuxA530V11COD
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00476) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00476 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00476) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00477" , @HStmt_T00477 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDV1100","T00477","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00477) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [DV1100]  WHERE [V10FECDOC] = ? AND [V10TIPDOC] = ? AND [V10NUMDOC] = "
                  cmdbuf = cmdbuf + "  ? AND [V11CODART] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00477,cmdbuf)
                  THISFORM.GX_DB_BindParmT00477_01 ()
               ENDIF
               AuxA494V10FEC = THISFORM.A494V10FEC
               Gx_err = GX_DB_SetDate( HStmt_T00477,1,@AuxA494V10FEC,0)
               THISFORM.A494V10FEC = AuxA494V10FEC
               AuxA495V10TIP = THISFORM.A495V10TIP
               Gx_err = GX_DB_SetInt( HStmt_T00477,2,@AuxA495V10TIP,0)
               THISFORM.A495V10TIP = AuxA495V10TIP
               AuxA497V10NUM = THISFORM.A497V10NUM
               Gx_err = GX_DB_SetStr( HStmt_T00477,3,AuxA497V10NUM,12,0)
