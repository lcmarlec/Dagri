                  THISFORM.GX_DB_BindParmT00475_01 ()
               ENDIF
               AuxA494V10FEC = THISFORM.A494V10FEC
               Gx_err = GX_DB_SetDate( HStmt_T00475,1,@AuxA494V10FEC,0)
               THISFORM.A494V10FEC = AuxA494V10FEC
