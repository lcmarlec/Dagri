               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00475) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00475 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00475) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00475 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00476" , @HStmt_T00476 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDV1100","T00476","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00476) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [DV1100] SET [V11CANCAJ]=?, [V11UNXCAJ]=?, [V11KGXCAJ]=?, [V11PREART]=?, [V11IMPART]=?, "
                  cmdbuf = cmdbuf + "  [V11DESCRI]=?, [V11CODCLI]=?  WHERE [V10FECDOC] = ? AND [V10TIPDOC] = ? AND [V10NUMDOC] "
                  cmdbuf = cmdbuf + "  = ? AND [V11CODART] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00476,cmdbuf)
