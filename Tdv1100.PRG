            cmdbuf = cmdbuf + "  [V11KGXCAJ], [V11PREART], [V11IMPART], [V11DESCRI], [V11CODCLI] FROM [DV1100] (FASTFIRSTROW "
            cmdbuf = cmdbuf + "  NOLOCK) WHERE [V10FECDOC] >= ? and [V10TIPDOC] >= ? and [V10NUMDOC] >= ? and [V11CODART] "
            cmdbuf = cmdbuf + "  >= ? ORDER BY [V10FECDOC], [V10TIPDOC], [V10NUMDOC], [V11CODART]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00474,cmdbuf)
