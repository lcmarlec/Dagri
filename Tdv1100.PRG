               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00477) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00477 = Gx_err
               THISFORM.T00472 = iif( THISFORM.T00477 = 0 , 104 , THISFORM.T00477 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00477) ,  ,  ,  , CS_SQLSRV , 0 )
