               ENDIF
               AuxA531V11CAN = THISFORM.A531V11CAN
               Gx_err = GX_DB_SetLong( HStmt_T00476,1,@AuxA531V11CAN,0)
               THISFORM.A531V11CAN = AuxA531V11CAN
               AuxA532V11UNX = THISFORM.A532V11UNX
               Gx_err = GX_DB_SetLong( HStmt_T00476,2,@AuxA532V11UNX,0)
               THISFORM.A532V11UNX = AuxA532V11UNX
               AuxA533V11KGX = THISFORM.A533V11KGX
               Gx_err = GX_DB_SetLong( HStmt_T00476,3,@AuxA533V11KGX,0)
               THISFORM.A533V11KGX = AuxA533V11KGX
               AuxA534V11PRE = THISFORM.A534V11PRE
