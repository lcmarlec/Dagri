         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA494V10FEC = THISFORM.A494V10FEC
            Gx_err = GX_DB_SetDate( HStmt_T00472,1,@AuxA494V10FEC,0)
            THISFORM.A494V10FEC = AuxA494V10FEC
            AuxA495V10TIP = THISFORM.A495V10TIP
            Gx_err = GX_DB_SetInt( HStmt_T00472,2,@AuxA495V10TIP,0)
            THISFORM.A495V10TIP = AuxA495V10TIP
            AuxA497V10NUM = THISFORM.A497V10NUM
            Gx_err = GX_DB_SetStr( HStmt_T00472,3,AuxA497V10NUM,12,0)
            THISFORM.A497V10NUM = AuxA497V10NUM
            AuxA530V11COD = THISFORM.A530V11COD
            Gx_err = GX_DB_SetLong( HStmt_T00472,4,@AuxA530V11COD,0)
            THISFORM.A530V11COD = AuxA530V11COD
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00472) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00472 = Gx_err
            THISFORM.GX_DB_GetT00472_01 ()
            IF .NOT. THISFORM.T00472 <> 103
               DO GX_ERRMW WITH "DV1100 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00472 = 101 .OR. THISFORM.Z531V11CAN <> THISFORM.Buf_T00472_531V11CANCAJ
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z536V11DES <> THISFORM.Buf_T00472_536V11DESCRI
               DO GX_ERRMW WITH "DV1100 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
