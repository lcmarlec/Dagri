      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00587" , @HStmt_T00587 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLIMSE","T00587","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00587) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [BANCOS2] ([BcoCta], [BcoFDe], [BcoFHa], [BcoSld], [BcoMax]) VALUES (?, "
                  cmdbuf = cmdbuf + "  ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00587,cmdbuf)
                  THISFORM.GX_DB_BindParmT00587_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T00587,1,@AuxA76BcoCta,0)
