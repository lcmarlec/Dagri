               THISFORM.A83BcoFHa = AuxA83BcoFHa
               AuxA85BcoSld = THISFORM.A85BcoSld
               Gx_err = GX_DB_SetDouble( HStmt_T00587,4,@AuxA85BcoSld,0)
               THISFORM.A85BcoSld = AuxA85BcoSld
               AuxA84BcoMax = THISFORM.A84BcoMax
               Gx_err = GX_DB_SetDouble( HStmt_T00587,5,@AuxA84BcoMax,0)
               THISFORM.A84BcoMax = AuxA84BcoMax
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00587) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00587 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00587) ,  ,  ,  , CS_SQLSRV , 0 )
