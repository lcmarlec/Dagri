               ENDIF
               Gx_err = GX_DB_SetInt( HStmt_R04835,1,@R2EmpCod,0)
               Gx_err = GX_DB_SetStr( HStmt_R04835,2,RV12Dcvtip,2,0)
               Gx_err = GX_DB_SetStr( HStmt_R04835,3,AV13Dcvser,1,0)
               Gx_err = GX_DB_SetInt( HStmt_R04835,4,@AV10Dcvsuc,0)
               Gx_err = GX_DB_SetDate( HStmt_R04835,5,@AV14Dcvfch,0)
               Gx_err = GX_DB_SetDate( HStmt_R04835,6,@AV14Dcvfch,0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R04835) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               R04835 = Gx_err
               GX_DB_GetR04835_01 ()
               DO WHILE R04835 <> 101
                  R1340CAITi = Buf_R04835_1340CAITipDoc
                  R1376CAISe = Buf_R04835_1376CAISer
                  R1341CAISu = Buf_R04835_1341CAISuc
                  R1337CAIFc = Buf_R04835_1337CAIFchDde
                  R1338CAIFc = Buf_R04835_1338CAIFchHta
                  RV29GXLvl4 = 1
                  AV11Okcai = "S"
                  * Exit For each command. Update data (if necessary), close cursors & exit.
                  EXIT
                  * Check if program is canceled.
                  DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
                  IF UserCancel
                     EXIT
                  ENDIF
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R04835) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  R04835 = Gx_err
