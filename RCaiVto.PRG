                  ENDIF
               ENDDO
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R04835) ,  ,  ,  , CS_SQLSRV ,  )
               LEVEL5 = .F.
               IF RV29GXLvl4 = 0
                  AV11Okcai = "N"
               ENDIF
            ELSE
