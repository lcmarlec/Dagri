            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
            IF UserCancel
               EXIT
            ENDIF
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R04834) ,  ,  ,  , CS_SQLSRV ,  )
         LEVEL4 = .F.
         DO EPDF0
         RETURN
      ENDIF
   ENDIF
   DO EPDF0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

