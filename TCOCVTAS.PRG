      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011510" , @HStmt_T011510 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOCVTAS","T011510","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T011510) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [DCVENT] ([DcvTipRed], [EmpCod], [DcVNroInt], [DcVEntGruT], [DcVEntCod], "
                  cmdbuf = cmdbuf + "  [DcVEntLgCo], [DcVFch], [DcVTip], [DcVSer], [DcVSuc], [DcVNro], [DcVNet], [DcVTot], "
                  cmdbuf = cmdbuf + "  [DcVFv], [DcVEst], [DcVCtaCte], [DcVNetSld], [DcVTotSld], [DcVTipaf], [DcVSeraf], "
                  cmdbuf = cmdbuf + "  [DcVSucaf], [DcVNroaf], [DcVNroHas], [DcVFchHas], [DcVTLi], [DcVFTli], [DcVDesc], "
