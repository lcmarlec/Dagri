      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T01155,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA415DcVNro = THISFORM.A415DcVNro
            Gx_err = GX_DB_SetDouble( HStmt_T01155,2,@AuxA415DcVNro,0)
            THISFORM.A415DcVNro = AuxA415DcVNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01155) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01155 = Gx_err
            THISFORM.GX_DB_GetT01155_01 ()
            IF .NOT. THISFORM.T01155 <> 103
               DO GX_ERRMW WITH "DCVENT reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01155 = 101 .OR. THISFORM.Z1208DcvTi <> THISFORM.Buf_T01155_1208DcvTipRed
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z422DcVTip <> THISFORM.Buf_T01155_422DcVTip
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z464DcVTot <> THISFORM.Buf_T01155_464DcVTot
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z470DcVTot <> THISFORM.Buf_T01155_470DcVTotSld
               DO GX_ERRMW WITH "DCVENT fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
