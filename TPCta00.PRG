      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A792PCtaDa = DATE()
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A793PCtaTi = SUBSTR(TIME(), 1, 8)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A794PCtaWr = GXWrkSt(128)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A791PCtaUs = THISFORM.AV9Usuario
               ENDIF
               IF .T. .OR. ( ( THISFORM.A211PCtaPG <> THISFORM.O211PCtaPG .OR. THISFORM.A212PCtaPG <> THISFORM.O211PCtaPG ) .AND. .T. )
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A2EmpCod
                  Aux1 = THISFORM.A198PCtaNr
                  DO PPyGCtas WITH Aux0 , Aux1
                  THISFORM.A2EmpCod = Aux0
                  THISFORM.A198PCtaNr = Aux1
                  THISFORM. cCT87A2 .Refresh()
                  THISFORM. cCT87A198 .Refresh()
               ENDIF
            CASE gxmode = "UPD"   && After update
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A792PCtaDa = DATE()
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A793PCtaTi = SUBSTR(TIME(), 1, 8)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A794PCtaWr = GXWrkSt(128)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A791PCtaUs = THISFORM.AV9Usuario
               ENDIF
               IF .T. .OR. ( ( THISFORM.A211PCtaPG <> THISFORM.O211PCtaPG .OR. THISFORM.A212PCtaPG <> THISFORM.O211PCtaPG ) .AND. .T. )
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A2EmpCod
                  Aux1 = THISFORM.A198PCtaNr
                  DO PPyGCtas WITH Aux0 , Aux1
                  THISFORM.A2EmpCod = Aux0
                  THISFORM.A198PCtaNr = Aux1
                  THISFORM. cCT87A2 .Refresh()
                  THISFORM. cCT87A198 .Refresh()
               ENDIF
            CASE gxmode = "DLT"   && After delete
         ENDCASE
