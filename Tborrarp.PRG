         * Search in Sub-File
         SELECT (THISFORM. cCT171S16 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT171S16 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT171S16 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S1746EntNr = THISFORM.A1746EntNr
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT171S16 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT171S16 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S1746EntNr = THISFORM.A1746EntNr
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT171S16 .Refresh()
               THISFORM. cCT171S16 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A1746EntNr = S1746EntNr
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT171S16 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT171S16 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S1746EntNr = THISFORM.A1746EntNr
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT171S16 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S1746EntNr = THISFORM.A1746EntNr
            ENDDO
            IF sf_err != 0
               THISFORM. cCT171S16 .AppendRow()
               THISFORM. cCT171S16 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A1746EntNr = S1746EntNr
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A150EntGru = S150EntGru
         THISFORM.A120EntCod = S120EntCod
         THISFORM.A1746EntNr = S1746EntNr
