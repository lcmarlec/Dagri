            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT171S16 = GETE('z:\temp') + '\' + SCT171S16
            ENDIF
