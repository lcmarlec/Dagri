      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T017112" , @HStmt_T017112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBORRARP","T017112","",GX_CURSOR_TYPE_READONLY,@HStmt_T017112) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntNroI], [EntFchHor], [EntObsV], [EntObsusu] "
                  cmdbuf = cmdbuf + "  FROM [PRVOBS] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [EntGruTip], [EntCod], [EntNroI]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T017112,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T017112,9)
                  THISFORM.GX_DB_BindColsT017112_01 ()
                  THISFORM.GX_DB_BindParmT017112_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T017112,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T017112,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T017112,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T017112) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T017112 = Gx_err
               THISFORM.GX_DB_GetT017112_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T017112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T017112) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T017112 = Gx_err
                  THISFORM.GX_DB_GetT017112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T017112 <> 101
               BRK4R203 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT171S16.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T017112) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T017112 = Gx_err
               THISFORM.GX_DB_GetT017112_01 ()
            ENDDO
         ENDIF
      ENDPROC
