               * Next Record
               IF THISFORM.W05352 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05352) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05352 = Gx_err
                  THISFORM.GX_DB_GetW05352_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05352 <> 101
               BRKVEV2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W05352_2EmpCod
               THISFORM.A1464ArtCo = THISFORM.Buf_W05352_1464ArtCodBar
               THISFORM.A1462FamCo = THISFORM.Buf_W05352_1462FamCodS
               THISFORM.A1463FamSu = THISFORM.Buf_W05352_1463FamSubCodS
               THISFORM.A1461ArtCo = THISFORM.Buf_W05352_1461ArtCodS
               THISFORM.A1460ArtIn = THISFORM.Buf_W05352_1460ArtInhab
               THISFORM.A24ArtCpr = THISFORM.Buf_W05352_24ArtCpr
               THISFORM.A28ArtVta = THISFORM.Buf_W05352_28ArtVta
               THISFORM.A6ArtDsc = THISFORM.Buf_W05352_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W05352_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W05352_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W05352_3FamCod
               GX_SFLOAD = 0
               THISFORM.U14VEV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05352) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05352 = Gx_err
               THISFORM.GX_DB_GetW05352_01 ()
            ENDDO
         ENDIF
      ENDPROC
