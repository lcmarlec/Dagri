      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10633" , @HStmt_W10633 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCANDIDA","W10633","",GX_CURSOR_TYPE_READONLY,@HStmt_W10633) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[CanPue], T1.[CanOk], T2.[CEmDsc], T1.[CEmCod], T1.[CanNom], "
                  cmdbuf = cmdbuf + "  T1.[CanCuil] FROM ([CANDIDAT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CEMPLEAD] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[CEmCod] = T1.[CEmCod]) WHERE (T1.[EmpCod] = "
                  cmdbuf = cmdbuf + "  ?) AND (UPPER(T1.[CanNom]) like UPPER(?)) AND (T1.[CanCuil] = ? or ? = 0) AND (T1.[CanNom] "
                  cmdbuf = cmdbuf + "  = ? or ? = ' ') AND (T1.[CEmCod] = ? or ? = ' ') AND (T1.[CanOk] = ? or ? = ' ') "
                  cmdbuf = cmdbuf + "  AND (T1.[CanPue] = ? or ? = ' ') ORDER BY T1.[EmpCod], T1.[CanCuil]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10633,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10633,15)
                  THISFORM.GX_DB_BindColsW10633_01 ()
                  THISFORM.GX_DB_BindParmW10633_01 ()
               ENDIF
               AuxAV10Emprco = THISFORM.AV10Emprco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10633,1,@AuxAV10Emprco,0)
               THISFORM.AV10Emprco = AuxAV10Emprco
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,2,PADR( TRIM(THISFORM.AV9Nombre),40, '%'),LEN(PADR( TRIM(THISFORM.AV9Nombre),40, '%')),0)
               AuxAV8Cuil = THISFORM.AV8Cuil
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10633,3,@AuxAV8Cuil,0)
               THISFORM.AV8Cuil = AuxAV8Cuil
               AuxAV8Cuil = THISFORM.AV8Cuil
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10633,4,@AuxAV8Cuil,0)
               THISFORM.AV8Cuil = AuxAV8Cuil
               AuxAV9Nombre = THISFORM.AV9Nombre
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,5,AuxAV9Nombre,40,0)
               THISFORM.AV9Nombre = AuxAV9Nombre
               AuxAV9Nombre = THISFORM.AV9Nombre
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,6,AuxAV9Nombre,40,0)
               THISFORM.AV9Nombre = AuxAV9Nombre
               AuxAV12Catego = THISFORM.AV12Catego
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,7,AuxAV12Catego,4,0)
               THISFORM.AV12Catego = AuxAV12Catego
               AuxAV12Catego = THISFORM.AV12Catego
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,8,AuxAV12Catego,4,0)
               THISFORM.AV12Catego = AuxAV12Catego
               AuxAV13Canok = THISFORM.AV13Canok
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,9,AuxAV13Canok,1,0)
               THISFORM.AV13Canok = AuxAV13Canok
               AuxAV13Canok = THISFORM.AV13Canok
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,10,AuxAV13Canok,1,0)
               THISFORM.AV13Canok = AuxAV13Canok
               AuxAV14Canpue = THISFORM.AV14Canpue
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,11,AuxAV14Canpue,40,0)
               THISFORM.AV14Canpue = AuxAV14Canpue
               AuxAV14Canpue = THISFORM.AV14Canpue
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10633,12,AuxAV14Canpue,40,0)
               THISFORM.AV14Canpue = AuxAV14Canpue
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10633) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10633 = Gx_err
               THISFORM.GX_DB_GetW10633_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV20Pgmnam = "WCandida"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10633 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10633) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10633 = Gx_err
                  THISFORM.GX_DB_GetW10633_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10633 <> 101
               BRKVTJ2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W10633_2EmpCod
               THISFORM.A3138CanPu = THISFORM.Buf_W10633_3138CanPue
               THISFORM.A3139CanOk = THISFORM.Buf_W10633_3139CanOk
               THISFORM.A2264CEmDs = THISFORM.Buf_W10633_2264CEmDsc
               THISFORM.A2263CEmCo = THISFORM.Buf_W10633_2263CEmCod
               THISFORM.A3136CanNo = THISFORM.Buf_W10633_3136CanNom
               THISFORM.A3135CanCu = THISFORM.Buf_W10633_3135CanCuil
               THISFORM.A2264CEmDs = THISFORM.Buf_W10633_2264CEmDsc
               GX_SFLOAD = 0
               THISFORM.U18VTJ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10633) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10633 = Gx_err
               THISFORM.GX_DB_GetW10633_01 ()
            ENDDO
         ENDIF
      ENDPROC
