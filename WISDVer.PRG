               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12432 = Gx_err
               THISFORM.GX_DB_GetW12432_01 ()
            ENDDO
         ENDIF
