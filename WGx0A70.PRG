               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10932,3,@AuxAV7C3204,0)
               THISFORM.AV7C3204 = AuxAV7C3204
               AuxAV8C3205 = THISFORM.AV8C3205
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10932,4,@AuxAV8C3205,0)
               THISFORM.AV8C3205 = AuxAV8C3205
               AuxAV9C3206 = THISFORM.AV9C3206
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10932,5,@AuxAV9C3206,0)
               THISFORM.AV9C3206 = AuxAV9C3206
               AuxAV10C3207 = THISFORM.AV10C3207
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10932,6,@AuxAV10C3207,0)
               THISFORM.AV10C3207 = AuxAV10C3207
               AuxAV11C3198 = THISFORM.AV11C3198
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10932,7,@AuxAV11C3198,0)
               THISFORM.AV11C3198 = AuxAV11C3198
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10932) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10932 = Gx_err
               THISFORM.GX_DB_GetW10932_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10932 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10932) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10932 = Gx_err
                  THISFORM.GX_DB_GetW10932_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10932 <> 101
               BRKVUD2 = .F.
               THISFORM.A3206CIFch = THISFORM.Buf_W10932_3206CIFch
               THISFORM.A3207CINro = THISFORM.Buf_W10932_3207CINro
               THISFORM.A3198CIMCo = THISFORM.Buf_W10932_3198CIMCod
               THISFORM.A3205CISNI = THISFORM.Buf_W10932_3205CISNI
               THISFORM.A3204CINI = THISFORM.Buf_W10932_3204CINI
               THISFORM.A3202CICod = THISFORM.Buf_W10932_3202CICod
               THISFORM.A2EmpCod = THISFORM.Buf_W10932_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VUD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10932) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10932 = Gx_err
               THISFORM.GX_DB_GetW10932_01 ()
            ENDDO
         ENDIF
      ENDPROC
