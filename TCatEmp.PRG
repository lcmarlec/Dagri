            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02284,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02284,100)
            THISFORM.GX_DB_BindColsT02284_01 ()
            THISFORM.GX_DB_BindParmT02284_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2EmpCod = 0
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02284,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
