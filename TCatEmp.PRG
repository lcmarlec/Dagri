                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02284 = Gx_err
               THISFORM.GX_DB_GetT02284_01 ()
               Gx_fcond = THISFORM.T02284 <> 101
            CASE GXOP = 2 && Next record
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02284,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02284 = Gx_err
               THISFORM.GX_DB_GetT02284_01 ()
               DO WHILE THISFORM.T02284 = 0 .AND. THISFORM.A2EmpCod >= THISFORM.Buf_T02284_2EmpCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02284 = Gx_err
                  THISFORM.GX_DB_GetT02284_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02284 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2EmpCod = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02284,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02284 = Gx_err
               THISFORM.GX_DB_GetT02284_01 ()
               DO WHILE THISFORM.T02284 = 0
                  THISFORM.A2EmpCod = THISFORM.Buf_T02284_2EmpCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02284 = Gx_err
                  THISFORM.GX_DB_GetT02284_01 ()
               ENDDO
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02284,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02284 = Gx_err
               THISFORM.GX_DB_GetT02284_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2EmpCod = THISFORM.Buf_T02284_2EmpCod
         ENDCASE
         Gx_fcond = THISFORM.T02284 <> 101 .AND. THISFORM.T02284 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

