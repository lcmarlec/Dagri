      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02284" , @HStmt_T02284 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCATEMP","T02284","",GX_CURSOR_TYPE_READONLY,@HStmt_T02284) ,  ,  ,  , CS_SQLSRV , 0 )
