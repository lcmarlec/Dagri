                  cmdbuf = cmdbuf + "  [EmpTel], [EmpFax], [EmpMai], [EmpCui], [EmpAct], [EmpFchIni], [EmpGrC], [EmpNrI], "
                  cmdbuf = cmdbuf + "  [EmpNrIT], [EmpSucUlt], [EmpVtaCie], [EmpComCie], [EmpNroAge], [EmpOCoCie], [EmpRecCie], "
                  cmdbuf = cmdbuf + "  [EmpCOdAux], [EmpInsCie], [EmpAusCie], [EmpCaea], [EmpPadAfip], [EmpPadPrc], [EmpRtCCie], "
                  cmdbuf = cmdbuf + "  [EmpPIBCie], [EmpCntCie], [EmpRTCICie], [EmpRTCSCie], [EmpGLN]) VALUES (?, ' ', "
                  cmdbuf = cmdbuf + "  ' ', ' ', ' ', ' ', ' ', ' ', ' ', convert(int, 0), ' ', convert( DATETIME, '17530101', "
                  cmdbuf = cmdbuf + "  112 ), ' ', convert(int, 0), convert(int, 0), convert(int, 0), convert( DATETIME, "
                  cmdbuf = cmdbuf + "  '17530101', 112 ), convert( DATETIME, '17530101', 112 ), ' ', convert( DATETIME, "
                  cmdbuf = cmdbuf + "  '17530101', 112 ), convert( DATETIME, '17530101', 112 ), convert(int, 0), convert( "
                  cmdbuf = cmdbuf + "  DATETIME, '17530101', 112 ), convert( DATETIME, '17530101', 112 ), convert(int, "
                  cmdbuf = cmdbuf + "  0), convert( DATETIME, '17530101', 112 ), convert( DATETIME, '17530101', 112 ), "
                  cmdbuf = cmdbuf + "  convert( DATETIME, '17530101', 112 ), convert( DATETIME, '17530101', 112 ), convert( "
                  cmdbuf = cmdbuf + "  DATETIME, '17530101', 112 ), convert( DATETIME, '17530101', 112 ), convert( DATETIME, "
                  cmdbuf = cmdbuf + "  '17530101', 112 ), ' ') "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02285,cmdbuf)
                  THISFORM.GX_DB_BindParmT02285_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02285,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02285) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02285 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02285) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02285 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02286" , @HStmt_T02286 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCATEMP","T02286","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02286) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [EMPRES]  WHERE [EmpCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02286,cmdbuf)
                  THISFORM.GX_DB_BindParmT02286_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02286,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02286) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02286 = Gx_err
               THISFORM.T02282 = iif( THISFORM.T02286 = 0 , 104 , THISFORM.T02286 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02286) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
