                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCATEMP","T02285","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02285) ,  ,  ,  , CS_SQLSRV , 0 )
