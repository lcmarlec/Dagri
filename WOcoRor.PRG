         THISFORM.AV21I = 0
         THISFORM.AV20Devent = THISFORM.AV11Desprv
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW100S15 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW100S15.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW100S15.SF (3, @GX_SFERR)
            THISFORM.cCW100S15 .SaveGridPos()
            IF THISFORM.AV22Sel = 1
               THISFORM.AV21I = THISFORM.AV21I + 1
               THISFORM.AV12Devuel[THISFORM.AV21I] = THISFORM.A682OCoNro
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW100S15 .RestoreGridPos()
               THISFORM.cCW100S15.SF (4, @GX_SFERR)
               THISFORM.cCW100S15.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW100S15 .ResetSavedGridPos()
         SELECT( THISFORM.cCW100S15 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW100S15.SF (3, @GX_SFERR)
         ENDIF
         THISFORM.ReleaseAll()
         RETURN
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
