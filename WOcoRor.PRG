               AuxAV14Desnro = THISFORM.AV14Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01002,2,@AuxAV14Desnro,0)
               THISFORM.AV14Desnro = AuxAV14Desnro
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01002,3,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV26Desfch = THISFORM.AV26Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01002,4,@AuxAV26Desfch,0)
               THISFORM.AV26Desfch = AuxAV26Desfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01002 = Gx_err
               THISFORM.GX_DB_GetW01002_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WOcoRor"
