                  ENDDO
                  THISFORM.W01002 = Gx_err
                  THISFORM.GX_DB_GetW01002_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01002 <> 101
               BRKV2S2 = .F.
               THISFORM.AV15Estado = SPACE(20)
