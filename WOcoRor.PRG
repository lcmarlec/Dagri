      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01002" , @HStmt_W01002 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOCOROR","W01002","",GX_CURSOR_TYPE_READONLY,@HStmt_W01002) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[OCoEst], T1.[EmpCod], T1.[OCoNroInt], T1.[OcoAut], T2.[EntRaz] AS OcoEntRaz, "
                  cmdbuf = cmdbuf + "  T1.[OcoEntCod] AS OcoEntCod, T1.[OcoEntGruT] AS OcoEntGruT, T1.[OCoFch], T1.[OCoNro], "
                  cmdbuf = cmdbuf + "  T1.[OCoSuc], T1.[OcoTip] FROM ([OCOMPN] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[OcoEntGruT] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[OcoEntCod]) WHERE (T1.[EmpCod] = ? and T1.[OCoEst] >= 0) AND (T1.[OCoNro] "
                  cmdbuf = cmdbuf + "  >= ? and T1.[OCoNro] > 0) AND (T1.[OcoEntCod] = ?) AND (T1.[OCoFch] >= ?) AND (T1.[OCoEst] "
                  cmdbuf = cmdbuf + "  <= 1) ORDER BY T1.[EmpCod], T1.[OCoEst]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01002,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01002,16)
                  THISFORM.GX_DB_BindColsW01002_01 ()
                  THISFORM.GX_DB_BindParmW01002_01 ()
