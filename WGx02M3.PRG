      PROCEDURE CreateTemp
         LOCAL SCW271S20
         SCW271S20 = ""
         IF USED( "SCW271S20" )
            SELECT SCW271S20
            SCW271S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW271S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA843EntMc"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA844EntMC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA845EntMc"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA846EntMc"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA850EntMc"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 6
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "sA852EntMc"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW271S20 = GETE('z:\temp') + '\' + SCW271S20
            ENDIF
            CREATE DBF (SCW271S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW271S20) EXCLUSIVE ALIAS SCW271S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW271S20
         THIS.GX_SfAlias = "SCW271S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02712" , @HStmt_W02712 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02M3","W02712","",GX_CURSOR_TYPE_READONLY,@HStmt_W02712) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntMcoBcoC], [EntMcopor], [EntMcoMonc], "
                  cmdbuf = cmdbuf + "  [EntMcoCta], [EntMCoCod], [EntMcoDias] FROM [PROVES] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? and [EntGruTip] = ? and [EntCod] = ? and [EntMcoDias] >= ? and [EntMCoCod] "
                  cmdbuf = cmdbuf + "  >= ? and [EntMcoCta] >= ? and [EntMcoMonc] >= ? ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod], [EntMcoDias], [EntMCoCod], [EntMcoCta], [EntMcoMonc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02712,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02712,9)
                  THISFORM.GX_DB_BindColsW02712_01 ()
                  THISFORM.GX_DB_BindParmW02712_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02712,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02712,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02712,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxAV5C843 = THISFORM.AV5C843
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02712,4,@AuxAV5C843,0)
               THISFORM.AV5C843 = AuxAV5C843
               AuxAV6C844 = THISFORM.AV6C844
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02712,5,@AuxAV6C844,0)
               THISFORM.AV6C844 = AuxAV6C844
               AuxAV7C845 = THISFORM.AV7C845
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02712,6,@AuxAV7C845,0)
               THISFORM.AV7C845 = AuxAV7C845
               AuxAV8C846 = THISFORM.AV8C846
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02712,7,@AuxAV8C846,0)
               THISFORM.AV8C846 = AuxAV8C846
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02712) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02712 = Gx_err
               THISFORM.GX_DB_GetW02712_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02712 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02712) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02712 = Gx_err
                  THISFORM.GX_DB_GetW02712_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02712 <> 101
               BRKV7J2 = .F.
               THISFORM.A852EntMco = THISFORM.Buf_W02712_852EntMcoBcoC
               THISFORM.A850EntMco = THISFORM.Buf_W02712_850EntMcopor
               THISFORM.A846EntMco = THISFORM.Buf_W02712_846EntMcoMonc
               THISFORM.A845EntMco = THISFORM.Buf_W02712_845EntMcoCta
               THISFORM.A844EntMCo = THISFORM.Buf_W02712_844EntMCoCod
               THISFORM.A843EntMco = THISFORM.Buf_W02712_843EntMcoDias
               GX_SFLOAD = 0
               THISFORM.U12V7J2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02712) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02712 = Gx_err
               THISFORM.GX_DB_GetW02712_01 ()
            ENDDO
         ENDIF
      ENDPROC
