         IF .not. THISFORM. cCW271S20 .GX_rec_modif
            THISFORM. cCW271S20 .Gx_rec_modif = .T.
            THISFORM. cCW271S20 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW271S20 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW271S20 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
