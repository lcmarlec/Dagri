      SpecialEffect = 0
      HelpContextId = 262268
      GX_CUPOS = 0
      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.AV15Nuevo
         THIS.AddData( "N" , "Modifica Pedido" )
         THIS.AddData( "S" , "Nuevo Pedido" )
         THIS.InitControl()
         THIS.LoadLocalVar()
         CGXRadioButton ::Init
         THIS.GX_OldValue = THISFORM.AV15Nuevo
         THIS.GX_Level = 2
      ENDPROC
      PROCEDURE InitLevel
         LPARAMETER gxILvl
         LOCAL gx_oMode
         IF gxILvl != 2
            RETURN .T.
         ENDIF
         THISFORM.AV19Pgmnam = "WPedNoM"
         THISFORM.Gx_err = 0
         THISFORM.gx_lastvld = THIS.GxObjOrder-1
         RETURN .T.
      ENDPROC
      PROCEDURE GotFocus
         CGXRadioButton ::GotFocus
         THIS.GXGotFocus()
         IF THISFORM.GX_NewLastVld > - 1
            THISFORM.GX_lastvld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         SET TOPIC TO Nuevo
         THISFORM.Gx_cursor = "THISFORM.AV15Nuevo"
         THISFORM.SetFKeys()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
      ENDPROC
      PROCEDURE Option1.LostFocus
         THIS.Parent.LostFocus
      ENDPROC
      PROCEDURE Option1.GotFocus
         THIS.Parent.gx_current_option = 1
         THIS.Parent.GotFocus
      ENDPROC
      PROCEDURE Option1.KeyPress(gx_key, gx_shift)
         THISFORM.gx_ctrReadkey = gx_key
         IF gx_key = 13
            NODEFAULT
            KEYBOARD "{TAB}"
         ENDIF
