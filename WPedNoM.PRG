   DEFINE CLASS CW124V15 AS CGXRadioButton
      Top = 22/GXsY
      Left = 112/GXsX
      Width = 181/GXsX
      Height = 65/GXsY
      GX_CUPOS = 0
      ADD OBJECT Option1 AS OptionButton
