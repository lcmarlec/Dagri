      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      * Exiting from a For First loop.
      EXIT
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R04544) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL4 = .F.
RETURN
