         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06692,1,@AuxAV11Emprco,0)
         THISFORM.AV11Emprco = AuxAV11Emprco
         AuxAV26Despro = THISFORM.AV26Despro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06692,2,@AuxAV26Despro,0)
