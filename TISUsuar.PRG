      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03895" , @HStmt_T03895 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TISUSUAR","T03895","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03895) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ISUSUARI] ([ISId], [ISNombre]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03895,cmdbuf)
                  THISFORM.GX_DB_BindParmT03895_01 ()
               ENDIF
               AuxA3607ISId = THISFORM.A3607ISId
               Gx_err = GX_DB_SetInt( HStmt_T03895,1,@AuxA3607ISId,0)
               THISFORM.A3607ISId = AuxA3607ISId
               AuxA3608ISNom = THISFORM.A3608ISNom
               Gx_err = GX_DB_SetStr( HStmt_T03895,2,AuxA3608ISNom,60,0)
               THISFORM.A3608ISNom = AuxA3608ISNom
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03895) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03895 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03895) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03895 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03896" , @HStmt_T03896 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TISUSUAR","T03896","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03896) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [ISUSUARI] SET [ISNombre]=?  WHERE [ISId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03896,cmdbuf)
                  THISFORM.GX_DB_BindParmT03896_01 ()
               ENDIF
               AuxA3608ISNom = THISFORM.A3608ISNom
               Gx_err = GX_DB_SetStr( HStmt_T03896,1,AuxA3608ISNom,60,0)
