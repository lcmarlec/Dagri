               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03892) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03892 = Gx_err
            THISFORM.GX_DB_GetT03892_01 ()
            IF .NOT. THISFORM.T03892 <> 103
               DO GX_ERRMW WITH "ISUSUARI reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03892 = 101 .OR. THISFORM.Z3608ISNom <> THISFORM.Buf_T03892_3608ISNombre
               DO GX_ERRMW WITH "ISUSUARI fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
