      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 411
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT389A3607 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT389A3607 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 411
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3607ISId = THISFORM.A3607ISId
                  Gx_err = GX_DB_SetInt( HStmt_T03893,1,@AuxA3607ISId,0)
                  THISFORM.A3607ISId = AuxA3607ISId
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03893) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03893 = Gx_err
                  THISFORM.GX_DB_GetT03893_01 ()
                  THISFORM. cCT389A3607 . ZMAT411 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCAT411 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03898" , @HStmt_T03898 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TISUSUAR","T03898","",GX_CURSOR_TYPE_READONLY,@HStmt_T03898) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod] FROM [ISDOC] (NOLOCK) WHERE [ISId] = ?  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03898,cmdbuf)
                  THISFORM.GX_DB_BindColsT03898_01 ()
                  THISFORM.GX_DB_BindParmT03898_01 ()
               ENDIF
               AuxBuf_T03893_3607ISId = THISFORM.Buf_T03893_3607ISId
               Gx_err = GX_DB_SetInt( HStmt_T03898,1,@AuxBuf_T03893_3607ISId,0)
               THISFORM.Buf_T03893_3607ISId = AuxBuf_T03893_3607ISId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03898) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03898 = Gx_err
               THISFORM.GX_DB_GetT03898_01 ()
               IF THISFORM.T03898 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03898) , "TISUSUAR" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " ISDoc "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03898) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT389A3607 . ZMAT411 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAT411 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT389A3608 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEAT411 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAT411 ()
                  RETURN
               ENDIF
               THISFORM.cCT389A3607.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03893) , "TISUSUAR" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03892) , "TISUSUAR" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT389A3608 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT389A3607 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

