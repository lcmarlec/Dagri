      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03894" , @HStmt_T03894 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TISUSUAR","T03894","",GX_CURSOR_TYPE_READONLY,@HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [ISId], [ISNombre] FROM [ISUSUARI] (FASTFIRSTROW NOLOCK) WHERE [ISId] >= ? "
            cmdbuf = cmdbuf + "  ORDER BY [ISId]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03894,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T03894,100)
            THISFORM.GX_DB_BindColsT03894_01 ()
            THISFORM.GX_DB_BindParmT03894_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A3607ISId = 0
               ENDIF
               AuxA3607ISId = THISFORM.A3607ISId
               Gx_err = GX_DB_SetInt( HStmt_T03894,1,@AuxA3607ISId,0)
               THISFORM.A3607ISId = AuxA3607ISId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03894 = Gx_err
               THISFORM.GX_DB_GetT03894_01 ()
               Gx_fcond = THISFORM.T03894 <> 101
            CASE GXOP = 2 && Next record
               AuxA3607ISId = THISFORM.A3607ISId
               Gx_err = GX_DB_SetInt( HStmt_T03894,1,@AuxA3607ISId,0)
               THISFORM.A3607ISId = AuxA3607ISId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03894 = Gx_err
               THISFORM.GX_DB_GetT03894_01 ()
               DO WHILE THISFORM.T03894 = 0 .AND. THISFORM.A3607ISId >= THISFORM.Buf_T03894_3607ISId
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03894 = Gx_err
                  THISFORM.GX_DB_GetT03894_01 ()
               ENDDO
               Gx_fcond = THISFORM.T03894 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A3607ISId = 0
               AuxA3607ISId = THISFORM.A3607ISId
               Gx_err = GX_DB_SetInt( HStmt_T03894,1,@AuxA3607ISId,0)
               THISFORM.A3607ISId = AuxA3607ISId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03894 = Gx_err
               THISFORM.GX_DB_GetT03894_01 ()
               DO WHILE THISFORM.T03894 = 0
                  THISFORM.A3607ISId = THISFORM.Buf_T03894_3607ISId
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03894 = Gx_err
                  THISFORM.GX_DB_GetT03894_01 ()
               ENDDO
               AuxA3607ISId = THISFORM.A3607ISId
               Gx_err = GX_DB_SetInt( HStmt_T03894,1,@AuxA3607ISId,0)
               THISFORM.A3607ISId = AuxA3607ISId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03894) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03894 = Gx_err
               THISFORM.GX_DB_GetT03894_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A3607ISId = THISFORM.Buf_T03894_3607ISId
               THISFORM.A3608ISNom = THISFORM.Buf_T03894_3608ISNombre
         ENDCASE
         Gx_fcond = THISFORM.T03894 <> 101 .AND. THISFORM.T03894 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

