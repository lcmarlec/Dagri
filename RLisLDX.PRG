   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R10812) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   RV25Hoja = 2
   RV11Docexc.selectsheet( "Duplicados Distintas Empresas" )
   RV27F = RV12Fila[RV25Hoja]
   RV11Docexc.cells(RV27F,1).Text = "Total"
   RV11Docexc.cells(RV27F,2).Number = RV29Total[RV25Hoja]
   RV25Hoja = 1
   RV11Docexc.selectsheet( "Duplicados Misma Empresa" )
   RV27F = RV12Fila[RV25Hoja]
   RV11Docexc.cells(RV27F,1).Text = "Total"
   RV11Docexc.cells(RV27F,2).Number = RV29Total[RV25Hoja]
   RV11Docexc.selectsheet( "Empleados con CUIL en 0" )
   LEVEL4 = .T.
   DO GX_CSC01
   IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R10813" , @HStmt_R10813 )
      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RLISLDX","R10813","",GX_CURSOR_TYPE_READONLY_NOTNESTED,@HStmt_R10813) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT T1.[EECod], T1.[TraFEgr], T1.[TraCod], T1.[TraNom], T2.[EEDsc], T1.[TraFIng], "
      cmdbuf = cmdbuf + "  T1.[TraCui], T1.[EmpCod] FROM ([EMPLEADO] T1 (NOLOCK) LEFT JOIN [EMPEMP] T2 (NOLOCK) "
      cmdbuf = cmdbuf + "  ON T2.[EECod] = T1.[EECod]) WHERE T1.[TraCui] = 0 ORDER BY T1.[EmpCod], T1.[TraCui], "
      cmdbuf = cmdbuf + "  T1.[TraFIng]  "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_R10813,cmdbuf)
      Gx_err = GX_DB_Set_StmtFetchSize( HStmt_R10813,100)
      GX_DB_BindColsR10813_01 ()
   ENDIF
   Gx_eop = 1
   DO WHILE Gx_eop != 0
      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R10813) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   R10813 = Gx_err
   GX_DB_GetR10813_01 ()
   DO WHILE R10813 <> 101
      R2280EECod = Buf_R10813_2280EECod
      R2291TraFE = Buf_R10813_2291TraFEgr
      R561TraCod = Buf_R10813_561TraCod
      R564TraNom = Buf_R10813_564TraNom
      R2281EEDsc = Buf_R10813_2281EEDsc
      R2290TraFI = Buf_R10813_2290TraFIng
      R562TraCui = Buf_R10813_562TraCui
      R2EmpCod = Buf_R10813_2EmpCod
      R2281EEDsc = Buf_R10813_2281EEDsc
      IF R2290TraFI <= RV10Fechah .AND. ( R2291TraFE >= AV9Fechad .OR. R2291TraFE = CTOD("  /  /  ") )
         RV27F = RV12Fila[RV25Hoja]
         RV11Docexc.cells(RV27F,1).Number = R562TraCui
         RV11Docexc.cells(RV27F,2).Number = R561TraCod
         RV11Docexc.cells(RV27F,3).Text = ALLTRIM( R564TraNom )
         RV11Docexc.cells(RV27F,4).Text = ALLTRIM( R2281EEDsc )
         RV11Docexc.cells(RV27F,5).Date = R2290TraFI
         RV11Docexc.cells(RV27F,6).Date = R2291TraFE
         RV12Fila[RV25Hoja] = RV12Fila[RV25Hoja] + 1
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R10813) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R10813 = Gx_err
      GX_DB_GetR10813_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R10813) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL4 = .F.
   RV11Docexc.selectsheet( "Duplicados Distintas Empresas" )
   RV11Docexc.close( )
   RV11Docexc.save( )
   RV13E = opendocument( AV8Planill )
   DO EPU10
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

