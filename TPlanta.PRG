            THISFORM.GX_DB_GetT02832_01 ()
            IF .NOT. THISFORM.T02832 <> 103
               DO GX_ERRMW WITH "PLANTA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02832 = 101 .OR. THISFORM.Z2733PlaDs <> THISFORM.Buf_T02832_2733PlaDsc
               DO GX_ERRMW WITH "PLANTA fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

