            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02838" , @HStmt_T02838 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPLANTA","T02838","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02838) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [PLANTA]  WHERE [EmpCod] = ? AND [PlaCod] = ? "
