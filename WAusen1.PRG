      PROCEDURE CreateTemp
         LOCAL SCW757S36
         SCW757S36 = ""
         IF USED( "SCW757S36" )
            SELECT SCW757S36
            SCW757S36 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW757S36
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "VAV82Tradu"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 1
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV80Cauxc"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW757S36 = GETE('z:\temp') + '\' + SCW757S36
            ENDIF
            CREATE DBF (SCW757S36) FROM ARRAY GX_STRUCT
            USE
            USE (SCW757S36) EXCLUSIVE ALIAS SCW757S36
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW757S36
         THIS.GX_SfAlias = "SCW757S36"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV82Tradup = 0
               GX_SFLOAD = 0
               THISFORM.cCW757S36.Load ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
      PROCEDURE LoadFromTbl
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV82Tradu WITH THISFORM.cCW757S36.Columns(1).Ctrl1.ValToText(THISFORM.AV82Tradup)
         REPLACE VAV80Cauxc WITH THISFORM.AV80Cauxco
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV82Tradup = THISFORM.cCW757S36.Columns(1).Ctrl1.TextToVal(VAV82Tradu,"int",1)
         THISFORM.AV80Cauxco = VAV80Cauxc
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 1
            THISFORM.AV82Tradup = THISFORM.cCW757S36.Columns(1).Ctrl1.TextToVal(THIS.Column1.Ctrl1.Value,"int",1)
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV82Tradup = 0
         THISFORM.AV80Cauxco = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 19
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
      PROCEDURE BeforeRowChange
      ENDPROC
      PROCEDURE AfterRowChange
      ENDPROC
      PROCEDURE DblClick
         THISFORM.U12VL12 ()
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE Click
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE CallRefreshEvent
         THISFORM.cCW757S36.GXRefreshEvt ()
      ENDPROC
      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW757S36 .GX_SfAlias)
            GO TOP
            THISFORM.cCW757S36 .Refresh()
         ENDIF
         THISFORM. cCW757S36 .GXSetRepos( .F. )
