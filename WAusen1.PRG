         THISFORM. AV56Blkfch = PAV56Blkfch
         THISFORM. AV57Blktip = PAV57Blktip
         =ACOPY( PAV72Docadj , THISFORM. AV72Docadj )
         THISFORM. AV85Tradup = PAV85Tradup
         THISFORM. AV108Pamap = PAV108Pamap
         THISFORM. AV109Pamcl = PAV109Pamcl
         THISFORM. AV110Pames = PAV110Pames
         THISFORM. AV111Pamma = PAV111Pamma
         THISFORM. AV112Pamma = PAV112Pamma
         THISFORM. AV113Pamma = PAV113Pamma
