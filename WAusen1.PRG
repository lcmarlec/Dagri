   DEFINE CLASS CW757S33V64 AS CGXEditBoxSf
      GXColumnNo = 1
      BorderStyle = 0
      HelpContextId = 262901
      PROCEDURE ValidObj
         IF .not. THISFORM. cCW757S33 .Gx_rec_modif
            RETURN .T.
         ENDIF
         THISFORM. cCW757S33 .Gx_rec_modif = .F.
      RETURN .T.
      ENDPROC
      PROCEDURE InteractiveChange
         IF .not. THISFORM. cCW757S33 .GX_rec_modif
            THISFORM. cCW757S33 .Gx_rec_modif = .T.
            THISFORM. cCW757S33 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW757S33 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW757S33 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW757S33 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.AV64Docume = THIS.Value
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW757S33 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
         ELSE
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            IF ! THISFORM.InRoutine("ISVALID")
               THISFORM.FormRefresh( .T. , .F. )
            ENDIF
         ENDIF
         IF gx_val_ret >= 0
            IF THIS.GX_Mouse
               THIS.GotMouseDown()
            ENDIF
            NODEFAULT
            IF gx_val_ret >= 0
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
            RETURN
         ELSE
            IF gx_val_ret = -2
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM.GX_NewLastVld != -1
            THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THISFORM. cCW757S33 .GX_focusInGrid = .T.
         THISFORM. cCW757S33 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 11
            THISFORM. cCW757V9 .InitLevel( 11 )
            THISFORM.GX_last_fld_lvl = 11
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.AV64Docume"
         THISFORM.cCW757S33 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW757S33 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW757S33 .GX_lastkey = 9.or. THISFORM.cCW757S33 .GX_lastkey = 13)
            IF ! THISFORM.cCW757S33 .GridValidObj( THISFORM.cCW757S33 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW757S33 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW757S33 .gx_can_changerow = .T.
         CGXEditBoxSf ::GotFocus
         THISFORM.LockScreen = .F.
      ENDPROC
