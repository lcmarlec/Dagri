      PROCEDURE Activate
         IF THISFORM.GX_init_activate
            IF ! THISFORM.InitLevels( 2 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            THISFORM.LoadMenuBar()
            THISFORM.SetLevel( 2 )
            THISFORM.GX_force_refresh = .T.
            THISFORM.U11VL12 ()
            IF TYPE( "OCW757" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            GXForm::Activate
         ENDIF
         THISFORM.ClearFrmTBar
         THISFORM.GxMenuBar.Clear
         THISFORM.SetMBTimer()
         gxMB = "OFF"
         THISFORM.GxMenuBar.Set(gxMB)
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         THISFORM.SetFKeys()
         GXTB.HideMode()
         IF GXTB.GetMessageValue() != "No hay registros que cumplan la condicion"
            GXTB.HideSB()
         ENDIF
      ENDPROC
