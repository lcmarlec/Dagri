               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02032) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02032 = Gx_err
            THISFORM.GX_DB_GetT02032_01 ()
            IF .NOT. THISFORM.T02032 <> 103
               DO GX_ERRMW WITH "RETEN reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02032 = 101 .OR. THISFORM.Z947RetNro <> THISFORM.Buf_T02032_947RetNro
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z940RetEst <> THISFORM.Buf_T02032_940RetEst
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2011RetBa <> THISFORM.Buf_T02032_2011RetBasImp
               DO GX_ERRMW WITH "RETEN fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
