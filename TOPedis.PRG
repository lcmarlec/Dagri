      PROCEDURE CreateTemp
         LOCAL SCT80S23
         SCT80S23 = ""
         IF USED( "SCT80S23" )
            SELECT SCT80S23
            SCT80S23 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT80S23
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA736OpeLi"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA6ArtDsc"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 50
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA737OpeCn"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 4

            GX_STRUCT[ 7 ,1]= "sA738OpeFE"
            GX_STRUCT[ 7 ,2]= "D"
            GX_STRUCT[ 7 ,3]= 8
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA739OpeLE"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 1
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "sA24ArtCpr"
            GX_STRUCT[ 9 ,2]= "C"
            GX_STRUCT[ 9 ,3]= 1
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT80S23 = GETE('z:\temp') + '\' + SCT80S23
            ENDIF
            CREATE DBF (SCT80S23) FROM ARRAY GX_STRUCT
            USE
            USE (SCT80S23) EXCLUSIVE ALIAS SCT80S23
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT80S23
