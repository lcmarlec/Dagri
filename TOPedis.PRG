         LOCAL gxO_Area
         gxO_Area = SELECT()
         IF EMPTY(THISFORM. cCT80S23 .GX_SfAlias)
            RETURN
         ENDIF
         SELECT (THISFORM. cCT80S23 .GX_SfAlias)
