      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S731OpeNro
         LOCAL S736OpeLin
         S2EmpCod = THISFORM.A2EmpCod
         S731OpeNro = THISFORM.A731OpeNro
         S736OpeLin = THISFORM.A736OpeLin
         THISFORM.A736OpeLin = THISFORM.M736OpeLin
         THISFORM. cCT80S23 .SaveTemp()
         THISFORM. cCT80S23 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT80S23 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT80S23 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT80S23 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S731OpeNro = THISFORM.A731OpeNro .AND. S736OpeLin = THISFORM.A736OpeLin
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT80S23 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT80S23 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S731OpeNro = THISFORM.A731OpeNro .AND. S736OpeLin = THISFORM.A736OpeLin
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT80S23 .Refresh()
               THISFORM. cCT80S23 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A731OpeNro = S731OpeNro
               THISFORM.A736OpeLin = S736OpeLin
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT80S23 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT80S23 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S731OpeNro = THISFORM.A731OpeNro .AND. S736OpeLin = THISFORM.A736OpeLin
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT80S23 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S731OpeNro = THISFORM.A731OpeNro .AND. S736OpeLin = THISFORM.A736OpeLin
            ENDDO
            IF sf_err != 0
               THISFORM. cCT80S23 .AppendRow()
               THISFORM. cCT80S23 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A731OpeNro = S731OpeNro
               THISFORM.A736OpeLin = S736OpeLin
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A731OpeNro = S731OpeNro
         THISFORM.A736OpeLin = S736OpeLin
         RETURN .F.
      ENDFUNC
