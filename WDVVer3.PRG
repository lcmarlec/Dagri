      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA456DcVIm WITH THISFORM.A456DcVImp
         REPLACE sA457DcVIm WITH THISFORM.A457DcVImp
         REPLACE sA458DcVNi WITH THISFORM.A458DcVNim
         REPLACE sA459DcVIm WITH THISFORM.A459DcVImp
