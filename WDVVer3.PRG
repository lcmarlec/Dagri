      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A456DcVImp = SPACE(6)
         THISFORM.A457DcVImp = SPACE(20)
         THISFORM.A458DcVNim = SPACE(12)
         THISFORM.A459DcVImp = 0.00
         THISFORM.A2EmpCod = 0
         THISFORM.A415DcVNro = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
