      PROCEDURE U12V1A2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'BORRAR'" )
         * 'Borrar' Routine
         IF THISFORM.AV23Nivel < 5
            DO GX_ERRMW WITH "No está autorizado para borrar el documento"
         ELSE
            IF THISFORM.A421DcVFch <= THISFORM.A1206EmpVt
               THISFORM.SaveTblPos()
               DO Werrores WITH "La fecha es anterior al cierre " , "R"
               THISFORM. cCW46S8 .RestoreGridPos()
               GX_rploop = .T.
            ELSE
               IF THISFORM.A422DcVTip = "NDPV" .OR. THISFORM.A422DcVTip = "NCPV"
                  DO GX_ERRMW WITH "Este documento debe ser Borrado desde el Módulo de Compras"
               ELSE
                  Response = .F.
                  DO GX_CONFW WITH 'Borra el documento' , Response
                  IF Response
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.AV8Emprcod
                     Aux1 = THISFORM.A415DcVNro
                     Aux2 = THISFORM.AV20Usuari
                     DO Pdcvanu WITH Aux0 , Aux1 , Aux2 , "B"
                     THISFORM.AV8Emprcod = Aux0
                     THISFORM.A415DcVNro = Aux1
                     THISFORM.AV20Usuari = Aux2
                     THISFORM. cCW46S8 .RestoreGridPos()
                     GX_rploop = .T.
                     THISFORM.ReleaseAll()
                     RETURN
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
