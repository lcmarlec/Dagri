      PROCEDURE CreateTemp
         LOCAL SCW1259S20
         SCW1259S20 = ""
         IF USED( "SCW1259S20" )
            SELECT SCW1259S20
            SCW1259S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1259S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3646EtiT"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3647EtiF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3648EtiH"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2867LiPr"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1259S20 = GETE('z:\temp') + '\' + SCW1259S20
            ENDIF
            CREATE DBF (SCW1259S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1259S20) EXCLUSIVE ALIAS SCW1259S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1259S20
         THIS.GX_SfAlias = "SCW1259S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12592" , @HStmt_W12592 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0BI0","W12592","",GX_CURSOR_TYPE_READONLY,@HStmt_W12592) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EtiQRL], [EtiQRLote], [LiPrCod], [EtiHor], [EtiFch], [EtiTraz], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [Etiquetas] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([EtiTraz] like "
                  cmdbuf = cmdbuf + "  ?) AND ([EtiFch] >= ?) AND ([EtiHor] like ?) AND ([LiPrCod] like ?) AND ([EtiQRL] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EtiQRLote] >= ?) ORDER BY [EmpCod], [EtiTraz]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12592,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12592,9)
                  THISFORM.GX_DB_BindColsW12592_01 ()
                  THISFORM.GX_DB_BindParmW12592_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12592,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12592,2,PADR( TRIM(THISFORM.AV6C3646),30, '%'),LEN(PADR( TRIM(THISFORM.AV6C3646),30, '%')),0)
               AuxAV7C3647 = THISFORM.AV7C3647
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12592,3,@AuxAV7C3647,0)
               THISFORM.AV7C3647 = AuxAV7C3647
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12592,4,PADR( TRIM(THISFORM.AV8C3648),8, '%'),LEN(PADR( TRIM(THISFORM.AV8C3648),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12592,5,PADR( TRIM(THISFORM.AV9C2867),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C2867),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12592,6,PADR( TRIM(THISFORM.AV10C3649),2, '%'),LEN(PADR( TRIM(THISFORM.AV10C3649),2, '%')),0)
               AuxAV11C3650 = THISFORM.AV11C3650
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12592,7,@AuxAV11C3650,0)
               THISFORM.AV11C3650 = AuxAV11C3650
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12592 = Gx_err
               THISFORM.GX_DB_GetW12592_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12592 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12592) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12592 = Gx_err
                  THISFORM.GX_DB_GetW12592_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12592 <> 101
               BRKVYZ2 = .F.
               THISFORM.A3649EtiQR = THISFORM.Buf_W12592_3649EtiQRL
               THISFORM.A3650EtiQR = THISFORM.Buf_W12592_3650EtiQRLote
               THISFORM.A2867LiPrC = THISFORM.Buf_W12592_2867LiPrCod
               THISFORM.A3648EtiHo = THISFORM.Buf_W12592_3648EtiHor
               THISFORM.A3647EtiFc = THISFORM.Buf_W12592_3647EtiFch
               THISFORM.A3646EtiTr = THISFORM.Buf_W12592_3646EtiTraz
               THISFORM.A2EmpCod = THISFORM.Buf_W12592_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VYZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12592 = Gx_err
               THISFORM.GX_DB_GetW12592_01 ()
            ENDDO
         ENDIF
      ENDPROC
