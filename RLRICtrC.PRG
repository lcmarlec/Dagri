      IF UserCancel
         EXIT
      ENDIF
      IF .NOT. BRKY83
         BRKY83 = .T.
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R12323) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         R12323 = Gx_err
         GX_DB_GetR12323_01 ()
      ENDIF
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R12323) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL3 = .F.
   * User Code
   fclose(gxArch)
   DO EPY80
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

