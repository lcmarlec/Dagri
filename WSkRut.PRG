      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01592" , @HStmt_W01592 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKRUT","W01592","",GX_CURSOR_TYPE_READONLY,@HStmt_W01592) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T2.[ChfNom] AS RutChfNom, T1.[RutChfCod] AS RutChfCod, T1.[RutCod] "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[ChfCod] = T1.[RutChfCod]) WHERE (T1.[EmpCod] = ? and T1.[RutCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T2.[ChfNom] like ?) ORDER BY T1.[EmpCod], T1.[RutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01592,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01592,10)
                  THISFORM.GX_DB_BindColsW01592_01 ()
                  THISFORM.GX_DB_BindParmW01592_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01592,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV11Rutcod = THISFORM.AV11Rutcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01592,2,@AuxAV11Rutcod,0)
               THISFORM.AV11Rutcod = AuxAV11Rutcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01592,3,PADR( TRIM(THISFORM.AV12Rutchf),40, '%'),LEN(PADR( TRIM(THISFORM.AV12Rutchf),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01592 = Gx_err
               THISFORM.GX_DB_GetW01592_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV15Pgmnam = "WSkRut"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01592 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01592) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01592 = Gx_err
                  THISFORM.GX_DB_GetW01592_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01592 <> 101
               BRKV4F2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W01592_2EmpCod
               THISFORM.A1217RutCh = THISFORM.Buf_W01592_1217RutChfNom
               THISFORM.A1216RutCh = THISFORM.Buf_W01592_1216RutChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W01592_966RutCod
               THISFORM.A1217RutCh = THISFORM.Buf_W01592_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U14V4F2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01592 = Gx_err
               THISFORM.GX_DB_GetW01592_01 ()
            ENDDO
         ENDIF
      ENDPROC
