      PROCEDURE CreateTemp
         LOCAL SCW159S14
         SCW159S14 = ""
         IF USED( "SCW159S14" )
            SELECT SCW159S14
            SCW159S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW159S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA966RutCo"
            GX_STRUCT[ 1 ,2]= "N"
