            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1217RutC"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW159S14 = GETE('z:\temp') + '\' + SCW159S14
            ENDIF
            CREATE DBF (SCW159S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW159S14) EXCLUSIVE ALIAS SCW159S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW159S14
