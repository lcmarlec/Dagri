      PROCEDURE CreateTemp
         LOCAL SCW943S20
         SCW943S20 = ""
         IF USED( "SCW943S20" )
            SELECT SCW943S20
            SCW943S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW943S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2870PCNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2871PCFc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2872PCNr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA150EntGr"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA120EntCo"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 6
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2879PcEs"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW943S20 = GETE('z:\temp') + '\' + SCW943S20
            ENDIF
            CREATE DBF (SCW943S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW943S20) EXCLUSIVE ALIAS SCW943S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW943S20
         THIS.GX_SfAlias = "SCW943S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09432" , @HStmt_W09432 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0941","W09432","",GX_CURSOR_TYPE_READONLY,@HStmt_W09432) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PCtotal], [PcEst], [EntCod], [EntGruTip], [PCNro], [PCFch], [PCNroInt] "
                  cmdbuf = cmdbuf + "  FROM [PERCOM] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [PCNroInt] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([PCFch] >= ?) AND ([PCNro] >= ?) AND ([EntGruTip] like ?) AND ([EntCod] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([PCtotal] >= ?) ORDER BY [EmpCod], [PCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09432,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09432,9)
                  THISFORM.GX_DB_BindColsW09432_01 ()
                  THISFORM.GX_DB_BindParmW09432_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09432,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C2870 = THISFORM.AV5C2870
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09432,2,@AuxAV5C2870,0)
               THISFORM.AV5C2870 = AuxAV5C2870
               AuxAV6C2871 = THISFORM.AV6C2871
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09432,3,@AuxAV6C2871,0)
               THISFORM.AV6C2871 = AuxAV6C2871
               AuxAV7C2872 = THISFORM.AV7C2872
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09432,4,@AuxAV7C2872,0)
               THISFORM.AV7C2872 = AuxAV7C2872
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09432,5,PADR( TRIM(THISFORM.AV8C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV8C150),2, '%')),0)
               AuxAV9C120 = THISFORM.AV9C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09432,6,@AuxAV9C120,0)
               THISFORM.AV9C120 = AuxAV9C120
               AuxAV10C2873 = THISFORM.AV10C2873
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09432,7,@AuxAV10C2873,0)
               THISFORM.AV10C2873 = AuxAV10C2873
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09432 = Gx_err
               THISFORM.GX_DB_GetW09432_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09432 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09432) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09432 = Gx_err
                  THISFORM.GX_DB_GetW09432_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09432 <> 101
               BRKVQ72 = .F.
               THISFORM.A2873PCtot = THISFORM.Buf_W09432_2873PCtotal
               THISFORM.A2879PcEst = THISFORM.Buf_W09432_2879PcEst
               THISFORM.A120EntCod = THISFORM.Buf_W09432_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W09432_150EntGruTip
               THISFORM.A2872PCNro = THISFORM.Buf_W09432_2872PCNro
               THISFORM.A2871PCFch = THISFORM.Buf_W09432_2871PCFch
               THISFORM.A2870PCNro = THISFORM.Buf_W09432_2870PCNroInt
               GX_SFLOAD = 0
               THISFORM.U12VQ72 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09432 = Gx_err
               THISFORM.GX_DB_GetW09432_01 ()
            ENDDO
         ENDIF
      ENDPROC
