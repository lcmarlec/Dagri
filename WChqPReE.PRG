      ***********************
      PROCEDURE U12VSD2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         THISFORM.AV27Ok = 0
         THISFORM.AV28Ok1 = 1
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW1021S4 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW1021S4.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW1021S4.SF (3, @GX_SFERR)
            THISFORM.cCW1021S4 .SaveGridPos()
            IF THISFORM.AV26Reentr = 1
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A121ChqNro
               Aux2 = THISFORM.A122ChqLin
               Aux3 = THISFORM.A123ChqTip
               Aux4 = THISFORM.A124ChqCta
               Aux5 = THISFORM.AV24Chqrec
               Aux6 = THISFORM.AV22Chqref
               Aux7 = THISFORM.AV23Chrreg
               Aux8 = THISFORM.AV15Chqfch
               Aux9 = THISFORM.AV27Ok
               DO PChqPReE WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7 , Aux8 , Aux9
               THISFORM.A2EmpCod = Aux0
               THISFORM.A121ChqNro = Aux1
               THISFORM.A122ChqLin = Aux2
               THISFORM.A123ChqTip = Aux3
               THISFORM.A124ChqCta = Aux4
               THISFORM.AV24Chqrec = Aux5
               THISFORM.AV22Chqref = Aux6
               THISFORM.AV23Chrreg = Aux7
               THISFORM.AV15Chqfch = Aux8
               THISFORM.AV27Ok = Aux9
               THISFORM. cCW1021S4 .RestoreGridPos()
               THISFORM. cCW1021S4.Columns(1).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW1021S4.Columns(5).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW1021S4 .GX_rec_modif = .T.
               THISFORM. cCW1021S4 .GX_LastVld1 = THISFORM. cCW1021S4.Columns(1).Ctrl1 .GXColumnNo - 1
               GX_rploop = .T.
               IF THISFORM.AV27Ok = 0
                  THISFORM.AV28Ok1 = 0
                  DO GX_ERRMW WITH "El cheque " + THISFORM.A121ChqNro + " no pudo ser reentreado"
               ELSE
                  THISFORM.AV30Numero = ALLTRIM( str( THISFORM.A2EmpCod ) ) + " " + ALLTRIM( str( THISFORM.A121ChqNro ) ) + " " + ALLTRIM( str( THISFORM.A122ChqLin ) ) + " P " + ALLTRIM( str( THISFORM.A124ChqCta ) )
                  THISFORM.AV29Audobs = "ReEntrega exitosa del cheque al: " + ALLTRIM( THISFORM.AV23Chrreg ) + " " + ALLTRIM( str( THISFORM.AV24Chqrec ) ) + " el: " + GXDTOC( THISFORM.AV22Chqref )
                  THISFORM.SaveTblPos()
                  Aux1 = THISFORM.AV9Emprcod
                  Aux3 = THISFORM.AV30Numero
                  Aux5 = THISFORM.AV29Audobs
                  Aux6 = THISFORM.AV14Usuari
                  DO PAuditor WITH "BCOS" , Aux1 , "CHQS" , Aux3 , "INS" , Aux5 , Aux6
                  THISFORM.AV9Emprcod = Aux1
                  THISFORM.AV30Numero = Aux3
                  THISFORM.AV29Audobs = Aux5
                  THISFORM.AV14Usuari = Aux6
                  THISFORM. cCW1021S4 .RestoreGridPos()
                  GX_rploop = .T.
               ENDIF
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW1021S4 .RestoreGridPos()
               THISFORM.cCW1021S4.SF (4, @GX_SFERR)
               THISFORM.cCW1021S4.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW1021S4 .ResetSavedGridPos()
         SELECT( THISFORM.cCW1021S4 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW1021S4.SF (3, @GX_SFERR)
         ENDIF
         IF THISFORM.AV28Ok1 = 1
            DO GX_ERRMW WITH "Todos los cheques tildados fueron reentregados exitosamente."
         ELSE
            DO GX_ERRMW WITH "Recuerde revisar el/los cheque/s que no pudieron ser reentregados."
         ENDIF
         THISFORM.GX_Refresh = 1   &&& Refresh
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

