         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10213" , @HStmt_W10213 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCHQPREE","W10213","",GX_CURSOR_TYPE_READONLY,@HStmt_W10213) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ChqFchIng], [ChqEst], [ChrREGrT], [ChqREFc], [ChqRECo], [ChqRE], [ChqFchDeb], "
                  cmdbuf = cmdbuf + "  [ChqImp], [ChqCta], [ChqNro], [ChqTip], [ChqLin], [ChqNroI], [EmpCod] FROM [CHQS] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE ([EmpCod] = ?) AND ([ChqTip] = 'P') AND ([ChqEst] = 3) AND ([ChqCta] "
                  cmdbuf = cmdbuf + "  = ?) AND ([ChqFchDeb] >= ?) AND ([ChqFchDeb] <= ? or ? = convert( DATETIME, '17530101', "
                  cmdbuf = cmdbuf + "  112 )) AND ([ChqFchIng] >= ?) AND ([ChqFchIng] <= ? or ? = convert( DATETIME, '17530101', "
                  cmdbuf = cmdbuf + "  112 )) AND ([ChqImp] >= ?) AND ([ChqImp] <= ? or ? = convert(int, 0)) AND ([ChqRE] "
                  cmdbuf = cmdbuf + "  <> convert( DATETIME, '17530101', 112 )) ORDER BY [EmpCod], [ChqNroI], [ChqLin], "
                  cmdbuf = cmdbuf + "  [ChqTip], [ChqCta]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10213,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10213,12)
                  THISFORM.GX_DB_BindColsW10213_01 ()
                  THISFORM.GX_DB_BindParmW10213_01 ()
