      PROCEDURE LoadObj(LoadType)
         * Default load for WKP
         GX_CUOPER = 1
         GX_CUERR = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03702" , @HStmt_W03702 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLPEDART","W03702","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W03702) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod] FROM [EMPRES] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? ORDER BY [EmpCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03702,cmdbuf)
                  THISFORM.GX_DB_BindColsW03702_01 ()
                  THISFORM.GX_DB_BindParmW03702_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03702,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03702 = Gx_err
               THISFORM.GX_DB_GetW03702_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV47Pgmnam = "WLPedArt"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03702 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03702) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03702 = Gx_err
                  THISFORM.GX_DB_GetW03702_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03702 <> 101
               BRKVAA2 = .F.
               GX_SFLOAD = 1
               THISFORM.U18VAA2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
         IF GX_CUERR != 0
            THISFORM.AV9Emprnom = SPACE(30)
            THISFORM.AV40Chofer = SPACE(40)
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
      RETURN .T.
      ENDPROC
