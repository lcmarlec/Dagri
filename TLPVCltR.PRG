         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T022313" , @HStmt_T022313 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLPVCLTR","T022313","",GX_CURSOR_TYPE_READONLY,@HStmt_T022313) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [PlVGruTip], [PlVEntCod], [LpvFch], [lpvind], [FamCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [ArtCod], [LpvArtRet], [LpvArtRet1], [LpvArtRet2], [LpvPrcReal], [LpvPrc], [LpvPrcAnt] "
                  cmdbuf = cmdbuf + "  FROM [LPVClt1] (NOLOCK) WHERE [EmpCod] = ? AND [PlVGruTip] = ? AND [PlVEntCod] = "
                  cmdbuf = cmdbuf + "  ? AND [LpvFch] = ? ORDER BY [EmpCod], [PlVGruTip], [PlVEntCod], [LpvFch], [lpvind], "
                  cmdbuf = cmdbuf + "  [FamCod], [FamSubCod], [ArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T022313,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T022313,13)
                  THISFORM.GX_DB_BindColsT022313_01 ()
                  THISFORM.GX_DB_BindParmT022313_01 ()
               ENDIF
               AuxA2113xEmpC = THISFORM.A2113xEmpC
               Gx_err = GX_DB_SetInt( HStmt_T022313,1,@AuxA2113xEmpC,0)
               THISFORM.A2113xEmpC = AuxA2113xEmpC
               AuxA2103xPlVG = THISFORM.A2103xPlVG
               Gx_err = GX_DB_SetStr( HStmt_T022313,2,AuxA2103xPlVG,2,0)
               THISFORM.A2103xPlVG = AuxA2103xPlVG
               AuxA2104xPlVE = THISFORM.A2104xPlVE
               Gx_err = GX_DB_SetLong( HStmt_T022313,3,@AuxA2104xPlVE,0)
               THISFORM.A2104xPlVE = AuxA2104xPlVE
               AuxA2105xLpvF = THISFORM.A2105xLpvF
               Gx_err = GX_DB_SetDate( HStmt_T022313,4,@AuxA2105xLpvF,0)
               THISFORM.A2105xLpvF = AuxA2105xLpvF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T022313) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T022313 = Gx_err
               THISFORM.GX_DB_GetT022313_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T022313 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T022313) ,  ,  ,  , CS_SQLSRV , 0 )
