      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCT223S26 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 251
            IF THIS.gx_ret > 0
               gx_val_ret = THIS.gx_ret
            ELSE
               gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            ENDIF
            IF gx_val_ret >= 0
               IF THIS.GX_Mouse
                  THIS.GotMouseDown()
               ENDIF
               NODEFAULT
               IF gx_val_ret >= 0
                  IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                     THISFORM.ReleaseAll()
                  ENDIF
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
            IF THISFORM.GX_NewLastVld != -1
               THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
               THISFORM.GX_NewLastVld = -1
               NODEFAULT
               RETURN
            ENDIF
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 251 )
               RETURN
            ENDIF
            THISFORM. cCT223S26 .SaveKey()
         ENDIF
         gx_a_trn = .F.
         THISFORM. cCT223S26 .GX_focusInGrid = .T.
         IF THISFORM.GX_Mode != "INS"
            THISFORM. cCT223S26 . AfterRowColChange1()
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 251
            THISFORM.SetLevel( 251 )
            THISFORM.SetMode("", "N" )
            THISFORM. cCT223S26.Columns(1).Ctrl1 .InitLevel( 251 )
            THISFORM.GX_last_fld_lvl = 251
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2150xArtV"
         THISFORM.cCT223S26 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCT223S26 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCT223S26 .GX_lastkey = 9.or. THISFORM.cCT223S26 .GX_lastkey = 13)
            IF ! THISFORM.cCT223S26 .GridValidObj( THISFORM.cCT223S26 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCT223S26 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCT223S26 .gx_can_changerow = .T.
         CGXTextBoxSf ::GotFocus
         THISFORM.LockScreen = .F.
