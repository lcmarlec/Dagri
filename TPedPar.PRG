      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T034120" , @HStmt_T034120 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPEDPAR","T034120","",GX_CURSOR_TYPE_READONLY,@HStmt_T034120) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [PedFch], [PedGruTip] AS PedGruTip, [PedEntCod] AS PedEntCod, [PedSucCod] "
                  cmdbuf = cmdbuf + "  AS PedSucCod, [PedSec], [PedInd], [FamCod], [FamSubCod], [ArtCod], [PedLinTotR], "
                  cmdbuf = cmdbuf + "  [PedCnt], [PedVPrc], [PedVOfe], [PedVOfeNro], [PedPrcOri], [PedCntOri] FROM [PEDIDO3] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [PedFch] = ? AND [PedGruTip] = ? AND [PedEntCod] "
                  cmdbuf = cmdbuf + "  = ? AND [PedSucCod] = ? AND [PedSec] = ? ORDER BY [EmpCod], [PedFch], [PedGruTip], "
                  cmdbuf = cmdbuf + "  [PedEntCod], [PedSucCod], [PedSec], [PedInd], [FamCod], [FamSubCod], [ArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T034120,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T034120,11)
                  THISFORM.GX_DB_BindColsT034120_01 ()
                  THISFORM.GX_DB_BindParmT034120_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T034120,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA795PedFch = THISFORM.A795PedFch
               Gx_err = GX_DB_SetDate( HStmt_T034120,2,@AuxA795PedFch,0)
               THISFORM.A795PedFch = AuxA795PedFch
               AuxA797PedGru = THISFORM.A797PedGru
               Gx_err = GX_DB_SetStr( HStmt_T034120,3,AuxA797PedGru,2,0)
               THISFORM.A797PedGru = AuxA797PedGru
               AuxA798PedEnt = THISFORM.A798PedEnt
               Gx_err = GX_DB_SetLong( HStmt_T034120,4,@AuxA798PedEnt,0)
               THISFORM.A798PedEnt = AuxA798PedEnt
               AuxA802PedSuc = THISFORM.A802PedSuc
               Gx_err = GX_DB_SetInt( HStmt_T034120,5,@AuxA802PedSuc,0)
               THISFORM.A802PedSuc = AuxA802PedSuc
               AuxA809PedSec = THISFORM.A809PedSec
               Gx_err = GX_DB_SetInt( HStmt_T034120,6,@AuxA809PedSec,0)
               THISFORM.A809PedSec = AuxA809PedSec
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T034120) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034120 = Gx_err
               THISFORM.GX_DB_GetT034120_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T034120 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034120) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T034120 = Gx_err
                  THISFORM.GX_DB_GetT034120_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T034120 <> 101
               BRK9H137 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT341S25.Columns(4).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T034120_809PedSec = THISFORM.A809PedSec .AND. THISFORM.Buf_T034120_802PedSucCod = THISFORM.A802PedSuc .AND. THISFORM.Buf_T034120_798PedEntCod = THISFORM.A798PedEnt .AND. THISFORM.Buf_T034120_797PedGruTip = THISFORM.A797PedGru .AND. THISFORM.Buf_T034120_795PedFch = THISFORM.A795PedFch .AND. THISFORM.Buf_T034120_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034120) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034120 = Gx_err
               THISFORM.GX_DB_GetT034120_01 ()
            ENDDO
         ENDIF
      ENDPROC
