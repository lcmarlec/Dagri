         S1060PedIn = THISFORM.A1060PedIn
         S3FamCod = THISFORM.A3FamCod
         S4FamSubCo = THISFORM.A4FamSubCo
         S5ArtCod = THISFORM.A5ArtCod
         THISFORM.A1060PedIn = THISFORM.M1060PedIn
