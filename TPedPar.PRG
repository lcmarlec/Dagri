               Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT341S25 .AppendRow()
               THISFORM. cCT341S25 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
