            Aux2 = THISFORM.A798PedEnt
            Aux4 = THISFORM.AV26Dcvser
            Aux5 = THISFORM.AV25Dcvsuc
            Aux6 = THISFORM.AV6Fechasi
            Aux7 = THISFORM.AV27Okcai
