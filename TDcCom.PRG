      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T003630" , @HStmt_T003630 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCCOM","T003630","",0,@HStmt_T003630) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT EmpCod, DcCNroInt, DcCchTip, dccchCta, dccchNro, dccchObs, dccChImp, dccChNroI, "
                  cmdbuf = cmdbuf + "  dccChLin  FROM DCCOM4 (NOLOCK) WHERE EmpCod = ? AND DcCNroInt = ? ORDER BY EmpCod, "
                  cmdbuf = cmdbuf + "  DcCNroInt, DcCchTip, dccchCta, dccchNro   "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_T003630,cmdbuf) ,  ,  ,  , CS_SQLSRV , 0 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtFetchSize( HStmt_T003630,9) ,  ,  ,  , CS_SQLSRV , 0 )
                  THISFORM.GX_DB_BindColsT00362_01 ( HStmt_T003630 )
                  THISFORM.GX_DB_BindParmT003630_01 ( HStmt_T003630 )
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T003630,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               Gx_err = GX_DB_SetDouble( HStmt_T003630,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T003630) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T003630 = Gx_err
               THISFORM.GX_DB_GetT003630_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T003630 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T003630) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T003630 = Gx_err
                  THISFORM.GX_DB_GetT003630_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T003630 <> 101
               BRK10115 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT36S57.Columns(6).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T003630) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T003630 = Gx_err
               THISFORM.GX_DB_GetT003630_01 ()
            ENDDO
         ENDIF
      ENDPROC
