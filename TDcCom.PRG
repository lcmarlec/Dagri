            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA1070dccc"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1073dccC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1071dccc"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 30
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA1068DcCc"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 1
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('s:\tmp')
               SCT36S57 = GETE('s:\tmp') + '\' + SCT36S57
            ENDIF
            CREATE DBF (SCT36S57) FROM ARRAY GX_STRUCT
            USE
            USE (SCT36S57) EXCLUSIVE ALIAS SCT36S57
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT36S57
