                  cmdbuf = cmdbuf + "  WHERE EmpCod = ? AND DcCNroInt = ? AND DcCRORNroI = ? ORDER BY EmpCod, DcCNroInt, "
                  cmdbuf = cmdbuf + "  DcCRORNroI, DcCRORLin   "
