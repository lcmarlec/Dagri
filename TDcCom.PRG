      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S346DcCNro
         LOCAL S354DcCROR
         LOCAL S359DcCROR
         S2EmpCod = THISFORM.A2EmpCod
         S346DcCNro = THISFORM.A346DcCNro
         S354DcCROR = THISFORM.A354DcCROR
         S359DcCROR = THISFORM.A359DcCROR
         THISFORM.A359DcCROR = THISFORM.M359DcCROR
         THISFORM. cCT36S27 .SaveTemp()
         THISFORM. cCT36S27 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT36S27 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT36S27 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT36S27 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT36S27 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT36S27 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT36S27 .Refresh()
               THISFORM. cCT36S27 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A346DcCNro = S346DcCNro
               THISFORM.A354DcCROR = S354DcCROR
               THISFORM.A359DcCROR = S359DcCROR
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT36S27 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT36S27 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT36S27 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
            ENDDO
            IF sf_err != 0
               THISFORM. cCT36S27 .AppendRow()
               THISFORM. cCT36S27 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A346DcCNro = S346DcCNro
               THISFORM.A354DcCROR = S354DcCROR
               THISFORM.A359DcCROR = S359DcCROR
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A346DcCNro = S346DcCNro
         THISFORM.A354DcCROR = S354DcCROR
         THISFORM.A359DcCROR = S359DcCROR
         RETURN .F.
      ENDFUNC
