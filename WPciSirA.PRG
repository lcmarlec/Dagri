      PROCEDURE CreateTemp
         LOCAL SCW742S16
         SCW742S16 = ""
         IF USED( "SCW742S16" )
            SELECT SCW742S16
            SCW742S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW742S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA786PciDG"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA633PciCo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA634PciDs"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV8Sircoe"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 4

            GX_STRUCT[ 5 ,1]= "VAV17Tacco"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW742S16 = GETE('z:\temp') + '\' + SCW742S16
            ENDIF
            CREATE DBF (SCW742S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW742S16) EXCLUSIVE ALIAS SCW742S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW742S16
         THIS.GX_SfAlias = "SCW742S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07422" , @HStmt_W07422 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPCISIRA","W07422","",GX_CURSOR_TYPE_READONLY,@HStmt_W07422) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PaiCod], T1.[SirAnio], T1.[SirMes], T1.[SirCoef], T1.[TACCoef], T2.[PciDsc], "
                  cmdbuf = cmdbuf + "  T1.[PciCod], T2.[PciDGI] FROM ([PCISIRCR] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [PCIAS] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[PaiCod] = T1.[PaiCod] AND T2.[PciCod] = T1.[PciCod]) WHERE T1.[PaiCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[SirAnio] = ? and T1.[SirMes] = ? ORDER BY T1.[PaiCod], T1.[SirAnio], "
                  cmdbuf = cmdbuf + "  T1.[SirMes], T2.[PciDGI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07422,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07422,14)
                  THISFORM.GX_DB_BindColsW07422_01 ()
                  THISFORM.GX_DB_BindParmW07422_01 ()
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07422,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               AuxA2231SirAn = THISFORM.A2231SirAn
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07422,2,@AuxA2231SirAn,0)
               THISFORM.A2231SirAn = AuxA2231SirAn
               AuxA2232SirMe = THISFORM.A2232SirMe
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07422,3,@AuxA2232SirMe,0)
               THISFORM.A2232SirMe = AuxA2232SirMe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07422) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07422 = Gx_err
               THISFORM.GX_DB_GetW07422_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV20Pgmnam = "WPciSirA"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07422 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07422) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07422 = Gx_err
                  THISFORM.GX_DB_GetW07422_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07422 <> 101
               BRKVKM2 = .F.
               THISFORM.AV8Sircoef = 0.0000
               THISFORM.AV17Taccoe = 0.0000
               THISFORM.A2233SirCo = THISFORM.Buf_W07422_2233SirCoef
               THISFORM.A3765TACCo = THISFORM.Buf_W07422_3765TACCoef
               THISFORM.A634PciDsc = THISFORM.Buf_W07422_634PciDsc
               THISFORM.A633PciCod = THISFORM.Buf_W07422_633PciCod
               THISFORM.A786PciDGI = THISFORM.Buf_W07422_786PciDGI
               THISFORM.A634PciDsc = THISFORM.Buf_W07422_634PciDsc
               THISFORM.A786PciDGI = THISFORM.Buf_W07422_786PciDGI
               GX_SFLOAD = 0
               THISFORM.U15VKM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07422) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07422 = Gx_err
               THISFORM.GX_DB_GetW07422_01 ()
            ENDDO
         ENDIF
      ENDPROC
