               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02382) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02382 = Gx_err
            THISFORM.GX_DB_GetT02382_01 ()
            IF .NOT. THISFORM.T02382 <> 103
               DO GX_ERRMW WITH "ARTLEG reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02382 = 101 .OR. THISFORM.Z2330AleDs <> THISFORM.Buf_T02382_2330AleDsc
               DO GX_ERRMW WITH "ARTLEG fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

