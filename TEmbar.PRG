      ***********************
      PROCEDURE DEAL400
      ***********************

         * After confirm
         IF .T.
            THISFORM.AV19Numero = THISFORM.A3515EbgEx
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "AUSE" , Aux1 , "EMBARGO" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT381V17 .Refresh()
         ENDIF
         * Locks
         DO WHILE .NOT. THISFORM.T03812 <> 103
            DO GX_ERRMW WITH "EMBARGO   reservado por otro"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03812,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA3514EbgNr = THISFORM.A3514EbgNr
            Gx_err = GX_DB_SetDouble( HStmt_T03812,2,@AuxA3514EbgNr,0)
            THISFORM.A3514EbgNr = AuxA3514EbgNr
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03812) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03812 = Gx_err
            THISFORM.GX_DB_GetT03812_01 ()
         ENDDO
         THISFORM. cCT381A3524 .WriteToTbl("DLT")
      RETURN .T.

