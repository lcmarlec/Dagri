      PROCEDURE SetMode(gxType,gxLvl)
         gxO_Rec = 0
         IF THISFORM.GX_Curr_Level = 400
            THISFORM.SaveMode( THISFORM.GX_1Lvl_mode, "EOF")
            RETURN
         ENDIF
         DO CASE
            CASE THISFORM.GX_Curr_Level = 400
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T038110" , @HStmt_T038110 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TEMBAR","T038110","",GX_CURSOR_TYPE_READONLY,@HStmt_T038110) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EbgNroInt], [EmpCod], [EbgExp], [TraCod], [EbgFch], [EbgImp], [EbgPorc], "
                  cmdbuf = cmdbuf + "  [EbgDte], [EbgCta], [EbgEst], [EbgMot], [EbgFUD], [EbgSld], [EbgInsUsu], [EbgInsFch], "
                  cmdbuf = cmdbuf + "  [EbgUpdUsu], [EbgUsuFch], [EbgPagUlt] FROM [EMBARGO] (NOLOCK) WHERE [EmpCod] = ? "
                  cmdbuf = cmdbuf + "  AND [EbgNroInt] = ?  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T038110,cmdbuf)
                  THISFORM.GX_DB_BindColsT038110_01 ()
                  THISFORM.GX_DB_BindParmT038110_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T038110,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3514EbgNr = THISFORM.A3514EbgNr
               Gx_err = GX_DB_SetDouble( HStmt_T038110,2,@AuxA3514EbgNr,0)
               THISFORM.A3514EbgNr = AuxA3514EbgNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T038110) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T038110 = Gx_err
               THISFORM.GX_DB_GetT038110_01 ()
               gx_NewMode = "UPD"
               IF .not. THISFORM.T038110 <> 101
                  gx_NewMode = "INS"
               ENDIF
               IF THIS.AMode
                  THISFORM.SaveMode(gx_NewMode, "")
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T038110) ,  ,  ,  , CS_SQLSRV , 0 )
               RETURN
         ENDCASE
