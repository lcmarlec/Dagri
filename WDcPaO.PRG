                  cmdbuf = " SELECT T1.[EmpCod], T1.[DcCEst], T1.[DccEsp], T1.[DcCTip], T1.[DcCTotSld], T1.[DcCNetSld], "
                  cmdbuf = cmdbuf + "  T1.[DccSig], T1.[EntGruTip], T1.[DcCNroInt], T2.[EntRaz], T1.[EntCod], T1.[DcCNro], "
                  cmdbuf = cmdbuf + "  T1.[DcCSuc], T1.[DcCFec] FROM ([DCCOM] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] = ? and T1.[EntGruTip] = 'PR' and "
                  cmdbuf = cmdbuf + "  T1.[EntCod] = ? and T1.[DcCFec] >= ?) AND (T1.[DcCEst] = 1) AND (T1.[DcCTip] = 'OTRO' "
                  cmdbuf = cmdbuf + "  or T1.[DcCTip] = 'OPOT') AND (T1.[DccEsp] <> 'S' or ? > 0) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip], T1.[EntCod], T1.[DcCFec]  "
