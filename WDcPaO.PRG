      ***********************
      PROCEDURE U12V852
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'PAGAR'" )
         * 'Pagar' Routine
         THISFORM.AV18I = 0
         THISFORM.AV19Totapa = 0
         THISFORM.AV21Totane = 0
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW293S13 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW293S13.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW293S13.SF (3, @GX_SFERR)
            THISFORM.cCW293S13 .SaveGridPos()
            IF THISFORM.AV16Elegir = 1
               THISFORM.AV18I = THISFORM.AV18I + 1
               THISFORM.AV17Nroint[THISFORM.AV18I] = THISFORM.A346DcCNro
               THISFORM.AV19Totapa = THISFORM.AV19Totapa + THISFORM.A377DcCTot * THISFORM.A379DccSig
               IF substr( THISFORM.A348DcCTip , 1 , 2 ) <> "OP" .AND. THISFORM.AV16Elegir = 1
                  THISFORM.AV21Totane = THISFORM.AV21Totane + THISFORM.A375DcCNet * THISFORM.A379DccSig
               ENDIF
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW293S13 .RestoreGridPos()
               THISFORM.cCW293S13.SF (4, @GX_SFERR)
               THISFORM.cCW293S13.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW293S13 .ResetSavedGridPos()
         SELECT( THISFORM.cCW293S13 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW293S13.SF (3, @GX_SFERR)
         ENDIF
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.A2EmpCod
         Aux1 = THISFORM.AV5Fechasi
         Aux2 = THISFORM.AV9Desprv
         DIMENSION Aux3[999]
         =ACOPY( THISFORM.AV17Nroint , Aux3 )
         Aux4 = THISFORM.AV18I
         Aux5 = THISFORM.AV19Totapa
         Aux6 = THISFORM.AV21Totane
         Aux7 = THISFORM.AV12Usuari
         DO PDcPaO WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7
         THISFORM.A2EmpCod = Aux0
         THISFORM.AV5Fechasi = Aux1
         THISFORM.AV9Desprv = Aux2
         =ACOPY( Aux3 , THISFORM.AV17Nroint )
         THISFORM.AV18I = Aux4
         THISFORM.AV19Totapa = Aux5
         THISFORM.AV21Totane = Aux6
         THISFORM.AV12Usuari = Aux7
         THISFORM. cCW293S13 .RestoreGridPos()
         GX_rploop = .T.
         THISFORM.AV15Desfch = CTOD("  /  /  ")
         THISFORM.AV9Desprv = 0
         THISFORM.cCW293V15.GXSetFocus( )
         THISFORM.GX_Refresh = 1   &&& Refresh
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

