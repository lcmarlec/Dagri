            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW1146S20 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW1146S20 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
