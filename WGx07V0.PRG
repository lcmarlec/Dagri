      PROCEDURE CreateTemp
         LOCAL SCW1146S20
         SCW1146S20 = ""
         IF USED( "SCW1146S20" )
            SELECT SCW1146S20
            SCW1146S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1146S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA76BcoCta"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2543SldE"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2544SldS"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2548Slde"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 16
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3421SldT"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 240
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1146S20 = GETE('z:\temp') + '\' + SCW1146S20
            ENDIF
            CREATE DBF (SCW1146S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1146S20) EXCLUSIVE ALIAS SCW1146S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1146S20
         THIS.GX_SfAlias = "SCW1146S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11462" , @HStmt_W11462 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07V0","W11462","",GX_CURSOR_TYPE_READONLY,@HStmt_W11462) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [SldObs], [SldEst], [SldTipo], [Sldenvio], [SldSec], [SldEPer], [BcoCta], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [SLDENVIO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [BcoCta] "
                  cmdbuf = cmdbuf + "  >= ? and [SldEPer] >= ? and [SldSec] >= ?) AND ([Sldenvio] >= ?) AND ([SldObs] like "
                  cmdbuf = cmdbuf + "  ?) AND ([SldEst] >= ?) ORDER BY [EmpCod], [BcoCta], [SldEPer], [SldSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11462,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11462,9)
                  THISFORM.GX_DB_BindColsW11462_01 ()
                  THISFORM.GX_DB_BindParmW11462_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11462,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C76 = THISFORM.AV6C76
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11462,2,@AuxAV6C76,0)
               THISFORM.AV6C76 = AuxAV6C76
               AuxAV7C2543 = THISFORM.AV7C2543
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11462,3,@AuxAV7C2543,0)
               THISFORM.AV7C2543 = AuxAV7C2543
               AuxAV8C2544 = THISFORM.AV8C2544
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11462,4,@AuxAV8C2544,0)
               THISFORM.AV8C2544 = AuxAV8C2544
               AuxAV9C2548 = THISFORM.AV9C2548
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W11462,5,@AuxAV9C2548,0)
               THISFORM.AV9C2548 = AuxAV9C2548
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11462,6,PADR( TRIM(THISFORM.AV10C2549),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C2549),40, '%')),0)
               AuxAV11C2550 = THISFORM.AV11C2550
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11462,7,@AuxAV11C2550,0)
               THISFORM.AV11C2550 = AuxAV11C2550
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11462 = Gx_err
               THISFORM.GX_DB_GetW11462_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11462 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11462) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11462 = Gx_err
                  THISFORM.GX_DB_GetW11462_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11462 <> 101
               BRKVVU2 = .F.
               THISFORM.A2549SldOb = THISFORM.Buf_W11462_2549SldObs
               THISFORM.A2550SldEs = THISFORM.Buf_W11462_2550SldEst
               THISFORM.A3421SldTi = THISFORM.Buf_W11462_3421SldTipo
               THISFORM.A2548Slden = THISFORM.Buf_W11462_2548Sldenvio
               THISFORM.A2544SldSe = THISFORM.Buf_W11462_2544SldSec
               THISFORM.A2543SldEP = THISFORM.Buf_W11462_2543SldEPer
               THISFORM.A76BcoCta = THISFORM.Buf_W11462_76BcoCta
               THISFORM.A2EmpCod = THISFORM.Buf_W11462_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VVU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11462 = Gx_err
               THISFORM.GX_DB_GetW11462_01 ()
            ENDDO
         ENDIF
      ENDPROC
