                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03128" , @HStmt_T03128 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTIMP","T03128","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03128) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [ENTIMP] SET [EIBase]=?, [EICoef1]=?, [EICoef2]=?, [EIPorc1]=?, [EIPorc2]=? "
                  cmdbuf = cmdbuf + "   WHERE [EmpCod] = ? AND [EntCui] = ? AND [ImpCod] = ? AND [EIDde] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03128,cmdbuf)
                  THISFORM.GX_DB_BindParmT03128_01 ()
               ENDIF
               AuxA2994EIBas = THISFORM.A2994EIBas
               Gx_err = GX_DB_SetStr( HStmt_T03128,1,AuxA2994EIBas,1,0)
               THISFORM.A2994EIBas = AuxA2994EIBas
