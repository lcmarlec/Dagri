               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03129) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03129 = Gx_err
               THISFORM.T03122 = iif( THISFORM.T03129 = 0 , 104 , THISFORM.T03129 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03129) ,  ,  ,  , CS_SQLSRV , 0 )
