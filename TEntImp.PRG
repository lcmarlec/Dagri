               THISFORM.A2997EIPor = AuxA2997EIPor
               AuxA2998EIPor = THISFORM.A2998EIPor
               Gx_err = GX_DB_SetDouble( HStmt_T03128,5,@AuxA2998EIPor,0)
               THISFORM.A2998EIPor = AuxA2998EIPor
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03128,6,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T03128,7,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               AuxA613ImpCod = THISFORM.A613ImpCod
               Gx_err = GX_DB_SetStr( HStmt_T03128,8,AuxA613ImpCod,6,0)
               THISFORM.A613ImpCod = AuxA613ImpCod
               AuxA2993EIDde = THISFORM.A2993EIDde
               Gx_err = GX_DB_SetDate( HStmt_T03128,9,@AuxA2993EIDde,0)
               THISFORM.A2993EIDde = AuxA2993EIDde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03128) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03128 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03128) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03129" , @HStmt_T03129 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTIMP","T03129","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03129) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ENTIMP]  WHERE [EmpCod] = ? AND [EntCui] = ? AND [ImpCod] = ? AND [EIDde] "
                  cmdbuf = cmdbuf + "  = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03129,cmdbuf)
                  THISFORM.GX_DB_BindParmT03129_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03129,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
