      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01012" , @HStmt_W01012 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFERTA","W01012","",GX_CURSOR_TYPE_READONLY,@HStmt_W01012) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EntGruTip], T1.[EmpCod], T1.[OfeUsu], T1.[OfeFch], T1.[OfePrc], T2.[EntRaz], "
                  cmdbuf = cmdbuf + "  T1.[EntCod], T1.[OfeFHa], T1.[OfeFDe], T3.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[FamCod] FROM (([OFERTA] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[EntCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] "
                  cmdbuf = cmdbuf + "  = T1.[FamCod] AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[FamCod] = ? and T1.[FamSubCod] = ? and T1.[ArtCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OfeFDe] >= ? ORDER BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[OfeFDe], T1.[EntGruTip], T1.[EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01012,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01012,15)
                  THISFORM.GX_DB_BindColsW01012_01 ()
                  THISFORM.GX_DB_BindParmW01012_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01012,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV13Famcod = THISFORM.AV13Famcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01012,2,@AuxAV13Famcod,0)
               THISFORM.AV13Famcod = AuxAV13Famcod
               AuxAV14Famsub = THISFORM.AV14Famsub
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01012,3,@AuxAV14Famsub,0)
               THISFORM.AV14Famsub = AuxAV14Famsub
               AuxAV12Artcod = THISFORM.AV12Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01012,4,@AuxAV12Artcod,0)
               THISFORM.AV12Artcod = AuxAV12Artcod
               AuxAV15Fecdes = THISFORM.AV15Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01012,5,@AuxAV15Fecdes,0)
               THISFORM.AV15Fecdes = AuxAV15Fecdes
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01012) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01012 = Gx_err
               THISFORM.GX_DB_GetW01012_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV19Pgmnam = "WOferta"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01012 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01012) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01012 = Gx_err
                  THISFORM.GX_DB_GetW01012_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01012 <> 101
               BRKV2T2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W01012_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W01012_2EmpCod
               THISFORM.A1703OfeUs = THISFORM.Buf_W01012_1703OfeUsu
               THISFORM.A1702OfeFc = THISFORM.Buf_W01012_1702OfeFch
               THISFORM.A707OfePrc = THISFORM.Buf_W01012_707OfePrc
               THISFORM.A153EntRaz = THISFORM.Buf_W01012_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W01012_120EntCod
               THISFORM.A706OfeFHa = THISFORM.Buf_W01012_706OfeFHa
               THISFORM.A705OfeFDe = THISFORM.Buf_W01012_705OfeFDe
               THISFORM.A6ArtDsc = THISFORM.Buf_W01012_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W01012_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01012_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01012_3FamCod
               THISFORM.A153EntRaz = THISFORM.Buf_W01012_153EntRaz
               THISFORM.A6ArtDsc = THISFORM.Buf_W01012_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U18V2T2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01012) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01012 = Gx_err
               THISFORM.GX_DB_GetW01012_01 ()
            ENDDO
         ENDIF
      ENDPROC
