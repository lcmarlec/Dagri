      ENDPROC
      PROCEDURE InteractiveChange
         IF .not. THISFORM. cCW101S18 .GX_rec_modif
            THISFORM. cCW101S18 .Gx_rec_modif = .T.
            THISFORM. cCW101S18 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW101S18 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW101S18 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW101S18 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.A3FamCod = THIS.Value
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW101S18 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER OCW101.EnterKey
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
         ELSE
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            IF ! THISFORM.InRoutine("ISVALID")
               THISFORM.FormRefresh( .T. , .F. )
            ENDIF
         ENDIF
         IF gx_val_ret >= 0
            IF THIS.GX_Mouse
               THIS.GotMouseDown()
            ENDIF
            NODEFAULT
            IF gx_val_ret >= 0
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
            RETURN
         ELSE
            IF gx_val_ret = -2
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM.GX_NewLastVld != -1
            THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THISFORM. cCW101S18 .GX_focusInGrid = .T.
         THISFORM. cCW101S18 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW101V8 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A3FamCod"
         THISFORM.cCW101S18 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW101S18 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW101S18 .GX_lastkey = 9.or. THISFORM.cCW101S18 .GX_lastkey = 13)
            IF ! THISFORM.cCW101S18 .GridValidObj( THISFORM.cCW101S18 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW101S18 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW101S18 .gx_can_changerow = .T.
