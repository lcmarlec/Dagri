            THISFORM.AV67Kilosb = THISFORM.AV67Kilosb + THISFORM.A649TDVCnt * THISFORM.A33ArtVtaK + THISFORM.A649TDVCnt * THISFORM.A1833ArtVt + THISFORM.A649TDVCnt * THISFORM.A2225ArtVt
