      PROCEDURE CreateTemp
         LOCAL SCW21S5
         SCW21S5 = ""
         IF USED( "SCW21S5" )
            SELECT SCW21S5
            SCW21S5 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW21S5
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "VAV18Objet"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV8Titulo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW21S5 = GETE('z:\temp') + '\' + SCW21S5
            ENDIF
            CREATE DBF (SCW21S5) FROM ARRAY GX_STRUCT
            USE
            USE (SCW21S5) EXCLUSIVE ALIAS SCW21S5
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW21S5
         THIS.GX_SfAlias = "SCW21S5"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U15V0L2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
      PROCEDURE LoadFromTbl
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV18Objet WITH THISFORM.AV18Objeto
         REPLACE VAV8Titulo WITH THISFORM.AV8Titulo
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV18Objeto = VAV18Objet
         THISFORM.AV8Titulo = VAV8Titulo
      ENDPROC
