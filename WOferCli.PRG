      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05212" , @HStmt_W05212 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFERCLI","W05212","",GX_CURSOR_TYPE_READONLY,@HStmt_W05212) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T1.[EntCod], T1.[EntGruTip], T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[OfvNro], T1.[OfvPrcReal], T1.[OfvPRet], T1.[OfvPorc], T1.[OfvUsu], T1.[OfvFch], "
                  cmdbuf = cmdbuf + "  T1.[OfvPrc], T1.[GrpOf], T3.[EntRaz], T1.[OfvFHa], T1.[OfvFDe], T2.[ArtDsc] FROM "
                  cmdbuf = cmdbuf + "  (([OFVTA] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T3.[EntGruTip] = T1.[EntGruTip] AND T3.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[EntGruTip] = 'CL') AND (T1.[EntCod] = ?) AND (T1.[OfvFDe] >= ?) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], T1.[OfvFDe], T1.[EntGruTip], "
                  cmdbuf = cmdbuf + "  T1.[EntCod], T1.[GrpOf]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05212,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05212,15)
                  THISFORM.GX_DB_BindColsW05212_01 ()
                  THISFORM.GX_DB_BindParmW05212_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05212,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV16Entcod = THISFORM.AV16Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05212,2,@AuxAV16Entcod,0)
               THISFORM.AV16Entcod = AuxAV16Entcod
               AuxAV15Fecdes = THISFORM.AV15Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W05212,3,@AuxAV15Fecdes,0)
               THISFORM.AV15Fecdes = AuxAV15Fecdes
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05212 = Gx_err
               THISFORM.GX_DB_GetW05212_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV38Pgmnam = "WOferCli"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05212 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05212) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05212 = Gx_err
                  THISFORM.GX_DB_GetW05212_01 ()
               ENDIF
         ENDCASE
