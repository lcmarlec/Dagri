         * Load Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05213" , @HStmt_W05213 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFERCLI","W05213","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05213) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [PlVGruTip], [PlVEntCod], [FamCod], [FamSubCod], [ArtCod], [PlVPrc], "
            cmdbuf = cmdbuf + "  [PlVPrcReal] FROM [PLAVTA1] (NOLOCK) WHERE [EmpCod] = ? and [PlVGruTip] = ? and "
            cmdbuf = cmdbuf + "  [PlVEntCod] = ? and [FamCod] = ? and [FamSubCod] = ? and [ArtCod] = ? ORDER BY [EmpCod], "
            cmdbuf = cmdbuf + "  [PlVGruTip], [PlVEntCod], [FamCod], [FamSubCod], [ArtCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05213,cmdbuf)
            THISFORM.GX_DB_BindColsW05213_01 ()
            THISFORM.GX_DB_BindParmW05213_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05213,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA150EntGru = THISFORM.A150EntGru
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05213,2,AuxA150EntGru,2,0)
