         THISFORM.A3FamCod = AuxA3FamCod
         AuxA4FamSubCo = THISFORM.A4FamSubCo
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05213,5,@AuxA4FamSubCo,0)
         THISFORM.A4FamSubCo = AuxA4FamSubCo
         AuxA5ArtCod = THISFORM.A5ArtCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05213,6,@AuxA5ArtCod,0)
         THISFORM.A5ArtCod = AuxA5ArtCod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05213) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05213 = Gx_err
         THISFORM.GX_DB_GetW05213_01 ()
         DO WHILE THISFORM.W05213 <> 101
            THISFORM.A836PlVGru = THISFORM.Buf_W05213_836PlVGruTip
            THISFORM.A837PlVEnt = THISFORM.Buf_W05213_837PlVEntCod
            THISFORM.A839PlVPrc = THISFORM.Buf_W05213_839PlVPrc
            THISFORM.A1328PlVPr = THISFORM.Buf_W05213_1328PlVPrcReal
            THISFORM.AV26Plvprc = THISFORM.A839PlVPrc
            THISFORM.AV27Plvprc = THISFORM.A1328PlVPr
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05213) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.cCW521S18 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW521S18 .GX_rec_loaded =  THISFORM.cCW521S18 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW521S18 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW521S18 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

