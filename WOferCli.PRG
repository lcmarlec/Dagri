      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "Alta" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VEH2()
            RETURN .T.
         ENDIF
         IF UPPER( "Borrar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VEH2()
            RETURN .T.
         ENDIF
         IF UPPER( "Modificar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VEH2()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU17VEH2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VEH2()
            RETURN .T.
         ENDIF
         IF UPPER( "SkArtic" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU18VEH2()
            RETURN .T.
         ENDIF
         IF UPPER( "SkClte" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VEH2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_FIRST"
            THISFORM.DoFirst
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_PREV"
            THISFORM.DoPrevious
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_NEXT"
            THISFORM.DoNext
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_LAST"
            THISFORM.DoLast
            RETURN .T.
         ENDIF
