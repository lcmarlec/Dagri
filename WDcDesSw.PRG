      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08272" , @HStmt_W08272 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCDESSW","W08272","",GX_CURSOR_TYPE_READONLY,@HStmt_W08272) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[DceNI], T3.[DcEEntCod], T3.[DcEGruTip], T1.[DcEValImp], T1.[DcEValImpO], "
                  cmdbuf = cmdbuf + "  T1.[DcEValFch], T2.[OPaNro] AS DcEOpaNro, T1.[DceOpaLin], T1.[DceOpaNII], T1.[DcEOpaNroI] "
                  cmdbuf = cmdbuf + "  AS DcEOpaNroI, T3.[DcENroDC], T3.[DcENroReg], T3.[DcENroTip], T3.[DcENroAd], T3.[DcENroAn] "
                  cmdbuf = cmdbuf + "  FROM (([DCDESSWI] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [OPAGOS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[OPaNroI] = T1.[DcEOpaNroI]) LEFT JOIN [DCDESPA1] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[DceNI] = T1.[DceNI]) WHERE T1.[EmpCod] = ? "
                  cmdbuf = cmdbuf + "  and T1.[DceNI] = ? ORDER BY T1.[EmpCod], T1.[DceNI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08272,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08272,9)
                  THISFORM.GX_DB_BindColsW08272_01 ()
                  THISFORM.GX_DB_BindParmW08272_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08272,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3022DceNI = THISFORM.A3022DceNI
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08272,2,@AuxA3022DceNI,0)
               THISFORM.A3022DceNI = AuxA3022DceNI
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08272 = Gx_err
               THISFORM.GX_DB_GetW08272_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WDcDesSw"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08272 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08272) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08272 = Gx_err
                  THISFORM.GX_DB_GetW08272_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08272 <> 101
               BRKVMZ2 = .F.
               THISFORM.A2363DcEEn = THISFORM.Buf_W08272_2363DcEEntCod
               THISFORM.A2365DcEGr = THISFORM.Buf_W08272_2365DcEGruTip
               THISFORM.A2360DcEVa = THISFORM.Buf_W08272_2360DcEValImp
               THISFORM.A2389DcEVa = THISFORM.Buf_W08272_2389DcEValImpO
               THISFORM.A2361DcEVa = THISFORM.Buf_W08272_2361DcEValFch
               THISFORM.A2388DcEOp = THISFORM.Buf_W08272_2388DcEOpaNro
               THISFORM.A2558DceOp = THISFORM.Buf_W08272_2558DceOpaLin
               THISFORM.A2552DceOp = THISFORM.Buf_W08272_2552DceOpaNII
               THISFORM.A2387DcEOp = THISFORM.Buf_W08272_2387DcEOpaNroI
               THISFORM.A2353DcENr = THISFORM.Buf_W08272_2353DcENroDC
               THISFORM.A2352DcENr = THISFORM.Buf_W08272_2352DcENroReg
               THISFORM.A2351DcENr = THISFORM.Buf_W08272_2351DcENroTip
               THISFORM.A2350DcENr = THISFORM.Buf_W08272_2350DcENroAd
               THISFORM.A2349DcENr = THISFORM.Buf_W08272_2349DcENroAn
               THISFORM.A2388DcEOp = THISFORM.Buf_W08272_2388DcEOpaNro
               THISFORM.A2363DcEEn = THISFORM.Buf_W08272_2363DcEEntCod
               THISFORM.A2365DcEGr = THISFORM.Buf_W08272_2365DcEGruTip
               THISFORM.A2353DcENr = THISFORM.Buf_W08272_2353DcENroDC
               THISFORM.A2352DcENr = THISFORM.Buf_W08272_2352DcENroReg
               THISFORM.A2351DcENr = THISFORM.Buf_W08272_2351DcENroTip
               THISFORM.A2350DcENr = THISFORM.Buf_W08272_2350DcENroAd
               THISFORM.A2349DcENr = THISFORM.Buf_W08272_2349DcENroAn
               GX_SFLOAD = 0
               THISFORM.U17VMZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
