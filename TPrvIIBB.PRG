               ENDDO
               THISFORM.T02155 = Gx_err
               THISFORM.GX_DB_GetT02155_01 ()
               Gx_fcond = THISFORM.T02155 <> 101
               DO WHILE Gx_fcond
                  Gx_fcond = THISFORM.Buf_T02155_120EntCod = THISFORM.A120EntCod .AND. THISFORM.Buf_T02155_150EntGruTip = THISFORM.A150EntGru
                  IF Gx_fcond
