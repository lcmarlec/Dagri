      PROCEDURE Activate
         IF THISFORM.GX_init_activate
            IF THISFORM.Gx_mode <> "DSP"
               THISFORM.AV21Pgmnam = "TPrvIIBB"
               THISFORM.A2EmpCod = THISFORM.AV8Emprcod
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               THISFORM.Gx_mode = "UPD"
               THISFORM.A2EmpCod = THISFORM.AV8Emprcod
               THISFORM.Gx_mode = "DSP"
            ENDIF
            THISFORM.U115Z2 ()
            IF TYPE( "OCT215" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            THISFORM.SetLevel( 15 )
            THISFORM.GX_last_fld_lvl = 15
            IF ! THISFORM.InitLevels( 15 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               IF THISFORM. cCT215A120 .MV(5) != 0
                  THISFORM.SaveMode( "INS" ,"")
               ELSE
                  THISFORM.LoadObj(4)
               ENDIF
            ENDIF
            GXForm::Activate
         ENDIF
         THISFORM.ClearFrmTBar
         THISFORM.GxMenuBar.Clear
         THISFORM.SetMBTimer()
         gxMB = "OFF"
         THISFORM.GxMenuBar.Set(gxMB)
         IF THISFORM.GX_Mode = "DLT"
            THISFORM.LockScreen = .F.
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02153,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA150EntGru = THISFORM.A150EntGru
            Gx_err = GX_DB_SetStr( HStmt_T02153,2,AuxA150EntGru,2,0)
            THISFORM.A150EntGru = AuxA150EntGru
            AuxA120EntCod = THISFORM.A120EntCod
            Gx_err = GX_DB_SetLong( HStmt_T02153,3,@AuxA120EntCod,0)
            THISFORM.A120EntCod = AuxA120EntCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02153) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02153 = Gx_err
            THISFORM.GX_DB_GetT02153_01 ()
            THISFORM. cCT215A120 . ZM5Z15 ( 3 )
            IF THISFORM.T02153 = 101
               DO GX_ERRMW WITH "No se encontro el registro"
            ELSE
               THISFORM.Visible = .T.
               THISFORM.LoadObj(0)
               THISFORM.DoDelete
            ENDIF
            THISFORM.ReleaseAll()
            RETURN
         ENDIF
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         THISFORM.SetFKeys()
         DO CASE
            CASE THISFORM.GX_Curr_Level = 15
               THISFORM.SaveMode( THIS.GX_mode ,"")
         ENDCASE
