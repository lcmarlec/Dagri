               DO WHILE THISFORM.T02155 = 0 .AND. THISFORM.A2EmpCod >= THISFORM.Buf_T02155_2EmpCod .AND. THISFORM.A150EntGru = THISFORM.Buf_T02155_150EntGruTip .AND. THISFORM.A120EntCod = THISFORM.Buf_T02155_120EntCod
