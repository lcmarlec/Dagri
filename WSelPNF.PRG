                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11202) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11202 = Gx_err
                  THISFORM.GX_DB_GetW11202_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11202 <> 101
               BRKVV42 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W11202_2EmpCod
               THISFORM.A150EntGru = THISFORM.Buf_W11202_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W11202_120EntCod
               THISFORM.A3308EntCo = THISFORM.Buf_W11202_3308EntCodDB
               THISFORM.A3307EntGr = THISFORM.Buf_W11202_3307EntGruDb
               X33090 = SPACE(40)
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A3307EntGr
               Aux2 = THISFORM.A3308EntCo
               DO RProvNFR WITH Aux0 , Aux1 , Aux2 , X33090
               THISFORM.A2EmpCod = Aux0
               THISFORM.A3307EntGr = Aux1
               THISFORM.A3308EntCo = Aux2
               GX_rploop = .T.
               THISFORM.A3309EntRa = X33090
               GX_SFLOAD = 0
               THISFORM.U14VV42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11202) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11202 = Gx_err
               THISFORM.GX_DB_GetW11202_01 ()
            ENDDO
         ENDIF
      ENDPROC
