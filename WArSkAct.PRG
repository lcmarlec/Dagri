               THISFORM.AV19Desfam = AuxAV19Desfam
               AuxAV18Desfam = THISFORM.AV18Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10422,4,@AuxAV18Desfam,0)
               THISFORM.AV18Desfam = AuxAV18Desfam
               AuxAV19Desfam = THISFORM.AV19Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10422,5,@AuxAV19Desfam,0)
               THISFORM.AV19Desfam = AuxAV19Desfam
               AuxAV19Desfam = THISFORM.AV19Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10422,6,@AuxAV19Desfam,0)
               THISFORM.AV19Desfam = AuxAV19Desfam
               AuxAV20Descod = THISFORM.AV20Descod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10422,7,@AuxAV20Descod,0)
               THISFORM.AV20Descod = AuxAV20Descod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10422,8,PADR( TRIM(THISFORM.AV16Desdsc),50, '%'),LEN(PADR( TRIM(THISFORM.AV16Desdsc),50, '%')),0)
               AuxAV21Tipart = THISFORM.AV21Tipart
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10422,9,AuxAV21Tipart,1,0)
               THISFORM.AV21Tipart = AuxAV21Tipart
               AuxAV21Tipart = THISFORM.AV21Tipart
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10422,10,AuxAV21Tipart,1,0)
               THISFORM.AV21Tipart = AuxAV21Tipart
               AuxAV21Tipart = THISFORM.AV21Tipart
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10422,11,AuxAV21Tipart,1,0)
               THISFORM.AV21Tipart = AuxAV21Tipart
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10422) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10422 = Gx_err
               THISFORM.GX_DB_GetW10422_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WArSkAct"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10422 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10422) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10422 = Gx_err
                  THISFORM.GX_DB_GetW10422_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10422 <> 101
               BRKVSY2 = .F.
               THISFORM.A28ArtVta = THISFORM.Buf_W10422_28ArtVta
               THISFORM.A24ArtCpr = THISFORM.Buf_W10422_24ArtCpr
               THISFORM.A6ArtDsc = THISFORM.Buf_W10422_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W10422_5ArtCod
               THISFORM.A16FamSubD = THISFORM.Buf_W10422_16FamSubDsc
               THISFORM.A4FamSubCo = THISFORM.Buf_W10422_4FamSubCod
               THISFORM.A15FamDsc = THISFORM.Buf_W10422_15FamDsc
               THISFORM.A3FamCod = THISFORM.Buf_W10422_3FamCod
               THISFORM.A15FamDsc = THISFORM.Buf_W10422_15FamDsc
               THISFORM.A16FamSubD = THISFORM.Buf_W10422_16FamSubDsc
               GX_SFLOAD = 0
               THISFORM.U23VSY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10422) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10422 = Gx_err
               THISFORM.GX_DB_GetW10422_01 ()
            ENDDO
         ENDIF
      ENDPROC
