      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV14Asifc WITH THISFORM.AV14Asifch
         REPLACE VAV13Asids WITH THISFORM.AV13Asidsc
         REPLACE VAV11Debe WITH THISFORM.AV11Debe
         REPLACE VAV12Haber WITH THISFORM.AV12Haber
         REPLACE VAV17Tagni WITH THISFORM.AV17Tagni
