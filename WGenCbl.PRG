      PROCEDURE CreateTemp
         LOCAL SCW435S10
         SCW435S10 = ""
         IF USED( "SCW435S10" )
            SELECT SCW435S10
            SCW435S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW435S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "VAV14Asifc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV13Asids"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV11Debe"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 14
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "VAV12Haber"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 14
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "VAV17Tagni"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW435S10 = GETE('z:\temp') + '\' + SCW435S10
            ENDIF
            CREATE DBF (SCW435S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCW435S10) EXCLUSIVE ALIAS SCW435S10
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW435S10
         THIS.GX_SfAlias = "SCW435S10"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV17Tagni = 0
               GX_SFLOAD = 0
               THISFORM.U17VC32 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
