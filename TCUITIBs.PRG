               DO WHILE THISFORM.T03204 = 0
                  THISFORM.A2658CUIT = THISFORM.Buf_T03204_2658CUIT
                  THISFORM.A2983perio = THISFORM.Buf_T03204_2983periodo
                  Gx_eop = 1
