                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03203) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03203 = Gx_err
                  THISFORM.GX_DB_GetT03203_01 ()
                  THISFORM. cCT320A2983 . ZM8W344 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC8W344 ()
               THISFORM. cCT320A2983 . ZM8W344 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC8W344 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT320A2985 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE8W344 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC8W344 ()
                  RETURN
               ENDIF
               THISFORM.cCT320A2983.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03203) , "TCUITIBS" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03202) , "TCUITIBS" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT320A2985 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT320A2983 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
