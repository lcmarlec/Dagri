            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1603TmSNr = THISFORM.A1603TmSNr .AND. S1632TmSUs = THISFORM.A1632TmSUs .AND. S1633TmSFe = THISFORM.A1633TmSFe .AND. S1634TmSHo = THISFORM.A1634TmSHo
