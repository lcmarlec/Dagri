                  cmdbuf = " SELECT [EmpCod], [TmSNroInt], [TmSUsuario], [TmSFecha], [TmSHora], [TmSLin], [TmSFamCod], "
                  cmdbuf = cmdbuf + "  [TmSFamSubC], [TmSArtCod], [TmSCntFc], [TmSCntEx], [TmSPrc], [TmSDifMotC], [TmSDifMotD], "
                  cmdbuf = cmdbuf + "  [TmSDifExp] FROM [TMPSEG1] (NOLOCK) WHERE [EmpCod] = ? AND [TmSNroInt] = ? AND [TmSUsuario] "
                  cmdbuf = cmdbuf + "  = ? AND [TmSFecha] = ? AND [TmSHora] = ? ORDER BY [EmpCod], [TmSNroInt], [TmSUsuario], "
                  cmdbuf = cmdbuf + "  [TmSFecha], [TmSHora], [TmSLin]  "
