      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T013717" , @HStmt_T013717 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTASIE","T013717","",GX_CURSOR_TYPE_READONLY,@HStmt_T013717) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EjeNro], [tasCod], [tasNroInt], [tasItNro], [tasDes], [CtaNro], "
                  cmdbuf = cmdbuf + "  [tasItDbOri], [tasItHbOri] FROM [TASEN1] (NOLOCK) WHERE [EmpCod] = ? AND [EjeNro] "
                  cmdbuf = cmdbuf + "  = ? AND [tasCod] = ? AND [tasNroInt] = ? ORDER BY [EmpCod], [EjeNro], [tasCod], "
                  cmdbuf = cmdbuf + "  [tasNroInt], [tasItNro]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T013717,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T013717,11)
                  THISFORM.GX_DB_BindColsT013717_01 ()
                  THISFORM.GX_DB_BindParmT013717_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T013717,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA548EjeNro = THISFORM.A548EjeNro
               Gx_err = GX_DB_SetLong( HStmt_T013717,2,@AuxA548EjeNro,0)
               THISFORM.A548EjeNro = AuxA548EjeNro
               AuxA1395tasCo = THISFORM.A1395tasCo
               Gx_err = GX_DB_SetInt( HStmt_T013717,3,@AuxA1395tasCo,0)
               THISFORM.A1395tasCo = AuxA1395tasCo
               AuxA1396tasNr = THISFORM.A1396tasNr
               Gx_err = GX_DB_SetLong( HStmt_T013717,4,@AuxA1396tasNr,0)
               THISFORM.A1396tasNr = AuxA1396tasNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T013717) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013717 = Gx_err
               THISFORM.GX_DB_GetT013717_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T013717 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013717) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T013717 = Gx_err
                  THISFORM.GX_DB_GetT013717_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T013717 <> 101
               BRK3T164 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT137S23.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T013717_1396tasNroInt = THISFORM.A1396tasNr .AND. THISFORM.Buf_T013717_1395tasCod = THISFORM.A1395tasCo .AND. THISFORM.Buf_T013717_548EjeNro = THISFORM.A548EjeNro .AND. THISFORM.Buf_T013717_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013717) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013717 = Gx_err
               THISFORM.GX_DB_GetT013717_01 ()
            ENDDO
         ENDIF
      ENDPROC
