      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10622" , @HStmt_W10622 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKARTLO","W10622","",GX_CURSOR_TYPE_READONLY,@HStmt_W10622) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PrvCod], T1.[lotraz], T3.[ArtVtaBlt], T2.[LugHab], T1.[ArtStkEst], T1.[ArtStkAct], "
                  cmdbuf = cmdbuf + "  T2.[LugDsc], T1.[LugCod], T1.[LotVnc], T1.[LotFch], T1.[LotNro], T1.[EmpCod], T3.[ArtDsc], "
                  cmdbuf = cmdbuf + "  T1.[ArtCod], T1.[FamSubCod], T1.[FamCod] FROM (([ARTSTK] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [LUGALM] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[LugCod] = T1.[LugCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] "
                  cmdbuf = cmdbuf + "  AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[FamCod] = ? and T1.[FamSubCod] = ? and T1.[ArtCod] = ? and T1.[ArtStkEst] "
                  cmdbuf = cmdbuf + "  = 0) AND (T1.[ArtStkAct] > 0) ORDER BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[ArtCod], T1.[ArtStkEst], T1.[LotVnc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10622,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10622,9)
                  THISFORM.GX_DB_BindColsW10622_01 ()
                  THISFORM.GX_DB_BindParmW10622_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10622,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV21Famcod = THISFORM.AV21Famcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10622,2,@AuxAV21Famcod,0)
               THISFORM.AV21Famcod = AuxAV21Famcod
               AuxAV22Famsub = THISFORM.AV22Famsub
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10622,3,@AuxAV22Famsub,0)
               THISFORM.AV22Famsub = AuxAV22Famsub
               AuxAV23Artcod = THISFORM.AV23Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10622,4,@AuxAV23Artcod,0)
               THISFORM.AV23Artcod = AuxAV23Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10622 = Gx_err
               THISFORM.GX_DB_GetW10622_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WSKArtLo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10622 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10622) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10622 = Gx_err
                  THISFORM.GX_DB_GetW10622_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
