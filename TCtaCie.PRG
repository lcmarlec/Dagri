            Gx_err = GX_DB_SetInt( HStmt_T01472,1,@AuxA76BcoCta,0)
            THISFORM.A76BcoCta = AuxA76BcoCta
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01472) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01472 = Gx_err
            THISFORM.GX_DB_GetT01472_01 ()
            IF .NOT. THISFORM.T01472 <> 103
               DO GX_ERRMW WITH "CTAS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01472 = 101 .OR. THISFORM.Z79BcoDir <> THISFORM.Buf_T01472_79BcoDir
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z86BcoCod <> THISFORM.Buf_T01472_86BcoCod
               DO GX_ERRMW WITH "CTAS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

