      PROCEDURE CreateTemp
         LOCAL SCW697S20
         SCW697S20 = ""
         IF USED( "SCW697S20" )
            SELECT SCW697S20
            SCW697S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW697S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2130RemN"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA150EntGr"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA120EntCo"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2131RemT"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2132RemS"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW697S20 = GETE('z:\temp') + '\' + SCW697S20
            ENDIF
            CREATE DBF (SCW697S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW697S20) EXCLUSIVE ALIAS SCW697S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW697S20
         THIS.GX_SfAlias = "SCW697S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06972" , @HStmt_W06972 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06L0","W06972","",GX_CURSOR_TYPE_READONLY,@HStmt_W06972) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [RemSuc], [RemSer], [RemTip], [EntCod], [EntGruTip], [RemNI], [EmpCod] FROM "
                  cmdbuf = cmdbuf + "  [REMMBT] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [RemNI] >= ?) AND ([EntGruTip] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EntCod] >= ?) AND ([RemTip] like ?) AND ([RemSer] like ?) AND ([RemSuc] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [RemNI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06972,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06972,9)
                  THISFORM.GX_DB_BindColsW06972_01 ()
                  THISFORM.GX_DB_BindParmW06972_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06972,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C2130 = THISFORM.AV6C2130
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06972,2,@AuxAV6C2130,0)
               THISFORM.AV6C2130 = AuxAV6C2130
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06972,3,PADR( TRIM(THISFORM.AV7C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV7C150),2, '%')),0)
               AuxAV8C120 = THISFORM.AV8C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06972,4,@AuxAV8C120,0)
               THISFORM.AV8C120 = AuxAV8C120
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06972,5,PADR( TRIM(THISFORM.AV9C2131),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C2131),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06972,6,PADR( TRIM(THISFORM.AV10C2132),1, '%'),LEN(PADR( TRIM(THISFORM.AV10C2132),1, '%')),0)
               AuxAV11C2133 = THISFORM.AV11C2133
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06972,7,@AuxAV11C2133,0)
               THISFORM.AV11C2133 = AuxAV11C2133
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06972) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06972 = Gx_err
               THISFORM.GX_DB_GetW06972_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06972 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06972) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06972 = Gx_err
                  THISFORM.GX_DB_GetW06972_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06972 <> 101
               BRKVJD2 = .F.
               THISFORM.A2133RemSu = THISFORM.Buf_W06972_2133RemSuc
               THISFORM.A2132RemSe = THISFORM.Buf_W06972_2132RemSer
               THISFORM.A2131RemTi = THISFORM.Buf_W06972_2131RemTip
               THISFORM.A120EntCod = THISFORM.Buf_W06972_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W06972_150EntGruTip
               THISFORM.A2130RemNI = THISFORM.Buf_W06972_2130RemNI
               THISFORM.A2EmpCod = THISFORM.Buf_W06972_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VJD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06972) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06972 = Gx_err
               THISFORM.GX_DB_GetW06972_01 ()
            ENDDO
         ENDIF
      ENDPROC
