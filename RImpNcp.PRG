   R02692 = Gx_err
   GX_DB_GetR02692_01 ()
   DO WHILE R02692 <> 101
      R613ImpCod = Buf_R02692_613ImpCod
      R616ImpPor = Buf_R02692_616ImpPor
      RV14Iva = R616ImpPor
