      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10072" , @HStmt_W10072 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPAIMP","W10072","",GX_CURSOR_TYPE_READONLY,@HStmt_W10072) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[OpaEntGruT] AS OpaEntGruT, T1.[OPaTip], T1.[OpaTot], T1.[OPaNro], T2.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS OpaEntRaz, T1.[OpaEntCod] AS OpaEntCod, T1.[OpaFch], T1.[OPaNroI], T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  FROM ([OPAGOS] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[OpaEntGruT] AND T2.[EntCod] = T1.[OpaEntCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[OPaNro] >= ?) AND (T1.[OPaNro] <= ? or ? = 0) AND (T1.[OpaEntCod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) AND (T1.[OpaEntGruT] = 'PR') AND (T1.[OpaFch] >= ?) AND (T1.[OpaFch] "
                  cmdbuf = cmdbuf + "  <= ? or (? = convert( DATETIME, '17530101', 112 ))) AND (T1.[OPaTip] = 'OPAG' or "
                  cmdbuf = cmdbuf + "  T1.[OPaTip] = 'OPOT') ORDER BY T1.[EmpCod], T1.[OPaNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10072,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10072,14)
                  THISFORM.GX_DB_BindColsW10072_01 ()
                  THISFORM.GX_DB_BindParmW10072_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10072,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV14Desnro = THISFORM.AV14Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10072,2,@AuxAV14Desnro,0)
               THISFORM.AV14Desnro = AuxAV14Desnro
               AuxAV26Hasnro = THISFORM.AV26Hasnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10072,3,@AuxAV26Hasnro,0)
               THISFORM.AV26Hasnro = AuxAV26Hasnro
               AuxAV26Hasnro = THISFORM.AV26Hasnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10072,4,@AuxAV26Hasnro,0)
               THISFORM.AV26Hasnro = AuxAV26Hasnro
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10072,5,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10072,6,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV23Desfch = THISFORM.AV23Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10072,7,@AuxAV23Desfch,0)
               THISFORM.AV23Desfch = AuxAV23Desfch
               AuxAV27Hasfch = THISFORM.AV27Hasfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10072,8,@AuxAV27Hasfch,0)
               THISFORM.AV27Hasfch = AuxAV27Hasfch
               AuxAV27Hasfch = THISFORM.AV27Hasfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10072,9,@AuxAV27Hasfch,0)
               THISFORM.AV27Hasfch = AuxAV27Hasfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10072 = Gx_err
               THISFORM.GX_DB_GetW10072_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WOpaImp"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10072 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10072) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10072 = Gx_err
                  THISFORM.GX_DB_GetW10072_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10072 <> 101
               BRKVRZ2 = .F.
               THISFORM.AV25Imprim = 0
               THISFORM.A712OpaEnt = THISFORM.Buf_W10072_712OpaEntGruT
               THISFORM.A715OPaTip = THISFORM.Buf_W10072_715OPaTip
               THISFORM.A729OpaTot = THISFORM.Buf_W10072_729OpaTot
               THISFORM.A718OPaNro = THISFORM.Buf_W10072_718OPaNro
               THISFORM.A714OpaEnt = THISFORM.Buf_W10072_714OpaEntRaz
               THISFORM.A713OpaEnt = THISFORM.Buf_W10072_713OpaEntCod
               THISFORM.A709OpaFch = THISFORM.Buf_W10072_709OpaFch
               THISFORM.A708OPaNro = THISFORM.Buf_W10072_708OPaNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W10072_2EmpCod
               THISFORM.A714OpaEnt = THISFORM.Buf_W10072_714OpaEntRaz
               GX_SFLOAD = 0
               THISFORM.U18VRZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10072 = Gx_err
               THISFORM.GX_DB_GetW10072_01 ()
            ENDDO
         ENDIF
      ENDPROC
