      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05623" , @HStmt_W05623 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WTALONAR","W05623","",GX_CURSOR_TYPE_READONLY,@HStmt_W05623) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TalBcoCta], [TalFch], [TalHab], [TalNroHta], [TalNroDde] FROM [TALONARI] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [TalBcoCta] = ? and [TalNroDde] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([TalHab] = ? or ? = 9) ORDER BY [EmpCod], [TalBcoCta], [TalNroDde]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05623,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05623,12)
                  THISFORM.GX_DB_BindColsW05623_01 ()
                  THISFORM.GX_DB_BindParmW05623_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05623,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Talbco = THISFORM.AV21Talbco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05623,2,@AuxAV21Talbco,0)
               THISFORM.AV21Talbco = AuxAV21Talbco
               AuxAV22Talnro = THISFORM.AV22Talnro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05623,3,@AuxAV22Talnro,0)
               THISFORM.AV22Talnro = AuxAV22Talnro
               AuxAV23Talhab = THISFORM.AV23Talhab
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05623,4,@AuxAV23Talhab,0)
               THISFORM.AV23Talhab = AuxAV23Talhab
               AuxAV23Talhab = THISFORM.AV23Talhab
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05623,5,@AuxAV23Talhab,0)
               THISFORM.AV23Talhab = AuxAV23Talhab
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05623) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05623 = Gx_err
               THISFORM.GX_DB_GetW05623_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WTalonar"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05623 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05623) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05623 = Gx_err
                  THISFORM.GX_DB_GetW05623_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05623 <> 101
               BRKVFM2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W05623_2EmpCod
               THISFORM.A1721TalBc = THISFORM.Buf_W05623_1721TalBcoCta
               THISFORM.A1730TalFc = THISFORM.Buf_W05623_1730TalFch
               THISFORM.A1726TalHa = THISFORM.Buf_W05623_1726TalHab
               THISFORM.A1724TalNr = THISFORM.Buf_W05623_1724TalNroHta
               THISFORM.A1723TalNr = THISFORM.Buf_W05623_1723TalNroDde
               GX_SFLOAD = 0
               THISFORM.U18VFM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05623) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05623 = Gx_err
               THISFORM.GX_DB_GetW05623_01 ()
            ENDDO
         ENDIF
