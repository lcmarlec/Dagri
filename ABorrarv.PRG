         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_P12712) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      P12712 = Gx_err
      GX_DB_GetP12712_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P12712) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   IF TYPE( "HConn_Default" ) = "N"
      IF GXCONNECTED
         Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
      ENDIF
   ENDIF
   DO GX_ERRMW WITH "Baja por vencidos " + str( RV9I , 6 )
   DO EPZB0
   RETURN
   GX_retp = 0
* End Program

