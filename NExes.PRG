      PROCEDURE CreateTemp
         LOCAL SCT52S9
         SCT52S9 = ""
         IF USED( "SCT52S9" )
            SELECT SCT52S9
            SCT52S9 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT52S9
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA583ExeNo"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA584ExeDe"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA585ExeFl"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT52S9 = GETE('z:\temp') + '\' + SCT52S9
            ENDIF
            CREATE DBF (SCT52S9) FROM ARRAY GX_STRUCT
            USE
            USE (SCT52S9) EXCLUSIVE ALIAS SCT52S9
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT52S9
         THIS.GX_SfAlias = "SCT52S9"
      ENDPROC
      PROCEDURE UpdObj(gxmode)
         LOCAL gxO_Area
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         THISFORM. GXInLvl54 = .T.
         THISFORM. cCT52S9 .GX_field_saved = .T.
         THISFORM. cCT52S9 .GX_field_saved = .T.
         THISFORM. cCT52S9 .GX_field_saved = .T.
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00527" , @HStmt_T00527 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TEXES","T00527","",GX_CURSOR_TYPE_READONLY,@HStmt_T00527) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [ExeNom], [ExeDesc], [ExeFlag] FROM [EXES] (NOLOCK) ORDER BY [ExeNom]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00527,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00527,8)
                  THISFORM.GX_DB_BindColsT00527_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00527) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00527 = Gx_err
               THISFORM.GX_DB_GetT00527_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T00527 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00527) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00527 = Gx_err
                  THISFORM.GX_DB_GetT00527_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T00527 <> 101
               BRK1G54 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT52S9.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00527) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00527 = Gx_err
               THISFORM.GX_DB_GetT00527_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A583ExeNom"
            THISFORM.A583ExeNom = THISFORM.Buf_T00527_583ExeNom
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A584ExeDes"
            THISFORM.A584ExeDes = THISFORM.Buf_T00527_584ExeDesc
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A585ExeFla"
            THISFORM.A585ExeFla = THISFORM.Buf_T00527_585ExeFlag
         ENDIF
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA583ExeNo WITH THISFORM.A583ExeNom
         REPLACE sA584ExeDe WITH THISFORM.A584ExeDes
         REPLACE sA585ExeFl WITH THISFORM.A585ExeFla
