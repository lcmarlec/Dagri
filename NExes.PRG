      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 54
               IF THISFORM.GX_Mode = "INS" .or. THISFORM. cCT52S9 .GX_in_last_row
                  THISFORM. cCT52S9 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 54
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA583ExeNom = THISFORM.A583ExeNom
                  Gx_err = GX_DB_SetStr( HStmt_T00523,1,AuxA583ExeNom,8,0)
                  THISFORM.A583ExeNom = AuxA583ExeNom
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00523) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00523 = Gx_err
                  THISFORM.GX_DB_GetT00523_01 ()
                  THISFORM. cCT52S9.Columns(1).Ctrl1 . ZM1G54 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC1G54 ()
               THISFORM. cCT52S9.Columns(1).Ctrl1 . ZM1G54 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1G54 ()
                  RETURN
               ENDIF
               THISFORM. cCT52S9 .GX_ctrl_modif =  .T.
               IF ! THISFORM. cCT52S9.Columns(3).Ctrl1 .CheckTables()
                  RETURN .F.
               ENDIF
               THISFORM. cCT52S9 .GX_ctrl_modif =  .F.
               IF .not. THISFORM. DE1G54 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1G54 ()
                  RETURN
               ENDIF
               GXErr = 0
               THISFORM. cCT52S9 .SF(10, GXErr)
               THISFORM. cCT52S9 .Refresh()
               THISFORM. cCT52S9 .LoadVar()
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00523) , "TEXES" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00522) , "TEXES" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT52S9.Columns(3).Ctrl1 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               IF THISFORM.AMode
                  THISFORM. cCT52S9 .SetFocus()
               ENDIF
               THISFORM.SetMode("", "1" )
               THISFORM. cCT52S9 .GX_need_load = .T.
               THISFORM. cCT52S9 .LoadGridRows()
         ENDCASE
      ENDPROC

