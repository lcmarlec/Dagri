      PROCEDURE LoadObj(LoadType)
         * Default load for WKP
         GX_CUOPER = 1
         GX_CUERR = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05502" , @HStmt_W05502 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAMIONV","W05502","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05502) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[CamPat], T1.[CamPatRen], T1.[CamHabCR], T1.[CamHabCaba], "
                  cmdbuf = cmdbuf + "  T1.[CamPatVto], T1.[CamNro], T1.[CamVTVR], T1.[CamMunR], T1.[CamTRuR], T1.[CamSegR], "
                  cmdbuf = cmdbuf + "  T1.[CamHabR], T1.[CamVdeR], T1.[CamCarR], T1.[CamMunic], T1.[CamTRu], T1.[CamSeg], "
                  cmdbuf = cmdbuf + "  T1.[CamHab], T1.[CamVde], T1.[CamCarga], T1.[CamSegEqf], T1.[CamSegFur], T1.[CamSegCha], "
                  cmdbuf = cmdbuf + "  T1.[CamVTV], T1.[CamFacPas], T1.[CamFacFch], T1.[CamFacNro], T1.[CamFacSuc], T2.[ChfNom] "
                  cmdbuf = cmdbuf + "  AS CamChfNom, T1.[CamChfCod] AS CamChfCod, T1.[CamObs], T1.[CamChanro], T1.[CamCol], "
                  cmdbuf = cmdbuf + "  T1.[CamAnio], T1.[CamMar], T1.[CamMod], T1.[CamMotNro], T1.[CamDsc] FROM ([CAMION] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ChfCod] = T1.[CamChfCod]) WHERE T1.[EmpCod] = ? and T1.[CamPat] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[CamPat]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05502,cmdbuf)
                  THISFORM.GX_DB_BindColsW05502_01 ()
                  THISFORM.GX_DB_BindParmW05502_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05502,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1664CamPa = THISFORM.A1664CamPa
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05502,2,AuxA1664CamPa,8,0)
               THISFORM.A1664CamPa = AuxA1664CamPa
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05502 = Gx_err
               THISFORM.GX_DB_GetW05502_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV13Pgmnam = "WCamionV"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05502 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05502) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05502 = Gx_err
