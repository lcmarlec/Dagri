            IF Gx_longc .OR. THISFORM.Buf_T02182_2120xLpvPrcAn <> THISFORM.Z2120xLpvP
               DO GX_ERRMW WITH "LPVCLT1 fue modificada."
               RETURN .F.
            ENDIF
