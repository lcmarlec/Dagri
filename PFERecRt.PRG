***********************
PROCEDURE EPJI0
***********************

   DO HJI0 WITH Gx_out , P_lines , 0, P_lines +1, .T., 0
   IF Gx_dvc = "PRN"
      GXAuxPrn_Flag = GXPrn_Flag
      gxPrnObj.GXEndDoc( GxHDC , @GXAuxPrn_Flag)
      gxPrnObj.GXEndPrn( GxHDC , @GXAuxPrn_Flag)
      GXPrn_Flag = GXAuxPrn_Flag
      PRIVATE GXCallFrm
      IF PROGRAM(0) = "MENU"
         GXCallFrm = _SCREEN.ActiveForm
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 0
         ENDIF
      ENDIF
      DO WHILE gxPrnObj.GxIsAliveDoc( GxHDC ) != 0
         WAIT "" TIMEOUT 1
         DOEVENTS
      ENDDO
      RELEASE WINDOW _WMSG
      IF PROGRAM(0) = "MENU"
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 1
         ENDIF
      ENDIF
   ELSE
      SET DEVICE TO SCREEN
      RptView = .T.
   ENDIF
   DO CDJI0
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

***********************
PROCEDURE HJI0
***********************

   PARAMETERS Gx_out, P_lines, Gx_line, Gx_inc, GX_footer, GX_inc_test

   Gx_line = Gx_line + Gx_inc
   IF Gx_line + GX_inc_test > P_lines
      IF Gx_page > 0
         Gx_line = P_lines
         IF Gx_dvc = "PRN" .and. Gx_pg_started
            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
         GXPrn_Flag = GXAuxPrn_Flag
         Gx_pg_started = .T.
      ENDIF
   ENDIF
RETURN
