      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09652" , @HStmt_W09652 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSELCLTE","W09652","",GX_CURSOR_TYPE_READONLY,@HStmt_W09652) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntCPD], T2.[EntInhab], T1.[EntLgDom], T1.[EntLgDsc], T1.[EntLgCod], T2.[EntRaz], "
                  cmdbuf = cmdbuf + "  T1.[EntCod], T1.[EntLgEan], T1.[EntLgInhab], T2.[EntEAN], T1.[EntGruTip], T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  FROM ([CLTES] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[EntGruTip] = ?) AND (RTRIM(T2.[EntEAN]) = RTRIM(?)) AND (RTRIM(T1.[EntLgEan]) "
                  cmdbuf = cmdbuf + "  = RTRIM(?)) AND (T2.[EntCPD] = CONVERT( DECIMAL(28,14), ?) or CONVERT( DECIMAL(28,14), "
                  cmdbuf = cmdbuf + "  ?) < 0) AND (T2.[EntInhab] <> 'S') AND (T1.[EntLgInhab] <> 'S') ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip], T1.[EntCod], T1.[EntLgDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09652,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09652,8)
                  THISFORM.GX_DB_BindColsW09652_01 ()
                  THISFORM.GX_DB_BindParmW09652_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09652,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV23Entgru = THISFORM.AV23Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09652,2,AuxAV23Entgru,2,0)
               THISFORM.AV23Entgru = AuxAV23Entgru
               AuxAV26Entean = THISFORM.AV26Entean
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09652,3,AuxAV26Entean,15,0)
               THISFORM.AV26Entean = AuxAV26Entean
               AuxAV27Entlge = THISFORM.AV27Entlge
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09652,4,AuxAV27Entlge,15,0)
               THISFORM.AV27Entlge = AuxAV27Entlge
               AuxAV28Provee = THISFORM.AV28Provee
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09652,5,AuxAV28Provee,10,0)
               THISFORM.AV28Provee = AuxAV28Provee
               AuxAV28Provee = THISFORM.AV28Provee
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09652,6,AuxAV28Provee,10,0)
               THISFORM.AV28Provee = AuxAV28Provee
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09652 = Gx_err
               THISFORM.GX_DB_GetW09652_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WSelClte"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09652 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09652) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09652 = Gx_err
                  THISFORM.GX_DB_GetW09652_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09652 <> 101
               BRKVQT2 = .F.
               THISFORM.A2937EntCP = THISFORM.Buf_W09652_2937EntCPD
               THISFORM.A1717EntIn = THISFORM.Buf_W09652_1717EntInhab
               THISFORM.A178EntLgD = THISFORM.Buf_W09652_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W09652_177EntLgDsc
               THISFORM.A176EntLgC = THISFORM.Buf_W09652_176EntLgCod
               THISFORM.A153EntRaz = THISFORM.Buf_W09652_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W09652_120EntCod
               THISFORM.A1917EntLg = THISFORM.Buf_W09652_1917EntLgEan
               THISFORM.A1886EntLg = THISFORM.Buf_W09652_1886EntLgInhab
               THISFORM.A1916EntEA = THISFORM.Buf_W09652_1916EntEAN
               THISFORM.A150EntGru = THISFORM.Buf_W09652_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W09652_2EmpCod
               THISFORM.A2937EntCP = THISFORM.Buf_W09652_2937EntCPD
               THISFORM.A1717EntIn = THISFORM.Buf_W09652_1717EntInhab
               THISFORM.A153EntRaz = THISFORM.Buf_W09652_153EntRaz
               THISFORM.A1916EntEA = THISFORM.Buf_W09652_1916EntEAN
               GX_SFLOAD = 0
               THISFORM.U15VQT2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09652 = Gx_err
               THISFORM.GX_DB_GetW09652_01 ()
            ENDDO
         ENDIF
