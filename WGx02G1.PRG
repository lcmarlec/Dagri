      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01972" , @HStmt_W01972 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02G1","W01972","",GX_CURSOR_TYPE_READONLY,@HStmt_W01972) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PaiCod], [PciIbr], [PciDGI], [PciCoU], [PciCo2], [PciIbB], [PciDsc], [PciCod] "
                  cmdbuf = cmdbuf + "  FROM [PCIAS] (FASTFIRSTROW NOLOCK) WHERE ([PaiCod] = ?) AND ([PciCod] like ?) AND "
                  cmdbuf = cmdbuf + "  ([PciIbr] >= ?) AND ([PciDGI] >= ?) AND ([PciCoU] >= ?) AND ([PciCo2] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([PciIbB] >= ?) ORDER BY [PaiCod], [PciCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01972,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01972,9)
                  THISFORM.GX_DB_BindColsW01972_01 ()
                  THISFORM.GX_DB_BindParmW01972_01 ()
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01972,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01972,2,PADR( TRIM(THISFORM.AV5C633),4, '%'),LEN(PADR( TRIM(THISFORM.AV5C633),4, '%')),0)
               AuxAV6C785 = THISFORM.AV6C785
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01972,3,@AuxAV6C785,0)
               THISFORM.AV6C785 = AuxAV6C785
               AuxAV7C786 = THISFORM.AV7C786
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01972,4,@AuxAV7C786,0)
               THISFORM.AV7C786 = AuxAV7C786
               AuxAV8C787 = THISFORM.AV8C787
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01972,5,@AuxAV8C787,0)
               THISFORM.AV8C787 = AuxAV8C787
               AuxAV9C1895 = THISFORM.AV9C1895
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01972,6,@AuxAV9C1895,0)
               THISFORM.AV9C1895 = AuxAV9C1895
               AuxAV10C2242 = THISFORM.AV10C2242
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01972,7,@AuxAV10C2242,0)
               THISFORM.AV10C2242 = AuxAV10C2242
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01972) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01972 = Gx_err
               THISFORM.GX_DB_GetW01972_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01972 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01972) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01972 = Gx_err
                  THISFORM.GX_DB_GetW01972_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01972 <> 101
               BRKV5H2 = .F.
               THISFORM.A785PciIbr = THISFORM.Buf_W01972_785PciIbr
               THISFORM.A786PciDGI = THISFORM.Buf_W01972_786PciDGI
               THISFORM.A787PciCoU = THISFORM.Buf_W01972_787PciCoU
               THISFORM.A1895PciCo = THISFORM.Buf_W01972_1895PciCo2
               THISFORM.A2242PciIb = THISFORM.Buf_W01972_2242PciIbB
               THISFORM.A634PciDsc = THISFORM.Buf_W01972_634PciDsc
               THISFORM.A633PciCod = THISFORM.Buf_W01972_633PciCod
               GX_SFLOAD = 0
               THISFORM.U12V5H2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01972) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01972 = Gx_err
               THISFORM.GX_DB_GetW01972_01 ()
            ENDDO
