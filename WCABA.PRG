      PROCEDURE CreateTemp
         LOCAL SCW1013S12
         SCW1013S12 = ""
         IF USED( "SCW1013S12" )
            SELECT SCW1013S12
            SCW1013S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1013S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2983peri"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3025Caba"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3026Caba"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3031PerC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA3032RetC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "sA2658CUIT"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 11
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1013S12 = GETE('z:\temp') + '\' + SCW1013S12
            ENDIF
            CREATE DBF (SCW1013S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1013S12) EXCLUSIVE ALIAS SCW1013S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1013S12
         THIS.GX_SfAlias = "SCW1013S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10132" , @HStmt_W10132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCABA","W10132","",GX_CURSOR_TYPE_READONLY,@HStmt_W10132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [RetCaba], [PerCaba], [CUIT], [CabaHta], [CabaDde], [periodo] FROM [CUITIIBB] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE [CUIT] = ? and [periodo] >= ? ORDER BY [CUIT], [periodo] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10132,14)
                  THISFORM.GX_DB_BindColsW10132_01 ()
                  THISFORM.GX_DB_BindParmW10132_01 ()
               ENDIF
               AuxAV5Entcui = THISFORM.AV5Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10132,1,@AuxAV5Entcui,0)
               THISFORM.AV5Entcui = AuxAV5Entcui
               AuxAV19Period = THISFORM.AV19Period
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10132,2,@AuxAV19Period,0)
               THISFORM.AV19Period = AuxAV19Period
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10132 = Gx_err
               THISFORM.GX_DB_GetW10132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WCABA"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10132 = Gx_err
                  THISFORM.GX_DB_GetW10132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10132 <> 101
               BRKVS52 = .F.
               THISFORM.A3032RetCa = THISFORM.Buf_W10132_3032RetCaba
               THISFORM.A3031PerCa = THISFORM.Buf_W10132_3031PerCaba
               THISFORM.A2658CUIT = THISFORM.Buf_W10132_2658CUIT
               THISFORM.A3026CabaH = THISFORM.Buf_W10132_3026CabaHta
               THISFORM.A3025CabaD = THISFORM.Buf_W10132_3025CabaDde
               THISFORM.A2983perio = THISFORM.Buf_W10132_2983periodo
               GX_SFLOAD = 0
               THISFORM.U16VS52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10132 = Gx_err
               THISFORM.GX_DB_GetW10132_01 ()
            ENDDO
         ENDIF
      ENDPROC
