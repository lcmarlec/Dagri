            RETURN
         ENDIF
         SELECT ( THISFORM.cCW1013S12 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
