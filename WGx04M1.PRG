      PROCEDURE CreateTemp
         LOCAL SCW450S16
         SCW450S16 = ""
         IF USED( "SCW450S16" )
            SELECT SCW450S16
            SCW450S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW450S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1434ActC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1435ActD"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1436ActI"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW450S16 = GETE('z:\temp') + '\' + SCW450S16
            ENDIF
            CREATE DBF (SCW450S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW450S16) EXCLUSIVE ALIAS SCW450S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW450S16
         THIS.GX_SfAlias = "SCW450S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04502" , @HStmt_W04502 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04M1","W04502","",GX_CURSOR_TYPE_READONLY,@HStmt_W04502) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ActIIBBPor], [ActIIBBMin], [ActDsc], [ActCod] FROM [ACTIVIDA] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [ActCod] >= ?) AND ([ActDsc] like ?) AND ([ActIIBBMin] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ActIIBBPor] >= ?) ORDER BY [EmpCod], [ActCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04502,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04502,9)
                  THISFORM.GX_DB_BindColsW04502_01 ()
                  THISFORM.GX_DB_BindParmW04502_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04502,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C1434 = THISFORM.AV5C1434
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04502,2,@AuxAV5C1434,0)
               THISFORM.AV5C1434 = AuxAV5C1434
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04502,3,PADR( TRIM(THISFORM.AV6C1435),30, '%'),LEN(PADR( TRIM(THISFORM.AV6C1435),30, '%')),0)
               AuxAV7C1436 = THISFORM.AV7C1436
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04502,4,@AuxAV7C1436,0)
               THISFORM.AV7C1436 = AuxAV7C1436
               AuxAV8C1437 = THISFORM.AV8C1437
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04502,5,@AuxAV8C1437,0)
               THISFORM.AV8C1437 = AuxAV8C1437
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04502 = Gx_err
               THISFORM.GX_DB_GetW04502_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04502 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04502) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04502 = Gx_err
                  THISFORM.GX_DB_GetW04502_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04502 <> 101
               BRKVCI2 = .F.
               THISFORM.A1437ActII = THISFORM.Buf_W04502_1437ActIIBBPor
               THISFORM.A1436ActII = THISFORM.Buf_W04502_1436ActIIBBMin
               THISFORM.A1435ActDs = THISFORM.Buf_W04502_1435ActDsc
               THISFORM.A1434ActCo = THISFORM.Buf_W04502_1434ActCod
               GX_SFLOAD = 0
               THISFORM.U12VCI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04502 = Gx_err
               THISFORM.GX_DB_GetW04502_01 ()
            ENDDO
         ENDIF
      ENDPROC
