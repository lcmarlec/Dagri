               THISFORM.A3148NumPr = THISFORM.Buf_W02522_3148NumPre
               THISFORM.A2505NumCn = THISFORM.Buf_W02522_2505NumCnt
               THISFORM.A2503NumEl = THISFORM.Buf_W02522_2503NumEle
               THISFORM.A119NumUlt = THISFORM.Buf_W02522_119NumUlt
               THISFORM.A679NumSuc = THISFORM.Buf_W02522_679NumSuc
               GX_SFLOAD = 0
               THISFORM.U12V702 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02522 = Gx_err
               THISFORM.GX_DB_GetW02522_01 ()
            ENDDO
         ENDIF
