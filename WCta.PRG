      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00242" , @HStmt_W00242 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCTA","W00242","",GX_CURSOR_TYPE_READONLY,@HStmt_W00242) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PCtaNro], T2.[PCtaNiv], T2.[PCtaDes], T1.[CtaDes], T1.[CtaNro] "
                  cmdbuf = cmdbuf + "  FROM ([CTA00] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [PCTA] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[PCtaNro] = T1.[PCtaNro]) WHERE (T1.[EmpCod] = ? and T1.[PCtaNro] "
                  cmdbuf = cmdbuf + "  = ? and T1.[CtaNro] >= ?) AND (T1.[CtaDes] like ?) ORDER BY T1.[EmpCod], T1.[PCtaNro] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00242,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00242,12)
                  THISFORM.GX_DB_BindColsW00242_01 ()
                  THISFORM.GX_DB_BindParmW00242_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00242,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA198PCtaNr = THISFORM.A198PCtaNr
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00242,2,@AuxA198PCtaNr,0)
               THISFORM.A198PCtaNr = AuxA198PCtaNr
               AuxAV20Ctanro = THISFORM.AV20Ctanro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00242,3,AuxAV20Ctanro,12,0)
               THISFORM.AV20Ctanro = AuxAV20Ctanro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00242,4,PADR( TRIM(THISFORM.AV22Ctades),40, '%'),LEN(PADR( TRIM(THISFORM.AV22Ctades),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00242) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00242 = Gx_err
               THISFORM.GX_DB_GetW00242_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WCta"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00242 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00242) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00242 = Gx_err
                  THISFORM.GX_DB_GetW00242_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00242 <> 101
               BRKV0O2 = .F.
               THISFORM.A790PCtaNi = THISFORM.Buf_W00242_790PCtaNiv
               THISFORM.A210PCtaDe = THISFORM.Buf_W00242_210PCtaDes
               THISFORM.A200CtaDes = THISFORM.Buf_W00242_200CtaDes
               THISFORM.A199CtaNro = THISFORM.Buf_W00242_199CtaNro
               THISFORM.A790PCtaNi = THISFORM.Buf_W00242_790PCtaNiv
               THISFORM.A210PCtaDe = THISFORM.Buf_W00242_210PCtaDes
               GX_SFLOAD = 0
               THISFORM.U16V0O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00242) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00242 = Gx_err
               THISFORM.GX_DB_GetW00242_01 ()
            ENDDO
         ENDIF
      ENDPROC
