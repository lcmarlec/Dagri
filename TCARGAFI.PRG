            ENDDO
            THISFORM.T03982 = Gx_err
            THISFORM.GX_DB_GetT03982_01 ()
            IF .NOT. THISFORM.T03982 <> 103
               DO GX_ERRMW WITH "CARGAFIN reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03982 = 101 .OR. THISFORM.Z3723CarFF <> THISFORM.Buf_T03982_3723CarFFchA
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z3728AcoFi <> THISFORM.Buf_T03982_3728AcoFin
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z3733PatFi <> THISFORM.Buf_T03982_3733PatFin
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z3738carfp <> THISFORM.Buf_T03982_3738carfp1
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z3743carfp <> THISFORM.Buf_T03982_3743carfp6
               DO GX_ERRMW WITH "CARGAFIN fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
