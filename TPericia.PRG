               Gx_err = GX_DB_SetLong( HStmt_T03289,10,@AuxA3099PerID,0)
               THISFORM.A3099PerID = AuxA3099PerID
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03289) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03289 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03289) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T032810" , @HStmt_T032810 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPERICIA","T032810","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T032810) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [PERICIAS]  WHERE [EmpCod] = ? AND [PerID] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T032810,cmdbuf)
                  THISFORM.GX_DB_BindParmT032810_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T032810,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3099PerID = THISFORM.A3099PerID
               Gx_err = GX_DB_SetLong( HStmt_T032810,2,@AuxA3099PerID,0)
               THISFORM.A3099PerID = AuxA3099PerID
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T032810) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T032810 = Gx_err
               THISFORM.T03282 = iif( THISFORM.T032810 = 0 , 104 , THISFORM.T032810 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T032810) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A3099PerID )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.A2EmpCod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "AUSE" , Aux1 , "Peri" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.A2EmpCod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT328V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 360 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
