               THISFORM.A3101PerPt = AuxA3101PerPt
               AuxA3102PerPt = THISFORM.A3102PerPt
               Gx_err = GX_DB_SetStr( HStmt_T03289,6,AuxA3102PerPt,20,0)
               THISFORM.A3102PerPt = AuxA3102PerPt
               AuxA3104PerOb = THISFORM.A3104PerOb
