               THISFORM.A3097PerTi = AuxA3097PerTi
               AuxA3101PerPt = THISFORM.A3101PerPt
               Gx_err = GX_DB_SetStr( HStmt_T03288,7,AuxA3101PerPt,50,0)
               THISFORM.A3101PerPt = AuxA3101PerPt
               AuxA3102PerPt = THISFORM.A3102PerPt
