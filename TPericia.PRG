                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPERICIA","T03289","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03289) ,  ,  ,  , CS_SQLSRV , 0 )
