               AuxA3105PerEs = THISFORM.A3105PerEs
               Gx_err = GX_DB_SetStr( HStmt_T03289,8,AuxA3105PerEs,3,0)
               THISFORM.A3105PerEs = AuxA3105PerEs
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03289,9,@AuxA2EmpCod,0)
