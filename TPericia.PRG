                  cmdbuf = " INSERT INTO [PERICIAS] ([EmpCod], [PerID], [TraCod], [PerFch], [PerEstFch], [PerTipId], "
                  cmdbuf = cmdbuf + "  [PerPtoNom], [PerPtoTel], [PerObs], [PerEst]) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, "
                  cmdbuf = cmdbuf + "  ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03288,cmdbuf)
                  THISFORM.GX_DB_BindParmT03288_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
