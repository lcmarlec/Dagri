               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03288) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03288 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03288) ,  ,  ,  , CS_SQLSRV , 0 )
