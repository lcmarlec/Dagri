                  cmdbuf = cmdbuf + "  [PerPtoTel]=?, [PerObs]=?, [PerEst]=?  WHERE [EmpCod] = ? AND [PerID] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03289,cmdbuf)
