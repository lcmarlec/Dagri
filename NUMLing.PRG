************
* NUMLETRA *
************
* FUNCION :      Convierte un numero a un string de palabras
* Programas que la utilizan: USO GENERAL
*
*     Antes de invocar deben haber sido pre-definidas las siguientes variables:
*     NLNUMERO : Es el numero a convertir
*     NLLONGIT : Es la longitud del renglon en el que va a dividir el string
*     NLSENDEC : Senial que indica si el numero posee decimales (1=Si ; 0=No)
*                Siempre la cantidad de decimales sera dos.
*     NLTEXTO  : Es donde quedara el string de salida
*
*     Es aconsejable que esten definidas en el lanzador del sistema
*
*
* PROCEDURE NUMLETRA
PARAMETERS NLNUMERO, NLLONGIT, NLSENDEC, NLTEXTO ,RELLENO

DECLARE NLVECUNI[9]
DECLARE NLVECDEC0[9]
DECLARE NLVECDEC[9]
DECLARE NLVECCEN[9]
NLVECUNI[1]='ONE'
NLVECUNI[2]='TWO'
NLVECUNI[3]='THREE'
NLVECUNI[4]='FOUR'
NLVECUNI[5]='FIVE'
NLVECUNI[6]='SIX'
NLVECUNI[7]='SEVEN'
NLVECUNI[8]='EIGHT'
NLVECUNI[9]='NINE'
NLVECDEC0[1]='ELEVEN'
NLVECDEC0[2]='TWELVE'
NLVECDEC0[3]='THIRTEEN'
NLVECDEC0[4]='FOURTEEN'
NLVECDEC0[5]='FIFTEEN'
NLVECDEC0[6]='TEN'
NLVECDEC[1]='TWENTY'
NLVECDEC[2]='TWENTY'
NLVECDEC[3]='THIRTY'
NLVECDEC[4]='FORTY'
NLVECDEC[5]='FIFTY'
NLVECDEC[6]='SIXTY'
NLVECDEC[7]='SEVENTY'
NLVECDEC[8]='EIGHTY'
NLVECDEC[9]='NINETY'
NLVECCEN[1]='HUNDRED'
NLVECCEN[2]='TWO'
NLVECCEN[3]='THREE'
NLVECCEN[4]='FOUR'
NLVECCEN[5]='FIVE HUNDRED'
NLVECCEN[6]='SIX'
NLVECCEN[7]='SEVEN'
NLVECCEN[8]='EIGHT'
NLVECCEN[9]='NINE'

NLDEC=0
NLCEN=0
NLTEXTO=''
IF NLNUMERO<0
	NLTEXTO='- '
ENDIF
NLDECI=(NLNUMERO-(INT(NLNUMERO)))*100
NLNUMERO2=INT(NLNUMERO)
NLDECISTR=STR(NLDECI,2)
NLNUMSTR=LTRIM(STR(NLNUMERO2))
NLENTE=LEN(NLNUMSTR)

NL1=1
DO WHILE NL1 <= NLENTE
	NL2=NLENTE-NL1
	NL6=VAL(SUBSTR(NLNUMSTR,NL1,1))
	IF NL2=0 .OR. NL2=3 .OR. NL2=6 .OR. NL2=9
		IF NLDEC=0 .AND. NLCEN=0 .AND. NL6=0
			NL1=NL1+1
			LOOP
		ELSE
			IF NLDEC=0 .AND. NLCEN=1
				IF NL6=0
					NLTEXTO=NLTEXTO+'HUNDRED '
				ELSE
					NLTEXTO=NLTEXTO+NLVECCEN[1]+' '
				ENDIF
			ENDIF
		ENDIF
		IF NLDEC=1
			IF NL6=0
				NLTEXTO=NLTEXTO+NLVECDEC0[6]+' '
			ELSE
				IF NL6>=1 .AND. NL6<=5
	//HASTA ACA				NLTEXTO=NLTEXTO+NLVECDEC0[NL6]+' '
				ELSE
					NLTEXTO=NLTEXTO+'DIECI'
				ENDIF
			ENDIF
		ENDIF
		IF NLDEC=2
			IF NL6=0
				NLTEXTO=NLTEXTO+NLVECDEC[1]+' '
			ELSE
				NLTEXTO=NLTEXTO+NLVECDEC[2]
			ENDIF
		ENDIF

		IF NL6<>0
			IF NLDEC=3
				NLTEXTO=NLTEXTO+'Y '
			ENDIF
			IF NL2<>0 .AND. NL6=1 .AND. NLDEC<>1
				NLTEXTO=NLTEXTO+'UN '
			ELSE
				IF NLDEC<>1 .OR. NL6>5
					NLTEXTO=NLTEXTO+NLVECUNI[NL6]+' '
				ENDIF
			ENDIF
		ENDIF

* U-END

		IF NL2<>0
			NLTEXTO=NLTEXTO+'MIL'
			IF NL2=6
				NLTEXTO=NLTEXTO+'LON'
				IF NLCEN<>0 .OR. NLDEC<>0 .OR. NL6<>1
					NLTEXTO=NLTEXTO+'ES'
				ENDIF
			ENDIF
			NLTEXTO=NLTEXTO+' '
		ENDIF
	ENDIF
	IF NL2=1 .OR. NL2=4 .OR. NL2=7 .OR. NL2=10
		NLDEC=0
		IF NL6<>0
			IF NLCEN=1
				NLTEXTO=NLTEXTO+NLVECCEN[1]+' '
			ENDIF
			IF NL6=1
				NLDEC=1
			ELSE
				IF NL6=2
					NLDEC=2
				ELSE
					NLDEC=3
					NLTEXTO=NLTEXTO+NLVECDEC[NL6]+' '
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	IF NL2=2 .OR. NL2=5 .OR. NL2=8 .OR. NL2=11
		NLCEN=0
		IF NL6<>0
			IF NL6=1
				NLCEN=1
			ELSE
				NLCEN=3
				NLTEXTO=NLTEXTO+NLVECCEN[NL6]
				IF NL6<>5
					NLTEXTO=NLTEXTO+'CIENTOS'
				ENDIF
				NLTEXTO=NLTEXTO+' '
			ENDIF
		ENDIF
	ENDIF
	NL1=NL1+1
ENDDO
IF NLSENDEC=1
	NLTEXTO=NLTEXTO+'CON '
	IF SUBSTR(NLDECISTR,1,1)=' ' 
		NLTEXTO=NLTEXTO+'0'+SUBSTR(NLDECISTR,2,1)+'/100'
	ELSE
		NLTEXTO=NLTEXTO+NLDECISTR+'/100'
	ENDIF
ENDIF

NLINDVEC=NLLONGIT
DO WHILE NLINDVEC < LEN(NLTEXTO)
	IF SUBSTR(NLTEXTO,NLINDVEC,1)=' '
		NLINDVEC=NLINDVEC+NLLONGIT
		LOOP
	ENDIF
	NLZZ=NLINDVEC
	DO WHILE SUBSTR(NLTEXTO,NLZZ,1)<>' '
		NLZZ=NLZZ-1
	ENDDO
	IF RELLENO = 'S'
		NLTEXTO=SUBSTR(NLTEXTO,1,NLZZ)+REPL('-',NLINDVEC-NLZZ)+SUBSTR(NLTEXTO,NLZZ+1)
		NLINDVEC=NLINDVEC+NLLONGIT
	ELSE
		NLTEXTO=SUBSTR(NLTEXTO,1,NLZZ)+SPACE(NLINDVEC-NLZZ)+SUBSTR(NLTEXTO,NLZZ+1)
		NLINDVEC=NLINDVEC+NLLONGIT
	ENDIF		
ENDDO
NLSENDEC=1
RETURN


