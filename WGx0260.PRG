      PROCEDURE CreateTemp
         LOCAL SCW621S20
         SCW621S20 = ""
         IF USED( "SCW621S20" )
            SELECT SCW621S20
            SCW621S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW621S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA705OfeFD"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA150EntGr"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 2
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW621S20 = GETE('z:\temp') + '\' + SCW621S20
            ENDIF
            CREATE DBF (SCW621S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW621S20) EXCLUSIVE ALIAS SCW621S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW621S20
         THIS.GX_SfAlias = "SCW621S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06212" , @HStmt_W06212 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0260","W06212","",GX_CURSOR_TYPE_READONLY,@HStmt_W06212) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntCod], [EntGruTip], [OfeFDe], [ArtCod], [FamSubCod], [FamCod], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [OFERTA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [FamCod] >= ? and [FamSubCod] "
                  cmdbuf = cmdbuf + "  >= ? and [ArtCod] >= ? and [OfeFDe] >= ?) AND ([EntGruTip] like ?) AND ([EntCod] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfeFDe], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06212,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06212,8)
                  THISFORM.GX_DB_BindColsW06212_01 ()
                  THISFORM.GX_DB_BindParmW06212_01 ()
               ENDIF
               AuxAV21C2 = THISFORM.AV21C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06212,1,@AuxAV21C2,0)
               THISFORM.AV21C2 = AuxAV21C2
               AuxAV20C3 = THISFORM.AV20C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06212,2,@AuxAV20C3,0)
               THISFORM.AV20C3 = AuxAV20C3
               AuxAV19C4 = THISFORM.AV19C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06212,3,@AuxAV19C4,0)
               THISFORM.AV19C4 = AuxAV19C4
               AuxAV18C5 = THISFORM.AV18C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06212,4,@AuxAV18C5,0)
               THISFORM.AV18C5 = AuxAV18C5
               AuxAV17C705 = THISFORM.AV17C705
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06212,5,@AuxAV17C705,0)
               THISFORM.AV17C705 = AuxAV17C705
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06212,6,PADR( TRIM(THISFORM.AV16C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV16C150),2, '%')),0)
               AuxAV15C120 = THISFORM.AV15C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06212,7,@AuxAV15C120,0)
               THISFORM.AV15C120 = AuxAV15C120
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06212 = Gx_err
               THISFORM.GX_DB_GetW06212_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06212 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06212) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06212 = Gx_err
                  THISFORM.GX_DB_GetW06212_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06212 <> 101
               BRKVH92 = .F.
               THISFORM.A120EntCod = THISFORM.Buf_W06212_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W06212_150EntGruTip
               THISFORM.A705OfeFDe = THISFORM.Buf_W06212_705OfeFDe
               THISFORM.A5ArtCod = THISFORM.Buf_W06212_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W06212_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W06212_3FamCod
               THISFORM.A2EmpCod = THISFORM.Buf_W06212_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VH92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06212 = Gx_err
               THISFORM.GX_DB_GetW06212_01 ()
            ENDDO
         ENDIF
      ENDPROC
