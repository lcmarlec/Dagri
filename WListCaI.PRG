      PROCEDURE CreateTemp
         LOCAL SCW805S11
         SCW805S11 = ""
         IF USED( "SCW805S11" )
            SELECT SCW805S11
            SCW805S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW805S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "VAV15Impri"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 1
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1664CamP"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW805S11 = GETE('z:\temp') + '\' + SCW805S11
            ENDIF
            CREATE DBF (SCW805S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW805S11) EXCLUSIVE ALIAS SCW805S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW805S11
         THIS.GX_SfAlias = "SCW805S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08052" , @HStmt_W08052 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLISTCAI","W08052","",GX_CURSOR_TYPE_READONLY,@HStmt_W08052) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CamPat] FROM [CAMION] (NOLOCK) ORDER BY [EmpCod], [CamPat]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08052,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08052,12)
                  THISFORM.GX_DB_BindColsW08052_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08052 = Gx_err
               THISFORM.GX_DB_GetW08052_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08052 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08052) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08052 = Gx_err
                  THISFORM.GX_DB_GetW08052_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08052 <> 101
               BRKVMD2 = .F.
               THISFORM.AV15Imprim = SPACE(1)
               THISFORM.A1664CamPa = THISFORM.Buf_W08052_1664CamPat
               GX_SFLOAD = 0
               THISFORM.U15VMD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08052 = Gx_err
               THISFORM.GX_DB_GetW08052_01 ()
            ENDDO
         ENDIF
      ENDPROC
