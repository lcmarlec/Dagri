      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "Salir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12V9U2()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16V9U2()
            RETURN .T.
         ENDIF
         IF UPPER( "SkDesdePrv" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14V9U2()
            RETURN .T.
         ENDIF
         IF UPPER( "SkPrvhas" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15V9U2()
            RETURN .T.
         ENDIF
         IF UPPER( "Imprimir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13V9U2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_FIRST"
            THISFORM.DoFirst
