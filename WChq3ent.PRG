      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00162" , @HStmt_W00162 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCHQ3ENT","W00162","",GX_CURSOR_TYPE_READONLY,@HStmt_W00162) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ChqMonCod] AS ChqMonCod, T1.[ChqEst], T1.[ChqCta], T1.[ChqTip], T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[ChqNroI], T1.[ChqLin], T1.[ChqImpreso], T1.[ChqNoO], T1.[ChqImp], T2.[MonSim] "
                  cmdbuf = cmdbuf + "  AS ChqMonSim, T1.[ChqFchDeb], T1.[ChqNro], T1.[ChqSuc], T3.[BcoDsc] AS ChqBcoDsc, "
                  cmdbuf = cmdbuf + "  T1.[ChqBcoCod] AS ChqBcoCod, T1.[ChqNroReg] FROM (([CHQS] T1 (NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [MONEDA] T2 (NOLOCK) ON T2.[Moncod] = T1.[ChqMonCod]) LEFT JOIN [BANCOS] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[BcoCod] = T1.[ChqBcoCod]) WHERE (T1.[EmpCod] = ? and T1.[ChqTip] = ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[ChqEst] = 1) AND (T1.[ChqNoO] <> 'X' or ? = 'D') AND (T1.[ChqFchDeb] >= ?) "
                  cmdbuf = cmdbuf + "  AND (T1.[ChqNroReg] >= ?) AND (T1.[ChqImpreso] < 9 or ? = 'D') ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[ChqTip], T1.[ChqCta], T1.[ChqEst], T1.[ChqFchDeb]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00162,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00162,13)
                  THISFORM.GX_DB_BindColsW00162_01 ()
                  THISFORM.GX_DB_BindParmW00162_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00162,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV22Chqtip = THISFORM.AV22Chqtip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00162,2,AuxAV22Chqtip,1,0)
               THISFORM.AV22Chqtip = AuxAV22Chqtip
               AuxAV19Para = THISFORM.AV19Para
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00162,3,AuxAV19Para,1,0)
               THISFORM.AV19Para = AuxAV19Para
               AuxAV21Desfch = THISFORM.AV21Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00162,4,@AuxAV21Desfch,0)
               THISFORM.AV21Desfch = AuxAV21Desfch
               AuxAV12Desde = THISFORM.AV12Desde
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00162,5,@AuxAV12Desde,0)
               THISFORM.AV12Desde = AuxAV12Desde
               AuxAV19Para = THISFORM.AV19Para
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00162,6,AuxAV19Para,1,0)
               THISFORM.AV19Para = AuxAV19Para
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00162 = Gx_err
               THISFORM.GX_DB_GetW00162_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00162 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00162) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00162 = Gx_err
                  THISFORM.GX_DB_GetW00162_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00162 <> 101
               BRKV0G2 = .F.
               THISFORM.AV13Sel = SPACE(1)
               THISFORM.A146ChqMon = THISFORM.Buf_W00162_146ChqMonCod
               THISFORM.A136ChqEst = THISFORM.Buf_W00162_136ChqEst
               THISFORM.A124ChqCta = THISFORM.Buf_W00162_124ChqCta
               THISFORM.A123ChqTip = THISFORM.Buf_W00162_123ChqTip
               THISFORM.A2EmpCod = THISFORM.Buf_W00162_2EmpCod
               THISFORM.A121ChqNro = THISFORM.Buf_W00162_121ChqNroI
               THISFORM.A122ChqLin = THISFORM.Buf_W00162_122ChqLin
               THISFORM.A1733ChqIm = THISFORM.Buf_W00162_1733ChqImpreso
               THISFORM.A145ChqNoO = THISFORM.Buf_W00162_145ChqNoO
               THISFORM.A131ChqImp = THISFORM.Buf_W00162_131ChqImp
               THISFORM.A148ChqMon = THISFORM.Buf_W00162_148ChqMonSim
               THISFORM.A132ChqFch = THISFORM.Buf_W00162_132ChqFchDeb
               THISFORM.A129ChqNro = THISFORM.Buf_W00162_129ChqNro
               THISFORM.A128ChqSuc = THISFORM.Buf_W00162_128ChqSuc
               THISFORM.A127ChqBco = THISFORM.Buf_W00162_127ChqBcoDsc
               THISFORM.A126ChqBco = THISFORM.Buf_W00162_126ChqBcoCod
               THISFORM.A137ChqNro = THISFORM.Buf_W00162_137ChqNroReg
               THISFORM.A148ChqMon = THISFORM.Buf_W00162_148ChqMonSim
               THISFORM.A127ChqBco = THISFORM.Buf_W00162_127ChqBcoDsc
               GX_SFLOAD = 0
               THISFORM.U14V0G2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00162 = Gx_err
               THISFORM.GX_DB_GetW00162_01 ()
            ENDDO
         ENDIF
