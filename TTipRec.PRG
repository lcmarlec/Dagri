               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01495) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01495 = Gx_err
