            THISFORM.T01492 = Gx_err
            THISFORM.GX_DB_GetT01492_01 ()
            IF .NOT. THISFORM.T01492 <> 103
               DO GX_ERRMW WITH "TIPREC reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01492 = 101 .OR. THISFORM.Z1491TReDs <> THISFORM.Buf_T01492_1491TReDsc
               DO GX_ERRMW WITH "TIPREC fue modificada."
               RETURN .F.
