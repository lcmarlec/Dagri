               THISFORM.T01496 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01496) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T01496 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01497" , @HStmt_T01497 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTIPREC","T01497","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01497) ,  ,  ,  , CS_SQLSRV , 0 )
