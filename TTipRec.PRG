                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01497,cmdbuf)
                  THISFORM.GX_DB_BindParmT01497_01 ()
               ENDIF
               AuxA1491TReDs = THISFORM.A1491TReDs
