               THISFORM.T01497 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01497) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01498" , @HStmt_T01498 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTIPREC","T01498","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01498) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [TIPREC]  WHERE [EmpCod] = ? AND [TReCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01498,cmdbuf)
                  THISFORM.GX_DB_BindParmT01498_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01498,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1490TReCo = THISFORM.A1490TReCo
               Gx_err = GX_DB_SetLong( HStmt_T01498,2,@AuxA1490TReCo,0)
               THISFORM.A1490TReCo = AuxA1490TReCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01498) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01498 = Gx_err
               THISFORM.T01492 = iif( THISFORM.T01498 = 0 , 104 , THISFORM.T01498 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01498) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A1490TReCo , 6 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "CALL" , Aux1 , "TRECL" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT149V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 170 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
