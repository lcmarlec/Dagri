               ENDDO
               THISFORM.T01495 = Gx_err
               THISFORM.GX_DB_GetT01495_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2EmpCod = THISFORM.Buf_T01495_2EmpCod
               THISFORM.A1490TReCo = THISFORM.Buf_T01495_1490TReCod
               THISFORM.A1491TReDs = THISFORM.Buf_T01495_1491TReDsc
         ENDCASE
         Gx_fcond = THISFORM.T01495 <> 101 .AND. THISFORM.T01495 <> 101
