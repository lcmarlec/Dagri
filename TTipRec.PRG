               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01495) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01495 = Gx_err
               THISFORM.GX_DB_GetT01495_01 ()
               DO WHILE THISFORM.T01495 = 0
                  THISFORM.A2EmpCod = THISFORM.Buf_T01495_2EmpCod
                  THISFORM.A1490TReCo = THISFORM.Buf_T01495_1490TReCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T01495) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T01495 = Gx_err
