               Gx_fcond = THISFORM.T01495 <> 101
            CASE GXOP = 2 && Next record
               M1490TReCo = THISFORM.A1490TReCo
               THISFORM.A1490TReCo = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01495,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1490TReCo = THISFORM.A1490TReCo
               Gx_err = GX_DB_SetLong( HStmt_T01495,2,@AuxA1490TReCo,0)
               THISFORM.A1490TReCo = AuxA1490TReCo
