            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTIPREC","T01495","",GX_CURSOR_TYPE_READONLY,@HStmt_T01495) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [TReCod], [TReDsc] FROM [TIPREC] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  >= ? and [TReCod] >= ? ORDER BY [EmpCod], [TReCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01495,cmdbuf)
