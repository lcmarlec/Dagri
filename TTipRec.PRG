                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01496,cmdbuf)
                  THISFORM.GX_DB_BindParmT01496_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01496,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
