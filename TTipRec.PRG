            THISFORM.GX_DB_BindColsT01495_01 ()
            THISFORM.GX_DB_BindParmT01495_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2EmpCod = 0
                  THISFORM.A1490TReCo = 0
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
