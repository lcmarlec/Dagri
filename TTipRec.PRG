               THISFORM.A1490TReCo = M1490TReCo
               DO WHILE THISFORM.T01495 = 0 .AND. THISFORM.A2EmpCod >= THISFORM.Buf_T01495_2EmpCod .AND. THISFORM.A1490TReCo >= THISFORM.Buf_T01495_1490TReCod
