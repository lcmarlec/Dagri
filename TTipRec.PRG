                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T01495) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T01495 = Gx_err
                  THISFORM.GX_DB_GetT01495_01 ()
               ENDDO
               Gx_fcond = THISFORM.T01495 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2EmpCod = 0
               THISFORM.A1490TReCo = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01495,1,@AuxA2EmpCod,0)
