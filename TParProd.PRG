         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3365PPFch = THISFORM.A3365PPFch .AND. S3366PPVer = THISFORM.A3366PPVer .AND. S3369PPID = THISFORM.A3369PPID .AND. S3378PPTer = THISFORM.A3378PPTer
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT360S58 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT360S58 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3365PPFch = THISFORM.A3365PPFch .AND. S3366PPVer = THISFORM.A3366PPVer .AND. S3369PPID = THISFORM.A3369PPID .AND. S3378PPTer = THISFORM.A3378PPTer
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT360S58 .Refresh()
               THISFORM. cCT360S58 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3365PPFch = S3365PPFch
               THISFORM.A3366PPVer = S3366PPVer
               THISFORM.A3369PPID = S3369PPID
               THISFORM.A3378PPTer = S3378PPTer
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT360S58 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT360S58 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3365PPFch = THISFORM.A3365PPFch .AND. S3366PPVer = THISFORM.A3366PPVer .AND. S3369PPID = THISFORM.A3369PPID .AND. S3378PPTer = THISFORM.A3378PPTer
