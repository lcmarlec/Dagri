      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T036023" , @HStmt_T036023 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPARPROD","T036023","",GX_CURSOR_TYPE_READONLY,@HStmt_T036023) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [PPFch], [PPVer], [PPID], [PPTerFH], [PPTerCnt], [PPTerUsu], [PPTerTurno], "
                  cmdbuf = cmdbuf + "  [PPTerCie], [RINroInt] FROM [PARPROD2] (NOLOCK) WHERE [EmpCod] = ? AND [PPFch] = "
                  cmdbuf = cmdbuf + "  ? AND [PPVer] = ? AND [PPID] = ? ORDER BY [EmpCod], [PPFch], [PPVer], [PPID], [PPTerFH] "
                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T036023,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T036023,9)
                  THISFORM.GX_DB_BindColsT036023_01 ()
                  THISFORM.GX_DB_BindParmT036023_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T036023,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3365PPFch = THISFORM.A3365PPFch
               Gx_err = GX_DB_SetDate( HStmt_T036023,2,@AuxA3365PPFch,0)
               THISFORM.A3365PPFch = AuxA3365PPFch
               AuxA3366PPVer = THISFORM.A3366PPVer
               Gx_err = GX_DB_SetInt( HStmt_T036023,3,@AuxA3366PPVer,0)
               THISFORM.A3366PPVer = AuxA3366PPVer
               AuxA3369PPID = THISFORM.A3369PPID
               Gx_err = GX_DB_SetInt( HStmt_T036023,4,@AuxA3369PPID,0)
               THISFORM.A3369PPID = AuxA3369PPID
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T036023) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T036023 = Gx_err
               THISFORM.GX_DB_GetT036023_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T036023 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T036023) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T036023 = Gx_err
                  THISFORM.GX_DB_GetT036023_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T036023 <> 101
               BRKA0386 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT360S58.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T036023) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T036023 = Gx_err
               THISFORM.GX_DB_GetT036023_01 ()
            ENDDO
         ENDIF
      ENDPROC
