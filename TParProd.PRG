         * Search in Sub-File
         SELECT (THISFORM. cCT360S58 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT360S58 .SF( 8, @sf_err)     && GO TOP
