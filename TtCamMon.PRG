               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T014319_1103tECHNroInt = THISFORM.A1103tECHN .AND. THISFORM.Buf_T014319_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T014319) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T014319 = Gx_err
               THISFORM.GX_DB_GetT014319_01 ()
            ENDDO
         ENDIF
