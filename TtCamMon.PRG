      PROCEDURE CreateTemp
         LOCAL SCT143S25
         SCT143S25 = ""
         IF USED( "SCT143S25" )
            SELECT SCT143S25
            SCT143S25 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT143S25
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1118tEch"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1119tEch"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1120tEch"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT143S25 = GETE('z:\temp') + '\' + SCT143S25
            ENDIF
            CREATE DBF (SCT143S25) FROM ARRAY GX_STRUCT
            USE
            USE (SCT143S25) EXCLUSIVE ALIAS SCT143S25
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT143S25
         THIS.GX_SfAlias = "SCT143S25"
      ENDPROC
