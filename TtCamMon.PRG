      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T014319" , @HStmt_T014319 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTCAMMON","T014319","",GX_CURSOR_TYPE_READONLY,@HStmt_T014319) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [tECHNroInt], [tEchMonCod] AS tEchMonCod, [tEchMOnImp], [tEchMonCot], "
                  cmdbuf = cmdbuf + "  [tEchMonEgr] FROM [TENCHE] (NOLOCK) WHERE [EmpCod] = ? AND [tECHNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [tECHNroInt], [tEchMonCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T014319,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T014319,10)
                  THISFORM.GX_DB_BindColsT014319_01 ()
                  THISFORM.GX_DB_BindParmT014319_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T014319,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1103tECHN = THISFORM.A1103tECHN
               Gx_err = GX_DB_SetDouble( HStmt_T014319,2,@AuxA1103tECHN,0)
               THISFORM.A1103tECHN = AuxA1103tECHN
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T014319) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T014319 = Gx_err
               THISFORM.GX_DB_GetT014319_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T014319 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T014319) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T014319 = Gx_err
                  THISFORM.GX_DB_GetT014319_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T014319 <> 101
               BRK3Z144 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT143Tb16.cCT143Pg17Tb16.cCT143S18.Columns(1).Ctrl1 .LoadObj(2)
