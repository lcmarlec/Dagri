      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA1747EntF WITH gxDtTtoC(THISFORM.A1747EntFc,8,5)
         REPLACE sA1749EntO WITH THISFORM.A1749EntOb
         REPLACE VAV15Entob WITH THISFORM.AV15Entobs
         REPLACE sA1746EntN WITH THISFORM.A1746EntNr
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A1747EntFc = GXDTCTOT(sA1747EntF)
         THISFORM.A1749EntOb = sA1749EntO
         THISFORM.AV15Entobs = VAV15Entob
         THISFORM.A1746EntNr = sA1746EntN
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 3
            THISFORM.AV15Entobs = THIS.Column3.Ctrl1.Value
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A1747EntFc = CTOT("  /  /  ")
         THISFORM.A1749EntOb = SPACE(10)
         THISFORM.AV15Entobs = SPACE(60)
         THISFORM.A1746EntNr = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
