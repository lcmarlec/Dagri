         THISFORM.A1748EntOb = Gx_lvchar_to_char( THISFORM.Buf_W05782_1748EntObsV )
         THISFORM.A1746EntNr = THISFORM.Buf_W05782_1746EntNroI
         THISFORM.A1749EntOb = THISFORM.Buf_W05782_1749EntObsusu
         THISFORM.A1747EntFc = THISFORM.Buf_W05782_1747EntFchHor
