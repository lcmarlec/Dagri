               THISFORM.AV19Pgmnam = "WOPedido"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01032 = Gx_err
                  THISFORM.GX_DB_GetW01032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01032 <> 101
               BRKV2V2 = .F.
               THISFORM.A740OpeCpr = THISFORM.Buf_W01032_740OpeCprGRT
               THISFORM.A736OpeLin = THISFORM.Buf_W01032_736OpeLin
               THISFORM.A732OPeSuc = THISFORM.Buf_W01032_732OPeSuc
               THISFORM.A701OPeNro = THISFORM.Buf_W01032_701OPeNro
               THISFORM.A735OpeEst = THISFORM.Buf_W01032_735OpeEst
               THISFORM.A733OpeFch = THISFORM.Buf_W01032_733OpeFch
               THISFORM.A744OpeOCo = THISFORM.Buf_W01032_744OpeOCoNro
               THISFORM.A743OpeOCo = THISFORM.Buf_W01032_743OpeOCoSuc
               THISFORM.A742OpeCpr = THISFORM.Buf_W01032_742OpeCprNom
               THISFORM.A741OpeCpr = THISFORM.Buf_W01032_741OpeCprCod
               THISFORM.A739OpeLEs = THISFORM.Buf_W01032_739OpeLEs
               THISFORM.A738OpeFEn = THISFORM.Buf_W01032_738OpeFEn
               THISFORM.A737OpeCnt = THISFORM.Buf_W01032_737OpeCnt
               THISFORM.A6ArtDsc = THISFORM.Buf_W01032_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W01032_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01032_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01032_3FamCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W01032_6ArtDsc
               THISFORM.A742OpeCpr = THISFORM.Buf_W01032_742OpeCprNom
               THISFORM.A732OPeSuc = THISFORM.Buf_W01032_732OPeSuc
               THISFORM.A701OPeNro = THISFORM.Buf_W01032_701OPeNro
               THISFORM.A735OpeEst = THISFORM.Buf_W01032_735OpeEst
               THISFORM.A733OpeFch = THISFORM.Buf_W01032_733OpeFch
               GX_SFLOAD = 0
               THISFORM.U18V2V2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01032 = Gx_err
               THISFORM.GX_DB_GetW01032_01 ()
            ENDDO
         ENDIF
      ENDPROC
