                  cmdbuf = cmdbuf + "  ON T4.[EmpCod] = T1.[EmpCod] AND T4.[OpeNroInt] = T1.[OpeNroInt]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OpeNroInt] = ? ORDER BY T1.[EmpCod], T1.[OpeNroInt]  "
