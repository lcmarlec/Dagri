               Gx_err = GX_DB_SetStr( HStmt_T03396,6,AuxA3235NroPa,13,0)
               THISFORM.A3235NroPa = AuxA3235NroPa
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03396) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03396 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03396) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03397" , @HStmt_T03397 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSCITEMS","T03397","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03397) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ItemsEmbarques]  WHERE [NroPed] = ? AND [NroPallet] = ? "
