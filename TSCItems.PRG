               Gx_err = GX_DB_SetStr( HStmt_T03396,4,AuxA3239Items,20,0)
               THISFORM.A3239Items = AuxA3239Items
               AuxA3234NroPe = THISFORM.A3234NroPe
               Gx_err = GX_DB_SetStr( HStmt_T03396,5,AuxA3234NroPe,17,0)
               THISFORM.A3234NroPe = AuxA3234NroPe
