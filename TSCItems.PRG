                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSCITEMS","T03396","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03396) ,  ,  ,  , CS_SQLSRV , 0 )
