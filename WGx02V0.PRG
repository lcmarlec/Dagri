               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08482,7,@AuxAV11C3439,0)
               THISFORM.AV11C3439 = AuxAV11C3439
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08482) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08482 = Gx_err
               THISFORM.GX_DB_GetW08482_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08482 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08482) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08482 = Gx_err
                  THISFORM.GX_DB_GetW08482_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08482 <> 101
               BRKVNK2 = .F.
               THISFORM.A956RetImp = THISFORM.Buf_W08482_956RetImpImp
               THISFORM.A957RetSig = THISFORM.Buf_W08482_957RetSig
               THISFORM.A3439RetIm = THISFORM.Buf_W08482_3439RetImpBas
               THISFORM.A951RetNro = THISFORM.Buf_W08482_951RetNroIImp
               THISFORM.A950RetNro = THISFORM.Buf_W08482_950RetNroLin
               THISFORM.A937RetNro = THISFORM.Buf_W08482_937RetNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W08482_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VNK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08482) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08482 = Gx_err
               THISFORM.GX_DB_GetW08482_01 ()
            ENDDO
         ENDIF
      ENDPROC
