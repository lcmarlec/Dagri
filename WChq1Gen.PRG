                  THISFORM.AV5Fechasi = Aux1
                  THISFORM.AV23Ctacod = Aux2
                  THISFORM.AV20Nrodeb = Aux3
                  GX_rploop = .T.
               ENDIF
               THISFORM.AV20Nrodeb = 0
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV7Emprcod
               Aux1 = THISFORM.AV5Fechasi
               Aux2 = THISFORM.AV23Ctacod
               Aux3 = THISFORM.AV20Nrodeb
               DO WTalChqS WITH Aux0 , Aux1 , Aux2 , Aux3
