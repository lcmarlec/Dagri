               THISFORM.AV5Fechasi = Aux1
               THISFORM.AV23Ctacod = Aux2
               THISFORM.AV20Nrodeb = Aux3
               GX_rploop = .T.
               IF THISFORM.AV20Nrodeb = 0
                  THISFORM.Refresh()
                  DO GX_ERRMW WITH "No hay Nros. de Cheque Disponibles"
                  THISFORM.cCW15V23.GXSetFocus( )
               ENDIF
            ENDIF
