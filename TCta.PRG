            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00192) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00192 = Gx_err
            THISFORM.GX_DB_GetT00192_01 ()
            IF .NOT. THISFORM.T00192 <> 103
               DO GX_ERRMW WITH "CTA00 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00192 = 101 .OR. THISFORM.Z216CtaCon <> THISFORM.Buf_T00192_216CtaConNro
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z200CtaDes <> THISFORM.Buf_T00192_200CtaDes
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z205CtaNro <> THISFORM.Buf_T00192_205CtaNroAso
               DO GX_ERRMW WITH "CTA00 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
