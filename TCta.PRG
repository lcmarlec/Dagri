                  cmdbuf = cmdbuf + "  ?, ?, ?, ?, ' ', ' ') "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00197,cmdbuf)
                  THISFORM.GX_DB_BindParmT00197_01 ()
               ENDIF
               AuxA198PCtaNr = THISFORM.A198PCtaNr
               Gx_err = GX_DB_SetInt( HStmt_T00197,1,@AuxA198PCtaNr,0)
               THISFORM.A198PCtaNr = AuxA198PCtaNr
               AuxA2EmpCod = THISFORM.A2EmpCod
