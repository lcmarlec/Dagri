      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A207CtaDat = DATE()
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A208CtaTim = SUBSTR(TIME(), 1, 8)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A209CtaWrk = GXWrkSt(128)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A206CtaUsu = THISFORM.AV17Usuari
               ENDIF
               IF .T. .AND. val( THISFORM.A216CtaCon ) = 0
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A215PCtaGr
                  Aux1 = THISFORM.A198PCtaNr
                  Aux2 = THISFORM.A2EmpCod
                  Aux3 = THISFORM.A199CtaNro
                  DO PCreaCt WITH Aux0 , Aux1 , Aux2 , Aux3
                  THISFORM.A215PCtaGr = Aux0
                  THISFORM.A198PCtaNr = Aux1
                  THISFORM.A2EmpCod = Aux2
                  THISFORM.A199CtaNro = Aux3
                  THISFORM. cCT19A199 .Refresh()
               ENDIF
            CASE gxmode = "UPD"   && After update
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A207CtaDat = DATE()
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A208CtaTim = SUBSTR(TIME(), 1, 8)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A209CtaWrk = GXWrkSt(128)
               ENDIF
               IF .T. .OR. .T. .OR. ( THISFORM.Gx_mode = 'DLT' .AND. .T. )
                  THISFORM.A206CtaUsu = THISFORM.AV17Usuari
               ENDIF
            CASE gxmode = "DLT"   && After delete
