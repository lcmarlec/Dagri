               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA199CtaNro = THISFORM.A199CtaNro
               Gx_err = GX_DB_SetStr( HStmt_T00197,3,AuxA199CtaNro,12,0)
               THISFORM.A199CtaNro = AuxA199CtaNro
               AuxA216CtaCon = THISFORM.A216CtaCon
               Gx_err = GX_DB_SetStr( HStmt_T00197,4,AuxA216CtaCon,12,0)
               THISFORM.A216CtaCon = AuxA216CtaCon
               AuxA207CtaDat = THISFORM.A207CtaDat
               Gx_err = GX_DB_SetDate( HStmt_T00197,5,@AuxA207CtaDat,0)
               THISFORM.A207CtaDat = AuxA207CtaDat
