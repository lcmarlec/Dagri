      ***********************
      PROCEDURE cCW76V12.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW76V12.ISVALID" )
         THISFORM.AV40GXLvl3 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00763" , @HStmt_W00763 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLISDCC","W00763","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00763) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntEsp], [EntRaz] FROM [ENTID] (NOLOCK) "
