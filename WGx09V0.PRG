      PROCEDURE CreateTemp
         LOCAL SCW1035S14
         SCW1035S14 = ""
         IF USED( "SCW1035S14" )
            SELECT SCW1035S14
            SCW1035S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1035S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA3070CDCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3071CdTi"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3079CdSe"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1035S14 = GETE('z:\temp') + '\' + SCW1035S14
            ENDIF
            CREATE DBF (SCW1035S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1035S14) EXCLUSIVE ALIAS SCW1035S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1035S14
         THIS.GX_SfAlias = "SCW1035S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10352" , @HStmt_W10352 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09V0","W10352","",GX_CURSOR_TYPE_READONLY,@HStmt_W10352) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CdDesc], [CdSerie], [CdTipRed], [CDCod] FROM [CDCOMP] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([CDCod] >= ?) AND ([CdTipRed] like ?) AND ([CdDesc] like ?) AND ([CdSerie] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [CDCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10352,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10352,9)
                  THISFORM.GX_DB_BindColsW10352_01 ()
                  THISFORM.GX_DB_BindParmW10352_01 ()
               ENDIF
               AuxAV5C3070 = THISFORM.AV5C3070
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10352,1,@AuxAV5C3070,0)
               THISFORM.AV5C3070 = AuxAV5C3070
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10352,2,PADR( TRIM(THISFORM.AV6C3071),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C3071),2, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10352,3,PADR( TRIM(THISFORM.AV7C3072),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C3072),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10352,4,PADR( TRIM(THISFORM.AV8C3079),1, '%'),LEN(PADR( TRIM(THISFORM.AV8C3079),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10352) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10352 = Gx_err
               THISFORM.GX_DB_GetW10352_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10352 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10352) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10352 = Gx_err
                  THISFORM.GX_DB_GetW10352_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10352 <> 101
               BRKVSR2 = .F.
               THISFORM.A3072CdDes = THISFORM.Buf_W10352_3072CdDesc
               THISFORM.A3079CdSer = THISFORM.Buf_W10352_3079CdSerie
               THISFORM.A3071CdTip = THISFORM.Buf_W10352_3071CdTipRed
               THISFORM.A3070CDCod = THISFORM.Buf_W10352_3070CDCod
               GX_SFLOAD = 0
               THISFORM.U12VSR2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10352) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10352 = Gx_err
               THISFORM.GX_DB_GetW10352_01 ()
            ENDDO
         ENDIF
      ENDPROC
