      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. GX_1Lvl_mode = PGx_mode
         THISFORM. Gx_mode = PGx_mode
         THISFORM. AV20Entlgc = PAV20Entlgc
         THISFORM. AV8Emprcod = PAV8Emprcod
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV17Usuari = PAV17Usuari
         THISFORM. A2EmpCod = PA2EmpCod
         THISFORM. A150EntGru = PA150EntGru
         THISFORM. A120EntCod = PA120EntCod
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02902" , @HStmt_T02902 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02902","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02902) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntLgCod], [EntLgIBTuc], [EntLgFVt], [EntLgCIvCo] "
            cmdbuf = cmdbuf + "  AS EntLgCIvCo, [EntLgIBRet], [EntLgDsc], [EntLgDom], [EntLgPos], [EntLgPaiCo] AS "
            cmdbuf = cmdbuf + "  EntLgPaiCo, [EntLgPciCo] AS EntLgPciCo, [Entlgloc], [EntLgCont], [EntLgTel], [EntLgOrden], "
            cmdbuf = cmdbuf + "  [EntLgGrpOf], [EntLgInhab], [entLgInhMo], [EntLgEan], [EntLgVdrCo] AS EntLgVdrCo "
            cmdbuf = cmdbuf + "  FROM [CLTES] (UPDLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? AND "
            cmdbuf = cmdbuf + "  [EntLgCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02902,cmdbuf)
            THISFORM.GX_DB_BindColsT02902_01 ()
            THISFORM.GX_DB_BindParmT02902_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02903" , @HStmt_T02903 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02903","",GX_CURSOR_TYPE_READONLY,@HStmt_T02903) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntLgCod], [EntLgIBTuc], [EntLgFVt], [EntLgCIvCo] "
            cmdbuf = cmdbuf + "  AS EntLgCIvCo, [EntLgIBRet], [EntLgDsc], [EntLgDom], [EntLgPos], [EntLgPaiCo] AS "
            cmdbuf = cmdbuf + "  EntLgPaiCo, [EntLgPciCo] AS EntLgPciCo, [Entlgloc], [EntLgCont], [EntLgTel], [EntLgOrden], "
            cmdbuf = cmdbuf + "  [EntLgGrpOf], [EntLgInhab], [entLgInhMo], [EntLgEan], [EntLgVdrCo] AS EntLgVdrCo "
            cmdbuf = cmdbuf + "  FROM [CLTES] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? AND "
            cmdbuf = cmdbuf + "  [EntLgCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02903,cmdbuf)
            THISFORM.GX_DB_BindColsT02903_01 ()
            THISFORM.GX_DB_BindParmT02903_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02904" , @HStmt_T02904 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02904","",GX_CURSOR_TYPE_READONLY,@HStmt_T02904) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EntRaz], [EntPos], [EntLocDsc], [EntFVt], [EntCIvCod], [EntIBRet] FROM [ENTID] "
            cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02904,cmdbuf)
            THISFORM.GX_DB_BindColsT02904_01 ()
            THISFORM.GX_DB_BindParmT02904_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02905" , @HStmt_T02905 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02905","",GX_CURSOR_TYPE_READONLY,@HStmt_T02905) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [VdrNom] AS EntLgVdrNo FROM [VEND] (NOLOCK) WHERE [EmpCod] = ? AND [VdrCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02905,cmdbuf)
            THISFORM.GX_DB_BindColsT02905_01 ()
            THISFORM.GX_DB_BindParmT02905_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02906" , @HStmt_T02906 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02906","",GX_CURSOR_TYPE_READONLY,@HStmt_T02906) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [PciDsc] AS EntLgPciDs FROM [Pcias] (NOLOCK) WHERE [PaiCod] = ? AND [PciCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02906,cmdbuf)
            THISFORM.GX_DB_BindColsT02906_01 ()
            THISFORM.GX_DB_BindParmT02906_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02907" , @HStmt_T02907 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02907","",GX_CURSOR_TYPE_READONLY,@HStmt_T02907) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [CIvDsc] AS EntLgCIvDs FROM [CATIVA] (NOLOCK) WHERE [CIvCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02907,cmdbuf)
            THISFORM.GX_DB_BindColsT02907_01 ()
            THISFORM.GX_DB_BindParmT02907_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02908" , @HStmt_T02908 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTSUC1","T02908","",GX_CURSOR_TYPE_READONLY,@HStmt_T02908) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EntLgGrpNo] FROM [CLTEGRP] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = "
            cmdbuf = cmdbuf + "  ? AND [EntCod] = ? AND [EntLgGrpOf] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02908,cmdbuf)
            THISFORM.GX_DB_BindColsT02908_01 ()
            THISFORM.GX_DB_BindParmT02908_01 ()
         ENDIF
         GXTB.ShowMode()
