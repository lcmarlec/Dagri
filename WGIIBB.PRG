      PROCEDURE CreateTemp
         LOCAL SCW580S17
         SCW580S17 = ""
         IF USED( "SCW580S17" )
            SELECT SCW580S17
            SCW580S17 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW580S17
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA1751IIBM"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1750IIBA"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1767IIBV"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 14
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA1768IIBV"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 14
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW580S17 = GETE('z:\temp') + '\' + SCW580S17
            ENDIF
            CREATE DBF (SCW580S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCW580S17) EXCLUSIVE ALIAS SCW580S17
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW580S17
         THIS.GX_SfAlias = "SCW580S17"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05802" , @HStmt_W05802 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGIIBB","W05802","",GX_CURSOR_TYPE_READONLY,@HStmt_W05802) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [IIBVtB], [IIBVtT], [IIBAno], [IIBMes] FROM [IIBB] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ?) AND ([IIBAno] * 100 + [IIBMes] >= ? * 100 + ?) ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [IIBAno], [IIBMes]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05802,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05802,13)
                  THISFORM.GX_DB_BindColsW05802_01 ()
                  THISFORM.GX_DB_BindParmW05802_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05802,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Iibano = THISFORM.AV21Iibano
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05802,2,@AuxAV21Iibano,0)
               THISFORM.AV21Iibano = AuxAV21Iibano
               AuxAV22Iibmes = THISFORM.AV22Iibmes
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05802,3,@AuxAV22Iibmes,0)
               THISFORM.AV22Iibmes = AuxAV22Iibmes
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05802 = Gx_err
               THISFORM.GX_DB_GetW05802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WGIIBB"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05802 = Gx_err
                  THISFORM.GX_DB_GetW05802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05802 <> 101
               BRKVG42 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W05802_2EmpCod
               THISFORM.A1768IIBVt = THISFORM.Buf_W05802_1768IIBVtB
               THISFORM.A1767IIBVt = THISFORM.Buf_W05802_1767IIBVtT
               THISFORM.A1750IIBAn = THISFORM.Buf_W05802_1750IIBAno
               THISFORM.A1751IIBMe = THISFORM.Buf_W05802_1751IIBMes
               GX_SFLOAD = 0
               THISFORM.U18VG42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05802 = Gx_err
               THISFORM.GX_DB_GetW05802_01 ()
            ENDDO
         ENDIF
      ENDPROC
