            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03178" , @HStmt_T03178 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCPAGOS","T03178","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03178) ,  ,  ,  , CS_SQLSRV , 0 )
