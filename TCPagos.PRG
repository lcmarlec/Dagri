               THISFORM.A3021CPaDs = AuxA3021CPaDs
               AuxA3314CpaDs = THISFORM.A3314CpaDs
               Gx_err = GX_DB_SetStr( HStmt_T03177,2,AuxA3314CpaDs,40,0)
