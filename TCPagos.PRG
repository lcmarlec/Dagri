               AuxA3020CPaCo = THISFORM.A3020CPaCo
               Gx_err = GX_DB_SetInt( HStmt_T03177,4,@AuxA3020CPaCo,0)
               THISFORM.A3020CPaCo = AuxA3020CPaCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03177) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03177 = Gx_err
