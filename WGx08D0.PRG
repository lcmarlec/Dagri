      PROCEDURE CreateTemp
         LOCAL SCW868S20
         SCW868S20 = ""
         IF USED( "SCW868S20" )
            SELECT SCW868S20
            SCW868S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW868S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2617ReIR"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 1
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2616ReIN"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2642ReIT"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2643ReIS"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW868S20 = GETE('z:\temp') + '\' + SCW868S20
            ENDIF
            CREATE DBF (SCW868S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW868S20) EXCLUSIVE ALIAS SCW868S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW868S20
         THIS.GX_SfAlias = "SCW868S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08682" , @HStmt_W08682 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX08D0","W08682","",GX_CURSOR_TYPE_READONLY,@HStmt_W08682) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ReINroDoc], [ReISuc], [ReISer], [ReITpo], [ReINroI], [ReIRoI], [EmpCod] FROM "
                  cmdbuf = cmdbuf + "  [REINCID1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([ReIRoI] like ?) AND "
                  cmdbuf = cmdbuf + "  ([ReINroI] >= ?) AND ([ReITpo] like ?) AND ([ReISer] like ?) AND ([ReISuc] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([ReINroDoc] >= ?) ORDER BY [EmpCod], [ReIRoI], [ReINroI], [ReITpo], [ReISer], "
                  cmdbuf = cmdbuf + "  [ReISuc], [ReINroDoc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08682,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08682,9)
                  THISFORM.GX_DB_BindColsW08682_01 ()
                  THISFORM.GX_DB_BindParmW08682_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08682,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08682,2,PADR( TRIM(THISFORM.AV6C2617),1, '%'),LEN(PADR( TRIM(THISFORM.AV6C2617),1, '%')),0)
               AuxAV7C2616 = THISFORM.AV7C2616
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08682,3,@AuxAV7C2616,0)
               THISFORM.AV7C2616 = AuxAV7C2616
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08682,4,PADR( TRIM(THISFORM.AV8C2642),2, '%'),LEN(PADR( TRIM(THISFORM.AV8C2642),2, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08682,5,PADR( TRIM(THISFORM.AV9C2643),1, '%'),LEN(PADR( TRIM(THISFORM.AV9C2643),1, '%')),0)
               AuxAV10C2644 = THISFORM.AV10C2644
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08682,6,@AuxAV10C2644,0)
               THISFORM.AV10C2644 = AuxAV10C2644
               AuxAV11C2645 = THISFORM.AV11C2645
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08682,7,@AuxAV11C2645,0)
               THISFORM.AV11C2645 = AuxAV11C2645
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08682 = Gx_err
               THISFORM.GX_DB_GetW08682_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08682 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08682) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08682 = Gx_err
                  THISFORM.GX_DB_GetW08682_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08682 <> 101
               BRKVO42 = .F.
               THISFORM.A2645ReINr = THISFORM.Buf_W08682_2645ReINroDoc
               THISFORM.A2644ReISu = THISFORM.Buf_W08682_2644ReISuc
               THISFORM.A2643ReISe = THISFORM.Buf_W08682_2643ReISer
               THISFORM.A2642ReITp = THISFORM.Buf_W08682_2642ReITpo
               THISFORM.A2616ReINr = THISFORM.Buf_W08682_2616ReINroI
               THISFORM.A2617ReIRo = THISFORM.Buf_W08682_2617ReIRoI
               THISFORM.A2EmpCod = THISFORM.Buf_W08682_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VO42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08682 = Gx_err
               THISFORM.GX_DB_GetW08682_01 ()
            ENDDO
         ENDIF
      ENDPROC
