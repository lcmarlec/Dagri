                  cmdbuf = cmdbuf + "  [ItemsEmbarques] (FASTFIRSTROW NOLOCK) WHERE ([NroPed] like ?) AND ([NroPallet] "
                  cmdbuf = cmdbuf + "  like ?) AND ([Producto] like ?) AND ([CantPickeada] >= ?) AND ([Saldo] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([FechaHora] like ?) ORDER BY [NroPed], [NroPallet]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11002,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11002,9)
                  THISFORM.GX_DB_BindColsW11002_01 ()
                  THISFORM.GX_DB_BindParmW11002_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11002,1,PADR( TRIM(THISFORM.AV5C3234),17, '%'),LEN(PADR( TRIM(THISFORM.AV5C3234),17, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11002,2,PADR( TRIM(THISFORM.AV6C3235),13, '%'),LEN(PADR( TRIM(THISFORM.AV6C3235),13, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11002,3,PADR( TRIM(THISFORM.AV7C3236),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C3236),10, '%')),0)
               AuxAV8C3237 = THISFORM.AV8C3237
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11002,4,@AuxAV8C3237,0)
               THISFORM.AV8C3237 = AuxAV8C3237
               AuxAV9C3238 = THISFORM.AV9C3238
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11002,5,@AuxAV9C3238,0)
               THISFORM.AV9C3238 = AuxAV9C3238
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11002,6,PADR( TRIM(THISFORM.AV10C3239),20, '%'),LEN(PADR( TRIM(THISFORM.AV10C3239),20, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11002 = Gx_err
               THISFORM.GX_DB_GetW11002_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11002 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11002) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11002 = Gx_err
                  THISFORM.GX_DB_GetW11002_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11002 <> 101
               BRKVUK2 = .F.
               THISFORM.A3239Items = THISFORM.Buf_W11002_3239ItemsEmbar
               THISFORM.A3238Saldo = THISFORM.Buf_W11002_3238Saldo
               THISFORM.A3237CantP = THISFORM.Buf_W11002_3237CantPickea
               THISFORM.A3236Produ = THISFORM.Buf_W11002_3236Producto
               THISFORM.A3235NroPa = THISFORM.Buf_W11002_3235NroPallet
               THISFORM.A3234NroPe = THISFORM.Buf_W11002_3234NroPed
               GX_SFLOAD = 0
               THISFORM.U12VUK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11002 = Gx_err
               THISFORM.GX_DB_GetW11002_01 ()
            ENDDO
         ENDIF
      ENDPROC
