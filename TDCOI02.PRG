                  cmdbuf = cmdbuf + "  [TDcArtCod] AS TDcArtCod, [TdcArtPrv], [TdcLinea], [TdcCntOri], [TdcCntFc], [TdcPrcFc], "
                  cmdbuf = cmdbuf + "  [TdcPrcOrig], [TdcAObs], [Tdc2Desc] FROM [DCOI02] (NOLOCK) WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [TdcNroInt] = ? ORDER BY [EmpCod], [TdcNroInt], [TDcFamCod], [TDcFamSubC], [TDcArtCod] "
                  cmdbuf = cmdbuf + "   "
