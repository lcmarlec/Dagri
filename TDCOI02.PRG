            THISFORM.T00375 = Gx_err
            THISFORM.GX_DB_GetT00375_01 ()
            IF .NOT. THISFORM.T00375 <> 103
               DO GX_ERRMW WITH "TDCOM reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00375 = 101 .OR. THISFORM.Z3266TdcLe <> THISFORM.Buf_T00375_3266TdcLeye
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z120EntCod <> THISFORM.Buf_T00375_120EntCod
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z386TdcGru <> THISFORM.Buf_T00375_386TdcGruCod
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z3024TdcEN <> THISFORM.Buf_T00375_3024TdcENI
               DO GX_ERRMW WITH "TDCOM fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
