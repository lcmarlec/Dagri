      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00624" , @HStmt_T00624 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TMONEDA","T00624","",GX_CURSOR_TYPE_READONLY,@HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [Moncod], [MonDsc], [MonSim] FROM [MONEDA] (FASTFIRSTROW NOLOCK) WHERE [Moncod] "
            cmdbuf = cmdbuf + "  >= ? ORDER BY [Moncod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00624,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00624,100)
            THISFORM.GX_DB_BindColsT00624_01 ()
            THISFORM.GX_DB_BindParmT00624_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A193Moncod = 0
               ENDIF
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00624,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00624 = Gx_err
               THISFORM.GX_DB_GetT00624_01 ()
               Gx_fcond = THISFORM.T00624 <> 101
            CASE GXOP = 2 && Next record
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00624,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00624 = Gx_err
               THISFORM.GX_DB_GetT00624_01 ()
               DO WHILE THISFORM.T00624 = 0 .AND. THISFORM.A193Moncod >= THISFORM.Buf_T00624_193Moncod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00624 = Gx_err
                  THISFORM.GX_DB_GetT00624_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00624 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A193Moncod = 0
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00624,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00624 = Gx_err
               THISFORM.GX_DB_GetT00624_01 ()
               DO WHILE THISFORM.T00624 = 0
                  THISFORM.A193Moncod = THISFORM.Buf_T00624_193Moncod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00624 = Gx_err
                  THISFORM.GX_DB_GetT00624_01 ()
               ENDDO
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00624,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00624) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00624 = Gx_err
               THISFORM.GX_DB_GetT00624_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A193Moncod = THISFORM.Buf_T00624_193Moncod
               THISFORM.A194MonDsc = THISFORM.Buf_T00624_194MonDsc
               THISFORM.A195MonSim = THISFORM.Buf_T00624_195MonSim
         ENDCASE
         Gx_fcond = THISFORM.T00624 <> 101 .AND. THISFORM.T00624 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

      ***********************
      PROCEDURE ZM1Q64
      ***********************

         PARAMETERS GX_JID
         IF GX_JID = 7 .OR. GX_JID = 0
            THISFORM.Z194MonDsc = THISFORM.Buf_T00623_194MonDsc
            THISFORM.Z195MonSim = THISFORM.Buf_T00623_195MonSim
         ENDIF
      RETURN

