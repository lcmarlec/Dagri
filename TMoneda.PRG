         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA193Moncod = THISFORM.A193Moncod
            Gx_err = GX_DB_SetInt( HStmt_T00622,1,@AuxA193Moncod,0)
            THISFORM.A193Moncod = AuxA193Moncod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00622) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00622 = Gx_err
            THISFORM.GX_DB_GetT00622_01 ()
            IF .NOT. THISFORM.T00622 <> 103
               DO GX_ERRMW WITH "MONEDA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00622 = 101 .OR. THISFORM.Z194MonDsc <> THISFORM.Buf_T00622_194MonDsc
               DO GX_ERRMW WITH "MONEDA fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00625" , @HStmt_T00625 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TMONEDA","T00625","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00625) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [MONEDA] ([Moncod], [MonDsc], [MonSim]) VALUES (?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00625,cmdbuf)
                  THISFORM.GX_DB_BindParmT00625_01 ()
               ENDIF
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00625,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               AuxA194MonDsc = THISFORM.A194MonDsc
               Gx_err = GX_DB_SetStr( HStmt_T00625,2,AuxA194MonDsc,20,0)
               THISFORM.A194MonDsc = AuxA194MonDsc
               AuxA195MonSim = THISFORM.A195MonSim
               Gx_err = GX_DB_SetStr( HStmt_T00625,3,AuxA195MonSim,3,0)
               THISFORM.A195MonSim = AuxA195MonSim
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00625) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00625 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00625) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00625 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00626" , @HStmt_T00626 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TMONEDA","T00626","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00626) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [MONEDA] SET [MonDsc]=?, [MonSim]=?  WHERE [Moncod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00626,cmdbuf)
                  THISFORM.GX_DB_BindParmT00626_01 ()
               ENDIF
               AuxA194MonDsc = THISFORM.A194MonDsc
               Gx_err = GX_DB_SetStr( HStmt_T00626,1,AuxA194MonDsc,20,0)
               THISFORM.A194MonDsc = AuxA194MonDsc
               AuxA195MonSim = THISFORM.A195MonSim
               Gx_err = GX_DB_SetStr( HStmt_T00626,2,AuxA195MonSim,3,0)
               THISFORM.A195MonSim = AuxA195MonSim
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00626,3,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00626) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00626 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00626) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00627" , @HStmt_T00627 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TMONEDA","T00627","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00627) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [MONEDA]  WHERE [Moncod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00627,cmdbuf)
                  THISFORM.GX_DB_BindParmT00627_01 ()
               ENDIF
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00627,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00627) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00627 = Gx_err
               THISFORM.T00622 = iif( THISFORM.T00627 = 0 , 104 , THISFORM.T00627 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00627) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A193Moncod , 3 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "MAES" , Aux1 , "Moneda" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT62V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 64 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
