            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW719S22 = GETE('z:\temp') + '\' + SCW719S22
            ENDIF
            CREATE DBF (SCW719S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW719S22) EXCLUSIVE ALIAS SCW719S22
         ENDIF
