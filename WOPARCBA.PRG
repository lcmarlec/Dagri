      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07192" , @HStmt_W07192 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPARCBA","W07192","",GX_CURSOR_TYPE_READONLY,@HStmt_W07192) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[OpaRcbHta], T1.[OpaRcbDde], T1.[OpaRcbTal], T2.[EntRaz] AS OpaEntRaz, "
                  cmdbuf = cmdbuf + "  T1.[OpaEntCod] AS OpaEntCod, T1.[OpaEntGruT] AS OpaEntGruT, T1.[EmpCod] FROM ([OPARCBAN] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[OpaEntGruT] AND T2.[EntCod] = T1.[OpaEntCod]) WHERE (T1.[OpaEntCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[EmpCod] = ?) AND (T1.[OpaEntGruT] = ?) ORDER BY T1.[OpaEntCod], T1.[OpaRcbTal] "
                  cmdbuf = cmdbuf + "  DESC, T1.[OpaRcbDde] DESC  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07192,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07192,11)
                  THISFORM.GX_DB_BindColsW07192_01 ()
                  THISFORM.GX_DB_BindParmW07192_01 ()
               ENDIF
               AuxAV21Desprv = THISFORM.AV21Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07192,1,@AuxAV21Desprv,0)
               THISFORM.AV21Desprv = AuxAV21Desprv
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07192,2,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV22Opaent = THISFORM.AV22Opaent
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07192,3,AuxAV22Opaent,2,0)
               THISFORM.AV22Opaent = AuxAV22Opaent
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07192 = Gx_err
               THISFORM.GX_DB_GetW07192_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WOPARCBA"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07192 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07192) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07192 = Gx_err
                  THISFORM.GX_DB_GetW07192_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07192 <> 101
               BRKVJZ2 = .F.
               THISFORM.A2158OpaRc = THISFORM.Buf_W07192_2158OpaRcbHta
               THISFORM.A2157OpaRc = THISFORM.Buf_W07192_2157OpaRcbDde
               THISFORM.A2159OpaRc = THISFORM.Buf_W07192_2159OpaRcbTal
               THISFORM.A714OpaEnt = THISFORM.Buf_W07192_714OpaEntRaz
               THISFORM.A713OpaEnt = THISFORM.Buf_W07192_713OpaEntCod
               THISFORM.A712OpaEnt = THISFORM.Buf_W07192_712OpaEntGruT
               THISFORM.A2EmpCod = THISFORM.Buf_W07192_2EmpCod
               THISFORM.A714OpaEnt = THISFORM.Buf_W07192_714OpaEntRaz
               GX_SFLOAD = 0
               THISFORM.U17VJZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07192 = Gx_err
               THISFORM.GX_DB_GetW07192_01 ()
            ENDDO
         ENDIF
      ENDPROC
