               Gx_err = GX_DB_SetInt( HStmt_T02817,4,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1664CamPa = THISFORM.A1664CamPa
               Gx_err = GX_DB_SetStr( HStmt_T02817,5,AuxA1664CamPa,8,0)
               THISFORM.A1664CamPa = AuxA1664CamPa
               AuxA2689PolFV = THISFORM.A2689PolFV
               Gx_err = GX_DB_SetDate( HStmt_T02817,6,@AuxA2689PolFV,0)
               THISFORM.A2689PolFV = AuxA2689PolFV
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02817) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02817 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02817) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02818" , @HStmt_T02818 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMPOL","T02818","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02818) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CAMPOL]  WHERE [EmpCod] = ? AND [CamPat] = ? AND [PolFVig] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02818,cmdbuf)
                  THISFORM.GX_DB_BindParmT02818_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02818,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1664CamPa = THISFORM.A1664CamPa
               Gx_err = GX_DB_SetStr( HStmt_T02818,2,AuxA1664CamPa,8,0)
