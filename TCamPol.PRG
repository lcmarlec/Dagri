                  cmdbuf = cmdbuf + "  = ? AND [PolFVig] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02817,cmdbuf)
                  THISFORM.GX_DB_BindParmT02817_01 ()
               ENDIF
               AuxA2690PolNr = THISFORM.A2690PolNr
               Gx_err = GX_DB_SetStr( HStmt_T02817,1,AuxA2690PolNr,15,0)
               THISFORM.A2690PolNr = AuxA2690PolNr
