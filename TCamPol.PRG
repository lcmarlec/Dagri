               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02817" , @HStmt_T02817 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMPOL","T02817","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02817) ,  ,  ,  , CS_SQLSRV , 0 )
