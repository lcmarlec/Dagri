               AuxA2689PolFV = THISFORM.A2689PolFV
               Gx_err = GX_DB_SetDate( HStmt_T02816,3,@AuxA2689PolFV,0)
               THISFORM.A2689PolFV = AuxA2689PolFV
               AuxA2690PolNr = THISFORM.A2690PolNr
               Gx_err = GX_DB_SetStr( HStmt_T02816,4,AuxA2690PolNr,15,0)
               THISFORM.A2690PolNr = AuxA2690PolNr
               AuxA2691PolFD = THISFORM.A2691PolFD
               Gx_err = GX_DB_SetDate( HStmt_T02816,5,@AuxA2691PolFD,0)
               THISFORM.A2691PolFD = AuxA2691PolFD
               AuxA2692PolAs = THISFORM.A2692PolAs
               Gx_err = GX_DB_SetStr( HStmt_T02816,6,AuxA2692PolAs,40,0)
               THISFORM.A2692PolAs = AuxA2692PolAs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02816) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02816 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02816) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02816 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
