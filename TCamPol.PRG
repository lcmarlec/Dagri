            THISFORM.T02812 = Gx_err
            THISFORM.GX_DB_GetT02812_01 ()
            IF .NOT. THISFORM.T02812 <> 103
               DO GX_ERRMW WITH "CAMPOL reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02812 = 101 .OR. THISFORM.Z2690PolNr <> THISFORM.Buf_T02812_2690PolNro
               DO GX_ERRMW WITH "CAMPOL fue modificada."
               RETURN .F.
