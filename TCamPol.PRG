      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02816" , @HStmt_T02816 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMPOL","T02816","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02816) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CAMPOL] ([EmpCod], [CamPat], [PolFVig], [PolNro], [PolFDde], [PolAse]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02816,cmdbuf)
                  THISFORM.GX_DB_BindParmT02816_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02816,1,@AuxA2EmpCod,0)
