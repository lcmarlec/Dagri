            THISFORM. cCT106A64 . ZM2Y110 ( 15 )
            IF THISFORM.T01069 = 101
               DO GX_ERRMW WITH "No se encontro el registro"
            ELSE
               THISFORM.Visible = .T.
               THISFORM.LoadObj(0)
