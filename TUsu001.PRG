               ENDIF
               DO CASE
                  CASE THISFORM.Gx_mode = 'INS'
                     THISFORM.AV15Pass1 = SPACE(10)
                  CASE .T. .AND. THISFORM.Gx_mode = 'UPD'
                     XPass10 = SPACE(10)
                     Aux0 = THISFORM.A1036UsuPa
                     DO PAut002 WITH Aux0 , "D" , XPass10
                     THISFORM.A1036UsuPa = Aux0
                     THISFORM.AV15Pass1 = XPass10
               ENDCASE
               IF THISFORM.Gx_mode = 'INS' .AND. EMPTY( THISFORM.AV14Pass ) .AND. .T.
                  THISFORM.AV14Pass = THISFORM.AV15Pass1
               ENDIF
               IF .T.
                  THISFORM.AV14Pass = THISFORM.AV15Pass1
               ENDIF
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               THISFORM.Gx_mode = "UPD"
               IF THISFORM.Gx_mode = 'UPD' .OR. THISFORM.Gx_mode = 'DLT'
                  THISFORM.A64UsuCod = THISFORM.AV16Usucod
               ENDIF
               THISFORM. cCT106A64 .Refresh()
               THISFORM.Gx_mode = "DSP"
            ENDIF
            THISFORM.U112Y2 ()
