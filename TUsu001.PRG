      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl = 110
            IF ! THISFORM. gx_110insert
               THISFORM.SetLevel( 110 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 110
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 110 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Response = .T.
            DO GX_CONFW WITH 'Confirma la transacción?' , Response
            Gx_ucfrm  = .T.
            IF .NOT. Response
               * Rollback TRANSACTION
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01069) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01068) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01066) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01065) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01063) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01062) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01067) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01064) , "TUSU001" )
               IF TYPE( "HConn_Default" ) = "N"
                  IF GXCONNECTED
                     Gx_Err = Gx_odbc_mrc( GX_DB_ConnRollback(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDIF
               ENDIF
            ELSE
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01069) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01068) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01066) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01065) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01063) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01062) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01067) , "TUSU001" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01064) , "TUSU001" )
               IF TYPE( "HConn_Default" ) = "N"
                  IF GXCONNECTED
                     Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDIF
               ENDIF
               THISFORM. cCT106A3088 .AfterTrn()
               DO CASE
                  CASE THISFORM.GX_Mode = "INS"
                  CASE THISFORM.GX_Mode = "UPD"
                     THISFORM.ReleaseAll()
                  CASE THISFORM.GX_Mode = "DLT"
                     THISFORM.ReleaseAll()
               ENDCASE
            ENDIF
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 110
            IF ! THISFORM. gx_110insert
               THISFORM.SetLevel( 110 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_110insert
            THISFORM. gx_110insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 110 )
            THISFORM. cCT106A64 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         gx_old_mode = THISFORM.GX_Mode
         IF THISFORM.GX_Mode = "DSP"
            THISFORM.GX_Mode = "UPD"
         ENDIF
         THIS.GX_noacc_cond = .F.
         IF THISFORM.Gx_mode = 'UPD' .OR. THISFORM.Gx_mode = 'DLT'
            THISFORM. GXInLvl110 = .T.
            THIS.GX_noacc_cond = .T.
         ENDIF
         THISFORM.GX_Mode = gx_old_mode
         IF THIS.GX_noacc_cond
            IF ! THIS.ValidObj()
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled( THIS.TabIndex, -1, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               THISFORM.gx_lastvld = THIS.GxObjOrder
            ENDIF
         ENDIF
         IF THIS.GX_noacc_cond .and. THISFORM.Gx_Mode = "DSP"
            THISFORM. cCT106A64 .LostFocus()
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 110
            THISFORM.SetLevel( 110 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT106A64 .InitLevel( 110 )
            THISFORM.GX_last_fld_lvl = 110
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A64UsuCod"
         THIS.GXGotFocus()
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         IF THIS.GX_noacc_cond
            NODEFAULT
            IF LASTKEY() = 19 .or. LASTKEY() = 15
               THISFORM.SetFocusEnabled( THIS.TabIndex, -1,-1, .T., .T., .F.)
            ELSE
               THISFORM.SetFocusEnabled( THIS.TabIndex, +1,+1, .T., .T., .F.)
            ENDIF
         ENDIF
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE LostFocus
         IF THISFORM.Gx_Mode = "DSP"
            THISFORM.LoadObj(2)
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         CGXTextBox ::LostFocus()
      ENDPROC
