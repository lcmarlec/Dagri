      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S64UsuCod
         LOCAL S2EmpCod
         S64UsuCod = THISFORM.A64UsuCod
         S2EmpCod = THISFORM.A2EmpCod
         THISFORM.A2EmpCod = THISFORM.M2EmpCod
         THISFORM. cCT106S15 .SaveTemp()
         THISFORM. cCT106S15 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT106S15 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT106S15 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT106S15 .SF( 3, @sf_err)     && Read
         Gx_fcond = S64UsuCod = THISFORM.A64UsuCod .AND. S2EmpCod = THISFORM.A2EmpCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT106S15 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT106S15 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S64UsuCod = THISFORM.A64UsuCod .AND. S2EmpCod = THISFORM.A2EmpCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT106S15 .Refresh()
               THISFORM. cCT106S15 .AfterRowColChange1()
               THISFORM.A64UsuCod = S64UsuCod
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT106S15 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT106S15 .LoadRec(2, @sf_err)
            Gx_fcond = S64UsuCod = THISFORM.A64UsuCod .AND. S2EmpCod = THISFORM.A2EmpCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT106S15 .LoadRec(2, @sf_err)
               Gx_fcond = S64UsuCod = THISFORM.A64UsuCod .AND. S2EmpCod = THISFORM.A2EmpCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT106S15 .AppendRow()
               THISFORM. cCT106S15 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A64UsuCod = S64UsuCod
               THISFORM.A2EmpCod = S2EmpCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A64UsuCod = S64UsuCod
         THISFORM.A2EmpCod = S2EmpCod
         RETURN .F.
      ENDFUNC
