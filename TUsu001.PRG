      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T010619" , @HStmt_T010619 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TUSU001","T010619","",GX_CURSOR_TYPE_READONLY,@HStmt_T010619) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [UsuCod], [EmpCod], [UsuGrutip] AS UsuGrutip, [UsuEntCod] AS UsuEntCod FROM "
                  cmdbuf = cmdbuf + "  [USU0011] (NOLOCK) WHERE [UsuCod] = ? AND [EmpCod] = ? ORDER BY [UsuCod], [EmpCod], "
                  cmdbuf = cmdbuf + "  [UsuGrutip], [UsuEntCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T010619,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T010619,6)
                  THISFORM.GX_DB_BindColsT010619_01 ()
                  THISFORM.GX_DB_BindParmT010619_01 ()
               ENDIF
               AuxA64UsuCod = THISFORM.A64UsuCod
               Gx_err = GX_DB_SetStr( HStmt_T010619,1,AuxA64UsuCod,10,0)
               THISFORM.A64UsuCod = AuxA64UsuCod
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T010619,2,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T010619) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010619 = Gx_err
               THISFORM.GX_DB_GetT010619_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T010619 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T010619) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T010619 = Gx_err
                  THISFORM.GX_DB_GetT010619_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T010619 <> 101
               BRK2Y394 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT106S29.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T010619) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T010619 = Gx_err
               THISFORM.GX_DB_GetT010619_01 ()
            ENDDO
         ENDIF
