      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11082" , @HStmt_W11082 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSTKCAMA","W11082","",0,@HStmt_W11082) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.RILin, T1.EmpCod, T1.RINroInt, T2.RILugDde, T2.RILugHta, T1.FamSubCod, "
                  cmdbuf = cmdbuf + "  T1.FamCod, T1.RICnt, T1.RITraz, T1.RiLotVnc, T1.RiLotFch, T1.RiLotNro, T3.ArtDsc, "
                  cmdbuf = cmdbuf + "  T3.ArtCodBar, T1.ArtCod  FROM ((REMINT1 T1 (FASTFIRSTROW NOLOCK) LEFT JOIN REMINT "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.EmpCod = T1.EmpCod AND T2.RINroInt = T1.RINroInt) LEFT JOIN ARTICS "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.EmpCod = T1.EmpCod AND T3.FamCod = T1.FamCod AND T3.FamSubCod "
                  cmdbuf = cmdbuf + "  = T1.FamSubCod AND T3.ArtCod = T1.ArtCod) WHERE ( T1.ArtCod = ? OR ? = 0 ) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.EmpCod, T1.RINroInt, T1.RILin   "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_W11082,cmdbuf) ,  ,  ,  , CS_SQLSRV ,  )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtFetchSize( HStmt_W11082,12) ,  ,  ,  , CS_SQLSRV ,  )
                  THISFORM.GX_DB_BindColsW11082_01 ( HStmt_W11082 )
                  THISFORM.GX_DB_BindParmW11082_01 ( HStmt_W11082 )
               ENDIF
               AuxAV21Artcod = THISFORM.AV21Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11082,1,@AuxAV21Artcod,0)
               THISFORM.AV21Artcod = AuxAV21Artcod
               AuxAV21Artcod = THISFORM.AV21Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11082,2,@AuxAV21Artcod,0)
               THISFORM.AV21Artcod = AuxAV21Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11082 = Gx_err
               THISFORM.GX_DB_GetW11082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WStkCama"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11082 = Gx_err
                  THISFORM.GX_DB_GetW11082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11082 <> 101
               BRKVUS2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W11082_2EmpCod
               THISFORM.A1306RINro = THISFORM.Buf_W11082_1306RINroInt
               THISFORM.A1312RILug = THISFORM.Buf_W11082_1312RILugDde
               THISFORM.A1314RILug = THISFORM.Buf_W11082_1314RILugHta
