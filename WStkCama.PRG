               THISFORM.A3000RITra = THISFORM.Buf_W11082_3000RITraz
               THISFORM.A1483RiLot = THISFORM.Buf_W11082_1483RiLotVnc
               THISFORM.A1482RiLot = THISFORM.Buf_W11082_1482RiLotFch
               THISFORM.A1481RiLot = THISFORM.Buf_W11082_1481RiLotNro
               THISFORM.A6ArtDsc = THISFORM.Buf_W11082_6ArtDsc
               THISFORM.A1464ArtCo = THISFORM.Buf_W11082_1464ArtCodBar
               THISFORM.A5ArtCod = THISFORM.Buf_W11082_5ArtCod
               THISFORM.A1312RILug = THISFORM.Buf_W11082_1312RILugDde
               THISFORM.A1314RILug = THISFORM.Buf_W11082_1314RILugHta
               THISFORM.A6ArtDsc = THISFORM.Buf_W11082_6ArtDsc
               THISFORM.A1464ArtCo = THISFORM.Buf_W11082_1464ArtCodBar
               IF THISFORM.A5ArtCod = THISFORM.AV21Artcod .OR. THISFORM.AV21Artcod = 0
                  DO GX_CSC01
                  IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11083" , @HStmt_W11083 )
                     Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSTKCAMA","W11083","",0,@HStmt_W11083) ,  ,  ,  , CS_SQLSRV ,  )
                     cmdbuf = " SELECT LugHab  FROM LUGALM (NOLOCK) WHERE EmpCod = ? AND LugCod = ?    "
                     Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_W11083,cmdbuf) ,  ,  ,  , CS_SQLSRV ,  )
                     THISFORM.GX_DB_BindColsW11083_01 ( HStmt_W11083 )
                     THISFORM.GX_DB_BindParmW11083_01 ( HStmt_W11083 )
                  ENDIF
                  AuxA2EmpCod = THISFORM.A2EmpCod
                  THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11083,1,@AuxA2EmpCod,0)
                  THISFORM.A2EmpCod = AuxA2EmpCod
                  AuxA1312RILug = THISFORM.A1312RILug
                  THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11083,2,@AuxA1312RILug,0)
                  THISFORM.A1312RILug = AuxA1312RILug
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11083) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11083 = Gx_err
                  THISFORM.GX_DB_GetW11083_01 ()
                  THISFORM.A36LugHab = THISFORM.Buf_W11083_36LugHab
                  IF THISFORM.A36LugHab = "S"
                     DO GX_CSC01
                     IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11084" , @HStmt_W11084 )
                        Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSTKCAMA","W11084","",0,@HStmt_W11084) ,  ,  ,  , CS_SQLSRV ,  )
                        cmdbuf = " SELECT LugHab  FROM LUGALM (NOLOCK) WHERE EmpCod = ? AND LugCod = ?    "
                        Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_W11084,cmdbuf) ,  ,  ,  , CS_SQLSRV ,  )
                        THISFORM.GX_DB_BindColsW11083_01 ( HStmt_W11084 )
                        THISFORM.GX_DB_BindParmW11084_01 ( HStmt_W11084 )
                     ENDIF
                     AuxA2EmpCod = THISFORM.A2EmpCod
                     THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11084,1,@AuxA2EmpCod,0)
                     THISFORM.A2EmpCod = AuxA2EmpCod
                     AuxA1314RILug = THISFORM.A1314RILug
                     THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11084,2,@AuxA1314RILug,0)
