                     ENDDO
                     THISFORM.W11084 = Gx_err
                     THISFORM.GX_DB_GetW11084_01 ()
                     THISFORM.A36LugHab = THISFORM.Buf_W11084_36LugHab
                     GX_SFLOAD = 0
                     THISFORM.U13VUS2 ()
                     THIS.GX_CUPOS = 0
                     DO CASE
                        CASE GX_SFLOAD = 1
