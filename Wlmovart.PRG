      ***********************
      PROCEDURE cCW862V24.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW862V24.ISVALID" )
         THISFORM.AV44GXLvl1 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08622" , @HStmt_W08622 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLMOVART","W08622","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W08622) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtDsc] FROM [ARTICS] (NOLOCK) "
            cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [FamCod] = ? and [FamSubCod] = ? and [ArtCod] = ? ORDER BY "
            cmdbuf = cmdbuf + "  [EmpCod], [FamCod], [FamSubCod], [ArtCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08622,cmdbuf)
            THISFORM.GX_DB_BindColsW08622_01 ()
            THISFORM.GX_DB_BindParmW08622_01 ()
         ENDIF
         AuxAV11Emprco = THISFORM.AV11Emprco
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08622,1,@AuxAV11Emprco,0)
         THISFORM.AV11Emprco = AuxAV11Emprco
         AuxAV26Desfam = THISFORM.AV26Desfam
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08622,2,@AuxAV26Desfam,0)
         THISFORM.AV26Desfam = AuxAV26Desfam
         AuxAV27Dessfa = THISFORM.AV27Dessfa
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08622,3,@AuxAV27Dessfa,0)
         THISFORM.AV27Dessfa = AuxAV27Dessfa
         AuxAV24Descod = THISFORM.AV24Descod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08622,4,@AuxAV24Descod,0)
         THISFORM.AV24Descod = AuxAV24Descod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08622) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W08622 = Gx_err
         THISFORM.GX_DB_GetW08622_01 ()
         DO WHILE THISFORM.W08622 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W08622_2EmpCod
            THISFORM.A3FamCod = THISFORM.Buf_W08622_3FamCod
            THISFORM.A4FamSubCo = THISFORM.Buf_W08622_4FamSubCod
            THISFORM.A5ArtCod = THISFORM.Buf_W08622_5ArtCod
            THISFORM.A6ArtDsc = THISFORM.Buf_W08622_6ArtDsc
            THISFORM.AV44GXLvl1 = 1
            THISFORM.AV25Desdes = THISFORM.A6ArtDsc
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W08622) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV44GXLvl1 = 0
            IF THISFORM.AV24Descod = 0
               THISFORM.AV25Desdes = "Primero "
            ELSE
               THISFORM.AV25Desdes = "Articulo Inexistente "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

