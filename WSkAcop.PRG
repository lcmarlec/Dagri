      PROCEDURE CreateTemp
         LOCAL SCW1280S13
         SCW1280S13 = ""
         IF USED( "SCW1280S13" )
            SELECT SCW1280S13
            SCW1280S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1280S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA3666Acop"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3667Acop"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3690Acop"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1280S13 = GETE('z:\temp') + '\' + SCW1280S13
            ENDIF
            CREATE DBF (SCW1280S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1280S13) EXCLUSIVE ALIAS SCW1280S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1280S13
         THIS.GX_SfAlias = "SCW1280S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12802" , @HStmt_W12802 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKACOP","W12802","",GX_CURSOR_TYPE_READONLY,@HStmt_W12802) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [AcopPall], [AcopDsc], [AcopPat] FROM [ACOP] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ?) AND ([AcopPat] like '%' + RTRIM(?) + '%' or [AcopDsc] like "
                  cmdbuf = cmdbuf + "  '%' + RTRIM(?) + '%') ORDER BY [EmpCod], [AcopPat]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12802,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12802,14)
                  THISFORM.GX_DB_BindColsW12802_01 ()
                  THISFORM.GX_DB_BindParmW12802_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12802,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12802,2,PADR( TRIM(THISFORM.AV22Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV22Desde),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12802,3,PADR( TRIM(THISFORM.AV22Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV22Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12802 = Gx_err
               THISFORM.GX_DB_GetW12802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WSkAcop"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12802 = Gx_err
                  THISFORM.GX_DB_GetW12802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12802 <> 101
               BRKVZK2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W12802_2EmpCod
               THISFORM.A3690AcopP = THISFORM.Buf_W12802_3690AcopPall
               THISFORM.A3667AcopD = THISFORM.Buf_W12802_3667AcopDsc
               THISFORM.A3666AcopP = THISFORM.Buf_W12802_3666AcopPat
               GX_SFLOAD = 0
               THISFORM.U15VZK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12802 = Gx_err
               THISFORM.GX_DB_GetW12802_01 ()
            ENDDO
         ENDIF
      ENDPROC
