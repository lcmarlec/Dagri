               THISFORM.A1396tasNr = AuxA1396tasNr
               AuxAV5C1402 = THISFORM.AV5C1402
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04432,5,@AuxAV5C1402,0)
               THISFORM.AV5C1402 = AuxAV5C1402
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04432,6,PADR( TRIM(THISFORM.AV6C199),12, '%'),LEN(PADR( TRIM(THISFORM.AV6C199),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04432,7,PADR( TRIM(THISFORM.AV7C1403),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C1403),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04432 = Gx_err
               THISFORM.GX_DB_GetW04432_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04432 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04432) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04432 = Gx_err
                  THISFORM.GX_DB_GetW04432_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04432 <> 101
               BRKVCB2 = .F.
               THISFORM.A1403tasDe = THISFORM.Buf_W04432_1403tasDes
               THISFORM.A1405tasIt = THISFORM.Buf_W04432_1405tasItHbOri
               THISFORM.A1404tasIt = THISFORM.Buf_W04432_1404tasItDbOri
               THISFORM.A199CtaNro = THISFORM.Buf_W04432_199CtaNro
               THISFORM.A1402tasIt = THISFORM.Buf_W04432_1402tasItNro
               GX_SFLOAD = 0
               THISFORM.U12VCB2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04432 = Gx_err
               THISFORM.GX_DB_GetW04432_01 ()
            ENDDO
         ENDIF
      ENDPROC
