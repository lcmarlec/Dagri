                  cmdbuf = cmdbuf + "  T1.[DcVTip], T1.[DcVNroInt], T1.[DcVFCo], T1.[DcVFaturo], T1.[DcVTotSld], T1.[DcVTot], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVNro], T1.[DcVSuc], "
                  cmdbuf = cmdbuf + "  T1.[DcVSer], T1.[DcvTipRed], T1.[DcVFch] FROM ([DCVENT] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[DcVEntGruT] AND T2.[EntCod] = T1.[DcVEntCod]) WHERE (T1.[EmpCod] = ? and T1.[DcVFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[DcVEntCod] = ? or ? = 0) AND (T1.[DcVSuc] = ? or ? = 0) AND (T1.[DcVNro] "
                  cmdbuf = cmdbuf + "  > 0) AND (T1.[DcVNro] >= ?) AND (T1.[DcVNro] <= ?) AND (T1.[DcVTot] >= ? or ? = "
                  cmdbuf = cmdbuf + "  0) AND (T1.[DcVTot] <= ? or ? = 0) AND (T1.[DcVEst] > 0) AND (T1.[DcvTipRed] = ? "
                  cmdbuf = cmdbuf + "  or ? = 'TT') AND (T1.[DcVSer] = ? or ? = 'T') AND (T1.[DcvTipRed] <> ' ' or ? = "
                  cmdbuf = cmdbuf + "  1) AND (T1.[DcVFch] <= ?) ORDER BY T1.[EmpCod], T1.[DcVFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11072,cmdbuf)
