            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S2617ReIRo = THISFORM.A2617ReIRo .AND. S2616ReINr = THISFORM.A2616ReINr .AND. S2642ReITp = THISFORM.A2642ReITp .AND. S2643ReISe = THISFORM.A2643ReISe
