                  cmdbuf = cmdbuf + "  [ReIObsDoc] FROM [REINCID1] (NOLOCK) WHERE [EmpCod] = ? AND [ReIRoI] = ? AND [ReINroI] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [ReIRoI], [ReINroI], [ReITpo], [ReISer], [ReISuc], [ReINroDoc] "
                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T027228,cmdbuf)
