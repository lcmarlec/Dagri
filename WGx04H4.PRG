               AuxA1346AsiNr = THISFORM.A1346AsiNr
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04312,4,@AuxA1346AsiNr,0)
               THISFORM.A1346AsiNr = AuxA1346AsiNr
               AuxAV5C1353 = THISFORM.AV5C1353
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04312,5,@AuxAV5C1353,0)
               THISFORM.AV5C1353 = AuxAV5C1353
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04312,6,PADR( TRIM(THISFORM.AV6C199),12, '%'),LEN(PADR( TRIM(THISFORM.AV6C199),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04312,7,PADR( TRIM(THISFORM.AV7C1355),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C1355),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04312 = Gx_err
               THISFORM.GX_DB_GetW04312_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04312 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04312) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04312 = Gx_err
                  THISFORM.GX_DB_GetW04312_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04312 <> 101
               BRKVBZ2 = .F.
               THISFORM.A1355AsiIt = THISFORM.Buf_W04312_1355AsiItDes
               THISFORM.A1357AsiIt = THISFORM.Buf_W04312_1357AsiItHbOri
               THISFORM.A1356AsiIt = THISFORM.Buf_W04312_1356AsiItDbOri
               THISFORM.A199CtaNro = THISFORM.Buf_W04312_199CtaNro
               THISFORM.A1353AsiIt = THISFORM.Buf_W04312_1353AsiItNro
               GX_SFLOAD = 0
               THISFORM.U12VBZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04312 = Gx_err
               THISFORM.GX_DB_GetW04312_01 ()
            ENDDO
         ENDIF
      ENDPROC
