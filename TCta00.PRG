            THISFORM.SetLevel( 18 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT20A199 .InitLevel( 18 )
            THISFORM.GX_last_fld_lvl = 18
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A205CtaNro"
         THIS.GXGotFocus()
         IF THIS.GX_noacc_cond
            NODEFAULT
            IF LASTKEY() = 19 .or. LASTKEY() = 15
               THISFORM.SetFocusEnabled( THIS.TabIndex, -1,-1, .T., .T., .F.)
            ELSE
               THISFORM.SetFocusEnabled( THIS.TabIndex, +1,+1, .T., .T., .F.)
            ENDIF
         ENDIF
