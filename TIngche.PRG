      PROCEDURE CreateTemp
         LOCAL SCT138S15
         SCT138S15 = ""
         IF USED( "SCT138S15" )
            SELECT SCT138S15
            SCT138S15 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT138S15
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1118tEch"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1119tEch"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1120tEch"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT138S15 = GETE('z:\temp') + '\' + SCT138S15
            ENDIF
            CREATE DBF (SCT138S15) FROM ARRAY GX_STRUCT
            USE
            USE (SCT138S15) EXCLUSIVE ALIAS SCT138S15
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT138S15
         THIS.GX_SfAlias = "SCT138S15"
      ENDPROC
