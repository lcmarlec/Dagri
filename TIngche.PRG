         ENDIF
         AuxA1122tEchT = THISFORM.A1122tEchT
         Gx_err = GX_DB_SetDouble( HStmt_T013816,1,@AuxA1122tEchT,0)
         THISFORM.A1122tEchT = AuxA1122tEchT
