                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00512,12)
                  THISFORM.GX_DB_BindColsW00512_01 ()
                  THISFORM.GX_DB_BindParmW00512_01 ()
               ENDIF
               AuxAV20Pctagr = THISFORM.AV20Pctagr
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00512,1,@AuxAV20Pctagr,0)
               THISFORM.AV20Pctagr = AuxAV20Pctagr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00512) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00512 = Gx_err
               THISFORM.GX_DB_GetW00512_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WElePCGr"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00512 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00512) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00512 = Gx_err
                  THISFORM.GX_DB_GetW00512_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00512 <> 101
               BRKV1F2 = .F.
               THISFORM.A228PCtaGr = THISFORM.Buf_W00512_228PCtaGrDes
               THISFORM.A215PCtaGr = THISFORM.Buf_W00512_215PCtaGrNro
               GX_SFLOAD = 0
               THISFORM.U15V1F2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00512) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00512 = Gx_err
               THISFORM.GX_DB_GetW00512_01 ()
            ENDDO
         ENDIF
      ENDPROC
