      PROCEDURE CreateTemp
         LOCAL SCW1212S20
         SCW1212S20 = ""
         IF USED( "SCW1212S20" )
            SELECT SCW1212S20
            SCW1212S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1212S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA3501ExpA"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 21
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3502ExpA"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 13
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3503ExpA"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3504ExpA"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 16
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3505ExpA"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1212S20 = GETE('z:\temp') + '\' + SCW1212S20
            ENDIF
            CREATE DBF (SCW1212S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1212S20) EXCLUSIVE ALIAS SCW1212S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1212S20
         THIS.GX_SfAlias = "SCW1212S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12122" , @HStmt_W12122 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0B30","W12122","",GX_CURSOR_TYPE_READONLY,@HStmt_W12122) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ExpauditOk], [ExpAuditlug], [ExpAuditLeg], [ExpAuditPallet], [ExpAuditCnt], "
                  cmdbuf = cmdbuf + "  [ExpAuditEAN], [ExpAuditFyH] FROM [ExpAudit] (FASTFIRSTROW NOLOCK) WHERE ([ExpAuditFyH] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ExpAuditEAN] like ?) AND ([ExpAuditCnt] >= ?) AND ([ExpAuditPallet] "
                  cmdbuf = cmdbuf + "  like ?) AND ([ExpAuditLeg] >= ?) AND ([ExpauditOk] >= ?) AND ([ExpAuditlug] >= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY [ExpAuditFyH], [ExpAuditEAN]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12122,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12122,9)
                  THISFORM.GX_DB_BindColsW12122_01 ()
                  THISFORM.GX_DB_BindParmW12122_01 ()
               ENDIF
               AuxAV5C3501 = THISFORM.AV5C3501
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12122,1,@AuxAV5C3501,0)
               THISFORM.AV5C3501 = AuxAV5C3501
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12122,2,PADR( TRIM(THISFORM.AV6C3502),13, '%'),LEN(PADR( TRIM(THISFORM.AV6C3502),13, '%')),0)
               AuxAV7C3503 = THISFORM.AV7C3503
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12122,3,@AuxAV7C3503,0)
               THISFORM.AV7C3503 = AuxAV7C3503
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12122,4,PADR( TRIM(THISFORM.AV8C3504),16, '%'),LEN(PADR( TRIM(THISFORM.AV8C3504),16, '%')),0)
               AuxAV9C3505 = THISFORM.AV9C3505
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12122,5,@AuxAV9C3505,0)
               THISFORM.AV9C3505 = AuxAV9C3505
               AuxAV10C3507 = THISFORM.AV10C3507
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12122,6,@AuxAV10C3507,0)
               THISFORM.AV10C3507 = AuxAV10C3507
               AuxAV11C3508 = THISFORM.AV11C3508
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12122,7,@AuxAV11C3508,0)
               THISFORM.AV11C3508 = AuxAV11C3508
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12122 = Gx_err
               THISFORM.GX_DB_GetW12122_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12122 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12122) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12122 = Gx_err
                  THISFORM.GX_DB_GetW12122_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12122 <> 101
               BRKVXO2 = .F.
               THISFORM.A3507Expau = THISFORM.Buf_W12122_3507ExpauditOk
               THISFORM.A3508ExpAu = THISFORM.Buf_W12122_3508ExpAuditlu
               THISFORM.A3505ExpAu = THISFORM.Buf_W12122_3505ExpAuditLe
               THISFORM.A3504ExpAu = THISFORM.Buf_W12122_3504ExpAuditPa
               THISFORM.A3503ExpAu = THISFORM.Buf_W12122_3503ExpAuditCn
               THISFORM.A3502ExpAu = THISFORM.Buf_W12122_3502ExpAuditEA
               THISFORM.A3501ExpAu = THISFORM.Buf_W12122_3501ExpAuditFy
               GX_SFLOAD = 0
               THISFORM.U12VXO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12122 = Gx_err
               THISFORM.GX_DB_GetW12122_01 ()
            ENDDO
         ENDIF
      ENDPROC
