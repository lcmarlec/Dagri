               THISFORM.cCT71A675.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00713) , "TNRORET" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00712) , "TNRORET" )
