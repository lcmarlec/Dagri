               ENDIF
               Response = .F.
               THISFORM. DC1Z71 ()
               THISFORM. cCT71A675 . ZM1Z71 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1Z71 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT71A676 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE1Z71 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1Z71 ()
