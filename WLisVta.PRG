            CREATE DBF (SCW83S3) FROM ARRAY GX_STRUCT
            USE
            USE (SCW83S3) EXCLUSIVE ALIAS SCW83S3
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW83S3
         THIS.GX_SfAlias = "SCW83S3"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U14V2B2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
