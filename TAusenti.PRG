               Gx_err = GX_DB_SetLong( HStmt_T023314,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               AuxA2266CAuCo = THISFORM.A2266CAuCo
               Gx_err = GX_DB_SetStr( HStmt_T023314,3,AuxA2266CAuCo,4,0)
               THISFORM.A2266CAuCo = AuxA2266CAuCo
               AuxA2272AusFc = THISFORM.A2272AusFc
               Gx_err = GX_DB_SetDate( HStmt_T023314,4,@AuxA2272AusFc,0)
               THISFORM.A2272AusFc = AuxA2272AusFc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T023314) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T023314 = Gx_err
               THISFORM.GX_DB_GetT023314_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T023314 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T023314) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T023314 = Gx_err
                  THISFORM.GX_DB_GetT023314_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T023314 <> 101
               BRK6H332 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT233Tb21.cCT233Pg22Tb21.cCT233S30.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T023314) ,  ,  ,  , CS_SQLSRV , 0 )
