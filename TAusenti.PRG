      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T023314" , @HStmt_T023314 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TAUSENTI","T023314","",GX_CURSOR_TYPE_READONLY,@HStmt_T023314) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TraCod], [CAuCod], [AusFch], [AusDoc] FROM [AUSENTI1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [TraCod] = ? AND [CAuCod] = ? AND [AusFch] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [TraCod], [CAuCod], [AusFch], [AusDoc]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T023314,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T023314,5)
                  THISFORM.GX_DB_BindColsT023314_01 ()
                  THISFORM.GX_DB_BindParmT023314_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T023314,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
