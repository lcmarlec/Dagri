               Gx_err = GX_DB_SetLong( HStmt_T029113,3,@AuxA2543SldEP,0)
               THISFORM.A2543SldEP = AuxA2543SldEP
               AuxA2544SldSe = THISFORM.A2544SldSe
               Gx_err = GX_DB_SetInt( HStmt_T029113,4,@AuxA2544SldSe,0)
               THISFORM.A2544SldSe = AuxA2544SldSe
               AuxA561TraCod = THISFORM.A561TraCod
               Gx_err = GX_DB_SetInt( HStmt_T029113,5,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T029113) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T029113 = Gx_err
               THISFORM.T02912 = iif( THISFORM.T029113 = 0 , 104 , THISFORM.T029113 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T029113) ,  ,  ,  , CS_SQLSRV , 0 )
