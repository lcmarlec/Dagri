                  cmdbuf = cmdbuf + "  [SldSec] = ? AND [TraCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T029113,cmdbuf)
                  THISFORM.GX_DB_BindParmT029113_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T029113,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T029113,2,@AuxA76BcoCta,0)
