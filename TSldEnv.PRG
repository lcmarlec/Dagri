               AuxA561TraCod = THISFORM.A561TraCod
               Gx_err = GX_DB_SetInt( HStmt_T029112,5,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T029112) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T029112 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T029112) ,  ,  ,  , CS_SQLSRV , 0 )
