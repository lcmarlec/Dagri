                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02774) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02774 = Gx_err
               THISFORM.GX_DB_GetT02774_01 ()
               DO WHILE THISFORM.T02774 = 0
                  THISFORM.A2658CUIT = THISFORM.Buf_T02774_2658CUIT
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02774) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02774 = Gx_err
                  THISFORM.GX_DB_GetT02774_01 ()
               ENDDO
               AuxA2658CUIT = THISFORM.A2658CUIT
               Gx_err = GX_DB_SetDouble( HStmt_T02774,1,@AuxA2658CUIT,0)
               THISFORM.A2658CUIT = AuxA2658CUIT
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02774) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02774 = Gx_err
               THISFORM.GX_DB_GetT02774_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2658CUIT = THISFORM.Buf_T02774_2658CUIT
