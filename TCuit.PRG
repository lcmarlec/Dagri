               ENDDO
               THISFORM.T02774 = Gx_err
               THISFORM.GX_DB_GetT02774_01 ()
               DO WHILE THISFORM.T02774 = 0 .AND. THISFORM.A2658CUIT >= THISFORM.Buf_T02774_2658CUIT
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02774) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
