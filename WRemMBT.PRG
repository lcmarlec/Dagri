      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06982" , @HStmt_W06982 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREMMBT","W06982","",GX_CURSOR_TYPE_READONLY,@HStmt_W06982) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntCod], [EntGruTip], [RemObs], [RemEst], [RemNro], [RemSuc], [RemSer], "
                  cmdbuf = cmdbuf + "  [RemTip], [RemFch], [RemNI] FROM [REMMBT] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND ([RemFch] >= ?) ORDER BY [EmpCod], [RemNI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06982,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06982,11)
                  THISFORM.GX_DB_BindColsW06982_01 ()
                  THISFORM.GX_DB_BindParmW06982_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06982,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06982,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06982 = Gx_err
               THISFORM.GX_DB_GetW06982_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WRemMBT"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06982 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06982) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06982 = Gx_err
                  THISFORM.GX_DB_GetW06982_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06982 <> 101
               BRKVJE2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W06982_2EmpCod
               THISFORM.A120EntCod = THISFORM.Buf_W06982_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W06982_150EntGruTip
               THISFORM.A2138RemOb = Gx_lvchar_to_char( THISFORM.Buf_W06982_2138RemObs )
               THISFORM.A2139RemEs = THISFORM.Buf_W06982_2139RemEst
               THISFORM.A2134RemNr = THISFORM.Buf_W06982_2134RemNro
               THISFORM.A2133RemSu = THISFORM.Buf_W06982_2133RemSuc
               THISFORM.A2132RemSe = THISFORM.Buf_W06982_2132RemSer
               THISFORM.A2131RemTi = THISFORM.Buf_W06982_2131RemTip
               THISFORM.A2135RemFc = THISFORM.Buf_W06982_2135RemFch
               THISFORM.A2130RemNI = THISFORM.Buf_W06982_2130RemNI
               GX_SFLOAD = 0
               THISFORM.U19VJE2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06982 = Gx_err
               THISFORM.GX_DB_GetW06982_01 ()
            ENDDO
         ENDIF
