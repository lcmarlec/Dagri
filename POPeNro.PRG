                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"POPENRO","P010211","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P010211) ,  ,  ,  , CS_SQLSRV ,  )
