                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_P010211,cmdbuf)
                  GX_DB_BindParmP010211_01 ()
               ENDIF
               Gx_err = GX_DB_SetInt( HStmt_P010211,1,@R735OpeEst,0)
               Gx_err = GX_DB_SetInt( HStmt_P010211,2,@A2EmpCod,0)
