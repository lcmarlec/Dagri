               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
               IF UserCancel
                  EXIT
               ENDIF
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P01029) ,  ,  ,  , CS_SQLSRV ,  )
            LEVEL6 = .F.
         ENDIF
      ENDIF
   ENDIF
