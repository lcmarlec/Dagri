      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU17V0T2()
            RETURN .T.
         ENDIF
         IF UPPER( "Factor" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU18V0T2()
            RETURN .T.
         ENDIF
         IF UPPER( "Buscar " ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14V0T2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver D/V" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15V0T2()
            RETURN .T.
         ENDIF
         IF UPPER( "Cobrar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13V0T2()
            RETURN .T.
         ENDIF
         IF UPPER( "Obs. Clte. " ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16V0T2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
