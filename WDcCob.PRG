      ***********************
      PROCEDURE cCW29V5.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW29V5.ISVALID" )
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00293" , @HStmt_W00293 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCOB","W00293","",GX_CURSOR_TYPE_READONLY,@HStmt_W00293) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[RCVNroLin], T1.[RCVNroI], T1.[RCVNroIImp], T1.[EmpCod], T2.[RCVFch], T2.[RCVTip] "
            cmdbuf = cmdbuf + "  FROM ([RECIBOS1] T1 (NOLOCK) LEFT JOIN [RECIBOS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
            cmdbuf = cmdbuf + "  AND T2.[RCVNroI] = T1.[RCVNroI]) WHERE (T1.[EmpCod] = ?) AND (T2.[RCVFch] > ?) AND "
            cmdbuf = cmdbuf + "  (T2.[RCVTip] = 'RCVT') ORDER BY T1.[EmpCod], T1.[RCVNroI], T1.[RCVNroLin]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00293,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00293,15)
            THISFORM.GX_DB_BindColsW00293_01 ()
            THISFORM.GX_DB_BindParmW00293_01 ()
         ENDIF
         AuxAV7Emprcod = THISFORM.AV7Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00293,1,@AuxAV7Emprcod,0)
         THISFORM.AV7Emprcod = AuxAV7Emprcod
         AuxAV5Fechasi = THISFORM.AV5Fechasi
         THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00293,2,@AuxAV5Fechasi,0)
         THISFORM.AV5Fechasi = AuxAV5Fechasi
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00293) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00293 = Gx_err
         THISFORM.GX_DB_GetW00293_01 ()
         DO WHILE THISFORM.W00293 <> 101
            THISFORM.A858RCVNro = THISFORM.Buf_W00293_858RCVNroI
            THISFORM.A870RCVNro = THISFORM.Buf_W00293_870RCVNroIImp
            THISFORM.A2EmpCod = THISFORM.Buf_W00293_2EmpCod
            THISFORM.A859RCVFch = THISFORM.Buf_W00293_859RCVFch
            THISFORM.A865RCVTip = THISFORM.Buf_W00293_865RCVTip
            THISFORM.A859RCVFch = THISFORM.Buf_W00293_859RCVFch
            THISFORM.A865RCVTip = THISFORM.Buf_W00293_865RCVTip
            IF THISFORM.A870RCVNro = THISFORM.A415DcVNro
               DO GX_ERRMW WITH "Existen recibos posteriores a la fecha"
               THISFORM.AV5Fechasi = THISFORM.A859RCVFch
               THISFORM.cCW29V5.GXSetFocus( )
               * Exit For each command. Update data (if necessary), close cursors & exit.
               EXIT
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00293) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W00293 = Gx_err
            THISFORM.GX_DB_GetW00293_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00293) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV5Fechasi > THISFORM.AV37Fecha
            DO GX_ERRMW WITH "No se puede generar recibos con fecha posterior al del sistema"
            THISFORM.AV5Fechasi = THISFORM.AV37Fecha
            THISFORM.cCW29V5.GXSetFocus( )
         ENDIF
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

