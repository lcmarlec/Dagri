               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04302,5,@AuxAV9C1345,0)
               THISFORM.AV9C1345 = AuxAV9C1345
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04302,6,PADR( TRIM(THISFORM.AV10C1347),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C1347),40, '%')),0)
               AuxAV11C1348 = THISFORM.AV11C1348
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04302,7,@AuxAV11C1348,0)
               THISFORM.AV11C1348 = AuxAV11C1348
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04302) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04302 = Gx_err
               THISFORM.GX_DB_GetW04302_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04302 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04302) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04302 = Gx_err
                  THISFORM.GX_DB_GetW04302_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04302 <> 101
               BRKVBY2 = .F.
               THISFORM.A1345AsiNr = THISFORM.Buf_W04302_1345AsiNro
               THISFORM.A1347AsiTi = THISFORM.Buf_W04302_1347AsiTit
               THISFORM.A1346AsiNr = THISFORM.Buf_W04302_1346AsiNroInt
               THISFORM.A1348AsiFc = THISFORM.Buf_W04302_1348AsiFch
               THISFORM.A1344AsiCo = THISFORM.Buf_W04302_1344AsiCod
               THISFORM.A548EjeNro = THISFORM.Buf_W04302_548EjeNro
               THISFORM.A2EmpCod = THISFORM.Buf_W04302_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VBY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04302) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04302 = Gx_err
               THISFORM.GX_DB_GetW04302_01 ()
            ENDDO
         ENDIF
      ENDPROC
