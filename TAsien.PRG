      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T013418" , @HStmt_T013418 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TASIEN","T013418","",GX_CURSOR_TYPE_READONLY,@HStmt_T013418) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EjeNro], [AsiCod], [AsiNroInt], [AsiItNro], [CtaNro], [AsiItDes], "
                  cmdbuf = cmdbuf + "  [AsiItDbOri], [AsiItHbOri], [AsiItDbSis], [AsiItHbSis] FROM [ASIEN1] (NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? AND [EjeNro] = ? AND [AsiCod] = ? AND [AsiNroInt] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [EjeNro], [AsiCod], [AsiNroInt], [AsiItNro]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T013418,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T013418,9)
                  THISFORM.GX_DB_BindColsT013418_01 ()
                  THISFORM.GX_DB_BindParmT013418_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T013418,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA548EjeNro = THISFORM.A548EjeNro
               Gx_err = GX_DB_SetLong( HStmt_T013418,2,@AuxA548EjeNro,0)
               THISFORM.A548EjeNro = AuxA548EjeNro
               AuxA1344AsiCo = THISFORM.A1344AsiCo
               Gx_err = GX_DB_SetInt( HStmt_T013418,3,@AuxA1344AsiCo,0)
               THISFORM.A1344AsiCo = AuxA1344AsiCo
               AuxA1346AsiNr = THISFORM.A1346AsiNr
               Gx_err = GX_DB_SetLong( HStmt_T013418,4,@AuxA1346AsiNr,0)
               THISFORM.A1346AsiNr = AuxA1346AsiNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T013418) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013418 = Gx_err
               THISFORM.GX_DB_GetT013418_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T013418 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013418) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T013418 = Gx_err
                  THISFORM.GX_DB_GetT013418_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T013418 <> 101
               BRK3Q161 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT134S38.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013418) ,  ,  ,  , CS_SQLSRV , 0 )
