         THISFORM.AV26Moneda = 0
         THISFORM.AV28Vdrcod = THISFORM.AV29Vvdrco
         IF THISFORM.AV29Vvdrco > 0
            THISFORM.AV38GXLvl1 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04814" , @HStmt_W04814 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLCHQC","W04814","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W04814) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [VdrCod], [VdrNom] FROM [VEND] (NOLOCK) WHERE [EmpCod] = ? and [VdrCod] "
               cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [VdrCod]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04814,cmdbuf)
               THISFORM.GX_DB_BindColsW04814_01 ()
               THISFORM.GX_DB_BindParmW04814_01 ()
            ENDIF
            AuxAV8Emprcod = THISFORM.AV8Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04814,1,@AuxAV8Emprcod,0)
            THISFORM.AV8Emprcod = AuxAV8Emprcod
            AuxAV28Vdrcod = THISFORM.AV28Vdrcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04814,2,@AuxAV28Vdrcod,0)
            THISFORM.AV28Vdrcod = AuxAV28Vdrcod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04814) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W04814 = Gx_err
            THISFORM.GX_DB_GetW04814_01 ()
            DO WHILE THISFORM.W04814 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W04814_2EmpCod
               THISFORM.A1037VdrCo = THISFORM.Buf_W04814_1037VdrCod
               THISFORM.A1038VdrNo = THISFORM.Buf_W04814_1038VdrNom
               THISFORM.AV38GXLvl1 = 1
               THISFORM.AV27Vdrnom = THISFORM.A1038VdrNo
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W04814) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV38GXLvl1 = 0
               THISFORM.AV27Vdrnom = "No Existe "
            ENDIF
            THISFORM.cCW481B20.Enabled = 0
         ENDIF
         THISFORM.AV31Que = 0
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
