         LOCAL gx_old_event
         THISFORM.SetEvent( "'SELECCIONAR'" )
         * 'Seleccionar' Routine
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV8Emprcod
         Aux3 = THISFORM.AV33Parval
         DO RParam WITH Aux0 , "PADRONTUC" , "CARPETA" , Aux3
         THISFORM.AV8Emprcod = Aux0
         THISFORM.AV33Parval = Aux3
         GX_rploop = .T.
         THISFORM.AV21Archiv = ALLTRIM( THISFORM.AV33Parval )
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV22Select
         Aux1 = THISFORM.AV21Archiv
         DO  gxnewfile  WITH Aux0 , Aux1 , "archivo" , "xlsx" , "Abrir"
         THISFORM.AV22Select = Aux0
         THISFORM.AV21Archiv = Aux1
         GX_rploop = .T.
         THISFORM.AV21Archiv = THISFORM.AV22Select
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

      ***********************
      PROCEDURE U13VRH2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'CONFIMAR'" )
         * 'Confimar' Routine
         DO CASE
            CASE THISFORM.AV23Que = "P"
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.AV21Archiv
               Aux2 = THISFORM.AV6Fechasi
               Aux3 = THISFORM.AV17Usuari
               DO PPadTuc WITH Aux0 , Aux1 , Aux2 , Aux3
               THISFORM.AV8Emprcod = Aux0
               THISFORM.AV21Archiv = Aux1
               THISFORM.AV6Fechasi = Aux2
               THISFORM.AV17Usuari = Aux3
               GX_rploop = .T.
            CASE THISFORM.AV23Que = "C"
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.AV21Archiv
               Aux2 = THISFORM.AV6Fechasi
               Aux3 = THISFORM.AV17Usuari
               DO PCoeTuc WITH Aux0 , Aux1 , Aux2 , Aux3
               THISFORM.AV8Emprcod = Aux0
               THISFORM.AV21Archiv = Aux1
               THISFORM.AV6Fechasi = Aux2
               THISFORM.AV17Usuari = Aux3
               GX_rploop = .T.
            OTHERWISE
               THISFORM.Refresh()
               DO GX_ERRMW WITH "Seleccione una Opción"
         ENDCASE
         IF THISFORM.AV24Caeaha = 1
            THISFORM.AV28Caeape = THISFORM.AV25Anio * 100 + THISFORM.AV26Mes
            THISFORM.AV29Caeaor = THISFORM.AV27Quin
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV8Emprcod
            Aux1 = THISFORM.AV6Fechasi
            Aux2 = THISFORM.AV17Usuari
            Aux3 = THISFORM.AV28Caeape
            Aux4 = THISFORM.AV29Caeaor
            Aux7 = THISFORM.AV32Respue
            DO PCAEA WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , 1 , 1 , Aux7
            THISFORM.AV8Emprcod = Aux0
            THISFORM.AV6Fechasi = Aux1
            THISFORM.AV17Usuari = Aux2
            THISFORM.AV28Caeape = Aux3
            THISFORM.AV29Caeaor = Aux4
            THISFORM.AV32Respue = Aux7
            GX_rploop = .T.
            IF THISFORM.AV32Respue = 0
               THISFORM.Refresh()
               DO GX_ERRMW WITH "No se pudo habilitar el CAEA"
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

      ***********************
      PROCEDURE cCW989V24.Click
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW989V24.CLICK" )
         IF THISFORM.AV24Caeaha = 1
            THISFORM.cCW989V26.Visible = 1
            THISFORM.cCW989V25.Visible = 1
