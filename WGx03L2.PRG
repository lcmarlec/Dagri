      PROCEDURE CreateTemp
         LOCAL SCW328S20
         SCW328S20 = ""
         IF USED( "SCW328S20" )
            SELECT SCW328S20
            SCW328S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW328S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1149Laba"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1150Laba"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1151Laba"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1153Laba"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1145Laba"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1152Laba"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW328S20 = GETE('z:\temp') + '\' + SCW328S20
            ENDIF
            CREATE DBF (SCW328S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW328S20) EXCLUSIVE ALIAS SCW328S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW328S20
         THIS.GX_SfAlias = "SCW328S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03282" , @HStmt_W03282 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX03L2","W03282","",GX_CURSOR_TYPE_READONLY,@HStmt_W03282) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [LabaNroInt], [LabaFNro], [LabaFSuc], [LabaFSer], [LabaTot], [LabaFTip], "
                  cmdbuf = cmdbuf + "  [LabaFFch], [LabaLgCod], [LabaEntCod], [LabaEntGru] FROM [LABAS1] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [LabaNroInt] = ?) AND ([LabaEntGru] like ?) AND "
                  cmdbuf = cmdbuf + "  ([LabaEntCod] >= ?) AND ([LabaLgCod] >= ?) AND ([LabaFFch] >= ?) AND ([LabaFTip] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [EmpCod], [LabaNroInt], [LabaEntGru], [LabaEntCod], [LabaLgCod], "
                  cmdbuf = cmdbuf + "  [LabaFFch], [LabaFTip], [LabaFSer], [LabaFSuc], [LabaFNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03282,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03282,9)
                  THISFORM.GX_DB_BindColsW03282_01 ()
                  THISFORM.GX_DB_BindParmW03282_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03282,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1140LabaN = THISFORM.A1140LabaN
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03282,2,@AuxA1140LabaN,0)
               THISFORM.A1140LabaN = AuxA1140LabaN
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03282,3,PADR( TRIM(THISFORM.AV5C1149),2, '%'),LEN(PADR( TRIM(THISFORM.AV5C1149),2, '%')),0)
               AuxAV6C1150 = THISFORM.AV6C1150
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03282,4,@AuxAV6C1150,0)
               THISFORM.AV6C1150 = AuxAV6C1150
               AuxAV7C1151 = THISFORM.AV7C1151
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03282,5,@AuxAV7C1151,0)
               THISFORM.AV7C1151 = AuxAV7C1151
               AuxAV8C1153 = THISFORM.AV8C1153
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03282,6,@AuxAV8C1153,0)
               THISFORM.AV8C1153 = AuxAV8C1153
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03282,7,PADR( TRIM(THISFORM.AV9C1145),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C1145),4, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03282) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03282 = Gx_err
               THISFORM.GX_DB_GetW03282_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03282 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03282) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03282 = Gx_err
                  THISFORM.GX_DB_GetW03282_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03282 <> 101
               BRKV942 = .F.
               THISFORM.A1148LabaF = THISFORM.Buf_W03282_1148LabaFNro
               THISFORM.A1147LabaF = THISFORM.Buf_W03282_1147LabaFSuc
               THISFORM.A1146LabaF = THISFORM.Buf_W03282_1146LabaFSer
               THISFORM.A1152LabaT = THISFORM.Buf_W03282_1152LabaTot
               THISFORM.A1145LabaF = THISFORM.Buf_W03282_1145LabaFTip
               THISFORM.A1153LabaF = THISFORM.Buf_W03282_1153LabaFFch
               THISFORM.A1151LabaL = THISFORM.Buf_W03282_1151LabaLgCod
               THISFORM.A1150LabaE = THISFORM.Buf_W03282_1150LabaEntCod
               THISFORM.A1149LabaE = THISFORM.Buf_W03282_1149LabaEntGru
               GX_SFLOAD = 0
               THISFORM.U12V942 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03282) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03282 = Gx_err
               THISFORM.GX_DB_GetW03282_01 ()
            ENDDO
         ENDIF
      ENDPROC
