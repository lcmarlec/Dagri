                  THISFORM.GX_DB_GetW00622_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00622 <> 101
               BRKV1Q2 = .F.
               THISFORM.A3FamCod = THISFORM.Buf_W00622_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W00622_4FamSubCod
               THISFORM.A5ArtCod = THISFORM.Buf_W00622_5ArtCod
               THISFORM.A150EntGru = THISFORM.Buf_W00622_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W00622_120EntCod
               THISFORM.A19ArtTip = THISFORM.Buf_W00622_19ArtTip
               THISFORM.A605For1Pr = THISFORM.Buf_W00622_605For1PrvTip
               THISFORM.A153EntRaz = THISFORM.Buf_W00622_153EntRaz
               THISFORM.A606For1Pr = THISFORM.Buf_W00622_606For1PrvCod
               THISFORM.A604For1Ct = THISFORM.Buf_W00622_604For1Ctr
               THISFORM.A603For1Me = THISFORM.Buf_W00622_603For1Mer
               THISFORM.A600For1Po = THISFORM.Buf_W00622_600For1Por
               THISFORM.A602For1As = THISFORM.Buf_W00622_602For1Asi
               THISFORM.A6ArtDsc = THISFORM.Buf_W00622_6ArtDsc
               THISFORM.A597For1Ar = THISFORM.Buf_W00622_597For1ArtCod
               THISFORM.A596For1Fa = THISFORM.Buf_W00622_596For1FamSub
               THISFORM.A595For1Fa = THISFORM.Buf_W00622_595For1FamCod
               THISFORM.A594ForDis = THISFORM.Buf_W00622_594ForDis
               THISFORM.A593ForCnt = THISFORM.Buf_W00622_593ForCnt
               THISFORM.A592ForArt = THISFORM.Buf_W00622_592ForArtTip
               THISFORM.A591ForFch = THISFORM.Buf_W00622_591ForFch
               THISFORM.A589ForArt = THISFORM.Buf_W00622_589ForArtDsc
               THISFORM.A592ForArt = THISFORM.Buf_W00622_592ForArtTip
               THISFORM.A589ForArt = THISFORM.Buf_W00622_589ForArtDsc
               THISFORM.A594ForDis = THISFORM.Buf_W00622_594ForDis
               THISFORM.A593ForCnt = THISFORM.Buf_W00622_593ForCnt
               THISFORM.A591ForFch = THISFORM.Buf_W00622_591ForFch
               THISFORM.A601For1Cn = THISFORM.A593ForCnt * THISFORM.A600For1Po / 100
               GX_SFLOAD = 0
               THISFORM.U13V1Q2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00622 = Gx_err
               THISFORM.GX_DB_GetW00622_01 ()
            ENDDO
         ENDIF
