      PROCEDURE CreateTemp
         LOCAL SCW979S20
         SCW979S20 = ""
         IF USED( "SCW979S20" )
            SELECT SCW979S20
            SCW979S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW979S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2970EtAL"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2971EtaE"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2972EtAL"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW979S20 = GETE('z:\temp') + '\' + SCW979S20
            ENDIF
            CREATE DBF (SCW979S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW979S20) EXCLUSIVE ALIAS SCW979S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW979S20
         THIS.GX_SfAlias = "SCW979S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09792" , @HStmt_W09792 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09I3","W09792","",GX_CURSOR_TYPE_READONLY,@HStmt_W09792) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EtAFch], [LiPrCod], [EtALote], [EtaElab], [ArtCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [FamCod], [EtALin] FROM [ETIART1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  [EtAFch] = ? and [LiPrCod] = ? and [EtALin] >= ?) AND ([FamCod] >= ?) AND ([FamSubCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ArtCod] >= ?) ORDER BY [EmpCod], [EtAFch], [LiPrCod], [EtALin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09792,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09792,9)
                  THISFORM.GX_DB_BindColsW09792_01 ()
                  THISFORM.GX_DB_BindParmW09792_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09792,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2969EtAFc = THISFORM.A2969EtAFc
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09792,2,@AuxA2969EtAFc,0)
               THISFORM.A2969EtAFc = AuxA2969EtAFc
               AuxA2867LiPrC = THISFORM.A2867LiPrC
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09792,3,AuxA2867LiPrC,4,0)
               THISFORM.A2867LiPrC = AuxA2867LiPrC
               AuxAV5C2970 = THISFORM.AV5C2970
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09792,4,@AuxAV5C2970,0)
               THISFORM.AV5C2970 = AuxAV5C2970
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09792,5,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09792,6,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               AuxAV8C5 = THISFORM.AV8C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09792,7,@AuxAV8C5,0)
               THISFORM.AV8C5 = AuxAV8C5
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09792 = Gx_err
               THISFORM.GX_DB_GetW09792_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09792 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09792) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09792 = Gx_err
                  THISFORM.GX_DB_GetW09792_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09792 <> 101
               BRKVR72 = .F.
               THISFORM.A2972EtALo = THISFORM.Buf_W09792_2972EtALote
               THISFORM.A2971EtaEl = THISFORM.Buf_W09792_2971EtaElab
               THISFORM.A5ArtCod = THISFORM.Buf_W09792_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W09792_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W09792_3FamCod
               THISFORM.A2970EtALi = THISFORM.Buf_W09792_2970EtALin
               GX_SFLOAD = 0
               THISFORM.U12VR72 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09792 = Gx_err
               THISFORM.GX_DB_GetW09792_01 ()
            ENDDO
         ENDIF
      ENDPROC
