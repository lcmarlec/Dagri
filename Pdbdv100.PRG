***********************
PROCEDURE EP100
***********************

   IF TYPE( "HConn_Default" ) = "N"
      IF GXCONNECTED
         Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
      ENDIF
   ENDIF
   DO CD100
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

***********************
PROCEDURE U11102
***********************

   * 'TIPODOCUMENTO' Routine
   DO CASE
      CASE val( RV13Tipdoc ) = 1
         RV13Tipdoc = "FCAN"
         RV14Serie = "A"
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 2
         RV13Tipdoc = "NCAN"
         RV14Serie = "A"
         RV16Signo = -1
      CASE val( RV13Tipdoc ) = 3
         RV13Tipdoc = "NDAN"
         RV14Serie = "A"
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 4
         RV13Tipdoc = "RCAN"
         RV14Serie = "X"
         RV16Signo = -1
      CASE val( RV13Tipdoc ) = 8
         RV13Tipdoc = "Retención "
         RV14Serie = "X"
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 11
         RV13Tipdoc = "FCMA"
         RV14Serie = "A"
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 12
         RV13Tipdoc = "NCMA"
         RV14Serie = "A"
         RV16Signo = -1
      CASE val( RV13Tipdoc ) = 13
         RV13Tipdoc = "NDMA"
         RV14Serie = "A"
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 21
         RV13Tipdoc = "FCAN"
         RV14Serie = "B"
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 31
         RV13Tipdoc = "TIAN"
         RV14Serie = " "
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 91
         RV13Tipdoc = "CAAN"
         RV14Serie = " "
         RV16Signo = 1
      CASE val( RV13Tipdoc ) = 6
         RV13Tipdoc = "NDPA"
         RV14Serie = "A"
         RV16Signo = -1
      OTHERWISE
         RV13Tipdoc = "FCEA"
         RV14Serie = "X"
         RV16Signo = 1
   ENDCASE
RETURN
