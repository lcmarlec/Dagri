      PROCEDURE CreateTemp
         LOCAL SCW923S14
         SCW923S14 = ""
         IF USED( "SCW923S14" )
            SELECT SCW923S14
            SCW923S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW923S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA346DcCNr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2832dccD"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW923S14 = GETE('z:\temp') + '\' + SCW923S14
            ENDIF
            CREATE DBF (SCW923S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW923S14) EXCLUSIVE ALIAS SCW923S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW923S14
         THIS.GX_SfAlias = "SCW923S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09232" , @HStmt_W09232 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX08Y0","W09232","",GX_CURSOR_TYPE_READONLY,@HStmt_W09232) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DccDrFch], [dccDrcod], [DcCNroInt], [EmpCod] FROM [DCCOM5] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ? and [DcCNroInt] >= ? and [dccDrcod] >= ?) AND ([DccDrFch] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [DcCNroInt], [dccDrcod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09232,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09232,9)
                  THISFORM.GX_DB_BindColsW09232_01 ()
                  THISFORM.GX_DB_BindParmW09232_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09232,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C346 = THISFORM.AV6C346
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09232,2,@AuxAV6C346,0)
               THISFORM.AV6C346 = AuxAV6C346
               AuxAV7C2832 = THISFORM.AV7C2832
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09232,3,@AuxAV7C2832,0)
               THISFORM.AV7C2832 = AuxAV7C2832
               AuxAV8C2834 = THISFORM.AV8C2834
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09232,4,@AuxAV8C2834,0)
               THISFORM.AV8C2834 = AuxAV8C2834
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09232 = Gx_err
               THISFORM.GX_DB_GetW09232_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09232 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09232) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09232 = Gx_err
                  THISFORM.GX_DB_GetW09232_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09232 <> 101
               BRKVPN2 = .F.
               THISFORM.A2834DccDr = THISFORM.Buf_W09232_2834DccDrFch
               THISFORM.A2832dccDr = THISFORM.Buf_W09232_2832dccDrcod
               THISFORM.A346DcCNro = THISFORM.Buf_W09232_346DcCNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W09232_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VPN2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09232 = Gx_err
               THISFORM.GX_DB_GetW09232_01 ()
            ENDDO
         ENDIF
      ENDPROC
