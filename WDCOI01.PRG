      ***********************
      PROCEDURE U12V102
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'INGRESAR'" )
         * 'Ingresar' Routine
         THISFORM.AV28Cantli = 0
         THISFORM.AV29Nroint = 0
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW36S20 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW36S20.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW36S20.SF (3, @GX_SFERR)
            THISFORM.cCW36S20 .SaveGridPos()
            IF THISFORM.AV30Opcion = "S"
               IF THISFORM.AV29Nroint = 0
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV8Emprcod
                  Aux1 = THISFORM.AV29Nroint
                  DO PSkNrI WITH Aux0 , Aux1
                  THISFORM.AV8Emprcod = Aux0
                  THISFORM.AV29Nroint = Aux1
                  THISFORM. cCW36S20 .RestoreGridPos()
                  GX_rploop = .T.
               ENDIF
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.AV29Nroint
               Aux2 = THISFORM.AV38Entcod
               Aux3 = THISFORM.A881RORNro
               Aux5 = THISFORM.AV6Fechasi
               Aux6 = THISFORM.AV17Usuari
               Aux7 = THISFORM.AV31Devuel
               DO PDCoFnc WITH Aux0 , Aux1 , Aux2 , Aux3 , 1 , Aux5 , Aux6 , Aux7
               THISFORM.AV8Emprcod = Aux0
               THISFORM.AV29Nroint = Aux1
               THISFORM.AV38Entcod = Aux2
               THISFORM.A881RORNro = Aux3
               THISFORM.AV6Fechasi = Aux5
               THISFORM.AV17Usuari = Aux6
               THISFORM.AV31Devuel = Aux7
               THISFORM. cCW36S20 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.AV28Cantli = THISFORM.AV28Cantli + 1
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW36S20 .RestoreGridPos()
               THISFORM.cCW36S20.SF (4, @GX_SFERR)
               THISFORM.cCW36S20.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW36S20 .ResetSavedGridPos()
         SELECT( THISFORM.cCW36S20 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW36S20.SF (3, @GX_SFERR)
         ENDIF
         IF THISFORM.AV28Cantli = 0
            THISFORM.SaveTblPos()
            DO Werrores WITH "No seleccionó Remitos ni Ordenes de Recepción " , "R"
            THISFORM. cCW36S20 .RestoreGridPos()
            GX_rploop = .T.
         ELSE
            THISFORM.ReleaseAll()
            RETURN
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

