      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16V102()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13V102()
            RETURN .T.
         ENDIF
         IF UPPER( "SkPrv" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15V102()
            RETURN .T.
         ENDIF
         IF UPPER( "Ingresar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12V102()
            RETURN .T.
         ENDIF
         IF UPPER( "Obs. Prov." ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14V102()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_FIRST"
            THISFORM.DoFirst
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_PREV"
            THISFORM.DoPrevious
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_NEXT"
