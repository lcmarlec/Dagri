      PROCEDURE CreateTemp
         LOCAL SCW36S20
         SCW36S20 = ""
         IF USED( "SCW36S20" )
            SELECT SCW36S20
            SCW36S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW36S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA886RORro"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 1
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA887RORSu"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 5
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA888RORNr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 9
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA889RORFc"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV30Opcio"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2EmpCod"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA881RORNr"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW36S20 = GETE('z:\temp') + '\' + SCW36S20
            ENDIF
            CREATE DBF (SCW36S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW36S20) EXCLUSIVE ALIAS SCW36S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW36S20
         THIS.GX_SfAlias = "SCW36S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00363" , @HStmt_W00363 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCOI01","W00363","",GX_CURSOR_TYPE_READONLY,@HStmt_W00363) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ROREst], [ROREntCod], [ROREntGruT], [EmpCod], [RORNroInt], [RORFch], [RORNro], "
                  cmdbuf = cmdbuf + "  [RORSuc], [RORror] FROM [REMING] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [ROREntGruT] "
                  cmdbuf = cmdbuf + "  = ? and [ROREntCod] = ? and [RORFch] >= ?) AND ([RORNro] > 0) AND ([ROREst] < 2 "
                  cmdbuf = cmdbuf + "  or [ROREst] = 5) AND ([RORror] <> 'P') ORDER BY [EmpCod], [ROREntGruT], [ROREntCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00363,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00363,14)
                  THISFORM.GX_DB_BindColsW00363_01 ()
                  THISFORM.GX_DB_BindParmW00363_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00363,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV32Entgru = THISFORM.AV32Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00363,2,AuxAV32Entgru,2,0)
               THISFORM.AV32Entgru = AuxAV32Entgru
               AuxAV21Entcod = THISFORM.AV21Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00363,3,@AuxAV21Entcod,0)
               THISFORM.AV21Entcod = AuxAV21Entcod
               AuxAV39Rorfch = THISFORM.AV39Rorfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00363,4,@AuxAV39Rorfch,0)
               THISFORM.AV39Rorfch = AuxAV39Rorfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00363) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00363 = Gx_err
               THISFORM.GX_DB_GetW00363_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV42Pgmnam = "WDCOI01"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00363 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00363) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00363 = Gx_err
                  THISFORM.GX_DB_GetW00363_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00363 <> 101
               BRKV102 = .F.
               THISFORM.AV30Opcion = SPACE(1)
               THISFORM.A891ROREst = THISFORM.Buf_W00363_891ROREst
               THISFORM.A884ROREnt = THISFORM.Buf_W00363_884ROREntCod
               THISFORM.A883ROREnt = THISFORM.Buf_W00363_883ROREntGruT
               THISFORM.A2EmpCod = THISFORM.Buf_W00363_2EmpCod
               THISFORM.A881RORNro = THISFORM.Buf_W00363_881RORNroInt
               THISFORM.A889RORFch = THISFORM.Buf_W00363_889RORFch
               THISFORM.A888RORNro = THISFORM.Buf_W00363_888RORNro
               THISFORM.A887RORSuc = THISFORM.Buf_W00363_887RORSuc
               THISFORM.A886RORror = THISFORM.Buf_W00363_886RORror
               GX_SFLOAD = 0
               THISFORM.U17V102 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00363) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00363 = Gx_err
               THISFORM.GX_DB_GetW00363_01 ()
            ENDDO
         ENDIF
      ENDPROC
