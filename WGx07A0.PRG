      PROCEDURE CreateTemp
         LOCAL SCW768S16
         SCW768S16 = ""
         IF USED( "SCW768S16" )
            SELECT SCW768S16
            SCW768S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW768S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA2299SCoC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2300ScoD"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW768S16 = GETE('z:\temp') + '\' + SCW768S16
            ENDIF
            CREATE DBF (SCW768S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW768S16) EXCLUSIVE ALIAS SCW768S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW768S16
         THIS.GX_SfAlias = "SCW768S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07682" , @HStmt_W07682 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07A0","W07682","",GX_CURSOR_TYPE_READONLY,@HStmt_W07682) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ScoDir], [ScoContact], [ScoTel], [ScoDsc], [SCoCod] FROM [SINDICAT] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([SCoCod] >= ?) AND ([ScoDsc] like ?) AND ([ScoDir] like ?) AND ([ScoContact] "
                  cmdbuf = cmdbuf + "  like ?) AND ([ScoTel] like ?) ORDER BY [SCoCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07682,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07682,9)
                  THISFORM.GX_DB_BindColsW07682_01 ()
                  THISFORM.GX_DB_BindParmW07682_01 ()
               ENDIF
               AuxAV5C2299 = THISFORM.AV5C2299
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07682,1,@AuxAV5C2299,0)
               THISFORM.AV5C2299 = AuxAV5C2299
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07682,2,PADR( TRIM(THISFORM.AV6C2300),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C2300),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07682,3,PADR( TRIM(THISFORM.AV7C2301),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C2301),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07682,4,PADR( TRIM(THISFORM.AV8C2302),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C2302),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07682,5,PADR( TRIM(THISFORM.AV9C2303),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C2303),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07682 = Gx_err
               THISFORM.GX_DB_GetW07682_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07682 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07682) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07682 = Gx_err
                  THISFORM.GX_DB_GetW07682_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07682 <> 101
               BRKVLC2 = .F.
               THISFORM.A2301ScoDi = THISFORM.Buf_W07682_2301ScoDir
               THISFORM.A2302ScoCo = THISFORM.Buf_W07682_2302ScoContact
               THISFORM.A2303ScoTe = THISFORM.Buf_W07682_2303ScoTel
               THISFORM.A2300ScoDs = THISFORM.Buf_W07682_2300ScoDsc
               THISFORM.A2299SCoCo = THISFORM.Buf_W07682_2299SCoCod
               GX_SFLOAD = 0
               THISFORM.U12VLC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07682 = Gx_err
               THISFORM.GX_DB_GetW07682_01 ()
            ENDDO
         ENDIF
      ENDPROC
