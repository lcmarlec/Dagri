                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01462) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01462 = Gx_err
                  THISFORM.GX_DB_GetW01462_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01462 <> 101
               BRKV422 = .F.
               THISFORM.A68EmpNom = THISFORM.Buf_W01462_68EmpNom
               THISFORM.A2EmpCod = THISFORM.Buf_W01462_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U14V422 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01462 = Gx_err
               THISFORM.GX_DB_GetW01462_01 ()
            ENDDO
         ENDIF
      ENDPROC
