      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04623" , @HStmt_W04623 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WVERASI0","W04623","",GX_CURSOR_TYPE_READONLY,@HStmt_W04623) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[PCtaNro], T1.[EmpCod], T1.[EjeNro], T1.[AsiCod], T1.[AsiNroInt], T1.[AsiItHbOri], "
                  cmdbuf = cmdbuf + "  T1.[AsiItDbOri], T1.[AsiItDes], T3.[CtaDes], T1.[CtaNro], T1.[AsiItNro], T4.[AsiMonCod], "
                  cmdbuf = cmdbuf + "  T4.[AsiFch], T4.[AsiTit], T4.[AsiNro] FROM ((([ASIEN1] T1 (NOLOCK) LEFT JOIN [EJE] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EjeNro] = T1.[EjeNro]) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [CTA00] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[PCtaNro] = T2.[PCtaNro] "
                  cmdbuf = cmdbuf + "  AND T3.[CtaNro] = T1.[CtaNro]) LEFT JOIN [ASIEN] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T4.[EjeNro] = T1.[EjeNro] AND T4.[AsiCod] = T1.[AsiCod] AND T4.[AsiNroInt] = "
                  cmdbuf = cmdbuf + "  T1.[AsiNroInt]) WHERE T1.[EmpCod] = ? and T1.[EjeNro] = ? and T1.[AsiCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[AsiNroInt] = ? ORDER BY T1.[EmpCod], T1.[EjeNro], T1.[AsiCod], T1.[AsiNroInt] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04623,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04623,12)
                  THISFORM.GX_DB_BindColsW04623_01 ()
                  THISFORM.GX_DB_BindParmW04623_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04623,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA548EjeNro = THISFORM.A548EjeNro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04623,2,@AuxA548EjeNro,0)
               THISFORM.A548EjeNro = AuxA548EjeNro
               AuxA1344AsiCo = THISFORM.A1344AsiCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04623,3,@AuxA1344AsiCo,0)
               THISFORM.A1344AsiCo = AuxA1344AsiCo
               AuxA1346AsiNr = THISFORM.A1346AsiNr
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04623,4,@AuxA1346AsiNr,0)
               THISFORM.A1346AsiNr = AuxA1346AsiNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04623) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04623 = Gx_err
               THISFORM.GX_DB_GetW04623_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WVerAsi0"
               THISFORM.Gx_err = 0
               THISFORM.VEVCU1361 ( THISFORM.A2EmpCod , THISFORM.A548EjeNro , THISFORM.A1344AsiCo , THISFORM.A1346AsiNr )
               THISFORM. cCW462A1361 .Refresh()
               THISFORM. cCW462A1360 .Refresh()
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04623 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04623) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04623 = Gx_err
                  THISFORM.GX_DB_GetW04623_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04623 <> 101
               BRKVCU2 = .F.
               THISFORM.A198PCtaNr = THISFORM.Buf_W04623_198PCtaNro
               THISFORM.A1357AsiIt = THISFORM.Buf_W04623_1357AsiItHbOri
               THISFORM.A1356AsiIt = THISFORM.Buf_W04623_1356AsiItDbOri
               THISFORM.A1355AsiIt = THISFORM.Buf_W04623_1355AsiItDes
               THISFORM.A200CtaDes = THISFORM.Buf_W04623_200CtaDes
               THISFORM.A199CtaNro = THISFORM.Buf_W04623_199CtaNro
               THISFORM.A1353AsiIt = THISFORM.Buf_W04623_1353AsiItNro
