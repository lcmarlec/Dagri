      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "Sistemas" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VCU2()
            RETURN .T.
         ENDIF
         IF UPPER( "confirma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VCU2()
            RETURN .T.
         ENDIF
         IF UPPER( "salir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VCU2()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VCU2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver Detalle" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VCU2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_FIRST"
            THISFORM.DoFirst
            RETURN .T.
