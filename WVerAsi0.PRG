               THISFORM.A1347AsiTi = THISFORM.Buf_W04623_1347AsiTit
               THISFORM.A1345AsiNr = THISFORM.Buf_W04623_1345AsiNro
               GX_SFLOAD = 0
               THISFORM.U17VCU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
