      ***********************
      PROCEDURE cCW445V27.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW445V27.ISVALID" )
         IF THISFORM.AV27Entcod = 0
            THISFORM.AV28Entraz = "Todos"
         ELSE
            THISFORM.AV33GXLvl5 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04453" , @HStmt_W04453 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLIIBBC","W04453","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W04453) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [EntCod], [EntGruTip], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
               cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
               cmdbuf = cmdbuf + "   "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04453,cmdbuf)
               THISFORM.GX_DB_BindColsW04453_01 ()
               THISFORM.GX_DB_BindParmW04453_01 ()
            ENDIF
            AuxAV8Emprcod = THISFORM.AV8Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04453,1,@AuxAV8Emprcod,0)
            THISFORM.AV8Emprcod = AuxAV8Emprcod
            AuxAV29Entgru = THISFORM.AV29Entgru
            THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04453,2,AuxAV29Entgru,2,0)
            THISFORM.AV29Entgru = AuxAV29Entgru
            AuxAV27Entcod = THISFORM.AV27Entcod
            THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04453,3,@AuxAV27Entcod,0)
            THISFORM.AV27Entcod = AuxAV27Entcod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04453) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W04453 = Gx_err
            THISFORM.GX_DB_GetW04453_01 ()
            DO WHILE THISFORM.W04453 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W04453_2EmpCod
               THISFORM.A120EntCod = THISFORM.Buf_W04453_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W04453_150EntGruTip
               THISFORM.A153EntRaz = THISFORM.Buf_W04453_153EntRaz
               THISFORM.AV33GXLvl5 = 1
               THISFORM.AV28Entraz = THISFORM.A153EntRaz
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W04453) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV33GXLvl5 = 0
               THISFORM.AV28Entraz = "No Existe"
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

