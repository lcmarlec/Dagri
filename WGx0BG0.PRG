      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12442" , @HStmt_W12442 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0BG0","W12442","",GX_CURSOR_TYPE_READONLY,@HStmt_W12442) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ISDNro], [ISDCuoAni], [ISDSuc], [IsdSer], [ISDTip], [ISId], [EntCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [ISDOC] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([EntGruTip] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EntCod] >= ?) AND ([ISId] >= ?) AND ([ISDTip] like ?) AND ([IsdSer] "
                  cmdbuf = cmdbuf + "  like ?) AND ([ISDSuc] >= ?) ORDER BY [EmpCod], [EntGruTip], [EntCod], [ISId], [ISDTip], "
                  cmdbuf = cmdbuf + "  [IsdSer], [ISDSuc], [ISDNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12442,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12442,9)
                  THISFORM.GX_DB_BindColsW12442_01 ()
                  THISFORM.GX_DB_BindParmW12442_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12442,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12442,2,PADR( TRIM(THISFORM.AV6C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C150),2, '%')),0)
               AuxAV7C120 = THISFORM.AV7C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12442,3,@AuxAV7C120,0)
               THISFORM.AV7C120 = AuxAV7C120
               AuxAV8C3607 = THISFORM.AV8C3607
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12442,4,@AuxAV8C3607,0)
               THISFORM.AV8C3607 = AuxAV8C3607
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12442,5,PADR( TRIM(THISFORM.AV9C3611),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C3611),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12442,6,PADR( TRIM(THISFORM.AV10C3612),1, '%'),LEN(PADR( TRIM(THISFORM.AV10C3612),1, '%')),0)
               AuxAV11C3613 = THISFORM.AV11C3613
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12442,7,@AuxAV11C3613,0)
               THISFORM.AV11C3613 = AuxAV11C3613
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12442 = Gx_err
               THISFORM.GX_DB_GetW12442_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12442 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12442) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12442 = Gx_err
                  THISFORM.GX_DB_GetW12442_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12442 <> 101
               BRKVYK2 = .F.
               THISFORM.A3614ISDNr = THISFORM.Buf_W12442_3614ISDNro
               THISFORM.A3618ISDCu = THISFORM.Buf_W12442_3618ISDCuoAni
               THISFORM.A3613ISDSu = THISFORM.Buf_W12442_3613ISDSuc
               THISFORM.A3612IsdSe = THISFORM.Buf_W12442_3612IsdSer
               THISFORM.A3611ISDTi = THISFORM.Buf_W12442_3611ISDTip
               THISFORM.A3607ISId = THISFORM.Buf_W12442_3607ISId
               THISFORM.A120EntCod = THISFORM.Buf_W12442_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W12442_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W12442_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VYK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12442 = Gx_err
               THISFORM.GX_DB_GetW12442_01 ()
            ENDDO
         ENDIF
