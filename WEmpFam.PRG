      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09312" , @HStmt_W09312 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMPFAM","W09312","",GX_CURSOR_TYPE_READONLY,@HStmt_W09312) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[TraCod], T2.[TraNom], T1.[TrafObs], T1.[TraFEC], T1.[TraFFNa], "
                  cmdbuf = cmdbuf + "  T1.[TraFNom], T1.[TraFNDoc], T1.[TraFTd], T1.[TRaFTip] FROM ([EMPLFAM] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [EMPLEADO] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TraCod] "
                  cmdbuf = cmdbuf + "  = T1.[TraCod]) WHERE T1.[EmpCod] = ? and T1.[TraCod] = ? ORDER BY T1.[EmpCod], T1.[TraCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09312,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09312,10)
                  THISFORM.GX_DB_BindColsW09312_01 ()
                  THISFORM.GX_DB_BindParmW09312_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09312,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09312,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09312 = Gx_err
               THISFORM.GX_DB_GetW09312_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV10Pgmnam = "WEmpFam"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09312 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09312) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09312 = Gx_err
                  THISFORM.GX_DB_GetW09312_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09312 <> 101
               BRKVPV2 = .F.
               THISFORM.A564TraNom = THISFORM.Buf_W09312_564TraNom
