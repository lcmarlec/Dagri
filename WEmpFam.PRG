               THISFORM.A2841TraFT = THISFORM.Buf_W09312_2841TraFTd
               THISFORM.A2840TRaFT = THISFORM.Buf_W09312_2840TRaFTip
               THISFORM.A564TraNom = THISFORM.Buf_W09312_564TraNom
               GX_SFLOAD = 0
               THISFORM.U17VPV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
