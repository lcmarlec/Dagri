      PROCEDURE FormRefresh
         LPARAMETER gx_SetFocus, gx_RefreshForm
         LOCAL gx_RecPos, gx_Ref, gx_old_event
         IF THISFORM.InRoutine("EXIT") .or. THISFORM.InRoutine("START") .or. ;
            THISFORM.InRoutine("LOAD") .or. THISFORM.InRoutine("GXGOTFOCUS") .or. THISFORM.GX_in_event
            RETURN
         ENDIF
         gx_old_event = THISFORM.GX_CurrentEvent
         gx_Ref = .F.
         IF THISFORM.GX_Refresh != 0
            gx_Ref = .T.
            IF THISFORM.GX_Refresh = 2
               THISFORM.gx_RefKeep = .T.
            ENDIF
            THISFORM.GX_Refresh = 0
            THISFORM. cCW1045S32 .GXRefreshSf( .F., .T.)
            THISFORM.gx_RefKeep = .F.
         ENDIF
         THISFORM. cCW1045S32 .GXSaveTempSf( GX_Ref )
         THISFORM.GX_CurrentEvent = gx_old_event
         IF (! THISFORM.InRoutine("EXIT") .and. ! THISFORM.InRoutine("ONLINEACTIVATE") .and. ! THISFORM.InRoutine("LOAD") .and. ! THISFORM.InRoutine("REFRESH") .and.;
            "" != THISFORM.GX_CurrentEvent) .or. gx_Ref
            THISFORM.Refresh
         ENDIF
      ENDPROC
