                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09922) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09922 = Gx_err
               THISFORM.GX_DB_GetW09922_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09922 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09922) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09922 = Gx_err
                  THISFORM.GX_DB_GetW09922_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09922 <> 101
               BRKVRK2 = .F.
               THISFORM.A2917McoCl = THISFORM.Buf_W09922_2917McoCli
               THISFORM.A2916McoIm = THISFORM.Buf_W09922_2916McoImp
               GX_SFLOAD = 1
               THISFORM.U13VRK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
         IF GX_CUERR != 0
            THISFORM.AV5Emprnom = SPACE(30)
            THISFORM.AV14Entraz = SPACE(40)
            THISFORM.A2917McoCl = 0
            THISFORM.A2916McoIm = 0.00
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
      RETURN .T.
