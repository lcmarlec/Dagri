         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00093" , @HStmt_W00093 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WAUTOUSU","W00093","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00093) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [AutNivel], [ObjCodAut], [UsuCod] FROM [AUT001] (NOLOCK) WHERE [UsuCod] "
            cmdbuf = cmdbuf + "  = ? and [ObjCodAut] = ? and [EmpCod] = ? ORDER BY [UsuCod], [ObjCodAut]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00093,cmdbuf)
            THISFORM.GX_DB_BindColsW00093_01 ()
            THISFORM.GX_DB_BindParmW00093_01 ()
         ENDIF
         AuxAV17Usucod = THISFORM.AV17Usucod
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00093,1,AuxAV17Usucod,10,0)
         THISFORM.AV17Usucod = AuxAV17Usucod
         AuxAV16Objcod = THISFORM.AV16Objcod
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00093,2,AuxAV16Objcod,8,0)
         THISFORM.AV16Objcod = AuxAV16Objcod
         AuxAV24Emprco = THISFORM.AV24Emprco
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00093,3,@AuxAV24Emprco,0)
         THISFORM.AV24Emprco = AuxAV24Emprco
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00093) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00093 = Gx_err
         THISFORM.GX_DB_GetW00093_01 ()
         DO WHILE THISFORM.W00093 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W00093_2EmpCod
            THISFORM.A74AutNive = THISFORM.Buf_W00093_74AutNivel
            THISFORM.A66ObjCodA = THISFORM.Buf_W00093_66ObjCodAut
            THISFORM.A64UsuCod = THISFORM.Buf_W00093_64UsuCod
            THISFORM.AV13Asig = THISFORM.A74AutNive
            THISFORM.AV32Nvoniv = THISFORM.A74AutNive
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00093) ,  ,  ,  , CS_SQLSRV ,  )
         IF ( THISFORM.AV13Asig = 0 .AND. THISFORM.AV15Ver = "-" ) .OR. THISFORM.AV15Ver = "TO" .OR. ( THISFORM.AV13Asig > 0 .AND. THISFORM.AV15Ver = "SI" )
            IF THISFORM.cCW9S12 .GX_rec_loaded >= 10000
               DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
               GX_SFLOAD = 2
            ELSE
               THISFORM.cCW9S12 .GX_rec_loaded =  THISFORM.cCW9S12 .GX_rec_loaded + 1
               SELECT( THISFORM.cCW9S12 .GX_SfAlias)
               GX_SFLOAD = 1
               APPEND BLANK
               THISFORM.cCW9S12 .SaveTemp()
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
