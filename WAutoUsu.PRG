      PROCEDURE CreateTemp
         LOCAL SCW9S12
         SCW9S12 = ""
         IF USED( "SCW9S12" )
            SELECT SCW9S12
            SCW9S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW9S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA680ObjCo"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA69ObjDsc"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 25
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA681ObjMo"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV13Asig"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV32Nvoni"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW9S12 = GETE('z:\temp') + '\' + SCW9S12
            ENDIF
            CREATE DBF (SCW9S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW9S12) EXCLUSIVE ALIAS SCW9S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW9S12
         THIS.GX_SfAlias = "SCW9S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00092" , @HStmt_W00092 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WAUTOUSU","W00092","",GX_CURSOR_TYPE_READONLY,@HStmt_W00092) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ObjMod], [ObjDsc], [ObjCod] FROM [OBJ001] (FASTFIRSTROW NOLOCK) WHERE ([ObjMod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 'TODOS') AND ([ObjCod] like ?) AND ([ObjDsc] like ?) ORDER BY [ObjCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00092,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00092,8)
                  THISFORM.GX_DB_BindColsW00092_01 ()
                  THISFORM.GX_DB_BindParmW00092_01 ()
               ENDIF
               AuxAV33Modulo = THISFORM.AV33Modulo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00092,1,AuxAV33Modulo,10,0)
               THISFORM.AV33Modulo = AuxAV33Modulo
               AuxAV33Modulo = THISFORM.AV33Modulo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00092,2,AuxAV33Modulo,10,0)
               THISFORM.AV33Modulo = AuxAV33Modulo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00092,3,PADR( TRIM(THISFORM.AV35Objeto),8, '%'),LEN(PADR( TRIM(THISFORM.AV35Objeto),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00092,4,PADR( TRIM(THISFORM.AV36Nombre),25, '%'),LEN(PADR( TRIM(THISFORM.AV36Nombre),25, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00092 = Gx_err
               THISFORM.GX_DB_GetW00092_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV42Pgmnam = "WAutoUsu"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00092 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00092) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00092 = Gx_err
                  THISFORM.GX_DB_GetW00092_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00092 <> 101
               BRKV092 = .F.
               THISFORM.AV32Nvoniv = 0
               THISFORM.A681ObjMod = THISFORM.Buf_W00092_681ObjMod
               THISFORM.A69ObjDsc = THISFORM.Buf_W00092_69ObjDsc
               THISFORM.A680ObjCod = THISFORM.Buf_W00092_680ObjCod
               GX_SFLOAD = 0
               THISFORM.U18V092 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00092 = Gx_err
               THISFORM.GX_DB_GetW00092_01 ()
            ENDDO
         ENDIF
      ENDPROC
