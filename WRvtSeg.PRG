            ENDIF
         ENDDO
         THISFORM.cCW499S16 .ResetSavedGridPos()
         SELECT( THISFORM.cCW499S16 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW499S16.SF (3, @GX_SFERR)
