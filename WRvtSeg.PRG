      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU24VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Controlar Remito" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver Remito" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver Factura" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU22VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Cambiar Ruta" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Listado" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Pasar a Pendiente" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Buscar Ruta" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU17VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Documento Sin Diferencias" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU18VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver Observacion" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU19VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Cambiar Observaciones" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU21VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "DesSeleccionar Todo" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU20VDV2()
            RETURN .T.
         ENDIF
         IF UPPER( "Obs. Clte." ) == UPPER(gx_evt_to_run)
            THISFORM.DoU23VDV2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
