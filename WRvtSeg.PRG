            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04993" , @HStmt_W04993 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTSEG","W04993","",GX_CURSOR_TYPE_READONLY,@HStmt_W04993) ,  ,  ,  , CS_SQLSRV ,  )
