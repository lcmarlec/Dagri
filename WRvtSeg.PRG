               cmdbuf = cmdbuf + "  FROM ([DCVENT1] T1 (NOLOCK) LEFT JOIN [DCVENT] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
               cmdbuf = cmdbuf + "  AND T2.[DcVNroInt] = T1.[DcVNroInt]) WHERE T1.[EmpCod] = ? and T1.[DcVRvtNi] = ? "
               cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[DcVRvtNi]  "
