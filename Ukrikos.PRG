      ControlSource = "THISFORM.AV9Archivo"
       ForeColor = GetSysColor(8)
       BackColor = GetSysColor(5)
       DisabledForeColor= RGB(127,127,127)
       DisabledBackColor = GetSysColor(5)
       FontName = "Courier New"
       FontSize = 9
       FontBold = .F.
      SpecialEffect = 0
      BackStyle = 1
      Alignment = 0
      HelpContextId = 262778
