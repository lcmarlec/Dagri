         Aux0 = THISFORM.AV15Select
         Aux1 = THISFORM.AV13Initpa
         Aux2 = THISFORM.AV14Extens
         Aux3 = THISFORM.AV12Captio
         Aux4 = THISFORM.AV10Buttca
         Aux5 = THISFORM.AV11Buttty
         DO  gxselfile  WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5
         THISFORM.AV15Select = Aux0
         THISFORM.AV13Initpa = Aux1
         THISFORM.AV14Extens = Aux2
         THISFORM.AV12Captio = Aux3
         THISFORM.AV10Buttca = Aux4
         THISFORM.AV11Buttty = Aux5
         GX_rploop = .T.
         THISFORM.AV9Archivo = THISFORM.AV15Select
