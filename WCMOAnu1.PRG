      PROCEDURE CreateTemp
         LOCAL SCW458S16
         SCW458S16 = ""
         IF USED( "SCW458S16" )
            SELECT SCW458S16
            SCW458S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW458S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA1253EchM"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1254EchM"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1255EchM"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA1456EchM"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA1256EchM"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW458S16 = GETE('z:\temp') + '\' + SCW458S16
            ENDIF
            CREATE DBF (SCW458S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW458S16) EXCLUSIVE ALIAS SCW458S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW458S16
         THIS.GX_SfAlias = "SCW458S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04582" , @HStmt_W04582 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCMOANU1","W04582","",GX_CURSOR_TYPE_READONLY,@HStmt_W04582) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[Moncod], T1.[EmpCod], T1.[ECHNroInt], T1.[EchMonCot], T1.[EchMonEgr], "
                  cmdbuf = cmdbuf + "  T1.[EchMOnImp], T2.[MonDsc], T1.[EchMonCod], T3.[EchEst], T3.[EchObs], T3.[ECHFch] "
                  cmdbuf = cmdbuf + "  FROM (([ENTCHE3] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) ON T2.[Moncod] "
                  cmdbuf = cmdbuf + "  = T1.[EchMonCod]) LEFT JOIN [ENTCHE] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[ECHNroInt] = T1.[ECHNroInt]) WHERE T1.[EmpCod] = ? and T1.[ECHNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[ECHNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04582,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04582,10)
                  THISFORM.GX_DB_BindColsW04582_01 ()
                  THISFORM.GX_DB_BindParmW04582_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04582,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04582,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04582 = Gx_err
               THISFORM.GX_DB_GetW04582_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WCMOAnu1"
               THISFORM.Gx_err = 0
               THISFORM.VEVCQ1102 ( THISFORM.A2EmpCod , THISFORM.A1083ECHNr )
               THISFORM. cCW458A1102 .Refresh()
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04582 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04582) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04582 = Gx_err
                  THISFORM.GX_DB_GetW04582_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04582 <> 101
               BRKVCQ2 = .F.
               THISFORM.A193Moncod = THISFORM.Buf_W04582_193Moncod
               THISFORM.A1256EchMo = THISFORM.Buf_W04582_1256EchMonCot
               THISFORM.A1456EchMo = THISFORM.Buf_W04582_1456EchMonEgr
               THISFORM.A1255EchMO = THISFORM.Buf_W04582_1255EchMOnImp
               THISFORM.A194MonDsc = THISFORM.Buf_W04582_194MonDsc
               THISFORM.A1253EchMo = THISFORM.Buf_W04582_1253EchMonCod
               THISFORM.A1265EchEs = THISFORM.Buf_W04582_1265EchEst
               THISFORM.A1087EchOb = THISFORM.Buf_W04582_1087EchObs
               THISFORM.A1139ECHFc = THISFORM.Buf_W04582_1139ECHFch
               THISFORM.A1265EchEs = THISFORM.Buf_W04582_1265EchEst
               THISFORM.A1087EchOb = THISFORM.Buf_W04582_1087EchObs
               THISFORM.A1139ECHFc = THISFORM.Buf_W04582_1139ECHFch
               GX_SFLOAD = 0
               THISFORM.U14VCQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04582 = Gx_err
               THISFORM.GX_DB_GetW04582_01 ()
            ENDDO
         ENDIF
      ENDPROC
