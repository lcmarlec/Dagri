      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S76BcoCta
         LOCAL S1688BcoCt
         S76BcoCta = THISFORM.A76BcoCta
         S1688BcoCt = THISFORM.A1688BcoCt
         THISFORM.A1688BcoCt = THISFORM.M1688BcoCt
         THISFORM. cCT164S27 .SaveTemp()
         THISFORM. cCT164S27 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT164S27 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT164S27 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT164S27 .SF( 3, @sf_err)     && Read
         Gx_fcond = S76BcoCta = THISFORM.A76BcoCta .AND. S1688BcoCt = THISFORM.A1688BcoCt
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT164S27 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT164S27 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S76BcoCta = THISFORM.A76BcoCta .AND. S1688BcoCt = THISFORM.A1688BcoCt
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT164S27 .Refresh()
               THISFORM. cCT164S27 .AfterRowColChange1()
               THISFORM.A76BcoCta = S76BcoCta
               THISFORM.A1688BcoCt = S1688BcoCt
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT164S27 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT164S27 .LoadRec(2, @sf_err)
            Gx_fcond = S76BcoCta = THISFORM.A76BcoCta .AND. S1688BcoCt = THISFORM.A1688BcoCt
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT164S27 .LoadRec(2, @sf_err)
               Gx_fcond = S76BcoCta = THISFORM.A76BcoCta .AND. S1688BcoCt = THISFORM.A1688BcoCt
            ENDDO
            IF sf_err != 0
               THISFORM. cCT164S27 .AppendRow()
               THISFORM. cCT164S27 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A76BcoCta = S76BcoCta
               THISFORM.A1688BcoCt = S1688BcoCt
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A76BcoCta = S76BcoCta
         THISFORM.A1688BcoCt = S1688BcoCt
         RETURN .F.
      ENDFUNC
