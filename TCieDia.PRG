      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T016414" , @HStmt_T016414 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCIEDIA","T016414","",GX_CURSOR_TYPE_READONLY,@HStmt_T016414) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [BcoCta], [BcoCtaCieD] FROM [CIEDIA] (NOLOCK) WHERE [BcoCta] = ? ORDER BY "
                  cmdbuf = cmdbuf + "  [BcoCta], [BcoCtaCieD]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T016414,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T016414,15)
                  THISFORM.GX_DB_BindColsT016414_01 ()
                  THISFORM.GX_DB_BindParmT016414_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T016414,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T016414) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T016414 = Gx_err
               THISFORM.GX_DB_GetT016414_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T016414 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T016414) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T016414 = Gx_err
                  THISFORM.GX_DB_GetT016414_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T016414 <> 101
               BRK4K191 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT164S27.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T016414_76BcoCta = THISFORM.A76BcoCta
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T016414) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T016414 = Gx_err
               THISFORM.GX_DB_GetT016414_01 ()
            ENDDO
         ENDIF
      ENDPROC
