      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T016412" , @HStmt_T016412 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCIEDIA","T016412","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T016412) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CIEDIA] ([BcoCta], [BcoCtaCieD]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T016412,cmdbuf)
                  THISFORM.GX_DB_BindParmT016412_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T016412,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxA1688BcoCt = THISFORM.A1688BcoCt
               Gx_err = GX_DB_SetDate( HStmt_T016412,2,@AuxA1688BcoCt,0)
               THISFORM.A1688BcoCt = AuxA1688BcoCt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T016412) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T016412 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T016412) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T016412 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T016413" , @HStmt_T016413 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCIEDIA","T016413","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T016413) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CIEDIA]  WHERE [BcoCta] = ? AND [BcoCtaCieD] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T016413,cmdbuf)
                  THISFORM.GX_DB_BindParmT016413_01 ()
               ENDIF
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T016413,1,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxA1688BcoCt = THISFORM.A1688BcoCt
               Gx_err = GX_DB_SetDate( HStmt_T016413,2,@AuxA1688BcoCt,0)
               THISFORM.A1688BcoCt = AuxA1688BcoCt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T016413) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T016413 = Gx_err
               THISFORM.T01642 = iif( THISFORM.T016413 = 0 , 104 , THISFORM.T016413 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T016413) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
         SELECT (THISFORM. cCT164S27 .GX_SfAlias)
         =TABLEUPDATE()
      RETURN .T.
