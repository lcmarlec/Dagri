      PROCEDURE CreateTemp
         LOCAL SCW365S20
         SCW365S20 = ""
         IF USED( "SCW365S20" )
            SELECT SCW365S20
            SCW365S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW365S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA795PedFc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA797PedGr"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA798PedEn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA802PedSu"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA801PedNu"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW365S20 = GETE('z:\temp') + '\' + SCW365S20
            ENDIF
            CREATE DBF (SCW365S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW365S20) EXCLUSIVE ALIAS SCW365S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW365S20
         THIS.GX_SfAlias = "SCW365S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03652" , @HStmt_W03652 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX03S0","W03652","",GX_CURSOR_TYPE_READONLY,@HStmt_W03652) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PedNro], [PedSec], [PedNumero], [PedSucCod], [PedEntCod], [PedGruTip], [PedFch], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [PEDIDO1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [PedFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PedGruTip] like ?) AND ([PedEntCod] >= ?) AND ([PedSucCod] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([PedSec] >= ?) AND ([PedNro] >= ?) ORDER BY [EmpCod], [PedFch], [PedGruTip], [PedEntCod], "
                  cmdbuf = cmdbuf + "  [PedSucCod], [PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03652,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03652,9)
                  THISFORM.GX_DB_BindColsW03652_01 ()
                  THISFORM.GX_DB_BindParmW03652_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03652,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C795 = THISFORM.AV6C795
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03652,2,@AuxAV6C795,0)
               THISFORM.AV6C795 = AuxAV6C795
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03652,3,PADR( TRIM(THISFORM.AV7C797),2, '%'),LEN(PADR( TRIM(THISFORM.AV7C797),2, '%')),0)
               AuxAV8C798 = THISFORM.AV8C798
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03652,4,@AuxAV8C798,0)
               THISFORM.AV8C798 = AuxAV8C798
               AuxAV9C802 = THISFORM.AV9C802
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03652,5,@AuxAV9C802,0)
               THISFORM.AV9C802 = AuxAV9C802
               AuxAV10C809 = THISFORM.AV10C809
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03652,6,@AuxAV10C809,0)
               THISFORM.AV10C809 = AuxAV10C809
               AuxAV11C796 = THISFORM.AV11C796
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03652,7,@AuxAV11C796,0)
               THISFORM.AV11C796 = AuxAV11C796
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03652 = Gx_err
               THISFORM.GX_DB_GetW03652_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03652 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03652) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03652 = Gx_err
                  THISFORM.GX_DB_GetW03652_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03652 <> 101
               BRKVA52 = .F.
               THISFORM.A796PedNro = THISFORM.Buf_W03652_796PedNro
               THISFORM.A809PedSec = THISFORM.Buf_W03652_809PedSec
               THISFORM.A801PedNum = THISFORM.Buf_W03652_801PedNumero
               THISFORM.A802PedSuc = THISFORM.Buf_W03652_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W03652_798PedEntCod
               THISFORM.A797PedGru = THISFORM.Buf_W03652_797PedGruTip
               THISFORM.A795PedFch = THISFORM.Buf_W03652_795PedFch
               THISFORM.A2EmpCod = THISFORM.Buf_W03652_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VA52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03652 = Gx_err
               THISFORM.GX_DB_GetW03652_01 ()
            ENDDO
         ENDIF
      ENDPROC
