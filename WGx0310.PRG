            THISFORM. cCW287S20 .Gx_rec_modif = .T.
            THISFORM. cCW287S20 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW287S20 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW287S20 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW287S20 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.A2EmpCod = THIS.Value
         ENDIF
