         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2EmpCod"
         THISFORM.cCW287S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW287S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW287S20 .GX_lastkey = 9.or. THISFORM.cCW287S20 .GX_lastkey = 13)
            IF ! THISFORM.cCW287S20 .GridValidObj( THISFORM.cCW287S20 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
