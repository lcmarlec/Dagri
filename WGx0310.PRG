      PROCEDURE CreateTemp
         LOCAL SCW287S20
         SCW287S20 = ""
         IF USED( "SCW287S20" )
            SELECT SCW287S20
            SCW287S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW287S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1011TTes"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1012TTes"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1013TTes"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1014TTes"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW287S20 = GETE('z:\temp') + '\' + SCW287S20
            ENDIF
            CREATE DBF (SCW287S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW287S20) EXCLUSIVE ALIAS SCW287S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW287S20
         THIS.GX_SfAlias = "SCW287S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02872" , @HStmt_W02872 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0310","W02872","",GX_CURSOR_TYPE_READONLY,@HStmt_W02872) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [TTesMedCod], [TTesBcoCod], [TTesFch], [TTesIoE], [TTesLin], [TTesNroI], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [TTESCYP1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [TTesNroI] >= ? and "
                  cmdbuf = cmdbuf + "  [TTesLin] >= ?) AND ([TTesIoE] like ?) AND ([TTesFch] >= ?) AND ([TTesMedCod] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([TTesBcoCod] >= ?) ORDER BY [EmpCod], [TTesNroI], [TTesLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02872,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02872,9)
                  THISFORM.GX_DB_BindColsW02872_01 ()
                  THISFORM.GX_DB_BindParmW02872_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02872,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C1011 = THISFORM.AV6C1011
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02872,2,@AuxAV6C1011,0)
               THISFORM.AV6C1011 = AuxAV6C1011
               AuxAV7C1012 = THISFORM.AV7C1012
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02872,3,@AuxAV7C1012,0)
               THISFORM.AV7C1012 = AuxAV7C1012
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02872,4,PADR( TRIM(THISFORM.AV8C1013),1, '%'),LEN(PADR( TRIM(THISFORM.AV8C1013),1, '%')),0)
               AuxAV9C1014 = THISFORM.AV9C1014
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02872,5,@AuxAV9C1014,0)
               THISFORM.AV9C1014 = AuxAV9C1014
               AuxAV10C1015 = THISFORM.AV10C1015
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02872,6,@AuxAV10C1015,0)
               THISFORM.AV10C1015 = AuxAV10C1015
               AuxAV11C1017 = THISFORM.AV11C1017
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02872,7,@AuxAV11C1017,0)
               THISFORM.AV11C1017 = AuxAV11C1017
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02872) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02872 = Gx_err
               THISFORM.GX_DB_GetW02872_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02872 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02872) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02872 = Gx_err
                  THISFORM.GX_DB_GetW02872_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02872 <> 101
               BRKV7Z2 = .F.
               THISFORM.A1015TTesM = THISFORM.Buf_W02872_1015TTesMedCod
               THISFORM.A1017TTesB = THISFORM.Buf_W02872_1017TTesBcoCod
               THISFORM.A1014TTesF = THISFORM.Buf_W02872_1014TTesFch
               THISFORM.A1013TTesI = THISFORM.Buf_W02872_1013TTesIoE
               THISFORM.A1012TTesL = THISFORM.Buf_W02872_1012TTesLin
               THISFORM.A1011TTesN = THISFORM.Buf_W02872_1011TTesNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W02872_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V7Z2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02872) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02872 = Gx_err
               THISFORM.GX_DB_GetW02872_01 ()
            ENDDO
         ENDIF
      ENDPROC
