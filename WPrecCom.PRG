                  cmdbuf = cmdbuf + "  T3.[DcCFec], T2.[ArtDsc] FROM (([DCCOM2] T1 (NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [DCCOM] T3 (NOLOCK) ON T3.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T3.[DcCNroInt] = T1.[DcCNroInt]) WHERE (T1.[EmpCod] = ? and T3.[DccTipRed] "
                  cmdbuf = cmdbuf + "  = 'FC') AND (T3.[DcCEst] < 9) AND (T1.[FamCod] = ?) AND (T1.[FamSubCod] = ?) AND "
