      ***********************
      PROCEDURE U18VID2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'PROVEEDOR'" )
         * 'PROVEEDOR' Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06613" , @HStmt_W06613 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPRECCOM","W06613","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W06613) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06613,cmdbuf)
            THISFORM.GX_DB_BindColsW06613_01 ()
            THISFORM.GX_DB_BindParmW06613_01 ()
         ENDIF
         AuxAV8Empcod = THISFORM.AV8Empcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06613,1,@AuxAV8Empcod,0)
         THISFORM.AV8Empcod = AuxAV8Empcod
         AuxAV32Entgru = THISFORM.AV32Entgru
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06613,2,AuxAV32Entgru,2,0)
         THISFORM.AV32Entgru = AuxAV32Entgru
         AuxAV16Entcod = THISFORM.AV16Entcod
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06613,3,@AuxAV16Entcod,0)
         THISFORM.AV16Entcod = AuxAV16Entcod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06613) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W06613 = Gx_err
         THISFORM.GX_DB_GetW06613_01 ()
         DO WHILE THISFORM.W06613 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W06613_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W06613_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W06613_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W06613_153EntRaz
            THISFORM.AV31Entraz = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W06613) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.EndEvent()
      ENDPROC

