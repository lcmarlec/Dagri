         THIS.GX_Level = 417
      ENDPROC
      PROCEDURE InitLevel
         LPARAMETER gxILvl
         LOCAL gx_oMode
         IF gxILvl != 417
            RETURN .T.
         ENDIF
         GX_lastvld = 0
         THISFORM.gx_lastvld = THIS.GxObjOrder-1
         RETURN .T.
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         THISFORM. GXInLvl417 = .T.
         IF THISFORM.GX_last_fld_lvl = 417
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 417
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 417 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03977) , "TALMACEN" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03976) , "TALMACEN" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03975) , "TALMACEN" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03974) , "TALMACEN" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03973) , "TALMACEN" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03972) , "TALMACEN" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT397A3698 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 417
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM. gx_417insert
            THISFORM. gx_417insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 417 )
            THISFORM. cCT397A3693 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 417
            THISFORM.SetLevel( 417 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT397V7 .InitLevel( 417 )
            THISFORM.GX_last_fld_lvl = 417
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         SET TOPIC TO Emprnomb
         THISFORM.Gx_cursor = "THISFORM.AV7Emprnom"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
