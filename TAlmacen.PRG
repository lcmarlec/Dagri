      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T039720" , @HStmt_T039720 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TALMACEN","T039720","",GX_CURSOR_TYPE_READONLY,@HStmt_T039720) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [AlmId], [AlmSecId], [UbiId], [UbiPas], [UbiEst], [UbiNiv], [UbiusuIns], [UbiFchIns], "
                  cmdbuf = cmdbuf + "  [UbiUsuMod], [UbiFchMod], [UbiMax], [UbiZona], [UbiCol], [UbiPall], [UbiDsc] FROM "
                  cmdbuf = cmdbuf + "  [AlmacenSectorUbicacion] (NOLOCK) WHERE [AlmId] = ? AND [AlmSecId] = ? ORDER BY "
                  cmdbuf = cmdbuf + "  [AlmId], [AlmSecId], [UbiId]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T039720,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T039720,9)
                  THISFORM.GX_DB_BindColsT039720_01 ()
                  THISFORM.GX_DB_BindParmT039720_01 ()
               ENDIF
               AuxA3693Almac = THISFORM.A3693Almac
               Gx_err = GX_DB_SetInt( HStmt_T039720,1,@AuxA3693Almac,0)
               THISFORM.A3693Almac = AuxA3693Almac
               AuxA3699AlmSe = THISFORM.A3699AlmSe
               Gx_err = GX_DB_SetInt( HStmt_T039720,2,@AuxA3699AlmSe,0)
               THISFORM.A3699AlmSe = AuxA3699AlmSe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T039720) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T039720 = Gx_err
               THISFORM.GX_DB_GetT039720_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T039720 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T039720) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T039720 = Gx_err
                  THISFORM.GX_DB_GetT039720_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T039720 <> 101
               BRKB1419 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT397S34.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T039720) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T039720 = Gx_err
               THISFORM.GX_DB_GetT039720_01 ()
            ENDDO
         ENDIF
      ENDPROC
