      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08082" , @HStmt_W08082 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WVERHEMP","W08082","",GX_CURSOR_TYPE_READONLY,@HStmt_W08082) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[HTraDato], T2.[htranom], T1.[TraCod], T2.[HtraUsu], T1.[HTraFch] "
                  cmdbuf = cmdbuf + "  FROM ([HEMPMOD] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [HEMPLEA] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[TraCod] = T1.[TraCod] AND T2.[HTraFch] = T1.[HTraFch]) WHERE "
                  cmdbuf = cmdbuf + "  (T1.[EmpCod] = ? and T1.[TraCod] = ? and T1.[HTraFch] >= ?) AND (T1.[HTraDato] like "
                  cmdbuf = cmdbuf + "  '%' + RTRIM(CAST(? AS char(40))) + '%') ORDER BY T1.[EmpCod], T1.[TraCod], T1.[HTraFch], "
                  cmdbuf = cmdbuf + "  T1.[HTraDato]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08082,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08082,14)
                  THISFORM.GX_DB_BindColsW08082_01 ()
                  THISFORM.GX_DB_BindParmW08082_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08082,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08082,2,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV26Htrafc = THISFORM.AV26Htrafc
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W08082,3,@AuxAV26Htrafc,0)
               THISFORM.AV26Htrafc = AuxAV26Htrafc
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08082,4,PADR( TRIM(THISFORM.AV25Htrada),40, '%'),LEN(PADR( TRIM(THISFORM.AV25Htrada),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08082 = Gx_err
               THISFORM.GX_DB_GetW08082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WVerHemp"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08082 = Gx_err
                  THISFORM.GX_DB_GetW08082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08082 <> 101
               BRKVMG2 = .F.
               THISFORM.AV27Htrafc = CTOT("  /  /  ")
               THISFORM.A2EmpCod = THISFORM.Buf_W08082_2EmpCod
               THISFORM.A3499HTraD = THISFORM.Buf_W08082_3499HTraDato
               THISFORM.A2458htran = THISFORM.Buf_W08082_2458htranom
               THISFORM.A561TraCod = THISFORM.Buf_W08082_561TraCod
               THISFORM.A2453HtraU = THISFORM.Buf_W08082_2453HtraUsu
               THISFORM.A2452HTraF = THISFORM.Buf_W08082_2452HTraFch
               THISFORM.A2458htran = THISFORM.Buf_W08082_2458htranom
               THISFORM.A2453HtraU = THISFORM.Buf_W08082_2453HtraUsu
               GX_SFLOAD = 0
               THISFORM.U14VMG2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08082 = Gx_err
               THISFORM.GX_DB_GetW08082_01 ()
            ENDDO
         ENDIF
      ENDPROC
