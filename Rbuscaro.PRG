         gxPrnObj.GxDwText( GxHDC , TRANSFORM(R718OPaNro, "@L 99999999")  ,53,3+Gx_line,100,17+Gx_line , "Times New Roman",10 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         SET CENTURY ON
         gxPrnObj.GxDwText( GxHDC , DTOC(R709OpaFch) ,112,3+Gx_line,167,17+Gx_line , "Times New Roman",10 ,256 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwText( GxHDC , TRANSFORM(R713OpaEnt, "999999")  ,180,3+Gx_line,215,17+Gx_line , "Times New Roman",10 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwText( GxHDC , R714OpaEnt ,231,3+Gx_line,430,17+Gx_line , "Times New Roman",10 ,256 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwText( GxHDC , TRANSFORM(RV10Saldo, "9999999.99")  ,455,3+Gx_line,514,17+Gx_line , "Times New Roman",10 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwText( GxHDC , TRANSFORM(RV8Tesimp, "999999999.99")  ,539,3+Gx_line,610,17+Gx_line , "Times New Roman",10 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwText( GxHDC , TRANSFORM(R708OPaNro, "999999999999")  ,682,4+Gx_line,753,18+Gx_line , "Times New Roman",10 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         Gx_line = Gx_line + 24
      ENDIF
      * Check if program is canceled.
      IF gxPrnObj.GxIsAliveDoc( GxHDC ) = 0
         UserCancel = .T.
      ENDIF
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R05692) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R05692 = Gx_err
      GX_DB_GetR05692_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R05692) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   DO EPFT0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

***********************
PROCEDURE EPFT0
***********************

   DO HFT0 WITH Gx_out , P_lines , 0, P_lines +1, .T., 0
   IF Gx_dvc = "PRN"
      GXAuxPrn_Flag = GXPrn_Flag
      gxPrnObj.GXEndDoc( GxHDC , @GXAuxPrn_Flag)
      gxPrnObj.GXEndPrn( GxHDC , @GXAuxPrn_Flag)
      GXPrn_Flag = GXAuxPrn_Flag
      PRIVATE GXCallFrm
      IF PROGRAM(0) = "MENU"
         GXCallFrm = _SCREEN.ActiveForm
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 0
         ENDIF
      ENDIF
      DO WHILE gxPrnObj.GxIsAliveDoc( GxHDC ) != 0
         WAIT "" TIMEOUT 1
         DOEVENTS
      ENDDO
      RELEASE WINDOW _WMSG
      IF PROGRAM(0) = "MENU"
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 1
         ENDIF
      ENDIF
   ELSE
      SET DEVICE TO SCREEN
      RptView = .T.
   ENDIF
   DO CDFT0
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

***********************
PROCEDURE HFT0
***********************

   PARAMETERS Gx_out, P_lines, Gx_line, Gx_inc, GX_footer, GX_inc_test

   Gx_line = Gx_line + Gx_inc
   IF Gx_line + GX_inc_test > P_lines
      IF Gx_page > 0
         Gx_line = P_lines
         IF Gx_dvc = "PRN" .and. Gx_pg_started
            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
         GXPrn_Flag = GXAuxPrn_Flag
         Gx_pg_started = .T.
      ENDIF
   ENDIF
RETURN
