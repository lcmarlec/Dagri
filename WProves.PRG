               AuxAV19Entgru = THISFORM.AV19Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,14,AuxAV19Entgru,3,0)
               THISFORM.AV19Entgru = AuxAV19Entgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,15,PADR( TRIM(THISFORM.AV24Entind),40, '%'),LEN(PADR( TRIM(THISFORM.AV24Entind),40, '%')),0)
               AuxAV24Entind = THISFORM.AV24Entind
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,16,AuxAV24Entind,40,0)
               THISFORM.AV24Entind = AuxAV24Entind
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,17,PADR( TRIM(THISFORM.AV22Entloc),40, '%'),LEN(PADR( TRIM(THISFORM.AV22Entloc),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
