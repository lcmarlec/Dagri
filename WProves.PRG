               THISFORM.gx_RefKeep = .T.
            ENDIF
            THISFORM.GX_Refresh = 0
            THISFORM. cCW129S12 .GXRefreshSf( .F., .T.)
            THISFORM.gx_RefKeep = .F.
         ENDIF
         THISFORM. cCW129S12 .GXSaveTempSf( GX_Ref )
