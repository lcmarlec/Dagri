               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01292,8,@AuxAV16Entcui,0)
               THISFORM.AV16Entcui = AuxAV16Entcui
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,9,PADR( TRIM(THISFORM.AV18Entdom),40, '%'),LEN(PADR( TRIM(THISFORM.AV18Entdom),40, '%')),0)
               AuxAV18Entdom = THISFORM.AV18Entdom
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,10,AuxAV18Entdom,40,0)
               THISFORM.AV18Entdom = AuxAV18Entdom
