               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01292 = Gx_err
               THISFORM.GX_DB_GetW01292_01 ()
            ENDDO
         ENDIF
