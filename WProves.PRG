         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01292" , @HStmt_W01292 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPROVES","W01292","",GX_CURSOR_TYPE_READONLY,@HStmt_W01292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntGruTip], [EmpCod], [EntInd], [EntGruCod], [EntTel], [EntLocDsc], [EntDom], "
                  cmdbuf = cmdbuf + "  [EntCont], [EntFan], [EntCui], [EntRaz], [EntCod] FROM [ENTID] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ? and [EntGruTip] = 'PR' and [EntCod] >= ?) AND ([EntRaz] like "
                  cmdbuf = cmdbuf + "  ? or (? = ' ')) AND ([EntCont] like ? or (? = convert(int, 0))) AND ([EntCui] = "
                  cmdbuf = cmdbuf + "  ? or ? = 0) AND ([EntDom] like ? or (? = ' ')) AND ([EntFan] like ? or (? = ' ')) "
                  cmdbuf = cmdbuf + "  AND ([EntGruCod] like ? or (? = ' ')) AND ([EntInd] like ? or (? = ' ')) AND ([EntLocDsc] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [EmpCod], [EntGruTip], [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01292,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01292,10)
                  THISFORM.GX_DB_BindColsW01292_01 ()
                  THISFORM.GX_DB_BindParmW01292_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01292,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV13Entcod = THISFORM.AV13Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01292,2,@AuxAV13Entcod,0)
               THISFORM.AV13Entcod = AuxAV13Entcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,3,PADR( TRIM(THISFORM.AV14Entraz),40, '%'),LEN(PADR( TRIM(THISFORM.AV14Entraz),40, '%')),0)
               AuxAV14Entraz = THISFORM.AV14Entraz
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,4,AuxAV14Entraz,40,0)
               THISFORM.AV14Entraz = AuxAV14Entraz
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01292,5,PADR( TRIM(THISFORM.AV17Entcon),40, '%'),LEN(PADR( TRIM(THISFORM.AV17Entcon),40, '%')),0)
               AuxAV13Entcod = THISFORM.AV13Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01292,6,@AuxAV13Entcod,0)
               THISFORM.AV13Entcod = AuxAV13Entcod
               AuxAV16Entcui = THISFORM.AV16Entcui
