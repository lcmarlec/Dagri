      PROCEDURE CreateTemp
         LOCAL SCW752S20
         SCW752S20 = ""
         IF USED( "SCW752S20" )
            SELECT SCW752S20
            SCW752S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW752S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA561TraCo"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA562TraCu"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 11
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2252TraV"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA2263CEmC"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2286TraD"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW752S20 = GETE('z:\temp') + '\' + SCW752S20
            ENDIF
            CREATE DBF (SCW752S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW752S20) EXCLUSIVE ALIAS SCW752S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW752S20
         THIS.GX_SfAlias = "SCW752S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07522" , @HStmt_W07522 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01G0","W07522","",GX_CURSOR_TYPE_READONLY,@HStmt_W07522) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [TraDir], [TraNom], [TraObs], [TraTel], [TraDNI], [CEmCod], [TraVal], [TraCui], "
                  cmdbuf = cmdbuf + "  [TraCod], [EmpCod] FROM [EMPLEADO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and "
                  cmdbuf = cmdbuf + "  [TraCod] >= ?) AND ([TraCui] >= ?) AND ([TraDir] like ?) AND ([TraNom] like ?) AND "
                  cmdbuf = cmdbuf + "  ([TraObs] like ?) AND ([TraTel] like ?) ORDER BY [EmpCod], [TraCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07522,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07522,9)
                  THISFORM.GX_DB_BindColsW07522_01 ()
                  THISFORM.GX_DB_BindParmW07522_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07522,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C561 = THISFORM.AV6C561
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07522,2,@AuxAV6C561,0)
               THISFORM.AV6C561 = AuxAV6C561
               AuxAV7C562 = THISFORM.AV7C562
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07522,3,@AuxAV7C562,0)
               THISFORM.AV7C562 = AuxAV7C562
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07522,4,PADR( TRIM(THISFORM.AV8C563),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C563),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07522,5,PADR( TRIM(THISFORM.AV9C564),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C564),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07522,6,PADR( TRIM(THISFORM.AV10C565),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C565),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07522,7,PADR( TRIM(THISFORM.AV11C566),40, '%'),LEN(PADR( TRIM(THISFORM.AV11C566),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07522 = Gx_err
               THISFORM.GX_DB_GetW07522_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07522 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07522) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07522 = Gx_err
                  THISFORM.GX_DB_GetW07522_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07522 <> 101
               BRKVKW2 = .F.
               THISFORM.A563TraDir = THISFORM.Buf_W07522_563TraDir
               THISFORM.A564TraNom = THISFORM.Buf_W07522_564TraNom
               THISFORM.A565TraObs = THISFORM.Buf_W07522_565TraObs
               THISFORM.A566TraTel = THISFORM.Buf_W07522_566TraTel
               THISFORM.A2286TraDN = THISFORM.Buf_W07522_2286TraDNI
               THISFORM.A2263CEmCo = THISFORM.Buf_W07522_2263CEmCod
               THISFORM.A2252TraVa = THISFORM.Buf_W07522_2252TraVal
               THISFORM.A562TraCui = THISFORM.Buf_W07522_562TraCui
               THISFORM.A561TraCod = THISFORM.Buf_W07522_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W07522_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VKW2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07522 = Gx_err
               THISFORM.GX_DB_GetW07522_01 ()
            ENDDO
         ENDIF
      ENDPROC
