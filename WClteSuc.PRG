               THISFORM.A2EmpCod = THISFORM.Buf_W05982_2EmpCod
               THISFORM.A120EntCod = THISFORM.Buf_W05982_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W05982_153EntRaz
