               THIS.GX_CUPOS = 0
               THISFORM.AV23Pgmnam = "WClteSuc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05982 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05982) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05982 = Gx_err
                  THISFORM.GX_DB_GetW05982_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05982 <> 101
               BRKVGM2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W05982_150EntGruTip
