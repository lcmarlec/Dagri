               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05982,3,@AuxAV20Entcod,0)
               THISFORM.AV20Entcod = AuxAV20Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
