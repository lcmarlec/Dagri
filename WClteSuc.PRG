      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05982" , @HStmt_W05982 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCLTESUC","W05982","",GX_CURSOR_TYPE_READONLY,@HStmt_W05982) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EntGruTip], T6.[EntLgGrpNo], T1.[EntLgGrpOf], T1.[EntLgOrden], T4.[VdrNom] "
                  cmdbuf = cmdbuf + "  AS EntLgVdrNo, T1.[EntLgVdrCo] AS EntLgVdrCo, T1.[EntLgTel], T1.[Entlgloc], T2.[PciDsc] "
                  cmdbuf = cmdbuf + "  AS EntLgPciDs, T1.[EntLgPciCo] AS EntLgPciCo, T1.[EntLgPaiCo] AS EntLgPaiCo, T1.[EntLgIBTuc], "
                  cmdbuf = cmdbuf + "  T1.[EntLgIBRet], T1.[EntLgFVt], T1.[EntLgEan], T1.[EntLgDom], T1.[EntLgCont], T3.[CIvDsc] "
                  cmdbuf = cmdbuf + "  AS EntLgCIvDs, T1.[EntLgCIvCo] AS EntLgCIvCo, T1.[EntLgDsc], T1.[EntLgCod], T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[EntCod], T5.[EntRaz] FROM ((((([CLTES] T1 (NOLOCK) LEFT JOIN [Pcias] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[PaiCod] = T1.[EntLgPaiCo] AND T2.[PciCod] = T1.[EntLgPciCo]) LEFT JOIN [CATIVA] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[CIvCod] = T1.[EntLgCIvCo]) LEFT JOIN [VEND] T4 (NOLOCK) ON T4.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T4.[VdrCod] = T1.[EntLgVdrCo]) LEFT JOIN [ENTID] T5 (NOLOCK) ON "
                  cmdbuf = cmdbuf + "  T5.[EmpCod] = T1.[EmpCod] AND T5.[EntGruTip] = T1.[EntGruTip] AND T5.[EntCod] = "
                  cmdbuf = cmdbuf + "  T1.[EntCod]) LEFT JOIN [CLTEGRP] T6 (NOLOCK) ON T6.[EmpCod] = T1.[EmpCod] AND T6.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[EntGruTip] AND T6.[EntCod] = T1.[EntCod] AND T6.[EntLgGrpOf] = T1.[EntLgGrpOf]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[EntGruTip] = ? and T1.[EntCod] = ? ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip], T1.[EntCod], T1.[EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05982,cmdbuf)
