         Aux0 = THISFORM.AV17Usuari
         Aux1 = THISFORM.AV19Objeto
         Aux2 = THISFORM.AV8Emprcod
         Aux3 = THISFORM.AV18Nivel
         DO RNivAcc WITH Aux0 , Aux1 , Aux2 , Aux3
         THISFORM.AV17Usuari = Aux0
         THISFORM.AV19Objeto = Aux1
         THISFORM.AV8Emprcod = Aux2
         THISFORM.AV18Nivel = Aux3
         THISFORM. cCW1104S27 .RestoreGridPos()
         GX_rploop = .T.
         IF THISFORM.AV18Nivel < 4
            THISFORM.cCW1104B8.Enabled = 0
         ENDIF
         IF THISFORM.AV18Nivel < 3
            THISFORM.cCW1104B9.Enabled = 0
         ENDIF
         IF THISFORM.AV18Nivel < 2
            THISFORM.cCW1104B7.Enabled = 0
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11043" , @HStmt_W11043 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WBONIF","W11043","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W11043) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11043,cmdbuf)
            THISFORM.GX_DB_BindColsW11043_01 ()
            THISFORM.GX_DB_BindParmW11043_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11043,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV21Plvgru = THISFORM.AV21Plvgru
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11043,2,AuxAV21Plvgru,2,0)
         THISFORM.AV21Plvgru = AuxAV21Plvgru
         AuxAV22Plvent = THISFORM.AV22Plvent
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11043,3,@AuxAV22Plvent,0)
         THISFORM.AV22Plvent = AuxAV22Plvent
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11043) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W11043 = Gx_err
         THISFORM.GX_DB_GetW11043_01 ()
         DO WHILE THISFORM.W11043 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W11043_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W11043_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W11043_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W11043_153EntRaz
            THISFORM.AV30Nomcli = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W11043) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
