      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11042" , @HStmt_W11042 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WBONIF","W11042","",GX_CURSOR_TYPE_READONLY,@HStmt_W11042) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[bonmin], T1.[boncnt], T2.[ArtDsc] AS bonartdsc, T1.[bonartcod] AS bonartcod, "
                  cmdbuf = cmdbuf + "  T1.[bonfams] AS bonfams, T1.[bonfam] AS bonfam, T1.[bonfha], T1.[bonfde], T1.[EntCod], "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip], T1.[EmpCod] FROM ([BONIFICA] T1 (NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[bonfam] AND T2.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[bonfams] AND T2.[ArtCod] = T1.[bonartcod]) WHERE (T1.[EmpCod] = ? and T1.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = ? and T1.[EntCod] = ?) AND (T1.[bonfha] >= ?) ORDER BY T1.[EmpCod], T1.[EntGruTip], "
                  cmdbuf = cmdbuf + "  T1.[EntCod], T1.[bonfde], T1.[bonfam], T1.[bonfams], T1.[bonartcod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11042,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11042,13)
                  THISFORM.GX_DB_BindColsW11042_01 ()
                  THISFORM.GX_DB_BindParmW11042_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11042,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Plvgru = THISFORM.AV21Plvgru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11042,2,AuxAV21Plvgru,2,0)
               THISFORM.AV21Plvgru = AuxAV21Plvgru
               AuxAV22Plvent = THISFORM.AV22Plvent
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11042,3,@AuxAV22Plvent,0)
               THISFORM.AV22Plvent = AuxAV22Plvent
               AuxAV23Lpvfch = THISFORM.AV23Lpvfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11042,4,@AuxAV23Lpvfch,0)
               THISFORM.AV23Lpvfch = AuxAV23Lpvfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11042 = Gx_err
               THISFORM.GX_DB_GetW11042_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV38Pgmnam = "WBonif"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11042 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11042) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11042 = Gx_err
                  THISFORM.GX_DB_GetW11042_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11042 <> 101
               BRKVUO2 = .F.
               THISFORM.A3254bonmi = THISFORM.Buf_W11042_3254bonmin
               THISFORM.A3253boncn = THISFORM.Buf_W11042_3253boncnt
               THISFORM.A3251bonar = THISFORM.Buf_W11042_3251bonartdsc
               THISFORM.A3250bonar = THISFORM.Buf_W11042_3250bonartcod
               THISFORM.A3249bonfa = THISFORM.Buf_W11042_3249bonfams
               THISFORM.A3248bonfa = THISFORM.Buf_W11042_3248bonfam
               THISFORM.A3252bonfh = THISFORM.Buf_W11042_3252bonfha
               THISFORM.A3247bonfd = THISFORM.Buf_W11042_3247bonfde
               THISFORM.A120EntCod = THISFORM.Buf_W11042_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W11042_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W11042_2EmpCod
               THISFORM.A3251bonar = THISFORM.Buf_W11042_3251bonartdsc
               GX_SFLOAD = 0
               THISFORM.U21VUO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11042 = Gx_err
               THISFORM.GX_DB_GetW11042_01 ()
            ENDDO
         ENDIF
      ENDPROC
