            Gx_err = GX_DB_Set_StmtCmdText( HStmt_P05977,cmdbuf)
            GX_DB_BindParmP05977_01 ()
         ENDIF
         Gx_err = GX_DB_SetLong( HStmt_P05977,1,@R352DcCNro,0)
         Gx_err = GX_DB_SetDate( HStmt_P05977,2,@R347DcCFec,0)
         Gx_err = GX_DB_SetInt( HStmt_P05977,3,@R2EmpCod,0)
         Gx_err = GX_DB_SetDouble( HStmt_P05977,4,@R346DcCNro,0)
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P05977) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P05977 = Gx_err
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P05977) ,  ,  ,  , CS_SQLSRV ,  )
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         * Exiting from a For First loop.
         EXIT
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P05976) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL5 = .F.
   ENDIF
   DO EPGL0
   RETURN
   GX_retp = 0
* End Program

