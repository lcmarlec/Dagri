               cmdbuf = " SELECT T1.[UsuCod], T1.[EmpCod], T2.[EmpNom] FROM ([USU001] T1 (NOLOCK) LEFT JOIN "
               cmdbuf = cmdbuf + "  [EMPRES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod]) WHERE T1.[UsuCod] = ? and T1.[EmpCod] "
               cmdbuf = cmdbuf + "  = ? ORDER BY T1.[UsuCod], T1.[EmpCod]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01202,cmdbuf)
               THISFORM.GX_DB_BindColsW01202_01 ()
               THISFORM.GX_DB_BindParmW01202_01 ()
            ENDIF
            AuxAV5Usuario = THISFORM.AV5Usuario
            THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01202,1,AuxAV5Usuario,10,0)
            THISFORM.AV5Usuario = AuxAV5Usuario
            AuxAV8Empcod = THISFORM.AV8Empcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01202,2,@AuxAV8Empcod,0)
            THISFORM.AV8Empcod = AuxAV8Empcod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01202) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W01202 = Gx_err
            THISFORM.GX_DB_GetW01202_01 ()
            DO WHILE THISFORM.W01202 <> 101
               THISFORM.A64UsuCod = THISFORM.Buf_W01202_64UsuCod
               THISFORM.A2EmpCod = THISFORM.Buf_W01202_2EmpCod
               THISFORM.A68EmpNom = THISFORM.Buf_W01202_68EmpNom
               THISFORM.A68EmpNom = THISFORM.Buf_W01202_68EmpNom
               THISFORM.AV9Emprnom = THISFORM.A68EmpNom
