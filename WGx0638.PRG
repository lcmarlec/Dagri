      PROCEDURE CreateTemp
         LOCAL SCW618S20
         SCW618S20 = ""
         IF USED( "SCW618S20" )
            SELECT SCW618S20
            SCW618S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW618S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 1 , 4]

            GX_STRUCT[ 1 ,1]= "sA176EntLg"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW618S20 = GETE('z:\temp') + '\' + SCW618S20
            ENDIF
            CREATE DBF (SCW618S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW618S20) EXCLUSIVE ALIAS SCW618S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW618S20
         THIS.GX_SfAlias = "SCW618S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06182" , @HStmt_W06182 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0638","W06182","",GX_CURSOR_TYPE_READONLY,@HStmt_W06182) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfvFDe], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [GrpOf], [EntLgCod] FROM [OFVTA1] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [FamCod] "
                  cmdbuf = cmdbuf + "  = ? and [FamSubCod] = ? and [ArtCod] = ? and [OfvFDe] = ? and [EntGruTip] = ? and "
                  cmdbuf = cmdbuf + "  [EntCod] = ? and [GrpOf] = ? ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], "
                  cmdbuf = cmdbuf + "  [OfvFDe], [EntGruTip], [EntCod], [GrpOf], [EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06182,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06182,9)
                  THISFORM.GX_DB_BindColsW06182_01 ()
                  THISFORM.GX_DB_BindParmW06182_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06182,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06182,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06182,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06182,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA1866OfvFD = THISFORM.A1866OfvFD
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06182,5,@AuxA1866OfvFD,0)
               THISFORM.A1866OfvFD = AuxA1866OfvFD
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06182,6,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06182,7,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA1854GrpOf = THISFORM.A1854GrpOf
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06182,8,@AuxA1854GrpOf,0)
               THISFORM.A1854GrpOf = AuxA1854GrpOf
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06182) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06182 = Gx_err
               THISFORM.GX_DB_GetW06182_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06182 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06182) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06182 = Gx_err
                  THISFORM.GX_DB_GetW06182_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06182 <> 101
               BRKVH62 = .F.
               THISFORM.A176EntLgC = THISFORM.Buf_W06182_176EntLgCod
               GX_SFLOAD = 0
               THISFORM.U12VH62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06182) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06182 = Gx_err
               THISFORM.GX_DB_GetW06182_01 ()
            ENDDO
         ENDIF
      ENDPROC
