      PROCEDURE CreateTemp
         LOCAL SCW23S24
         SCW23S24 = ""
         IF USED( "SCW23S24" )
            SELECT SCW23S24
            SCW23S24 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW23S24
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA196CotFc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA197CotIm"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 10
            GX_STRUCT[ 2 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW23S24 = GETE('z:\temp') + '\' + SCW23S24
            ENDIF
            CREATE DBF (SCW23S24) FROM ARRAY GX_STRUCT
            USE
            USE (SCW23S24) EXCLUSIVE ALIAS SCW23S24
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW23S24
         THIS.GX_SfAlias = "SCW23S24"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00232" , @HStmt_W00232 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCOTIZ","W00232","",GX_CURSOR_TYPE_READONLY,@HStmt_W00232) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[Moncod], T1.[CotImp], T1.[CotFch], T2.[MonSim], T2.[MonDsc] FROM ([MONEDA1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) ON T2.[Moncod] = T1.[Moncod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[Moncod] = ? and T1.[CotFch] >= ? ORDER BY T1.[Moncod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00232,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00232,13)
                  THISFORM.GX_DB_BindColsW00232_01 ()
                  THISFORM.GX_DB_BindParmW00232_01 ()
               ENDIF
               AuxA193Moncod = THISFORM.A193Moncod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00232,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00232,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00232 = Gx_err
               THISFORM.GX_DB_GetW00232_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WCotiz"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00232 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00232) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00232 = Gx_err
                  THISFORM.GX_DB_GetW00232_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00232 <> 101
               BRKV0N2 = .F.
               THISFORM.A197CotImp = THISFORM.Buf_W00232_197CotImp
               THISFORM.A196CotFch = THISFORM.Buf_W00232_196CotFch
               THISFORM.A195MonSim = THISFORM.Buf_W00232_195MonSim
               THISFORM.A194MonDsc = THISFORM.Buf_W00232_194MonDsc
               THISFORM.A195MonSim = THISFORM.Buf_W00232_195MonSim
               THISFORM.A194MonDsc = THISFORM.Buf_W00232_194MonDsc
               GX_SFLOAD = 0
               THISFORM.U16V0N2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00232 = Gx_err
               THISFORM.GX_DB_GetW00232_01 ()
            ENDDO
         ENDIF
      ENDPROC
