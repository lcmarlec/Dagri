            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_STATUSBAR"
            GXTB.Visible = .NOT. GXTB.Visible
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_TOOLBAR"
            RETURN .T.
         ENDIF
         RETURN .F.
      ENDFUNC
