      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02622" , @HStmt_W02622 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02A0","W02622","",GX_CURSOR_TYPE_READONLY,@HStmt_W02622) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [OpeTLi], [OpeEst], [OpeFch], [OPeNro], [OPeSuc], [OpeNroInt], [EmpCod] FROM "
                  cmdbuf = cmdbuf + "  [OPEDIS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [OpeNroInt] >= ?) AND ([OPeSuc] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([OPeNro] >= ?) AND ([OpeFch] >= ?) AND ([OpeTLi] >= ?) AND ([OpeEst] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [OpeNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02622,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02622,8)
                  THISFORM.GX_DB_BindColsW02622_01 ()
                  THISFORM.GX_DB_BindParmW02622_01 ()
               ENDIF
               AuxAV21C2 = THISFORM.AV21C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02622,1,@AuxAV21C2,0)
               THISFORM.AV21C2 = AuxAV21C2
               AuxAV20C731 = THISFORM.AV20C731
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02622,2,@AuxAV20C731,0)
               THISFORM.AV20C731 = AuxAV20C731
               AuxAV19C732 = THISFORM.AV19C732
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02622,3,@AuxAV19C732,0)
               THISFORM.AV19C732 = AuxAV19C732
               AuxAV18C701 = THISFORM.AV18C701
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02622,4,@AuxAV18C701,0)
               THISFORM.AV18C701 = AuxAV18C701
               AuxAV17C733 = THISFORM.AV17C733
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02622,5,@AuxAV17C733,0)
               THISFORM.AV17C733 = AuxAV17C733
               AuxAV16C734 = THISFORM.AV16C734
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02622,6,@AuxAV16C734,0)
               THISFORM.AV16C734 = AuxAV16C734
               AuxAV15C735 = THISFORM.AV15C735
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02622,7,@AuxAV15C735,0)
               THISFORM.AV15C735 = AuxAV15C735
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02622 = Gx_err
               THISFORM.GX_DB_GetW02622_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02622 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02622) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02622 = Gx_err
                  THISFORM.GX_DB_GetW02622_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02622 <> 101
               BRKV7A2 = .F.
               THISFORM.A734OpeTLi = THISFORM.Buf_W02622_734OpeTLi
               THISFORM.A735OpeEst = THISFORM.Buf_W02622_735OpeEst
               THISFORM.A733OpeFch = THISFORM.Buf_W02622_733OpeFch
               THISFORM.A701OPeNro = THISFORM.Buf_W02622_701OPeNro
               THISFORM.A732OPeSuc = THISFORM.Buf_W02622_732OPeSuc
               THISFORM.A731OpeNro = THISFORM.Buf_W02622_731OpeNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W02622_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V7A2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02622 = Gx_err
               THISFORM.GX_DB_GetW02622_01 ()
            ENDDO
         ENDIF
      ENDPROC
