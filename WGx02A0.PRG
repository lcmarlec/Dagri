            GX_STRUCT[ 5 ,1]= "sA733OpeFc"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW262S20 = GETE('z:\temp') + '\' + SCW262S20
            ENDIF
            CREATE DBF (SCW262S20) FROM ARRAY GX_STRUCT
            USE
