      ***********************
      PROCEDURE cCW638V27.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW638V27.ISVALID" )
         IF THISFORM.AV27Despro = 0
            THISFORM.AV26Desraz = "Todos"
         ELSE
            THISFORM.AV36GXLvl8 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06382" , @HStmt_W06382 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREIMPRI","W06382","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W06382) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
               cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'CL' and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
               cmdbuf = cmdbuf + "   "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06382,cmdbuf)
               THISFORM.GX_DB_BindColsW06382_01 ()
               THISFORM.GX_DB_BindParmW06382_01 ()
            ENDIF
            AuxAV14Empcod = THISFORM.AV14Empcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06382,1,@AuxAV14Empcod,0)
            THISFORM.AV14Empcod = AuxAV14Empcod
            AuxAV27Despro = THISFORM.AV27Despro
            THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06382,2,@AuxAV27Despro,0)
            THISFORM.AV27Despro = AuxAV27Despro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06382) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W06382 = Gx_err
            THISFORM.GX_DB_GetW06382_01 ()
            DO WHILE THISFORM.W06382 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W06382_2EmpCod
               THISFORM.A150EntGru = THISFORM.Buf_W06382_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W06382_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W06382_153EntRaz
               THISFORM.AV36GXLvl8 = 1
               THISFORM.AV26Desraz = THISFORM.A153EntRaz
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W06382) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV36GXLvl8 = 0
               THISFORM.AV26Desraz = "No Existe "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

