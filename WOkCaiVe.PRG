      PROCEDURE CreateTemp
         LOCAL SCW660S9
         SCW660S9 = ""
         IF USED( "SCW660S9" )
            SELECT SCW660S9
            SCW660S9 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW660S9
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1975CtrC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1976CtrC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1977CtrC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1978CtrC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1974CtrC"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 16
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1973CtrC"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW660S9 = GETE('z:\temp') + '\' + SCW660S9
            ENDIF
            CREATE DBF (SCW660S9) FROM ARRAY GX_STRUCT
            USE
            USE (SCW660S9) EXCLUSIVE ALIAS SCW660S9
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW660S9
         THIS.GX_SfAlias = "SCW660S9"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06602" , @HStmt_W06602 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOKCAIVE","W06602","",GX_CURSOR_TYPE_READONLY,@HStmt_W06602) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CtrCaiTpo], [EmpCod], [CtrCaiUsu], [CtrCaifch], [CtrCaiHta], [CtrCaiDde], "
                  cmdbuf = cmdbuf + "  [CtrCaiMes], [CtrCaiAno] FROM [CTRCAI] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) "
                  cmdbuf = cmdbuf + "  AND ([CtrCaiTpo] = ?) AND ([CtrCaiMes] >= ?) AND ([CtrCaiAno] >= ?) ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [CtrCaiAno] DESC, [CtrCaiMes] DESC  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06602,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06602,11)
                  THISFORM.GX_DB_BindColsW06602_01 ()
                  THISFORM.GX_DB_BindParmW06602_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06602,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Ctrcai = THISFORM.AV19Ctrcai
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06602,2,AuxAV19Ctrcai,1,0)
               THISFORM.AV19Ctrcai = AuxAV19Ctrcai
               AuxAV20Desdm = THISFORM.AV20Desdm
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06602,3,@AuxAV20Desdm,0)
               THISFORM.AV20Desdm = AuxAV20Desdm
               AuxAV21Desda = THISFORM.AV21Desda
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06602,4,@AuxAV21Desda,0)
               THISFORM.AV21Desda = AuxAV21Desda
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06602 = Gx_err
               THISFORM.GX_DB_GetW06602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WOkCaiVe"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06602 = Gx_err
                  THISFORM.GX_DB_GetW06602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06602 <> 101
               BRKVIC2 = .F.
               THISFORM.A1972CtrCa = THISFORM.Buf_W06602_1972CtrCaiTpo
               THISFORM.A2EmpCod = THISFORM.Buf_W06602_2EmpCod
               THISFORM.A1973CtrCa = THISFORM.Buf_W06602_1973CtrCaiUsu
               THISFORM.A1974CtrCa = THISFORM.Buf_W06602_1974CtrCaifch
               THISFORM.A1978CtrCa = THISFORM.Buf_W06602_1978CtrCaiHta
               THISFORM.A1977CtrCa = THISFORM.Buf_W06602_1977CtrCaiDde
               THISFORM.A1976CtrCa = THISFORM.Buf_W06602_1976CtrCaiMes
               THISFORM.A1975CtrCa = THISFORM.Buf_W06602_1975CtrCaiAno
               GX_SFLOAD = 0
               THISFORM.U13VIC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06602 = Gx_err
               THISFORM.GX_DB_GetW06602_01 ()
            ENDDO
         ENDIF
      ENDPROC
