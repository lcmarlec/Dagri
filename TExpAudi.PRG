                  ENDDO
                  THISFORM.T03793 = Gx_err
                  THISFORM.GX_DB_GetT03793_01 ()
                  THISFORM. cCT379A3502 . ZMAJ399 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCAJ399 ()
               THISFORM. cCT379A3502 . ZMAJ399 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAJ399 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT379A3508 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEAJ399 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAJ399 ()
                  RETURN
               ENDIF
               THISFORM.cCT379A3502.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03793) , "TEXPAUDI" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03792) , "TEXPAUDI" )
