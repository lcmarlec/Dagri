            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02792 <> 101
               BRKV7R2 = .F.
               THISFORM.A3439RetIm = THISFORM.Buf_W02792_3439RetImpBas
               THISFORM.A957RetSig = THISFORM.Buf_W02792_957RetSig
               THISFORM.A956RetImp = THISFORM.Buf_W02792_956RetImpImp
               THISFORM.A951RetNro = THISFORM.Buf_W02792_951RetNroIImp
               THISFORM.A950RetNro = THISFORM.Buf_W02792_950RetNroLin
               GX_SFLOAD = 0
               THISFORM.U12V7R2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02792 = Gx_err
               THISFORM.GX_DB_GetW02792_01 ()
            ENDDO
         ENDIF
      ENDPROC
