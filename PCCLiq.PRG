            R1936CCRcv = Buf_P05047_1936CCRcvLin
            IF R1945CCPag = AV19Ccpagn
               R1945CCPag = 0
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P05048" , @HStmt_P05048 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PCCLIQ","P05048","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P05048) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " UPDATE [CCOBRADO] SET [CCPagNI]=?  WHERE [EmpCod] = ? AND [CCVdrCod] = ? AND [CCRcvNroI] "
                  cmdbuf = cmdbuf + "  = ? AND [CCRcvLin] = ? AND [CCChqLin] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_P05048,cmdbuf)
                  GX_DB_BindParmP05048_01 ()
               ENDIF
               Gx_err = GX_DB_SetDouble( HStmt_P05048,1,@R1945CCPag,0)
               Gx_err = GX_DB_SetInt( HStmt_P05048,2,@R2EmpCod,0)
               Gx_err = GX_DB_SetInt( HStmt_P05048,3,@R1946CCVdr,0)
               Gx_err = GX_DB_SetDouble( HStmt_P05048,4,@R1935CCRcv,0)
               Gx_err = GX_DB_SetInt( HStmt_P05048,5,@R1936CCRcv,0)
               Gx_err = GX_DB_SetInt( HStmt_P05048,6,@R1959CCChq,0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P05048) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               P05048 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P05048) ,  ,  ,  , CS_SQLSRV ,  )
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_P05047) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            P05047 = Gx_err
            GX_DB_GetP05047_01 ()
            IF UserCancel
               EXIT
            ENDIF
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P05047) ,  ,  ,  , CS_SQLSRV ,  )
         LEVEL5 = .F.
   ENDCASE
   DO EPE00
   RETURN
   DO EPE00
   RETURN
   GX_retp = 0
* End Program

