      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09112" , @HStmt_W09112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06G2","W09112","",GX_CURSOR_TYPE_READONLY,@HStmt_W09112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [paicod], [pcicod], [MunHue], [MunMin], [MunNRell], [MunRell], [MunTap], [munaba], "
                  cmdbuf = cmdbuf + "  [muncod] FROM [muni] (FASTFIRSTROW NOLOCK) WHERE ([paicod] = ? and [pcicod] = ?) "
                  cmdbuf = cmdbuf + "  AND ([muncod] like ?) AND ([munaba] >= ?) AND ([MunTap] >= ?) AND ([MunRell] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([MunNRell] >= ?) ORDER BY [paicod], [pcicod], [muncod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09112,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09112,9)
                  THISFORM.GX_DB_BindColsW09112_01 ()
                  THISFORM.GX_DB_BindParmW09112_01 ()
               ENDIF
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09112,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               AuxA2081xPciC = THISFORM.A2081xPciC
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09112,2,AuxA2081xPciC,4,0)
               THISFORM.A2081xPciC = AuxA2081xPciC
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09112,3,PADR( TRIM(THISFORM.AV5C2082),4, '%'),LEN(PADR( TRIM(THISFORM.AV5C2082),4, '%')),0)
               AuxAV6C2083 = THISFORM.AV6C2083
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09112,4,@AuxAV6C2083,0)
               THISFORM.AV6C2083 = AuxAV6C2083
               AuxAV7C2085 = THISFORM.AV7C2085
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09112,5,@AuxAV7C2085,0)
               THISFORM.AV7C2085 = AuxAV7C2085
               AuxAV8C2086 = THISFORM.AV8C2086
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09112,6,@AuxAV8C2086,0)
               THISFORM.AV8C2086 = AuxAV8C2086
               AuxAV9C2087 = THISFORM.AV9C2087
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09112,7,@AuxAV9C2087,0)
               THISFORM.AV9C2087 = AuxAV9C2087
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09112 = Gx_err
               THISFORM.GX_DB_GetW09112_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09112) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09112 = Gx_err
                  THISFORM.GX_DB_GetW09112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09112 <> 101
               BRKVPB2 = .F.
               THISFORM.A2089xMunH = THISFORM.Buf_W09112_2089xMunHue
