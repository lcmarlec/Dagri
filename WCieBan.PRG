      PROCEDURE CreateTemp
         LOCAL SCW477S11
         SCW477S11 = ""
         IF USED( "SCW477S11" )
            SELECT SCW477S11
            SCW477S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW477S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA87BcoDsc"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 40
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA76BcoCta"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA78BcoSuc"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA79BcoDir"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1478BcoC"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW477S11 = GETE('z:\temp') + '\' + SCW477S11
            ENDIF
            CREATE DBF (SCW477S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW477S11) EXCLUSIVE ALIAS SCW477S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW477S11
         THIS.GX_SfAlias = "SCW477S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04772" , @HStmt_W04772 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCIEBAN","W04772","",GX_CURSOR_TYPE_READONLY,@HStmt_W04772) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[BcoCod], T1.[BcoCtaCie], T1.[BcoDir], T1.[BcoSuc], T1.[BcoCta], T2.[BcoDsc] "
                  cmdbuf = cmdbuf + "  FROM ([CTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] "
                  cmdbuf = cmdbuf + "  = T1.[BcoCod]) ORDER BY T1.[BcoCta]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04772,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04772,14)
                  THISFORM.GX_DB_BindColsW04772_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04772) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04772 = Gx_err
               THISFORM.GX_DB_GetW04772_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV19Pgmnam = "WCieBan"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04772 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04772) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04772 = Gx_err
                  THISFORM.GX_DB_GetW04772_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04772 <> 101
               BRKVD92 = .F.
               THISFORM.A86BcoCod = THISFORM.Buf_W04772_86BcoCod
               THISFORM.A1478BcoCt = THISFORM.Buf_W04772_1478BcoCtaCie
               THISFORM.A79BcoDir = THISFORM.Buf_W04772_79BcoDir
               THISFORM.A78BcoSuc = THISFORM.Buf_W04772_78BcoSuc
               THISFORM.A76BcoCta = THISFORM.Buf_W04772_76BcoCta
               THISFORM.A87BcoDsc = THISFORM.Buf_W04772_87BcoDsc
               THISFORM.A87BcoDsc = THISFORM.Buf_W04772_87BcoDsc
               GX_SFLOAD = 0
               THISFORM.U15VD92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04772) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04772 = Gx_err
               THISFORM.GX_DB_GetW04772_01 ()
            ENDDO
         ENDIF
      ENDPROC
