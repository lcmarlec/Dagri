      PROCEDURE CreateTemp
         LOCAL SCW184S14
         SCW184S14 = ""
         IF USED( "SCW184S14" )
            SELECT SCW184S14
            SCW184S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW184S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA680ObjCo"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA69ObjDsc"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 25
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA67ObjMax"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW184S14 = GETE('z:\temp') + '\' + SCW184S14
            ENDIF
            CREATE DBF (SCW184S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW184S14) EXCLUSIVE ALIAS SCW184S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW184S14
         THIS.GX_SfAlias = "SCW184S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01842" , @HStmt_W01842 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0220","W01842","",GX_CURSOR_TYPE_READONLY,@HStmt_W01842) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ObjMod], [ObjMax], [ObjDsc], [ObjCod] FROM [OBJ001] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([ObjCod] like ?) AND ([ObjDsc] like ?) AND ([ObjMax] like ?) AND ([ObjMod] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [ObjCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01842,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01842,8)
                  THISFORM.GX_DB_BindColsW01842_01 ()
                  THISFORM.GX_DB_BindParmW01842_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01842,1,PADR( TRIM(THISFORM.AV18C680),8, '%'),LEN(PADR( TRIM(THISFORM.AV18C680),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01842,2,PADR( TRIM(THISFORM.AV17C69),25, '%'),LEN(PADR( TRIM(THISFORM.AV17C69),25, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01842,3,PADR( TRIM(THISFORM.AV16C67),1, '%'),LEN(PADR( TRIM(THISFORM.AV16C67),1, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01842,4,PADR( TRIM(THISFORM.AV15C681),10, '%'),LEN(PADR( TRIM(THISFORM.AV15C681),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01842 = Gx_err
               THISFORM.GX_DB_GetW01842_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01842 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01842) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01842 = Gx_err
                  THISFORM.GX_DB_GetW01842_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01842 <> 101
               BRKV542 = .F.
               THISFORM.A681ObjMod = THISFORM.Buf_W01842_681ObjMod
               THISFORM.A67ObjMax = THISFORM.Buf_W01842_67ObjMax
               THISFORM.A69ObjDsc = THISFORM.Buf_W01842_69ObjDsc
               THISFORM.A680ObjCod = THISFORM.Buf_W01842_680ObjCod
               GX_SFLOAD = 0
               THISFORM.U12V542 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01842 = Gx_err
               THISFORM.GX_DB_GetW01842_01 ()
            ENDDO
         ENDIF
      ENDPROC
