               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C121 = THISFORM.AV6C121
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W01922,2,@AuxAV6C121,0)
               THISFORM.AV6C121 = AuxAV6C121
               AuxAV7C122 = THISFORM.AV7C122
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01922,3,@AuxAV7C122,0)
               THISFORM.AV7C122 = AuxAV7C122
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01922,4,PADR( TRIM(THISFORM.AV8C123),1, '%'),LEN(PADR( TRIM(THISFORM.AV8C123),1, '%')),0)
               AuxAV9C124 = THISFORM.AV9C124
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01922,5,@AuxAV9C124,0)
               THISFORM.AV9C124 = AuxAV9C124
               AuxAV10C125 = THISFORM.AV10C125
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01922,6,@AuxAV10C125,0)
               THISFORM.AV10C125 = AuxAV10C125
               AuxAV11C126 = THISFORM.AV11C126
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01922,7,@AuxAV11C126,0)
               THISFORM.AV11C126 = AuxAV11C126
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01922) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01922 = Gx_err
               THISFORM.GX_DB_GetW01922_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01922 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01922) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01922 = Gx_err
                  THISFORM.GX_DB_GetW01922_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01922 <> 101
               BRKV5C2 = .F.
               THISFORM.A125ChqFch = THISFORM.Buf_W01922_125ChqFchIng
               THISFORM.A126ChqBco = THISFORM.Buf_W01922_126ChqBcoCod
               THISFORM.A124ChqCta = THISFORM.Buf_W01922_124ChqCta
               THISFORM.A123ChqTip = THISFORM.Buf_W01922_123ChqTip
               THISFORM.A122ChqLin = THISFORM.Buf_W01922_122ChqLin
               THISFORM.A121ChqNro = THISFORM.Buf_W01922_121ChqNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W01922_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V5C2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01922) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01922 = Gx_err
               THISFORM.GX_DB_GetW01922_01 ()
            ENDDO
         ENDIF
      ENDPROC
