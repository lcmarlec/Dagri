            THISFORM.A3255bonCf = THISFORM.Buf_T034021_3255bonCfam
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3256bonCf"
            THISFORM.A3256bonCf = THISFORM.Buf_T034021_3256bonCfamS
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3257bonCA"
            THISFORM.A3257bonCA = THISFORM.Buf_T034021_3257bonCArtCod
         ENDIF
      ENDPROC
