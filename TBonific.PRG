      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T034021" , @HStmt_T034021 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBONIFIC","T034021","",GX_CURSOR_TYPE_READONLY,@HStmt_T034021) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [bonfde], [bonfam] AS bonfam, [bonfams] AS "
                  cmdbuf = cmdbuf + "  bonfams, [bonartcod] AS bonartcod, [bonCfam] AS bonCfam, [bonCfamS] AS bonCfamS, "
                  cmdbuf = cmdbuf + "  [bonCArtCod] AS bonCArtCod FROM [BONIFIC2] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] "
                  cmdbuf = cmdbuf + "  = ? AND [EntCod] = ? AND [bonfde] = ? AND [bonfam] = ? AND [bonfams] = ? AND [bonartcod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], [bonfde], [bonfam], [bonfams], [bonartcod], "
                  cmdbuf = cmdbuf + "  [bonCfam], [bonCfamS], [bonCArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T034021,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T034021,9)
                  THISFORM.GX_DB_BindColsT034021_01 ()
                  THISFORM.GX_DB_BindParmT034021_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T034021,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T034021,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T034021,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA3247bonfd = THISFORM.A3247bonfd
               Gx_err = GX_DB_SetDate( HStmt_T034021,4,@AuxA3247bonfd,0)
               THISFORM.A3247bonfd = AuxA3247bonfd
               AuxA3248bonfa = THISFORM.A3248bonfa
               Gx_err = GX_DB_SetInt( HStmt_T034021,5,@AuxA3248bonfa,0)
               THISFORM.A3248bonfa = AuxA3248bonfa
               AuxA3249bonfa = THISFORM.A3249bonfa
               Gx_err = GX_DB_SetInt( HStmt_T034021,6,@AuxA3249bonfa,0)
               THISFORM.A3249bonfa = AuxA3249bonfa
               AuxA3250bonar = THISFORM.A3250bonar
               Gx_err = GX_DB_SetInt( HStmt_T034021,7,@AuxA3250bonar,0)
               THISFORM.A3250bonar = AuxA3250bonar
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T034021) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034021 = Gx_err
               THISFORM.GX_DB_GetT034021_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T034021 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034021) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T034021 = Gx_err
                  THISFORM.GX_DB_GetT034021_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T034021 <> 101
               BRK9G374 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT340S45.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034021) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034021 = Gx_err
               THISFORM.GX_DB_GetT034021_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
