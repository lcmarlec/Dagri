      PROCEDURE CreateTemp
         LOCAL SCW459S11
         SCW459S11 = ""
         IF USED( "SCW459S11" )
            SELECT SCW459S11
            SCW459S11 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW459S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "VAV14Asifc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV21Asict"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV18Cuent"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 30
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV11Debe"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 14
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "VAV12Haber"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 14
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "VAV24Sdebe"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 14
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "VAV25Shabe"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 14
            GX_STRUCT[ 7 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW459S11 = GETE('z:\temp') + '\' + SCW459S11
            ENDIF
            CREATE DBF (SCW459S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW459S11) EXCLUSIVE ALIAS SCW459S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW459S11
         THIS.GX_SfAlias = "SCW459S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U13VCR2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
