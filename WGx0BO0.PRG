      PROCEDURE CreateTemp
         LOCAL SCW1264S20
         SCW1264S20 = ""
         IF USED( "SCW1264S20" )
            SELECT SCW1264S20
            SCW1264S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1264S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3356CarN"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 15
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3722CarN"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3723CarF"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 21
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3724CarF"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 20
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1264S20 = GETE('z:\temp') + '\' + SCW1264S20
            ENDIF
            CREATE DBF (SCW1264S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1264S20) EXCLUSIVE ALIAS SCW1264S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1264S20
         THIS.GX_SfAlias = "SCW1264S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12642" , @HStmt_W12642 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0BO0","W12642","",GX_CURSOR_TYPE_READONLY,@HStmt_W12642) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CarFinHorFin], [CaFinrHorIni], [CarFinUsuAlt], [CarFinFchAlt], [CarNroFin], "
                  cmdbuf = cmdbuf + "  [CarNro], [EmpCod] FROM [CARGAFIN] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([CarNro] like ?) AND ([CarNroFin] >= ?) AND ([CarFinFchAlt] >= ?) AND ([CarFinUsuAlt] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CarFinHorFin] >= ?) AND ([CaFinrHorIni] >= ?) ORDER BY [EmpCod], [CarNro], "
                  cmdbuf = cmdbuf + "  [CarNroFin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12642,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12642,9)
                  THISFORM.GX_DB_BindColsW12642_01 ()
                  THISFORM.GX_DB_BindParmW12642_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12642,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12642,2,PADR( TRIM(THISFORM.AV6C3356),15, '%'),LEN(PADR( TRIM(THISFORM.AV6C3356),15, '%')),0)
               AuxAV7C3722 = THISFORM.AV7C3722
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12642,3,@AuxAV7C3722,0)
               THISFORM.AV7C3722 = AuxAV7C3722
               AuxAV8C3723 = THISFORM.AV8C3723
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12642,4,@AuxAV8C3723,0)
               THISFORM.AV8C3723 = AuxAV8C3723
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12642,5,PADR( TRIM(THISFORM.AV9C3724),20, '%'),LEN(PADR( TRIM(THISFORM.AV9C3724),20, '%')),0)
               AuxAV10C3725 = THISFORM.AV10C3725
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12642,6,@AuxAV10C3725,0)
               THISFORM.AV10C3725 = AuxAV10C3725
               AuxAV11C3726 = THISFORM.AV11C3726
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12642,7,@AuxAV11C3726,0)
               THISFORM.AV11C3726 = AuxAV11C3726
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12642 = Gx_err
               THISFORM.GX_DB_GetW12642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12642 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12642) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12642 = Gx_err
                  THISFORM.GX_DB_GetW12642_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12642 <> 101
               BRKVZ42 = .F.
               THISFORM.A3725CarFH = THISFORM.Buf_W12642_3725CarFHorF
               THISFORM.A3726CaFin = THISFORM.Buf_W12642_3726CaFinrHo
               THISFORM.A3724CarFU = THISFORM.Buf_W12642_3724CarFUsuA
               THISFORM.A3723CarFF = THISFORM.Buf_W12642_3723CarFFchA
               THISFORM.A3722CarNr = THISFORM.Buf_W12642_3722CarNroFi
               THISFORM.A3356CarNr = THISFORM.Buf_W12642_3356CarNro
               THISFORM.A2EmpCod = THISFORM.Buf_W12642_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VZ42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12642 = Gx_err
               THISFORM.GX_DB_GetW12642_01 ()
            ENDDO
         ENDIF
      ENDPROC
