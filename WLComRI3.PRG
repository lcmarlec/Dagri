      ***********************
      PROCEDURE cCW850V12.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW850V12.ISVALID" )
         THISFORM.AV27GXLvl1 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08502" , @HStmt_W08502 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLCOMRI3","W08502","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W08502) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'PR' and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08502,cmdbuf)
            THISFORM.GX_DB_BindColsW08502_01 ()
            THISFORM.GX_DB_BindParmW08502_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08502,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV12Despro = THISFORM.AV12Despro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08502,2,@AuxAV12Despro,0)
         THISFORM.AV12Despro = AuxAV12Despro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08502) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W08502 = Gx_err
         THISFORM.GX_DB_GetW08502_01 ()
         DO WHILE THISFORM.W08502 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W08502_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W08502_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W08502_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W08502_153EntRaz
            THISFORM.AV27GXLvl1 = 1
            THISFORM.AV18Desraz = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W08502) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV27GXLvl1 = 0
            IF THISFORM.AV12Despro = 0
               THISFORM.AV18Desraz = "Primero "
            ELSE
               THISFORM.AV18Desraz = "No Existe "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

