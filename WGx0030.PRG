      PROCEDURE CreateTemp
         LOCAL SCW174S20
         SCW174S20 = ""
         IF USED( "SCW174S20" )
            SELECT SCW174S20
            SCW174S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW174S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA34LugCod"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA45ArtStk"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW174S20 = GETE('z:\temp') + '\' + SCW174S20
            ENDIF
            CREATE DBF (SCW174S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW174S20) EXCLUSIVE ALIAS SCW174S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW174S20
         THIS.GX_SfAlias = "SCW174S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01742" , @HStmt_W01742 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0030","W01742","",GX_CURSOR_TYPE_READONLY,@HStmt_W01742) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [lotraz], [LotNro], [PrvCod], [ArtStkEst], [LugCod], [ArtCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [FamCod], [EmpCod] FROM [ARTSTK] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and "
                  cmdbuf = cmdbuf + "  [FamCod] >= ? and [FamSubCod] >= ? and [ArtCod] >= ? and [LugCod] >= ? and [PrvCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([LotNro] like ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], "
                  cmdbuf = cmdbuf + "  [LugCod], [PrvCod], [LotNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01742,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01742,9)
                  THISFORM.GX_DB_BindColsW01742_01 ()
                  THISFORM.GX_DB_BindParmW01742_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01742,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C3 = THISFORM.AV6C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01742,2,@AuxAV6C3,0)
               THISFORM.AV6C3 = AuxAV6C3
               AuxAV7C4 = THISFORM.AV7C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01742,3,@AuxAV7C4,0)
               THISFORM.AV7C4 = AuxAV7C4
               AuxAV8C5 = THISFORM.AV8C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01742,4,@AuxAV8C5,0)
               THISFORM.AV8C5 = AuxAV8C5
               AuxAV9C34 = THISFORM.AV9C34
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01742,5,@AuxAV9C34,0)
               THISFORM.AV9C34 = AuxAV9C34
               AuxAV10C37 = THISFORM.AV10C37
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01742,6,@AuxAV10C37,0)
               THISFORM.AV10C37 = AuxAV10C37
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01742,7,PADR( TRIM(THISFORM.AV11C38),12, '%'),LEN(PADR( TRIM(THISFORM.AV11C38),12, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01742 = Gx_err
               THISFORM.GX_DB_GetW01742_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01742 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01742) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01742 = Gx_err
                  THISFORM.GX_DB_GetW01742_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01742 <> 101
               BRKV4U2 = .F.
               THISFORM.A38LotNro = THISFORM.Buf_W01742_38LotNro
               THISFORM.A37PrvCod = THISFORM.Buf_W01742_37PrvCod
               THISFORM.A45ArtStkE = THISFORM.Buf_W01742_45ArtStkEst
               THISFORM.A34LugCod = THISFORM.Buf_W01742_34LugCod
               THISFORM.A5ArtCod = THISFORM.Buf_W01742_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01742_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01742_3FamCod
               THISFORM.A2EmpCod = THISFORM.Buf_W01742_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V4U2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01742 = Gx_err
               THISFORM.GX_DB_GetW01742_01 ()
            ENDDO
         ENDIF
      ENDPROC
