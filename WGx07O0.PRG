      PROCEDURE CreateTemp
         LOCAL SCW809S20
         SCW809S20 = ""
         IF USED( "SCW809S20" )
            SELECT SCW809S20
            SCW809S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW809S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA561TraCo"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2452HTra"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 16
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2453Htra"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2455htra"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 11
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW809S20 = GETE('z:\temp') + '\' + SCW809S20
            ENDIF
            CREATE DBF (SCW809S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW809S20) EXCLUSIVE ALIAS SCW809S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW809S20
         THIS.GX_SfAlias = "SCW809S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08092" , @HStmt_W08092 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07O0","W08092","",GX_CURSOR_TYPE_READONLY,@HStmt_W08092) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [htradir], [htraloc], [htracui], [HtraUsu], [HTraFch], [TraCod], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [HEMPLEA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [TraCod] >= ? and "
                  cmdbuf = cmdbuf + "  [HTraFch] >= ?) AND ([HtraUsu] like ?) AND ([htracui] >= ?) AND ([htradir] like "
                  cmdbuf = cmdbuf + "  ?) AND ([htraloc] like ?) ORDER BY [EmpCod], [TraCod], [HTraFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08092,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08092,9)
                  THISFORM.GX_DB_BindColsW08092_01 ()
                  THISFORM.GX_DB_BindParmW08092_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08092,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C561 = THISFORM.AV6C561
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08092,2,@AuxAV6C561,0)
               THISFORM.AV6C561 = AuxAV6C561
               AuxAV7C2452 = THISFORM.AV7C2452
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W08092,3,@AuxAV7C2452,0)
               THISFORM.AV7C2452 = AuxAV7C2452
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08092,4,PADR( TRIM(THISFORM.AV8C2453),10, '%'),LEN(PADR( TRIM(THISFORM.AV8C2453),10, '%')),0)
               AuxAV9C2455 = THISFORM.AV9C2455
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08092,5,@AuxAV9C2455,0)
               THISFORM.AV9C2455 = AuxAV9C2455
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08092,6,PADR( TRIM(THISFORM.AV10C2456),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C2456),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08092,7,PADR( TRIM(THISFORM.AV11C2457),30, '%'),LEN(PADR( TRIM(THISFORM.AV11C2457),30, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08092 = Gx_err
               THISFORM.GX_DB_GetW08092_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08092 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08092) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08092 = Gx_err
                  THISFORM.GX_DB_GetW08092_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08092 <> 101
               BRKVMH2 = .F.
               THISFORM.A2456htrad = THISFORM.Buf_W08092_2456htradir
               THISFORM.A2457htral = THISFORM.Buf_W08092_2457htraloc
               THISFORM.A2455htrac = THISFORM.Buf_W08092_2455htracui
               THISFORM.A2453HtraU = THISFORM.Buf_W08092_2453HtraUsu
               THISFORM.A2452HTraF = THISFORM.Buf_W08092_2452HTraFch
               THISFORM.A561TraCod = THISFORM.Buf_W08092_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W08092_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VMH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08092 = Gx_err
               THISFORM.GX_DB_GetW08092_01 ()
            ENDDO
         ENDIF
      ENDPROC
