         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV15Emprco
            Aux3 = THISFORM.AV14Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV13Audobs
            Aux6 = THISFORM.AV11Usuari
