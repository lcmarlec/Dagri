      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10842" , @HStmt_W10842 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPICPAR","W10842","",GX_CURSOR_TYPE_READONLY,@HStmt_W10842) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RINroInt], T1.[RIEst], T2.[LugDsc] AS RiLugDdeD, T1.[RILugDde] "
                  cmdbuf = cmdbuf + "  AS RILugDde, T1.[RiPal], T1.[RIObs], T3.[CRIDsc], T1.[CRICod], T1.[RiHora], T1.[RIFch], "
                  cmdbuf = cmdbuf + "  T1.[RINro] FROM (([REMINT] T1 (NOLOCK) LEFT JOIN [LUGALM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[LugCod] = T1.[RILugDde]) LEFT JOIN [CRINTERN] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[CRICod] = T1.[CRICod]) WHERE (T1.[EmpCod] = "
                  cmdbuf = cmdbuf + "  ?) AND (T1.[RIEst] = 1) AND (T1.[RIObs] = RTRIM(?)) AND (T1.[RiPal] <> ' ') AND "
                  cmdbuf = cmdbuf + "  (T1.[CRICod] = 23) ORDER BY T1.[EmpCod], T1.[RIObs]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10842,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10842,14)
                  THISFORM.GX_DB_BindColsW10842_01 ()
                  THISFORM.GX_DB_BindParmW10842_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10842,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV28Riobs = THISFORM.AV28Riobs
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10842,2,AuxAV28Riobs,40,0)
               THISFORM.AV28Riobs = AuxAV28Riobs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10842 = Gx_err
               THISFORM.GX_DB_GetW10842_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WPicPar"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10842 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10842) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10842 = Gx_err
                  THISFORM.GX_DB_GetW10842_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10842 <> 101
               BRKVU42 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W10842_2EmpCod
               THISFORM.A1306RINro = THISFORM.Buf_W10842_1306RINroInt
               THISFORM.A1310RIEst = THISFORM.Buf_W10842_1310RIEst
               THISFORM.A1313RiLug = THISFORM.Buf_W10842_1313RiLugDdeD
               THISFORM.A1312RILug = THISFORM.Buf_W10842_1312RILugDde
               THISFORM.A3183RiPal = THISFORM.Buf_W10842_3183RiPal
               THISFORM.A1311RIObs = THISFORM.Buf_W10842_1311RIObs
               THISFORM.A1319CRIDs = THISFORM.Buf_W10842_1319CRIDsc
               THISFORM.A1318CRICo = THISFORM.Buf_W10842_1318CRICod
               THISFORM.A1584RiHor = THISFORM.Buf_W10842_1584RiHora
               THISFORM.A1308RIFch = THISFORM.Buf_W10842_1308RIFch
               THISFORM.A1317RINro = THISFORM.Buf_W10842_1317RINro
               THISFORM.A1313RiLug = THISFORM.Buf_W10842_1313RiLugDdeD
               THISFORM.A1319CRIDs = THISFORM.Buf_W10842_1319CRIDsc
               GX_SFLOAD = 0
               THISFORM.U18VU42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10842 = Gx_err
               THISFORM.GX_DB_GetW10842_01 ()
            ENDDO
         ENDIF
      ENDPROC
