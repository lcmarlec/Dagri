            ENDIF
            Gx_fcond = S3070CDCod = THISFORM.A3070CDCod .AND. S3073CdTip = THISFORM.A3073CdTip
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT324S16 .Refresh()
               THISFORM. cCT324S16 .AfterRowColChange1()
               THISFORM.A3070CDCod = S3070CDCod
               THISFORM.A3073CdTip = S3073CdTip
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT324S16 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT324S16 .LoadRec(2, @sf_err)
            Gx_fcond = S3070CDCod = THISFORM.A3070CDCod .AND. S3073CdTip = THISFORM.A3073CdTip
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT324S16 .LoadRec(2, @sf_err)
               Gx_fcond = S3070CDCod = THISFORM.A3070CDCod .AND. S3073CdTip = THISFORM.A3073CdTip
            ENDDO
            IF sf_err != 0
               THISFORM. cCT324S16 .AppendRow()
               THISFORM. cCT324S16 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A3070CDCod = S3070CDCod
               THISFORM.A3073CdTip = S3073CdTip
