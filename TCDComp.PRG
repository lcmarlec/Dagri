            USE (SCT324S16) EXCLUSIVE ALIAS SCT324S16
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT324S16
         THIS.GX_SfAlias = "SCT324S16"
      ENDPROC
      PROCEDURE UpdObj(gxmode)
         LOCAL gxO_Area
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         THISFORM. GXInLvl356 = .F.
         THISFORM. cCT324S16 .GX_field_saved = .T.
         THISFORM. cCT324S16 .GX_field_saved = .T.
         THISFORM. cCT324S16 .GX_field_saved = .T.
         THISFORM. cCT324S16 .GX_field_saved = .T.
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T032413" , @HStmt_T032413 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCDCOMP","T032413","",GX_CURSOR_TYPE_READONLY,@HStmt_T032413) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [CDCod], [CdTip], [CdTipDesc], [CdVta], [CdCmp] FROM [CDCOMP1] (NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [CDCod] = ? ORDER BY [CDCod], [CdTip]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T032413,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T032413,13)
                  THISFORM.GX_DB_BindColsT032413_01 ()
                  THISFORM.GX_DB_BindParmT032413_01 ()
               ENDIF
               AuxA3070CDCod = THISFORM.A3070CDCod
               Gx_err = GX_DB_SetInt( HStmt_T032413,1,@AuxA3070CDCod,0)
               THISFORM.A3070CDCod = AuxA3070CDCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T032413) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T032413 = Gx_err
               THISFORM.GX_DB_GetT032413_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T032413 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T032413) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T032413 = Gx_err
                  THISFORM.GX_DB_GetT032413_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T032413 <> 101
               BRK90356 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT324S16.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T032413) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T032413 = Gx_err
               THISFORM.GX_DB_GetT032413_01 ()
            ENDDO
         ENDIF
      ENDPROC
