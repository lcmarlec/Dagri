         * Search in Sub-File
         SELECT (THISFORM. cCT324S16 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT324S16 .SF( 8, @sf_err)     && GO TOP
