      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03246" , @HStmt_T03246 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCDCOMP","T03246","",GX_CURSOR_TYPE_READONLY,@HStmt_T03246) ,  ,  ,  , CS_SQLSRV , 0 )
