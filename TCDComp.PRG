         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3078CdCmp"
            THISFORM.A3078CdCmp = THISFORM.Buf_T032413_3078CdCmp
         ENDIF
      ENDPROC
