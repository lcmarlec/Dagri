         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P01946" , @HStmt_P01946 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PDCOI03","P01946","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P01946) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " UPDATE [TDCOM3] SET [TdcImpCnt]=?  WHERE [EmpCod] = ? AND [TdcNroInt] = ? AND [TdcImpCod] "
            cmdbuf = cmdbuf + "  = ? AND [TdcNim] = ? "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_P01946,cmdbuf)
            GX_DB_BindParmP01946_01 ()
         ENDIF
         Gx_err = GX_DB_SetDouble( HStmt_P01946,1,@R404TdcImp,0)
         Gx_err = GX_DB_SetInt( HStmt_P01946,2,@A2EmpCod,0)
         Gx_err = GX_DB_SetDouble( HStmt_P01946,3,@A380TdcNro,0)
         Gx_err = GX_DB_SetStr( HStmt_P01946,4,R401TdcImp,6,0)
         Gx_err = GX_DB_SetStr( HStmt_P01946,5,R402TdcNim,12,0)
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P01946) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P01946 = Gx_err
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P01946) ,  ,  ,  , CS_SQLSRV ,  )
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         * Exiting from a For First loop.
         EXIT
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P01945) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL5 = .F.
   ELSE
      Gx_err = 0
      Gx_emsg = ""
   ENDIF
   * End Insert
   LEVEL4 = .F.
   DO EP5E0
   RETURN
   DO EP5E0
   RETURN
   GX_retp = 0
* End Program

