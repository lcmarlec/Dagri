      cmdbuf = " SELECT T1.[ChqBcoCod] AS ChqBcoCod, T1.[ChqPrvCod], T1.[ChqBcoCta], T1.[ChqNroI], "
      cmdbuf = cmdbuf + "  T1.[ChqLin], T1.[ChqCliCod], T1.[ChqFchIng], T1.[ChqMonCod] AS ChqMonCod, T1.[ChqFchDeb], "
      cmdbuf = cmdbuf + "  T1.[ChqFchEgr], T1.[ChqCliGrT], T1.[ChqEst], T1.[ChqEsp], T1.[ChqImp], T1.[ChqPrvGrT], "
      cmdbuf = cmdbuf + "  T3.[MonSim] AS ChqMonSim, T2.[BcoDsc] AS ChqBcoDsc, T1.[ChqNro], T1.[ChqNroReg], "
      cmdbuf = cmdbuf + "  T1.[ChqCta], T1.[ChqTip], T1.[EmpCod] FROM (([CHQS] T1 (NOLOCK) LEFT JOIN [BANCOS] "
      cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[BcoCod] = T1.[ChqBcoCod]) LEFT JOIN [MONEDA] T3 (NOLOCK) ON T3.[Moncod] "
      cmdbuf = cmdbuf + "  = T1.[ChqMonCod]) WHERE (T1.[EmpCod] = ? and T1.[ChqTip] >= ? and T1.[ChqCta] = "
      cmdbuf = cmdbuf + "  0 and T1.[ChqNroReg] >= ?) AND (T1.[ChqMonCod] = ? or ? = 0) AND (T1.[ChqNroReg] "
      cmdbuf = cmdbuf + "  <= ?) AND (T1.[ChqFchDeb] >= ?) AND (T1.[ChqFchEgr] >= ?) AND (T1.[ChqFchIng] >= "
      cmdbuf = cmdbuf + "  ?) AND (T1.[ChqFchDeb] <= ?) AND (T1.[ChqFchEgr] <= ?) AND (T1.[ChqFchIng] <= ?) "
      cmdbuf = cmdbuf + "  AND (T1.[ChqCliGrT] = ? or ? = 0) AND (T1.[ChqCliCod] = ? or ? = 0) AND (T1.[ChqEst] "
      cmdbuf = cmdbuf + "  = ? or ? = 10 or ( T1.[ChqEst] >= 7 and ? = 4) or ( T1.[ChqEst] <= 1 and ? = 11)) "
      cmdbuf = cmdbuf + "  AND (T1.[ChqEsp] = ? or ? = 9 or ( ? = 0 and T1.[ChqEsp] + 1 < 2)) AND (T1.[ChqPrvCod] "
      cmdbuf = cmdbuf + "  = ? or ? = 0) AND (T1.[ChqTip] = 'T' or T1.[ChqTip] = 'E') AND (T1.[ChqImp] >= ?) "
      cmdbuf = cmdbuf + "  AND (T1.[ChqImp] <= ? or ? = 0) AND (T1.[ChqTip] <= ?) ORDER BY T1.[EmpCod], T1.[ChqTip], "
      cmdbuf = cmdbuf + "  T1.[ChqCta], T1.[ChqNroReg]  "
