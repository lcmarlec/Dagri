      PROCEDURE CreateTemp
         LOCAL SCT165S34
         SCT165S34 = ""
         IF USED( "SCT165S34" )
            SELECT SCT165S34
            SCT165S34 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT165S34
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA150EntGr"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA120EntCo"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA176EntLg"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1697DMSe"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1698DMIn"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1699DMCn"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 4

            GX_STRUCT[ 7 ,1]= "sA1700DMCn"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCT165S34 = GETE('z:\temp') + '\' + SCT165S34
            ENDIF
            CREATE DBF (SCT165S34) FROM ARRAY GX_STRUCT
            USE
            USE (SCT165S34) EXCLUSIVE ALIAS SCT165S34
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT165S34
         THIS.GX_SfAlias = "SCT165S34"
      ENDPROC
