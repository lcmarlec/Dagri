      PROCEDURE CreateTemp
         LOCAL SCW529S20
         SCW529S20 = ""
         IF USED( "SCW529S20" )
            SELECT SCW529S20
            SCW529S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW529S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1625TmSL"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1626TmSF"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1627TmSF"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1628TmSA"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1629TmSC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA1631TmSP"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW529S20 = GETE('z:\temp') + '\' + SCW529S20
            ENDIF
            CREATE DBF (SCW529S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW529S20) EXCLUSIVE ALIAS SCW529S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW529S20
         THIS.GX_SfAlias = "SCW529S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05292" , @HStmt_W05292 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0575","W05292","",GX_CURSOR_TYPE_READONLY,@HStmt_W05292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TmSNroInt], [TmSUsuario], [TmSFecha], [TmSHora], [TmSPrc], [TmSCntFc], "
                  cmdbuf = cmdbuf + "  [TmSArtCod], [TmSFamSubC], [TmSFamCod], [TmSLin] FROM [TMPSEG1] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ? and [TmSNroInt] = ? and [TmSUsuario] = ? and [TmSFecha] = ? "
                  cmdbuf = cmdbuf + "  and [TmSHora] = ? and [TmSLin] >= ?) AND ([TmSFamCod] >= ?) ORDER BY [EmpCod], [TmSNroInt], "
                  cmdbuf = cmdbuf + "  [TmSUsuario], [TmSFecha], [TmSHora], [TmSLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05292,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05292,9)
                  THISFORM.GX_DB_BindColsW05292_01 ()
                  THISFORM.GX_DB_BindParmW05292_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05292,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1603TmSNr = THISFORM.A1603TmSNr
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05292,2,@AuxA1603TmSNr,0)
               THISFORM.A1603TmSNr = AuxA1603TmSNr
               AuxA1632TmSUs = THISFORM.A1632TmSUs
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05292,3,AuxA1632TmSUs,10,0)
               THISFORM.A1632TmSUs = AuxA1632TmSUs
               AuxA1633TmSFe = THISFORM.A1633TmSFe
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W05292,4,@AuxA1633TmSFe,0)
               THISFORM.A1633TmSFe = AuxA1633TmSFe
               AuxA1634TmSHo = THISFORM.A1634TmSHo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05292,5,AuxA1634TmSHo,8,0)
               THISFORM.A1634TmSHo = AuxA1634TmSHo
               AuxAV5C1625 = THISFORM.AV5C1625
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05292,6,@AuxAV5C1625,0)
               THISFORM.AV5C1625 = AuxAV5C1625
               AuxAV6C1626 = THISFORM.AV6C1626
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05292,7,@AuxAV6C1626,0)
               THISFORM.AV6C1626 = AuxAV6C1626
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05292 = Gx_err
               THISFORM.GX_DB_GetW05292_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05292 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05292) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05292 = Gx_err
                  THISFORM.GX_DB_GetW05292_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05292 <> 101
               BRKVEP2 = .F.
               THISFORM.A1631TmSPr = THISFORM.Buf_W05292_1631TmSPrc
               THISFORM.A1629TmSCn = THISFORM.Buf_W05292_1629TmSCntFc
               THISFORM.A1628TmSAr = THISFORM.Buf_W05292_1628TmSArtCod
               THISFORM.A1627TmSFa = THISFORM.Buf_W05292_1627TmSFamSubC
               THISFORM.A1626TmSFa = THISFORM.Buf_W05292_1626TmSFamCod
               THISFORM.A1625TmSLi = THISFORM.Buf_W05292_1625TmSLin
               GX_SFLOAD = 0
               THISFORM.U12VEP2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05292 = Gx_err
               THISFORM.GX_DB_GetW05292_01 ()
            ENDDO
         ENDIF
      ENDPROC
