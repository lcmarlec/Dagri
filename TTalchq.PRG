               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01676" , @HStmt_T01676 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTALCHQ","T01676","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01676) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [EMPRES]  WHERE [EmpCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01676,cmdbuf)
                  THISFORM.GX_DB_BindParmT01676_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01676,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01676) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01676 = Gx_err
               THISFORM.T01672 = iif( THISFORM.T01676 = 0 , 104 , THISFORM.T01676 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01676) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 53 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
