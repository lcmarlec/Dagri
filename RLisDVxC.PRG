      cmdbuf = cmdbuf + "  = T1.[DcVEntLgCo]) WHERE (T1.[EmpCod] = ? and T1.[DcVFch] >= ?) AND (T1.[DcVEst] "
      cmdbuf = cmdbuf + "  > 0) AND (( T1.[DcVCtaCte] = 'S' and ? = 2) or ( T1.[DcVCtaCte] <> 'S' and ? = 1) "
      cmdbuf = cmdbuf + "  or ( ? = 0) or ( T1.[DcVEst] = 9 and ? = 9) or ( T1.[DcVEst] = 1 and ? = 5)) AND "
      cmdbuf = cmdbuf + "  (T1.[DcvTipRed] = 'NC' or T1.[DcvTipRed] = 'FC' or T1.[DcvTipRed] = 'ND' or T1.[DcVTip] "
