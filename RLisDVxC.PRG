      cmdbuf = " SELECT T1.[DcVNroInt], T1.[DcVSig], T1.[EmpCod], T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVEntCod] "
      cmdbuf = cmdbuf + "  AS DcVEntCod, T1.[DcVFch], T1.[DcVEst], T1.[DcVCtaCte], T1.[DcvTipRed], T1.[DcVEntLgCo] "
