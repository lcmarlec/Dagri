      cmdbuf = cmdbuf + "  AS DcVPaiCod, T2.[EntCui], T1.[DcvTD], T1.[DcvCotiz], T1.[DcVNro], T1.[DcVSuc], "
      cmdbuf = cmdbuf + "  T1.[DcVSer], T1.[DcVTip] FROM (([DCVENT] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
      cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND T2.[EntCod] "
