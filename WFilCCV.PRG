               THISFORM.cCW469S11.SF (4, @GX_SFERR)
               THISFORM.cCW469S11.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW469S11 .ResetSavedGridPos()
         SELECT( THISFORM.cCW469S11 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW469S11.SF (3, @GX_SFERR)
         ENDIF
