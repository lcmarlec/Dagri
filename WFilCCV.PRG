      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04692" , @HStmt_W04692 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFILCCV","W04692","",GX_CURSOR_TYPE_READONLY,@HStmt_W04692) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntLgCo] AS DcVEntLgCo, T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVEst], "
                  cmdbuf = cmdbuf + "  T1.[DcvVerEC], T1.[DcVTot], T1.[EmpCod], T1.[DcVNroInt], T1.[DcVSig], T3.[EntLgDom] "
                  cmdbuf = cmdbuf + "  AS DcVEntLgDo, T2.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVFch], "
                  cmdbuf = cmdbuf + "  T1.[DcVNro], T1.[DcVSuc], T1.[DcVSer], T1.[DcVTip] FROM (([DCVENT] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntGruT] AND T2.[EntCod] = T1.[DcVEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[DcVEntGruT] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntCod] AND T3.[EntLgCod] = T1.[DcVEntLgCo]) WHERE (T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[DcVEntCod] = ? and T1.[DcVFch] >= ?) AND (T1.[DcVEntGruT] = 'CL') AND (T1.[DcVEst] "
                  cmdbuf = cmdbuf + "  > 0) AND (T1.[DcVEst] < 3) ORDER BY T1.[EmpCod], T1.[DcVEntCod], T1.[DcVFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04692,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04692,13)
                  THISFORM.GX_DB_BindColsW04692_01 ()
                  THISFORM.GX_DB_BindParmW04692_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04692,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV24Clicod = THISFORM.AV24Clicod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04692,2,@AuxAV24Clicod,0)
               THISFORM.AV24Clicod = AuxAV24Clicod
               AuxAV13Fecha = THISFORM.AV13Fecha
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04692,3,@AuxAV13Fecha,0)
               THISFORM.AV13Fecha = AuxAV13Fecha
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04692) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04692 = Gx_err
               THISFORM.GX_DB_GetW04692_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV31Pgmnam = "WFilCCV"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04692 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04692) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04692 = Gx_err
                  THISFORM.GX_DB_GetW04692_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04692 <> 101
               BRKVD12 = .F.
               THISFORM.AV27Dcvtot = 0.00
               THISFORM.AV25Excl = 0
               THISFORM.A419DcVEnt = THISFORM.Buf_W04692_419DcVEntLgCo
               THISFORM.A416DcVEnt = THISFORM.Buf_W04692_416DcVEntGruT
               THISFORM.A466DcVEst = THISFORM.Buf_W04692_466DcVEst
               THISFORM.A1465DcvVe = THISFORM.Buf_W04692_1465DcvVerEC
               THISFORM.A464DcVTot = THISFORM.Buf_W04692_464DcVTot
               THISFORM.A2EmpCod = THISFORM.Buf_W04692_2EmpCod
               THISFORM.A415DcVNro = THISFORM.Buf_W04692_415DcVNroInt
               THISFORM.A472DcVSig = THISFORM.Buf_W04692_472DcVSig
               THISFORM.A420DcVEnt = THISFORM.Buf_W04692_420DcVEntLgDo
               THISFORM.A418DcVEnt = THISFORM.Buf_W04692_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W04692_417DcVEntCod
               THISFORM.A421DcVFch = THISFORM.Buf_W04692_421DcVFch
               THISFORM.A425DcVNro = THISFORM.Buf_W04692_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W04692_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W04692_423DcVSer
               THISFORM.A422DcVTip = THISFORM.Buf_W04692_422DcVTip
               THISFORM.A418DcVEnt = THISFORM.Buf_W04692_418DcVEntRaz
               THISFORM.A420DcVEnt = THISFORM.Buf_W04692_420DcVEntLgDo
               GX_SFLOAD = 0
               THISFORM.U16VD12 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04692) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04692 = Gx_err
               THISFORM.GX_DB_GetW04692_01 ()
            ENDDO
         ENDIF
      ENDPROC
