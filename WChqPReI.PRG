      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         THISFORM.AV22Ok = 0
         THISFORM.AV25Ok1 = 1
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW1022S22 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW1022S22.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW1022S22.SF (3, @GX_SFERR)
            THISFORM.cCW1022S22 .SaveGridPos()
            IF THISFORM.AV6Reingre = 1
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A121ChqNro
               Aux2 = THISFORM.A122ChqLin
               Aux3 = THISFORM.A123ChqTip
               Aux4 = THISFORM.A124ChqCta
               Aux5 = THISFORM.AV5Chqre
               Aux6 = THISFORM.AV15Chqfch
               Aux7 = THISFORM.AV22Ok
               DO PChqPReI WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7
               THISFORM.A2EmpCod = Aux0
               THISFORM.A121ChqNro = Aux1
               THISFORM.A122ChqLin = Aux2
               THISFORM.A123ChqTip = Aux3
               THISFORM.A124ChqCta = Aux4
               THISFORM.AV5Chqre = Aux5
               THISFORM.AV15Chqfch = Aux6
               THISFORM.AV22Ok = Aux7
               THISFORM. cCW1022S22 .RestoreGridPos()
               THISFORM. cCW1022S22.Columns(1).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW1022S22.Columns(5).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW1022S22 .GX_rec_modif = .T.
               THISFORM. cCW1022S22 .GX_LastVld1 = THISFORM. cCW1022S22.Columns(1).Ctrl1 .GXColumnNo - 1
               GX_rploop = .T.
               IF THISFORM.AV22Ok = 0
                  THISFORM.AV25Ok1 = 0
                  DO GX_ERRMW WITH "El cheque " + THISFORM.A121ChqNro + " no pudo ser reingresado"
               ELSE
                  THISFORM.AV24Numero = ALLTRIM( str( THISFORM.A2EmpCod ) ) + " " + ALLTRIM( str( THISFORM.A121ChqNro ) ) + " " + ALLTRIM( str( THISFORM.A122ChqLin ) ) + " P " + ALLTRIM( str( THISFORM.A124ChqCta ) )
                  THISFORM.AV23Audobs = "Reingreso exitoso del cheque:" + THISFORM.AV24Numero
                  THISFORM.SaveTblPos()
                  Aux1 = THISFORM.AV9Emprcod
                  Aux3 = THISFORM.AV24Numero
                  Aux5 = THISFORM.AV23Audobs
                  Aux6 = THISFORM.AV14Usuari
                  DO PAuditor WITH "BCOS" , Aux1 , "CHQS" , Aux3 , "INS" , Aux5 , Aux6
                  THISFORM.AV9Emprcod = Aux1
                  THISFORM.AV24Numero = Aux3
                  THISFORM.AV23Audobs = Aux5
                  THISFORM.AV14Usuari = Aux6
                  THISFORM. cCW1022S22 .RestoreGridPos()
                  GX_rploop = .T.
               ENDIF
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW1022S22 .RestoreGridPos()
               THISFORM.cCW1022S22.SF (4, @GX_SFERR)
               THISFORM.cCW1022S22.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW1022S22 .ResetSavedGridPos()
         SELECT( THISFORM.cCW1022S22 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW1022S22.SF (3, @GX_SFERR)
         ENDIF
         IF THISFORM.AV25Ok1 = 1
            DO GX_ERRMW WITH "Todos los cheques tildados fueron reingresados exitosamente."
         ELSE
            DO GX_ERRMW WITH "Recuerde revisar el/los cheque/s que no pudieron ser reingresados."
         ENDIF
         THISFORM.GX_Refresh = 1   &&& Refresh
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

