      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09952" , @HStmt_W09952 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLPEDXUS","W09952","",GX_CURSOR_TYPE_READONLY,@HStmt_W09952) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [UsuNombre], [UsuCod] FROM [USU002] (FASTFIRSTROW NOLOCK) ORDER BY [UsuCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09952,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09952,11)
                  THISFORM.GX_DB_BindColsW09952_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09952) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09952 = Gx_err
               THISFORM.GX_DB_GetW09952_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV61Pgmnam = "WLPedxUs"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09952 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09952) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09952 = Gx_err
                  THISFORM.GX_DB_GetW09952_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09952 <> 101
               BRKVRN2 = .F.
               THISFORM.AV60Op = SPACE(1)
               THISFORM.A65UsuNomb = THISFORM.Buf_W09952_65UsuNombre
               THISFORM.A64UsuCod = THISFORM.Buf_W09952_64UsuCod
               GX_SFLOAD = 0
               THISFORM.U15VRN2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09952) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09952 = Gx_err
               THISFORM.GX_DB_GetW09952_01 ()
            ENDDO
         ENDIF
      ENDPROC
