            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW995S14 = GETE('z:\temp') + '\' + SCW995S14
            ENDIF
            CREATE DBF (SCW995S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW995S14) EXCLUSIVE ALIAS SCW995S14
         ENDIF
         SET DELETE ON
