      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11802" , @HStmt_W11802 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCONPREA","W11802","",GX_CURSOR_TYPE_READONLY,@HStmt_W11802) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ConPreDsc], [ConPreId] FROM [CONPRE] (FASTFIRSTROW NOLOCK) WHERE [ConPreDsc] "
                  cmdbuf = cmdbuf + "  like ? ORDER BY [ConPreId]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11802,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11802,12)
                  THISFORM.GX_DB_BindColsW11802_01 ()
                  THISFORM.GX_DB_BindParmW11802_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11802,1,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11802 = Gx_err
               THISFORM.GX_DB_GetW11802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WConPreA"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11802 = Gx_err
                  THISFORM.GX_DB_GetW11802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11802 <> 101
               BRKVWS2 = .F.
               THISFORM.A3431ConPr = THISFORM.Buf_W11802_3431ConPreDsc
               THISFORM.A3430ConPr = THISFORM.Buf_W11802_3430ConPreId
               GX_SFLOAD = 0
               THISFORM.U16VWS2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
