               Aux1 = THISFORM.AV21Mes
               Aux2 = THISFORM.AV22Anio
               Aux3 = THISFORM.AV23Numero
               Aux4 = THISFORM.AV20Tipo
               Aux5 = THISFORM.AV24Ni
