               THISFORM.AV21Mes = Aux1
               THISFORM.AV22Anio = Aux2
               THISFORM.AV23Numero = Aux3
               THISFORM.AV20Tipo = Aux4
               THISFORM.AV24Ni = Aux5
               GX_rploop = .T.
            CASE THISFORM.AV20Tipo = "D"
               THISFORM.AV27Td = "NDP"
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.AV21Mes
               Aux2 = THISFORM.AV22Anio
               Aux3 = THISFORM.AV23Numero
               Aux4 = THISFORM.AV27Td
               Aux5 = THISFORM.AV24Ni
               DO RCtrNdp WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5
               THISFORM.AV8Emprcod = Aux0
               THISFORM.AV21Mes = Aux1
               THISFORM.AV22Anio = Aux2
               THISFORM.AV23Numero = Aux3
               THISFORM.AV27Td = Aux4
               THISFORM.AV24Ni = Aux5
               GX_rploop = .T.
            CASE THISFORM.AV20Tipo = "C"
               THISFORM.AV27Td = "NCP"
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.AV21Mes
               Aux2 = THISFORM.AV22Anio
               Aux3 = THISFORM.AV23Numero
               Aux4 = THISFORM.AV27Td
               Aux5 = THISFORM.AV24Ni
               DO RCtrNdp WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5
               THISFORM.AV8Emprcod = Aux0
               THISFORM.AV21Mes = Aux1
               THISFORM.AV22Anio = Aux2
               THISFORM.AV23Numero = Aux3
               THISFORM.AV27Td = Aux4
               THISFORM.AV24Ni = Aux5
               GX_rploop = .T.
         ENDCASE
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV17Usuari
         Aux2 = THISFORM.AV8Emprcod
         Aux3 = THISFORM.AV26Nivesp
         DO RNivAcc WITH Aux0 , "DCCESP" , Aux2 , Aux3
         THISFORM.AV17Usuari = Aux0
         THISFORM.AV8Emprcod = Aux2
         THISFORM.AV26Nivesp = Aux3
         GX_rploop = .T.
         IF THISFORM.AV26Nivesp < 1
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03792" , @HStmt_W03792 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCMOD","W03792","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W03792) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [DcCNroInt], [DccEsp] FROM [DCCOM] (NOLOCK) WHERE [EmpCod] = ? and "
               cmdbuf = cmdbuf + "  [DcCNroInt] = ? ORDER BY [EmpCod], [DcCNroInt]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03792,cmdbuf)
               THISFORM.GX_DB_BindColsW03792_01 ()
               THISFORM.GX_DB_BindParmW03792_01 ()
            ENDIF
            AuxAV8Emprcod = THISFORM.AV8Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03792,1,@AuxAV8Emprcod,0)
            THISFORM.AV8Emprcod = AuxAV8Emprcod
            AuxAV24Ni = THISFORM.AV24Ni
            THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03792,2,@AuxAV24Ni,0)
            THISFORM.AV24Ni = AuxAV24Ni
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03792) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W03792 = Gx_err
            THISFORM.GX_DB_GetW03792_01 ()
            DO WHILE THISFORM.W03792 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W03792_2EmpCod
               THISFORM.A346DcCNro = THISFORM.Buf_W03792_346DcCNroInt
               THISFORM.A1882DccEs = THISFORM.Buf_W03792_1882DccEsp
               IF THISFORM.A1882DccEs = "S"
                  THISFORM.AV24Ni = 0
               ENDIF
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W03792) ,  ,  ,  , CS_SQLSRV ,  )
         ENDIF
         IF THISFORM.AV24Ni > 0
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV8Emprcod
            Aux1 = THISFORM.AV24Ni
            Aux2 = THISFORM.AV6Fechasi
            Aux3 = THISFORM.AV17Usuari
            DO PDccMod WITH Aux0 , Aux1 , Aux2 , Aux3
            THISFORM.AV8Emprcod = Aux0
            THISFORM.AV24Ni = Aux1
            THISFORM.AV6Fechasi = Aux2
            THISFORM.AV17Usuari = Aux3
            GX_rploop = .T.
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

