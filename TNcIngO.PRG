      PROCEDURE CreateTemp
         LOCAL SCT66S10
         SCT66S10 = ""
         IF USED( "SCT66S10" )
            SELECT SCT66S10
            SCT66S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT66S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA657tDVFL"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA658tDVFO"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 60
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT66S10 = GETE('z:\temp') + '\' + SCT66S10
            ENDIF
            CREATE DBF (SCT66S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCT66S10) EXCLUSIVE ALIAS SCT66S10
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT66S10
         THIS.GX_SfAlias = "SCT66S10"
      ENDPROC
