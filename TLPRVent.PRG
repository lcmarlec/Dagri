      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T030714" , @HStmt_T030714 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLPRVENT","T030714","",GX_CURSOR_TYPE_READONLY,@HStmt_T030714) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [lprfch], [LprInd], [FamCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [ArtCod], [ArtLprPrc] FROM [LPRVENT1] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] "
                  cmdbuf = cmdbuf + "  = ? AND [EntCod] = ? AND [lprfch] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [lprfch], [LprInd], [FamCod], [FamSubCod], [ArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T030714,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T030714,10)
                  THISFORM.GX_DB_BindColsT030714_01 ()
                  THISFORM.GX_DB_BindParmT030714_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T030714,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T030714,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T030714,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA2953lprfc = THISFORM.A2953lprfc
               Gx_err = GX_DB_SetDate( HStmt_T030714,4,@AuxA2953lprfc,0)
               THISFORM.A2953lprfc = AuxA2953lprfc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T030714) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030714 = Gx_err
               THISFORM.GX_DB_GetT030714_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T030714 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030714) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T030714 = Gx_err
                  THISFORM.GX_DB_GetT030714_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T030714 <> 101
               BRK8J340 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT307S10.Columns(4).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T030714_2953lprfch = THISFORM.A2953lprfc .AND. THISFORM.Buf_T030714_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T030714_120EntCod = THISFORM.A120EntCod .AND. THISFORM.Buf_T030714_150EntGruTip = THISFORM.A150EntGru
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030714) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030714 = Gx_err
               THISFORM.GX_DB_GetT030714_01 ()
            ENDDO
         ENDIF
      ENDPROC
