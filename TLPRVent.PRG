         S120EntCod = THISFORM.A120EntCod
         S2953lprfc = THISFORM.A2953lprfc
         S2954LprIn = THISFORM.A2954LprIn
         S3FamCod = THISFORM.A3FamCod
         S4FamSubCo = THISFORM.A4FamSubCo
         S5ArtCod = THISFORM.A5ArtCod
         THISFORM.A2954LprIn = THISFORM.M2954LprIn
         THISFORM.A3FamCod = THISFORM.M3FamCod
         THISFORM.A4FamSubCo = THISFORM.M4FamSubCo
         THISFORM.A5ArtCod = THISFORM.M5ArtCod
         THISFORM. cCT307S10 .SaveTemp()
         THISFORM. cCT307S10 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT307S10 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT307S10 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT307S10 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2953lprfc = THISFORM.A2953lprfc .AND. S2954LprIn = THISFORM.A2954LprIn
         Gx_fcond = Gx_fcond .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT307S10 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT307S10 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2953lprfc = THISFORM.A2953lprfc .AND. S2954LprIn = THISFORM.A2954LprIn
            Gx_fcond = Gx_fcond .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT307S10 .Refresh()
               THISFORM. cCT307S10 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A2953lprfc = S2953lprfc
               THISFORM.A2954LprIn = S2954LprIn
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT307S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT307S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2953lprfc = THISFORM.A2953lprfc .AND. S2954LprIn = THISFORM.A2954LprIn
            Gx_fcond = Gx_fcond .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT307S10 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2953lprfc = THISFORM.A2953lprfc .AND. S2954LprIn = THISFORM.A2954LprIn
               Gx_fcond = Gx_fcond .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT307S10 .AppendRow()
               THISFORM. cCT307S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A2953lprfc = S2953lprfc
               THISFORM.A2954LprIn = S2954LprIn
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A150EntGru = S150EntGru
         THISFORM.A120EntCod = S120EntCod
         THISFORM.A2953lprfc = S2953lprfc
         THISFORM.A2954LprIn = S2954LprIn
         THISFORM.A3FamCod = S3FamCod
         THISFORM.A4FamSubCo = S4FamSubCo
         THISFORM.A5ArtCod = S5ArtCod
         RETURN .F.
