                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T030710,cmdbuf)
                  THISFORM.GX_DB_BindParmT030710_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T030710,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
