               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T030710,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA2953lprfc = THISFORM.A2953lprfc
               Gx_err = GX_DB_SetDate( HStmt_T030710,4,@AuxA2953lprfc,0)
               THISFORM.A2953lprfc = AuxA2953lprfc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T030710) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030710 = Gx_err
               THISFORM.T03075 = iif( THISFORM.T030710 = 0 , 104 , THISFORM.T030710 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T030710) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
