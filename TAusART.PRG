         THISFORM. cCT388S34 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT388S34 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT388S34 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT388S34 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3582AArtN = THISFORM.A3582AArtN .AND. S3587AArtM = THISFORM.A3587AArtM
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT388S34 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT388S34 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3582AArtN = THISFORM.A3582AArtN .AND. S3587AArtM = THISFORM.A3587AArtM
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT388S34 .Refresh()
               THISFORM. cCT388S34 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3582AArtN = S3582AArtN
               THISFORM.A3587AArtM = S3587AArtM
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT388S34 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT388S34 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3582AArtN = THISFORM.A3582AArtN .AND. S3587AArtM = THISFORM.A3587AArtM
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT388S34 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3582AArtN = THISFORM.A3582AArtN .AND. S3587AArtM = THISFORM.A3587AArtM
            ENDDO
            IF sf_err != 0
               THISFORM. cCT388S34 .AppendRow()
               THISFORM. cCT388S34 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3582AArtN = S3582AArtN
               THISFORM.A3587AArtM = S3587AArtM
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A3582AArtN = S3582AArtN
         THISFORM.A3587AArtM = S3587AArtM
         RETURN .F.
