      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12902" , @HStmt_W12902 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WINGROP","W12902","",GX_CURSOR_TYPE_READONLY,@HStmt_W12902) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RopObs], T1.[RopCnt], T1.[ArtTalle], T2.[ArtDsc], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod], T1.[FamCod], T1.[RopFch], T1.[RopFchEnt], T1.[TraCod] FROM ([ENTREGA] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] "
                  cmdbuf = cmdbuf + "  = T1.[ArtCod]) WHERE (T1.[EmpCod] = ? and T1.[TraCod] = 0) AND (T1.[RopFchEnt] >= "
                  cmdbuf = cmdbuf + "  ?) AND (T1.[ArtCod] = ? or ? = 0) ORDER BY T1.[EmpCod], T1.[TraCod], T1.[RopFch], "
                  cmdbuf = cmdbuf + "  T1.[FamCod], T1.[FamSubCod], T1.[ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12902,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12902,13)
                  THISFORM.GX_DB_BindColsW12902_01 ()
                  THISFORM.GX_DB_BindParmW12902_01 ()
