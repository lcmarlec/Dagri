      ***********************
      PROCEDURE U12V2M2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'CONFIRMAR'" )
         * 'Confirmar' Routine
         THISFORM.AV17Afparm = THISFORM.AV16Af
         IF THISFORM.AV13Afnro <> 0
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV7Emprcod
            Aux1 = THISFORM.AV10Aftipo
            Aux2 = THISFORM.AV11Afseri
            Aux3 = THISFORM.AV12Afsuc
            Aux4 = THISFORM.AV13Afnro
            Aux5 = THISFORM.AV9Ni
            Aux6 = THISFORM.AV5Fechasi
            DO RCtrDcV WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV7Emprcod = Aux0
            THISFORM.AV10Aftipo = Aux1
            THISFORM.AV11Afseri = Aux2
            THISFORM.AV12Afsuc = Aux3
            THISFORM.AV13Afnro = Aux4
            THISFORM.AV9Ni = Aux5
            THISFORM.AV5Fechasi = Aux6
            GX_rploop = .T.
            THISFORM.AV15Ok = 1
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00942" , @HStmt_W00942 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WNCSDA","W00942","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00942) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [DcVNroInt], [DcVFch], [DcVCtaCte], [DcVEst] FROM [DCVENT] (NOLOCK) "
               cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [DcVNroInt] = ? ORDER BY [EmpCod], [DcVNroInt]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00942,cmdbuf)
               THISFORM.GX_DB_BindColsW00942_01 ()
               THISFORM.GX_DB_BindParmW00942_01 ()
            ENDIF
            AuxAV7Emprcod = THISFORM.AV7Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00942,1,@AuxAV7Emprcod,0)
            THISFORM.AV7Emprcod = AuxAV7Emprcod
            AuxAV9Ni = THISFORM.AV9Ni
            THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00942,2,@AuxAV9Ni,0)
            THISFORM.AV9Ni = AuxAV9Ni
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00942) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W00942 = Gx_err
            THISFORM.GX_DB_GetW00942_01 ()
            DO WHILE THISFORM.W00942 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W00942_2EmpCod
               THISFORM.A415DcVNro = THISFORM.Buf_W00942_415DcVNroInt
               THISFORM.A421DcVFch = THISFORM.Buf_W00942_421DcVFch
               THISFORM.A467DcVCta = THISFORM.Buf_W00942_467DcVCtaCte
               THISFORM.A466DcVEst = THISFORM.Buf_W00942_466DcVEst
               IF THISFORM.A421DcVFch > THISFORM.AV5Fechasi
                  THISFORM.AV15Ok = 0
                  THISFORM.SaveTblPos()
                  DO Werrores WITH "El documento es posterior a la fecha" , "R"
                  GX_rploop = .T.
               ELSE
                  IF THISFORM.A466DcVEst = 2 .AND. THISFORM.A467DcVCta = "S"
                     THISFORM.Refresh()
                     DO GX_ERRMW WITH "Atencion!!!! El documento se encuentra PAGADO"
                  ELSE
                     IF THISFORM.A466DcVEst = 3
                        THISFORM.Refresh()
                        DO GX_ERRMW WITH "Atencion!!!! El documento se cancelo con N/C"
                     ENDIF
                  ENDIF
               ENDIF
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00942) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV15Ok = 1
               IF THISFORM.AV9Ni = 0
                  THISFORM.SaveTblPos()
                  DO Werrores WITH "No existe el documento a afectar" , "R"
                  GX_rploop = .T.
               ELSE
                  THISFORM.ReleaseAll()
                  RETURN
               ENDIF
            ENDIF
         ELSE
            THISFORM.AV9Ni = 0
            THISFORM.ReleaseAll()
            RETURN
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

