      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03542,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA1083ECHNr = THISFORM.A1083ECHNr
            Gx_err = GX_DB_SetDouble( HStmt_T03542,2,@AuxA1083ECHNr,0)
            THISFORM.A1083ECHNr = AuxA1083ECHNr
            AuxA1091EchCt = THISFORM.A1091EchCt
            Gx_err = GX_DB_SetStr( HStmt_T03542,3,AuxA1091EchCt,12,0)
            THISFORM.A1091EchCt = AuxA1091EchCt
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03542) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03542 = Gx_err
            THISFORM.GX_DB_GetT03542_01 ()
            IF .NOT. THISFORM.T03542 <> 103
               DO GX_ERRMW WITH "ENTCHE2 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03542 = 101 .OR. THISFORM.Z1100EchCt <> THISFORM.Buf_T03542_1100EchCtaImp
               DO GX_ERRMW WITH "ENTCHE2 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03546" , @HStmt_T03546 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTCHE2","T03546","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03546) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ENTCHE2] ([EmpCod], [ECHNroInt], [EchCtaCod], [EchCtaImp]) VALUES (?, "
                  cmdbuf = cmdbuf + "  ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03546,cmdbuf)
                  THISFORM.GX_DB_BindParmT03546_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03546,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               Gx_err = GX_DB_SetDouble( HStmt_T03546,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               AuxA1091EchCt = THISFORM.A1091EchCt
               Gx_err = GX_DB_SetStr( HStmt_T03546,3,AuxA1091EchCt,12,0)
               THISFORM.A1091EchCt = AuxA1091EchCt
               AuxA1100EchCt = THISFORM.A1100EchCt
               Gx_err = GX_DB_SetDouble( HStmt_T03546,4,@AuxA1100EchCt,0)
               THISFORM.A1100EchCt = AuxA1100EchCt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03546) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03546 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03546) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03546 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03547" , @HStmt_T03547 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTCHE2","T03547","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03547) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [ENTCHE2] SET [EchCtaImp]=?  WHERE [EmpCod] = ? AND [ECHNroInt] = ? AND [EchCtaCod] "
                  cmdbuf = cmdbuf + "  = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03547,cmdbuf)
                  THISFORM.GX_DB_BindParmT03547_01 ()
               ENDIF
               AuxA1100EchCt = THISFORM.A1100EchCt
               Gx_err = GX_DB_SetDouble( HStmt_T03547,1,@AuxA1100EchCt,0)
               THISFORM.A1100EchCt = AuxA1100EchCt
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03547,2,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               Gx_err = GX_DB_SetDouble( HStmt_T03547,3,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               AuxA1091EchCt = THISFORM.A1091EchCt
               Gx_err = GX_DB_SetStr( HStmt_T03547,4,AuxA1091EchCt,12,0)
               THISFORM.A1091EchCt = AuxA1091EchCt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03547) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03547 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03547) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03548" , @HStmt_T03548 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTCHE2","T03548","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03548) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ENTCHE2]  WHERE [EmpCod] = ? AND [ECHNroInt] = ? AND [EchCtaCod] = ? "
                  cmdbuf = cmdbuf + "  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03548,cmdbuf)
                  THISFORM.GX_DB_BindParmT03548_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03548,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               Gx_err = GX_DB_SetDouble( HStmt_T03548,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               AuxA1091EchCt = THISFORM.A1091EchCt
               Gx_err = GX_DB_SetStr( HStmt_T03548,3,AuxA1091EchCt,12,0)
               THISFORM.A1091EchCt = AuxA1091EchCt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03548) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03548 = Gx_err
               THISFORM.T03542 = iif( THISFORM.T03548 = 0 , 104 , THISFORM.T03548 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03548) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
