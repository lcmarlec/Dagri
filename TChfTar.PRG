      PROCEDURE CreateTemp
         LOCAL SCT181S13
         SCT181S13 = ""
         IF USED( "SCT181S13" )
            SELECT SCT181S13
            SCT181S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT181S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1817chTK"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 9
            GX_STRUCT[ 1 ,4]= 4

            GX_STRUCT[ 2 ,1]= "sA1819chTK"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1820chTK"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1825ChtK"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1818chTK"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 9
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA1821ChTT"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCT181S13 = GETE('z:\temp') + '\' + SCT181S13
            ENDIF
            CREATE DBF (SCT181S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCT181S13) EXCLUSIVE ALIAS SCT181S13
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT181S13
         THIS.GX_SfAlias = "SCT181S13"
      ENDPROC
