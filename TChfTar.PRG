         LOCAL S1820chTKg
         S2EmpCod = THISFORM.A2EmpCod
         S1549ChfEn = THISFORM.A1549ChfEn
         S1550ChfEn = THISFORM.A1550ChfEn
         S1817chTKg = THISFORM.A1817chTKg
         S1819chTKg = THISFORM.A1819chTKg
         S1820chTKg = THISFORM.A1820chTKg
         THISFORM.A1817chTKg = THISFORM.M1817chTKg
         THISFORM.A1819chTKg = THISFORM.M1819chTKg
         THISFORM.A1820chTKg = THISFORM.M1820chTKg
         THISFORM. cCT181S13 .SaveTemp()
         THISFORM. cCT181S13 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT181S13 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT181S13 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT181S13 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1549ChfEn = THISFORM.A1549ChfEn .AND. S1550ChfEn = THISFORM.A1550ChfEn .AND. S1817chTKg = THISFORM.A1817chTKg .AND. S1819chTKg = THISFORM.A1819chTKg
         Gx_fcond = Gx_fcond .AND. S1820chTKg = THISFORM.A1820chTKg
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT181S13 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT181S13 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1549ChfEn = THISFORM.A1549ChfEn .AND. S1550ChfEn = THISFORM.A1550ChfEn .AND. S1817chTKg = THISFORM.A1817chTKg .AND. S1819chTKg = THISFORM.A1819chTKg
            Gx_fcond = Gx_fcond .AND. S1820chTKg = THISFORM.A1820chTKg
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT181S13 .Refresh()
               THISFORM. cCT181S13 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1549ChfEn = S1549ChfEn
               THISFORM.A1550ChfEn = S1550ChfEn
               THISFORM.A1817chTKg = S1817chTKg
               THISFORM.A1819chTKg = S1819chTKg
               THISFORM.A1820chTKg = S1820chTKg
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT181S13 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT181S13 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1549ChfEn = THISFORM.A1549ChfEn .AND. S1550ChfEn = THISFORM.A1550ChfEn .AND. S1817chTKg = THISFORM.A1817chTKg .AND. S1819chTKg = THISFORM.A1819chTKg
            Gx_fcond = Gx_fcond .AND. S1820chTKg = THISFORM.A1820chTKg
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT181S13 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1549ChfEn = THISFORM.A1549ChfEn .AND. S1550ChfEn = THISFORM.A1550ChfEn .AND. S1817chTKg = THISFORM.A1817chTKg .AND. S1819chTKg = THISFORM.A1819chTKg
               Gx_fcond = Gx_fcond .AND. S1820chTKg = THISFORM.A1820chTKg
            ENDDO
            IF sf_err != 0
               THISFORM. cCT181S13 .AppendRow()
               THISFORM. cCT181S13 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1549ChfEn = S1549ChfEn
               THISFORM.A1550ChfEn = S1550ChfEn
               THISFORM.A1817chTKg = S1817chTKg
               THISFORM.A1819chTKg = S1819chTKg
               THISFORM.A1820chTKg = S1820chTKg
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1549ChfEn = S1549ChfEn
         THISFORM.A1550ChfEn = S1550ChfEn
         THISFORM.A1817chTKg = S1817chTKg
         THISFORM.A1819chTKg = S1819chTKg
         THISFORM.A1820chTKg = S1820chTKg
         RETURN .F.
      ENDFUNC
