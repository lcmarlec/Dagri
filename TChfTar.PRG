      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T018115" , @HStmt_T018115 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCHFTAR","T018115","",GX_CURSOR_TYPE_READONLY,@HStmt_T018115) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [ChfEntGruT] AS ChfEntGruT, [ChfEntCod] AS ChfEntCod, [chTKgHta], "
                  cmdbuf = cmdbuf + "  [chTKgPaiCo] AS chTKgPaiCo, [chTKgPciCo] AS chTKgPciCo, [chTKgMin], [ChTTarifa] "
                  cmdbuf = cmdbuf + "  FROM [CHFTAR1] (NOLOCK) WHERE [EmpCod] = ? AND [ChfEntGruT] = ? AND [ChfEntCod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [ChfEntGruT], [ChfEntCod], [chTKgHta], [chTKgPaiCo], [chTKgPciCo] "
                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T018115,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T018115,11)
                  THISFORM.GX_DB_BindColsT018115_01 ()
                  THISFORM.GX_DB_BindParmT018115_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T018115,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1549ChfEn = THISFORM.A1549ChfEn
               Gx_err = GX_DB_SetStr( HStmt_T018115,2,AuxA1549ChfEn,2,0)
               THISFORM.A1549ChfEn = AuxA1549ChfEn
               AuxA1550ChfEn = THISFORM.A1550ChfEn
               Gx_err = GX_DB_SetLong( HStmt_T018115,3,@AuxA1550ChfEn,0)
               THISFORM.A1550ChfEn = AuxA1550ChfEn
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T018115) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T018115 = Gx_err
               THISFORM.GX_DB_GetT018115_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T018115 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T018115) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T018115 = Gx_err
                  THISFORM.GX_DB_GetT018115_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T018115 <> 101
               BRK51210 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT181S13.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T018115_1550ChfEntCod = THISFORM.A1550ChfEn .AND. THISFORM.Buf_T018115_1549ChfEntGruT = THISFORM.A1549ChfEn .AND. THISFORM.Buf_T018115_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T018115) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T018115 = Gx_err
               THISFORM.GX_DB_GetT018115_01 ()
            ENDDO
         ENDIF
      ENDPROC
