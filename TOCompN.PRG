               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00775) , "TOCOMPN" )
               IF TYPE( "HConn_Default" ) = "N"
                  IF GXCONNECTED
                     Gx_Err = Gx_odbc_mrc( GX_DB_ConnRollback(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDIF
               ENDIF
            ELSE
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00777) , "TOCOMPN" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00776) , "TOCOMPN" )
