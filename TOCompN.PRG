                  cmdbuf = cmdbuf + "  [OcoArtCpr], [OcoLObs], [OCoCnt], [OCoCntEnt], [OCoFEn], [OCoPrc], [OcoPrcFcU], "
                  cmdbuf = cmdbuf + "  [OcoPrcOri], [OCoLEs], [OcoDet] FROM [OCOMPN1] (NOLOCK) WHERE [EmpCod] = ? AND [OCoNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [OCoNroInt], [OCoLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007719,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007719,12)
                  THISFORM.GX_DB_BindColsT007719_01 ()
                  THISFORM.GX_DB_BindParmT007719_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T007719,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA682OCoNro = THISFORM.A682OCoNro
               Gx_err = GX_DB_SetDouble( HStmt_T007719,2,@AuxA682OCoNro,0)
               THISFORM.A682OCoNro = AuxA682OCoNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007719) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007719 = Gx_err
               THISFORM.GX_DB_GetT007719_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T007719 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007719) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T007719 = Gx_err
                  THISFORM.GX_DB_GetT007719_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T007719 <> 101
               BRK2577 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT77S40.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T007719_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T007719_682OCoNroInt = THISFORM.A682OCoNro
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007719) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007719 = Gx_err
               THISFORM.GX_DB_GetT007719_01 ()
            ENDDO
         ENDIF
