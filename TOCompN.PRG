         S682OCoNro = THISFORM.A682OCoNro
         S695OCoLin = THISFORM.A695OCoLin
         THISFORM.A695OCoLin = THISFORM.M695OCoLin
         THISFORM. cCT77S40 .SaveTemp()
         THISFORM. cCT77S40 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT77S40 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT77S40 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT77S40 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT77S40 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT77S40 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT77S40 .Refresh()
               THISFORM. cCT77S40 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A682OCoNro = S682OCoNro
               THISFORM.A695OCoLin = S695OCoLin
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT77S40 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT77S40 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT77S40 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
            ENDDO
            IF sf_err != 0
               THISFORM. cCT77S40 .AppendRow()
               THISFORM. cCT77S40 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A682OCoNro = S682OCoNro
               THISFORM.A695OCoLin = S695OCoLin
               RETURN .T.
            ENDIF
         ENDIF
