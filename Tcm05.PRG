         * Search in Sub-File
         SELECT (THISFORM. cCT314S12 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT314S12 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT314S12 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S3011CMAni = THISFORM.A3011CMAni .AND. S631PaiCod = THISFORM.A631PaiCod .AND. S633PciCod = THISFORM.A633PciCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT314S12 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT314S12 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S3011CMAni = THISFORM.A3011CMAni .AND. S631PaiCod = THISFORM.A631PaiCod .AND. S633PciCod = THISFORM.A633PciCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT314S12 .Refresh()
               THISFORM. cCT314S12 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A166EntCui = S166EntCui
               THISFORM.A3011CMAni = S3011CMAni
