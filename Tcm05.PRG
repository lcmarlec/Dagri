                  cmdbuf = cmdbuf + "  [EmpCod] = ? AND [EntCui] = ? AND [CMAnio] = ? ORDER BY [EmpCod], [EntCui], [CMAnio], "
                  cmdbuf = cmdbuf + "  [PaiCod], [PciCod]  "
