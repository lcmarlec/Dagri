            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA631PaiCo"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA633PciCo"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA634PciDs"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA786PciDG"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA3012cmco"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 7
            GX_STRUCT[ 7 ,4]= 4

            GX_STRUCT[ 8 ,1]= "sA2EmpCod"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 4
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT314S12 = GETE('z:\temp') + '\' + SCT314S12
            ENDIF
            CREATE DBF (SCT314S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCT314S12) EXCLUSIVE ALIAS SCT314S12
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
