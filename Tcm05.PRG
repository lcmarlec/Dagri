      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T031416" , @HStmt_T031416 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCM05","T031416","",GX_CURSOR_TYPE_READONLY,@HStmt_T031416) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntCui], [CMAnio], [PaiCod], [PciCod], [cmcoef] FROM [CM052] (NOLOCK) "
                  cmdbuf = cmdbuf + "  ORDER BY [EmpCod], [EntCui], [CMAnio], [PaiCod], [PciCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T031416,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T031416,14)
                  THISFORM.GX_DB_BindColsT031416_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T031416) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031416 = Gx_err
               THISFORM.GX_DB_GetT031416_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T031416 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031416) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T031416 = Gx_err
                  THISFORM.GX_DB_GetT031416_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T031416 <> 101
               BRK8Q347 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT314S12.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031416) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031416 = Gx_err
               THISFORM.GX_DB_GetT031416_01 ()
            ENDDO
         ENDIF
      ENDPROC
