                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03146) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03146 = Gx_err
                  THISFORM.GX_DB_GetT03146_01 ()
                  THISFORM. cCT314A3011 . ZM8Q346 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC8Q346 ()
               THISFORM. cCT314A3011 . ZM8Q346 ( 0 )
               DO GX_CONFW WITH "Eliminar toda la informacion en " + " cm05 ?", Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC8Q346 ()
