                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T031417) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031417 = Gx_err
               THISFORM.GX_DB_GetT031417_01 ()
               DO WHILE THISFORM.T031417 <> 101 .AND. THISFORM.Buf_T031417_2EmpCod=THISFORM.Buf_T03146_2EmpCod .AND. THISFORM.Buf_T031417_166EntCui=THISFORM.Buf_T03146_166EntCui .AND. THISFORM.Buf_T031417_3011CMAnio=THISFORM.Buf_T03146_3011CMAnio
