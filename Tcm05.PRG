               ENDIF
               IF ! THISFORM. cCT314V7 .CheckTables()
                  RETURN .F.
               ENDIF
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T031417" , @HStmt_T031417 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCM05","T031417","",GX_CURSOR_TYPE_READONLY,@HStmt_T031417) ,  ,  ,  , CS_SQLSRV , 0 )
