         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01313" , @HStmt_W01313 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRGAVER","W01313","",GX_CURSOR_TYPE_READONLY,@HStmt_W01313) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RetNIRc], T2.[EntCaRet], T1.[RetEntGruT] AS RetEntGruT, T1.[RetNroI], "
                  cmdbuf = cmdbuf + "  T1.[RetAnt], T2.[EntIBRet], T2.[EntSURet], T2.[EntRetGan], T1.[RetEst], T1.[RetTot], "
                  cmdbuf = cmdbuf + "  T1.[RetFch], T2.[EntRaz] AS RetEntRaz, T1.[RetEntCod] AS RetEntCod, T1.[RetNro], "
                  cmdbuf = cmdbuf + "  T1.[RetSer], T1.[RetTip] FROM ([RETEN] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[RetEntGruT] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[RetEntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[RetNro] >= ?) AND (T1.[RetNro] "
                  cmdbuf = cmdbuf + "  <= ? or ? = 0) AND (T1.[RetEntCod] = ? or ? = 0) AND (T1.[RetTip] = ? or ? = 'ALL') "
                  cmdbuf = cmdbuf + "  AND (T1.[RetEntGruT] = 'PR') AND (T1.[RetFch] >= ?) AND (T1.[RetFch] <= ? or (? "
                  cmdbuf = cmdbuf + "  = convert( DATETIME, '17530101', 112 ))) ORDER BY T1.[EmpCod], T1.[RetNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01313,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01313,14)
                  THISFORM.GX_DB_BindColsW01313_01 ()
                  THISFORM.GX_DB_BindParmW01313_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01313,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV14Desnro = THISFORM.AV14Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01313,2,@AuxAV14Desnro,0)
               THISFORM.AV14Desnro = AuxAV14Desnro
               AuxAV26Hasnro = THISFORM.AV26Hasnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01313,3,@AuxAV26Hasnro,0)
               THISFORM.AV26Hasnro = AuxAV26Hasnro
               AuxAV26Hasnro = THISFORM.AV26Hasnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01313,4,@AuxAV26Hasnro,0)
               THISFORM.AV26Hasnro = AuxAV26Hasnro
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01313,5,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01313,6,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV21Tipo = THISFORM.AV21Tipo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01313,7,AuxAV21Tipo,6,0)
               THISFORM.AV21Tipo = AuxAV21Tipo
               AuxAV21Tipo = THISFORM.AV21Tipo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01313,8,AuxAV21Tipo,6,0)
               THISFORM.AV21Tipo = AuxAV21Tipo
               AuxAV23Desfch = THISFORM.AV23Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01313,9,@AuxAV23Desfch,0)
               THISFORM.AV23Desfch = AuxAV23Desfch
               AuxAV27Hasfch = THISFORM.AV27Hasfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01313,10,@AuxAV27Hasfch,0)
               THISFORM.AV27Hasfch = AuxAV27Hasfch
               AuxAV27Hasfch = THISFORM.AV27Hasfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01313,11,@AuxAV27Hasfch,0)
               THISFORM.AV27Hasfch = AuxAV27Hasfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01313) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01313 = Gx_err
               THISFORM.GX_DB_GetW01313_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV31Pgmnam = "WRGaVer"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01313 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01313) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01313 = Gx_err
                  THISFORM.GX_DB_GetW01313_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01313 <> 101
               BRKV3N2 = .F.
               THISFORM.AV25Imprim = 0
               THISFORM.A2EmpCod = THISFORM.Buf_W01313_2EmpCod
               THISFORM.A948RetNIR = THISFORM.Buf_W01313_948RetNIRc
               THISFORM.A3033EntCa = THISFORM.Buf_W01313_3033EntCaRet
               THISFORM.A941RetEnt = THISFORM.Buf_W01313_941RetEntGruT
               THISFORM.A937RetNro = THISFORM.Buf_W01313_937RetNroI
               THISFORM.A959RetAnt = THISFORM.Buf_W01313_959RetAnt
               THISFORM.A1432EntIB = THISFORM.Buf_W01313_1432EntIBRet
               THISFORM.A1459EntSU = THISFORM.Buf_W01313_1459EntSURet
               THISFORM.A842EntRet = THISFORM.Buf_W01313_842EntRetGan
               THISFORM.A940RetEst = THISFORM.Buf_W01313_940RetEst
               THISFORM.A958RetTot = THISFORM.Buf_W01313_958RetTot
               THISFORM.A938RetFch = THISFORM.Buf_W01313_938RetFch
               THISFORM.A943RetEnt = THISFORM.Buf_W01313_943RetEntRaz
               THISFORM.A942RetEnt = THISFORM.Buf_W01313_942RetEntCod
               THISFORM.A947RetNro = THISFORM.Buf_W01313_947RetNro
               THISFORM.A945RetSer = THISFORM.Buf_W01313_945RetSer
               THISFORM.A944RetTip = THISFORM.Buf_W01313_944RetTip
               THISFORM.A3033EntCa = THISFORM.Buf_W01313_3033EntCaRet
               THISFORM.A1432EntIB = THISFORM.Buf_W01313_1432EntIBRet
               THISFORM.A1459EntSU = THISFORM.Buf_W01313_1459EntSURet
               THISFORM.A842EntRet = THISFORM.Buf_W01313_842EntRetGan
               THISFORM.A943RetEnt = THISFORM.Buf_W01313_943RetEntRaz
               GX_SFLOAD = 0
               THISFORM.U19V3N2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01313) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01313 = Gx_err
               THISFORM.GX_DB_GetW01313_01 ()
            ENDDO
         ENDIF
      ENDPROC
