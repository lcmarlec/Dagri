                  cmdbuf = cmdbuf + "  T2.[ImpNim] AS EntImpNim, T2.[ImpDsc] AS EntImpDsc, T1.[EntImpCod] AS EntImpCod, "
                  cmdbuf = cmdbuf + "  T3.[EntLocDsc], T3.[EntRetGan], T3.[EntGCo], T3.[EntCIvCod] AS EntCIvCod, T4.[CIvDsc] "
