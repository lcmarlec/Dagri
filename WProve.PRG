                  cmdbuf = cmdbuf + "  T3.[EntFax], T3.[EntTel], T7.[GruDsc] AS EntGruDsc, T3.[EntGruCod] AS EntGruCod, "
                  cmdbuf = cmdbuf + "  T3.[EntCont], T3.[EntFan], T3.[EntRaz] FROM (((((([PROVES1] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [IMPUES] T2 (NOLOCK) ON T2.[ImpCod] = T1.[EntImpCod]) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[EntGruTip] AND "
                  cmdbuf = cmdbuf + "  T3.[EntCod] = T1.[EntCod]) LEFT JOIN [CATIVA] T4 (NOLOCK) ON T4.[CIvCod] = T3.[EntCIvCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [Pcias] T5 (NOLOCK) ON T5.[PaiCod] = T3.[EntPaiCod] AND T5.[PciCod] = "
                  cmdbuf = cmdbuf + "  T3.[EntPciCod]) LEFT JOIN [paises] T6 (NOLOCK) ON T6.[paicod] = T3.[EntPaiCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [GRUPO] T7 (NOLOCK) ON T7.[EmpCod] = T1.[EmpCod] AND T7.[GruTip] = T1.[EntGruTip] "
                  cmdbuf = cmdbuf + "  AND T7.[GruCod] = T3.[EntGruCod]) WHERE T1.[EmpCod] = ? and T1.[EntGruTip] = ? and "
                  cmdbuf = cmdbuf + "  T1.[EntCod] = ? ORDER BY T1.[EmpCod], T1.[EntGruTip], T1.[EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01282,cmdbuf)
