               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011714,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1154LInsN = THISFORM.A1154LInsN
               Gx_err = GX_DB_SetDouble( HStmt_T011714,2,@AuxA1154LInsN,0)
