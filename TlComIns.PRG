                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLCOMINS","T011714","",GX_CURSOR_TYPE_READONLY,@HStmt_T011714) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [LInsNI], [LInsGruCod], [LInsEntCod], [LinsEntRaz], [LInsDM01], "
                  cmdbuf = cmdbuf + "  [LInsDM02], [LInsDM03], [LInsDM04], [LInsDM05], [LInsDM06], [LInsDM07], [LInsDM08], "
                  cmdbuf = cmdbuf + "  [LInsDM09], [LInsDM10], [LInsDM11], [LInsDM12] FROM [LCOMINS1] (NOLOCK) WHERE [EmpCod] "
                  cmdbuf = cmdbuf + "  = ? AND [LInsNI] = ? AND [LInsGruCod] = ? ORDER BY [EmpCod], [LInsNI], [LInsGruCod], "
                  cmdbuf = cmdbuf + "  [LInsEntCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011714,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011714,9)
