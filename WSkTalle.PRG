      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12922" , @HStmt_W12922 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKTALLE","W12922","",GX_CURSOR_TYPE_READONLY,@HStmt_W12922) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ArtTalle], T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  FROM ([ROPA] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ArtCod] = T1.[ArtCod]) WHERE T1.[EmpCod] = ? and T1.[FamCod] = ? and T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[ArtCod] = ? ORDER BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[ArtTalle]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12922,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12922,14)
                  THISFORM.GX_DB_BindColsW12922_01 ()
                  THISFORM.GX_DB_BindParmW12922_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12922,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Famcod = THISFORM.AV21Famcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12922,2,@AuxAV21Famcod,0)
               THISFORM.AV21Famcod = AuxAV21Famcod
               AuxAV22Famsub = THISFORM.AV22Famsub
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12922,3,@AuxAV22Famsub,0)
               THISFORM.AV22Famsub = AuxAV22Famsub
               AuxAV23Artcod = THISFORM.AV23Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12922,4,@AuxAV23Artcod,0)
               THISFORM.AV23Artcod = AuxAV23Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12922) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12922 = Gx_err
               THISFORM.GX_DB_GetW12922_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WSkTalle"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12922 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12922) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12922 = Gx_err
                  THISFORM.GX_DB_GetW12922_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12922 <> 101
               BRKVZW2 = .F.
               THISFORM.A3801ArtTa = THISFORM.Buf_W12922_3801ArtTalle
               THISFORM.A6ArtDsc = THISFORM.Buf_W12922_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W12922_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W12922_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W12922_3FamCod
               THISFORM.A2EmpCod = THISFORM.Buf_W12922_2EmpCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W12922_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U15VZW2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12922) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12922 = Gx_err
               THISFORM.GX_DB_GetW12922_01 ()
            ENDDO
         ENDIF
      ENDPROC
