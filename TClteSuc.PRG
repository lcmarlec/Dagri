      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. GX_1Lvl_mode = PGx_mode
         THISFORM. Gx_mode = PGx_mode
         THISFORM. AV20Entlgc = PAV20Entlgc
         THISFORM. AV8Emprcod = PAV8Emprcod
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV17Usuari = PAV17Usuari
         THISFORM. A2EmpCod = PA2EmpCod
         THISFORM. A150EntGru = PA150EntGru
         THISFORM. A120EntCod = PA120EntCod
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01782" , @HStmt_T01782 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESUC","T01782","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01782) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntLgCod], [EntLgIBTuc], [EntLgPaiCo] AS "
            cmdbuf = cmdbuf + "  EntLgPaiCo, [EntLgPciCo] AS EntLgPciCo, [Entlgloc], [EntLgPos], [EntLgMunCo] AS "
            cmdbuf = cmdbuf + "  EntLgMunCo, [EntLgFVt], [EntLgCIvCo] AS EntLgCIvCo, [EntLgIBRet], [EntLgDsc], [EntLgDom], "
            cmdbuf = cmdbuf + "  [EntLgDNro], [EntLgCont], [EntLgTel], [EntLgVdrCo] AS EntLgVdrCo, [EntLgOrden], "
            cmdbuf = cmdbuf + "  [EntLgGrpOf], [EntLgInhab], [entLgInhMo], [EntLgEan], [EntlgObs], [EntLgMisEx], "
            cmdbuf = cmdbuf + "  [EntLgMEV], [EntLgVtMin] FROM [CLTES] (UPDLOCK) WHERE [EmpCod] = ? AND [EntGruTip] "
            cmdbuf = cmdbuf + "  = ? AND [EntCod] = ? AND [EntLgCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01782,cmdbuf)
            THISFORM.GX_DB_BindColsT01782_01 ()
            THISFORM.GX_DB_BindParmT01782_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01783" , @HStmt_T01783 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESUC","T01783","",GX_CURSOR_TYPE_READONLY,@HStmt_T01783) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntLgCod], [EntLgIBTuc], [EntLgPaiCo] AS "
            cmdbuf = cmdbuf + "  EntLgPaiCo, [EntLgPciCo] AS EntLgPciCo, [Entlgloc], [EntLgPos], [EntLgMunCo] AS "
            cmdbuf = cmdbuf + "  EntLgMunCo, [EntLgFVt], [EntLgCIvCo] AS EntLgCIvCo, [EntLgIBRet], [EntLgDsc], [EntLgDom], "
            cmdbuf = cmdbuf + "  [EntLgDNro], [EntLgCont], [EntLgTel], [EntLgVdrCo] AS EntLgVdrCo, [EntLgOrden], "
            cmdbuf = cmdbuf + "  [EntLgGrpOf], [EntLgInhab], [entLgInhMo], [EntLgEan], [EntlgObs], [EntLgMisEx], "
            cmdbuf = cmdbuf + "  [EntLgMEV], [EntLgVtMin] FROM [CLTES] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] "
            cmdbuf = cmdbuf + "  = ? AND [EntCod] = ? AND [EntLgCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01783,cmdbuf)
            THISFORM.GX_DB_BindColsT01783_01 ()
            THISFORM.GX_DB_BindParmT01783_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01784" , @HStmt_T01784 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESUC","T01784","",GX_CURSOR_TYPE_READONLY,@HStmt_T01784) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EntRaz], [EntPos], [EntPaiCod], [EntPciCod], [EntLocDsc], [EntMunCod], [EntFVt], "
            cmdbuf = cmdbuf + "  [EntCIvCod], [EntIBRet] FROM [ENTID] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] "
            cmdbuf = cmdbuf + "  = ? AND [EntCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01784,cmdbuf)
            THISFORM.GX_DB_BindColsT01784_01 ()
            THISFORM.GX_DB_BindParmT01784_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01785" , @HStmt_T01785 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESUC","T01785","",GX_CURSOR_TYPE_READONLY,@HStmt_T01785) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [VdrNom] AS EntLgVdrNo FROM [VEND] (NOLOCK) WHERE [EmpCod] = ? AND [VdrCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01785,cmdbuf)
            THISFORM.GX_DB_BindColsT01785_01 ()
