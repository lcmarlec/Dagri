      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV14Numero = str( THISFORM.A2658CUIT , 11 ) + str( THISFORM.A2983perio , 6 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV15Emprco
            Aux3 = THISFORM.AV14Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV13Audobs
            Aux6 = THISFORM.AV11Usuari
            DO PAuditor WITH "LAP" , Aux1 , "CUIT" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV15Emprco = Aux1
            THISFORM.AV14Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV13Audobs = Aux5
            THISFORM.AV11Usuari = Aux6
