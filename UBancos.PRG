            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "VAV12Objet"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV8Titulo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW10S5 = GETE('z:\temp') + '\' + SCW10S5
            ENDIF
            CREATE DBF (SCW10S5) FROM ARRAY GX_STRUCT
            USE
            USE (SCW10S5) EXCLUSIVE ALIAS SCW10S5
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW10S5
         THIS.GX_SfAlias = "SCW10S5"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U15V0A2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
      PROCEDURE LoadFromTbl
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV12Objet WITH THISFORM.AV12Objeto
         REPLACE VAV8Titulo WITH THISFORM.AV8Titulo
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV12Objeto = VAV12Objet
         THISFORM.AV8Titulo = VAV8Titulo
      ENDPROC
      PROCEDURE LoadVarFromCtrl
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV12Objeto = SPACE(10)
         THISFORM.AV8Titulo = SPACE(40)
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
      PROCEDURE BeforeRowChange
      ENDPROC
      PROCEDURE AfterRowChange
      ENDPROC
      PROCEDURE DblClick
         THISFORM.U14V0A2 ()
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE Click
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE CallRefreshEvent
         THISFORM.cCW10S5.GXRefreshEvt ()
      ENDPROC
      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW10S5 .GX_SfAlias)
            GO TOP
            THISFORM.cCW10S5 .Refresh()
         ENDIF
         THISFORM. cCW10S5 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW10S5 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
