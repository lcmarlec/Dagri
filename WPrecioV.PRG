      Alignment = 0
      HelpContextId = 262670
      GX_CUPOS = 0
      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.AV13Fchdde
         CGXTextBox ::Init
         THIS.GX_OldValue = THISFORM.AV13Fchdde
         THIS.GX_Level = 2
      ENDPROC
      PROCEDURE GotFocus
         CGXTextBox ::GotFocus
         THIS.GXGotFocus()
         IF THISFORM.GX_NewLastVld > - 1
            THISFORM.GX_lastvld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         SET TOPIC TO Fchdde
         THISFORM.Gx_cursor = "THISFORM.AV13Fchdde"
         THISFORM.SetFKeys()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
