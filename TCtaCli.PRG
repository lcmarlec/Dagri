                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCTACLI","T01458","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01458) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CTACLI]  WHERE [EmpCod] = ? AND [CtaCliCod] = ? "
