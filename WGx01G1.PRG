      PROCEDURE CreateTemp
         LOCAL SCW234S20
         SCW234S20 = ""
         IF USED( "SCW234S20" )
            SELECT SCW234S20
            SCW234S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW234S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA561TraCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA562TraCu"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 11
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2252TraV"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA2263CEmC"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2286TraD"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2288TraS"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW234S20 = GETE('z:\temp') + '\' + SCW234S20
            ENDIF
            CREATE DBF (SCW234S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW234S20) EXCLUSIVE ALIAS SCW234S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW234S20
         THIS.GX_SfAlias = "SCW234S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02342" , @HStmt_W02342 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01G1","W02342","",GX_CURSOR_TYPE_READONLY,@HStmt_W02342) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TraDir], [TraNom], [TraObs], [TraTel], [TraSex], [TraDNI], [CEmCod], "
                  cmdbuf = cmdbuf + "  [TraVal], [TraCui], [TraCod] FROM [EMPLEADO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [TraCod] >= ?) AND ([TraCui] >= ?) AND ([TraDir] like ?) AND ([TraNom] like "
                  cmdbuf = cmdbuf + "  ?) AND ([TraObs] like ?) AND ([TraTel] like ?) ORDER BY [EmpCod], [TraCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02342,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02342,9)
                  THISFORM.GX_DB_BindColsW02342_01 ()
                  THISFORM.GX_DB_BindParmW02342_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02342,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C561 = THISFORM.AV5C561
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02342,2,@AuxAV5C561,0)
               THISFORM.AV5C561 = AuxAV5C561
               AuxAV6C562 = THISFORM.AV6C562
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02342,3,@AuxAV6C562,0)
               THISFORM.AV6C562 = AuxAV6C562
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02342,4,PADR( TRIM(THISFORM.AV7C563),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C563),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02342,5,PADR( TRIM(THISFORM.AV8C564),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C564),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02342,6,PADR( TRIM(THISFORM.AV9C565),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C565),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02342,7,PADR( TRIM(THISFORM.AV10C566),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C566),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02342 = Gx_err
               THISFORM.GX_DB_GetW02342_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02342 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02342) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02342 = Gx_err
                  THISFORM.GX_DB_GetW02342_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02342 <> 101
               BRKV6I2 = .F.
               THISFORM.A563TraDir = THISFORM.Buf_W02342_563TraDir
               THISFORM.A564TraNom = THISFORM.Buf_W02342_564TraNom
               THISFORM.A565TraObs = THISFORM.Buf_W02342_565TraObs
               THISFORM.A566TraTel = THISFORM.Buf_W02342_566TraTel
               THISFORM.A2288TraSe = THISFORM.Buf_W02342_2288TraSex
               THISFORM.A2286TraDN = THISFORM.Buf_W02342_2286TraDNI
               THISFORM.A2263CEmCo = THISFORM.Buf_W02342_2263CEmCod
               THISFORM.A2252TraVa = THISFORM.Buf_W02342_2252TraVal
               THISFORM.A562TraCui = THISFORM.Buf_W02342_562TraCui
               THISFORM.A561TraCod = THISFORM.Buf_W02342_561TraCod
               GX_SFLOAD = 0
               THISFORM.U12V6I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02342 = Gx_err
               THISFORM.GX_DB_GetW02342_01 ()
            ENDDO
         ENDIF
      ENDPROC
