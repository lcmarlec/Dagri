                           Gx_err = GX_DB_Set_StmtCmdText( HStmt_P03548,cmdbuf)
                           GX_DB_BindParmP03548_01 ()
                        ENDIF
                        Gx_err = GX_DB_SetInt( HStmt_P03548,1,@R1516LlaEs,0)
                        Gx_err = GX_DB_SetInt( HStmt_P03548,2,@R2EmpCod,0)
                        Gx_err = GX_DB_SetDouble( HStmt_P03548,3,@R1525LlaNr,0)
                        Gx_eop = 1
                        DO WHILE Gx_eop != 0
                           Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P03548) ,  ,  ,  , CS_SQLSRV ,  )
                        ENDDO
                        P03548 = Gx_err
                        Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P03548) ,  ,  ,  , CS_SQLSRV ,  )
                        * Check if program is canceled.
                        DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
                        IF UserCancel
                           EXIT
                        ENDIF
                        * Exiting from a For First loop.
                        EXIT
                        IF UserCancel
                           EXIT
                        ENDIF
                     ENDDO
                     Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P03547) ,  ,  ,  , CS_SQLSRV ,  )
                     LEVEL5 = .F.
                  ELSE
                     IF TYPE( "HConn_Default" ) = "N"
                        IF GXCONNECTED
                           Gx_Err = Gx_odbc_mrc( GX_DB_ConnRollback(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
                        ENDIF
                     ENDIF
                  ENDIF
            ENDCASE
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
               ENDIF
            ENDIF
            IF AV23Tipo = "F"
               DO RLlamImp WITH AV10Emprco , RV17Llanro , "PRN" , 1
            ELSE
               DO RLlaCImp WITH AV10Emprco , RV17Llanro , "PRN" , 1
            ENDIF
         ENDIF
   ENDCASE
   DO EP9U0
   RETURN
   GX_retp = 0
* End Program

