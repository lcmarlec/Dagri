      PROCEDURE CreateTemp
         LOCAL SCW1164S20
         SCW1164S20 = ""
         IF USED( "SCW1164S20" )
            SELECT SCW1164S20
            SCW1164S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1164S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA3378PPTe"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 16
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3379PPTe"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3380PPTe"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3381PPTe"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3382PPTe"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1164S20 = GETE('z:\temp') + '\' + SCW1164S20
            ENDIF
            CREATE DBF (SCW1164S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1164S20) EXCLUSIVE ALIAS SCW1164S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1164S20
         THIS.GX_SfAlias = "SCW1164S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11642" , @HStmt_W11642 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0AQ4","W11642","",GX_CURSOR_TYPE_READONLY,@HStmt_W11642) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PPFch], [PPVer], [PPID], [PPTerCie], [PPTerTurno], [PPTerUsu], "
                  cmdbuf = cmdbuf + "  [PPTerCnt], [PPTerFH] FROM [PARPROD2] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? "
                  cmdbuf = cmdbuf + "  and [PPFch] = ? and [PPVer] = ? and [PPID] = ? and [PPTerFH] >= ?) AND ([PPTerCnt] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PPTerUsu] like ?) ORDER BY [EmpCod], [PPFch], [PPVer], [PPID], [PPTerFH] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11642,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11642,9)
                  THISFORM.GX_DB_BindColsW11642_01 ()
                  THISFORM.GX_DB_BindParmW11642_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11642,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3365PPFch = THISFORM.A3365PPFch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11642,2,@AuxA3365PPFch,0)
               THISFORM.A3365PPFch = AuxA3365PPFch
               AuxA3366PPVer = THISFORM.A3366PPVer
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11642,3,@AuxA3366PPVer,0)
               THISFORM.A3366PPVer = AuxA3366PPVer
               AuxA3369PPID = THISFORM.A3369PPID
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11642,4,@AuxA3369PPID,0)
               THISFORM.A3369PPID = AuxA3369PPID
               AuxAV5C3378 = THISFORM.AV5C3378
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W11642,5,@AuxAV5C3378,0)
               THISFORM.AV5C3378 = AuxAV5C3378
               AuxAV6C3379 = THISFORM.AV6C3379
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11642,6,@AuxAV6C3379,0)
               THISFORM.AV6C3379 = AuxAV6C3379
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11642,7,PADR( TRIM(THISFORM.AV7C3380),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C3380),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11642 = Gx_err
               THISFORM.GX_DB_GetW11642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11642 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11642) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11642 = Gx_err
                  THISFORM.GX_DB_GetW11642_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11642 <> 101
               BRKVWC2 = .F.
               THISFORM.A3382PPTer = THISFORM.Buf_W11642_3382PPTerCie
               THISFORM.A3381PPTer = THISFORM.Buf_W11642_3381PPTerTurno
               THISFORM.A3380PPTer = THISFORM.Buf_W11642_3380PPTerUsu
               THISFORM.A3379PPTer = THISFORM.Buf_W11642_3379PPTerCnt
               THISFORM.A3378PPTer = THISFORM.Buf_W11642_3378PPTerFH
               GX_SFLOAD = 0
               THISFORM.U12VWC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11642 = Gx_err
               THISFORM.GX_DB_GetW11642_01 ()
            ENDDO
         ENDIF
      ENDPROC
