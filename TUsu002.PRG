      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA64UsuCod = THISFORM.A64UsuCod
            Gx_err = GX_DB_SetStr( HStmt_T01072,1,AuxA64UsuCod,10,0)
            THISFORM.A64UsuCod = AuxA64UsuCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01072) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01072 = Gx_err
            THISFORM.GX_DB_GetT01072_01 ()
            IF .NOT. THISFORM.T01072 <> 103
               DO GX_ERRMW WITH "USU002 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01072 = 101 .OR. THISFORM.Z65UsuNomb <> THISFORM.Buf_T01072_65UsuNombre
               DO GX_ERRMW WITH "USU002 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01075" , @HStmt_T01075 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TUSU002","T01075","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01075) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [USU002] ([UsuCod], [UsuNombre], [UsuPass], [UsuVdrCod], [UsuActivo], "
                  cmdbuf = cmdbuf + "  [UsuLLe], [UsuLegajo]) VALUES (?, ?, ?, convert(int, 0), convert(int, 0), convert(int, "
                  cmdbuf = cmdbuf + "  0), convert(int, 0)) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01075,cmdbuf)
                  THISFORM.GX_DB_BindParmT01075_01 ()
               ENDIF
               AuxA64UsuCod = THISFORM.A64UsuCod
               Gx_err = GX_DB_SetStr( HStmt_T01075,1,AuxA64UsuCod,10,0)
               THISFORM.A64UsuCod = AuxA64UsuCod
               AuxA65UsuNomb = THISFORM.A65UsuNomb
               Gx_err = GX_DB_SetStr( HStmt_T01075,2,AuxA65UsuNomb,30,0)
               THISFORM.A65UsuNomb = AuxA65UsuNomb
               AuxA1036UsuPa = THISFORM.A1036UsuPa
               Gx_err = GX_DB_SetStr( HStmt_T01075,3,AuxA1036UsuPa,10,0)
               THISFORM.A1036UsuPa = AuxA1036UsuPa
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01075) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01075 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01075) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T01075 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01076" , @HStmt_T01076 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TUSU002","T01076","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01076) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [USU002] SET [UsuNombre]=?, [UsuPass]=?  WHERE [UsuCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01076,cmdbuf)
                  THISFORM.GX_DB_BindParmT01076_01 ()
               ENDIF
               AuxA65UsuNomb = THISFORM.A65UsuNomb
               Gx_err = GX_DB_SetStr( HStmt_T01076,1,AuxA65UsuNomb,30,0)
               THISFORM.A65UsuNomb = AuxA65UsuNomb
               AuxA1036UsuPa = THISFORM.A1036UsuPa
               Gx_err = GX_DB_SetStr( HStmt_T01076,2,AuxA1036UsuPa,10,0)
               THISFORM.A1036UsuPa = AuxA1036UsuPa
               AuxA64UsuCod = THISFORM.A64UsuCod
               Gx_err = GX_DB_SetStr( HStmt_T01076,3,AuxA64UsuCod,10,0)
               THISFORM.A64UsuCod = AuxA64UsuCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01076) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01076 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01076) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01077" , @HStmt_T01077 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TUSU002","T01077","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01077) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [USU002]  WHERE [UsuCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01077,cmdbuf)
                  THISFORM.GX_DB_BindParmT01077_01 ()
               ENDIF
               AuxA64UsuCod = THISFORM.A64UsuCod
               Gx_err = GX_DB_SetStr( HStmt_T01077,1,AuxA64UsuCod,10,0)
               THISFORM.A64UsuCod = AuxA64UsuCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01077) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01077 = Gx_err
               THISFORM.T01072 = iif( THISFORM.T01077 = 0 , 104 , THISFORM.T01077 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01077) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
