      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV32Numero = THISFORM.A64UsuCod
         ENDIF
         IF .T.
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV15Passn
            Aux2 = THISFORM.A1036UsuPa
            DO PAut002 WITH Aux0 , "E" , Aux2
            THISFORM.AV15Passn = Aux0
            THISFORM.A1036UsuPa = Aux2
            THISFORM. cCT107V15 .Refresh()
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV21Emprco
            Aux3 = THISFORM.AV32Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV31Audobs
            Aux6 = THISFORM.AV30Usuari
            DO PAuditor WITH "SEGU" , Aux1 , "USUA" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV21Emprco = Aux1
            THISFORM.AV32Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV31Audobs = Aux5
            THISFORM.AV30Usuari = Aux6
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
