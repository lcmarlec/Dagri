                  THISFORM. cCT197A1923 . ZM5H224 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC5H224 ()
               THISFORM. cCT197A1923 . ZM5H224 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC5H224 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT197A1924 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE5H224 ()
