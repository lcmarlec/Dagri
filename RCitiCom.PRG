      IF substr( R348DcCTip , 1 , 3 ) = "NCP"
         RV11Linea = RV11Linea + ALLTRIM( RV12Aux ) + str( R576EmpCui , 11 ) + substr( R68EmpNom , 1 , 25 )
      ELSE
         RV11Linea = RV11Linea + ALLTRIM( RV12Aux ) + str( R166EntCui , 11 ) + substr( R153EntRaz , 1 , 25 )
      ENDIF
      RV13Iva = 0
      LEVEL3 = .T.
      * Optimized group.
      DO GX_CSC01
      IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R01903" , @HStmt_R01903 )
         Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RCITICOM","R01903","",GX_CURSOR_TYPE_READONLY,@HStmt_R01903) ,  ,  ,  , CS_SQLSRV ,  )
         cmdbuf = " SELECT SUM([DcCImpCnt]) FROM [DCCOM3] (NOLOCK) WHERE ([EmpCod] = ? and [DcCNroInt] "
         cmdbuf = cmdbuf + "  = ?) AND (SUBSTRING([DcCImpCod], 1, 4) = ' IVA')  "
         Gx_err = GX_DB_Set_StmtCmdText( HStmt_R01903,cmdbuf)
         GX_DB_BindColsR01903_01 ()
         GX_DB_BindParmR01903_01 ()
