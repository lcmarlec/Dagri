      Gx_err = GX_DB_SetInt( HStmt_R01903,1,@R2EmpCod,0)
      Gx_err = GX_DB_SetDouble( HStmt_R01903,2,@R346DcCNro,0)
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R01903) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R01903 = Gx_err
      GX_DB_GetR01903_01 ()
      c369DcCImp = Buf_R01903_369DcCImpCnt
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R01903) ,  ,  ,  , CS_SQLSRV ,  )
      RV13Iva = RV13Iva + c369DcCImp
      * End optimized group.
      LEVEL3 = .F.
      IF RV13Iva > 0
         RV13Iva = RV13Iva * 100
         DO RStrZero WITH RV13Iva , 12 , 0 , RV12Aux
         Gxlinea = RV11Linea + ALLTRIM( RV12Aux ) + "00000000000" + space( 25 ) + "000000000000" + "0D0A"
         * User Code
         fputs(gxArch, gxlinea)
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R01902) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R01902 = Gx_err
      GX_DB_GetR01902_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R01902) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
