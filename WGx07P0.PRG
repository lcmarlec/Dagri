         ENDIF
         gxO_Area = SELECT()
         SELECT (THISFORM. cCW810S16 .GX_SfAlias)
         REPLACE sA2487blkT WITH THISFORM.A2487blkTi
         SELECT (gxO_Area)
         THIS.Refresh()
      ENDPROC
