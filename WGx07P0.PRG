      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08102" , @HStmt_W08102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07P0","W08102","",GX_CURSOR_TYPE_READONLY,@HStmt_W08102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [blkfch], [blkTip], [CAuCod], [TraCod], [EmpCod] FROM [BLOQAUSE] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ? and [TraCod] >= ?) AND ([CAuCod] like ?) AND ([blkTip] "
                  cmdbuf = cmdbuf + "  like ?) AND ([blkfch] >= ?) ORDER BY [EmpCod], [TraCod], [CAuCod], [blkTip]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08102,9)
                  THISFORM.GX_DB_BindColsW08102_01 ()
                  THISFORM.GX_DB_BindParmW08102_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08102,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C561 = THISFORM.AV6C561
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08102,2,@AuxAV6C561,0)
               THISFORM.AV6C561 = AuxAV6C561
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08102,3,PADR( TRIM(THISFORM.AV7C2266),4, '%'),LEN(PADR( TRIM(THISFORM.AV7C2266),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08102,4,PADR( TRIM(THISFORM.AV8C2487),1, '%'),LEN(PADR( TRIM(THISFORM.AV8C2487),1, '%')),0)
               AuxAV9C2488 = THISFORM.AV9C2488
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08102,5,@AuxAV9C2488,0)
               THISFORM.AV9C2488 = AuxAV9C2488
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08102 = Gx_err
               THISFORM.GX_DB_GetW08102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08102 = Gx_err
                  THISFORM.GX_DB_GetW08102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08102 <> 101
               BRKVMI2 = .F.
               THISFORM.A2488blkfc = THISFORM.Buf_W08102_2488blkfch
               THISFORM.A2487blkTi = THISFORM.Buf_W08102_2487blkTip
               THISFORM.A2266CAuCo = THISFORM.Buf_W08102_2266CAuCod
               THISFORM.A561TraCod = THISFORM.Buf_W08102_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W08102_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VMI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08102 = Gx_err
               THISFORM.GX_DB_GetW08102_01 ()
            ENDDO
         ENDIF
      ENDPROC
