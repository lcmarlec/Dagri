            GX_STRUCT[ 4 ,1]= "sA2487blkT"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW810S16 = GETE('z:\temp') + '\' + SCW810S16
            ENDIF
            CREATE DBF (SCW810S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW810S16) EXCLUSIVE ALIAS SCW810S16
         ENDIF
