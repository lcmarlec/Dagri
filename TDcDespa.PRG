      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02432,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA3022DceNI = THISFORM.A3022DceNI
            Gx_err = GX_DB_SetDouble( HStmt_T02432,2,@AuxA3022DceNI,0)
            THISFORM.A3022DceNI = AuxA3022DceNI
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02432) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02432 = Gx_err
            THISFORM.GX_DB_GetT02432_01 ()
            IF .NOT. THISFORM.T02432 <> 103
               DO GX_ERRMW WITH "DCDESPA1 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02432 = 101 .OR. THISFORM.Z2365DcEGr <> THISFORM.Buf_T02432_2365DcEGruTip
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2351DcENr <> THISFORM.Buf_T02432_2351DcENroTip
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2356DcEDe <> THISFORM.Buf_T02432_2356DcEDesCod
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2386DceTo <> THISFORM.Buf_T02432_2386DceTotImp
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2565DceSe <> THISFORM.Buf_T02432_2565DceSeguro
               DO GX_ERRMW WITH "DCDESPA1 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

