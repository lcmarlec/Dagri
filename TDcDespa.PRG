      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV23Dceni = THISFORM.A3022DceNI
         ENDIF
         IF .T.
            THISFORM.AV16Numero = str( THISFORM.A2349DcENr , 2 ) + THISFORM.A2350DcENr + THISFORM.A2351DcENr + str( THISFORM.A2352DcENr , 6 ) + THISFORM.A2353DcENr
         ENDIF
         IF .T. .AND. THISFORM.A2384DceDc = 0
            DO GX_ERRMW WITH "Debe Seleccionar Factura del Vendedor"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF .T. .AND. THISFORM.A2384DceDc <> 0
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV10Emprco
            Aux3 = THISFORM.AV16Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV17Audobs
            Aux6 = THISFORM.AV9Usuario
            DO PAuditor WITH "COMP" , Aux1 , "EMBD" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV10Emprco = Aux1
            THISFORM.AV16Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV17Audobs = Aux5
            THISFORM.AV9Usuario = Aux6
            THISFORM. cCT243V9 .Refresh()
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated) .AND. THISFORM.A2384DceDc <> 0
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV10Emprco
            Aux1 = THISFORM.A3022DceNI
            Aux2 = THISFORM.A2384DceDc
            DO PActFcDs WITH Aux0 , Aux1 , Aux2
            THISFORM.AV10Emprco = Aux0
            THISFORM.A3022DceNI = Aux1
            THISFORM.A2384DceDc = Aux2
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 349 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.U216R2 ()
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
