         THIS.GX_SfName = SCW1233S32
         THIS.GX_SfAlias = "SCW1233S32"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV52Caudsc = SPACE(50)
               THISFORM.AV51Caucod = SPACE(4)
               THISFORM.AV47Sel = 0
               THISFORM.AV74Aartnr = 0
               GX_SFLOAD = 0
               THISFORM.U19VY92 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
