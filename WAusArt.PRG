            IF '' <> GETE('z:\temp')
               SCW1233S32 = GETE('z:\temp') + '\' + SCW1233S32
            ENDIF
            CREATE DBF (SCW1233S32) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1233S32) EXCLUSIVE ALIAS SCW1233S32
         ENDIF
