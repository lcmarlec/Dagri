      PROCEDURE CreateTemp
         LOCAL SCW1233S32
         SCW1233S32 = ""
         IF USED( "SCW1233S32" )
            SELECT SCW1233S32
            SCW1233S32 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1233S32
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 12 , 4]

            GX_STRUCT[ 1 ,1]= "VAV52Cauds"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 50
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV37Ausfc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV36Ausfc"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV43Dias"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV35Traco"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 6
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV38Trano"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 40
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "VAV47Sel"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 1
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "VAV71Aartn"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 10
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "VAV72Aarte"
            GX_STRUCT[ 9 ,2]= "C"
            GX_STRUCT[ 9 ,3]= 240
            GX_STRUCT[ 9 ,4]= 0

            GX_STRUCT[ 10 ,1]= "VAV73Aartf"
            GX_STRUCT[ 10 ,2]= "D"
            GX_STRUCT[ 10 ,3]= 8
            GX_STRUCT[ 10 ,4]= 0

            GX_STRUCT[ 11 ,1]= "VAV51Cauco"
            GX_STRUCT[ 11 ,2]= "C"
            GX_STRUCT[ 11 ,3]= 4
            GX_STRUCT[ 11 ,4]= 0

            GX_STRUCT[ 12 ,1]= "VAV74Aartn"
