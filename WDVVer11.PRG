                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05712) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05712 = Gx_err
                  THISFORM.GX_DB_GetW05712_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05712 <> 101
               BRKVFV2 = .F.
               THISFORM.AV26Famcod = 0
               THISFORM.AV27Famsub = 0
               THISFORM.AV28Artcod = 0
               THISFORM.AV29Artdsc = SPACE(50)
               THISFORM.AV30Dcvcnt = 0.0000
               THISFORM.AV31Dcvprc = 0.0000
               THISFORM.AV22Totlin = 0.00
               THISFORM.AV35Oferta = SPACE(3)
               THISFORM.A416DcVEnt = THISFORM.Buf_W05712_416DcVEntGruT
               THISFORM.A419DcVEnt = THISFORM.Buf_W05712_419DcVEntLgCo
               THISFORM.A466DcVEst = THISFORM.Buf_W05712_466DcVEst
               THISFORM.A470DcVTot = THISFORM.Buf_W05712_470DcVTotSld
               THISFORM.A415DcVNro = THISFORM.Buf_W05712_415DcVNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W05712_2EmpCod
               THISFORM.A2817EntLg = THISFORM.Buf_W05712_2817EntLgDNro
               THISFORM.A1206EmpVt = THISFORM.Buf_W05712_1206EmpVtaCie
               THISFORM.A444DcVFat = THISFORM.Buf_W05712_444DcVFaturo
               THISFORM.A2496DCvOr = THISFORM.Buf_W05712_2496DCvOrd12
               THISFORM.A429DcVNro = THISFORM.Buf_W05712_429DcVNroaf
               THISFORM.A428DcVSuc = THISFORM.Buf_W05712_428DcVSucaf
               THISFORM.A427DcVSer = THISFORM.Buf_W05712_427DcVSeraf
               THISFORM.A426DcVTip = THISFORM.Buf_W05712_426DcVTipaf
               THISFORM.A421DcVFch = THISFORM.Buf_W05712_421DcVFch
               THISFORM.A418DcVEnt = THISFORM.Buf_W05712_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W05712_417DcVEntCod
               THISFORM.A463DcVNet = THISFORM.Buf_W05712_463DcVNet
               THISFORM.A464DcVTot = THISFORM.Buf_W05712_464DcVTot
               THISFORM.A425DcVNro = THISFORM.Buf_W05712_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W05712_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W05712_423DcVSer
               THISFORM.A422DcVTip = THISFORM.Buf_W05712_422DcVTip
               THISFORM.A1206EmpVt = THISFORM.Buf_W05712_1206EmpVtaCie
               THISFORM.A418DcVEnt = THISFORM.Buf_W05712_418DcVEntRaz
               THISFORM.A2817EntLg = THISFORM.Buf_W05712_2817EntLgDNro
               GX_SFLOAD = 0
               THISFORM.U19VFV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
      ENDPROC
