                  cmdbuf = " SELECT T1.[PedEst], T1.[PedNro], T1.[PedSec], T1.[PedGruTip] AS PedGruTip, T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[PedCarNroF], T1.[PedCarNro], T1.[PedCarFch], T1.[PedNroFac], T1.[PedSucFac], "
                  cmdbuf = cmdbuf + "  T1.[PedNroRto], T1.[PedSucRto], T2.[Entlgloc], T2.[EntLgDsc], T1.[PedSucCod] AS "
                  cmdbuf = cmdbuf + "  PedSucCod, T1.[PedEntCod] AS PedEntCod, T1.[PedFch] FROM ([PEDIDO1] T1 (NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CLTES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[PedGruTip] AND T2.[EntCod] = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[PedFch] >= ?) AND (T1.[PedEst] >= 1) AND (T1.[PedEst] "
                  cmdbuf = cmdbuf + "  < 9) AND (T1.[PedEntCod] = ? or ? = 0) AND (T1.[PedCarNro] = ?) AND (T1.[PedCarNroF] "
                  cmdbuf = cmdbuf + "  * 1 = 0) ORDER BY T1.[EmpCod], T1.[PedFch], T1.[PedGruTip], T1.[PedEntCod], T1.[PedSucCod], "
                  cmdbuf = cmdbuf + "  T1.[PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12672,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12672,15)
