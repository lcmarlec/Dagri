                  THISFORM.GX_DB_BindParmW12672_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12672,1,@AuxAV7Emprcod,0)
