               THISFORM.AV44Pgmnam = "WDesAgFi"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12672 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12672) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12672 = Gx_err
                  THISFORM.GX_DB_GetW12672_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12672 <> 101
               BRKVZ72 = .F.
               THISFORM.AV14Sel = 0
