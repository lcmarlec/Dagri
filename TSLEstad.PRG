            IF .NOT. THISFORM.T01304 <> 103
               DO GX_ERRMW WITH "SLESTADO reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01304 = 101 .OR. THISFORM.Z1293SLEEn <> THISFORM.Buf_T01304_1293SLEEntGruT
