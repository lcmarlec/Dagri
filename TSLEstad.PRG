      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T013014" , @HStmt_T013014 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSLESTAD","T013014","",GX_CURSOR_TYPE_READONLY,@HStmt_T013014) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [SLEEntCod], [SLENro], [SLEArtCod], [SLEArtDsc] FROM [SLESTAD1] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [SLEEntCod] = ? AND [SLENro] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [SLEEntCod], [SLENro], [SLEArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T013014,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T013014,12)
                  THISFORM.GX_DB_BindColsT013014_01 ()
                  THISFORM.GX_DB_BindParmT013014_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T013014,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1294SLEEn = THISFORM.A1294SLEEn
               Gx_err = GX_DB_SetLong( HStmt_T013014,2,@AuxA1294SLEEn,0)
               THISFORM.A1294SLEEn = AuxA1294SLEEn
               AuxA1295SLENr = THISFORM.A1295SLENr
               Gx_err = GX_DB_SetInt( HStmt_T013014,3,@AuxA1295SLENr,0)
               THISFORM.A1295SLENr = AuxA1295SLENr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T013014) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013014 = Gx_err
               THISFORM.GX_DB_GetT013014_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T013014 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013014) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T013014 = Gx_err
                  THISFORM.GX_DB_GetT013014_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T013014 <> 101
               BRK3M148 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT130S18.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T013014) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T013014 = Gx_err
               THISFORM.GX_DB_GetT013014_01 ()
            ENDDO
         ENDIF
      ENDPROC
