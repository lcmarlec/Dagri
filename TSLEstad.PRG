                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T013015,100)
                  THISFORM.GX_DB_BindColsT013015_01 ()
                  THISFORM.GX_DB_BindParmT013015_01 ()
               ENDIF
               AuxBuf_T01305_2EmpCod = THISFORM.Buf_T01305_2EmpCod
