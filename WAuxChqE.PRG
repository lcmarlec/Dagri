            SELECT ( THISFORM.cCW663S21 .GX_SfAlias)
            GO TOP
            THISFORM.cCW663S21 .Refresh()
         ENDIF
         THISFORM. cCW663S21 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW663S21 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
