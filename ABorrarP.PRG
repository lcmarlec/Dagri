      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_P08173) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   P08173 = Gx_err
   GX_DB_GetP08173_01 ()
   DO WHILE P08173 <> 101
      R2EmpCod = Buf_P08173_2EmpCod
      R795PedFch = Buf_P08173_795PedFch
      R797PedGru = Buf_P08173_797PedGruTip
      R798PedEnt = Buf_P08173_798PedEntCod
      R802PedSuc = Buf_P08173_802PedSucCod
      R809PedSec = Buf_P08173_809PedSec
      R826PedEst = Buf_P08173_826PedEst
      RV8Borrar = 0
      * Exit For each command. Update data (if necessary), close cursors & exit.
      EXIT
      * Check if program is canceled.
      IF gxPrnObj.GxIsAliveDoc( GxHDC ) = 0
         UserCancel = .T.
      ENDIF
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      * Exiting from a For First loop.
      EXIT
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P08173) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL3 = .F.
RETURN

***********************
PROCEDURE HMP0
***********************

   PARAMETERS Gx_out, P_lines, Gx_line, Gx_inc, GX_footer, GX_inc_test

   Gx_line = Gx_line + Gx_inc
   IF Gx_line + GX_inc_test > P_lines
      IF Gx_page > 0
         Gx_line = P_lines
         IF Gx_dvc = "PRN" .and. Gx_pg_started
            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
         GXPrn_Flag = GXAuxPrn_Flag
         Gx_pg_started = .T.
      ENDIF
   ENDIF
RETURN
