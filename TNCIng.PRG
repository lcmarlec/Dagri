      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S473TDVNro
         LOCAL S648TDVLIn
         S2EmpCod = THISFORM.A2EmpCod
         S473TDVNro = THISFORM.A473TDVNro
         S648TDVLIn = THISFORM.A648TDVLIn
         THISFORM.A648TDVLIn = THISFORM.M648TDVLIn
         THISFORM. cCT64S15 .SaveTemp()
         THISFORM. cCT64S15 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT64S15 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT64S15 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT64S15 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT64S15 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT64S15 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT64S15 .Refresh()
               THISFORM. cCT64S15 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
               THISFORM.A648TDVLIn = S648TDVLIn
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT64S15 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT64S15 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT64S15 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
            ENDDO
            IF sf_err != 0
               THISFORM. cCT64S15 .AppendRow()
               THISFORM. cCT64S15 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
               THISFORM.A648TDVLIn = S648TDVLIn
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A473TDVNro = S473TDVNro
         THISFORM.A648TDVLIn = S648TDVLIn
         RETURN .F.
      ENDFUNC
