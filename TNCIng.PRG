      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T006419" , @HStmt_T006419 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNCING","T006419","",GX_CURSOR_TYPE_READONLY,@HStmt_T006419) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TDVNroInt], [TDVLIn], [TDvLinTotR], [TDVPrc], [FamCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [ArtCod], [TDVCnt], [TdvCntAf] FROM [TDVENT1] (NOLOCK) WHERE [EmpCod] = ? AND [TDVNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [TDVNroInt], [TDVLIn]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T006419,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T006419,9)
                  THISFORM.GX_DB_BindColsT006419_01 ()
                  THISFORM.GX_DB_BindParmT006419_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T006419,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA473TDVNro = THISFORM.A473TDVNro
               Gx_err = GX_DB_SetDouble( HStmt_T006419,2,@AuxA473TDVNro,0)
               THISFORM.A473TDVNro = AuxA473TDVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T006419) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T006419 = Gx_err
               THISFORM.GX_DB_GetT006419_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T006419 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T006419) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T006419 = Gx_err
                  THISFORM.GX_DB_GetT006419_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T006419 <> 101
               BRK1S66 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT64S15.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T006419_473TDVNroInt = THISFORM.A473TDVNro .AND. THISFORM.Buf_T006419_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T006419) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T006419 = Gx_err
               THISFORM.GX_DB_GetT006419_01 ()
            ENDDO
         ENDIF
      ENDPROC
