            IF '' <> GETE('z:\temp')
               SCW170S20 = GETE('z:\temp') + '\' + SCW170S20
            ENDIF
            CREATE DBF (SCW170S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW170S20) EXCLUSIVE ALIAS SCW170S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW170S20
         THIS.GX_SfAlias = "SCW170S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01702" , @HStmt_W01702 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00F2","W01702","",GX_CURSOR_TYPE_READONLY,@HStmt_W01702) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntFan], [EntCont], [EntDom], [EntPos], [EntPaiCod], "
                  cmdbuf = cmdbuf + "  [EntGruCod], [EntCod] FROM [ENTID] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  [EntGruTip] = ? and [EntCod] >= ?) AND ([EntGruCod] like ?) AND ([EntFan] like ?) "
                  cmdbuf = cmdbuf + "  AND ([EntCont] like ?) AND ([EntDom] like ?) ORDER BY [EmpCod], [EntGruTip], [EntCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01702,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01702,9)
                  THISFORM.GX_DB_BindColsW01702_01 ()
                  THISFORM.GX_DB_BindParmW01702_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01702,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01702,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxAV5C120 = THISFORM.AV5C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01702,3,@AuxAV5C120,0)
               THISFORM.AV5C120 = AuxAV5C120
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01702,4,PADR( TRIM(THISFORM.AV6C151),3, '%'),LEN(PADR( TRIM(THISFORM.AV6C151),3, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01702,5,PADR( TRIM(THISFORM.AV7C154),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C154),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01702,6,PADR( TRIM(THISFORM.AV8C155),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C155),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01702,7,PADR( TRIM(THISFORM.AV9C156),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C156),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01702 = Gx_err
               THISFORM.GX_DB_GetW01702_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01702 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01702) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01702 = Gx_err
                  THISFORM.GX_DB_GetW01702_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01702 <> 101
               BRKV4Q2 = .F.
               THISFORM.A154EntFan = THISFORM.Buf_W01702_154EntFan
               THISFORM.A155EntCon = THISFORM.Buf_W01702_155EntCont
               THISFORM.A156EntDom = THISFORM.Buf_W01702_156EntDom
               THISFORM.A163EntPos = THISFORM.Buf_W01702_163EntPos
               THISFORM.A157EntPai = THISFORM.Buf_W01702_157EntPaiCod
               THISFORM.A151EntGru = THISFORM.Buf_W01702_151EntGruCod
               THISFORM.A120EntCod = THISFORM.Buf_W01702_120EntCod
               GX_SFLOAD = 0
               THISFORM.U12V4Q2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01702 = Gx_err
               THISFORM.GX_DB_GetW01702_01 ()
            ENDDO
         ENDIF
      ENDPROC
