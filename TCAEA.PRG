            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT250S29 = GETE('z:\temp') + '\' + SCT250S29
            ENDIF
            CREATE DBF (SCT250S29) FROM ARRAY GX_STRUCT
            USE
            USE (SCT250S29) EXCLUSIVE ALIAS SCT250S29
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
