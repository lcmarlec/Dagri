      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025014" , @HStmt_T025014 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAEA","T025014","",GX_CURSOR_TYPE_READONLY,@HStmt_T025014) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [CAEAPer], [CAEAOrd], [CAEAOK], [CAEAErCod], [CAEAERDsc], [CAEAErTpo] "
                  cmdbuf = cmdbuf + "  FROM [CAEA1] (NOLOCK) WHERE [EmpCod] = ? AND [CAEAPer] = ? AND [CAEAOrd] = ? AND "
                  cmdbuf = cmdbuf + "  [CAEAOK] = ? ORDER BY [EmpCod], [CAEAPer], [CAEAOrd], [CAEAOK], [CAEAErCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T025014,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T025014,9)
                  THISFORM.GX_DB_BindColsT025014_01 ()
                  THISFORM.GX_DB_BindParmT025014_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T025014,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2426CAEAP = THISFORM.A2426CAEAP
               Gx_err = GX_DB_SetLong( HStmt_T025014,2,@AuxA2426CAEAP,0)
               THISFORM.A2426CAEAP = AuxA2426CAEAP
               AuxA2427CAEAO = THISFORM.A2427CAEAO
               Gx_err = GX_DB_SetInt( HStmt_T025014,3,@AuxA2427CAEAO,0)
               THISFORM.A2427CAEAO = AuxA2427CAEAO
               AuxA2428CAEAO = THISFORM.A2428CAEAO
               Gx_err = GX_DB_SetInt( HStmt_T025014,4,@AuxA2428CAEAO,0)
               THISFORM.A2428CAEAO = AuxA2428CAEAO
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T025014) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025014 = Gx_err
               THISFORM.GX_DB_GetT025014_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T025014 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025014) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T025014 = Gx_err
                  THISFORM.GX_DB_GetT025014_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T025014 <> 101
               BRK6Y274 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT250S29.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025014) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025014 = Gx_err
               THISFORM.GX_DB_GetT025014_01 ()
            ENDDO
         ENDIF
      ENDPROC
