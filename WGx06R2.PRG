      PROCEDURE CreateTemp
         LOCAL SCW707S20
         SCW707S20 = ""
         IF USED( "SCW707S20" )
            SELECT SCW707S20
            SCW707S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW707S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA1782tEch"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1783tEch"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1785tEch"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1786tEch"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA1789tech"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW707S20 = GETE('z:\temp') + '\' + SCW707S20
            ENDIF
            CREATE DBF (SCW707S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW707S20) EXCLUSIVE ALIAS SCW707S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW707S20
         THIS.GX_SfAlias = "SCW707S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07072" , @HStmt_W07072 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06R2","W07072","",GX_CURSOR_TYPE_READONLY,@HStmt_W07072) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [tECHNroInt], [techmcoMon], [tEchMcoImp], [tEchMcoFch], [tEchMcoCta], "
                  cmdbuf = cmdbuf + "  [tEchMcoCod] FROM [TENCHE1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [tECHNroInt] "
                  cmdbuf = cmdbuf + "  = ? and [tEchMcoCod] >= ? and [tEchMcoCta] >= ? and [tEchMcoFch] >= ?) AND ([tEchMcoImp] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([techmcoMon] >= ?) ORDER BY [EmpCod], [tECHNroInt], [tEchMcoCod], [tEchMcoCta], "
                  cmdbuf = cmdbuf + "  [tEchMcoFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07072,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07072,9)
                  THISFORM.GX_DB_BindColsW07072_01 ()
                  THISFORM.GX_DB_BindParmW07072_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07072,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1103tECHN = THISFORM.A1103tECHN
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07072,2,@AuxA1103tECHN,0)
               THISFORM.A1103tECHN = AuxA1103tECHN
               AuxAV5C1782 = THISFORM.AV5C1782
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07072,3,@AuxAV5C1782,0)
               THISFORM.AV5C1782 = AuxAV5C1782
               AuxAV6C1783 = THISFORM.AV6C1783
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07072,4,@AuxAV6C1783,0)
               THISFORM.AV6C1783 = AuxAV6C1783
               AuxAV7C1785 = THISFORM.AV7C1785
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07072,5,@AuxAV7C1785,0)
               THISFORM.AV7C1785 = AuxAV7C1785
               AuxAV8C1786 = THISFORM.AV8C1786
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07072,6,@AuxAV8C1786,0)
               THISFORM.AV8C1786 = AuxAV8C1786
               AuxAV9C1789 = THISFORM.AV9C1789
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07072,7,@AuxAV9C1789,0)
               THISFORM.AV9C1789 = AuxAV9C1789
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07072 = Gx_err
               THISFORM.GX_DB_GetW07072_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07072 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07072) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07072 = Gx_err
                  THISFORM.GX_DB_GetW07072_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07072 <> 101
               BRKVJN2 = .F.
               THISFORM.A1789techm = THISFORM.Buf_W07072_1789techmcoMon
               THISFORM.A1786tEchM = THISFORM.Buf_W07072_1786tEchMcoImp
               THISFORM.A1785tEchM = THISFORM.Buf_W07072_1785tEchMcoFch
               THISFORM.A1783tEchM = THISFORM.Buf_W07072_1783tEchMcoCta
               THISFORM.A1782tEchM = THISFORM.Buf_W07072_1782tEchMcoCod
               GX_SFLOAD = 0
               THISFORM.U12VJN2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07072 = Gx_err
               THISFORM.GX_DB_GetW07072_01 ()
            ENDDO
         ENDIF
      ENDPROC
