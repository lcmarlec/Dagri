      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12752" , @HStmt_W12752 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCOPIARR","W12752","",GX_CURSOR_TYPE_READONLY,@HStmt_W12752) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EntGruTip], T1.[EmpCod], T1.[RutCod], T3.[EntLgTel], T3.[EntLgCont], T1.[RutHab], "
                  cmdbuf = cmdbuf + "  T1.[RutPri], T3.[EntLgDom], T3.[EntLgDsc], T1.[EntLgCod], T2.[EntRaz], T1.[EntCod] "
                  cmdbuf = cmdbuf + "  FROM (([RUTVTA] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CLTES] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip] AND T3.[EntCod] = T1.[EntCod] AND T3.[EntLgCod] = T1.[EntLgCod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[RutCod] = ? ORDER BY T1.[EmpCod], T1.[RutCod], T1.[EntCod], "
                  cmdbuf = cmdbuf + "  T1.[EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12752,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12752,19)
                  THISFORM.GX_DB_BindColsW12752_01 ()
                  THISFORM.GX_DB_BindParmW12752_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12752,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Desrut = THISFORM.AV21Desrut
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12752,2,@AuxAV21Desrut,0)
               THISFORM.AV21Desrut = AuxAV21Desrut
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12752) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12752 = Gx_err
               THISFORM.GX_DB_GetW12752_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WCopiarR"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12752 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12752) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12752 = Gx_err
                  THISFORM.GX_DB_GetW12752_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12752 <> 101
               BRKVZF2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W12752_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W12752_2EmpCod
               THISFORM.A966RutCod = THISFORM.Buf_W12752_966RutCod
               THISFORM.A186EntLgT = THISFORM.Buf_W12752_186EntLgTel
               THISFORM.A185EntLgC = THISFORM.Buf_W12752_185EntLgCont
               THISFORM.A968RutHab = THISFORM.Buf_W12752_968RutHab
               THISFORM.A967RutPri = THISFORM.Buf_W12752_967RutPri
               THISFORM.A178EntLgD = THISFORM.Buf_W12752_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W12752_177EntLgDsc
               THISFORM.A176EntLgC = THISFORM.Buf_W12752_176EntLgCod
               THISFORM.A153EntRaz = THISFORM.Buf_W12752_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W12752_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W12752_153EntRaz
               THISFORM.A186EntLgT = THISFORM.Buf_W12752_186EntLgTel
               THISFORM.A185EntLgC = THISFORM.Buf_W12752_185EntLgCont
               THISFORM.A178EntLgD = THISFORM.Buf_W12752_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W12752_177EntLgDsc
               GX_SFLOAD = 0
               THISFORM.U16VZF2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12752) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12752 = Gx_err
               THISFORM.GX_DB_GetW12752_01 ()
            ENDDO
         ENDIF
      ENDPROC
