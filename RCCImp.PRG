***********************
PROCEDURE EPE10
***********************

   DO HE10 WITH Gx_out , P_lines , 0, P_lines +1, .T., 0
   IF Gx_dvc = "PRN"
      GXAuxPrn_Flag = GXPrn_Flag
      gxPrnObj.GXEndDoc( GxHDC , @GXAuxPrn_Flag)
      gxPrnObj.GXEndPrn( GxHDC , @GXAuxPrn_Flag)
      GXPrn_Flag = GXAuxPrn_Flag
      PRIVATE GXCallFrm
      IF PROGRAM(0) = "MENU"
         GXCallFrm = _SCREEN.ActiveForm
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 0
         ENDIF
      ENDIF
      DO WHILE gxPrnObj.GxIsAliveDoc( GxHDC ) != 0
         WAIT "" TIMEOUT 1
         DOEVENTS
      ENDDO
      RELEASE WINDOW _WMSG
      IF PROGRAM(0) = "MENU"
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 1
         ENDIF
      ENDIF
   ELSE
      SET DEVICE TO SCREEN
      RptView = .T.
   ENDIF
   DO CDE10
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

***********************
PROCEDURE HE10
***********************

   PARAMETERS Gx_out, P_lines, Gx_line, Gx_inc, GX_footer, GX_inc_test

   Gx_line = Gx_line + Gx_inc
   IF Gx_line + GX_inc_test > P_lines
      IF Gx_page > 0
         Gx_line = P_lines
         IF Gx_dvc = "PRN" .and. Gx_pg_started
            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
         GXPrn_Flag = GXAuxPrn_Flag
         Gx_pg_started = .T.
      ENDIF
      IF LEVEL1
         gxPrnObj.GxDwTextNB( GxHDC , [Fecha:] ,910,3+Gx_line,942,15+Gx_line , "MS Sans Serif",9 ,256 ,0,0,0,0 ,0 ,0,0,0 )
         IF SET('CENTURY') = 'ON'
            SET CENTURY OFF
         ENDIF
         gxPrnObj.GxDwText( GxHDC , DTOC(Gx_date) ,990,3+Gx_line,1031,17+Gx_line , "Times New Roman",9 ,256 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwTextNB( GxHDC , [Hora:] ,910,22+Gx_line,935,34+Gx_line , "MS Sans Serif",9 ,256 ,0,0,0,0 ,0 ,0,0,0 )
         gxPrnObj.GxDwText( GxHDC , Gx_time ,956,21+Gx_line,1043,35+Gx_line , "Times New Roman",9 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwTextNB( GxHDC , [Página:] ,910,39+Gx_line,955,54+Gx_line , "MS Sans Serif",10 ,256 ,0,0,0,0 ,0 ,0,0,0 )
         gxPrnObj.GxDwText( GxHDC , TRANSFORM(Gx_page, "999999")  ,1018,39+Gx_line,1053,53+Gx_line , "Times New Roman",9 ,258 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GxDwTextNB( GxHDC , [Liquidación al Vendedor ] ,468,35+Gx_line,632,53+Gx_line , "Times New Roman",12 ,256 ,1,0,0,0 ,0 ,0,0,0 )
         gxPrnObj.GxDwText( GxHDC , RV10Emprno ,21,0+Gx_line,170,14+Gx_line , "Times New Roman",9 ,256 ,0,0,0,0 ,0 ,0,0,0 , 1, 255,255,255 )
         gxPrnObj.GXDwLine( GxHDC ,9,58+Gx_line,1092,58+Gx_line ,2 ,0,0,0 )
         gxPrnObj.GxDwText( GxHDC , RV20Contro ,441,4+Gx_line,660,34+Gx_line , "Times New Roman",20 ,1 ,0,0,0,0 ,0 ,200,200,200 , 1, 255,255,255 )
         Gx_line = Gx_line + 61
      ENDIF
   ENDIF
