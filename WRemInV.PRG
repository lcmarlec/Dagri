               THISFORM.A1320CRITi = THISFORM.Buf_W04132_1320CRITiMo
               THISFORM.A1319CRIDs = THISFORM.Buf_W04132_1319CRIDsc
               GX_SFLOAD = 0
               THISFORM.U14VBH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04132) ,  ,  ,  , CS_SQLSRV ,  )
