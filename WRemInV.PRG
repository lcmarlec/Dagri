               THISFORM.A1483RiLot = THISFORM.Buf_W04132_1483RiLotVnc
               THISFORM.A1482RiLot = THISFORM.Buf_W04132_1482RiLotFch
               THISFORM.A1481RiLot = THISFORM.Buf_W04132_1481RiLotNro
               THISFORM.A6ArtDsc = THISFORM.Buf_W04132_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W04132_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W04132_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W04132_3FamCod
               THISFORM.A1316RILin = THISFORM.Buf_W04132_1316RILin
               THISFORM.A1315RiLug = THISFORM.Buf_W04132_1315RiLugHtaD
               THISFORM.A1314RILug = THISFORM.Buf_W04132_1314RILugHta
               THISFORM.A1313RiLug = THISFORM.Buf_W04132_1313RiLugDdeD
               THISFORM.A1312RILug = THISFORM.Buf_W04132_1312RILugDde
               THISFORM.A1311RIObs = THISFORM.Buf_W04132_1311RIObs
               THISFORM.A1308RIFch = THISFORM.Buf_W04132_1308RIFch
               THISFORM.A1320CRITi = THISFORM.Buf_W04132_1320CRITiMo
               THISFORM.A1319CRIDs = THISFORM.Buf_W04132_1319CRIDsc
               THISFORM.A1318CRICo = THISFORM.Buf_W04132_1318CRICod
               THISFORM.A6ArtDsc = THISFORM.Buf_W04132_6ArtDsc
               THISFORM.A1815Riusu = THISFORM.Buf_W04132_1815Riusuario
               THISFORM.A1584RiHor = THISFORM.Buf_W04132_1584RiHora
               THISFORM.A1310RIEst = THISFORM.Buf_W04132_1310RIEst
               THISFORM.A1317RINro = THISFORM.Buf_W04132_1317RINro
               THISFORM.A1314RILug = THISFORM.Buf_W04132_1314RILugHta
