                  cmdbuf = cmdbuf + "  T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T1.[RILin], T4.[LugDsc] AS "
                  cmdbuf = cmdbuf + "  RiLugHtaD, T3.[RILugHta] AS RILugHta, T5.[LugDsc] AS RiLugDdeD, T3.[RILugDde] AS "
                  cmdbuf = cmdbuf + "  RILugDde, T3.[RIObs], T3.[RIFch], T6.[CRITiMo], T6.[CRIDsc], T3.[CRICod] FROM ((((([REMINT1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] "
                  cmdbuf = cmdbuf + "  = T1.[ArtCod]) LEFT JOIN [REMINT] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[RINroInt] "
                  cmdbuf = cmdbuf + "  = T1.[RINroInt]) LEFT JOIN [LUGALM] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T4.[LugCod] = T3.[RILugHta]) LEFT JOIN [LUGALM] T5 (NOLOCK) ON T5.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T5.[LugCod] = T3.[RILugDde]) LEFT JOIN [CRINTERN] T6 (NOLOCK) ON T6.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T6.[CRICod] = T3.[CRICod]) WHERE T1.[EmpCod] = ? and T1.[RINroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[RINroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04132,11)
                  THISFORM.GX_DB_BindColsW04132_01 ()
                  THISFORM.GX_DB_BindParmW04132_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04132,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1306RINro = THISFORM.A1306RINro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04132,2,@AuxA1306RINro,0)
               THISFORM.A1306RINro = AuxA1306RINro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04132 = Gx_err
               THISFORM.GX_DB_GetW04132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04132 = Gx_err
                  THISFORM.GX_DB_GetW04132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04132 <> 101
               BRKVBH2 = .F.
               THISFORM.A1815Riusu = THISFORM.Buf_W04132_1815Riusuario
               THISFORM.A1584RiHor = THISFORM.Buf_W04132_1584RiHora
               THISFORM.A1310RIEst = THISFORM.Buf_W04132_1310RIEst
               THISFORM.A1317RINro = THISFORM.Buf_W04132_1317RINro
