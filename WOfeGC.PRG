      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06112" , @HStmt_W06112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFEGC","W06112","",GX_CURSOR_TYPE_READONLY,@HStmt_W06112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PlVEntCod] AS PlVEntCod, T1.[PlVGruTip] AS PlVGruTip, T1.[ArtCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[FamCod], T1.[EmpCod], T4.[PlvObs], T1.[PlVPrcReal], T1.[PlVPrc], T2.[ArtDsc], "
                  cmdbuf = cmdbuf + "  T3.[EntRaz] AS PlVEntRaz FROM ((([PLAVTA1] T1 (NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T3.[EntGruTip] = T1.[PlVGruTip] AND T3.[EntCod] = T1.[PlVEntCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [PLAVTA] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[PlVGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[PlVGruTip] AND T4.[PlVEntCod] = T1.[PlVEntCod]) WHERE T1.[PlVEntCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[PlVGruTip], T1.[PlVEntCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06112,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06112,13)
                  THISFORM.GX_DB_BindColsW06112_01 ()
                  THISFORM.GX_DB_BindParmW06112_01 ()
               ENDIF
               AuxA837PlVEnt = THISFORM.A837PlVEnt
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06112,1,@AuxA837PlVEnt,0)
               THISFORM.A837PlVEnt = AuxA837PlVEnt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06112 = Gx_err
               THISFORM.GX_DB_GetW06112_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV45Pgmnam = "WOfeGC"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06112) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06112 = Gx_err
                  THISFORM.GX_DB_GetW06112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06112 <> 101
               BRKVGZ2 = .F.
               THISFORM.AV38Op = SPACE(1)
               THISFORM.A836PlVGru = THISFORM.Buf_W06112_836PlVGruTip
               THISFORM.A5ArtCod = THISFORM.Buf_W06112_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W06112_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W06112_3FamCod
               THISFORM.A2EmpCod = THISFORM.Buf_W06112_2EmpCod
               THISFORM.A1885PlvOb = Gx_lvchar_to_char( THISFORM.Buf_W06112_1885PlvObs )
               THISFORM.A1328PlVPr = THISFORM.Buf_W06112_1328PlVPrcReal
               THISFORM.A839PlVPrc = THISFORM.Buf_W06112_839PlVPrc
               THISFORM.A6ArtDsc = THISFORM.Buf_W06112_6ArtDsc
               THISFORM.A838PlVEnt = THISFORM.Buf_W06112_838PlVEntRaz
               THISFORM.A6ArtDsc = THISFORM.Buf_W06112_6ArtDsc
               THISFORM.A838PlVEnt = THISFORM.Buf_W06112_838PlVEntRaz
               THISFORM.A1885PlvOb = Gx_lvchar_to_char( THISFORM.Buf_W06112_1885PlvObs )
               GX_SFLOAD = 0
               THISFORM.U17VGZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06112 = Gx_err
               THISFORM.GX_DB_GetW06112_01 ()
            ENDDO
         ENDIF
      ENDPROC
