      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10172" , @HStmt_W10172 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKPCIAI","W10172","",GX_CURSOR_TYPE_READONLY,@HStmt_W10172) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PaiCod], T2.[PaiDsc], T1.[PciDsc], T1.[PciCod], T1.[PciDGI] FROM ([PCIAS] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [PAISES] T2 (NOLOCK) ON T2.[PaiCod] = T1.[PaiCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[PaiCod] = ?) AND (T1.[PciDsc] like ?) ORDER BY T1.[PciDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10172,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10172,13)
                  THISFORM.GX_DB_BindColsW10172_01 ()
                  THISFORM.GX_DB_BindParmW10172_01 ()
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10172,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10172,2,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10172 = Gx_err
               THISFORM.GX_DB_GetW10172_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10172 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10172) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10172 = Gx_err
                  THISFORM.GX_DB_GetW10172_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10172 <> 101
               BRKVS92 = .F.
               THISFORM.A632PaiDsc = THISFORM.Buf_W10172_632PaiDsc
               THISFORM.A634PciDsc = THISFORM.Buf_W10172_634PciDsc
               THISFORM.A633PciCod = THISFORM.Buf_W10172_633PciCod
               THISFORM.A786PciDGI = THISFORM.Buf_W10172_786PciDGI
               THISFORM.A632PaiDsc = THISFORM.Buf_W10172_632PaiDsc
               GX_SFLOAD = 0
               THISFORM.U14VS92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10172 = Gx_err
               THISFORM.GX_DB_GetW10172_01 ()
            ENDDO
         ENDIF
