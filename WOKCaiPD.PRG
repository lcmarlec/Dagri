      ***********************
      PROCEDURE U12VDA2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         IF THISFORM.AV10Anio = 0 .OR. THISFORM.AV11Mes < 1 .OR. THISFORM.AV11Mes > 12 .OR. THISFORM.AV10Anio > year( THISFORM.AV6Fechasi )
            THISFORM.Refresh()
            DO GX_ERRMW WITH "Período Incorrecto "
         ELSE
            IF THISFORM.AV13Dccnro < 1 .OR. THISFORM.AV12Dccnro > THISFORM.AV13Dccnro
               THISFORM.Refresh()
               DO GX_ERRMW WITH "Rango de Números de Control Incorrecto "
            ELSE
               IF THISFORM.AV10Anio < 1900
                  IF THISFORM.AV10Anio < 50
                     THISFORM.AV10Anio = THISFORM.AV10Anio + 2000
                  ELSE
                     THISFORM.AV10Anio = THISFORM.AV10Anio + 1900
                  ENDIF
               ENDIF
               IF THISFORM.AV14Que = "C"
                  THISFORM.Refresh()
                  Response = .T.
                  DO GX_CONFW WITH 'Acepta los CAI del período como Controlados ?' , Response
               ELSE
                  THISFORM.Refresh()
                  Response = .T.
                  DO GX_CONFW WITH 'Acepta los CAI del período como VERIFICADOS ?' , Response
               ENDIF
               IF Response
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV8Emprcod
                  Aux1 = THISFORM.AV10Anio
                  Aux2 = THISFORM.AV11Mes
                  Aux3 = THISFORM.AV12Dccnro
                  Aux4 = THISFORM.AV13Dccnro
                  Aux5 = THISFORM.AV14Que
                  Aux6 = THISFORM.AV15Usuari
                  DO POkCAIPD WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6
                  THISFORM.AV8Emprcod = Aux0
                  THISFORM.AV10Anio = Aux1
                  THISFORM.AV11Mes = Aux2
                  THISFORM.AV12Dccnro = Aux3
                  THISFORM.AV13Dccnro = Aux4
                  THISFORM.AV14Que = Aux5
                  THISFORM.AV15Usuari = Aux6
                  GX_rploop = .T.
                  THISFORM.Refresh()
                  DO GX_ERRMW WITH "Proceso Terminado"
               ENDIF
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

