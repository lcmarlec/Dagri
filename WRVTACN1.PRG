               THISFORM.AV14Sucori = AuxAV14Sucori
               AuxAV15Nroori = THISFORM.AV15Nroori
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03022,4,@AuxAV15Nroori,0)
               THISFORM.AV15Nroori = AuxAV15Nroori
