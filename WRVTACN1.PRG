                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTACN1","W03022","",GX_CURSOR_TYPE_READONLY,@HStmt_W03022) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RVtEntGruT] AS RVtEntGruT, T1.[EmpCod], T1.[RVtNroInt], T3.[EntLgDom], "
                  cmdbuf = cmdbuf + "  T1.[RVtEntLgCo] AS RVtEntLgCo, T2.[EntRaz] AS RVtEntRaz, T1.[RVtEntCod] AS RVtEntCod, "
                  cmdbuf = cmdbuf + "  T1.[RVtFch], T1.[RVtNro], T1.[RVtSuc] FROM (([REMVTA] T1 (FASTFIRSTROW NOLOCK) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[RVtEntGruT] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[RVtEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) ON T3.[EmpCod] = "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] AND T3.[EntGruTip] = T1.[RVtEntGruT] AND T3.[EntCod] = T1.[RVtEntCod] "
                  cmdbuf = cmdbuf + "  AND T3.[EntLgCod] = T1.[RVtEntLgCo]) WHERE (T1.[EmpCod] = ?) AND (T1.[RVtFch] >= "
                  cmdbuf = cmdbuf + "  ?) AND (T1.[RVtSuc] = ?) AND (T1.[RVtNro] >= ?) AND (T1.[RVtNro] <= ?) ORDER BY "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T1.[RVtNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03022,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03022,15)
                  THISFORM.GX_DB_BindColsW03022_01 ()
                  THISFORM.GX_DB_BindParmW03022_01 ()
