      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06532" , @HStmt_W06532 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCCVYB","W06532","",GX_CURSOR_TYPE_READONLY,@HStmt_W06532) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[CCPagFch], T1.[CCPagTip], T1.[CCPagSer], T1.[CCPagSuc], T1.[CCPagnro], "
                  cmdbuf = cmdbuf + "  T2.[VdrPrvGru], T2.[VdrPrvCod], T1.[CCPagOri], T1.[CCImpPag], T1.[CCImpBas], T2.[VdrNom] "
                  cmdbuf = cmdbuf + "  AS CCVdrNom, T1.[CCVdrCod] AS CCVdrCod, T1.[CCPagNI], T1.[EmpCod] FROM ([CCPAGO] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [VEND] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[VdrCod] = T1.[CCVdrCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[CCPagFch] >= ?) "
                  cmdbuf = cmdbuf + "  AND (T1.[CCVdrCod] = ? or ? = 0) AND (T1.[CCPagSuc] = ? or ? = 0) AND (T1.[CCPagnro] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) AND (T1.[CCImpPag] >= ?) AND (T1.[CCImpPag] <= ? or ? = 0) AND (T1.[CCPagTip] "
                  cmdbuf = cmdbuf + "  = ?) ORDER BY T1.[EmpCod], T1.[CCPagNI], T1.[CCVdrCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06532,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06532,16)
                  THISFORM.GX_DB_BindColsW06532_01 ()
                  THISFORM.GX_DB_BindParmW06532_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06532,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV15Desfch = THISFORM.AV15Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06532,2,@AuxAV15Desfch,0)
               THISFORM.AV15Desfch = AuxAV15Desfch
               AuxAV33Vdrcod = THISFORM.AV33Vdrcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06532,3,@AuxAV33Vdrcod,0)
               THISFORM.AV33Vdrcod = AuxAV33Vdrcod
               AuxAV33Vdrcod = THISFORM.AV33Vdrcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06532,4,@AuxAV33Vdrcod,0)
               THISFORM.AV33Vdrcod = AuxAV33Vdrcod
               AuxAV18Dessuc = THISFORM.AV18Dessuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06532,5,@AuxAV18Dessuc,0)
               THISFORM.AV18Dessuc = AuxAV18Dessuc
               AuxAV18Dessuc = THISFORM.AV18Dessuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06532,6,@AuxAV18Dessuc,0)
               THISFORM.AV18Dessuc = AuxAV18Dessuc
               AuxAV19Desnro = THISFORM.AV19Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06532,7,@AuxAV19Desnro,0)
               THISFORM.AV19Desnro = AuxAV19Desnro
               AuxAV19Desnro = THISFORM.AV19Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06532,8,@AuxAV19Desnro,0)
               THISFORM.AV19Desnro = AuxAV19Desnro
               AuxAV20Impdes = THISFORM.AV20Impdes
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06532,9,@AuxAV20Impdes,0)
               THISFORM.AV20Impdes = AuxAV20Impdes
               AuxAV21Imphas = THISFORM.AV21Imphas
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06532,10,@AuxAV21Imphas,0)
               THISFORM.AV21Imphas = AuxAV21Imphas
               AuxAV21Imphas = THISFORM.AV21Imphas
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06532,11,@AuxAV21Imphas,0)
               THISFORM.AV21Imphas = AuxAV21Imphas
               AuxAV37Ccpagt = THISFORM.AV37Ccpagt
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06532,12,AuxAV37Ccpagt,2,0)
               THISFORM.AV37Ccpagt = AuxAV37Ccpagt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06532 = Gx_err
               THISFORM.GX_DB_GetW06532_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV40Pgmnam = "WCCVyB"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06532 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06532) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06532 = Gx_err
                  THISFORM.GX_DB_GetW06532_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06532 <> 101
               BRKVI52 = .F.
               THISFORM.AV35Ver = 0
               THISFORM.A1955CCPag = THISFORM.Buf_W06532_1955CCPagFch
               THISFORM.A1951CCPag = THISFORM.Buf_W06532_1951CCPagTip
               THISFORM.A1952CCPag = THISFORM.Buf_W06532_1952CCPagSer
