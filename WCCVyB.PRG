               THISFORM.A3510VdrPr = THISFORM.Buf_W06532_3510VdrPrvCod
               THISFORM.A2963CCPag = THISFORM.Buf_W06532_2963CCPagOri
               THISFORM.A1957CCImp = THISFORM.Buf_W06532_1957CCImpPag
               THISFORM.A1956CCImp = THISFORM.Buf_W06532_1956CCImpBas
               THISFORM.A1947CCVdr = THISFORM.Buf_W06532_1947CCVdrNom
               THISFORM.A1946CCVdr = THISFORM.Buf_W06532_1946CCVdrCod
               THISFORM.A1945CCPag = THISFORM.Buf_W06532_1945CCPagNI
               THISFORM.A2EmpCod = THISFORM.Buf_W06532_2EmpCod
               THISFORM.A3509VdrPr = THISFORM.Buf_W06532_3509VdrPrvGru
               THISFORM.A3510VdrPr = THISFORM.Buf_W06532_3510VdrPrvCod
               THISFORM.A1947CCVdr = THISFORM.Buf_W06532_1947CCVdrNom
               GX_SFLOAD = 0
               THISFORM.U18VI52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06532 = Gx_err
               THISFORM.GX_DB_GetW06532_01 ()
            ENDDO
         ENDIF
