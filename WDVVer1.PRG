      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00443" , @HStmt_W00443 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVVER1","W00443","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00443) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntLgCo] AS DcVEntLgCo, T1.[DcVEst], T1.[DcVTotSld], T1.[DcVNroInt], "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T1.[DcVEntGruT] AS DcVEntGruT, T4.[EntLgDNro], T4.[EntLgDom] AS DcVEntLgDo, "
                  cmdbuf = cmdbuf + "  T4.[EntlgObs], T1.[DcvTipRed], T1.[DcvLE], T1.[DcvFac], T1.[DCVNroPro], T2.[EmpVtaCie], "
                  cmdbuf = cmdbuf + "  T4.[EntLgCIvCo], T1.[DcvIdioma], T1.[DcvCotiz], T1.[DcvMonCod], T1.[DcvCAENro], "
                  cmdbuf = cmdbuf + "  T1.[DcVObs], T1.[DcVFaturo], T1.[DCvOrd12], T1.[DcVNroaf], T1.[DcVSucaf], T1.[DcVSeraf], "
                  cmdbuf = cmdbuf + "  T1.[DcVTipaf], T1.[DcVFch], T3.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, "
                  cmdbuf = cmdbuf + "  T1.[DcVNet], T1.[DcVTot], T1.[DcVNro], T1.[DcVSuc], T1.[DcVSer], T1.[DcVTip] FROM "
                  cmdbuf = cmdbuf + "  ((([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EMPRES] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntGruT] AND T3.[EntCod] = T1.[DcVEntCod]) LEFT JOIN [CLTES] T4 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T4.[EmpCod] = T1.[EmpCod] AND T4.[EntGruTip] = T1.[DcVEntGruT] AND T4.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntCod] AND T4.[EntLgCod] = T1.[DcVEntLgCo]) WHERE T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[DcVNroInt] = ? ORDER BY T1.[EmpCod], T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00443,cmdbuf)
                  THISFORM.GX_DB_BindColsW00443_01 ()
                  THISFORM.GX_DB_BindParmW00443_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00443,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Ni = THISFORM.AV19Ni
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00443,2,@AuxAV19Ni,0)
               THISFORM.AV19Ni = AuxAV19Ni
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00443) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00443 = Gx_err
               THISFORM.GX_DB_GetW00443_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV88Pgmnam = "WDVVer1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00443 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00443) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00443 = Gx_err
                  THISFORM.GX_DB_GetW00443_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00443 <> 101
               BRKV182 = .F.
               THISFORM.A419DcVEnt = THISFORM.Buf_W00443_419DcVEntLgCo
