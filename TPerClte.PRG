      PROCEDURE CreateTemp
         LOCAL SCT313S4
         SCT313S4 = ""
         IF USED( "SCT313S4" )
            SELECT SCT313S4
            SCT313S4 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT313S4
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA2993EIDd"
            GX_STRUCT[ 1 ,2]= "D"
