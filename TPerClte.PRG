            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2994EIBa"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 240
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2999EIMi"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA2995EICo"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 7
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA2996EICo"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 7
            GX_STRUCT[ 6 ,4]= 4

            GX_STRUCT[ 7 ,1]= "sA2997EIPo"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 7
            GX_STRUCT[ 7 ,4]= 4

            GX_STRUCT[ 8 ,1]= "sA2998EIPo"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 7
            GX_STRUCT[ 8 ,4]= 4

            GX_STRUCT[ 9 ,1]= "sA3001EIEx"
            GX_STRUCT[ 9 ,2]= "C"
            GX_STRUCT[ 9 ,3]= 1
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT313S4 = GETE('z:\temp') + '\' + SCT313S4
            ENDIF
            CREATE DBF (SCT313S4) FROM ARRAY GX_STRUCT
            USE
            USE (SCT313S4) EXCLUSIVE ALIAS SCT313S4
