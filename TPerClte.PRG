      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S166EntCui
         LOCAL S613ImpCod
         LOCAL S2993EIDde
         S2EmpCod = THISFORM.A2EmpCod
         S166EntCui = THISFORM.A166EntCui
         S613ImpCod = THISFORM.A613ImpCod
         S2993EIDde = THISFORM.A2993EIDde
         THISFORM.A2993EIDde = THISFORM.M2993EIDde
         THISFORM. cCT313S4 .SaveTemp()
         THISFORM. cCT313S4 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT313S4 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT313S4 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT313S4 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S613ImpCod = THISFORM.A613ImpCod .AND. S2993EIDde = THISFORM.A2993EIDde
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT313S4 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT313S4 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S613ImpCod = THISFORM.A613ImpCod .AND. S2993EIDde = THISFORM.A2993EIDde
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT313S4 .Refresh()
               THISFORM. cCT313S4 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A166EntCui = S166EntCui
               THISFORM.A613ImpCod = S613ImpCod
               THISFORM.A2993EIDde = S2993EIDde
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT313S4 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT313S4 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S613ImpCod = THISFORM.A613ImpCod .AND. S2993EIDde = THISFORM.A2993EIDde
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT313S4 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S166EntCui = THISFORM.A166EntCui .AND. S613ImpCod = THISFORM.A613ImpCod .AND. S2993EIDde = THISFORM.A2993EIDde
            ENDDO
            IF sf_err != 0
               THISFORM. cCT313S4 .AppendRow()
               THISFORM. cCT313S4 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A166EntCui = S166EntCui
               THISFORM.A613ImpCod = S613ImpCod
               THISFORM.A2993EIDde = S2993EIDde
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
