      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T031314" , @HStmt_T031314 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPERCLTE","T031314","",GX_CURSOR_TYPE_READONLY,@HStmt_T031314) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntCui], [ImpCod], [EIDde], [EIBase], [EIMin], [EICoef1], [EICoef2], "
                  cmdbuf = cmdbuf + "  [EIPorc1], [EIPorc2], [EIExento] FROM [ENTIMP] (NOLOCK) WHERE [EmpCod] = ? AND [EntCui] "
                  cmdbuf = cmdbuf + "  = ? AND [ImpCod] = ? ORDER BY [EmpCod], [EntCui], [ImpCod], [EIDde]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T031314,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T031314,12)
                  THISFORM.GX_DB_BindColsT031314_01 ()
                  THISFORM.GX_DB_BindParmT031314_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T031314,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T031314,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               AuxA613ImpCod = THISFORM.A613ImpCod
               Gx_err = GX_DB_SetStr( HStmt_T031314,3,AuxA613ImpCod,6,0)
               THISFORM.A613ImpCod = AuxA613ImpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T031314) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031314 = Gx_err
               THISFORM.GX_DB_GetT031314_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T031314 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031314) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T031314 = Gx_err
                  THISFORM.GX_DB_GetT031314_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T031314 <> 101
               BRK8P345 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT313S4.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T031314_613ImpCod = THISFORM.A613ImpCod .AND. THISFORM.Buf_T031314_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T031314_166EntCui = THISFORM.A166EntCui
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T031314) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T031314 = Gx_err
               THISFORM.GX_DB_GetT031314_01 ()
            ENDDO
         ENDIF
      ENDPROC
