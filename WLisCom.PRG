            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW75S3 = GETE('z:\temp') + '\' + SCW75S3
            ENDIF
            CREATE DBF (SCW75S3) FROM ARRAY GX_STRUCT
            USE
