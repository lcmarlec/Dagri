         THISFORM. cCT141S19 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT141S19 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT141S19 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT141S19 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1434ActCo = THISFORM.A1434ActCo .AND. S1579ActGa = THISFORM.A1579ActGa
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT141S19 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT141S19 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1434ActCo = THISFORM.A1434ActCo .AND. S1579ActGa = THISFORM.A1579ActGa
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT141S19 .Refresh()
               THISFORM. cCT141S19 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1434ActCo = S1434ActCo
               THISFORM.A1579ActGa = S1579ActGa
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT141S19 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT141S19 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1434ActCo = THISFORM.A1434ActCo .AND. S1579ActGa = THISFORM.A1579ActGa
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT141S19 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1434ActCo = THISFORM.A1434ActCo .AND. S1579ActGa = THISFORM.A1579ActGa
            ENDDO
            IF sf_err != 0
               THISFORM. cCT141S19 .AppendRow()
               THISFORM. cCT141S19 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1434ActCo = S1434ActCo
               THISFORM.A1579ActGa = S1579ActGa
               RETURN .T.
            ENDIF
