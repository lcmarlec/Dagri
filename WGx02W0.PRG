      PROCEDURE CreateTemp
         LOCAL SCW280S14
         SCW280S14 = ""
         IF USED( "SCW280S14" )
            SELECT SCW280S14
            SCW280S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW280S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA150EntGr"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA120EntCo"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA963RGNPe"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW280S14 = GETE('z:\temp') + '\' + SCW280S14
            ENDIF
            CREATE DBF (SCW280S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW280S14) EXCLUSIVE ALIAS SCW280S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW280S14
         THIS.GX_SfAlias = "SCW280S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02802" , @HStmt_W02802 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02W0","W02802","",GX_CURSOR_TYPE_READONLY,@HStmt_W02802) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [RGNPer], [EntCod], [EntGruTip], [EmpCod] FROM [RGAN] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] >= ?) AND ([EntGruTip] like ?) AND ([EntCod] >= ?) AND ([RGNPer] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [EmpCod], [EntGruTip], [EntCod], [RGNPer]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02802,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02802,8)
                  THISFORM.GX_DB_BindColsW02802_01 ()
                  THISFORM.GX_DB_BindParmW02802_01 ()
               ENDIF
               AuxAV18C2 = THISFORM.AV18C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02802,1,@AuxAV18C2,0)
               THISFORM.AV18C2 = AuxAV18C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02802,2,PADR( TRIM(THISFORM.AV17C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV17C150),2, '%')),0)
               AuxAV16C120 = THISFORM.AV16C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02802,3,@AuxAV16C120,0)
               THISFORM.AV16C120 = AuxAV16C120
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02802,4,PADR( TRIM(THISFORM.AV15C963),6, '%'),LEN(PADR( TRIM(THISFORM.AV15C963),6, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02802 = Gx_err
               THISFORM.GX_DB_GetW02802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02802 = Gx_err
                  THISFORM.GX_DB_GetW02802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02802 <> 101
               BRKV7S2 = .F.
               THISFORM.A963RGNPer = THISFORM.Buf_W02802_963RGNPer
               THISFORM.A120EntCod = THISFORM.Buf_W02802_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W02802_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W02802_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V7S2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02802 = Gx_err
               THISFORM.GX_DB_GetW02802_01 ()
            ENDDO
         ENDIF
      ENDPROC
