      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11522" , @HStmt_W11522 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCARGAAG","W11522","",GX_CURSOR_TYPE_READONLY,@HStmt_W11522) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PedEst], T1.[PedNro], T1.[PedSec], T1.[PedGruTip] AS PedGruTip, T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[PedCarNro], T1.[PedCarFch], T1.[PedNroFac], T1.[PedSucFac], T1.[PedNroRto], "
                  cmdbuf = cmdbuf + "  T1.[PedSucRto], T2.[Entlgloc], T2.[EntLgDsc], T1.[PedSucCod] AS PedSucCod, T1.[PedEntCod] "
                  cmdbuf = cmdbuf + "  AS PedEntCod, T1.[PedFch] FROM ([PEDIDO1] T1 (NOLOCK) LEFT JOIN [CLTES] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[PedGruTip] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) WHERE (T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[PedFch] = ?) AND (T1.[PedNro] = ?) AND (T1.[PedEst] >= 1) AND (T1.[PedEst] < "
                  cmdbuf = cmdbuf + "  9) AND (T1.[PedEntCod] = ? or ? = 0) AND (T1.[PedCarNro] <> ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[PedFch], T1.[PedGruTip], T1.[PedEntCod], T1.[PedSucCod], T1.[PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11522,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11522,15)
                  THISFORM.GX_DB_BindColsW11522_01 ()
                  THISFORM.GX_DB_BindParmW11522_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11522,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV15Fecdes = THISFORM.AV15Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11522,2,@AuxAV15Fecdes,0)
               THISFORM.AV15Fecdes = AuxAV15Fecdes
               AuxAV19Pednro = THISFORM.AV19Pednro
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11522,3,@AuxAV19Pednro,0)
               THISFORM.AV19Pednro = AuxAV19Pednro
               AuxAV35Despro = THISFORM.AV35Despro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11522,4,@AuxAV35Despro,0)
               THISFORM.AV35Despro = AuxAV35Despro
               AuxAV35Despro = THISFORM.AV35Despro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11522,5,@AuxAV35Despro,0)
               THISFORM.AV35Despro = AuxAV35Despro
               AuxAV34Pedcar = THISFORM.AV34Pedcar
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11522,6,AuxAV34Pedcar,15,0)
               THISFORM.AV34Pedcar = AuxAV34Pedcar
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11522 = Gx_err
               THISFORM.GX_DB_GetW11522_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV41Pgmnam = "WCargaAg"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11522 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11522) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11522 = Gx_err
                  THISFORM.GX_DB_GetW11522_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11522 <> 101
               BRKVW02 = .F.
               THISFORM.AV14Sel = 0
               THISFORM.A826PedEst = THISFORM.Buf_W11522_826PedEst
               THISFORM.A796PedNro = THISFORM.Buf_W11522_796PedNro
               THISFORM.A809PedSec = THISFORM.Buf_W11522_809PedSec
               THISFORM.A797PedGru = THISFORM.Buf_W11522_797PedGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W11522_2EmpCod
               THISFORM.A3360PedCa = THISFORM.Buf_W11522_3360PedCarNro
               THISFORM.A3362PedCa = THISFORM.Buf_W11522_3362PedCarFch
               THISFORM.A829PedNro = THISFORM.Buf_W11522_829PedNroFac
               THISFORM.A828PedSuc = THISFORM.Buf_W11522_828PedSucFac
               THISFORM.A831PedNro = THISFORM.Buf_W11522_831PedNroRto
               THISFORM.A830PedSuc = THISFORM.Buf_W11522_830PedSucRto
               THISFORM.A1076Entlg = THISFORM.Buf_W11522_1076Entlgloc
               THISFORM.A177EntLgD = THISFORM.Buf_W11522_177EntLgDsc
               THISFORM.A802PedSuc = THISFORM.Buf_W11522_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W11522_798PedEntCod
               THISFORM.A795PedFch = THISFORM.Buf_W11522_795PedFch
               THISFORM.A1076Entlg = THISFORM.Buf_W11522_1076Entlgloc
               THISFORM.A177EntLgD = THISFORM.Buf_W11522_177EntLgDsc
               X7990 = SPACE(40)
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A797PedGru
               Aux2 = THISFORM.A798PedEnt
               DO RPedEntr WITH Aux0 , Aux1 , Aux2 , X7990
               THISFORM.A2EmpCod = Aux0
               THISFORM.A797PedGru = Aux1
               THISFORM.A798PedEnt = Aux2
               THISFORM. cCW1152S19 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.A799PedEnt = X7990
               GX_SFLOAD = 0
               THISFORM.U17VW02 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11522 = Gx_err
               THISFORM.GX_DB_GetW11522_01 ()
            ENDDO
         ENDIF
