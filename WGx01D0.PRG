      PROCEDURE CreateTemp
         LOCAL SCW230S20
         SCW230S20 = ""
         IF USED( "SCW230S20" )
            SELECT SCW230S20
            SCW230S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW230S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA494V10FE"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA495V10TI"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA497V10NU"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA530V11CO"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA531V11CA"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW230S20 = GETE('z:\temp') + '\' + SCW230S20
            ENDIF
            CREATE DBF (SCW230S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW230S20) EXCLUSIVE ALIAS SCW230S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW230S20
         THIS.GX_SfAlias = "SCW230S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02302" , @HStmt_W02302 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01D0","W02302","",GX_CURSOR_TYPE_READONLY,@HStmt_W02302) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [V11UNXCAJ], [V11KGXCAJ], [V11CANCAJ], [V11CODART], [V10NUMDOC], [V10TIPDOC], "
                  cmdbuf = cmdbuf + "  [V10FECDOC] FROM [DV1100] (FASTFIRSTROW NOLOCK) WHERE ([V10FECDOC] >= ? and [V10TIPDOC] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([V10NUMDOC] like ?) AND ([V11CODART] >= ?) AND ([V11CANCAJ] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([V11UNXCAJ] >= ?) AND ([V11KGXCAJ] >= ?) ORDER BY [V10FECDOC], [V10TIPDOC], [V10NUMDOC], "
                  cmdbuf = cmdbuf + "  [V11CODART]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02302,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02302,8)
                  THISFORM.GX_DB_BindColsW02302_01 ()
                  THISFORM.GX_DB_BindParmW02302_01 ()
               ENDIF
               AuxAV21C494 = THISFORM.AV21C494
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02302,1,@AuxAV21C494,0)
               THISFORM.AV21C494 = AuxAV21C494
               AuxAV20C495 = THISFORM.AV20C495
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02302,2,@AuxAV20C495,0)
               THISFORM.AV20C495 = AuxAV20C495
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02302,3,PADR( TRIM(THISFORM.AV19C497),12, '%'),LEN(PADR( TRIM(THISFORM.AV19C497),12, '%')),0)
               AuxAV18C530 = THISFORM.AV18C530
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02302,4,@AuxAV18C530,0)
               THISFORM.AV18C530 = AuxAV18C530
               AuxAV17C531 = THISFORM.AV17C531
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02302,5,@AuxAV17C531,0)
               THISFORM.AV17C531 = AuxAV17C531
               AuxAV16C532 = THISFORM.AV16C532
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02302,6,@AuxAV16C532,0)
               THISFORM.AV16C532 = AuxAV16C532
               AuxAV15C533 = THISFORM.AV15C533
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02302,7,@AuxAV15C533,0)
               THISFORM.AV15C533 = AuxAV15C533
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02302) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02302 = Gx_err
               THISFORM.GX_DB_GetW02302_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02302 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02302) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02302 = Gx_err
                  THISFORM.GX_DB_GetW02302_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02302 <> 101
               BRKV6E2 = .F.
               THISFORM.A532V11UNX = THISFORM.Buf_W02302_532V11UNXCAJ
               THISFORM.A533V11KGX = THISFORM.Buf_W02302_533V11KGXCAJ
               THISFORM.A531V11CAN = THISFORM.Buf_W02302_531V11CANCAJ
               THISFORM.A530V11COD = THISFORM.Buf_W02302_530V11CODART
               THISFORM.A497V10NUM = THISFORM.Buf_W02302_497V10NUMDOC
               THISFORM.A495V10TIP = THISFORM.Buf_W02302_495V10TIPDOC
               THISFORM.A494V10FEC = THISFORM.Buf_W02302_494V10FECDOC
               GX_SFLOAD = 0
               THISFORM.U12V6E2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02302) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02302 = Gx_err
               THISFORM.GX_DB_GetW02302_01 ()
            ENDDO
         ENDIF
      ENDPROC
