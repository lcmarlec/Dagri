                  THISFORM.GX_DB_BindParmT011234_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011234,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
