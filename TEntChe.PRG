      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011231" , @HStmt_T011231 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTCHE","T011231","",GX_CURSOR_TYPE_READONLY,@HStmt_T011231) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [ECHNroInt], [EchCtaCod] AS EchCtaCod, [EchCtaImp] FROM [ENTCHE2] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [ECHNroInt] = ? ORDER BY [EmpCod], [ECHNroInt], "
                  cmdbuf = cmdbuf + "  [EchCtaCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011231,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011231,9)
                  THISFORM.GX_DB_BindColsT011231_01 ()
                  THISFORM.GX_DB_BindParmT011231_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011231,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               Gx_err = GX_DB_SetDouble( HStmt_T011231,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011231) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011231 = Gx_err
               THISFORM.GX_DB_GetT011231_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011231 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011231) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011231 = Gx_err
                  THISFORM.GX_DB_GetT011231_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011231 <> 101
               BRK34379 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT112S60.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011231) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011231 = Gx_err
               THISFORM.GX_DB_GetT011231_01 ()
            ENDDO
         ENDIF
      ENDPROC
