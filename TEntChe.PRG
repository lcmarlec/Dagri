      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S1083ECHNr
         LOCAL S1091EchCt
         S2EmpCod = THISFORM.A2EmpCod
         S1083ECHNr = THISFORM.A1083ECHNr
         S1091EchCt = THISFORM.A1091EchCt
         THISFORM.A1091EchCt = THISFORM.M1091EchCt
         THISFORM. cCT112S60 .SaveTemp()
         THISFORM. cCT112S60 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT112S60 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT112S60 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT112S60 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1091EchCt = THISFORM.A1091EchCt
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT112S60 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT112S60 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1091EchCt = THISFORM.A1091EchCt
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT112S60 .Refresh()
               THISFORM. cCT112S60 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1083ECHNr = S1083ECHNr
               THISFORM.A1091EchCt = S1091EchCt
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT112S60 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT112S60 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1091EchCt = THISFORM.A1091EchCt
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT112S60 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1091EchCt = THISFORM.A1091EchCt
            ENDDO
            IF sf_err != 0
               THISFORM. cCT112S60 .AppendRow()
               THISFORM. cCT112S60 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1083ECHNr = S1083ECHNr
               THISFORM.A1091EchCt = S1091EchCt
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1083ECHNr = S1083ECHNr
         THISFORM.A1091EchCt = S1091EchCt
         RETURN .F.
      ENDFUNC
