               THISFORM.A1253EchMo = AuxA1253EchMo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T011234) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011234 = Gx_err
               THISFORM.T01128 = iif( THISFORM.T011234 = 0 , 104 , THISFORM.T011234 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T011234) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
         SELECT (THISFORM. cCT112S64 .GX_SfAlias)
