      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011232" , @HStmt_T011232 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTCHE","T011232","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T011232) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ENTCHE3] ([EmpCod], [ECHNroInt], [EchMonCod], [EchMOnImp], [EchMonCot], "
                  cmdbuf = cmdbuf + "  [EchMonEgr]) VALUES (?, ?, ?, ?, ?, convert(int, 0)) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011232,cmdbuf)
                  THISFORM.GX_DB_BindParmT011232_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011232,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               Gx_err = GX_DB_SetDouble( HStmt_T011232,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               AuxA1253EchMo = THISFORM.A1253EchMo
