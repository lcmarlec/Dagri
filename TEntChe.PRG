               THISFORM.A1255EchMO = AuxA1255EchMO
               AuxA1256EchMo = THISFORM.A1256EchMo
               Gx_err = GX_DB_SetDouble( HStmt_T011232,5,@AuxA1256EchMo,0)
               THISFORM.A1256EchMo = AuxA1256EchMo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T011232) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011232 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T011232) ,  ,  ,  , CS_SQLSRV , 0 )
