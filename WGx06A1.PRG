      PROCEDURE CreateTemp
         LOCAL SCW650S20
         SCW650S20 = ""
         IF USED( "SCW650S20" )
            SELECT SCW650S20
            SCW650S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW650S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA1945CCPa"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1946CCVd"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1951CCPa"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1952CCPa"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1953CCPa"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW650S20 = GETE('z:\temp') + '\' + SCW650S20
            ENDIF
            CREATE DBF (SCW650S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW650S20) EXCLUSIVE ALIAS SCW650S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW650S20
         THIS.GX_SfAlias = "SCW650S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06502" , @HStmt_W06502 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06A1","W06502","",GX_CURSOR_TYPE_READONLY,@HStmt_W06502) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CCPagnro], [CCPagSuc], [CCPagSer], [CCPagTip], [CCVdrCod], [CCPagNI] "
                  cmdbuf = cmdbuf + "  FROM [CCPAGO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [CCPagNI] >= ? and [CCVdrCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([CCPagTip] like ?) AND ([CCPagSer] like ?) AND ([CCPagSuc] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([CCPagnro] >= ?) ORDER BY [EmpCod], [CCPagNI], [CCVdrCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06502,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06502,9)
                  THISFORM.GX_DB_BindColsW06502_01 ()
                  THISFORM.GX_DB_BindParmW06502_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06502,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C1945 = THISFORM.AV5C1945
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06502,2,@AuxAV5C1945,0)
               THISFORM.AV5C1945 = AuxAV5C1945
               AuxAV6C1946 = THISFORM.AV6C1946
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06502,3,@AuxAV6C1946,0)
               THISFORM.AV6C1946 = AuxAV6C1946
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06502,4,PADR( TRIM(THISFORM.AV7C1951),2, '%'),LEN(PADR( TRIM(THISFORM.AV7C1951),2, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06502,5,PADR( TRIM(THISFORM.AV8C1952),1, '%'),LEN(PADR( TRIM(THISFORM.AV8C1952),1, '%')),0)
               AuxAV9C1953 = THISFORM.AV9C1953
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06502,6,@AuxAV9C1953,0)
               THISFORM.AV9C1953 = AuxAV9C1953
               AuxAV10C1954 = THISFORM.AV10C1954
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06502,7,@AuxAV10C1954,0)
               THISFORM.AV10C1954 = AuxAV10C1954
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06502 = Gx_err
               THISFORM.GX_DB_GetW06502_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06502 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06502) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06502 = Gx_err
                  THISFORM.GX_DB_GetW06502_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06502 <> 101
               BRKVI22 = .F.
               THISFORM.A1954CCPag = THISFORM.Buf_W06502_1954CCPagnro
               THISFORM.A1953CCPag = THISFORM.Buf_W06502_1953CCPagSuc
               THISFORM.A1952CCPag = THISFORM.Buf_W06502_1952CCPagSer
               THISFORM.A1951CCPag = THISFORM.Buf_W06502_1951CCPagTip
               THISFORM.A1946CCVdr = THISFORM.Buf_W06502_1946CCVdrCod
               THISFORM.A1945CCPag = THISFORM.Buf_W06502_1945CCPagNI
               GX_SFLOAD = 0
               THISFORM.U12VI22 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06502 = Gx_err
               THISFORM.GX_DB_GetW06502_01 ()
            ENDDO
         ENDIF
      ENDPROC
