               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02122,5,PADR( TRIM(THISFORM.AV17C331),13, '%'),LEN(PADR( TRIM(THISFORM.AV17C331),13, '%')),0)
               AuxAV16C332 = THISFORM.AV16C332
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02122,6,@AuxAV16C332,0)
               THISFORM.AV16C332 = AuxAV16C332
               AuxAV15C333 = THISFORM.AV15C333
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02122,7,@AuxAV15C333,0)
               THISFORM.AV15C333 = AuxAV15C333
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02122 = Gx_err
               THISFORM.GX_DB_GetW02122_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02122 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02122) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02122 = Gx_err
                  THISFORM.GX_DB_GetW02122_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02122 <> 101
               BRKV5W2 = .F.
               THISFORM.A333C12IMP = THISFORM.Buf_W02122_333C12IMPORT
               THISFORM.A332C12FEC = THISFORM.Buf_W02122_332C12FECIMP
               THISFORM.A331C12NUM = THISFORM.Buf_W02122_331C12NUMIMP
               THISFORM.A330C12TIP = THISFORM.Buf_W02122_330C12TIPIMP
               THISFORM.A329C12FEC = THISFORM.Buf_W02122_329C12FECREC
               THISFORM.A328C12NUM = THISFORM.Buf_W02122_328C12NUMREC
               THISFORM.A327C12TIP = THISFORM.Buf_W02122_327C12TIPREC
               GX_SFLOAD = 0
               THISFORM.U12V5W2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02122 = Gx_err
               THISFORM.GX_DB_GetW02122_01 ()
            ENDDO
         ENDIF
      ENDPROC
