      PROCEDURE CreateTemp
         LOCAL SCW220S20
         SCW220S20 = ""
         IF USED( "SCW220S20" )
            SELECT SCW220S20
            SCW220S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW220S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA388TDcFa"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA389TDcFa"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA390TDcAr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA392TdcCn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 4

            GX_STRUCT[ 5 ,1]= "sA393TdcCn"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA2165Tdc2"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 6
            GX_STRUCT[ 6 ,4]= 3

            IF '' <> GETE('z:\temp')
               SCW220S20 = GETE('z:\temp') + '\' + SCW220S20
            ENDIF
            CREATE DBF (SCW220S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW220S20) EXCLUSIVE ALIAS SCW220S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW220S20
         THIS.GX_SfAlias = "SCW220S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02202" , @HStmt_W02202 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0122","W02202","",GX_CURSOR_TYPE_READONLY,@HStmt_W02202) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TdcNroInt], [Tdc2Desc], [TdcCntFc], [TdcCntOri], [TDcArtCod], [TDcFamSubC], "
                  cmdbuf = cmdbuf + "  [TDcFamCod] FROM [DCOI02] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [TdcNroInt] "
                  cmdbuf = cmdbuf + "  = ? and [TDcFamCod] >= ? and [TDcFamSubC] >= ? and [TDcArtCod] >= ?) AND ([TdcCntOri] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([TdcCntFc] >= ?) ORDER BY [EmpCod], [TdcNroInt], [TDcFamCod], [TDcFamSubC], "
                  cmdbuf = cmdbuf + "  [TDcArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02202,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02202,9)
                  THISFORM.GX_DB_BindColsW02202_01 ()
                  THISFORM.GX_DB_BindParmW02202_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02202,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA380TdcNro = THISFORM.A380TdcNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02202,2,@AuxA380TdcNro,0)
               THISFORM.A380TdcNro = AuxA380TdcNro
               AuxAV5C388 = THISFORM.AV5C388
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02202,3,@AuxAV5C388,0)
               THISFORM.AV5C388 = AuxAV5C388
               AuxAV6C389 = THISFORM.AV6C389
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02202,4,@AuxAV6C389,0)
               THISFORM.AV6C389 = AuxAV6C389
               AuxAV7C390 = THISFORM.AV7C390
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02202,5,@AuxAV7C390,0)
               THISFORM.AV7C390 = AuxAV7C390
               AuxAV8C392 = THISFORM.AV8C392
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02202,6,@AuxAV8C392,0)
               THISFORM.AV8C392 = AuxAV8C392
               AuxAV9C393 = THISFORM.AV9C393
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02202,7,@AuxAV9C393,0)
               THISFORM.AV9C393 = AuxAV9C393
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02202) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02202 = Gx_err
               THISFORM.GX_DB_GetW02202_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02202 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02202) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02202 = Gx_err
                  THISFORM.GX_DB_GetW02202_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02202 <> 101
               BRKV642 = .F.
               THISFORM.A2165Tdc2D = THISFORM.Buf_W02202_2165Tdc2Desc
               THISFORM.A393TdcCnt = THISFORM.Buf_W02202_393TdcCntFc
               THISFORM.A392TdcCnt = THISFORM.Buf_W02202_392TdcCntOri
               THISFORM.A390TDcArt = THISFORM.Buf_W02202_390TDcArtCod
               THISFORM.A389TDcFam = THISFORM.Buf_W02202_389TDcFamSubC
               THISFORM.A388TDcFam = THISFORM.Buf_W02202_388TDcFamCod
               GX_SFLOAD = 0
               THISFORM.U12V642 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02202) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02202 = Gx_err
               THISFORM.GX_DB_GetW02202_01 ()
            ENDDO
         ENDIF
      ENDPROC
