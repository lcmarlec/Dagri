         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE InteractiveChange
         IF .not. THISFORM. cCW220S20 .GX_rec_modif
            THISFORM. cCW220S20 .Gx_rec_modif = .T.
            THISFORM. cCW220S20 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW220S20 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW220S20 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW220S20 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.A388TDcFam = THIS.Value
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW220S20 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER OCW220.EnterKey
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
         ELSE
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            IF ! THISFORM.InRoutine("ISVALID")
               THISFORM.FormRefresh( .T. , .F. )
            ENDIF
         ENDIF
         IF gx_val_ret >= 0
            IF THIS.GX_Mouse
               THIS.GotMouseDown()
            ENDIF
            NODEFAULT
            IF gx_val_ret >= 0
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
            RETURN
         ELSE
            IF gx_val_ret = -2
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM.GX_NewLastVld != -1
            THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THISFORM. cCW220S20 .GX_focusInGrid = .T.
         THISFORM. cCW220S20 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW220A2 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A388TDcFam"
         THISFORM.cCW220S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW220S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW220S20 .GX_lastkey = 9.or. THISFORM.cCW220S20 .GX_lastkey = 13)
            IF ! THISFORM.cCW220S20 .GridValidObj( THISFORM.cCW220S20 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW220S20 .GridValidObj(THIS.GXColumnNo)
