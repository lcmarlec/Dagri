         LOCAL SCW1160S21
         SCW1160S21 = ""
         IF USED( "SCW1160S21" )
            SELECT SCW1160S21
            SCW1160S21 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1160S21
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA3365PPFc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3366PPVe"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3367PPUs"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1160S21 = GETE('z:\temp') + '\' + SCW1160S21
            ENDIF
            CREATE DBF (SCW1160S21) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1160S21) EXCLUSIVE ALIAS SCW1160S21
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1160S21
         THIS.GX_SfAlias = "SCW1160S21"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11602" , @HStmt_W11602 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPARPROD","W11602","",GX_CURSOR_TYPE_READONLY,@HStmt_W11602) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PPUV], [PPUsu], [PPVer], [PPFch] FROM [PARPROD] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ? and [PPFch] >= ?) AND ([PPUV] = 1) ORDER BY [EmpCod], [PPFch], "
                  cmdbuf = cmdbuf + "  [PPVer]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11602,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11602,7)
                  THISFORM.GX_DB_BindColsW11602_01 ()
                  THISFORM.GX_DB_BindParmW11602_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11602,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11602,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11602 = Gx_err
               THISFORM.GX_DB_GetW11602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WParProd"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11602 = Gx_err
                  THISFORM.GX_DB_GetW11602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11602 <> 101
               BRKVW82 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W11602_2EmpCod
               THISFORM.A3383PPUV = THISFORM.Buf_W11602_3383PPUV
               THISFORM.A3367PPUsu = THISFORM.Buf_W11602_3367PPUsu
               THISFORM.A3366PPVer = THISFORM.Buf_W11602_3366PPVer
               THISFORM.A3365PPFch = THISFORM.Buf_W11602_3365PPFch
               GX_SFLOAD = 0
               THISFORM.U16VW82 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11602 = Gx_err
               THISFORM.GX_DB_GetW11602_01 ()
            ENDDO
         ENDIF
      ENDPROC
