         THISFORM.AV19Lotnro = SPACE(12)
         THISFORM.AV23Lotfch = CTOD("  /  /  ")
         THISFORM.AV20Artcod = 0
         THISFORM.AV24Artdsc = SPACE(50)
         THISFORM.AV25Artcod = SPACE(15)
         THISFORM.AV26Artcnt = 0.00
         THISFORM.AV27Artcnt = 0.00
         THIS.SaveTemp()
