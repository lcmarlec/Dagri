            cmdbuf = " SELECT T1.[RILin], T1.[FamCod], T1.[FamSubCod], T1.[RINroInt], T1.[ArtCod], T2.[ArtCodBar], "
            cmdbuf = cmdbuf + "  T3.[RIEst], T3.[CRICod], T1.[RiLotFch], T2.[ArtDsc], T1.[RICnt], T1.[RiLotNro], "
