      IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R07675" , @HStmt_R07675 )
         Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RVACPEND","R07675","",GX_CURSOR_TYPE_READONLY_NOTNESTED,@HStmt_R07675) ,  ,  ,  , CS_SQLSRV ,  )
         cmdbuf = " SELECT [FerFch] FROM [FERIADOS] (NOLOCK) WHERE ([FerFch] >= ?) AND ([FerFch] <= ?) "
         cmdbuf = cmdbuf + "  ORDER BY [FerFch]  "
         Gx_err = GX_DB_Set_StmtCmdText( HStmt_R07675,cmdbuf)
         Gx_err = GX_DB_Set_StmtFetchSize( HStmt_R07675,100)
         GX_DB_BindColsR07675_01 ()
         GX_DB_BindParmR07675_01 ()
      ENDIF
      Gx_err = GX_DB_SetDate( HStmt_R07675,1,@RV14Fecha,0)
      Gx_err = GX_DB_SetDate( HStmt_R07675,2,@RV15Fin,0)
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R07675) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R07675 = Gx_err
      GX_DB_GetR07675_01 ()
      DO WHILE R07675 <> 101
         R2824FerFc = Buf_R07675_2824FerFch
         IF dow( R2824FerFc ) > 1
            AV13X = AV13X - 1
         ENDIF
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R07675) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         R07675 = Gx_err
         GX_DB_GetR07675_01 ()
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R07675) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL5 = .F.
      RV23I = AV13X / 20
      AV13X = GXFTRUNC( AV13X / 20 , 0 )
      RV23I = RV23I - AV13X
      IF RV23I > 0.8
         AV13X = AV13X + 1
      ENDIF
   ELSE
      AV13X = AV13X + AV11Ausani - year( RV14Fecha ) + ( 12 - month( RV14Fecha ) ) / 12
      DO CASE
         CASE AV13X < 5
            AV13X = 14
         CASE AV13X < 10
            AV13X = 21
         CASE AV13X < 20
            AV13X = 28
         OTHERWISE
            AV13X = 35
      ENDCASE
   ENDIF
   AV12Pend = AV12Pend + AV13X
   DO EPLB0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

