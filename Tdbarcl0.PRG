                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA256PVCodC = THISFORM.A256PVCodC
                  Gx_err = GX_DB_SetLong( HStmt_T00263,1,@AuxA256PVCodC,0)
                  THISFORM.A256PVCodC = AuxA256PVCodC
