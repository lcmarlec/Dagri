                  SELECT(gxO_Area)
                  THIS.WriteObj(THISFORM.GX_mode)
               ENDIF
            ELSE
               IF THISFORM.Gx_mode = 'INS'
                  gxO_Mode = THISFORM.Gx_mode
                  THISFORM.Gx_mode = "UPD"
                  THISFORM.LoadObj(0)
                  DO GX_ERRMW WITH "Ya existe el registro"
                  THISFORM.Gx_mode = gxO_Mode
                  RETURN .F.
               ENDIF
            ENDIF
         ELSE
            IF THISFORM.AMode .OR. THISFORM.Gx_mode = 'INS'
               THISFORM.SetMode("EOF", "1" )
               THISFORM.LoadObj(1)
               THISFORM.FormRefresh( .F. , .T. )
            ENDIF
         ENDIF
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_23insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_23insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_23insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_23insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT26A257 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_23insert = .F.
               THISFORM.gx_insert = THISFORM. gx_23insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         gx_UseTblVar = .T.
         IF gxLoadType = 2 .or. gxLoadType = 3 .or. gxLoadType = 4
            IF gxLoadType != 4
               THIS.MV( iif(gxLoadType = 2, 5, 1))
            ENDIF
            gx_lmode = THISFORM.GX_Mode
            IF THIS.MV( 6) <> 0
               IF THISFORM.AMode
                  gx_lmode = "INS"
               ENDIF
            ENDIF
            IF THISFORM.GX_curr_level = 23
               THISFORM.SaveMode( gx_lmode ,"")
            ENDIF
            gx_UseTblVar = .F.
         ELSE
            IF THISFORM.GX_curr_level = 23
               THISFORM.SetMode("EOF", "1" )
            ENDIF
         ENDIF
         IF THISFORM.Gx_mode = "INS"
            IF (( gxLoadType = 0 .or. gxLoadType = 2) .and. THISFORM.AMode ) .or. gxLoadType = 4
               THISFORM.A257PVCodA = 0
            ENDIF
         ENDIF
         IF THISFORM.Gx_mode != "INS"
            Is_updated = .F.
            GX_OLDPOS = 0
            IF gx_UseTblVar
               THISFORM.A256PVCodC = THISFORM.Buf_T00263_256PVCodCli
               THISFORM.A257PVCodA = THISFORM.Buf_T00263_257PVCodArt
            ENDIF
            IF ! THISFORM.GX_mode_not_set .and. THISFORM.GX_mode != "DLT"
            ENDIF
         ENDIF
         IF gxLoadType != 1
         ENDIF
         IF THISFORM.Gx_Refresh_grid_Att
            THISFORM.FormRefresh( .F. , .T. )
         ELSE
            THISFORM.FormRefresh( .F. , .F. )
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      PROCEDURE InteractiveChange
         THISFORM. GXInLvl23 = .T.
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA256PVCodC = THISFORM.A256PVCodC
            Gx_err = GX_DB_SetLong( HStmt_T00262,1,@AuxA256PVCodC,0)
            THISFORM.A256PVCodC = AuxA256PVCodC
            AuxA257PVCodA = THISFORM.A257PVCodA
            Gx_err = GX_DB_SetLong( HStmt_T00262,2,@AuxA257PVCodA,0)
            THISFORM.A257PVCodA = AuxA257PVCodA
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00262) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00262 = Gx_err
            THISFORM.GX_DB_GetT00262_01 ()
            IF .NOT. THISFORM.T00262 <> 103
               DO GX_ERRMW WITH "DBARCL00 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00262 = 101
               DO GX_ERRMW WITH "DBARCL00 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC
      PROCEDURE UpdObj(gxmode)
         LOCAL gxO_Area
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         THISFORM. GXInLvl23 = .T.
         THISFORM. cCT26A256 .GX_field_saved = .T.
         THISFORM. cCT26A257 .GX_field_saved = .T.
      ENDPROC

      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00264" , @HStmt_T00264 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBARCL0","T00264","",GX_CURSOR_TYPE_READONLY,@HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [PVCodCli], [PVCodArt] FROM [DBARCL00] (FASTFIRSTROW NOLOCK) WHERE [PVCodCli] "
            cmdbuf = cmdbuf + "  >= ? and [PVCodArt] >= ? ORDER BY [PVCodCli], [PVCodArt]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00264,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00264,100)
            THISFORM.GX_DB_BindColsT00264_01 ()
            THISFORM.GX_DB_BindParmT00264_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A256PVCodC = 0
                  THISFORM.A257PVCodA = 0
               ENDIF
               AuxA256PVCodC = THISFORM.A256PVCodC
               Gx_err = GX_DB_SetLong( HStmt_T00264,1,@AuxA256PVCodC,0)
               THISFORM.A256PVCodC = AuxA256PVCodC
               AuxA257PVCodA = THISFORM.A257PVCodA
               Gx_err = GX_DB_SetLong( HStmt_T00264,2,@AuxA257PVCodA,0)
               THISFORM.A257PVCodA = AuxA257PVCodA
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00264 = Gx_err
               THISFORM.GX_DB_GetT00264_01 ()
               Gx_fcond = THISFORM.T00264 <> 101
            CASE GXOP = 2 && Next record
               M257PVCodA = THISFORM.A257PVCodA
               THISFORM.A257PVCodA = 0
               AuxA256PVCodC = THISFORM.A256PVCodC
               Gx_err = GX_DB_SetLong( HStmt_T00264,1,@AuxA256PVCodC,0)
               THISFORM.A256PVCodC = AuxA256PVCodC
               AuxA257PVCodA = THISFORM.A257PVCodA
               Gx_err = GX_DB_SetLong( HStmt_T00264,2,@AuxA257PVCodA,0)
               THISFORM.A257PVCodA = AuxA257PVCodA
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00264 = Gx_err
               THISFORM.GX_DB_GetT00264_01 ()
               THISFORM.A257PVCodA = M257PVCodA
               DO WHILE THISFORM.T00264 = 0 .AND. THISFORM.A256PVCodC >= THISFORM.Buf_T00264_256PVCodCli .AND. THISFORM.A257PVCodA >= THISFORM.Buf_T00264_257PVCodArt
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00264 = Gx_err
                  THISFORM.GX_DB_GetT00264_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00264 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A256PVCodC = 0
               THISFORM.A257PVCodA = 0
               AuxA256PVCodC = THISFORM.A256PVCodC
               Gx_err = GX_DB_SetLong( HStmt_T00264,1,@AuxA256PVCodC,0)
               THISFORM.A256PVCodC = AuxA256PVCodC
               AuxA257PVCodA = THISFORM.A257PVCodA
               Gx_err = GX_DB_SetLong( HStmt_T00264,2,@AuxA257PVCodA,0)
               THISFORM.A257PVCodA = AuxA257PVCodA
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00264 = Gx_err
               THISFORM.GX_DB_GetT00264_01 ()
               DO WHILE THISFORM.T00264 = 0
                  THISFORM.A256PVCodC = THISFORM.Buf_T00264_256PVCodCli
                  THISFORM.A257PVCodA = THISFORM.Buf_T00264_257PVCodArt
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00264 = Gx_err
                  THISFORM.GX_DB_GetT00264_01 ()
               ENDDO
               AuxA256PVCodC = THISFORM.A256PVCodC
               Gx_err = GX_DB_SetLong( HStmt_T00264,1,@AuxA256PVCodC,0)
               THISFORM.A256PVCodC = AuxA256PVCodC
               AuxA257PVCodA = THISFORM.A257PVCodA
               Gx_err = GX_DB_SetLong( HStmt_T00264,2,@AuxA257PVCodA,0)
               THISFORM.A257PVCodA = AuxA257PVCodA
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00264) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00264 = Gx_err
               THISFORM.GX_DB_GetT00264_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A256PVCodC = THISFORM.Buf_T00264_256PVCodCli
               THISFORM.A257PVCodA = THISFORM.Buf_T00264_257PVCodArt
         ENDCASE
         Gx_fcond = THISFORM.T00264 <> 101 .AND. THISFORM.T00264 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

