      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00265" , @HStmt_T00265 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBARCL0","T00265","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00265) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [DBARCL00] ([PVCodCli], [PVCodArt]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00265,cmdbuf)
                  THISFORM.GX_DB_BindParmT00265_01 ()
               ENDIF
               AuxA256PVCodC = THISFORM.A256PVCodC
               Gx_err = GX_DB_SetLong( HStmt_T00265,1,@AuxA256PVCodC,0)
               THISFORM.A256PVCodC = AuxA256PVCodC
               AuxA257PVCodA = THISFORM.A257PVCodA
               Gx_err = GX_DB_SetLong( HStmt_T00265,2,@AuxA257PVCodA,0)
               THISFORM.A257PVCodA = AuxA257PVCodA
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00265) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00265 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00265) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00265 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00266" , @HStmt_T00266 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBARCL0","T00266","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00266) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [DBARCL00]  WHERE [PVCodCli] = ? AND [PVCodArt] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00266,cmdbuf)
                  THISFORM.GX_DB_BindParmT00266_01 ()
               ENDIF
               AuxA256PVCodC = THISFORM.A256PVCodC
               Gx_err = GX_DB_SetLong( HStmt_T00266,1,@AuxA256PVCodC,0)
               THISFORM.A256PVCodC = AuxA256PVCodC
               AuxA257PVCodA = THISFORM.A257PVCodA
               Gx_err = GX_DB_SetLong( HStmt_T00266,2,@AuxA257PVCodA,0)
               THISFORM.A257PVCodA = AuxA257PVCodA
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00266) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00266 = Gx_err
               THISFORM.T00262 = iif( THISFORM.T00266 = 0 , 104 , THISFORM.T00266 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00266) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
