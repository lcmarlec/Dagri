                  Gx_err = GX_DB_SetLong( HStmt_T00263,2,@AuxA257PVCodA,0)
                  THISFORM.A257PVCodA = AuxA257PVCodA
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00263) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00263 = Gx_err
                  THISFORM.GX_DB_GetT00263_01 ()
                  THISFORM. cCT26A257 . ZM0Q23 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0Q23 ()
               THISFORM. cCT26A257 . ZM0Q23 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0Q23 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT26A257 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0Q23 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0Q23 ()
                  RETURN
               ENDIF
               THISFORM.cCT26A257.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00263) , "TDBARCL0" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00262) , "TDBARCL0" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT26A257 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT26A256 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

