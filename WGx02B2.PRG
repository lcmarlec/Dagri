      PROCEDURE CreateTemp
         LOCAL SCW261S20
         SCW261S20 = ""
         IF USED( "SCW261S20" )
            SELECT SCW261S20
            SCW261S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW261S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA736OpeLi"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA737OpeCn"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA740OpeCp"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 2
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW261S20 = GETE('z:\temp') + '\' + SCW261S20
            ENDIF
            CREATE DBF (SCW261S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW261S20) EXCLUSIVE ALIAS SCW261S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW261S20
         THIS.GX_SfAlias = "SCW261S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02612" , @HStmt_W02612 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02B2","W02612","",GX_CURSOR_TYPE_READONLY,@HStmt_W02612) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [OpeNroInt], [OpeCprGRT], [OpeCnt], [ArtCod], [FamSubCod], [FamCod], "
                  cmdbuf = cmdbuf + "  [OpeLin] FROM [OPEDIS1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [OpeNroInt] "
                  cmdbuf = cmdbuf + "  = ? and [OpeLin] >= ?) AND ([FamCod] >= ?) AND ([FamSubCod] >= ?) AND ([ArtCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([OpeCnt] >= ?) ORDER BY [EmpCod], [OpeNroInt], [OpeLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02612,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02612,8)
                  THISFORM.GX_DB_BindColsW02612_01 ()
                  THISFORM.GX_DB_BindParmW02612_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02612,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA731OpeNro = THISFORM.A731OpeNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02612,2,@AuxA731OpeNro,0)
               THISFORM.A731OpeNro = AuxA731OpeNro
               AuxAV19C736 = THISFORM.AV19C736
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02612,3,@AuxAV19C736,0)
               THISFORM.AV19C736 = AuxAV19C736
               AuxAV18C3 = THISFORM.AV18C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02612,4,@AuxAV18C3,0)
               THISFORM.AV18C3 = AuxAV18C3
               AuxAV17C4 = THISFORM.AV17C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02612,5,@AuxAV17C4,0)
               THISFORM.AV17C4 = AuxAV17C4
               AuxAV16C5 = THISFORM.AV16C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02612,6,@AuxAV16C5,0)
               THISFORM.AV16C5 = AuxAV16C5
               AuxAV15C737 = THISFORM.AV15C737
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02612,7,@AuxAV15C737,0)
               THISFORM.AV15C737 = AuxAV15C737
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02612) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02612 = Gx_err
               THISFORM.GX_DB_GetW02612_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02612 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02612) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02612 = Gx_err
                  THISFORM.GX_DB_GetW02612_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02612 <> 101
               BRKV792 = .F.
               THISFORM.A740OpeCpr = THISFORM.Buf_W02612_740OpeCprGRT
               THISFORM.A737OpeCnt = THISFORM.Buf_W02612_737OpeCnt
               THISFORM.A5ArtCod = THISFORM.Buf_W02612_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W02612_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W02612_3FamCod
               THISFORM.A736OpeLin = THISFORM.Buf_W02612_736OpeLin
               GX_SFLOAD = 0
               THISFORM.U12V792 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02612) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02612 = Gx_err
               THISFORM.GX_DB_GetW02612_01 ()
            ENDDO
         ENDIF
      ENDPROC
