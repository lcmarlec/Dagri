         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12563" , @HStmt_W12563 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESPA1","W12563","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W12563) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[EmpCod], T1.[RutCod], T2.[ChfNom] AS RutChfNom, T1.[RutChfCod] AS RutChfCod "
            cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
            cmdbuf = cmdbuf + "  AND T2.[ChfCod] = T1.[RutChfCod]) WHERE T1.[EmpCod] = ? and T1.[RutCod] = ? ORDER "
            cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[RutCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12563,cmdbuf)
            THISFORM.GX_DB_BindColsW12563_01 ()
            THISFORM.GX_DB_BindParmW12563_01 ()
         ENDIF
         AuxAV7Emprcod = THISFORM.AV7Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12563,1,@AuxAV7Emprcod,0)
         THISFORM.AV7Emprcod = AuxAV7Emprcod
