      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12562" , @HStmt_W12562 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESPA1","W12562","",GX_CURSOR_TYPE_READONLY,@HStmt_W12562) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[PedEst], T1.[PedSec], T1.[PedGruTip] AS PedGruTip, T1.[PedFch], T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[PedNro], T1.[PedCarNro], T1.[PedOrd12], T1.[PedCarFch], T1.[PedNroFac], T1.[PedSucFac], "
                  cmdbuf = cmdbuf + "  T1.[PedNroRto], T1.[PedSucRto], T2.[Entlgloc], T2.[EntLgDsc], T1.[PedSucCod] AS "
                  cmdbuf = cmdbuf + "  PedSucCod, T1.[PedEntCod] AS PedEntCod FROM ([PEDIDO1] T1 (NOLOCK) LEFT JOIN [CLTES] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[PedGruTip] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[PedEst] >= 1) AND (T1.[PedCarFch] = ?) AND (T1.[PedEst] < 9) AND (T1.[PedCarNro] "
                  cmdbuf = cmdbuf + "  = ?) ORDER BY T1.[EmpCod], T1.[PedFch], T1.[PedGruTip], T1.[PedEntCod], T1.[PedSucCod], "
                  cmdbuf = cmdbuf + "  T1.[PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12562,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12562,19)
                  THISFORM.GX_DB_BindColsW12562_01 ()
                  THISFORM.GX_DB_BindParmW12562_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12562,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV37Carfch = THISFORM.AV37Carfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12562,2,@AuxAV37Carfch,0)
               THISFORM.AV37Carfch = AuxAV37Carfch
               AuxAV34Pedcar = THISFORM.AV34Pedcar
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12562,3,AuxAV34Pedcar,15,0)
               THISFORM.AV34Pedcar = AuxAV34Pedcar
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12562) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12562 = Gx_err
               THISFORM.GX_DB_GetW12562_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV52Pgmnam = "WDespa1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12562 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12562) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12562 = Gx_err
                  THISFORM.GX_DB_GetW12562_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12562 <> 101
               BRKVYW2 = .F.
               THISFORM.AV14Sel = 0
               THISFORM.A826PedEst = THISFORM.Buf_W12562_826PedEst
               THISFORM.A809PedSec = THISFORM.Buf_W12562_809PedSec
               THISFORM.A797PedGru = THISFORM.Buf_W12562_797PedGruTip
               THISFORM.A795PedFch = THISFORM.Buf_W12562_795PedFch
               THISFORM.A2EmpCod = THISFORM.Buf_W12562_2EmpCod
               THISFORM.A796PedNro = THISFORM.Buf_W12562_796PedNro
               THISFORM.A3360PedCa = THISFORM.Buf_W12562_3360PedCarNro
               THISFORM.A2497PedOr = THISFORM.Buf_W12562_2497PedOrd12
               THISFORM.A3362PedCa = THISFORM.Buf_W12562_3362PedCarFch
               THISFORM.A829PedNro = THISFORM.Buf_W12562_829PedNroFac
               THISFORM.A828PedSuc = THISFORM.Buf_W12562_828PedSucFac
               THISFORM.A831PedNro = THISFORM.Buf_W12562_831PedNroRto
               THISFORM.A830PedSuc = THISFORM.Buf_W12562_830PedSucRto
               THISFORM.A1076Entlg = THISFORM.Buf_W12562_1076Entlgloc
               THISFORM.A177EntLgD = THISFORM.Buf_W12562_177EntLgDsc
               THISFORM.A802PedSuc = THISFORM.Buf_W12562_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W12562_798PedEntCod
               THISFORM.A1076Entlg = THISFORM.Buf_W12562_1076Entlgloc
               THISFORM.A177EntLgD = THISFORM.Buf_W12562_177EntLgDsc
               X7990 = SPACE(40)
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A797PedGru
               Aux2 = THISFORM.A798PedEnt
               DO RPedEntr WITH Aux0 , Aux1 , Aux2 , X7990
               THISFORM.A2EmpCod = Aux0
               THISFORM.A797PedGru = Aux1
               THISFORM.A798PedEnt = Aux2
               THISFORM. cCW1256S28 .RestoreGridPos()
               GX_rploop = .T.
