         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12563,2,@AuxAV19Pednro,0)
         THISFORM.AV19Pednro = AuxAV19Pednro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12563) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W12563 = Gx_err
         THISFORM.GX_DB_GetW12563_01 ()
         DO WHILE THISFORM.W12563 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W12563_2EmpCod
            THISFORM.A966RutCod = THISFORM.Buf_W12563_966RutCod
            THISFORM.A1217RutCh = THISFORM.Buf_W12563_1217RutChfNom
            THISFORM.A1216RutCh = THISFORM.Buf_W12563_1216RutChfCod
            THISFORM.A1217RutCh = THISFORM.Buf_W12563_1217RutChfNom
            THISFORM.AV20Chofer = THISFORM.A1217RutCh
            THISFORM.AV22Rutchf = THISFORM.A1216RutCh
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W12563) ,  ,  ,  , CS_SQLSRV ,  )
