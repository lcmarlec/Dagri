               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11752 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11752) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11752 = Gx_err
                  THISFORM.GX_DB_GetW11752_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11752 <> 101
               BRKVWN2 = .F.
               THISFORM.A3396CArri = THISFORM.Buf_W11752_3396CArriTraz
