               AuxAV11C3347 = THISFORM.AV11C3347
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11752,7,@AuxAV11C3347,0)
               THISFORM.AV11C3347 = AuxAV11C3347
               Gx_eop = 1
