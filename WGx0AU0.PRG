                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0AU0","W11752","",GX_CURSOR_TYPE_READONLY,@HStmt_W11752) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CArriTraz], [ArtCod], [FamSubCod], [FamCod], [CarPedSec], [CarpedSuc], [CarPedInd], "
                  cmdbuf = cmdbuf + "  [CarPedEnt], [CarPedGruT], [CarPedFch], [CarPedCar], [EmpCod] FROM [CARPED2] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ?) AND ([CarPedCar] like ?) AND ([CarPedFch] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([CarPedGruT] like ?) AND ([CarPedEnt] >= ?) AND ([CarpedSuc] >= ?) AND ([CarPedSec] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [CarPedCar], [CarPedFch], [CarPedGruT], [CarPedEnt], [CarpedSuc], "
                  cmdbuf = cmdbuf + "  [CarPedSec], [CarPedInd], [FamCod], [FamSubCod], [ArtCod], [CArriTraz]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11752,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11752,9)
                  THISFORM.GX_DB_BindColsW11752_01 ()
                  THISFORM.GX_DB_BindParmW11752_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11752,1,@AuxAV5C2,0)
