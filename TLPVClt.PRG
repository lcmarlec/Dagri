                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T018917) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T018917 = Gx_err
                  THISFORM.GX_DB_GetT018917_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T018917 <> 101
               BRK59217 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT189S11.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T018917) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T018917 = Gx_err
               THISFORM.GX_DB_GetT018917_01 ()
            ENDDO
         ENDIF
      ENDPROC
