         ENDIF
         IF ! THISFORM. cCT189S11 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT189S11 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S836PlVGru = THISFORM.A836PlVGru .AND. S837PlVEnt = THISFORM.A837PlVEnt .AND. S1855LpvFc = THISFORM.A1855LpvFc .AND. S3FamCod = THISFORM.A3FamCod
