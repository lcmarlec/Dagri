            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10832 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10832) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10832 = Gx_err
                  THISFORM.GX_DB_GetW10832_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10832 <> 101
               BRKVU32 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W10832_2EmpCod
               THISFORM.A1462FamCo = THISFORM.Buf_W10832_1462FamCodS
               THISFORM.A1463FamSu = THISFORM.Buf_W10832_1463FamSubCodS
               THISFORM.A1461ArtCo = THISFORM.Buf_W10832_1461ArtCodS
               THISFORM.A3168ArtDu = THISFORM.Buf_W10832_3168ArtDum14
               THISFORM.A24ArtCpr = THISFORM.Buf_W10832_24ArtCpr
               THISFORM.A28ArtVta = THISFORM.Buf_W10832_28ArtVta
               THISFORM.A6ArtDsc = THISFORM.Buf_W10832_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W10832_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W10832_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W10832_3FamCod
               GX_SFLOAD = 0
               THISFORM.U14VU32 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10832) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10832 = Gx_err
               THISFORM.GX_DB_GetW10832_01 ()
            ENDDO
         ENDIF
      ENDPROC
