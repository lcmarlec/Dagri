               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06422" , @HStmt_W06422 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPROTOK","W06422","",GX_CURSOR_TYPE_READONLY,@HStmt_W06422) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ROREntGruT] AS ROREntGruT, T1.[RORNroInt], T1.[ROREntCod] AS ROREntCod, "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T1.[RORNroCtr], T1.[RorProtSN], T1.[ROREst], T1.[RorProtOK], T2.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS ROREntRaz, T1.[RORFch], T1.[RORNro], T1.[RORSuc], T1.[RorfchRec] FROM ([REMING] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[ROREntGruT] AND T2.[EntCod] = T1.[ROREntCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[RORNro] >= ?) AND (T1.[RORSuc] = ? or ? = 0) AND (T1.[ROREst] < 9) AND "
                  cmdbuf = cmdbuf + "  (T1.[RorProtOK] = ? or ? = 'T') AND (T1.[RorProtSN] = 'S') AND (T1.[ROREntCod] = "
                  cmdbuf = cmdbuf + "  ? or ? = 0) ORDER BY T1.[EmpCod], T1.[RORNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06422,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06422,16)
                  THISFORM.GX_DB_BindColsW06422_01 ()
                  THISFORM.GX_DB_BindParmW06422_01 ()
