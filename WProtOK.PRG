                  DO WHILE THISFORM.W06423 <> 101
                     THISFORM.A346DcCNro = THISFORM.Buf_W06423_346DcCNroInt
                     THISFORM.A354DcCROR = THISFORM.Buf_W06423_354DcCRORNroI
