                     cmdbuf = " SELECT T1.[DcCNroInt], T1.[EmpCod], T1.[DcCRORNroI], T2.[DcCTip] FROM ([DCCOM1] T1 "
                     cmdbuf = cmdbuf + "  (NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[DcCNroInt] "
                     cmdbuf = cmdbuf + "  = T1.[DcCNroInt]) WHERE (T1.[EmpCod] = ? and T1.[DcCRORNroI] = ?) AND (T2.[DcCTip] "
                     cmdbuf = cmdbuf + "  = 'FC02') ORDER BY T1.[EmpCod], T1.[DcCRORNroI]  "
