               OTHERWISE
                  RV30Import[5] = RV30Import[5] + R996TesImp * RV35Dccsig
            ENDCASE
         CASE R989TesMed = 4 .OR. R989TesMed = 18
            RV30Import[11] = RV30Import[11] + R996TesImp * RV35Dccsig
         CASE R989TesMed = 5 .OR. R989TesMed = 11 .OR. R989TesMed = 60
