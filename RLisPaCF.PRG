   DO WHILE R02033 <> 101
      R2EmpCod = Buf_R02033_2EmpCod
      R985TesNro = Buf_R02033_985TesNroI
      R989TesMed = Buf_R02033_989TesMedCod
      R1007TesMo = Buf_R02033_1007TesMonCod
      R996TesImp = Buf_R02033_996TesImp
      DO CASE
         CASE R989TesMed = 1 .OR. R989TesMed = 50 .OR. R989TesMed = 101
            DO CASE
               CASE R1007TesMo = 1 .OR. R1007TesMo = 0
                  RV30Import[1] = RV30Import[1] + R996TesImp * RV35Dccsig
               CASE R1007TesMo = 3
                  RV30Import[2] = RV30Import[2] + R996TesImp * RV35Dccsig
               CASE R1007TesMo = 4
                  RV30Import[3] = RV30Import[3] + R996TesImp * RV35Dccsig
               CASE R1007TesMo = 5
