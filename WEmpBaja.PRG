               THISFORM.AV26Tracui = AuxAV26Tracui
               AuxAV27Tradni = THISFORM.AV27Tradni
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12292,7,@AuxAV27Tradni,0)
               THISFORM.AV27Tradni = AuxAV27Tradni
               AuxAV27Tradni = THISFORM.AV27Tradni
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12292,8,@AuxAV27Tradni,0)
               THISFORM.AV27Tradni = AuxAV27Tradni
               AuxAV31Eecod = THISFORM.AV31Eecod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12292,9,@AuxAV31Eecod,0)
               THISFORM.AV31Eecod = AuxAV31Eecod
               AuxAV31Eecod = THISFORM.AV31Eecod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12292,10,@AuxAV31Eecod,0)
               THISFORM.AV31Eecod = AuxAV31Eecod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12292 = Gx_err
               THISFORM.GX_DB_GetW12292_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV36Pgmnam = "WEmpBaja"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12292 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12292) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12292 = Gx_err
                  THISFORM.GX_DB_GetW12292_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12292 <> 101
               BRKVY52 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W12292_2EmpCod
               THISFORM.A2281EEDsc = THISFORM.Buf_W12292_2281EEDsc
               THISFORM.A2280EECod = THISFORM.Buf_W12292_2280EECod
               THISFORM.A2286TraDN = THISFORM.Buf_W12292_2286TraDNI
               THISFORM.A565TraObs = THISFORM.Buf_W12292_565TraObs
               THISFORM.A562TraCui = THISFORM.Buf_W12292_562TraCui
               THISFORM.A566TraTel = THISFORM.Buf_W12292_566TraTel
               THISFORM.A563TraDir = THISFORM.Buf_W12292_563TraDir
               THISFORM.A2291TraFE = THISFORM.Buf_W12292_2291TraFEgr
               THISFORM.A564TraNom = THISFORM.Buf_W12292_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W12292_561TraCod
               THISFORM.A2281EEDsc = THISFORM.Buf_W12292_2281EEDsc
               GX_SFLOAD = 0
               THISFORM.U21VY52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12292 = Gx_err
               THISFORM.GX_DB_GetW12292_01 ()
            ENDDO
         ENDIF
      ENDPROC
