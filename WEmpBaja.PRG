               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12292,3,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12292,4,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV26Tracui = THISFORM.AV26Tracui
