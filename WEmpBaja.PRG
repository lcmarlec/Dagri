      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12292" , @HStmt_W12292 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMPBAJA","W12292","",GX_CURSOR_TYPE_READONLY,@HStmt_W12292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T2.[EEDsc], T1.[EECod], T1.[TraDNI], T1.[TraObs], T1.[TraCui], "
                  cmdbuf = cmdbuf + "  T1.[TraTel], T1.[TraDir], T1.[TraFEgr], T1.[TraNom], T1.[TraCod] FROM ([EMPLEADO] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EMPEMP] T2 (NOLOCK) ON T2.[EECod] = T1.[EECod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ?) AND (UPPER(T1.[TraNom]) like UPPER(?)) AND (T1.[TraCod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) AND (T1.[TraCui] = ? or ? = 0) AND (T1.[TraDNI] = ? or ? = 0) AND "
                  cmdbuf = cmdbuf + "  (T1.[TraFEgr] <> convert( DATETIME, '17530101', 112 )) AND (T1.[EECod] = ? or ? "
                  cmdbuf = cmdbuf + "  = 0) ORDER BY T1.[EmpCod], T1.[TraNom]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12292,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12292,17)
                  THISFORM.GX_DB_BindColsW12292_01 ()
                  THISFORM.GX_DB_BindParmW12292_01 ()
               ENDIF
