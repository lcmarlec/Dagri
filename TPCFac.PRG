      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03017" , @HStmt_T03017 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPCFAC","T03017","",GX_CURSOR_TYPE_READONLY,@HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [PCNroInt] FROM [PERCOM] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] >= "
            cmdbuf = cmdbuf + "  ? and [PCNroInt] >= ? ORDER BY [EmpCod], [PCNroInt]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03017,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T03017,100)
            THISFORM.GX_DB_BindColsT03017_01 ()
            THISFORM.GX_DB_BindParmT03017_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2EmpCod = 0
                  THISFORM.A2870PCNro = 0
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03017,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2870PCNro = THISFORM.A2870PCNro
               Gx_err = GX_DB_SetDouble( HStmt_T03017,2,@AuxA2870PCNro,0)
               THISFORM.A2870PCNro = AuxA2870PCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03017 = Gx_err
               THISFORM.GX_DB_GetT03017_01 ()
               Gx_fcond = THISFORM.T03017 <> 101
            CASE GXOP = 2 && Next record
               M2870PCNro = THISFORM.A2870PCNro
               THISFORM.A2870PCNro = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03017,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2870PCNro = THISFORM.A2870PCNro
               Gx_err = GX_DB_SetDouble( HStmt_T03017,2,@AuxA2870PCNro,0)
               THISFORM.A2870PCNro = AuxA2870PCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03017 = Gx_err
               THISFORM.GX_DB_GetT03017_01 ()
               THISFORM.A2870PCNro = M2870PCNro
               DO WHILE THISFORM.T03017 = 0 .AND. THISFORM.A2EmpCod >= THISFORM.Buf_T03017_2EmpCod .AND. THISFORM.A2870PCNro >= THISFORM.Buf_T03017_2870PCNroInt
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03017 = Gx_err
                  THISFORM.GX_DB_GetT03017_01 ()
               ENDDO
               Gx_fcond = THISFORM.T03017 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2EmpCod = 0
               THISFORM.A2870PCNro = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03017,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2870PCNro = THISFORM.A2870PCNro
               Gx_err = GX_DB_SetDouble( HStmt_T03017,2,@AuxA2870PCNro,0)
               THISFORM.A2870PCNro = AuxA2870PCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03017 = Gx_err
               THISFORM.GX_DB_GetT03017_01 ()
               DO WHILE THISFORM.T03017 = 0
                  THISFORM.A2EmpCod = THISFORM.Buf_T03017_2EmpCod
                  THISFORM.A2870PCNro = THISFORM.Buf_T03017_2870PCNroInt
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03017 = Gx_err
                  THISFORM.GX_DB_GetT03017_01 ()
               ENDDO
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03017,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2870PCNro = THISFORM.A2870PCNro
               Gx_err = GX_DB_SetDouble( HStmt_T03017,2,@AuxA2870PCNro,0)
               THISFORM.A2870PCNro = AuxA2870PCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03017) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03017 = Gx_err
               THISFORM.GX_DB_GetT03017_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2EmpCod = THISFORM.Buf_T03017_2EmpCod
               THISFORM.A2870PCNro = THISFORM.Buf_T03017_2870PCNroInt
         ENDCASE
         Gx_fcond = THISFORM.T03017 <> 101 .AND. THISFORM.T03017 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

