      PROCEDURE CreateTemp
         LOCAL SCT301S14
         SCT301S14 = ""
         IF USED( "SCT301S14" )
            SELECT SCT301S14
            SCT301S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT301S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA2884PCDC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2885PCDC"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2886PCDC"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2887PCDC"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2888PCDC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2889PCDC"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 9
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA2890PCDC"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT301S14 = GETE('z:\temp') + '\' + SCT301S14
            ENDIF
            CREATE DBF (SCT301S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCT301S14) EXCLUSIVE ALIAS SCT301S14
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT301S14
         THIS.GX_SfAlias = "SCT301S14"
      ENDPROC
