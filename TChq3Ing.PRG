      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S98TChqNro
         LOCAL S101TChqLi
         S2EmpCod = THISFORM.A2EmpCod
         S98TChqNro = THISFORM.A98TChqNro
         S101TChqLi = THISFORM.A101TChqLi
         THISFORM.A101TChqLi = THISFORM.M101TChqLi
         THISFORM. cCT14S13 .SaveTemp()
         THISFORM. cCT14S13 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT14S13 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT14S13 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT14S13 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT14S13 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT14S13 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT14S13 .Refresh()
               THISFORM. cCT14S13 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A98TChqNro = S98TChqNro
               THISFORM.A101TChqLi = S101TChqLi
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT14S13 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT14S13 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT14S13 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S98TChqNro = THISFORM.A98TChqNro .AND. S101TChqLi = THISFORM.A101TChqLi
            ENDDO
            IF sf_err != 0
               THISFORM. cCT14S13 .AppendRow()
               THISFORM. cCT14S13 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A98TChqNro = S98TChqNro
               THISFORM.A101TChqLi = S101TChqLi
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A98TChqNro = S98TChqNro
         THISFORM.A101TChqLi = S101TChqLi
         RETURN .F.
      ENDFUNC
