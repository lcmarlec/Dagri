         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T001418" , @HStmt_T001418 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCHQ3ING","T001418","",GX_CURSOR_TYPE_READONLY,@HStmt_T001418) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TChqNroI], [TChqLin], [TChqCliGrT] AS TChqCliGrT, [TChqCliCod] "
                  cmdbuf = cmdbuf + "  AS TChqCliCod, [TChqNroReg], [TChqTit], [TChqMonCod] AS TChqMonCod, [TChqNoO], [TChqBcoCod] "
                  cmdbuf = cmdbuf + "  AS TChqBcoCod, [TChqSuc], [TChqNro], [TChqImp], [TChqFchDeb], [TChqCotImp], [TChqCP] "
                  cmdbuf = cmdbuf + "  FROM [TCHQS1] (NOLOCK) WHERE [EmpCod] = ? AND [TChqNroI] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [TChqNroI], [TChqLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T001418,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T001418,14)
                  THISFORM.GX_DB_BindColsT001418_01 ()
                  THISFORM.GX_DB_BindParmT001418_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T001418,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA98TChqNro = THISFORM.A98TChqNro
               Gx_err = GX_DB_SetDouble( HStmt_T001418,2,@AuxA98TChqNro,0)
               THISFORM.A98TChqNro = AuxA98TChqNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T001418) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T001418 = Gx_err
               THISFORM.GX_DB_GetT001418_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T001418 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T001418) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T001418 = Gx_err
                  THISFORM.GX_DB_GetT001418_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T001418 <> 101
               BRK0E13 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
