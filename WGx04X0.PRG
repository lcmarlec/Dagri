      PROCEDURE CreateTemp
         LOCAL SCW503S20
         SCW503S20 = ""
         IF USED( "SCW503S20" )
            SELECT SCW503S20
            SCW503S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW503S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1529DifN"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1544DifT"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1530DifF"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1531DifF"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1535DifN"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW503S20 = GETE('z:\temp') + '\' + SCW503S20
            ENDIF
            CREATE DBF (SCW503S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW503S20) EXCLUSIVE ALIAS SCW503S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW503S20
         THIS.GX_SfAlias = "SCW503S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05032" , @HStmt_W05032 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04X0","W05032","",GX_CURSOR_TYPE_READONLY,@HStmt_W05032) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DifLin], [DifArtCod], [DifNC], [DifFamSCod], [DifFamCod], [DifTpo], [DifNI], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [DIFER] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [DifNI] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([DifTpo] like ?) AND ([DifFamCod] >= ?) AND ([DifFamSCod] >= ?) AND ([DifArtCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([DifLin] >= ?) ORDER BY [EmpCod], [DifNI], [DifTpo], [DifFamCod], [DifFamSCod], "
                  cmdbuf = cmdbuf + "  [DifArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05032,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05032,8)
                  THISFORM.GX_DB_BindColsW05032_01 ()
                  THISFORM.GX_DB_BindParmW05032_01 ()
               ENDIF
               AuxAV21C2 = THISFORM.AV21C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05032,1,@AuxAV21C2,0)
               THISFORM.AV21C2 = AuxAV21C2
               AuxAV20C1529 = THISFORM.AV20C1529
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05032,2,@AuxAV20C1529,0)
               THISFORM.AV20C1529 = AuxAV20C1529
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05032,3,PADR( TRIM(THISFORM.AV19C1544),2, '%'),LEN(PADR( TRIM(THISFORM.AV19C1544),2, '%')),0)
               AuxAV18C1530 = THISFORM.AV18C1530
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05032,4,@AuxAV18C1530,0)
               THISFORM.AV18C1530 = AuxAV18C1530
               AuxAV17C1531 = THISFORM.AV17C1531
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05032,5,@AuxAV17C1531,0)
               THISFORM.AV17C1531 = AuxAV17C1531
               AuxAV16C1532 = THISFORM.AV16C1532
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05032,6,@AuxAV16C1532,0)
               THISFORM.AV16C1532 = AuxAV16C1532
               AuxAV15C1543 = THISFORM.AV15C1543
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05032,7,@AuxAV15C1543,0)
               THISFORM.AV15C1543 = AuxAV15C1543
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05032 = Gx_err
               THISFORM.GX_DB_GetW05032_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05032 = Gx_err
                  THISFORM.GX_DB_GetW05032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05032 <> 101
               BRKVDZ2 = .F.
               THISFORM.A1543DifLi = THISFORM.Buf_W05032_1543DifLin
               THISFORM.A1532DifAr = THISFORM.Buf_W05032_1532DifArtCod
               THISFORM.A1535DifNC = THISFORM.Buf_W05032_1535DifNC
               THISFORM.A1531DifFa = THISFORM.Buf_W05032_1531DifFamSCod
               THISFORM.A1530DifFa = THISFORM.Buf_W05032_1530DifFamCod
               THISFORM.A1544DifTp = THISFORM.Buf_W05032_1544DifTpo
               THISFORM.A1529DifNI = THISFORM.Buf_W05032_1529DifNI
               THISFORM.A2EmpCod = THISFORM.Buf_W05032_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VDZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05032 = Gx_err
               THISFORM.GX_DB_GetW05032_01 ()
            ENDDO
         ENDIF
      ENDPROC
