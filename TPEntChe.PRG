      PROCEDURE CreateTemp
         LOCAL SCT111S14
         SCT111S14 = ""
         IF USED( "SCT111S14" )
            SELECT SCT111S14
            SCT111S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT111S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA1080PenC"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1081PenC"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT111S14 = GETE('z:\temp') + '\' + SCT111S14
            ENDIF
            CREATE DBF (SCT111S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCT111S14) EXCLUSIVE ALIAS SCT111S14
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT111S14
         THIS.GX_SfAlias = "SCT111S14"
      ENDPROC
