      ENDPROC
      PROCEDURE InitLevel
         LPARAMETER gxILvl
         LOCAL gx_oMode
         IF gxILvl != 118
            RETURN .T.
         ENDIF
         GX_lastvld = 0
         THISFORM.gx_lastvld = THIS.GxObjOrder-1
         RETURN .T.
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl = 118
            IF ! THISFORM. gx_118insert
               THISFORM.SetLevel( 118 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 118
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 118 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01116) , "TPENTCHE" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01115) , "TPENTCHE" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01113) , "TPENTCHE" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01112) , "TPENTCHE" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01117) , "TPENTCHE" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01114) , "TPENTCHE" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT111A3065 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 118
            IF ! THISFORM. gx_118insert
               THISFORM.SetLevel( 118 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_118insert
            THISFORM. gx_118insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 118 )
            THISFORM. cCT111A1078 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         gx_old_mode = THISFORM.GX_Mode
         IF THISFORM.GX_Mode = "DSP"
            THISFORM.GX_Mode = "UPD"
         ENDIF
         THIS.GX_noacc_cond = .F.
         IF THISFORM.Gx_mode = 'DLT' .OR. THISFORM.Gx_mode = 'UPD'
            THISFORM. GXInLvl118 = .T.
            THIS.GX_noacc_cond = .T.
         ENDIF
         THISFORM.GX_Mode = gx_old_mode
         IF THIS.GX_noacc_cond
            IF ! THIS.ValidObj()
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled( THIS.TabIndex, -1, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               THISFORM.gx_lastvld = THIS.GxObjOrder
            ENDIF
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 118
            THISFORM.SetLevel( 118 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT111A1078 .InitLevel( 118 )
            THISFORM.GX_last_fld_lvl = 118
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A1078PenMo"
         THIS.GXGotFocus()
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         IF THIS.GX_noacc_cond
            NODEFAULT
            IF LASTKEY() = 19 .or. LASTKEY() = 15
               THISFORM.SetFocusEnabled( THIS.TabIndex, -1,-1, .T., .T., .F.)
            ELSE
               THISFORM.SetFocusEnabled( THIS.TabIndex, +1,+1, .T., .T., .F.)
            ENDIF
         ENDIF
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
