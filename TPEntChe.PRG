         IF .not. THISFORM.Gx_Curr_Level = 118  .and. THISFORM.GX_1_accepted
            IF .not. THISFORM. GXInLvl118
               RETURN .T.
            ENDIF
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.A1078PenMo = 1
            THISFORM.A1079PenMo = "INGRESO A CAJA"
         ENDIF
         THISFORM. cCT111A1079 .Refresh()
         IF EMPTY( THISFORM.A1078PenMo )
            DO GX_ERRMW WITH "Debe ingresar un Código de Motivo  !!!"
