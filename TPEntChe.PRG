      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011114" , @HStmt_T011114 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPENTCHE","T011114","",GX_CURSOR_TYPE_READONLY,@HStmt_T011114) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [PenMotCod], [PenPCtaCod] AS PenPCtaCod, [PenCtaCod] AS PenCtaCod "
                  cmdbuf = cmdbuf + "  FROM [PENTCHE1] (NOLOCK) WHERE [EmpCod] = ? AND [PenMotCod] = ? AND [PenPCtaCod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [PenMotCod], [PenPCtaCod], [PenCtaCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011114,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011114,8)
                  THISFORM.GX_DB_BindColsT011114_01 ()
                  THISFORM.GX_DB_BindParmT011114_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011114,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1078PenMo = THISFORM.A1078PenMo
               Gx_err = GX_DB_SetInt( HStmt_T011114,2,@AuxA1078PenMo,0)
               THISFORM.A1078PenMo = AuxA1078PenMo
               AuxA1082PenPC = THISFORM.A1082PenPC
               Gx_err = GX_DB_SetInt( HStmt_T011114,3,@AuxA1082PenPC,0)
               THISFORM.A1082PenPC = AuxA1082PenPC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011114) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011114 = Gx_err
               THISFORM.GX_DB_GetT011114_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011114 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011114) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011114 = Gx_err
                  THISFORM.GX_DB_GetT011114_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011114 <> 101
               BRK33117 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT111S14.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T011114_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011114) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011114 = Gx_err
               THISFORM.GX_DB_GetT011114_01 ()
            ENDDO
         ENDIF
      ENDPROC
