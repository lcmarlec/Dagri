      ***********************
      PROCEDURE cCW416V22.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW416V22.ISVALID" )
         IF THISFORM.AV22Cricod = 0
            THISFORM.AV23Cridsc = "Todos "
         ELSE
            THISFORM.AV35GXLvl4 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04163" , @HStmt_W04163 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLREMINT","W04163","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W04163) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [CRICod], [CRIDsc] FROM [CRINTERN] (NOLOCK) WHERE [EmpCod] = ? and "
               cmdbuf = cmdbuf + "  [CRICod] = ? ORDER BY [EmpCod], [CRICod]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04163,cmdbuf)
               THISFORM.GX_DB_BindColsW04163_01 ()
               THISFORM.GX_DB_BindParmW04163_01 ()
            ENDIF
            AuxAV8Emprcod = THISFORM.AV8Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04163,1,@AuxAV8Emprcod,0)
            THISFORM.AV8Emprcod = AuxAV8Emprcod
            AuxAV22Cricod = THISFORM.AV22Cricod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04163,2,@AuxAV22Cricod,0)
            THISFORM.AV22Cricod = AuxAV22Cricod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04163) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W04163 = Gx_err
            THISFORM.GX_DB_GetW04163_01 ()
            DO WHILE THISFORM.W04163 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W04163_2EmpCod
               THISFORM.A1318CRICo = THISFORM.Buf_W04163_1318CRICod
               THISFORM.A1319CRIDs = THISFORM.Buf_W04163_1319CRIDsc
               THISFORM.AV35GXLvl4 = 1
               THISFORM.AV23Cridsc = THISFORM.A1319CRIDs
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W04163) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV35GXLvl4 = 0
               THISFORM.AV23Cridsc = "No Existe "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

