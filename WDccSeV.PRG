      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA364DcCOb WITH THISFORM.A364DcCObs
         REPLACE sA363DcCPr WITH THISFORM.A363DcCPrc
         REPLACE sA359DcCRO WITH THISFORM.A359DcCROR
         REPLACE sA354DcCRO WITH THISFORM.A354DcCROR
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A364DcCObs = sA364DcCOb
         THISFORM.A363DcCPrc = sA363DcCPr
         THISFORM.A359DcCROR = sA359DcCRO
         THISFORM.A354DcCROR = sA354DcCRO
