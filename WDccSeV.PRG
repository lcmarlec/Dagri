         SCW31S22 = ""
         IF USED( "SCW31S22" )
            SELECT SCW31S22
            SCW31S22 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW31S22
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA364DcCOb"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 40
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA363DcCPr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 15
            GX_STRUCT[ 2 ,4]= 4

            GX_STRUCT[ 3 ,1]= "sA359DcCRO"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA354DcCRO"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW31S22 = GETE('z:\temp') + '\' + SCW31S22
            ENDIF
            CREATE DBF (SCW31S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW31S22) EXCLUSIVE ALIAS SCW31S22
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW31S22
         THIS.GX_SfAlias = "SCW31S22"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00312" , @HStmt_W00312 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCSEV","W00312","",GX_CURSOR_TYPE_READONLY,@HStmt_W00312) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntGruTip], T1.[EmpCod], T1.[DcCNroInt], T2.[DcCCtaCte], T2.[DccObs], "
                  cmdbuf = cmdbuf + "  T2.[DccArtPen], T2.[DccArtTot], T2.[DcCNet], T1.[DcCRORNroI], T1.[DcCRORLin], T1.[DcCPrc], "
                  cmdbuf = cmdbuf + "  T1.[DcCObsLin], T2.[DccSer], T2.[DcCFV], T2.[DcCNro], T2.[DcCSuc], T2.[DcCTip], "
                  cmdbuf = cmdbuf + "  T2.[DcCFec], T3.[EntRaz], T2.[EntCod] FROM (([DCCOM2] T1 (NOLOCK) LEFT JOIN [DCCOM] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[DcCNroInt] = T1.[DcCNroInt]) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  AND T3.[EntCod] = T2.[EntCod]) WHERE T1.[EmpCod] = ? and T1.[DcCNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00312,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00312,10)
                  THISFORM.GX_DB_BindColsW00312_01 ()
                  THISFORM.GX_DB_BindParmW00312_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00312,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00312,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00312 = Gx_err
               THISFORM.GX_DB_GetW00312_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WDccSeV"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00312 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00312) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00312 = Gx_err
                  THISFORM.GX_DB_GetW00312_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00312 <> 101
               BRKV0V2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W00312_150EntGruTip
               THISFORM.A374DcCCta = THISFORM.Buf_W00312_374DcCCtaCte
               THISFORM.A1591DccOb = THISFORM.Buf_W00312_1591DccObs
               THISFORM.A1264DccAr = THISFORM.Buf_W00312_1264DccArtPen
               THISFORM.A1263DccAr = THISFORM.Buf_W00312_1263DccArtTot
               THISFORM.A370DcCNet = THISFORM.Buf_W00312_370DcCNet
               THISFORM.A354DcCROR = THISFORM.Buf_W00312_354DcCRORNroI
               THISFORM.A359DcCROR = THISFORM.Buf_W00312_359DcCRORLin
               THISFORM.A363DcCPrc = THISFORM.Buf_W00312_363DcCPrc
               THISFORM.A364DcCObs = THISFORM.Buf_W00312_364DcCObsLin
               THISFORM.A349DccSer = THISFORM.Buf_W00312_349DccSer
               THISFORM.A372DcCFV = THISFORM.Buf_W00312_372DcCFV
               THISFORM.A352DcCNro = THISFORM.Buf_W00312_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W00312_350DcCSuc
               THISFORM.A348DcCTip = THISFORM.Buf_W00312_348DcCTip
               THISFORM.A347DcCFec = THISFORM.Buf_W00312_347DcCFec
               THISFORM.A153EntRaz = THISFORM.Buf_W00312_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W00312_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W00312_150EntGruTip
               THISFORM.A374DcCCta = THISFORM.Buf_W00312_374DcCCtaCte
               THISFORM.A1591DccOb = THISFORM.Buf_W00312_1591DccObs
               THISFORM.A1264DccAr = THISFORM.Buf_W00312_1264DccArtPen
               THISFORM.A1263DccAr = THISFORM.Buf_W00312_1263DccArtTot
               THISFORM.A370DcCNet = THISFORM.Buf_W00312_370DcCNet
               THISFORM.A349DccSer = THISFORM.Buf_W00312_349DccSer
               THISFORM.A372DcCFV = THISFORM.Buf_W00312_372DcCFV
               THISFORM.A352DcCNro = THISFORM.Buf_W00312_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W00312_350DcCSuc
               THISFORM.A348DcCTip = THISFORM.Buf_W00312_348DcCTip
               THISFORM.A347DcCFec = THISFORM.Buf_W00312_347DcCFec
               THISFORM.A120EntCod = THISFORM.Buf_W00312_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W00312_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U15V0V2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00312 = Gx_err
               THISFORM.GX_DB_GetW00312_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         THISFORM.A354DcCROR = THISFORM.Buf_W00312_354DcCRORNroI
         THISFORM.A359DcCROR = THISFORM.Buf_W00312_359DcCRORLin
         THISFORM.A363DcCPrc = THISFORM.Buf_W00312_363DcCPrc
         THISFORM.A364DcCObs = THISFORM.Buf_W00312_364DcCObsLin
