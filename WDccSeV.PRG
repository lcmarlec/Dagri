         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00313" , @HStmt_W00313 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCSEV","W00313","",GX_CURSOR_TYPE_READONLY,@HStmt_W00313) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [DcCNroInt], [DcCRORTip], [DcCRORNroI] FROM [DCCOM1] (NOLOCK) WHERE "
            cmdbuf = cmdbuf + "  ([EmpCod] = ? and [DcCNroInt] = ?) AND ([DcCRORTip] <> 'C') ORDER BY [EmpCod], [DcCNroInt] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00313,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00313,10)
            THISFORM.GX_DB_BindColsW00313_01 ()
            THISFORM.GX_DB_BindParmW00313_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00313,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA346DcCNro = THISFORM.A346DcCNro
         THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00313,2,@AuxA346DcCNro,0)
         THISFORM.A346DcCNro = AuxA346DcCNro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00313) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00313 = Gx_err
         THISFORM.GX_DB_GetW00313_01 ()
         DO WHILE THISFORM.W00313 <> 101
            THISFORM.A355DcCROR = THISFORM.Buf_W00313_355DcCRORTip
            THISFORM.A354DcCROR = THISFORM.Buf_W00313_354DcCRORNroI
            THISFORM.AV18J = 0
            DO WHILE THISFORM.AV18J <= THISFORM.AV19I .AND. THISFORM.AV19I > 0
               THISFORM.AV18J = THISFORM.AV18J + 1
               IF THISFORM.AV17Anroi[THISFORM.AV18J] = THISFORM.A354DcCROR .OR. THISFORM.A354DcCROR = 0
                  THISFORM.AV18J = 99
               ENDIF
            ENDDO
            IF THISFORM.AV18J < 99 .AND. THISFORM.A354DcCROR <> 0
               THISFORM.AV19I = THISFORM.AV19I + 1
               THISFORM.AV17Anroi[THISFORM.AV19I] = THISFORM.A354DcCROR
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00313) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
