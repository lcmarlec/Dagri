         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00313) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV19I > 0
            THISFORM.cCW31B35.Visible = 1
