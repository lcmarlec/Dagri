      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00952" , @HStmt_W00952 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOBJ001","W00952","",GX_CURSOR_TYPE_READONLY,@HStmt_W00952) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ObjDsc], [ObjCod] FROM [OBJ001] (FASTFIRSTROW NOLOCK) WHERE ([ObjCod] like "
                  cmdbuf = cmdbuf + "  ?) AND ([ObjDsc] like ?) ORDER BY [ObjCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00952,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00952,11)
                  THISFORM.GX_DB_BindColsW00952_01 ()
                  THISFORM.GX_DB_BindParmW00952_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00952,1,PADR( TRIM(THISFORM.AV6Objcod),8, '%'),LEN(PADR( TRIM(THISFORM.AV6Objcod),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00952,2,PADR( TRIM(THISFORM.AV5Objdsc),25, '%'),LEN(PADR( TRIM(THISFORM.AV5Objdsc),25, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00952) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00952 = Gx_err
               THISFORM.GX_DB_GetW00952_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV15Pgmnam = "WObj001"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00952 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00952) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00952 = Gx_err
                  THISFORM.GX_DB_GetW00952_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00952 <> 101
               BRKV2N2 = .F.
               THISFORM.A69ObjDsc = THISFORM.Buf_W00952_69ObjDsc
               THISFORM.A680ObjCod = THISFORM.Buf_W00952_680ObjCod
               GX_SFLOAD = 0
               THISFORM.U17V2N2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00952) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00952 = Gx_err
               THISFORM.GX_DB_GetW00952_01 ()
            ENDDO
         ENDIF
