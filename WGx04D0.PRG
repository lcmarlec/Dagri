      PROCEDURE CreateTemp
         LOCAL SCW429S20
         SCW429S20 = ""
         IF USED( "SCW429S20" )
            SELECT SCW429S20
            SCW429S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW429S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1340CAIT"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1376CAIS"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1341CAIS"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1342CAIN"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW429S20 = GETE('z:\temp') + '\' + SCW429S20
            ENDIF
            CREATE DBF (SCW429S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW429S20) EXCLUSIVE ALIAS SCW429S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW429S20
         THIS.GX_SfAlias = "SCW429S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04292" , @HStmt_W04292 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04D0","W04292","",GX_CURSOR_TYPE_READONLY,@HStmt_W04292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CAINroHta], [CAIFchDde], [CAINroDde], [CAISuc], [CAISer], [CAITipDoc], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [CAI] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([CAITipDoc] like ?) "
                  cmdbuf = cmdbuf + "  AND ([CAISer] like ?) AND ([CAISuc] >= ?) AND ([CAINroDde] >= ?) AND ([CAINroHta] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([CAIFchDde] >= ?) ORDER BY [EmpCod], [CAITipDoc], [CAISer], [CAISuc], "
                  cmdbuf = cmdbuf + "  [CAINroDde]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04292,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04292,9)
                  THISFORM.GX_DB_BindColsW04292_01 ()
                  THISFORM.GX_DB_BindParmW04292_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04292,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04292,2,PADR( TRIM(THISFORM.AV6C1340),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C1340),2, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04292,3,PADR( TRIM(THISFORM.AV7C1376),1, '%'),LEN(PADR( TRIM(THISFORM.AV7C1376),1, '%')),0)
               AuxAV8C1341 = THISFORM.AV8C1341
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04292,4,@AuxAV8C1341,0)
               THISFORM.AV8C1341 = AuxAV8C1341
               AuxAV9C1342 = THISFORM.AV9C1342
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04292,5,@AuxAV9C1342,0)
               THISFORM.AV9C1342 = AuxAV9C1342
               AuxAV10C1343 = THISFORM.AV10C1343
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04292,6,@AuxAV10C1343,0)
               THISFORM.AV10C1343 = AuxAV10C1343
               AuxAV11C1337 = THISFORM.AV11C1337
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04292,7,@AuxAV11C1337,0)
               THISFORM.AV11C1337 = AuxAV11C1337
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04292 = Gx_err
               THISFORM.GX_DB_GetW04292_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04292 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04292) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04292 = Gx_err
                  THISFORM.GX_DB_GetW04292_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04292 <> 101
               BRKVBX2 = .F.
               THISFORM.A1343CAINr = THISFORM.Buf_W04292_1343CAINroHta
               THISFORM.A1337CAIFc = THISFORM.Buf_W04292_1337CAIFchDde
               THISFORM.A1342CAINr = THISFORM.Buf_W04292_1342CAINroDde
               THISFORM.A1341CAISu = THISFORM.Buf_W04292_1341CAISuc
               THISFORM.A1376CAISe = THISFORM.Buf_W04292_1376CAISer
               THISFORM.A1340CAITi = THISFORM.Buf_W04292_1340CAITipDoc
               THISFORM.A2EmpCod = THISFORM.Buf_W04292_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VBX2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04292 = Gx_err
               THISFORM.GX_DB_GetW04292_01 ()
            ENDDO
         ENDIF
      ENDPROC
