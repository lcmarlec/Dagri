      ***********************
      PROCEDURE U13V2Y2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'CONFIRMAR'" )
         * 'confirmar' Routine
         THISFORM.AV28Ok = "S"
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW106S27 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW106S27.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW106S27.SF (3, @GX_SFERR)
            THISFORM.cCW106S27 .SaveGridPos()
            IF THISFORM.AV26Lugcod = 0 .AND. THISFORM.AV25Cantid <> THISFORM.AV24Cantor
               THISFORM.SaveTblPos()
               DO Werrores WITH "Debe ingresar un Lugar de Almacenamiento " , "R"
               THISFORM. cCW106S27 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.AV28Ok = "N"
               * Exit For each command. Update data (if necessary), close cursors & exit.
               EXIT
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW106S27 .RestoreGridPos()
               THISFORM.cCW106S27.SF (4, @GX_SFERR)
               THISFORM.cCW106S27.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW106S27 .ResetSavedGridPos()
         SELECT( THISFORM.cCW106S27 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW106S27.SF (3, @GX_SFERR)
         ENDIF
         IF THISFORM.AV28Ok = "S"
            LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
            GX_SFERR = 0
            Gx_fel_sel = .T.
            gxO_Rec = 0
            SELECT( THISFORM.cCW106S27 .GX_SfAlias)
            gxO_Rec1 = IIF(EOF(), 0, RECNO())
            THISFORM.cCW106S27.SF (8, @GX_SFERR)
            DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
               THISFORM.cCW106S27.SF (3, @GX_SFERR)
               THISFORM.cCW106S27 .SaveGridPos()
               IF THISFORM.AV25Cantid <> THISFORM.AV24Cantor
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.A2EmpCod
                  Aux1 = THISFORM.A748OPrLot
                  Aux2 = THISFORM.A745OPrFam
                  Aux3 = THISFORM.A746OprFam
                  Aux4 = THISFORM.A747OprArt
                  Aux5 = THISFORM.A749OPrSLt
                  Aux6 = THISFORM.A777OprFLi
                  Aux7 = THISFORM.A778OprFFa
                  Aux8 = THISFORM.A779OprFFa
                  Aux9 = THISFORM.A780OprFAr
                  Aux10 = THISFORM.AV25Cantid
                  Aux11 = THISFORM.AV26Lugcod
                  Aux13 = THISFORM.AV6Fechasi
                  Aux14 = THISFORM.AV19Usuari
                  DO POprodF1 WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7 , Aux8 , Aux9 , Aux10 , Aux11 , "UPD" , Aux13 , Aux14
                  THISFORM.A2EmpCod = Aux0
                  THISFORM.A748OPrLot = Aux1
                  THISFORM.A745OPrFam = Aux2
                  THISFORM.A746OprFam = Aux3
                  THISFORM.A747OprArt = Aux4
                  THISFORM.A749OPrSLt = Aux5
                  THISFORM.A777OprFLi = Aux6
                  THISFORM.A778OprFFa = Aux7
                  THISFORM.A779OprFFa = Aux8
                  THISFORM.A780OprFAr = Aux9
                  THISFORM.AV25Cantid = Aux10
                  THISFORM.AV26Lugcod = Aux11
                  THISFORM.AV6Fechasi = Aux13
                  THISFORM.AV19Usuari = Aux14
                  THISFORM. cCW106S27 .RestoreGridPos()
                  THISFORM. cCW106S27.Columns(1).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW106S27.Columns(2).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW106S27.Columns(3).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW106S27.Columns(5).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW106S27.Columns(6).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW106S27 .GX_rec_modif = .T.
                  THISFORM. cCW106S27 .GX_LastVld1 = THISFORM. cCW106S27.Columns(1).Ctrl1 .GXColumnNo - 1
                  GX_rploop = .T.
               ENDIF
               IF Gx_fel_sel
                  THISFORM.cCW106S27 .RestoreGridPos()
                  THISFORM.cCW106S27.SF (4, @GX_SFERR)
                  THISFORM.cCW106S27.SF (9, @GX_SFERR)
               ENDIF
            ENDDO
            THISFORM.cCW106S27 .ResetSavedGridPos()
            SELECT( THISFORM.cCW106S27 .GX_SfAlias)
            IF gxO_Rec1 != 0
               GOTO (gxO_Rec1)
               THISFORM.cCW106S27.SF (3, @GX_SFERR)
            ENDIF
            THISFORM.ReleaseAll()
            RETURN
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
