      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06102" , @HStmt_W06102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WVERAUDI","W06102","",GX_CURSOR_TYPE_READONLY,@HStmt_W06102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AudSist], [AudEmpCod], [AudCodObj], [AudNro], [AudObs], [AudWrk], [AudUsu], "
                  cmdbuf = cmdbuf + "  [Audtime], [AudCodAct], [AudFch] FROM [AUDIT] (FASTFIRSTROW NOLOCK) WHERE ([AudEmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [AudCodObj] = ?) AND (( [AudNro] = ? and SUBSTRING(?, 1, 4) <> 'Lega') or "
                  cmdbuf = cmdbuf + "  ( [AudNro] like ? and SUBSTRING(?, 1, 4) = 'Lega')) ORDER BY [AudEmpCod], [AudCodObj], "
                  cmdbuf = cmdbuf + "  [AudNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06102,9)
                  THISFORM.GX_DB_BindColsW06102_01 ()
                  THISFORM.GX_DB_BindParmW06102_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06102,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Audcod = THISFORM.AV19Audcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06102,2,AuxAV19Audcod,4,0)
               THISFORM.AV19Audcod = AuxAV19Audcod
               AuxAV20Audnro = THISFORM.AV20Audnro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06102,3,AuxAV20Audnro,30,0)
               THISFORM.AV20Audnro = AuxAV20Audnro
               AuxAV20Audnro = THISFORM.AV20Audnro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06102,4,AuxAV20Audnro,30,0)
               THISFORM.AV20Audnro = AuxAV20Audnro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06102,5,PADR( TRIM(THISFORM.AV20Audnro),30, '%'),LEN(PADR( TRIM(THISFORM.AV20Audnro),30, '%')),0)
               AuxAV20Audnro = THISFORM.AV20Audnro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06102,6,AuxAV20Audnro,30,0)
               THISFORM.AV20Audnro = AuxAV20Audnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06102 = Gx_err
               THISFORM.GX_DB_GetW06102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WVerAudi"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06102 = Gx_err
                  THISFORM.GX_DB_GetW06102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06102 <> 101
               BRKVGY2 = .F.
               THISFORM.A47AudEmpC = THISFORM.Buf_W06102_47AudEmpCod
               THISFORM.A51AudCodO = THISFORM.Buf_W06102_51AudCodObj
               THISFORM.A14AudNro = THISFORM.Buf_W06102_14AudNro
               THISFORM.A13AudObs = THISFORM.Buf_W06102_13AudObs
               THISFORM.A53AudWrk = THISFORM.Buf_W06102_53AudWrk
               THISFORM.A52AudUsu = THISFORM.Buf_W06102_52AudUsu
               THISFORM.A49Audtime = THISFORM.Buf_W06102_49Audtime
               THISFORM.A50AudCodA = THISFORM.Buf_W06102_50AudCodAct
               THISFORM.A48AudFch = THISFORM.Buf_W06102_48AudFch
               GX_SFLOAD = 0
               THISFORM.U13VGY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06102 = Gx_err
               THISFORM.GX_DB_GetW06102_01 ()
            ENDDO
         ENDIF
      ENDPROC
