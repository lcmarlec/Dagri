            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "sA14AudNro"
            GX_STRUCT[ 9 ,2]= "C"
            GX_STRUCT[ 9 ,3]= 30
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW610S10 = GETE('z:\temp') + '\' + SCW610S10
            ENDIF
            CREATE DBF (SCW610S10) FROM ARRAY GX_STRUCT
            USE
