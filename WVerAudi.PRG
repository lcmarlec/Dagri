      PROCEDURE CreateTemp
         LOCAL SCW610S10
         SCW610S10 = ""
         IF USED( "SCW610S10" )
            SELECT SCW610S10
            SCW610S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW610S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA48AudFch"
