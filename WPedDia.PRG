      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01192" , @HStmt_W01192 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPEDDIA","W01192","",GX_CURSOR_TYPE_READONLY,@HStmt_W01192) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PedNro], T1.[PedFVT], T1.[PedGruTip] AS PedGruTip, T1.[PedFch], "
                  cmdbuf = cmdbuf + "  T1.[PedSucCod] AS PedSucCod, T1.[PedEst], T1.[PedOrd12], T2.[EntLgTel] AS PedSucTel, "
                  cmdbuf = cmdbuf + "  T1.[PedPri], T1.[PedSec], T2.[EntLgDsc], T1.[PedEntCod] AS PedEntCod FROM ([PEDIDO1] "
                  cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [CLTES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[PedGruTip] AND T2.[EntCod] = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ?) AND (T1.[PedFch] = ?) AND (T1.[PedNro] = ?) AND (T1.[PedEst] "
                  cmdbuf = cmdbuf + "  < 3 or T1.[PedEst] = 9) ORDER BY T1.[EmpCod], T1.[PedEst], T1.[PedPri], T1.[PedEntCod], "
                  cmdbuf = cmdbuf + "  T2.[EntLgDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01192,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01192,15)
                  THISFORM.GX_DB_BindColsW01192_01 ()
                  THISFORM.GX_DB_BindParmW01192_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01192,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV23Pedfch = THISFORM.AV23Pedfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01192,2,@AuxAV23Pedfch,0)
               THISFORM.AV23Pedfch = AuxAV23Pedfch
               AuxAV18Ruta = THISFORM.AV18Ruta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01192,3,@AuxAV18Ruta,0)
               THISFORM.AV18Ruta = AuxAV18Ruta
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01192 = Gx_err
               THISFORM.GX_DB_GetW01192_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WPedDia"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01192 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01192) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01192 = Gx_err
                  THISFORM.GX_DB_GetW01192_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01192 <> 101
               BRKV3B2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W01192_2EmpCod
               THISFORM.A796PedNro = THISFORM.Buf_W01192_796PedNro
               THISFORM.A808PedFVT = THISFORM.Buf_W01192_808PedFVT
