            .and. EMPTY( THISFORM.AV32Cbacon ) ;
            .and. EMPTY( THISFORM.AV32Cbacon ) ;
            .and. .T.
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW398S35 .GX_SfAlias)
         THISFORM.cCW398S35 .SF(8)
         LOCATE FOR ( sA1280CBaS >= THISFORM.AV34Cbasum .AND. THISFORM.AV34Cbasum <> 0 ) .OR. ( sA1281CBaR >= THISFORM.AV35Cbares .AND. THISFORM.AV35Cbares <> 0 ) .OR. ( sA1278CBaC = THISFORM.AV32Cbacon .AND. THISFORM.AV32Cbacon <> 0 )
         IF EOF()
            GX_SFERR = 0
            IF RECCOUNT() = 0
               THISFORM.cCW398S35 .LoadRec(1, @GX_SFERR)
            ELSE
               THISFORM.cCW398S35 .LoadRec(2, @GX_SFERR)
            ENDIF
            SELECT ( THISFORM.cCW398S35 .GX_SfAlias)
            DO WHILE GX_SFERR = 0 .AND. .NOT. ( ( sA1280CBaS >= THISFORM.AV34Cbasum .AND. THISFORM.AV34Cbasum <> 0 ) .OR. ( sA1281CBaR >= THISFORM.AV35Cbares .AND. THISFORM.AV35Cbares <> 0 ) .OR. ( sA1278CBaC = THISFORM.AV32Cbacon .AND. THISFORM.AV32Cbacon <> 0 ) )
               * Load Next Record in SubFile
               THISFORM.cCW398S35 .LoadRec(2, @GX_SFERR)
               SELECT ( THISFORM.cCW398S35 .GX_SfAlias)
            ENDDO
            IF EOF()
               SELECT(THISFORM. cCW398S35 .GX_SfAlias)
               IF EOF()
                  DO GX_MSGW WITH "No hay registros que cumplan la condicion"
               ELSE
                  IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
                     DO GX_MSGW WITH ""
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
         SELECT ( THISFORM.cCW398S35 .GX_SfAlias)
         THISFORM.cCW398S35 .SF(3)
         gxO_Rec = IIF( EOF(), 0, RECNO())
         THISFORM.cCW398S35 .Refresh()
         IF gxO_Rec != 0 .and. gxO_Rec <= RECCOUNT()
            GOTO (gxO_Rec)
            THISFORM. cCW398S35 .GX_need_load = .T.
            THISFORM. cCW398S35 .LoadGridRows()
            GOTO (gxO_Rec)
         ENDIF
         THISFORM. cCW398S35 .GXSetRepos( .F. )
