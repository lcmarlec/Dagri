      PROCEDURE GXReposSf
         IF .T.;
            .and. EMPTY( THISFORM.AV34Cbasum ) ;
            .and. EMPTY( THISFORM.AV34Cbasum ) ;
            .and. EMPTY( THISFORM.AV35Cbares ) ;
