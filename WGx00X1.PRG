      PROCEDURE CreateTemp
         LOCAL SCW259S20
         SCW259S20 = ""
         IF USED( "SCW259S20" )
            SELECT SCW259S20
            SCW259S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW259S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA346DcCNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA150EntGr"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA120EntCo"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA347DcCFe"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA348DcCTi"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW259S20 = GETE('z:\temp') + '\' + SCW259S20
            ENDIF
            CREATE DBF (SCW259S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW259S20) EXCLUSIVE ALIAS SCW259S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW259S20
         THIS.GX_SfAlias = "SCW259S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02592" , @HStmt_W02592 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00X1","W02592","",GX_CURSOR_TYPE_READONLY,@HStmt_W02592) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DccGruCod], [DcCNroCtr], [DcCTip], [DcCFec], [EntCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [DcCNroInt] FROM [DCCOM] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [DcCNroInt] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([EntGruTip] like ?) AND ([EntCod] >= ?) AND ([DcCFec] >= ?) AND ([DccGruCod] "
                  cmdbuf = cmdbuf + "  like ?) AND ([DcCNroCtr] >= ?) ORDER BY [EmpCod], [DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02592,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02592,9)
                  THISFORM.GX_DB_BindColsW02592_01 ()
                  THISFORM.GX_DB_BindParmW02592_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02592,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C346 = THISFORM.AV5C346
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02592,2,@AuxAV5C346,0)
               THISFORM.AV5C346 = AuxAV5C346
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02592,3,PADR( TRIM(THISFORM.AV6C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C150),2, '%')),0)
               AuxAV7C120 = THISFORM.AV7C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02592,4,@AuxAV7C120,0)
               THISFORM.AV7C120 = AuxAV7C120
               AuxAV8C347 = THISFORM.AV8C347
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02592,5,@AuxAV8C347,0)
               THISFORM.AV8C347 = AuxAV8C347
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02592,6,PADR( TRIM(THISFORM.AV9C351),3, '%'),LEN(PADR( TRIM(THISFORM.AV9C351),3, '%')),0)
               AuxAV10C353 = THISFORM.AV10C353
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02592,7,@AuxAV10C353,0)
               THISFORM.AV10C353 = AuxAV10C353
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02592 = Gx_err
               THISFORM.GX_DB_GetW02592_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02592 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02592) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02592 = Gx_err
                  THISFORM.GX_DB_GetW02592_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02592 <> 101
               BRKV772 = .F.
               THISFORM.A351DccGru = THISFORM.Buf_W02592_351DccGruCod
               THISFORM.A353DcCNro = THISFORM.Buf_W02592_353DcCNroCtr
               THISFORM.A348DcCTip = THISFORM.Buf_W02592_348DcCTip
               THISFORM.A347DcCFec = THISFORM.Buf_W02592_347DcCFec
               THISFORM.A120EntCod = THISFORM.Buf_W02592_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W02592_150EntGruTip
               THISFORM.A346DcCNro = THISFORM.Buf_W02592_346DcCNroInt
               GX_SFLOAD = 0
               THISFORM.U12V772 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02592 = Gx_err
               THISFORM.GX_DB_GetW02592_01 ()
            ENDDO
         ENDIF
      ENDPROC
