***********************
PROCEDURE U11UA1
***********************

   * 'IMPORTE' Routine
   RV24Import = RV13Excel.cells(RV15Fila,8).Text
   RV24Import = ALLTRIM( RV24Import )
   RV27Entero = ""
   RV28Decima = ""
   RV29Punto = 0
   RV26Len = LEN(TRIM(RV24Import))
   RV25I = 1
   DO WHILE RV25I <= RV26Len
      IF substr( RV24Import , RV25I , 1 ) <> "$"
         IF substr( RV24Import , RV25I , 1 ) = "." .OR. substr( RV24Import , RV25I , 1 ) = ","
            RV29Punto = 1
         ELSE
            IF substr( RV24Import , RV25I , 1 ) = "0" .OR. ( val( substr( RV24Import , RV25I , 1 ) ) > 0 .AND. val( substr( RV24Import , RV25I , 1 ) ) < 10 )
               IF RV29Punto = 0
                  RV27Entero = RV27Entero + substr( RV24Import , RV25I , 1 )
               ELSE
                  RV28Decima = RV28Decima + substr( RV24Import , RV25I , 1 )
               ENDIF
            ENDIF
         ENDIF
      ENDIF
      RV25I = RV25I + 1
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   IF LEN(TRIM(RV28Decima)) = 1
      RV28Decima = RV28Decima + "0"
   ENDIF
   RV30Chqimp = val( RV27Entero ) + val( RV28Decima ) / 100
RETURN
