   IF Gx_dvc = "PRN"
      GXAuxPrn_Flag = GXPrn_Flag
      gxPrnObj.GXEndDoc( GxHDC , @GXAuxPrn_Flag)
      gxPrnObj.GXEndPrn( GxHDC , @GXAuxPrn_Flag)
      GXPrn_Flag = GXAuxPrn_Flag
      PRIVATE GXCallFrm
      IF PROGRAM(0) = "MENU"
         GXCallFrm = _SCREEN.ActiveForm
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 0
         ENDIF
      ENDIF
      DO WHILE gxPrnObj.GxIsAliveDoc( GxHDC ) != 0
         WAIT "" TIMEOUT 1
         DOEVENTS
      ENDDO
      RELEASE WINDOW _WMSG
      IF PROGRAM(0) = "MENU"
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 1
         ENDIF
      ENDIF
   ELSE
      SET DEVICE TO SCREEN
      RptView = .T.
   ENDIF
   DO CDMJ0
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

***********************
PROCEDURE U11MJ7
***********************

   * 'IMPUTACIONES' Routine
   LEVEL8 = .T.
   DO GX_CSC01
   IF .NOT. GX_DB_StmtIsDef( HConn_Default , "R08116" , @HStmt_R08116 )
      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RLSUELDO","R08116","",GX_CURSOR_TYPE_READONLY_NOTNESTED,@HStmt_R08116) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT T2.[EchPCta] AS EchPCta, T1.[EmpCod], T1.[ECHNroInt], T1.[EchCtaCod] AS EchCtaCod, "
      cmdbuf = cmdbuf + "  T1.[EchCtaImp], T3.[CtaDes] AS EchCtaDsc FROM (([ENTCHE2] T1 (NOLOCK) LEFT JOIN "
      cmdbuf = cmdbuf + "  [ENTCHE] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[ECHNroInt] = T1.[ECHNroInt]) "
      cmdbuf = cmdbuf + "  LEFT JOIN [CTA00] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[PCtaNro] = T2.[EchPCta] "
      cmdbuf = cmdbuf + "  AND T3.[CtaNro] = T1.[EchCtaCod]) WHERE T1.[EmpCod] = ? and T1.[ECHNroInt] = ? ORDER "
      cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[ECHNroInt], T1.[EchCtaCod]  "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_R08116,cmdbuf)
      Gx_err = GX_DB_Set_StmtFetchSize( HStmt_R08116,100)
      GX_DB_BindColsR08116_01 ()
      GX_DB_BindParmR08116_01 ()
   ENDIF
   Gx_err = GX_DB_SetInt( HStmt_R08116,1,@AV8Emprcod,0)
   Gx_err = GX_DB_SetDouble( HStmt_R08116,2,@RV36Echnro,0)
   Gx_eop = 1
   DO WHILE Gx_eop != 0
      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_R08116) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   R08116 = Gx_err
   GX_DB_GetR08116_01 ()
   DO WHILE R08116 <> 101
      R1088EchPC = Buf_R08116_1088EchPCta
      R2EmpCod = Buf_R08116_2EmpCod
      R1083ECHNr = Buf_R08116_1083ECHNroInt
      R1091EchCt = Buf_R08116_1091EchCtaCod
      R1100EchCt = Buf_R08116_1100EchCtaImp
      R1092EchCt = Buf_R08116_1092EchCtaDsc
      R1088EchPC = Buf_R08116_1088EchPCta
      R1092EchCt = Buf_R08116_1092EchCtaDsc
      RV33I = 1
      DO WHILE RV33I <= RV34J
         IF RV32Totcta[RV33I] = R1091EchCt
            RV27Totent[RV33I] = RV27Totent[RV33I] + R1100EchCt
            RV33I = 100
         ENDIF
         RV33I = RV33I + 1
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      IF RV33I < 100 .AND. RV34J < 20
         RV34J = RV34J + 1
         RV32Totcta[RV34J] = R1091EchCt
         RV35Totcta[RV34J] = R1092EchCt
         RV27Totent[RV34J] = R1100EchCt
      ENDIF
      * Check if program is canceled.
      IF gxPrnObj.GxIsAliveDoc( GxHDC ) = 0
         UserCancel = .T.
      ENDIF
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R08116) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R08116 = Gx_err
      GX_DB_GetR08116_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08116) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL8 = .F.
RETURN

