               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03602,2,@AuxAV17Desde,0)
               THISFORM.AV17Desde = AuxAV17Desde
               AuxAV21Cuales = THISFORM.AV21Cuales
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03602,3,AuxAV21Cuales,1,0)
               THISFORM.AV21Cuales = AuxAV21Cuales
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03602 = Gx_err
               THISFORM.GX_DB_GetW03602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WRcVNrCl"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03602 = Gx_err
                  THISFORM.GX_DB_GetW03602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03602 <> 101
               BRKVA02 = .F.
               THISFORM.AV22Recibo = 0
               THISFORM.AV23Fechac = CTOD("  /  /  ")
               THISFORM.A862RCVEnt = THISFORM.Buf_W03602_862RCVEntGruT
               THISFORM.A867RCVSuc = THISFORM.Buf_W03602_867RCVSuc
               THISFORM.A866RCVSer = THISFORM.Buf_W03602_866RCVSer
               THISFORM.A865RCVTip = THISFORM.Buf_W03602_865RCVTip
               THISFORM.A1213RcvFc = THISFORM.Buf_W03602_1213RcvFchCli
               THISFORM.A1198RCVNr = THISFORM.Buf_W03602_1198RCVNroCli
               THISFORM.A2EmpCod = THISFORM.Buf_W03602_2EmpCod
               THISFORM.A858RCVNro = THISFORM.Buf_W03602_858RCVNroI
               THISFORM.A879RCVTot = THISFORM.Buf_W03602_879RCVTot
               THISFORM.A859RCVFch = THISFORM.Buf_W03602_859RCVFch
               THISFORM.A864RCVEnt = THISFORM.Buf_W03602_864RCVEntRaz
               THISFORM.A863RCVEnt = THISFORM.Buf_W03602_863RCVEntCod
               THISFORM.A868RCVNro = THISFORM.Buf_W03602_868RCVNro
               THISFORM.A864RCVEnt = THISFORM.Buf_W03602_864RCVEntRaz
               GX_SFLOAD = 0
               THISFORM.U14VA02 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03602 = Gx_err
               THISFORM.GX_DB_GetW03602_01 ()
            ENDDO
         ENDIF
      ENDPROC
