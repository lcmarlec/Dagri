                  cmdbuf = " SELECT T1.[RCVEntGruT] AS RCVEntGruT, T1.[RCVSuc], T1.[RCVSer], T1.[RCVTip], T1.[RcvFchCli], "
                  cmdbuf = cmdbuf + "  T1.[RCVNroCli], T1.[EmpCod], T1.[RCVNroI], T1.[RCVTot], T1.[RCVFch], T2.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS RCVEntRaz, T1.[RCVEntCod] AS RCVEntCod, T1.[RCVNro] FROM ([RECIBOS] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
