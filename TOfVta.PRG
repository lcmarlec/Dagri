      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T019015" , @HStmt_T019015 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOFVTA","T019015","",GX_CURSOR_TYPE_READONLY,@HStmt_T019015) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfvFDe], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [GrpOf], [EntLgCod] FROM [OFVTA1] (NOLOCK) WHERE [EmpCod] = ? AND [FamCod] = ? AND "
                  cmdbuf = cmdbuf + "  [FamSubCod] = ? AND [ArtCod] = ? AND [OfvFDe] = ? AND [EntGruTip] = ? AND [EntCod] "
                  cmdbuf = cmdbuf + "  = ? AND [GrpOf] = ? ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfvFDe], "
                  cmdbuf = cmdbuf + "  [EntGruTip], [EntCod], [GrpOf], [EntLgCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T019015,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T019015,11)
                  THISFORM.GX_DB_BindColsT019015_01 ()
                  THISFORM.GX_DB_BindParmT019015_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T019015,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T019015,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T019015,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T019015,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA1866OfvFD = THISFORM.A1866OfvFD
               Gx_err = GX_DB_SetDate( HStmt_T019015,5,@AuxA1866OfvFD,0)
               THISFORM.A1866OfvFD = AuxA1866OfvFD
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T019015,6,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T019015,7,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA1854GrpOf = THISFORM.A1854GrpOf
               Gx_err = GX_DB_SetInt( HStmt_T019015,8,@AuxA1854GrpOf,0)
               THISFORM.A1854GrpOf = AuxA1854GrpOf
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T019015) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T019015 = Gx_err
               THISFORM.GX_DB_GetT019015_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T019015 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T019015) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T019015 = Gx_err
                  THISFORM.GX_DB_GetT019015_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T019015 <> 101
               BRK5A219 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT190S37.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T019015_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T019015) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T019015 = Gx_err
               THISFORM.GX_DB_GetT019015_01 ()
            ENDDO
         ENDIF
      ENDPROC
