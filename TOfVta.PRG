      PROCEDURE CreateTemp
         LOCAL SCT190S37
         SCT190S37 = ""
         IF USED( "SCT190S37" )
            SELECT SCT190S37
            SCT190S37 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT190S37
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA176EntLg"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA177EntLg"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA178EntLg"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2817EntL"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV11Numer"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 30
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT190S37 = GETE('z:\temp') + '\' + SCT190S37
            ENDIF
            CREATE DBF (SCT190S37) FROM ARRAY GX_STRUCT
            USE
            USE (SCT190S37) EXCLUSIVE ALIAS SCT190S37
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT190S37
         THIS.GX_SfAlias = "SCT190S37"
      ENDPROC
