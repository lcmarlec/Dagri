         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S1866OfvFD = THISFORM.A1866OfvFD
