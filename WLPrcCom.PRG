      ***********************
      PROCEDURE cCW722V9.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW722V9.ISVALID" )
         IF THISFORM.AV21Famdes + THISFORM.AV23Famsde + THISFORM.AV9Artdes = 0
            THISFORM.AV25Artdsc = "Primero "
         ELSE
            THISFORM.AV31GXLvl6 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07222" , @HStmt_W07222 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLPRCCOM","W07222","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W07222) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtDsc] FROM [ARTICS] (NOLOCK) "
               cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [FamCod] = ? and [FamSubCod] = ? and [ArtCod] = ? ORDER BY "
               cmdbuf = cmdbuf + "  [EmpCod], [FamCod], [FamSubCod], [ArtCod]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07222,cmdbuf)
               THISFORM.GX_DB_BindColsW07222_01 ()
               THISFORM.GX_DB_BindParmW07222_01 ()
            ENDIF
            AuxAV11Emprco = THISFORM.AV11Emprco
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07222,1,@AuxAV11Emprco,0)
            THISFORM.AV11Emprco = AuxAV11Emprco
            AuxAV21Famdes = THISFORM.AV21Famdes
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07222,2,@AuxAV21Famdes,0)
            THISFORM.AV21Famdes = AuxAV21Famdes
            AuxAV23Famsde = THISFORM.AV23Famsde
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07222,3,@AuxAV23Famsde,0)
            THISFORM.AV23Famsde = AuxAV23Famsde
            AuxAV9Artdes = THISFORM.AV9Artdes
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07222,4,@AuxAV9Artdes,0)
            THISFORM.AV9Artdes = AuxAV9Artdes
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07222) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W07222 = Gx_err
            THISFORM.GX_DB_GetW07222_01 ()
            DO WHILE THISFORM.W07222 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W07222_2EmpCod
               THISFORM.A3FamCod = THISFORM.Buf_W07222_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W07222_4FamSubCod
               THISFORM.A5ArtCod = THISFORM.Buf_W07222_5ArtCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W07222_6ArtDsc
               THISFORM.AV31GXLvl6 = 1
               THISFORM.AV25Artdsc = THISFORM.A6ArtDsc
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W07222) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV31GXLvl6 = 0
               THISFORM.AV25Artdsc = "Artículo Inexistente "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

