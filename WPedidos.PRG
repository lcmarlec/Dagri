      PROCEDURE CreateTemp
         LOCAL SCW122S12
         SCW122S12 = ""
         IF USED( "SCW122S12" )
            SELECT SCW122S12
            SCW122S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW122S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA966RutCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1216RutC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1217RutC"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2EmpCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW122S12 = GETE('z:\temp') + '\' + SCW122S12
            ENDIF
            CREATE DBF (SCW122S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW122S12) EXCLUSIVE ALIAS SCW122S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW122S12
         THIS.GX_SfAlias = "SCW122S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01222" , @HStmt_W01222 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPEDIDOS","W01222","",GX_CURSOR_TYPE_READONLY,@HStmt_W01222) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RutCod], T1.[EmpCod], T2.[ChfNom] AS RutChfNom, T1.[RutChfCod] AS RutChfCod "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[ChfCod] = T1.[RutChfCod]) WHERE T1.[EmpCod] = ? and T1.[RutCod] "
                  cmdbuf = cmdbuf + "  >= ? ORDER BY T1.[EmpCod], T1.[RutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01222,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01222,14)
                  THISFORM.GX_DB_BindColsW01222_01 ()
                  THISFORM.GX_DB_BindParmW01222_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01222,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV29Rutcod = THISFORM.AV29Rutcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01222,2,@AuxAV29Rutcod,0)
               THISFORM.AV29Rutcod = AuxAV29Rutcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01222) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01222 = Gx_err
               THISFORM.GX_DB_GetW01222_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WPedidos"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01222 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01222) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01222 = Gx_err
                  THISFORM.GX_DB_GetW01222_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01222 <> 101
               BRKV3E2 = .F.
               THISFORM.A966RutCod = THISFORM.Buf_W01222_966RutCod
               THISFORM.A2EmpCod = THISFORM.Buf_W01222_2EmpCod
               THISFORM.A1217RutCh = THISFORM.Buf_W01222_1217RutChfNom
               THISFORM.A1216RutCh = THISFORM.Buf_W01222_1216RutChfCod
               THISFORM.A1217RutCh = THISFORM.Buf_W01222_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U15V3E2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01222) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01222 = Gx_err
               THISFORM.GX_DB_GetW01222_01 ()
            ENDDO
         ENDIF
      ENDPROC
