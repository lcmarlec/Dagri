      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T009420" , @HStmt_T009420 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TREMING","T009420","",GX_CURSOR_TYPE_READONLY,@HStmt_T009420) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [RORNroInt], [RORLin], [RORLugCod] AS RORLugCod, [RorAba], [RorTrans], "
                  cmdbuf = cmdbuf + "  [RorTemp], [RorLinea], [RorFamAso], [RorSubAso], [RorArtAso], [ROROCoNI], [FamCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod], [ArtCod], [RorArtCpr], [RORCnt], [RORCntFac], [RORPrcOri], [RORLes], "
                  cmdbuf = cmdbuf + "  [RorLotNro], [RorLotFch], [RorLotVnc], [RorLObs], [RorProt], [ROROcoCnt], [RorFchPac], "
                  cmdbuf = cmdbuf + "  [RorCntPend] FROM [REMING1] (NOLOCK) WHERE [EmpCod] = ? AND [RORNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [RORNroInt], [RORLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T009420,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T009420,12)
                  THISFORM.GX_DB_BindColsT009420_01 ()
                  THISFORM.GX_DB_BindParmT009420_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T009420,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA881RORNro = THISFORM.A881RORNro
               Gx_err = GX_DB_SetDouble( HStmt_T009420,2,@AuxA881RORNro,0)
               THISFORM.A881RORNro = AuxA881RORNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T009420) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009420 = Gx_err
               THISFORM.GX_DB_GetT009420_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T009420 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009420) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T009420 = Gx_err
                  THISFORM.GX_DB_GetT009420_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T009420 <> 101
               BRK2M99 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT94S21.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T009420_881RORNroInt = THISFORM.A881RORNro .AND. THISFORM.Buf_T009420_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009420) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009420 = Gx_err
               THISFORM.GX_DB_GetT009420_01 ()
            ENDDO
         ENDIF
      ENDPROC
