      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S881RORNro
         LOCAL S893RORLin
         S2EmpCod = THISFORM.A2EmpCod
         S881RORNro = THISFORM.A881RORNro
         S893RORLin = THISFORM.A893RORLin
         THISFORM.A893RORLin = THISFORM.M893RORLin
         THISFORM. cCT94S21 .SaveTemp()
         THISFORM. cCT94S21 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT94S21 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT94S21 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT94S21 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S881RORNro = THISFORM.A881RORNro .AND. S893RORLin = THISFORM.A893RORLin
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT94S21 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT94S21 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S881RORNro = THISFORM.A881RORNro .AND. S893RORLin = THISFORM.A893RORLin
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT94S21 .Refresh()
               THISFORM. cCT94S21 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A881RORNro = S881RORNro
               THISFORM.A893RORLin = S893RORLin
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT94S21 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT94S21 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S881RORNro = THISFORM.A881RORNro .AND. S893RORLin = THISFORM.A893RORLin
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT94S21 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S881RORNro = THISFORM.A881RORNro .AND. S893RORLin = THISFORM.A893RORLin
            ENDDO
            IF sf_err != 0
               THISFORM. cCT94S21 .AppendRow()
               THISFORM. cCT94S21 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A881RORNro = S881RORNro
               THISFORM.A893RORLin = S893RORLin
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A881RORNro = S881RORNro
         THISFORM.A893RORLin = S893RORLin
         RETURN .F.
      ENDFUNC
