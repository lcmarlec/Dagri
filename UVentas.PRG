      PROCEDURE CreateTemp
         LOCAL SCW166S3
         SCW166S3 = ""
         IF USED( "SCW166S3" )
            SELECT SCW166S3
            SCW166S3 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW166S3
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "VAV14Objet"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV8Titulo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW166S3 = GETE('z:\temp') + '\' + SCW166S3
            ENDIF
            CREATE DBF (SCW166S3) FROM ARRAY GX_STRUCT
            USE
            USE (SCW166S3) EXCLUSIVE ALIAS SCW166S3
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW166S3
         THIS.GX_SfAlias = "SCW166S3"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               GX_SFLOAD = 0
               THISFORM.U15V4M2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
      PROCEDURE LoadFromTbl
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV14Objet WITH THISFORM.AV14Objeto
         REPLACE VAV8Titulo WITH THISFORM.AV8Titulo
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV14Objeto = VAV14Objet
         THISFORM.AV8Titulo = VAV8Titulo
      ENDPROC
