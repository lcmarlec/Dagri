         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW73V12.ISVALID" )
         THISFORM.AV35GXLvl1 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00732" , @HStmt_W00732 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLISCCC","W00732","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00732) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntEsp], [EntRaz] FROM [ENTID] (NOLOCK) "
            cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ? and [EntGruTip] = 'PR' and [EntCod] = ?) AND ([EntEsp] <> 'S' "
            cmdbuf = cmdbuf + "  or ? = 9) ORDER BY [EmpCod], [EntGruTip], [EntCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00732,cmdbuf)
            THISFORM.GX_DB_BindColsW00732_01 ()
            THISFORM.GX_DB_BindParmW00732_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00732,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV12Despro = THISFORM.AV12Despro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00732,2,@AuxAV12Despro,0)
         THISFORM.AV12Despro = AuxAV12Despro
         AuxAV24Autniv = THISFORM.AV24Autniv
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00732,3,@AuxAV24Autniv,0)
         THISFORM.AV24Autniv = AuxAV24Autniv
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00732) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00732 = Gx_err
