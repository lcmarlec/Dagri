                     ENDIF
                  ENDIF
                  THISFORM. cCT46A529 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT46A494 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
