                  ENDDO
                  THISFORM.T00463 = Gx_err
                  THISFORM.GX_DB_GetT00463_01 ()
                  THISFORM. cCT46A497 . ZM1A48 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC1A48 ()
               THISFORM. cCT46A497 . ZM1A48 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1A48 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT46A529 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE1A48 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1A48 ()
                  RETURN
               ENDIF
               THISFORM.cCT46A497.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00463) , "TDV1000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00462) , "TDV1000" )
