                  ENDDO
                  THISFORM.T00343 = Gx_err
                  THISFORM.GX_DB_GetT00343_01 ()
                  THISFORM. cCT34A336 . ZM0Y31 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0Y31 ()
               THISFORM. cCT34A336 . ZM0Y31 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0Y31 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT34A338 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0Y31 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0Y31 ()
                  RETURN
               ENDIF
               THISFORM.cCT34A336.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00343) , "TDC1500" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00342) , "TDC1500" )
