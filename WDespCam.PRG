      PROCEDURE CreateTemp
         LOCAL SCW1265S14
         SCW1265S14 = ""
         IF USED( "SCW1265S14" )
            SELECT SCW1265S14
            SCW1265S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1265S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA3359CarR"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3357CarF"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3670CarH"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3356CarN"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 15
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3722CarN"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3733PatF"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 10
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA2EmpCod"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 4
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1265S14 = GETE('z:\temp') + '\' + SCW1265S14
            ENDIF
            CREATE DBF (SCW1265S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1265S14) EXCLUSIVE ALIAS SCW1265S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1265S14
         THIS.GX_SfAlias = "SCW1265S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12652" , @HStmt_W12652 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESPCAM","W12652","",GX_CURSOR_TYPE_READONLY,@HStmt_W12652) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[CarNroFin], T1.[EmpCod], T1.[CarNro], T1.[CarFinObs], T1.[PatFin], T2.[CarHor], "
                  cmdbuf = cmdbuf + "  T2.[CarFch], T2.[CarRut] FROM ([CARGAFIN] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CARGA] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[CarNro] = T1.[CarNro]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[CarNro] = ? ORDER BY T1.[EmpCod], T1.[CarNro], T1.[CarNroFin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12652,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12652,13)
                  THISFORM.GX_DB_BindColsW12652_01 ()
                  THISFORM.GX_DB_BindParmW12652_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12652,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV31Carnro = THISFORM.AV31Carnro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12652,2,AuxAV31Carnro,15,0)
               THISFORM.AV31Carnro = AuxAV31Carnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12652 = Gx_err
               THISFORM.GX_DB_GetW12652_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV39Pgmnam = "WDespCam"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12652 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12652 <> 101
               BRKVZ52 = .F.
               THISFORM.A3722CarNr = THISFORM.Buf_W12652_3722CarNroFi
               THISFORM.A2EmpCod = THISFORM.Buf_W12652_2EmpCod
               THISFORM.A3356CarNr = THISFORM.Buf_W12652_3356CarNro
               THISFORM.A3744CarFO = THISFORM.Buf_W12652_3744CarFObs
               THISFORM.A3733PatFi = THISFORM.Buf_W12652_3733PatFin
               THISFORM.A3670CarHo = THISFORM.Buf_W12652_3670CarHor
               THISFORM.A3357CarFc = THISFORM.Buf_W12652_3357CarFch
               THISFORM.A3359CarRu = THISFORM.Buf_W12652_3359CarRut
               THISFORM.A3670CarHo = THISFORM.Buf_W12652_3670CarHor
               THISFORM.A3357CarFc = THISFORM.Buf_W12652_3357CarFch
               THISFORM.A3359CarRu = THISFORM.Buf_W12652_3359CarRut
               GX_SFLOAD = 0
               THISFORM.U14VZ52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKVZ52
                  BRKVZ52 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12652) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12652 = Gx_err
                  THISFORM.GX_DB_GetW12652_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
