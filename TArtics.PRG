         THISFORM.A10ArtCprA = THISFORM.M10ArtCprA
         THISFORM.A27ArtCprO = THISFORM.M27ArtCprO
         THISFORM.A7ArtCprGr = THISFORM.M7ArtCprGr
         THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .SaveTemp()
         THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
         Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
            Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .Refresh()
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.A7ArtCprGr = S7ArtCprGr
               THISFORM.A8ArtCprCo = S8ArtCprCo
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
            Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
               Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
            ENDDO
            IF sf_err != 0
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .AppendRow()
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.A7ArtCprGr = S7ArtCprGr
               THISFORM.A8ArtCprCo = S8ArtCprCo
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A3FamCod = S3FamCod
         THISFORM.A4FamSubCo = S4FamSubCo
         THISFORM.A5ArtCod = S5ArtCod
         THISFORM.A7ArtCprGr = S7ArtCprGr
         THISFORM.A8ArtCprCo = S8ArtCprCo
         RETURN .F.
      ENDFUNC
