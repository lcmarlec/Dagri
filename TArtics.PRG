      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T000318" , @HStmt_T000318 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTICS","T000318","",GX_CURSOR_TYPE_READONLY,@HStmt_T000318) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCprGrT] AS ArtCprGrT, [ArtCprCod] "
                  cmdbuf = cmdbuf + "  AS ArtCprCod, [ArtCprArt], [ArtCprObs] FROM [ARTICS1] (NOLOCK) WHERE [EmpCod] = "
                  cmdbuf = cmdbuf + "  ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] = ? ORDER BY [EmpCod], [FamCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod], [ArtCod], [ArtCprGrT], [ArtCprCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T000318,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T000318,12)
                  THISFORM.GX_DB_BindColsT000318_01 ()
                  THISFORM.GX_DB_BindParmT000318_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T000318,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T000318,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T000318,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T000318,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T000318) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T000318 = Gx_err
               THISFORM.GX_DB_GetT000318_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T000318 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T000318) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T000318 = Gx_err
                  THISFORM.GX_DB_GetT000318_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T000318 <> 101
               BRK031 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT3Tb10.cCT3Pg94Tb10.cCT3S101.Columns(5).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T000318_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T000318) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T000318 = Gx_err
               THISFORM.GX_DB_GetT000318_01 ()
            ENDDO
         ENDIF
      ENDPROC
