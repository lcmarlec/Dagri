      PROCEDURE CreateTemp
         LOCAL SCT3S101
         SCT3S101 = ""
         IF USED( "SCT3S101" )
            SELECT SCT3S101
            SCT3S101 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT3S101
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA8ArtCprC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA9ArtCprN"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA10ArtCpr"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA27ArtCpr"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 80
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA7ArtCprG"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 2
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT3S101 = GETE('z:\temp') + '\' + SCT3S101
            ENDIF
            CREATE DBF (SCT3S101) FROM ARRAY GX_STRUCT
            USE
            USE (SCT3S101) EXCLUSIVE ALIAS SCT3S101
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT3S101
         THIS.GX_SfAlias = "SCT3S101"
      ENDPROC
