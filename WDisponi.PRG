         LOCAL gx_old_event
         THISFORM.SetEvent( "'CUENTA'" )
         * 'CUENTA' Routine
         THISFORM.AV43GXLvl6 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05372" , @HStmt_W05372 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDISPONI","W05372","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05372) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[BcoCod], T1.[BcoCta], T1.[BcoCtaNro], T2.[BcoDsc] FROM ([CTAS] T1 (NOLOCK) "
            cmdbuf = cmdbuf + "  LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[BcoCod]) WHERE T1.[BcoCta] = "
            cmdbuf = cmdbuf + "  ? ORDER BY T1.[BcoCta]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05372,cmdbuf)
            THISFORM.GX_DB_BindColsW05372_01 ()
            THISFORM.GX_DB_BindParmW05372_01 ()
         ENDIF
         AuxAV28Ctacod = THISFORM.AV28Ctacod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05372,1,@AuxAV28Ctacod,0)
         THISFORM.AV28Ctacod = AuxAV28Ctacod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05372) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05372 = Gx_err
         THISFORM.GX_DB_GetW05372_01 ()
         DO WHILE THISFORM.W05372 <> 101
            THISFORM.A86BcoCod = THISFORM.Buf_W05372_86BcoCod
            THISFORM.A76BcoCta = THISFORM.Buf_W05372_76BcoCta
            THISFORM.A77BcoCtaN = THISFORM.Buf_W05372_77BcoCtaNro
            THISFORM.A87BcoDsc = THISFORM.Buf_W05372_87BcoDsc
            THISFORM.A87BcoDsc = THISFORM.Buf_W05372_87BcoDsc
            THISFORM.AV43GXLvl6 = 1
            THISFORM.AV29Ctanro = THISFORM.A77BcoCtaN
            THISFORM.AV30Ctabco = THISFORM.A87BcoDsc
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05372) ,  ,  ,  , CS_SQLSRV ,  )
