               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11893" , @HStmt_W11893 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCOBVA","W11893","",GX_CURSOR_TYPE_READONLY,@HStmt_W11893) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DcVNroInt], [DcVEntGruT], [DcVEst], [DcvTipRed], [EmpCod], [DcvCtaCliC], "
                  cmdbuf = cmdbuf + "  [DcvMonCod], [DcVTotSld], [DcVTot], [DcVSig], [DcvCotiz], [DcVNro], [DcVSuc], [DcVSer], "
                  cmdbuf = cmdbuf + "  [DcVTip], [DcVFch], [DcVEntCod] FROM [DCVENT] (NOLOCK) WHERE ([EmpCod] = ? and [DcvCtaCliC] "
                  cmdbuf = cmdbuf + "  = ? and [DcVEst] = 1) AND ([DcVFch] >= ?) AND ([DcVEntCod] > 0) AND ([DcVEntGruT] "
                  cmdbuf = cmdbuf + "  = 'CL') AND ([DcvTipRed] <> 'AJ' or [DcVNro] >= 63) ORDER BY [EmpCod], [DcvCtaCliC], "
                  cmdbuf = cmdbuf + "  [DcVEst], [DcVSuc], [DcvTipRed] DESC, [DcVFch], [DcVNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11893,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11893,14)
                  THISFORM.GX_DB_BindColsW11893_01 ()
                  THISFORM.GX_DB_BindParmW11893_01 ()
