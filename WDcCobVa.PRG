      ***********************
      PROCEDURE cCW1189V5.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW1189V5.ISVALID" )
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11894" , @HStmt_W11894 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCOBVA","W11894","",GX_CURSOR_TYPE_READONLY,@HStmt_W11894) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[RCVNroLin], T1.[RCVNroI], T1.[RCVNroIImp], T1.[EmpCod], T2.[RCVFch], T2.[RCVTip] "
            cmdbuf = cmdbuf + "  FROM ([RECIBOS1] T1 (NOLOCK) LEFT JOIN [RECIBOS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
            cmdbuf = cmdbuf + "  AND T2.[RCVNroI] = T1.[RCVNroI]) WHERE (T1.[EmpCod] = ?) AND (T2.[RCVFch] > ?) AND "
            cmdbuf = cmdbuf + "  (T2.[RCVTip] = 'RCVT') ORDER BY T1.[EmpCod], T1.[RCVNroI], T1.[RCVNroLin]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11894,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11894,14)
            THISFORM.GX_DB_BindColsW11894_01 ()
            THISFORM.GX_DB_BindParmW11894_01 ()
         ENDIF
         AuxAV7Emprcod = THISFORM.AV7Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11894,1,@AuxAV7Emprcod,0)
         THISFORM.AV7Emprcod = AuxAV7Emprcod
         AuxAV5Fechasi = THISFORM.AV5Fechasi
         THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11894,2,@AuxAV5Fechasi,0)
         THISFORM.AV5Fechasi = AuxAV5Fechasi
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11894) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W11894 = Gx_err
         THISFORM.GX_DB_GetW11894_01 ()
         DO WHILE THISFORM.W11894 <> 101
            THISFORM.A858RCVNro = THISFORM.Buf_W11894_858RCVNroI
            THISFORM.A870RCVNro = THISFORM.Buf_W11894_870RCVNroIImp
            THISFORM.A2EmpCod = THISFORM.Buf_W11894_2EmpCod
            THISFORM.A859RCVFch = THISFORM.Buf_W11894_859RCVFch
            THISFORM.A865RCVTip = THISFORM.Buf_W11894_865RCVTip
            THISFORM.A859RCVFch = THISFORM.Buf_W11894_859RCVFch
            THISFORM.A865RCVTip = THISFORM.Buf_W11894_865RCVTip
            IF THISFORM.A870RCVNro = THISFORM.A415DcVNro
               DO GX_ERRMW WITH "Existen recibos posteriores a la fecha"
               THISFORM.AV5Fechasi = THISFORM.A859RCVFch
               THISFORM.cCW1189V5.GXSetFocus( )
               * Exit For each command. Update data (if necessary), close cursors & exit.
               EXIT
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11894) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W11894 = Gx_err
            THISFORM.GX_DB_GetW11894_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W11894) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV5Fechasi > THISFORM.AV37Fecha
            DO GX_ERRMW WITH "No se puede generar recibos con fecha posterior al del sistema"
            THISFORM.AV5Fechasi = THISFORM.AV37Fecha
            THISFORM.cCW1189V5.GXSetFocus( )
         ENDIF
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

