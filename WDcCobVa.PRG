               THIS.GX_CUPOS = 0
               THISFORM.AV80Pgmnam = "WDcCobVa"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11893 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11893) ,  ,  ,  , CS_SQLSRV ,  )
