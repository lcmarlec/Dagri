            THISFORM.A946RetSuc = 0
            THISFORM.A943RetEnt = SPACE(40)
            THISFORM.A942RetEnt = 0
            THISFORM.A941RetEnt = SPACE(2)
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
      RETURN .T.
