               THISFORM.GX_DB_GetW04802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04802 = Gx_err
                  THISFORM.GX_DB_GetW04802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04802 <> 101
               BRKVDC2 = .F.
               THISFORM.A962RetNro = THISFORM.Buf_W04802_962RetNroCtr
               THISFORM.A938RetFch = THISFORM.Buf_W04802_938RetFch
               THISFORM.A961RetDsc = THISFORM.Buf_W04802_961RetDsc
