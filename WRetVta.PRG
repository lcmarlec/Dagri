               THISFORM.A943RetEnt = THISFORM.Buf_W04802_943RetEntRaz
               THISFORM.A942RetEnt = THISFORM.Buf_W04802_942RetEntCod
               THISFORM.A941RetEnt = THISFORM.Buf_W04802_941RetEntGruT
               THISFORM.A961RetDsc = THISFORM.Buf_W04802_961RetDsc
               THISFORM.A943RetEnt = THISFORM.Buf_W04802_943RetEntRaz
               GX_SFLOAD = 1
               THISFORM.U13VDC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
         IF GX_CUERR != 0
            THISFORM.AV5Emprnom = SPACE(30)
            THISFORM.A962RetNro = 0
            THISFORM.A938RetFch = CTOD("  /  /  ")
            THISFORM.A961RetDsc = SPACE(20)
            THISFORM.A944RetTip = SPACE(6)
