      PROCEDURE CreateTemp
         LOCAL SCW1203S20
         SCW1203S20 = ""
         IF USED( "SCW1203S20" )
            SELECT SCW1203S20
            SCW1203S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1203S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA166EntCu"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 11
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2536IBED"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2537IBEH"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2538IBEP"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW1203S20 = GETE('z:\temp') + '\' + SCW1203S20
            ENDIF
            CREATE DBF (SCW1203S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1203S20) EXCLUSIVE ALIAS SCW1203S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1203S20
         THIS.GX_SfAlias = "SCW1203S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12032" , @HStmt_W12032 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07U0","W12032","",GX_CURSOR_TYPE_READONLY,@HStmt_W12032) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [IBExe], [IBETpo], [IBEPor], [IBEHta], [IBEDde], [EntCui], [EmpCod] FROM [IBESP1] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [EntCui] >= ? and [IBEDde] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([IBETpo] like ?) AND ([IBEHta] >= ?) AND ([IBEPor] >= ?) AND ([IBExe] >= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY [EmpCod], [EntCui], [IBEDde], [IBETpo]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12032,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12032,9)
                  THISFORM.GX_DB_BindColsW12032_01 ()
                  THISFORM.GX_DB_BindParmW12032_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12032,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C166 = THISFORM.AV6C166
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W12032,2,@AuxAV6C166,0)
               THISFORM.AV6C166 = AuxAV6C166
               AuxAV7C2536 = THISFORM.AV7C2536
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12032,3,@AuxAV7C2536,0)
               THISFORM.AV7C2536 = AuxAV7C2536
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12032,4,PADR( TRIM(THISFORM.AV8C2535),1, '%'),LEN(PADR( TRIM(THISFORM.AV8C2535),1, '%')),0)
               AuxAV9C2537 = THISFORM.AV9C2537
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12032,5,@AuxAV9C2537,0)
               THISFORM.AV9C2537 = AuxAV9C2537
               AuxAV10C2538 = THISFORM.AV10C2538
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W12032,6,@AuxAV10C2538,0)
               THISFORM.AV10C2538 = AuxAV10C2538
               AuxAV11C3470 = THISFORM.AV11C3470
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12032,7,@AuxAV11C3470,0)
               THISFORM.AV11C3470 = AuxAV11C3470
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12032 = Gx_err
               THISFORM.GX_DB_GetW12032_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12032 = Gx_err
                  THISFORM.GX_DB_GetW12032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12032 <> 101
               BRKVXF2 = .F.
               THISFORM.A3470IBExe = THISFORM.Buf_W12032_3470IBExe
               THISFORM.A2535IBETp = THISFORM.Buf_W12032_2535IBETpo
               THISFORM.A2538IBEPo = THISFORM.Buf_W12032_2538IBEPor
               THISFORM.A2537IBEHt = THISFORM.Buf_W12032_2537IBEHta
               THISFORM.A2536IBEDd = THISFORM.Buf_W12032_2536IBEDde
               THISFORM.A166EntCui = THISFORM.Buf_W12032_166EntCui
               THISFORM.A2EmpCod = THISFORM.Buf_W12032_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VXF2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12032 = Gx_err
               THISFORM.GX_DB_GetW12032_01 ()
            ENDDO
         ENDIF
      ENDPROC
