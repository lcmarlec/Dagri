PROCEDURE HLCB2
***********************

   PARAMETERS Key_read, Attrinum
   PRIVATE GXLToBD
   GXLToBD = GXToBeDone
   GXToBeDone = ""
   DO CASE
      CASE Key_read <> 7 .AND. Key_read <> 8
         RETURN
      CASE Key_read = 8
         SET TOPIC TO  [PFBFnc]
         HELP
      OTHERWISE
         SET TOPIC TO  [PFBFnc]
         HELP
   ENDCASE
RETURN
