         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A1654CPCle"
         THISFORM.cCW533S17 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW533S17 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW533S17 .GX_lastkey = 9.or. THISFORM.cCW533S17 .GX_lastkey = 13) .AND. ! MDOWN()
            IF ! THISFORM.cCW533S17 .GridValidObj( THISFORM.cCW533S17 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW533S17 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW533S17 .gx_can_changerow = .T.
