      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05332" , @HStmt_W05332 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0581","W05332","",GX_CURSOR_TYPE_READONLY,@HStmt_W05332) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CPPaiCod], [CPPciCod], [CPPConf], [CPClear], [CPLocal], [CPCod] "
                  cmdbuf = cmdbuf + "  FROM [CODPOS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND ([CPCod] like ?) AND "
                  cmdbuf = cmdbuf + "  ([CPClear] >= ?) AND ([CPPaiCod] like ?) AND ([CPPciCod] like ?) AND ([CPPConf] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [EmpCod], [CPCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05332,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05332,9)
                  THISFORM.GX_DB_BindColsW05332_01 ()
                  THISFORM.GX_DB_BindParmW05332_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05332,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05332,2,PADR( TRIM(THISFORM.AV5C1652),8, '%'),LEN(PADR( TRIM(THISFORM.AV5C1652),8, '%')),0)
               AuxAV6C1654 = THISFORM.AV6C1654
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05332,3,@AuxAV6C1654,0)
               THISFORM.AV6C1654 = AuxAV6C1654
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05332,4,PADR( TRIM(THISFORM.AV7C1656),4, '%'),LEN(PADR( TRIM(THISFORM.AV7C1656),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05332,5,PADR( TRIM(THISFORM.AV8C1658),4, '%'),LEN(PADR( TRIM(THISFORM.AV8C1658),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05332,6,PADR( TRIM(THISFORM.AV9C1675),1, '%'),LEN(PADR( TRIM(THISFORM.AV9C1675),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05332 = Gx_err
               THISFORM.GX_DB_GetW05332_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05332 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05332) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05332 = Gx_err
                  THISFORM.GX_DB_GetW05332_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05332 <> 101
               BRKVET2 = .F.
               THISFORM.A1656CPPai = THISFORM.Buf_W05332_1656CPPaiCod
               THISFORM.A1658CPPci = THISFORM.Buf_W05332_1658CPPciCod
               THISFORM.A1675CPPCo = THISFORM.Buf_W05332_1675CPPConf
               THISFORM.A1654CPCle = THISFORM.Buf_W05332_1654CPClear
               THISFORM.A1653CPLoc = THISFORM.Buf_W05332_1653CPLocal
               THISFORM.A1652CPCod = THISFORM.Buf_W05332_1652CPCod
               GX_SFLOAD = 0
               THISFORM.U12VET2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05332 = Gx_err
               THISFORM.GX_DB_GetW05332_01 ()
            ENDDO
         ENDIF
      ENDPROC
