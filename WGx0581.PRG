            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW533S17 = GETE('z:\temp') + '\' + SCW533S17
            ENDIF
            CREATE DBF (SCW533S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCW533S17) EXCLUSIVE ALIAS SCW533S17
