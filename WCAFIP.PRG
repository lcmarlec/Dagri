      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11112" , @HStmt_W11112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAFIP","W11112","",GX_CURSOR_TYPE_READONLY,@HStmt_W11112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CACotiz], [CACAE], [CATot], [CAIVA], [CAExe], [CANoGrav], [CAGrav], [CAYa], "
                  cmdbuf = cmdbuf + "  [CAMon], [CAFch], [CACUIT], [CANro], [CASuc], [CATipo] FROM [COMPAFIP] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE (( [CACUIT] = ? and ( [CATipo] = ? or [CATipo] = ?)) or ( [CASuc] "
                  cmdbuf = cmdbuf + "  = ? and [CANro] = ?)) AND ([CAYa] = 0) ORDER BY [CACUIT], [CATipo], [CASuc], [CANro] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11112,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11112,12)
                  THISFORM.GX_DB_BindColsW11112_01 ()
                  THISFORM.GX_DB_BindParmW11112_01 ()
               ENDIF
               AuxAV29Entcui = THISFORM.AV29Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W11112,1,@AuxAV29Entcui,0)
               THISFORM.AV29Entcui = AuxAV29Entcui
               AuxAV30I = THISFORM.AV30I
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11112,2,@AuxAV30I,0)
               THISFORM.AV30I = AuxAV30I
               AuxAV40I1 = THISFORM.AV40I1
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11112,3,@AuxAV40I1,0)
               THISFORM.AV40I1 = AuxAV40I1
               AuxAV26Tdcsuc = THISFORM.AV26Tdcsuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11112,4,@AuxAV26Tdcsuc,0)
               THISFORM.AV26Tdcsuc = AuxAV26Tdcsuc
               AuxAV25Tdcnro = THISFORM.AV25Tdcnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11112,5,@AuxAV25Tdcnro,0)
               THISFORM.AV25Tdcnro = AuxAV25Tdcnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11112 = Gx_err
               THISFORM.GX_DB_GetW11112_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV50Pgmnam = "WCAFIP"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11112) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11112 = Gx_err
                  THISFORM.GX_DB_GetW11112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11112 <> 101
               BRKVUV2 = .F.
               THISFORM.A3291CACot = THISFORM.Buf_W11112_3291CACotiz
               THISFORM.A3289CACAE = THISFORM.Buf_W11112_3289CACAE
               THISFORM.A3296CATot = THISFORM.Buf_W11112_3296CATot
               THISFORM.A3295CAIVA = THISFORM.Buf_W11112_3295CAIVA
               THISFORM.A3294CAExe = THISFORM.Buf_W11112_3294CAExe
               THISFORM.A3293CANoG = THISFORM.Buf_W11112_3293CANoGrav
               THISFORM.A3292CAGra = THISFORM.Buf_W11112_3292CAGrav
               THISFORM.A3299CAYa = THISFORM.Buf_W11112_3299CAYa
               THISFORM.A3290CAMon = THISFORM.Buf_W11112_3290CAMon
               THISFORM.A3288CAFch = THISFORM.Buf_W11112_3288CAFch
               THISFORM.A3284CACUI = THISFORM.Buf_W11112_3284CACUIT
               THISFORM.A3287CANro = THISFORM.Buf_W11112_3287CANro
               THISFORM.A3286CASuc = THISFORM.Buf_W11112_3286CASuc
               THISFORM.A3285CATip = THISFORM.Buf_W11112_3285CATipo
               GX_SFLOAD = 0
               THISFORM.U14VUV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11112 = Gx_err
               THISFORM.GX_DB_GetW11112_01 ()
            ENDDO
         ENDIF
