               ENDDO
               THISFORM.W05092 = Gx_err
               THISFORM.GX_DB_GetW05092_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV42Pgmnam = "WDifND"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05092 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05092) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05092 = Gx_err
                  THISFORM.GX_DB_GetW05092_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05092 <> 101
               BRKVE52 = .F.
               THISFORM.AV33Dcvnro = 0
               THISFORM.AV25Cantid = 0.0000
               THISFORM.AV24Precio = 0.0000
               THISFORM.AV39Ok = SPACE(1)
               THISFORM.A3FamCod = THISFORM.Buf_W05092_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W05092_4FamSubCod
               THISFORM.A5ArtCod = THISFORM.Buf_W05092_5ArtCod
               THISFORM.A1565DifMo = THISFORM.Buf_W05092_1565DifMotCod
               THISFORM.A1552DifEx = THISFORM.Buf_W05092_1552DifExpFcSe
               THISFORM.A1538DifND = THISFORM.Buf_W05092_1538DifND
               THISFORM.A1546DifND = THISFORM.Buf_W05092_1546DifNDNi
               THISFORM.A1554DifEx = THISFORM.Buf_W05092_1554DifExpFcNr
               THISFORM.A1553DifEx = THISFORM.Buf_W05092_1553DifExpFcSu
               THISFORM.A1541DifRu = THISFORM.Buf_W05092_1541DifRutNro
               THISFORM.A1529DifNI = THISFORM.Buf_W05092_1529DifNI
               THISFORM.A1544DifTp = THISFORM.Buf_W05092_1544DifTpo
               THISFORM.A2EmpCod = THISFORM.Buf_W05092_2EmpCod
               THISFORM.A1566DifMo = THISFORM.Buf_W05092_1566DifMotDsc
               THISFORM.A1561DifAr = THISFORM.Buf_W05092_1561DifArtPrc
               THISFORM.A1548DifAr = THISFORM.Buf_W05092_1548DifArtCnt
               THISFORM.A1559DifCl = THISFORM.Buf_W05092_1559DifCliCod
               THISFORM.A1558DifCl = THISFORM.Buf_W05092_1558DifCliGruT
               THISFORM.A6ArtDsc = THISFORM.Buf_W05092_6ArtDsc
               THISFORM.A1532DifAr = THISFORM.Buf_W05092_1532DifArtCod
               THISFORM.A1531DifFa = THISFORM.Buf_W05092_1531DifFamSCod
               THISFORM.A1530DifFa = THISFORM.Buf_W05092_1530DifFamCod
               THISFORM.A1566DifMo = THISFORM.Buf_W05092_1566DifMotDsc
               GX_SFLOAD = 0
               THISFORM.U17VE52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05092 = Gx_err
               THISFORM.GX_DB_GetW05092_01 ()
            ENDDO
         ENDIF
