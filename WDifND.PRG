      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05092" , @HStmt_W05092 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDIFND","W05092","",GX_CURSOR_TYPE_READONLY,@HStmt_W05092) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T3.[FamCod], T3.[FamSubCod], T3.[ArtCod], T1.[DifMotCod], T1.[DifExpFcSe], "
                  cmdbuf = cmdbuf + "  T1.[DifND], T1.[DifNDNi], T1.[DifExpFcNr], T1.[DifExpFcSu], T1.[DifRutNro], T1.[DifNI], "
                  cmdbuf = cmdbuf + "  T1.[DifTpo], T1.[EmpCod], T2.[DifMotDsc], T1.[DifArtPrc], T1.[DifArtCnt], T1.[DifCliCod], "
                  cmdbuf = cmdbuf + "  T1.[DifCliGruT], T3.[ArtDsc], T1.[DifArtCod], T1.[DifFamSCod], T1.[DifFamCod] FROM "
                  cmdbuf = cmdbuf + "  (([DIFER] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [DIFMOT] T2 (NOLOCK) ON T2.[DifMotCod] "
                  cmdbuf = cmdbuf + "  = T1.[DifMotCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[FamCod] = T1.[DifFamCod] AND T3.[FamSubCod] = T1.[DifFamSCod] AND T3.[ArtCod] "
                  cmdbuf = cmdbuf + "  = T1.[DifArtCod]) WHERE (T1.[EmpCod] = ? and T1.[DifRutNro] = ? and T1.[DifExpFcSu] "
                  cmdbuf = cmdbuf + "  = ? and T1.[DifExpFcNr] = ?) AND (T1.[DifExpFcSe] = ?) AND (T1.[DifND] = 'S') AND "
                  cmdbuf = cmdbuf + "  (T1.[DifNDNi] = 0) AND (T1.[DifArtCnt] > 0) ORDER BY T1.[EmpCod], T1.[DifRutNro], "
                  cmdbuf = cmdbuf + "  T1.[DifExpFcSu], T1.[DifExpFcNr]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05092,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05092,13)
                  THISFORM.GX_DB_BindColsW05092_01 ()
                  THISFORM.GX_DB_BindParmW05092_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05092,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV36Chfcod = THISFORM.AV36Chfcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05092,2,@AuxAV36Chfcod,0)
               THISFORM.AV36Chfcod = AuxAV36Chfcod
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05092,3,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV21Desnro = THISFORM.AV21Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05092,4,@AuxAV21Desnro,0)
               THISFORM.AV21Desnro = AuxAV21Desnro
               AuxAV22Serie = THISFORM.AV22Serie
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05092,5,AuxAV22Serie,1,0)
               THISFORM.AV22Serie = AuxAV22Serie
               Gx_eop = 1
               DO WHILE Gx_eop != 0
