      ***********************
      PROCEDURE U18VE52
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'PROVEEDOR'" )
         * 'PROVEEDOR' Routine
         THISFORM.AV47GXLvl8 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05094" , @HStmt_W05094 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDIFND","W05094","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05094) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T2.[EntRaz] AS ChfEntRaz, T1.[ChfEntCod] AS ChfEntCod, T1.[ChfEntGruT] AS "
            cmdbuf = cmdbuf + "  ChfEntGruT, T1.[EmpCod] FROM ([CHFTAR] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
            cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[ChfEntGruT] AND T2.[EntCod] "
            cmdbuf = cmdbuf + "  = T1.[ChfEntCod]) WHERE T1.[EmpCod] = ? and T1.[ChfEntGruT] = 'PR' and T1.[ChfEntCod] "
            cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[ChfEntGruT], T1.[ChfEntCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05094,cmdbuf)
            THISFORM.GX_DB_BindColsW05094_01 ()
            THISFORM.GX_DB_BindParmW05094_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05094,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV19Desprv = THISFORM.AV19Desprv
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05094,2,@AuxAV19Desprv,0)
         THISFORM.AV19Desprv = AuxAV19Desprv
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05094) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05094 = Gx_err
         THISFORM.GX_DB_GetW05094_01 ()
         DO WHILE THISFORM.W05094 <> 101
            THISFORM.A1551ChfEn = THISFORM.Buf_W05094_1551ChfEntRaz
            THISFORM.A1550ChfEn = THISFORM.Buf_W05094_1550ChfEntCod
            THISFORM.A1549ChfEn = THISFORM.Buf_W05094_1549ChfEntGruT
            THISFORM.A2EmpCod = THISFORM.Buf_W05094_2EmpCod
            THISFORM.A1551ChfEn = THISFORM.Buf_W05094_1551ChfEntRaz
            THISFORM.AV47GXLvl8 = 1
            THISFORM.AV23Entraz = THISFORM.A1551ChfEn
            THISFORM.AV35Rutcod = THISFORM.AV36Chfcod
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05094) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV47GXLvl8 = 0
            THISFORM.AV23Entraz = "Proveedor No Encontrado"
         ENDIF
