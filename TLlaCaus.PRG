                  cmdbuf = cmdbuf + "  [LlaApe], [LlaMarCod], [LlaTReCod], [LlaEst], [LlaPrd], [LlaLote], [LlaVnc], [LlaCau], "
                  cmdbuf = cmdbuf + "  [LlaTel1], [LLaTT1], [LlaTel2], [LlaTT2], [LlaDir], [LlaLoc], [LlaLocal], [LlaLinU], "
                  cmdbuf = cmdbuf + "  [LlaTip], [LlaEntGru], [LlaEntCod], [LlaentLg], [FamCod], [FamSubCod], [ArtCod], "
                  cmdbuf = cmdbuf + "  [LlaCnt], [LlaMues], [LlaMedCom], [LlaRecep], [LlaFchInc], [LlaACOK], [LlaAcNok], "
                  cmdbuf = cmdbuf + "  [LlaAcF], [LlaAPOk], [LlaAPNok], [LlaAPF], [LlaAcSol], [LlaAcSF], [LlaApSiNo], [LlaIno], "
                  cmdbuf = cmdbuf + "  [LLaEmi], [LlaRes], [LlaAut]) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
                  cmdbuf = cmdbuf + "  ' ', ' ', ' ', ' ', ' ', ' ', ' ', convert(int, 0), ' ', ' ', convert(int, 0), convert(int, "
                  cmdbuf = cmdbuf + "  0), convert(int, 0), convert(int, 0), convert(int, 0), convert(int, 0), ' ', ' ', "
                  cmdbuf = cmdbuf + "  ' ', convert( DATETIME, '17530101', 112 ), convert(int, 0), convert(int, 0), convert( "
                  cmdbuf = cmdbuf + "  DATETIME, '17530101', 112 ), convert(int, 0), convert(int, 0), convert( DATETIME, "
                  cmdbuf = cmdbuf + "  '17530101', 112 ), ' ', convert( DATETIME, '17530101', 112 ), ' ', convert(int, "
