      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02082" , @HStmt_W02082 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00P0","W02082","",GX_CURSOR_TYPE_READONLY,@HStmt_W02082) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CLNomFan], [CLDomLeg], [CLPrvLeg], [CLTelCom], [CLCPoLeg], [CLRazCli], [CLCodCli] "
                  cmdbuf = cmdbuf + "  FROM [DBCL0000] (FASTFIRSTROW NOLOCK) WHERE ([CLCodCli] >= ?) AND ([CLRazCli] like "
                  cmdbuf = cmdbuf + "  ?) AND ([CLNomFan] like ?) AND ([CLDomLeg] like ?) AND ([CLCPoLeg] >= ?) AND ([CLPrvLeg] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CLTelCom] like ?) ORDER BY [CLCodCli]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02082,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02082,8)
                  THISFORM.GX_DB_BindColsW02082_01 ()
                  THISFORM.GX_DB_BindParmW02082_01 ()
               ENDIF
               AuxAV21C260 = THISFORM.AV21C260
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02082,1,@AuxAV21C260,0)
               THISFORM.AV21C260 = AuxAV21C260
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02082,2,PADR( TRIM(THISFORM.AV20C261),30, '%'),LEN(PADR( TRIM(THISFORM.AV20C261),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02082,3,PADR( TRIM(THISFORM.AV19C262),25, '%'),LEN(PADR( TRIM(THISFORM.AV19C262),25, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02082,4,PADR( TRIM(THISFORM.AV18C263),30, '%'),LEN(PADR( TRIM(THISFORM.AV18C263),30, '%')),0)
               AuxAV17C264 = THISFORM.AV17C264
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02082,5,@AuxAV17C264,0)
               THISFORM.AV17C264 = AuxAV17C264
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02082,6,PADR( TRIM(THISFORM.AV16C265),4, '%'),LEN(PADR( TRIM(THISFORM.AV16C265),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02082,7,PADR( TRIM(THISFORM.AV15C266),30, '%'),LEN(PADR( TRIM(THISFORM.AV15C266),30, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02082 = Gx_err
               THISFORM.GX_DB_GetW02082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02082 = Gx_err
                  THISFORM.GX_DB_GetW02082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02082 <> 101
               BRKV5S2 = .F.
               THISFORM.A262CLNomF = THISFORM.Buf_W02082_262CLNomFan
