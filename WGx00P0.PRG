         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A260CLCodC"
         THISFORM.cCW208S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW208S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW208S20 .GX_lastkey = 9.or. THISFORM.cCW208S20 .GX_lastkey = 13)
            IF ! THISFORM.cCW208S20 .GridValidObj( THISFORM.cCW208S20 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
