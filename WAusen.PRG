            THISFORM. cCW751V59 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A561TraCod"
         THISFORM.cCW751S30 .SaveFocus(THIS.GXColumnNo)
