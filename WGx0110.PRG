      PROCEDURE CreateTemp
         LOCAL SCW284S20
         SCW284S20 = ""
         IF USED( "SCW284S20" )
            SELECT SCW284S20
            SCW284S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW284S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA380TdcNr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA381TdcFe"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA382TdcTi"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA383TdcSe"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW284S20 = GETE('z:\temp') + '\' + SCW284S20
            ENDIF
            CREATE DBF (SCW284S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW284S20) EXCLUSIVE ALIAS SCW284S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW284S20
         THIS.GX_SfAlias = "SCW284S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02842" , @HStmt_W02842 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0110","W02842","",GX_CURSOR_TYPE_READONLY,@HStmt_W02842) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [TdcSuc], [TdcNro], [TdcSer], [TdcTip], [TdcFec], [TdcNroInt], [EmpCod] FROM "
                  cmdbuf = cmdbuf + "  [TDCOM] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [TdcNroInt] >= ?) AND ([TdcFec] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([TdcTip] like ?) AND ([TdcSer] like ?) AND ([TdcSuc] >= ?) AND ([TdcNro] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [TdcNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02842,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02842,9)
                  THISFORM.GX_DB_BindColsW02842_01 ()
                  THISFORM.GX_DB_BindParmW02842_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02842,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C380 = THISFORM.AV6C380
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02842,2,@AuxAV6C380,0)
               THISFORM.AV6C380 = AuxAV6C380
               AuxAV7C381 = THISFORM.AV7C381
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02842,3,@AuxAV7C381,0)
               THISFORM.AV7C381 = AuxAV7C381
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02842,4,PADR( TRIM(THISFORM.AV8C382),4, '%'),LEN(PADR( TRIM(THISFORM.AV8C382),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02842,5,PADR( TRIM(THISFORM.AV9C383),1, '%'),LEN(PADR( TRIM(THISFORM.AV9C383),1, '%')),0)
               AuxAV10C384 = THISFORM.AV10C384
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02842,6,@AuxAV10C384,0)
               THISFORM.AV10C384 = AuxAV10C384
               AuxAV11C385 = THISFORM.AV11C385
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02842,7,@AuxAV11C385,0)
               THISFORM.AV11C385 = AuxAV11C385
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02842 = Gx_err
               THISFORM.GX_DB_GetW02842_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02842 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02842) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02842 = Gx_err
                  THISFORM.GX_DB_GetW02842_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02842 <> 101
               BRKV7W2 = .F.
               THISFORM.A384TdcSuc = THISFORM.Buf_W02842_384TdcSuc
               THISFORM.A385TdcNro = THISFORM.Buf_W02842_385TdcNro
               THISFORM.A383TdcSer = THISFORM.Buf_W02842_383TdcSer
               THISFORM.A382TdcTip = THISFORM.Buf_W02842_382TdcTip
               THISFORM.A381TdcFec = THISFORM.Buf_W02842_381TdcFec
               THISFORM.A380TdcNro = THISFORM.Buf_W02842_380TdcNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W02842_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12V7W2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02842 = Gx_err
               THISFORM.GX_DB_GetW02842_01 ()
            ENDDO
         ENDIF
      ENDPROC
