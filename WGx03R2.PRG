      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03442" , @HStmt_W03442 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX03R2","W03442","",GX_CURSOR_TYPE_READONLY,@HStmt_W03442) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [VdrCod], [VdrEDde], [VdrECom], [VdrEntGruT], [VdrEntCod] FROM [VEND1] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [VdrCod] = ? and [VdrEntCod] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([VdrEntGruT] like ?) AND ([VdrECom] >= ?) AND ([VdrEDde] >= ?) ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [VdrCod], [VdrEntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03442,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03442,9)
                  THISFORM.GX_DB_BindColsW03442_01 ()
                  THISFORM.GX_DB_BindParmW03442_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03442,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1037VdrCo = THISFORM.A1037VdrCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03442,2,@AuxA1037VdrCo,0)
               THISFORM.A1037VdrCo = AuxA1037VdrCo
               AuxAV5C1201 = THISFORM.AV5C1201
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03442,3,@AuxAV5C1201,0)
               THISFORM.AV5C1201 = AuxAV5C1201
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03442,4,PADR( TRIM(THISFORM.AV6C1203),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C1203),2, '%')),0)
               AuxAV7C3394 = THISFORM.AV7C3394
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03442,5,@AuxAV7C3394,0)
               THISFORM.AV7C3394 = AuxAV7C3394
               AuxAV8C3395 = THISFORM.AV8C3395
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03442,6,@AuxAV8C3395,0)
               THISFORM.AV8C3395 = AuxAV8C3395
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03442 = Gx_err
               THISFORM.GX_DB_GetW03442_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03442 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03442) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03442 = Gx_err
                  THISFORM.GX_DB_GetW03442_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03442 <> 101
               BRKV9K2 = .F.
               THISFORM.A3395VdrED = THISFORM.Buf_W03442_3395VdrEDde
               THISFORM.A3394VdrEC = THISFORM.Buf_W03442_3394VdrECom
               THISFORM.A1203VdrEn = THISFORM.Buf_W03442_1203VdrEntGruT
               THISFORM.A1201VdrEn = THISFORM.Buf_W03442_1201VdrEntCod
               GX_SFLOAD = 0
               THISFORM.U12V9K2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03442 = Gx_err
               THISFORM.GX_DB_GetW03442_01 ()
            ENDDO
         ENDIF
      ENDPROC
