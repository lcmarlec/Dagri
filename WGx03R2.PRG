            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3394VdrE"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW344S18 = GETE('z:\temp') + '\' + SCW344S18
            ENDIF
            CREATE DBF (SCW344S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW344S18) EXCLUSIVE ALIAS SCW344S18
         ENDIF
