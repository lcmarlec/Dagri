                  cmdbuf = cmdbuf + "  AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVNro], T1.[DcVSuc], T1.[DcVSer], "
                  cmdbuf = cmdbuf + "  T1.[DcvTipRed], T1.[DcVFch] FROM ([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[DcVEntCod]) WHERE (T1.[EmpCod] = ? and T1.[DcVFch] >= ?) AND (T1.[DcVEntCod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) AND (T1.[DcVSuc] = ? or ? = 0) AND (T1.[DcVSuc] < 1000) AND (T1.[DcVNro] "
                  cmdbuf = cmdbuf + "  = 0) AND (T1.[DcVTot] >= ? or ? = 0) AND (T1.[DcVTot] <= ? or ? = 0) AND (T1.[DcVEst] "
                  cmdbuf = cmdbuf + "  = 0) AND (T1.[DcvTipRed] = ? or ? = 'TT') AND (T1.[DcVFch] <= ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[DcVFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10772,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10772,15)
