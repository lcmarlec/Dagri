      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09762" , @HStmt_W09762 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WETIART","W09762","",GX_CURSOR_TYPE_READONLY,@HStmt_W09762) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[LiPrCod], T2.[LiPrDsc], T1.[EtAFch], T1.[EmpCod] FROM ([ETIART] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [LIPROD] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[LiPrCod] "
                  cmdbuf = cmdbuf + "  = T1.[LiPrCod]) WHERE T1.[EmpCod] = ? and T1.[EtAFch] >= ? ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[EtAFch], T1.[LiPrCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09762,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09762,14)
                  THISFORM.GX_DB_BindColsW09762_01 ()
                  THISFORM.GX_DB_BindParmW09762_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09762,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV17Fecdes = THISFORM.AV17Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09762,2,@AuxAV17Fecdes,0)
               THISFORM.AV17Fecdes = AuxAV17Fecdes
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09762) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09762 = Gx_err
               THISFORM.GX_DB_GetW09762_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WEtiArt"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09762 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09762) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09762 = Gx_err
                  THISFORM.GX_DB_GetW09762_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09762 <> 101
               BRKVR42 = .F.
               THISFORM.A2867LiPrC = THISFORM.Buf_W09762_2867LiPrCod
               THISFORM.A2868LiPrD = THISFORM.Buf_W09762_2868LiPrDsc
               THISFORM.A2969EtAFc = THISFORM.Buf_W09762_2969EtAFch
               THISFORM.A2EmpCod = THISFORM.Buf_W09762_2EmpCod
               THISFORM.A2868LiPrD = THISFORM.Buf_W09762_2868LiPrDsc
               GX_SFLOAD = 0
               THISFORM.U16VR42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09762) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09762 = Gx_err
               THISFORM.GX_DB_GetW09762_01 ()
            ENDDO
         ENDIF
      ENDPROC
