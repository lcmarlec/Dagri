            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW976S12 = GETE('z:\temp') + '\' + SCW976S12
            ENDIF
            CREATE DBF (SCW976S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW976S12) EXCLUSIVE ALIAS SCW976S12
         ENDIF
