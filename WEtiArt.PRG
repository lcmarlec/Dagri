               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW976S12 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW976S12 .gx_can_changerow = .T.
