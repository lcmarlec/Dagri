         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2868LiPrD"
         THISFORM.cCW976S12 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW976S12 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW976S12 .GX_lastkey = 9.or. THISFORM.cCW976S12 .GX_lastkey = 13)
