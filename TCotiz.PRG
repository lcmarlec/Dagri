      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA193Moncod = THISFORM.A193Moncod
            Gx_err = GX_DB_SetInt( HStmt_T00182,1,@AuxA193Moncod,0)
            THISFORM.A193Moncod = AuxA193Moncod
            AuxA196CotFch = THISFORM.A196CotFch
            Gx_err = GX_DB_SetDate( HStmt_T00182,2,@AuxA196CotFch,0)
            THISFORM.A196CotFch = AuxA196CotFch
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00182) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00182 = Gx_err
            THISFORM.GX_DB_GetT00182_01 ()
            IF .NOT. THISFORM.T00182 <> 103
               DO GX_ERRMW WITH "MONEDA1 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00182 = 101 .OR. THISFORM.Z197CotImp <> THISFORM.Buf_T00182_197CotImp
               DO GX_ERRMW WITH "MONEDA1 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00186" , @HStmt_T00186 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOTIZ","T00186","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00186) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [MONEDA1] ([Moncod], [CotFch], [CotImp]) VALUES (?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00186,cmdbuf)
                  THISFORM.GX_DB_BindParmT00186_01 ()
               ENDIF
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00186,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               AuxA196CotFch = THISFORM.A196CotFch
               Gx_err = GX_DB_SetDate( HStmt_T00186,2,@AuxA196CotFch,0)
               THISFORM.A196CotFch = AuxA196CotFch
               AuxA197CotImp = THISFORM.A197CotImp
               Gx_err = GX_DB_SetDouble( HStmt_T00186,3,@AuxA197CotImp,0)
               THISFORM.A197CotImp = AuxA197CotImp
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00186) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00186 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00186) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00186 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00187" , @HStmt_T00187 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOTIZ","T00187","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00187) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [MONEDA1] SET [CotImp]=?  WHERE [Moncod] = ? AND [CotFch] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00187,cmdbuf)
                  THISFORM.GX_DB_BindParmT00187_01 ()
               ENDIF
               AuxA197CotImp = THISFORM.A197CotImp
               Gx_err = GX_DB_SetDouble( HStmt_T00187,1,@AuxA197CotImp,0)
               THISFORM.A197CotImp = AuxA197CotImp
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00187,2,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               AuxA196CotFch = THISFORM.A196CotFch
               Gx_err = GX_DB_SetDate( HStmt_T00187,3,@AuxA196CotFch,0)
               THISFORM.A196CotFch = AuxA196CotFch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00187) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00187 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00187) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00188" , @HStmt_T00188 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOTIZ","T00188","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00188) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [MONEDA1]  WHERE [Moncod] = ? AND [CotFch] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00188,cmdbuf)
                  THISFORM.GX_DB_BindParmT00188_01 ()
               ENDIF
               AuxA193Moncod = THISFORM.A193Moncod
               Gx_err = GX_DB_SetInt( HStmt_T00188,1,@AuxA193Moncod,0)
               THISFORM.A193Moncod = AuxA193Moncod
               AuxA196CotFch = THISFORM.A196CotFch
               Gx_err = GX_DB_SetDate( HStmt_T00188,2,@AuxA196CotFch,0)
               THISFORM.A196CotFch = AuxA196CotFch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00188) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00188 = Gx_err
               THISFORM.T00182 = iif( THISFORM.T00188 = 0 , 104 , THISFORM.T00188 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00188) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV12Numero = THISFORM.A195MonSim + " " + GXDTOC( THISFORM.A196CotFch )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV12Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV11Audobs
            Aux6 = THISFORM.AV10Usuari
            DO PAuditor WITH "SIST" , Aux1 , "Objeto" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV12Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV11Audobs = Aux5
            THISFORM.AV10Usuari = Aux6
            THISFORM. cCT18V10 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 17 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
