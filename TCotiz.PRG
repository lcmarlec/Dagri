                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT18A196 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_17insert = .F.
               THISFORM.gx_insert = THISFORM. gx_17insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
