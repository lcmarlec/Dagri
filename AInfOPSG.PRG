***********************
PROCEDURE U11ZK5
***********************

   * 'OCOMPRA' Routine
   RV12Oconro = 0
   RV15Ocofch = CTOD("  /  /  ")
   LEVEL7 = .T.
   DO GX_CSC01
   IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P12808" , @HStmt_P12808 )
      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PINFOPSG","P12808","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_P12808) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT [OCoNro], [OCoSuc], [OCoFch], [OCoNroInt], [EmpCod] FROM [OCOMPN] (NOLOCK) "
      cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [OCoNroInt] = ? ORDER BY [EmpCod], [OCoNroInt]  "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_P12808,cmdbuf)
      GX_DB_BindColsP12808_01 ()
      GX_DB_BindParmP12808_01 ()
   ENDIF
   Gx_err = GX_DB_SetInt( HStmt_P12808,1,@RV8Emprcod,0)
   Gx_err = GX_DB_SetDouble( HStmt_P12808,2,@RV21Oconro,0)
   Gx_eop = 1
   DO WHILE Gx_eop != 0
      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_P12808) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   P12808 = Gx_err
   GX_DB_GetP12808_01 ()
   DO WHILE P12808 <> 101
      R687OCoNro = Buf_P12808_687OCoNro
      R686OCoSuc = Buf_P12808_686OCoSuc
      R688OCoFch = Buf_P12808_688OCoFch
      R682OCoNro = Buf_P12808_682OCoNroInt
      R2EmpCod = Buf_P12808_2EmpCod
      RV11Texto = "Ocompra Int " + str( R682OCoNro , 12 ) + " Suc " + str( R686OCoSuc , 4 ) + " Nro " + str( R687OCoNro , 8 )
      IF R686OCoSuc > 0
         RV12Oconro = R687OCoNro
         RV15Ocofch = R688OCoFch
         * Exit For each command. Update data (if necessary), close cursors & exit.
         EXIT
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      * Exiting from a For First loop.
      EXIT
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P12808) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL7 = .F.
RETURN
