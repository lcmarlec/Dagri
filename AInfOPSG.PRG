   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P12802) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   * User Code
   fclose(gxArch)
   IF TYPE( "HConn_Default" ) = "N"
      IF GXCONNECTED
         Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
      ENDIF
   ENDIF
   DO GX_MSGW WITH "Se generaron " + ALLTRIM( str( RV18N , 3 ) ) + " Pagos"
   DO EPZK0
   RETURN
   GX_retp = 0
* End Program

