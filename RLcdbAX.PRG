      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R09922) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   RV11Fila = RV11Fila + 1
