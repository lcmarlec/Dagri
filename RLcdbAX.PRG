   RV25Docexc.cells(RV11Fila,6).Text = space( 50 )
   RV25Docexc.cells(RV11Fila,7).Text = space( 30 )
   RV25Docexc.save( )
   RV25Docexc.close( )
   RV12E = opendocument( AV10Planil )
   DO EPRK0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

