         THISFORM.A37PrvCod = AuxA37PrvCod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01103) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W01103 = Gx_err
         THISFORM.GX_DB_GetW01103_01 ()
         DO WHILE THISFORM.W01103 <> 101
            THISFORM.A120EntCod = THISFORM.Buf_W01103_120EntCod
            THISFORM.A150EntGru = THISFORM.Buf_W01103_150EntGruTip
            THISFORM.A153EntRaz = THISFORM.Buf_W01103_153EntRaz
            THISFORM.AV14Provee = THISFORM.A153EntRaz
            * Exit For each command. Update data (if necessary), close cursors & exit.
            EXIT
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W01103) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.cCW110S17 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW110S17 .GX_rec_loaded =  THISFORM.cCW110S17 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW110S17 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW110S17 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

