      PROCEDURE U14V322
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01103" , @HStmt_W01103 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODI4","W01103","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W01103) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntCod], [EntGruTip], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'PR' and [EntCod] = ? ORDER BY [EmpCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01103,cmdbuf)
            THISFORM.GX_DB_BindColsW01103_01 ()
            THISFORM.GX_DB_BindParmW01103_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01103,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA37PrvCod = THISFORM.A37PrvCod
