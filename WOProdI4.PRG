      PROCEDURE CreateTemp
         LOCAL SCW110S17
         SCW110S17 = ""
         IF USED( "SCW110S17" )
            SELECT SCW110S17
            SCW110S17 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW110S17
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA38LotNro"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA39LotFch"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA40LotVnc"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV14Prove"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 30
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA35LugDsc"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA44ArtStk"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 4

            GX_STRUCT[ 7 ,1]= "VAV11Canti"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 4

            GX_STRUCT[ 8 ,1]= "sA37PrvCod"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 6
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "sA34LugCod"
            GX_STRUCT[ 9 ,2]= "N"
            GX_STRUCT[ 9 ,3]= 3
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW110S17 = GETE('z:\temp') + '\' + SCW110S17
            ENDIF
            CREATE DBF (SCW110S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCW110S17) EXCLUSIVE ALIAS SCW110S17
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW110S17
         THIS.GX_SfAlias = "SCW110S17"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01102" , @HStmt_W01102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODI4","W01102","",GX_CURSOR_TYPE_READONLY,@HStmt_W01102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[lotraz], T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], T1.[PrvCod], "
                  cmdbuf = cmdbuf + "  T2.[LugHab], T1.[LugCod], T1.[ArtStkAct], T2.[LugDsc], T1.[LotVnc], T1.[LotFch], "
                  cmdbuf = cmdbuf + "  T1.[LotNro], T3.[ArtDsc] FROM (([ARTSTK] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [LUGALM] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[LugCod] = T1.[LugCod]) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] "
                  cmdbuf = cmdbuf + "  AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[FamCod] = ? and T1.[FamSubCod] = ? and T1.[ArtCod] = ?) AND (T2.[LugHab] "
                  cmdbuf = cmdbuf + "  = 'S') AND (T1.[PrvCod] = ? or ? = 0) AND (T1.[ArtStkAct] > 0) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], T1.[LotVnc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01102,11)
                  THISFORM.GX_DB_BindColsW01102_01 ()
                  THISFORM.GX_DB_BindParmW01102_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01102,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01102,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01102,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01102,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxAV13Prvcod = THISFORM.AV13Prvcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01102,5,@AuxAV13Prvcod,0)
               THISFORM.AV13Prvcod = AuxAV13Prvcod
               AuxAV13Prvcod = THISFORM.AV13Prvcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01102,6,@AuxAV13Prvcod,0)
               THISFORM.AV13Prvcod = AuxAV13Prvcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01102 = Gx_err
               THISFORM.GX_DB_GetW01102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV19Pgmnam = "WOProdI4"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01102 = Gx_err
                  THISFORM.GX_DB_GetW01102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01102 <> 101
               BRKV322 = .F.
               THISFORM.AV14Provee = SPACE(30)
               THISFORM.AV11Cantid = 0.0000
               THISFORM.A37PrvCod = THISFORM.Buf_W01102_37PrvCod
               THISFORM.A36LugHab = THISFORM.Buf_W01102_36LugHab
               THISFORM.A34LugCod = THISFORM.Buf_W01102_34LugCod
               THISFORM.A44ArtStkA = THISFORM.Buf_W01102_44ArtStkAct
               THISFORM.A35LugDsc = THISFORM.Buf_W01102_35LugDsc
               THISFORM.A40LotVnc = THISFORM.Buf_W01102_40LotVnc
               THISFORM.A39LotFch = THISFORM.Buf_W01102_39LotFch
               THISFORM.A38LotNro = THISFORM.Buf_W01102_38LotNro
               THISFORM.A6ArtDsc = THISFORM.Buf_W01102_6ArtDsc
               THISFORM.A36LugHab = THISFORM.Buf_W01102_36LugHab
               THISFORM.A35LugDsc = THISFORM.Buf_W01102_35LugDsc
               THISFORM.A6ArtDsc = THISFORM.Buf_W01102_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U14V322 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01102 = Gx_err
               THISFORM.GX_DB_GetW01102_01 ()
            ENDDO
         ENDIF
      ENDPROC
