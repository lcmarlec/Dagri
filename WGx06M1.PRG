      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07002" , @HStmt_W07002 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06M1","W07002","",GX_CURSOR_TYPE_READONLY,@HStmt_W07002) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TEntTLprc], [TEntCod], [TEntGruTip], [TcliNI] FROM [TCLIENTE] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [TcliNI] >= ?) AND ([TEntGruTip] like ?) AND ([TEntCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([TEntTLprc] like ?) ORDER BY [EmpCod], [TcliNI], [TEntGruTip], [TEntCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07002,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07002,9)
                  THISFORM.GX_DB_BindColsW07002_01 ()
                  THISFORM.GX_DB_BindParmW07002_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07002,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C2141 = THISFORM.AV5C2141
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07002,2,@AuxAV5C2141,0)
               THISFORM.AV5C2141 = AuxAV5C2141
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07002,3,PADR( TRIM(THISFORM.AV6C2126),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C2126),2, '%')),0)
               AuxAV7C2127 = THISFORM.AV7C2127
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07002,4,@AuxAV7C2127,0)
               THISFORM.AV7C2127 = AuxAV7C2127
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07002,5,PADR( TRIM(THISFORM.AV8C2129),2, '%'),LEN(PADR( TRIM(THISFORM.AV8C2129),2, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07002 = Gx_err
               THISFORM.GX_DB_GetW07002_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07002 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07002) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07002 = Gx_err
                  THISFORM.GX_DB_GetW07002_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07002 <> 101
               BRKVJG2 = .F.
               THISFORM.A2129TEntT = THISFORM.Buf_W07002_2129TEntTLprc
               THISFORM.A2127TEntC = THISFORM.Buf_W07002_2127TEntCod
               THISFORM.A2126TEntG = THISFORM.Buf_W07002_2126TEntGruTip
               THISFORM.A2141TcliN = THISFORM.Buf_W07002_2141TcliNI
               GX_SFLOAD = 0
               THISFORM.U12VJG2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07002 = Gx_err
               THISFORM.GX_DB_GetW07002_01 ()
            ENDDO
         ENDIF
