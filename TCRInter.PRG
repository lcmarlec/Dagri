               AuxA3428CRIPi = THISFORM.A3428CRIPi
               Gx_err = GX_DB_SetInt( HStmt_T01326,5,@AuxA3428CRIPi,0)
               THISFORM.A3428CRIPi = AuxA3428CRIPi
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01326) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01326 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01326) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T01326 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01327" , @HStmt_T01327 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCRINTER","T01327","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01327) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [CRINTERN] SET [CRIDsc]=?, [CRITiMo]=?, [CRIPidPal]=?  WHERE [EmpCod] = ? "
                  cmdbuf = cmdbuf + "  AND [CRICod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01327,cmdbuf)
                  THISFORM.GX_DB_BindParmT01327_01 ()
               ENDIF
               AuxA1319CRIDs = THISFORM.A1319CRIDs
               Gx_err = GX_DB_SetStr( HStmt_T01327,1,AuxA1319CRIDs,40,0)
               THISFORM.A1319CRIDs = AuxA1319CRIDs
               AuxA1320CRITi = THISFORM.A1320CRITi
               Gx_err = GX_DB_SetStr( HStmt_T01327,2,AuxA1320CRITi,1,0)
               THISFORM.A1320CRITi = AuxA1320CRITi
               AuxA3428CRIPi = THISFORM.A3428CRIPi
               Gx_err = GX_DB_SetInt( HStmt_T01327,3,@AuxA3428CRIPi,0)
               THISFORM.A3428CRIPi = AuxA3428CRIPi
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01327,4,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1318CRICo = THISFORM.A1318CRICo
               Gx_err = GX_DB_SetInt( HStmt_T01327,5,@AuxA1318CRICo,0)
               THISFORM.A1318CRICo = AuxA1318CRICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01327) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01327 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01327) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01328" , @HStmt_T01328 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCRINTER","T01328","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01328) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CRINTERN]  WHERE [EmpCod] = ? AND [CRICod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01328,cmdbuf)
                  THISFORM.GX_DB_BindParmT01328_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01328,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1318CRICo = THISFORM.A1318CRICo
               Gx_err = GX_DB_SetInt( HStmt_T01328,2,@AuxA1318CRICo,0)
               THISFORM.A1318CRICo = AuxA1318CRICo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01328) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01328 = Gx_err
               THISFORM.T01322 = iif( THISFORM.T01328 = 0 , 104 , THISFORM.T01328 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01328) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
