      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T01322,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA1318CRICo = THISFORM.A1318CRICo
            Gx_err = GX_DB_SetInt( HStmt_T01322,2,@AuxA1318CRICo,0)
            THISFORM.A1318CRICo = AuxA1318CRICo
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01322) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01322 = Gx_err
            THISFORM.GX_DB_GetT01322_01 ()
            IF .NOT. THISFORM.T01322 <> 103
               DO GX_ERRMW WITH "CRINTERN reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01322 = 101 .OR. THISFORM.Z1319CRIDs <> THISFORM.Buf_T01322_1319CRIDsc
               DO GX_ERRMW WITH "CRINTERN fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01326" , @HStmt_T01326 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCRINTER","T01326","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01326) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CRINTERN] ([EmpCod], [CRICod], [CRIDsc], [CRITiMo], [CRIPidPal]) VALUES "
                  cmdbuf = cmdbuf + "  (?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01326,cmdbuf)
                  THISFORM.GX_DB_BindParmT01326_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01326,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1318CRICo = THISFORM.A1318CRICo
               Gx_err = GX_DB_SetInt( HStmt_T01326,2,@AuxA1318CRICo,0)
               THISFORM.A1318CRICo = AuxA1318CRICo
               AuxA1319CRIDs = THISFORM.A1319CRIDs
               Gx_err = GX_DB_SetStr( HStmt_T01326,3,AuxA1319CRIDs,40,0)
               THISFORM.A1319CRIDs = AuxA1319CRIDs
               AuxA1320CRITi = THISFORM.A1320CRITi
               Gx_err = GX_DB_SetStr( HStmt_T01326,4,AuxA1320CRITi,1,0)
