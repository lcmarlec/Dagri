      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA631PaiCod = THISFORM.A631PaiCod
            Gx_err = GX_DB_SetStr( HStmt_T00842,1,AuxA631PaiCod,4,0)
            THISFORM.A631PaiCod = AuxA631PaiCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00842) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00842 = Gx_err
            THISFORM.GX_DB_GetT00842_01 ()
            IF .NOT. THISFORM.T00842 <> 103
               DO GX_ERRMW WITH "PAISES reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00842 = 101 .OR. THISFORM.Z632PaiDsc <> THISFORM.Buf_T00842_632PaiDsc
               DO GX_ERRMW WITH "PAISES fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00845" , @HStmt_T00845 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPAISES","T00845","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00845) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [PAISES] ([PaiCod], [PaiDsc], [PaiFPCod]) VALUES (?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00845,cmdbuf)
                  THISFORM.GX_DB_BindParmT00845_01 ()
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               Gx_err = GX_DB_SetStr( HStmt_T00845,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               AuxA632PaiDsc = THISFORM.A632PaiDsc
               Gx_err = GX_DB_SetStr( HStmt_T00845,2,AuxA632PaiDsc,40,0)
               THISFORM.A632PaiDsc = AuxA632PaiDsc
               AuxA2321PaiFP = THISFORM.A2321PaiFP
               Gx_err = GX_DB_SetStr( HStmt_T00845,3,AuxA2321PaiFP,3,0)
               THISFORM.A2321PaiFP = AuxA2321PaiFP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00845) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00845 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00845) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00845 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00846" , @HStmt_T00846 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPAISES","T00846","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00846) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [PAISES] SET [PaiDsc]=?, [PaiFPCod]=?  WHERE [PaiCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00846,cmdbuf)
                  THISFORM.GX_DB_BindParmT00846_01 ()
               ENDIF
               AuxA632PaiDsc = THISFORM.A632PaiDsc
               Gx_err = GX_DB_SetStr( HStmt_T00846,1,AuxA632PaiDsc,40,0)
               THISFORM.A632PaiDsc = AuxA632PaiDsc
               AuxA2321PaiFP = THISFORM.A2321PaiFP
               Gx_err = GX_DB_SetStr( HStmt_T00846,2,AuxA2321PaiFP,3,0)
               THISFORM.A2321PaiFP = AuxA2321PaiFP
               AuxA631PaiCod = THISFORM.A631PaiCod
               Gx_err = GX_DB_SetStr( HStmt_T00846,3,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
