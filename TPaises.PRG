               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00847) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00847 = Gx_err
               THISFORM.T00842 = iif( THISFORM.T00847 = 0 , 104 , THISFORM.T00847 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00847) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
