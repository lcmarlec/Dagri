               ENDDO
               THISFORM.T00846 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00846) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
