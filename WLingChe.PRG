      ***********************
      PROCEDURE cCW568V29.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW568V29.ISVALID" )
         IF EMPTY( THISFORM.AV29Pencta )
            THISFORM.AV30Pencta = "Todas "
         ELSE
            THISFORM.AV33GXLvl3 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05682" , @HStmt_W05682 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLINGCHE","W05682","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05682) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [PCtaNro], [CtaNro], [CtaDes] FROM [CTA00] (NOLOCK) WHERE [EmpCod] "
               cmdbuf = cmdbuf + "  = ? and [PCtaNro] = ? and [CtaNro] = ? ORDER BY [EmpCod], [PCtaNro], [CtaNro]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05682,cmdbuf)
               THISFORM.GX_DB_BindColsW05682_01 ()
               THISFORM.GX_DB_BindParmW05682_01 ()
            ENDIF
            AuxAV11Emprco = THISFORM.AV11Emprco
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05682,1,@AuxAV11Emprco,0)
            THISFORM.AV11Emprco = AuxAV11Emprco
            AuxAV28Penpct = THISFORM.AV28Penpct
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05682,2,@AuxAV28Penpct,0)
            THISFORM.AV28Penpct = AuxAV28Penpct
            AuxAV29Pencta = THISFORM.AV29Pencta
            THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05682,3,AuxAV29Pencta,12,0)
            THISFORM.AV29Pencta = AuxAV29Pencta
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05682) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W05682 = Gx_err
            THISFORM.GX_DB_GetW05682_01 ()
            DO WHILE THISFORM.W05682 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W05682_2EmpCod
               THISFORM.A198PCtaNr = THISFORM.Buf_W05682_198PCtaNro
               THISFORM.A199CtaNro = THISFORM.Buf_W05682_199CtaNro
               THISFORM.A200CtaDes = THISFORM.Buf_W05682_200CtaDes
               THISFORM.AV33GXLvl3 = 1
               THISFORM.AV30Pencta = THISFORM.A200CtaDes
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05682) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV33GXLvl3 = 0
               THISFORM.AV30Pencta = "Cuenta Inexistente "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

