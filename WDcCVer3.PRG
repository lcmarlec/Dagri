      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00352" , @HStmt_W00352 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCVER3","W00352","",GX_CURSOR_TYPE_READONLY,@HStmt_W00352) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[OPaNroLin], T2.[OpaEst], T1.[OPaSig], T2.[OpaTot], T1.[OPaNroI], T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[OpaNroIImp] AS OpaNroIImp, T3.[DcCFecOri], T1.[OPaImpImp], T3.[DcCNro] AS OPaNroImp, "
                  cmdbuf = cmdbuf + "  T3.[DcCSuc] AS OPaSucImp, T3.[DccSer] AS OPaSerImp, T3.[DcCTip] AS OPaTipImp FROM "
                  cmdbuf = cmdbuf + "  (([OPAGOS1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [OPAGOS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[OPaNroI] = T1.[OPaNroI]) LEFT JOIN [DCCOM] T3 (NOLOCK) ON "
                  cmdbuf = cmdbuf + "  T3.[EmpCod] = T1.[EmpCod] AND T3.[DcCNroInt] = T1.[OpaNroIImp]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OPaNroI] = ? ORDER BY T1.[EmpCod], T1.[OPaNroI], T1.[OPaNroLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00352,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00352,13)
                  THISFORM.GX_DB_BindColsW00352_01 ()
                  THISFORM.GX_DB_BindParmW00352_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00352,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV21Opanro = THISFORM.AV21Opanro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00352,2,@AuxAV21Opanro,0)
               THISFORM.AV21Opanro = AuxAV21Opanro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00352) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00352 = Gx_err
               THISFORM.GX_DB_GetW00352_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WDcCVer3"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00352 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00352) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00352 = Gx_err
                  THISFORM.GX_DB_GetW00352_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00352 <> 101
               BRKV0Z2 = .F.
               THISFORM.A711OpaEst = THISFORM.Buf_W00352_711OpaEst
               THISFORM.A727OPaSig = THISFORM.Buf_W00352_727OPaSig
               THISFORM.A729OpaTot = THISFORM.Buf_W00352_729OpaTot
               THISFORM.A708OPaNro = THISFORM.Buf_W00352_708OPaNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W00352_2EmpCod
               THISFORM.A720OpaNro = THISFORM.Buf_W00352_720OpaNroIImp
               THISFORM.A2278DcCFe = THISFORM.Buf_W00352_2278DcCFecOri
               THISFORM.A725OPaImp = THISFORM.Buf_W00352_725OPaImpImp
               THISFORM.A724OPaNro = THISFORM.Buf_W00352_724OPaNroImp
               THISFORM.A723OPaSuc = THISFORM.Buf_W00352_723OPaSucImp
               THISFORM.A722OPaSer = THISFORM.Buf_W00352_722OPaSerImp
               THISFORM.A721OPaTip = THISFORM.Buf_W00352_721OPaTipImp
               THISFORM.A711OpaEst = THISFORM.Buf_W00352_711OpaEst
               THISFORM.A729OpaTot = THISFORM.Buf_W00352_729OpaTot
               THISFORM.A2278DcCFe = THISFORM.Buf_W00352_2278DcCFecOri
               THISFORM.A724OPaNro = THISFORM.Buf_W00352_724OPaNroImp
               THISFORM.A723OPaSuc = THISFORM.Buf_W00352_723OPaSucImp
               THISFORM.A722OPaSer = THISFORM.Buf_W00352_722OPaSerImp
               THISFORM.A721OPaTip = THISFORM.Buf_W00352_721OPaTipImp
               GX_SFLOAD = 0
               THISFORM.U15V0Z2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00352) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00352 = Gx_err
               THISFORM.GX_DB_GetW00352_01 ()
            ENDDO
         ENDIF
