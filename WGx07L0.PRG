      PROCEDURE CreateTemp
         LOCAL SCW803S20
         SCW803S20 = ""
         IF USED( "SCW803S20" )
            SELECT SCW803S20
            SCW803S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW803S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2426CAEA"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2427CAEA"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2428CAEA"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2429CAEA"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2431CAEA"
            GX_STRUCT[ 6 ,2]= "D"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW803S20 = GETE('z:\temp') + '\' + SCW803S20
            ENDIF
            CREATE DBF (SCW803S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW803S20) EXCLUSIVE ALIAS SCW803S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW803S20
         THIS.GX_SfAlias = "SCW803S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08032" , @HStmt_W08032 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX07L0","W08032","",GX_CURSOR_TYPE_READONLY,@HStmt_W08032) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CAEANro], [CAEAFDde], [CAEAFch], [CAEAOK], [CAEAOrd], [CAEAPer], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [CAEA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [CAEAPer] >= ? and [CAEAOrd] "
                  cmdbuf = cmdbuf + "  >= ? and [CAEAOK] >= ?) AND ([CAEAFch] >= ?) AND ([CAEANro] >= ?) AND ([CAEAFDde] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [CAEAPer], [CAEAOrd], [CAEAOK]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08032,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08032,9)
                  THISFORM.GX_DB_BindColsW08032_01 ()
                  THISFORM.GX_DB_BindParmW08032_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08032,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C2426 = THISFORM.AV6C2426
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08032,2,@AuxAV6C2426,0)
               THISFORM.AV6C2426 = AuxAV6C2426
               AuxAV7C2427 = THISFORM.AV7C2427
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08032,3,@AuxAV7C2427,0)
               THISFORM.AV7C2427 = AuxAV7C2427
               AuxAV8C2428 = THISFORM.AV8C2428
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08032,4,@AuxAV8C2428,0)
               THISFORM.AV8C2428 = AuxAV8C2428
               AuxAV9C2429 = THISFORM.AV9C2429
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08032,5,@AuxAV9C2429,0)
               THISFORM.AV9C2429 = AuxAV9C2429
               AuxAV10C2430 = THISFORM.AV10C2430
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08032,6,@AuxAV10C2430,0)
               THISFORM.AV10C2430 = AuxAV10C2430
               AuxAV11C2431 = THISFORM.AV11C2431
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08032,7,@AuxAV11C2431,0)
               THISFORM.AV11C2431 = AuxAV11C2431
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08032 = Gx_err
               THISFORM.GX_DB_GetW08032_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08032 = Gx_err
                  THISFORM.GX_DB_GetW08032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08032 <> 101
               BRKVMB2 = .F.
               THISFORM.A2430CAEAN = THISFORM.Buf_W08032_2430CAEANro
               THISFORM.A2431CAEAF = THISFORM.Buf_W08032_2431CAEAFDde
               THISFORM.A2429CAEAF = THISFORM.Buf_W08032_2429CAEAFch
               THISFORM.A2428CAEAO = THISFORM.Buf_W08032_2428CAEAOK
               THISFORM.A2427CAEAO = THISFORM.Buf_W08032_2427CAEAOrd
               THISFORM.A2426CAEAP = THISFORM.Buf_W08032_2426CAEAPer
               THISFORM.A2EmpCod = THISFORM.Buf_W08032_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VMB2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08032 = Gx_err
               THISFORM.GX_DB_GetW08032_01 ()
            ENDDO
         ENDIF
      ENDPROC
