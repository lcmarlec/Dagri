      PROCEDURE CreateTemp
         LOCAL SCW396S20
         SCW396S20 = ""
         IF USED( "SCW396S20" )
            SELECT SCW396S20
            SCW396S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW396S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1272CBaN"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1273CBaL"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1274CbaS"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1275CBaC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW396S20 = GETE('z:\temp') + '\' + SCW396S20
            ENDIF
            CREATE DBF (SCW396S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW396S20) EXCLUSIVE ALIAS SCW396S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW396S20
         THIS.GX_SfAlias = "SCW396S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03962" , @HStmt_W03962 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0410","W03962","",GX_CURSOR_TYPE_READONLY,@HStmt_W03962) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CBaCtaNro], [CBaFch], [CBaCtaCod], [CbaSLi], [CBaLin], [CBaNI], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [CONBAN] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [CBaNI] >= ? and [CBaLin] "
                  cmdbuf = cmdbuf + "  >= ? and [CbaSLi] >= ?) AND ([CBaCtaCod] >= ?) AND ([CBaCtaNro] like ?) AND ([CBaFch] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [CBaNI], [CBaLin], [CbaSLi]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03962,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03962,8)
                  THISFORM.GX_DB_BindColsW03962_01 ()
                  THISFORM.GX_DB_BindParmW03962_01 ()
               ENDIF
               AuxAV25C2 = THISFORM.AV25C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03962,1,@AuxAV25C2,0)
               THISFORM.AV25C2 = AuxAV25C2
               AuxAV24C1272 = THISFORM.AV24C1272
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03962,2,@AuxAV24C1272,0)
               THISFORM.AV24C1272 = AuxAV24C1272
               AuxAV23C1273 = THISFORM.AV23C1273
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03962,3,@AuxAV23C1273,0)
               THISFORM.AV23C1273 = AuxAV23C1273
               AuxAV22C1274 = THISFORM.AV22C1274
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03962,4,@AuxAV22C1274,0)
               THISFORM.AV22C1274 = AuxAV22C1274
               AuxAV21C1275 = THISFORM.AV21C1275
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03962,5,@AuxAV21C1275,0)
               THISFORM.AV21C1275 = AuxAV21C1275
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03962,6,PADR( TRIM(THISFORM.AV20C1276),12, '%'),LEN(PADR( TRIM(THISFORM.AV20C1276),12, '%')),0)
               AuxAV19C1277 = THISFORM.AV19C1277
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03962,7,@AuxAV19C1277,0)
               THISFORM.AV19C1277 = AuxAV19C1277
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03962 = Gx_err
               THISFORM.GX_DB_GetW03962_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03962 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03962) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03962 = Gx_err
                  THISFORM.GX_DB_GetW03962_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03962 <> 101
               BRKVB02 = .F.
               THISFORM.A1276CBaCt = THISFORM.Buf_W03962_1276CBaCtaNro
               THISFORM.A1277CBaFc = THISFORM.Buf_W03962_1277CBaFch
               THISFORM.A1275CBaCt = THISFORM.Buf_W03962_1275CBaCtaCod
               THISFORM.A1274CbaSL = THISFORM.Buf_W03962_1274CbaSLi
               THISFORM.A1273CBaLi = THISFORM.Buf_W03962_1273CBaLin
               THISFORM.A1272CBaNI = THISFORM.Buf_W03962_1272CBaNI
               THISFORM.A2EmpCod = THISFORM.Buf_W03962_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VB02 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03962 = Gx_err
               THISFORM.GX_DB_GetW03962_01 ()
            ENDDO
         ENDIF
      ENDPROC
