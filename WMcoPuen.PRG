               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09912,5,@AuxAV26Mcopue,0)
               THISFORM.AV26Mcopue = AuxAV26Mcopue
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09912) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09912 = Gx_err
               THISFORM.GX_DB_GetW09912_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WMcoPuen"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09912 = 101
                  GX_CUERR = 100
