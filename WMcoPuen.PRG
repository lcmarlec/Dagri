      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09912" , @HStmt_W09912 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WMCOPUEN","W09912","",GX_CURSOR_TYPE_READONLY,@HStmt_W09912) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [McoPrv], [McoCli], [McoImp], [McoFch], [McoNro], [McoSuc], [McoSer], [McoTip], "
                  cmdbuf = cmdbuf + "  [McoCuit], [MCoCod], [McoNI], [EmpCod] FROM [MCOPUENT] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([EmpCod] = ?) AND ([McoCli] = ? or ? = 0) AND ([McoFch] >= ?) AND ([McoPrv] = 0) "
                  cmdbuf = cmdbuf + "  AND ([MCoCod] = ?) ORDER BY [EmpCod], [McoNI], [MCoCod], [McoCuit], [McoTip], [McoSer], "
                  cmdbuf = cmdbuf + "  [McoSuc], [McoNro], [McoFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09912,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09912,15)
                  THISFORM.GX_DB_BindColsW09912_01 ()
                  THISFORM.GX_DB_BindParmW09912_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09912,1,@AuxAV8Emprcod,0)
