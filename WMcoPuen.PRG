                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09912) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09912 = Gx_err
                  THISFORM.GX_DB_GetW09912_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09912 <> 101
               BRKVRJ2 = .F.
               THISFORM.A2918McoPr = THISFORM.Buf_W09912_2918McoPrv
               THISFORM.A2917McoCl = THISFORM.Buf_W09912_2917McoCli
