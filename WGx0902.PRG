      PROCEDURE CreateTemp
         LOCAL SCW926S20
         SCW926S20 = ""
         IF USED( "SCW926S20" )
            SELECT SCW926S20
            SCW926S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW926S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2840TRaF"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 240
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2841TraF"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 240
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2842TraF"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2844TraF"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2845TraF"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW926S20 = GETE('z:\temp') + '\' + SCW926S20
            ENDIF
            CREATE DBF (SCW926S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW926S20) EXCLUSIVE ALIAS SCW926S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW926S20
         THIS.GX_SfAlias = "SCW926S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09262" , @HStmt_W09262 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0902","W09262","",GX_CURSOR_TYPE_READONLY,@HStmt_W09262) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [TraCod], [TraFNom], [TraFEC], [TraFFNa], [TraFNDoc], [TraFTd], "
                  cmdbuf = cmdbuf + "  [TRaFTip] FROM [EMPLFAM] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [TraCod] "
                  cmdbuf = cmdbuf + "  = ? and [TRaFTip] >= ? and [TraFTd] >= ? and [TraFNDoc] >= ?) AND ([TraFNom] like "
                  cmdbuf = cmdbuf + "  ?) AND ([TraFFNa] >= ?) ORDER BY [EmpCod], [TraCod], [TRaFTip], [TraFTd], [TraFNDoc] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09262,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09262,9)
                  THISFORM.GX_DB_BindColsW09262_01 ()
                  THISFORM.GX_DB_BindParmW09262_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09262,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09262,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               AuxAV5C2840 = THISFORM.AV5C2840
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09262,3,@AuxAV5C2840,0)
               THISFORM.AV5C2840 = AuxAV5C2840
               AuxAV6C2841 = THISFORM.AV6C2841
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09262,4,@AuxAV6C2841,0)
               THISFORM.AV6C2841 = AuxAV6C2841
               AuxAV7C2842 = THISFORM.AV7C2842
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09262,5,@AuxAV7C2842,0)
               THISFORM.AV7C2842 = AuxAV7C2842
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09262,6,PADR( TRIM(THISFORM.AV8C2843),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C2843),40, '%')),0)
               AuxAV9C2844 = THISFORM.AV9C2844
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09262,7,@AuxAV9C2844,0)
               THISFORM.AV9C2844 = AuxAV9C2844
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09262 = Gx_err
               THISFORM.GX_DB_GetW09262_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09262 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09262) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09262 = Gx_err
                  THISFORM.GX_DB_GetW09262_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09262 <> 101
               BRKVPQ2 = .F.
               THISFORM.A2843TraFN = THISFORM.Buf_W09262_2843TraFNom
               THISFORM.A2845TraFE = THISFORM.Buf_W09262_2845TraFEC
               THISFORM.A2844TraFF = THISFORM.Buf_W09262_2844TraFFNa
               THISFORM.A2842TraFN = THISFORM.Buf_W09262_2842TraFNDoc
               THISFORM.A2841TraFT = THISFORM.Buf_W09262_2841TraFTd
               THISFORM.A2840TRaFT = THISFORM.Buf_W09262_2840TRaFTip
               GX_SFLOAD = 0
               THISFORM.U12VPQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09262 = Gx_err
               THISFORM.GX_DB_GetW09262_01 ()
            ENDDO
         ENDIF
      ENDPROC
