      ***********************
      PROCEDURE U12VPL2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         THISFORM.AV21Fechah = GXSvr("Now" )
         LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
         GX_SFERR = 0
         Gx_fel_sel = .T.
         gxO_Rec = 0
         SELECT( THISFORM.cCW921S13 .GX_SfAlias)
         gxO_Rec1 = IIF(EOF(), 0, RECNO())
         THISFORM.cCW921S13.SF (8, @GX_SFERR)
         DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
            THISFORM.cCW921S13.SF (3, @GX_SFERR)
            THISFORM.cCW921S13 .SaveGridPos()
            IF THISFORM.A2834DccDr <> THISFORM.AV18Dccdrf .OR. THISFORM.A2835DccDr <> THISFORM.AV20Dccdro
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.AV8Emprcod
               Aux1 = THISFORM.A346DcCNro
               Aux2 = THISFORM.A2832dccDr
               Aux3 = THISFORM.AV18Dccdrf
               Aux4 = THISFORM.AV20Dccdro
               Aux5 = THISFORM.AV17Usuari
               Aux6 = THISFORM.AV21Fechah
               DO PReqDoc1 WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , "M"
               THISFORM.AV8Emprcod = Aux0
               THISFORM.A346DcCNro = Aux1
               THISFORM.A2832dccDr = Aux2
               THISFORM.AV18Dccdrf = Aux3
               THISFORM.AV20Dccdro = Aux4
               THISFORM.AV17Usuari = Aux5
               THISFORM.AV21Fechah = Aux6
               THISFORM. cCW921S13 .RestoreGridPos()
               THISFORM. cCW921S13.Columns(1).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW921S13.Columns(3).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW921S13.Columns(4).Ctrl1 .RefreshSfAtt()
               THISFORM. cCW921S13 .GX_rec_modif = .T.
               THISFORM. cCW921S13 .GX_LastVld1 = THISFORM. cCW921S13.Columns(1).Ctrl1 .GXColumnNo - 1
               GX_rploop = .T.
            ENDIF
            IF Gx_fel_sel
               THISFORM.cCW921S13 .RestoreGridPos()
               THISFORM.cCW921S13.SF (4, @GX_SFERR)
               THISFORM.cCW921S13.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW921S13 .ResetSavedGridPos()
         SELECT( THISFORM.cCW921S13 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW921S13.SF (3, @GX_SFERR)
         ENDIF
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV8Emprcod
         Aux1 = THISFORM.A346DcCNro
         Aux3 = THISFORM.AV18Dccdrf
         Aux4 = THISFORM.AV20Dccdro
         Aux5 = THISFORM.AV17Usuari
         Aux6 = THISFORM.AV21Fechah
         DO PReqDoc1 WITH Aux0 , Aux1 , 0 , Aux3 , Aux4 , Aux5 , Aux6 , "C"
         THISFORM.AV8Emprcod = Aux0
         THISFORM.A346DcCNro = Aux1
         THISFORM.AV18Dccdrf = Aux3
         THISFORM.AV20Dccdro = Aux4
         THISFORM.AV17Usuari = Aux5
         THISFORM.AV21Fechah = Aux6
         THISFORM. cCW921S13 .RestoreGridPos()
         THISFORM. cCW921S13.Columns(3).Ctrl1 .RefreshSfAtt()
         THISFORM. cCW921S13.Columns(4).Ctrl1 .RefreshSfAtt()
         THISFORM. cCW921S13 .GX_rec_modif = .T.
         THISFORM. cCW921S13 .GX_LastVld1 = THISFORM. cCW921S13.Columns(3).Ctrl1 .GXColumnNo - 1
         GX_rploop = .T.
         IF TYPE( "HConn_Default" ) = "N"
            IF GXCONNECTED
               Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
            ENDIF
         ENDIF
         THISFORM.ReleaseAll()
         RETURN
         THISFORM.GX_in_event = .F.
