               THISFORM.A346DcCNro = AuxA346DcCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09212 = Gx_err
               THISFORM.GX_DB_GetW09212_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WReqDoc1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09212 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09212) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09212 = Gx_err
                  THISFORM.GX_DB_GetW09212_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09212 <> 101
               BRKVPL2 = .F.
               THISFORM.AV18Dccdrf = CTOD("  /  /  ")
               THISFORM.AV20Dccdro = SPACE(100)
               THISFORM.A150EntGru = THISFORM.Buf_W09212_150EntGruTip
               THISFORM.A347DcCFec = THISFORM.Buf_W09212_347DcCFec
               THISFORM.A352DcCNro = THISFORM.Buf_W09212_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W09212_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W09212_349DccSer
               THISFORM.A348DcCTip = THISFORM.Buf_W09212_348DcCTip
               THISFORM.A2835DccDr = THISFORM.Buf_W09212_2835DccDrObs
               THISFORM.A2834DccDr = THISFORM.Buf_W09212_2834DccDrFch
               THISFORM.A2833DccDr = THISFORM.Buf_W09212_2833DccDrDsc
               THISFORM.A2832dccDr = THISFORM.Buf_W09212_2832dccDrcod
               THISFORM.A153EntRaz = THISFORM.Buf_W09212_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W09212_120EntCod
               THISFORM.A2833DccDr = THISFORM.Buf_W09212_2833DccDrDsc
               THISFORM.A150EntGru = THISFORM.Buf_W09212_150EntGruTip
               THISFORM.A347DcCFec = THISFORM.Buf_W09212_347DcCFec
               THISFORM.A352DcCNro = THISFORM.Buf_W09212_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W09212_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W09212_349DccSer
               THISFORM.A348DcCTip = THISFORM.Buf_W09212_348DcCTip
               THISFORM.A120EntCod = THISFORM.Buf_W09212_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W09212_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U17VPL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09212 = Gx_err
               THISFORM.GX_DB_GetW09212_01 ()
            ENDDO
         ENDIF
      ENDPROC
