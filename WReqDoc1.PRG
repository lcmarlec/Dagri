               THISFORM.gx_RefKeep = .T.
            ENDIF
            THISFORM.GX_Refresh = 0
            THISFORM. cCW921S13 .GXRefreshSf( .F., .T.)
            THISFORM.gx_RefKeep = .F.
         ENDIF
         THISFORM. cCW921S13 .GXSaveTempSf( GX_Ref )
