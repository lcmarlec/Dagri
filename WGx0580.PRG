      PROCEDURE CreateTemp
         LOCAL SCW532S19
         SCW532S19 = ""
         IF USED( "SCW532S19" )
            SELECT SCW532S19
            SCW532S19 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW532S19
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1652CPCo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1654CPCl"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 240
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1656CPPa"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1658CPPc"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW532S19 = GETE('z:\temp') + '\' + SCW532S19
            ENDIF
            CREATE DBF (SCW532S19) FROM ARRAY GX_STRUCT
            USE
            USE (SCW532S19) EXCLUSIVE ALIAS SCW532S19
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW532S19
         THIS.GX_SfAlias = "SCW532S19"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05322" , @HStmt_W05322 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0580","W05322","",GX_CURSOR_TYPE_READONLY,@HStmt_W05322) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CPLocal], [CPPConf], [CPPciCod], [CPPaiCod], [CPClear], [CPCod], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [CODPOS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([CPCod] like ?) AND "
                  cmdbuf = cmdbuf + "  ([CPLocal] like ?) AND ([CPClear] >= ?) AND ([CPPaiCod] like ?) AND ([CPPciCod] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CPPConf] like ?) ORDER BY [EmpCod], [CPCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05322,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05322,9)
                  THISFORM.GX_DB_BindColsW05322_01 ()
                  THISFORM.GX_DB_BindParmW05322_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05322,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05322,2,PADR( TRIM(THISFORM.AV6C1652),8, '%'),LEN(PADR( TRIM(THISFORM.AV6C1652),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05322,3,PADR( TRIM(THISFORM.AV7C1653),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C1653),40, '%')),0)
               AuxAV8C1654 = THISFORM.AV8C1654
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05322,4,@AuxAV8C1654,0)
               THISFORM.AV8C1654 = AuxAV8C1654
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05322,5,PADR( TRIM(THISFORM.AV9C1656),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C1656),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05322,6,PADR( TRIM(THISFORM.AV10C1658),4, '%'),LEN(PADR( TRIM(THISFORM.AV10C1658),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05322,7,PADR( TRIM(THISFORM.AV11C1675),1, '%'),LEN(PADR( TRIM(THISFORM.AV11C1675),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05322 = Gx_err
               THISFORM.GX_DB_GetW05322_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05322 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05322) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05322 = Gx_err
                  THISFORM.GX_DB_GetW05322_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05322 <> 101
               BRKVES2 = .F.
               THISFORM.A1653CPLoc = THISFORM.Buf_W05322_1653CPLocal
               THISFORM.A1675CPPCo = THISFORM.Buf_W05322_1675CPPConf
               THISFORM.A1658CPPci = THISFORM.Buf_W05322_1658CPPciCod
               THISFORM.A1656CPPai = THISFORM.Buf_W05322_1656CPPaiCod
               THISFORM.A1654CPCle = THISFORM.Buf_W05322_1654CPClear
               THISFORM.A1652CPCod = THISFORM.Buf_W05322_1652CPCod
               THISFORM.A2EmpCod = THISFORM.Buf_W05322_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VES2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05322 = Gx_err
               THISFORM.GX_DB_GetW05322_01 ()
            ENDDO
         ENDIF
      ENDPROC
