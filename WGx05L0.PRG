               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05632,6,@AuxAV16C1726,0)
               THISFORM.AV16C1726 = AuxAV16C1726
               AuxAV15C1724 = THISFORM.AV15C1724
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05632,7,@AuxAV15C1724,0)
               THISFORM.AV15C1724 = AuxAV15C1724
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05632) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05632 = Gx_err
               THISFORM.GX_DB_GetW05632_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05632 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05632) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05632 = Gx_err
                  THISFORM.GX_DB_GetW05632_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05632 <> 101
               BRKVFN2 = .F.
               THISFORM.A1730TalFc = THISFORM.Buf_W05632_1730TalFch
               THISFORM.A1725TalFc = THISFORM.Buf_W05632_1725TalFchVnc
               THISFORM.A1724TalNr = THISFORM.Buf_W05632_1724TalNroHta
               THISFORM.A1726TalHa = THISFORM.Buf_W05632_1726TalHab
               THISFORM.A1723TalNr = THISFORM.Buf_W05632_1723TalNroDde
               THISFORM.A1721TalBc = THISFORM.Buf_W05632_1721TalBcoCta
               THISFORM.A2EmpCod = THISFORM.Buf_W05632_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VFN2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05632) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05632 = Gx_err
               THISFORM.GX_DB_GetW05632_01 ()
            ENDDO
         ENDIF
      ENDPROC
