            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 39
            IF THIS.gx_ret > 0
               gx_val_ret = THIS.gx_ret
            ELSE
               gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            ENDIF
            IF gx_val_ret >= 0
               IF THIS.GX_Mouse
                  THIS.GotMouseDown()
               ENDIF
               NODEFAULT
               IF gx_val_ret >= 0
                  IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                     THISFORM.ReleaseAll()
                  ENDIF
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
            IF THISFORM.GX_NewLastVld != -1
               THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
               THISFORM.GX_NewLastVld = -1
               NODEFAULT
               RETURN
            ENDIF
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 39 )
               RETURN
            ENDIF
            THISFORM. cCT38S26 .SaveKey()
         ENDIF
         gx_a_trn = .F.
         THISFORM. cCT38S26 .GX_focusInGrid = .T.
         IF THISFORM.GX_Mode != "INS"
            THISFORM. cCT38S26 . AfterRowColChange1()
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 39
            THISFORM.SetLevel( 39 )
            THISFORM.SetMode("", "N" )
            THISFORM. cCT38S26.Columns(1).Ctrl1 .InitLevel( 39 )
            THISFORM.GX_last_fld_lvl = 39
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A404TdcImp"
         THISFORM.cCT38S26 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCT38S26 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCT38S26 .GX_lastkey = 9.or. THISFORM.cCT38S26 .GX_lastkey = 13)
            IF ! THISFORM.cCT38S26 .GridValidObj( THISFORM.cCT38S26 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCT38S26 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THIS.GX_noacc_cond = .F.
         IF THISFORM.A401TdcImp = "PIVA  " .AND. substr( THISFORM.A382TdcTip , 3 , 1 ) = "P"
            THIS.GX_noacc_cond = .T.
            gx_na_fld = -1
            IF THISFORM. cCT38S26 .GX_LastKey = 19 .or. THISFORM. cCT38S26 .GX_LastKey = 15
               gx_na_fld = THISFORM.cCT38S26.ToSetFocusEnabled(THIS.GXColumnNo-1,-1)
            ELSE
               gx_na_fld = THISFORM.cCT38S26.ToSetFocusEnabled(THIS.GXColumnNo+1, 1)
            ENDIF
            NODEFAULT
            IF gx_na_fld > 0
               THISFORM. cCT38S26 .gx_can_changerow = .F.
               THISFORM. cCT38S26 .Columns(gx_na_fld).SetFocus()
               THISFORM. cCT38S26 .gx_can_changerow = .T.
            ELSE
               IF ! THISFORM.SetFocusEnabled( THISFORM.cCT38S26.TabIndex , -1, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
         ENDIF
