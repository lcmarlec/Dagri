                  THISFORM. Z3426xPciA = ZZ3426xPciA
                  THISFORM.FormRefresh( .F. , .T. )
               ELSE
                  THISFORM.SaveMode("UPD", "")
                  THISFORM.LoadObj(0)
                  THISFORM.FormRefresh( .F. , .T. )
                  SELECT(gxO_Area)
                  THIS.WriteObj(THISFORM.GX_mode)
               ENDIF
            ELSE
               IF THISFORM.Gx_mode = 'INS'
                  gxO_Mode = THISFORM.Gx_mode
                  THISFORM.Gx_mode = "UPD"
                  THISFORM.LoadObj(0)
                  DO GX_ERRMW WITH "Ya existe el registro"
                  THISFORM.Gx_mode = gxO_Mode
                  RETURN .F.
               ENDIF
            ENDIF
            IF THISFORM.Buf_T02163_2080xPaiCod = THISFORM.A2080xPaiC
            ELSE
               DO GX_ERRMW WITH "No es posible acceder al registro"
               UserCancel = .T.
               CLEAR READ
               RETURN .F.
            ENDIF
         ELSE
            IF THISFORM.AMode .OR. THISFORM.Gx_mode = 'INS'
               THISFORM.SetMode("EOF", "1" )
               THISFORM.LoadObj(1)
               THISFORM.FormRefresh( .F. , .T. )
            ELSE
               DO GX_ERRMW WITH "No se encontro el registro"
               RETURN .F.
            ENDIF
         ENDIF
         IF THISFORM.Gx_mode = 'DLT' .OR. THISFORM.Gx_mode = 'UPD'
            THISFORM.A2081xPciC = THISFORM.AV21Pcicod
         ENDIF
         THISFORM. cCT216A2081 .Refresh()
         AuxA2080xPaiC = THISFORM.A2080xPaiC
         Gx_err = GX_DB_SetStr( HStmt_T02164,1,AuxA2080xPaiC,4,0)
