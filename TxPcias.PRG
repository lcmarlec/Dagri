               THISFORM.T02162 = iif( THISFORM.T02168 = 0 , 104 , THISFORM.T02168 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02168) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV20Numero = THISFORM.A2080xPaiC + THISFORM.A2081xPciC
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV13Emprco
            Aux3 = THISFORM.AV20Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV10Audobs
            Aux6 = THISFORM.AV9Usuario
            DO PAuditor WITH "TABL" , Aux1 , "PROV" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV13Emprco = Aux1
            THISFORM.AV20Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV10Audobs = Aux5
            THISFORM.AV9Usuario = Aux6
            THISFORM. cCT216V9 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 233 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
