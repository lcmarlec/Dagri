      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02165" , @HStmt_T02165 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TXPCIAS","T02165","",GX_CURSOR_TYPE_READONLY,@HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [PaiCod], [PciCod], [PciDsc], [PciIbr], [PciDGI], [PciCou], [PciCo2], [pciibb], "
            cmdbuf = cmdbuf + "  [pciibA], [pciagp], [pciagr] FROM [Pcias] (FASTFIRSTROW NOLOCK) WHERE [PaiCod] = "
            cmdbuf = cmdbuf + "  ? and [PciCod] >= ? ORDER BY [PaiCod], [PciCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02165,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02165,100)
            THISFORM.GX_DB_BindColsT02165_01 ()
            THISFORM.GX_DB_BindParmT02165_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2081xPciC = SPACE(4)
               ENDIF
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T02165,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               AuxA2081xPciC = THISFORM.A2081xPciC
               Gx_err = GX_DB_SetStr( HStmt_T02165,2,AuxA2081xPciC,4,0)
               THISFORM.A2081xPciC = AuxA2081xPciC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02165 = Gx_err
               THISFORM.GX_DB_GetT02165_01 ()
               Gx_fcond = THISFORM.T02165 <> 101 .AND. THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
               DO WHILE Gx_fcond
                  Gx_fcond = THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
                  IF Gx_fcond
                     EXIT
                  ELSE
                     Gx_eop = 1
                     DO WHILE Gx_eop != 0
                        Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDDO
                     THISFORM.T02165 = Gx_err
                     THISFORM.GX_DB_GetT02165_01 ()
                  ENDIF
                  Gx_fcond = THISFORM.T02165 <> 101 .AND. THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
               ENDDO
            CASE GXOP = 2 && Next record
               M2081xPciC = THISFORM.A2081xPciC
               THISFORM.A2081xPciC = SPACE(4)
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T02165,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               AuxA2081xPciC = THISFORM.A2081xPciC
               Gx_err = GX_DB_SetStr( HStmt_T02165,2,AuxA2081xPciC,4,0)
               THISFORM.A2081xPciC = AuxA2081xPciC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02165 = Gx_err
               THISFORM.GX_DB_GetT02165_01 ()
               THISFORM.A2081xPciC = M2081xPciC
               DO WHILE THISFORM.T02165 = 0 .AND. THISFORM.A2080xPaiC = THISFORM.Buf_T02165_2080xPaiCod .AND. THISFORM.A2081xPciC >= THISFORM.Buf_T02165_2081xPciCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02165 = Gx_err
                  THISFORM.GX_DB_GetT02165_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02165 <> 101 .AND. THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
               DO WHILE Gx_fcond
                  Gx_fcond = THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
                  IF Gx_fcond
                     EXIT
                  ELSE
                     Gx_eop = 1
                     DO WHILE Gx_eop != 0
                        Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDDO
                     THISFORM.T02165 = Gx_err
                     THISFORM.GX_DB_GetT02165_01 ()
                  ENDIF
                  Gx_fcond = THISFORM.T02165 <> 101 .AND. THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
               ENDDO
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2081xPciC = SPACE(4)
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T02165,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               AuxA2081xPciC = THISFORM.A2081xPciC
               Gx_err = GX_DB_SetStr( HStmt_T02165,2,AuxA2081xPciC,4,0)
               THISFORM.A2081xPciC = AuxA2081xPciC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02165 = Gx_err
               THISFORM.GX_DB_GetT02165_01 ()
               DO WHILE THISFORM.T02165 = 0
                  Gx_fcond = THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
                  IF Gx_fcond
                     THISFORM.A2081xPciC = THISFORM.Buf_T02165_2081xPciCod
                  ENDIF
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02165 = Gx_err
                  THISFORM.GX_DB_GetT02165_01 ()
               ENDDO
               AuxA2080xPaiC = THISFORM.A2080xPaiC
               Gx_err = GX_DB_SetStr( HStmt_T02165,1,AuxA2080xPaiC,4,0)
               THISFORM.A2080xPaiC = AuxA2080xPaiC
               AuxA2081xPciC = THISFORM.A2081xPciC
               Gx_err = GX_DB_SetStr( HStmt_T02165,2,AuxA2081xPciC,4,0)
               THISFORM.A2081xPciC = AuxA2081xPciC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02165) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02165 = Gx_err
               THISFORM.GX_DB_GetT02165_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2081xPciC = THISFORM.Buf_T02165_2081xPciCod
               THISFORM.A2096xPciD = THISFORM.Buf_T02165_2096xPciDsc
               THISFORM.A2097xPciI = THISFORM.Buf_T02165_2097xPciIbr
               THISFORM.A2098xPcID = THISFORM.Buf_T02165_2098xPcIDGI
               THISFORM.A2099xPciC = THISFORM.Buf_T02165_2099xPciCoU
               THISFORM.A2100xPciC = THISFORM.Buf_T02165_2100xPciCo2
               THISFORM.A2243xPciI = THISFORM.Buf_T02165_2243xPciIbB
               THISFORM.A3096xPciI = THISFORM.Buf_T02165_3096xPciIbA
               THISFORM.A3425xPciA = THISFORM.Buf_T02165_3425xPciAgP
               THISFORM.A3426xPciA = THISFORM.Buf_T02165_3426xPciAgR
         ENDCASE
         Gx_fcond = THISFORM.T02165 <> 101 .AND. THISFORM.T02165 <> 101 .AND. THISFORM.Buf_T02165_2080xPaiCod = THISFORM.A2080xPaiC
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

