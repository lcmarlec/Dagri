         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02164) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDDO
         THISFORM.T02164 = Gx_err
         THISFORM.GX_DB_GetT02164_01 ()
         IF THISFORM.T02164 = 101
            DO GX_ERRMW WITH "No existe xpais" + "."
            GX_buttpress = 0
            RETURN .F.
         ENDIF
         IF EMPTY( THISFORM.A2081xPciC )
            DO GX_ERRMW WITH "Debe ingresar un Código de Provincia !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
