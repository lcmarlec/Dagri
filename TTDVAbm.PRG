               ENDIF
            ENDIF
            IF THISFORM.GX_NewLastVld != -1
               THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
               THISFORM.GX_NewLastVld = -1
               NODEFAULT
               RETURN
            ENDIF
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 66 )
               RETURN
            ENDIF
            THISFORM. cCT103S22 .SaveKey()
         ENDIF
         gx_a_trn = .F.
