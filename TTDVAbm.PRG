         THISFORM.A648TDVLIn = THISFORM.M648TDVLIn
         THISFORM. cCT103S22 .SaveTemp()
         THISFORM. cCT103S22 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT103S22 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT103S22 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT103S22 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT103S22 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT103S22 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT103S22 .Refresh()
               THISFORM. cCT103S22 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
               THISFORM.A648TDVLIn = S648TDVLIn
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT103S22 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT103S22 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT103S22 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S473TDVNro = THISFORM.A473TDVNro .AND. S648TDVLIn = THISFORM.A648TDVLIn
            ENDDO
            IF sf_err != 0
               THISFORM. cCT103S22 .AppendRow()
               THISFORM. cCT103S22 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A473TDVNro = S473TDVNro
               THISFORM.A648TDVLIn = S648TDVLIn
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A473TDVNro = S473TDVNro
         THISFORM.A648TDVLIn = S648TDVLIn
         RETURN .F.
      ENDFUNC
