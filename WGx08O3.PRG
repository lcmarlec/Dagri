               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09002,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09002,4,PADR( TRIM(THISFORM.AV5C2774),10, '%'),LEN(PADR( TRIM(THISFORM.AV5C2774),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09002,5,PADR( TRIM(THISFORM.AV6C2775),30, '%'),LEN(PADR( TRIM(THISFORM.AV6C2775),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09002,6,PADR( TRIM(THISFORM.AV7C2776),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C2776),10, '%')),0)
               AuxAV8C2777 = THISFORM.AV8C2777
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W09002,7,@AuxAV8C2777,0)
               THISFORM.AV8C2777 = AuxAV8C2777
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09002 = Gx_err
               THISFORM.GX_DB_GetW09002_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09002 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09002) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09002 = Gx_err
                  THISFORM.GX_DB_GetW09002_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09002 <> 101
               BRKVP02 = .F.
               THISFORM.A2777CuoFc = THISFORM.Buf_W09002_2777CuoFchAl
               THISFORM.A3788CuoMc = THISFORM.Buf_W09002_3788CuoMcoCta
               THISFORM.A2776CuoUs = THISFORM.Buf_W09002_2776CuoUsuAl
               THISFORM.A2775CuoDs = THISFORM.Buf_W09002_2775CuoDsc
               THISFORM.A2774CuoId = THISFORM.Buf_W09002_2774CuoId
               GX_SFLOAD = 0
               THISFORM.U12VP02 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09002) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09002 = Gx_err
               THISFORM.GX_DB_GetW09002_01 ()
            ENDDO
         ENDIF
      ENDPROC
