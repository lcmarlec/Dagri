      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11973" , @HStmt_W11973 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSDOSCLI","W11973","",GX_CURSOR_TYPE_READONLY,@HStmt_W11973) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVTotReal], T1.[DcVTot], T1.[DcvMonCod], T1.[DcVFch], T2.[EntRaz] AS "
                  cmdbuf = cmdbuf + "  DcVEntRaz, T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVTip], "
                  cmdbuf = cmdbuf + "  T1.[DcVNroInt], T1.[EmpCod] FROM ([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[DcVEntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[DcVTip] = 'SDOI') "
                  cmdbuf = cmdbuf + "  AND (T1.[DcVEntCod] >= ?) AND (T2.[EntRaz] like ?) AND (T1.[DcVEntGruT] = 'CL') "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11973,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11973,14)
                  THISFORM.GX_DB_BindColsW11973_01 ()
                  THISFORM.GX_DB_BindParmW11973_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11973,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Clidde = THISFORM.AV21Clidde
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11973,2,@AuxAV21Clidde,0)
               THISFORM.AV21Clidde = AuxAV21Clidde
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11973,3,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11973) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11973 = Gx_err
               THISFORM.GX_DB_GetW11973_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WSdosCli"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11973 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11973) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11973 = Gx_err
                  THISFORM.GX_DB_GetW11973_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11973 <> 101
               BRKVX92 = .F.
               THISFORM.A1336DcVTo = THISFORM.Buf_W11973_1336DcVTotReal
               THISFORM.A464DcVTot = THISFORM.Buf_W11973_464DcVTot
               THISFORM.A1427DcvMo = THISFORM.Buf_W11973_1427DcvMonCod
               THISFORM.A421DcVFch = THISFORM.Buf_W11973_421DcVFch
               THISFORM.A418DcVEnt = THISFORM.Buf_W11973_418DcVEntRaz
               THISFORM.A416DcVEnt = THISFORM.Buf_W11973_416DcVEntGruT
               THISFORM.A417DcVEnt = THISFORM.Buf_W11973_417DcVEntCod
               THISFORM.A422DcVTip = THISFORM.Buf_W11973_422DcVTip
               THISFORM.A415DcVNro = THISFORM.Buf_W11973_415DcVNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W11973_2EmpCod
               THISFORM.A418DcVEnt = THISFORM.Buf_W11973_418DcVEntRaz
               GX_SFLOAD = 0
               THISFORM.U16VX92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11973) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11973 = Gx_err
               THISFORM.GX_DB_GetW11973_01 ()
            ENDDO
         ENDIF
