               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08162 = Gx_err
               THISFORM.GX_DB_GetW08162_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08162 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08162) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08162 = Gx_err
                  THISFORM.GX_DB_GetW08162_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08162 <> 101
               BRKVMO2 = .F.
               THISFORM.A3470IBExe = THISFORM.Buf_W08162_3470IBExe
               THISFORM.A2538IBEPo = THISFORM.Buf_W08162_2538IBEPor
               THISFORM.A2537IBEHt = THISFORM.Buf_W08162_2537IBEHta
               THISFORM.A2535IBETp = THISFORM.Buf_W08162_2535IBETpo
               THISFORM.A2536IBEDd = THISFORM.Buf_W08162_2536IBEDde
               GX_SFLOAD = 0
               THISFORM.U12VMO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08162 = Gx_err
               THISFORM.GX_DB_GetW08162_01 ()
            ENDDO
         ENDIF
      ENDPROC
