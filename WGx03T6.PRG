      PROCEDURE CreateTemp
         LOCAL SCW364S20
         SCW364S20 = ""
         IF USED( "SCW364S20" )
            SELECT SCW364S20
            SCW364S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW364S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1060PedI"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3FamCod"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA4FamSubC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA810PedCn"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA813PedVP"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 13
            GX_STRUCT[ 6 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW364S20 = GETE('z:\temp') + '\' + SCW364S20
            ENDIF
            CREATE DBF (SCW364S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW364S20) EXCLUSIVE ALIAS SCW364S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW364S20
         THIS.GX_SfAlias = "SCW364S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03642" , @HStmt_W03642 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX03T6","W03642","",GX_CURSOR_TYPE_READONLY,@HStmt_W03642) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PedFch], [PedGruTip], [PedEntCod], [PedSucCod], [PedSec], [PedVPrc], "
                  cmdbuf = cmdbuf + "  [PedCnt], [ArtCod], [FamSubCod], [FamCod], [PedInd] FROM [PEDIDO3] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE [EmpCod] = ? and [PedFch] = ? and [PedGruTip] = ? and [PedEntCod] "
                  cmdbuf = cmdbuf + "  = ? and [PedSucCod] = ? and [PedSec] = ? and [PedInd] >= ? ORDER BY [EmpCod], [PedFch], "
                  cmdbuf = cmdbuf + "  [PedGruTip], [PedEntCod], [PedSucCod], [PedSec], [PedInd], [FamCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03642,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03642,9)
                  THISFORM.GX_DB_BindColsW03642_01 ()
                  THISFORM.GX_DB_BindParmW03642_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03642,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA795PedFch = THISFORM.A795PedFch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03642,2,@AuxA795PedFch,0)
               THISFORM.A795PedFch = AuxA795PedFch
               AuxA797PedGru = THISFORM.A797PedGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03642,3,AuxA797PedGru,2,0)
               THISFORM.A797PedGru = AuxA797PedGru
               AuxA798PedEnt = THISFORM.A798PedEnt
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03642,4,@AuxA798PedEnt,0)
               THISFORM.A798PedEnt = AuxA798PedEnt
               AuxA802PedSuc = THISFORM.A802PedSuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03642,5,@AuxA802PedSuc,0)
               THISFORM.A802PedSuc = AuxA802PedSuc
               AuxA809PedSec = THISFORM.A809PedSec
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03642,6,@AuxA809PedSec,0)
               THISFORM.A809PedSec = AuxA809PedSec
               AuxAV5C1060 = THISFORM.AV5C1060
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03642,7,@AuxAV5C1060,0)
               THISFORM.AV5C1060 = AuxAV5C1060
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03642 = Gx_err
               THISFORM.GX_DB_GetW03642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03642 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03642) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03642 = Gx_err
                  THISFORM.GX_DB_GetW03642_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03642 <> 101
               BRKVA42 = .F.
               THISFORM.A813PedVPr = THISFORM.Buf_W03642_813PedVPrc
               THISFORM.A810PedCnt = THISFORM.Buf_W03642_810PedCnt
               THISFORM.A5ArtCod = THISFORM.Buf_W03642_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W03642_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W03642_3FamCod
               THISFORM.A1060PedIn = THISFORM.Buf_W03642_1060PedInd
               GX_SFLOAD = 0
               THISFORM.U12VA42 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03642 = Gx_err
               THISFORM.GX_DB_GetW03642_01 ()
            ENDDO
         ENDIF
      ENDPROC
