                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOFEGC1","W06122","",GX_CURSOR_TYPE_READONLY,@HStmt_W06122) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtDsc] FROM [ARTICS] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([FamCod] = ? and [FamSubCod] = ?) AND ([ArtCod] = ?) ORDER BY [FamCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06122,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06122,100)
                  THISFORM.GX_DB_BindColsW06122_01 ()
                  THISFORM.GX_DB_BindParmW06122_01 ()
               ENDIF
               AuxA3FamCod = THISFORM.A3FamCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06122,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06122,2,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06122,3,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06122 = Gx_err
               THISFORM.GX_DB_GetW06122_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV44Pgmnam = "WOfeGC1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06122 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06122) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06122 = Gx_err
                  THISFORM.GX_DB_GetW06122_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06122 <> 101
               BRKVH02 = .F.
               THISFORM.A6ArtDsc = THISFORM.Buf_W06122_6ArtDsc
               GX_SFLOAD = 1
               THISFORM.U14VH02 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06122 = Gx_err
               THISFORM.GX_DB_GetW06122_01 ()
            ENDDO
         ENDIF
         IF GX_CUERR != 0
            THISFORM.AV5Emprnom = SPACE(30)
            THISFORM.AV6Fechasi = CTOD("  /  /  ")
            THISFORM.A6ArtDsc = SPACE(50)
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
      RETURN .T.
