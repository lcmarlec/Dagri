      PROCEDURE CreateTemp
         LOCAL SCW1057S5
         SCW1057S5 = ""
         IF USED( "SCW1057S5" )
            SELECT SCW1057S5
            SCW1057S5 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1057S5
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA561TraCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA564TraNo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2312TraF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2EmpCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1057S5 = GETE('z:\temp') + '\' + SCW1057S5
            ENDIF
            CREATE DBF (SCW1057S5) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1057S5) EXCLUSIVE ALIAS SCW1057S5
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1057S5
         THIS.GX_SfAlias = "SCW1057S5"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10572" , @HStmt_W10572 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCTRFVL","W10572","",GX_CURSOR_TYPE_READONLY,@HStmt_W10572) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [TraFEgr], [TraFVL], [TraNom], [TraCod], [EmpCod] FROM [EMPLEADO] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ?) AND ([TraFVL] < DATEADD( dd,7, ?)) AND ([TraFEgr] = "
                  cmdbuf = cmdbuf + "  convert( DATETIME, '17530101', 112 )) ORDER BY [EmpCod], [TraCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10572,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10572,9)
                  THISFORM.GX_DB_BindColsW10572_01 ()
                  THISFORM.GX_DB_BindParmW10572_01 ()
               ENDIF
               AuxAV5Emprcod = THISFORM.AV5Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10572,1,@AuxAV5Emprcod,0)
               THISFORM.AV5Emprcod = AuxAV5Emprcod
               AuxAV6Fechasi = THISFORM.AV6Fechasi
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10572,2,@AuxAV6Fechasi,0)
               THISFORM.AV6Fechasi = AuxAV6Fechasi
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10572 = Gx_err
               THISFORM.GX_DB_GetW10572_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10572 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10572) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10572 = Gx_err
                  THISFORM.GX_DB_GetW10572_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10572 <> 101
               BRKVTD2 = .F.
               THISFORM.A2291TraFE = THISFORM.Buf_W10572_2291TraFEgr
               THISFORM.A2312TraFV = THISFORM.Buf_W10572_2312TraFVL
               THISFORM.A564TraNom = THISFORM.Buf_W10572_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W10572_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W10572_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U14VTD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10572 = Gx_err
               THISFORM.GX_DB_GetW10572_01 ()
            ENDDO
         ENDIF
      ENDPROC
