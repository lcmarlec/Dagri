      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09572" , @HStmt_W09572 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09B5","W09572","",GX_CURSOR_TYPE_READONLY,@HStmt_W09572) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ComFch], [ComFcSer], [ComFcSuc], [ComFcNro], [ComTraFch], [TraCod] "
                  cmdbuf = cmdbuf + "  FROM [COMIDA1] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [ComFch] = ? and [ComFcSer] "
                  cmdbuf = cmdbuf + "  = ? and [ComFcSuc] = ? and [ComFcNro] = ? and [TraCod] >= ? and [ComTraFch] >= ? "
                  cmdbuf = cmdbuf + "  ORDER BY [EmpCod], [ComFch], [ComFcSer], [ComFcSuc], [ComFcNro], [TraCod], [ComTraFch] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09572,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09572,9)
                  THISFORM.GX_DB_BindColsW09572_01 ()
                  THISFORM.GX_DB_BindParmW09572_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09572,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2899ComFc = THISFORM.A2899ComFc
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09572,2,@AuxA2899ComFc,0)
               THISFORM.A2899ComFc = AuxA2899ComFc
               AuxA2900ComFc = THISFORM.A2900ComFc
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09572,3,AuxA2900ComFc,1,0)
               THISFORM.A2900ComFc = AuxA2900ComFc
               AuxA2901ComFc = THISFORM.A2901ComFc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09572,4,@AuxA2901ComFc,0)
               THISFORM.A2901ComFc = AuxA2901ComFc
               AuxA2902ComFc = THISFORM.A2902ComFc
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09572,5,@AuxA2902ComFc,0)
               THISFORM.A2902ComFc = AuxA2902ComFc
               AuxAV5C561 = THISFORM.AV5C561
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09572,6,@AuxAV5C561,0)
               THISFORM.AV5C561 = AuxAV5C561
               AuxAV6C2905 = THISFORM.AV6C2905
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09572,7,@AuxAV6C2905,0)
               THISFORM.AV6C2905 = AuxAV6C2905
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09572 = Gx_err
               THISFORM.GX_DB_GetW09572_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09572 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09572) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09572 = Gx_err
                  THISFORM.GX_DB_GetW09572_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09572 <> 101
               BRKVQL2 = .F.
               THISFORM.A2905ComTr = THISFORM.Buf_W09572_2905ComTraFch
               THISFORM.A561TraCod = THISFORM.Buf_W09572_561TraCod
               GX_SFLOAD = 0
               THISFORM.U12VQL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09572 = Gx_err
               THISFORM.GX_DB_GetW09572_01 ()
            ENDDO
         ENDIF
