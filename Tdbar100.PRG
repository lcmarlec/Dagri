            Gx_longc = .F.
            IF THISFORM.T00242 = 101 .OR. THISFORM.Z246ACDesA <> THISFORM.Buf_T00242_246ACDesArt
               DO GX_ERRMW WITH "DBAR1000 fue modificada."
               RETURN .F.
