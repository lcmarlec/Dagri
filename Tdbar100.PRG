      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 21
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT24A245 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 21
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA245ACCodA = THISFORM.A245ACCodA
                  Gx_err = GX_DB_SetLong( HStmt_T00243,1,@AuxA245ACCodA,0)
                  THISFORM.A245ACCodA = AuxA245ACCodA
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00243) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00243 = Gx_err
                  THISFORM.GX_DB_GetT00243_01 ()
                  THISFORM. cCT24A245 . ZM0O21 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0O21 ()
               THISFORM. cCT24A245 . ZM0O21 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0O21 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT24A249 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0O21 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0O21 ()
                  RETURN
               ENDIF
               THISFORM.cCT24A245.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00243) , "TDBAR100" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00242) , "TDBAR100" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT24A249 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT24A245 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

