               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07082,5,@AuxAV7C1796,0)
               THISFORM.AV7C1796 = AuxAV7C1796
               AuxAV8C1797 = THISFORM.AV8C1797
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07082,6,@AuxAV8C1797,0)
               THISFORM.AV8C1797 = AuxAV8C1797
               AuxAV9C1798 = THISFORM.AV9C1798
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07082,7,@AuxAV9C1798,0)
               THISFORM.AV9C1798 = AuxAV9C1798
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07082 = Gx_err
               THISFORM.GX_DB_GetW07082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07082 = Gx_err
                  THISFORM.GX_DB_GetW07082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07082 <> 101
               BRKVJO2 = .F.
               THISFORM.A1798echmc = THISFORM.Buf_W07082_1798echmcoMon
               THISFORM.A1797EchMc = THISFORM.Buf_W07082_1797EchMcoImp
               THISFORM.A1796EchMc = THISFORM.Buf_W07082_1796EchMcoFch
               THISFORM.A1794EchMc = THISFORM.Buf_W07082_1794EchMcoCta
               THISFORM.A1792EchMc = THISFORM.Buf_W07082_1792EchMcoCod
               GX_SFLOAD = 0
               THISFORM.U12VJO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07082 = Gx_err
               THISFORM.GX_DB_GetW07082_01 ()
            ENDDO
         ENDIF
      ENDPROC
