      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01132" , @HStmt_W01132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODS","W01132","",GX_CURSOR_TYPE_READONLY,@HStmt_W01132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[FamCod], T2.[FamSubCod], T2.[ArtCod], T1.[EmpCod], T1.[OprFRes], T1.[OPrEst], "
                  cmdbuf = cmdbuf + "  T1.[OPrRes], T1.[OPrCnt], T1.[OPrForNro], T2.[ArtDsc], T1.[OprArtCod], T1.[OprFamSubC], "
                  cmdbuf = cmdbuf + "  T1.[OPrFamCod], T1.[OPrSLt], T1.[OPrLot] FROM ([OPROD] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[OPrFamCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamSubCod] = T1.[OprFamSubC] AND T2.[ArtCod] = T1.[OprArtCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[OPrLot] >= ?) ORDER BY T1.[EmpCod], T1.[OPrFamCod], T1.[OprFamSubC], "
                  cmdbuf = cmdbuf + "  T1.[OprArtCod], T1.[OPrLot], T1.[OPrSLt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01132,15)
                  THISFORM.GX_DB_BindColsW01132_01 ()
                  THISFORM.GX_DB_BindParmW01132_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01132,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV12Desde = THISFORM.AV12Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01132,2,@AuxAV12Desde,0)
               THISFORM.AV12Desde = AuxAV12Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01132 = Gx_err
               THISFORM.GX_DB_GetW01132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV18Pgmnam = "WOProds"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01132 = Gx_err
                  THISFORM.GX_DB_GetW01132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01132 <> 101
               BRKV352 = .F.
               THISFORM.A3FamCod = THISFORM.Buf_W01132_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01132_4FamSubCod
               THISFORM.A5ArtCod = THISFORM.Buf_W01132_5ArtCod
               THISFORM.A2EmpCod = THISFORM.Buf_W01132_2EmpCod
               THISFORM.A762OprFRe = THISFORM.Buf_W01132_762OprFRes
               THISFORM.A752OPrEst = THISFORM.Buf_W01132_752OPrEst
               THISFORM.A757OPrRes = THISFORM.Buf_W01132_757OPrRes
               THISFORM.A751OPrCnt = THISFORM.Buf_W01132_751OPrCnt
               THISFORM.A753OPrFor = THISFORM.Buf_W01132_753OPrForNro
               THISFORM.A6ArtDsc = THISFORM.Buf_W01132_6ArtDsc
               THISFORM.A747OprArt = THISFORM.Buf_W01132_747OprArtCod
               THISFORM.A746OprFam = THISFORM.Buf_W01132_746OprFamSubC
               THISFORM.A745OPrFam = THISFORM.Buf_W01132_745OPrFamCod
               THISFORM.A749OPrSLt = THISFORM.Buf_W01132_749OPrSLt
               THISFORM.A748OPrLot = THISFORM.Buf_W01132_748OPrLot
               GX_SFLOAD = 0
               THISFORM.U17V352 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01132 = Gx_err
               THISFORM.GX_DB_GetW01132_01 ()
            ENDDO
         ENDIF
      ENDPROC
