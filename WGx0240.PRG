      PROCEDURE CreateTemp
         LOCAL SCW607S20
         SCW607S20 = ""
         IF USED( "SCW607S20" )
            SELECT SCW607S20
            SCW607S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW607S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA682OCoNr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA683OcoEn"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 2
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA684OcoEn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA686OCoSu"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA687OCoNr"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW607S20 = GETE('z:\temp') + '\' + SCW607S20
            ENDIF
            CREATE DBF (SCW607S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW607S20) EXCLUSIVE ALIAS SCW607S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW607S20
         THIS.GX_SfAlias = "SCW607S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06072" , @HStmt_W06072 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0240","W06072","",GX_CURSOR_TYPE_READONLY,@HStmt_W06072) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [OCoFch], [OCoNro], [OCoSuc], [OcoEntCod], [OcoEntGruT], [OCoNroInt], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [OCOMPN] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [OCoNroInt] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([OcoEntGruT] like ?) AND ([OcoEntCod] >= ?) AND ([OCoSuc] >= ?) AND ([OCoNro] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([OCoFch] >= ?) ORDER BY [EmpCod], [OCoNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06072,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06072,9)
                  THISFORM.GX_DB_BindColsW06072_01 ()
                  THISFORM.GX_DB_BindParmW06072_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06072,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C682 = THISFORM.AV6C682
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06072,2,@AuxAV6C682,0)
               THISFORM.AV6C682 = AuxAV6C682
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06072,3,PADR( TRIM(THISFORM.AV7C683),2, '%'),LEN(PADR( TRIM(THISFORM.AV7C683),2, '%')),0)
               AuxAV8C684 = THISFORM.AV8C684
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06072,4,@AuxAV8C684,0)
               THISFORM.AV8C684 = AuxAV8C684
               AuxAV9C686 = THISFORM.AV9C686
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06072,5,@AuxAV9C686,0)
               THISFORM.AV9C686 = AuxAV9C686
               AuxAV10C687 = THISFORM.AV10C687
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06072,6,@AuxAV10C687,0)
               THISFORM.AV10C687 = AuxAV10C687
               AuxAV11C688 = THISFORM.AV11C688
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06072,7,@AuxAV11C688,0)
               THISFORM.AV11C688 = AuxAV11C688
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06072 = Gx_err
               THISFORM.GX_DB_GetW06072_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06072 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06072) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06072 = Gx_err
                  THISFORM.GX_DB_GetW06072_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06072 <> 101
               BRKVGV2 = .F.
               THISFORM.A688OCoFch = THISFORM.Buf_W06072_688OCoFch
               THISFORM.A687OCoNro = THISFORM.Buf_W06072_687OCoNro
               THISFORM.A686OCoSuc = THISFORM.Buf_W06072_686OCoSuc
               THISFORM.A684OcoEnt = THISFORM.Buf_W06072_684OcoEntCod
               THISFORM.A683OcoEnt = THISFORM.Buf_W06072_683OcoEntGruT
               THISFORM.A682OCoNro = THISFORM.Buf_W06072_682OCoNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W06072_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VGV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06072 = Gx_err
               THISFORM.GX_DB_GetW06072_01 ()
            ENDDO
         ENDIF
      ENDPROC
