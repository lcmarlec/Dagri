      PROCEDURE CreateTemp
         LOCAL SCW3S3
         SCW3S3 = ""
         IF USED( "SCW3S3" )
            SELECT SCW3S3
            SCW3S3 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW3S3
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA421DcVFc"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA415DcVNr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA425DcVNr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA417DcVEn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA418DcVEn"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA422DcVTi"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA423DcVSe"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 1
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA424DcVSu"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 4
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW3S3 = GETE('z:\temp') + '\' + SCW3S3
            ENDIF
            CREATE DBF (SCW3S3) FROM ARRAY GX_STRUCT
            USE
            USE (SCW3S3) EXCLUSIVE ALIAS SCW3S3
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW3S3
         THIS.GX_SfAlias = "SCW3S3"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00032" , @HStmt_W00032 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WARCHIVO","W00032","",GX_CURSOR_TYPE_READONLY,@HStmt_W00032) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntGruT] AS DcVEntGruT, T1.[EmpCod], T1.[DcVSuc], T1.[DcVSer], T1.[DcVTip], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVNro], T1.[DcVNroInt], "
                  cmdbuf = cmdbuf + "  T1.[DcVFch] FROM ([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcVEntCod]) ORDER BY T1.[EmpCod], T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00032,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00032,20)
                  THISFORM.GX_DB_BindColsW00032_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00032 = Gx_err
               THISFORM.GX_DB_GetW00032_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00032 = Gx_err
                  THISFORM.GX_DB_GetW00032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00032 <> 101
               BRKV032 = .F.
               THISFORM.A416DcVEnt = THISFORM.Buf_W00032_416DcVEntGruT
               THISFORM.A2EmpCod = THISFORM.Buf_W00032_2EmpCod
               THISFORM.A424DcVSuc = THISFORM.Buf_W00032_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W00032_423DcVSer
               THISFORM.A422DcVTip = THISFORM.Buf_W00032_422DcVTip
               THISFORM.A418DcVEnt = THISFORM.Buf_W00032_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W00032_417DcVEntCod
               THISFORM.A425DcVNro = THISFORM.Buf_W00032_425DcVNro
               THISFORM.A415DcVNro = THISFORM.Buf_W00032_415DcVNroInt
               THISFORM.A421DcVFch = THISFORM.Buf_W00032_421DcVFch
               THISFORM.A418DcVEnt = THISFORM.Buf_W00032_418DcVEntRaz
               GX_SFLOAD = 0
               THISFORM.U12V032 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00032 = Gx_err
               THISFORM.GX_DB_GetW00032_01 ()
            ENDDO
         ENDIF
      ENDPROC
