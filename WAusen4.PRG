            RETURN .T.
         ENDIF
         THISFORM. cCW1145S34 .Gx_rec_modif = .F.
      RETURN .T.
      ENDPROC
      PROCEDURE InteractiveChange
         IF .not. THISFORM. cCW1145S34 .GX_rec_modif
            THISFORM. cCW1145S34 .Gx_rec_modif = .T.
            THISFORM. cCW1145S34 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW1145S34 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW1145S34 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
         ENDIF
         IF THIS.GXColumnNo = THISFORM. cCW1145S34 .ActiveColumn .OR. THIS.GX_CalendarValue
            THISFORM.AV45Docume = THIS.Value
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW1145S34 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
         ELSE
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            IF ! THISFORM.InRoutine("ISVALID")
               THISFORM.FormRefresh( .T. , .F. )
            ENDIF
         ENDIF
         IF gx_val_ret >= 0
            IF THIS.GX_Mouse
               THIS.GotMouseDown()
            ENDIF
            NODEFAULT
            IF gx_val_ret >= 0
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
            RETURN
         ELSE
            IF gx_val_ret = -2
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM.GX_NewLastVld != -1
            THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THISFORM. cCW1145S34 .GX_focusInGrid = .T.
         THISFORM. cCW1145S34 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 7
            THISFORM. cCW1145V9 .InitLevel( 7 )
            THISFORM.GX_last_fld_lvl = 7
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.AV45Docume"
         THISFORM.cCW1145S34 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW1145S34 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW1145S34 .GX_lastkey = 9.or. THISFORM.cCW1145S34 .GX_lastkey = 13)
            IF ! THISFORM.cCW1145S34 .GridValidObj( THISFORM.cCW1145S34 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW1145S34 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW1145S34 .gx_can_changerow = .T.
