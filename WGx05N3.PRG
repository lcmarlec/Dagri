      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW579S18 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER OCW579.EnterKey
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THIS.gx_ret > 0
            gx_val_ret = THIS.gx_ret
         ELSE
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            IF ! THISFORM.InRoutine("ISVALID")
               THISFORM.FormRefresh( .T. , .F. )
            ENDIF
         ENDIF
         IF gx_val_ret >= 0
            IF THIS.GX_Mouse
               THIS.GotMouseDown()
            ENDIF
            NODEFAULT
            IF gx_val_ret >= 0
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
            ENDIF
            RETURN
         ELSE
            IF gx_val_ret = -2
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM.GX_NewLastVld != -1
            THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         THISFORM. cCW579S18 .GX_focusInGrid = .T.
         THISFORM. cCW579S18 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW579A2 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A1749EntOb"
         THISFORM.cCW579S18 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW579S18 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW579S18 .GX_lastkey = 9.or. THISFORM.cCW579S18 .GX_lastkey = 13)
            IF ! THISFORM.cCW579S18 .GridValidObj( THISFORM.cCW579S18 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW579S18 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW579S18 .gx_can_changerow = .T.
         CGXTextBoxSf ::GotFocus
         THISFORM.LockScreen = .F.
      ENDPROC
