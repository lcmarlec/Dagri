      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05792" , @HStmt_W05792 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX05N3","W05792","",GX_CURSOR_TYPE_READONLY,@HStmt_W05792) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntObsusu], [EntFchHor], [EntNroI] FROM "
                  cmdbuf = cmdbuf + "  [PRVOBS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EntGruTip] = ? and [EntCod] "
                  cmdbuf = cmdbuf + "  = ? and [EntNroI] >= ?) AND ([EntFchHor] >= ?) AND ([EntObsusu] like ?) ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod], [EntGruTip], [EntCod], [EntNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05792,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05792,8)
                  THISFORM.GX_DB_BindColsW05792_01 ()
                  THISFORM.GX_DB_BindParmW05792_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05792,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05792,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05792,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxAV17C1746 = THISFORM.AV17C1746
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05792,4,@AuxAV17C1746,0)
               THISFORM.AV17C1746 = AuxAV17C1746
               AuxAV16C1747 = THISFORM.AV16C1747
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W05792,5,@AuxAV16C1747,0)
               THISFORM.AV16C1747 = AuxAV16C1747
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05792,6,PADR( TRIM(THISFORM.AV15C1749),10, '%'),LEN(PADR( TRIM(THISFORM.AV15C1749),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05792 = Gx_err
               THISFORM.GX_DB_GetW05792_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05792 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05792) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05792 = Gx_err
                  THISFORM.GX_DB_GetW05792_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05792 <> 101
               BRKVG32 = .F.
               THISFORM.A1749EntOb = THISFORM.Buf_W05792_1749EntObsusu
               THISFORM.A1747EntFc = THISFORM.Buf_W05792_1747EntFchHor
               THISFORM.A1746EntNr = THISFORM.Buf_W05792_1746EntNroI
               GX_SFLOAD = 0
               THISFORM.U12VG32 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05792 = Gx_err
               THISFORM.GX_DB_GetW05792_01 ()
            ENDDO
         ENDIF
      ENDPROC
