         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW579S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1746EntN"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1747EntF"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 16
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1749EntO"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW579S18 = GETE('z:\temp') + '\' + SCW579S18
            ENDIF
            CREATE DBF (SCW579S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW579S18) EXCLUSIVE ALIAS SCW579S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW579S18
