      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl422
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_422insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_422insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_422insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_422insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT400A3751 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_422insert = .F.
               THISFORM.gx_insert = THISFORM. gx_422insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
