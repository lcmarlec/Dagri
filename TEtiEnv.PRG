      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA3751EtiEn = THISFORM.A3751EtiEn
            Gx_err = GX_DB_SetStr( HStmt_T04002,1,AuxA3751EtiEn,15,0)
            THISFORM.A3751EtiEn = AuxA3751EtiEn
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T04002) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T04002 = Gx_err
            THISFORM.GX_DB_GetT04002_01 ()
            IF .NOT. THISFORM.T04002 <> 103
               DO GX_ERRMW WITH "ETIENV reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T04002 = 101 .OR. THISFORM.Z3752EtiEn <> THISFORM.Buf_T04002_3752EtiEnvFC
               DO GX_ERRMW WITH "ETIENV fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04005" , @HStmt_T04005 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TETIENV","T04005","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04005) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ETIENV] ([EtiEnvNro], [EtiEnvFC], [EtiEnvUC], [EtiEnvEst], [EtiEnvUU], "
                  cmdbuf = cmdbuf + "  [EtiEnvFU]) VALUES (?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04005,cmdbuf)
                  THISFORM.GX_DB_BindParmT04005_01 ()
               ENDIF
               AuxA3751EtiEn = THISFORM.A3751EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04005,1,AuxA3751EtiEn,15,0)
               THISFORM.A3751EtiEn = AuxA3751EtiEn
               AuxA3752EtiEn = THISFORM.A3752EtiEn
               Gx_err = GX_DB_SetDateTime( HStmt_T04005,2,@AuxA3752EtiEn,0)
               THISFORM.A3752EtiEn = AuxA3752EtiEn
               AuxA3753EtiEn = THISFORM.A3753EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04005,3,AuxA3753EtiEn,10,0)
               THISFORM.A3753EtiEn = AuxA3753EtiEn
               AuxA3754EtiEn = THISFORM.A3754EtiEn
               Gx_err = GX_DB_SetInt( HStmt_T04005,4,@AuxA3754EtiEn,0)
               THISFORM.A3754EtiEn = AuxA3754EtiEn
               AuxA3755EtiEn = THISFORM.A3755EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04005,5,AuxA3755EtiEn,10,0)
               THISFORM.A3755EtiEn = AuxA3755EtiEn
               AuxA3756EtiEn = THISFORM.A3756EtiEn
               Gx_err = GX_DB_SetDateTime( HStmt_T04005,6,@AuxA3756EtiEn,0)
               THISFORM.A3756EtiEn = AuxA3756EtiEn
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T04005) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T04005 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04005) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T04005 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04006" , @HStmt_T04006 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TETIENV","T04006","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04006) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [ETIENV] SET [EtiEnvFC]=?, [EtiEnvUC]=?, [EtiEnvEst]=?, [EtiEnvUU]=?, [EtiEnvFU]=? "
                  cmdbuf = cmdbuf + "   WHERE [EtiEnvNro] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04006,cmdbuf)
                  THISFORM.GX_DB_BindParmT04006_01 ()
               ENDIF
               AuxA3752EtiEn = THISFORM.A3752EtiEn
               Gx_err = GX_DB_SetDateTime( HStmt_T04006,1,@AuxA3752EtiEn,0)
               THISFORM.A3752EtiEn = AuxA3752EtiEn
               AuxA3753EtiEn = THISFORM.A3753EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04006,2,AuxA3753EtiEn,10,0)
               THISFORM.A3753EtiEn = AuxA3753EtiEn
               AuxA3754EtiEn = THISFORM.A3754EtiEn
               Gx_err = GX_DB_SetInt( HStmt_T04006,3,@AuxA3754EtiEn,0)
               THISFORM.A3754EtiEn = AuxA3754EtiEn
               AuxA3755EtiEn = THISFORM.A3755EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04006,4,AuxA3755EtiEn,10,0)
               THISFORM.A3755EtiEn = AuxA3755EtiEn
               AuxA3756EtiEn = THISFORM.A3756EtiEn
               Gx_err = GX_DB_SetDateTime( HStmt_T04006,5,@AuxA3756EtiEn,0)
               THISFORM.A3756EtiEn = AuxA3756EtiEn
               AuxA3751EtiEn = THISFORM.A3751EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04006,6,AuxA3751EtiEn,15,0)
               THISFORM.A3751EtiEn = AuxA3751EtiEn
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T04006) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T04006 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04006) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04007" , @HStmt_T04007 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TETIENV","T04007","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04007) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ETIENV]  WHERE [EtiEnvNro] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04007,cmdbuf)
                  THISFORM.GX_DB_BindParmT04007_01 ()
               ENDIF
               AuxA3751EtiEn = THISFORM.A3751EtiEn
               Gx_err = GX_DB_SetStr( HStmt_T04007,1,AuxA3751EtiEn,15,0)
               THISFORM.A3751EtiEn = AuxA3751EtiEn
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T04007) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T04007 = Gx_err
               THISFORM.T04002 = iif( THISFORM.T04007 = 0 , 104 , THISFORM.T04007 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T04007) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
