      PROCEDURE CreateTemp
         LOCAL SCW460S8
         SCW460S8 = ""
         IF USED( "SCW460S8" )
            SELECT SCW460S8
            SCW460S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW460S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1390TAGA"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1385TAGA"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV18Cuent"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 30
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1393TAGA"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1386TAGA"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 14
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "sA1387TAGA"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 14
            GX_STRUCT[ 6 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW460S8 = GETE('z:\temp') + '\' + SCW460S8
            ENDIF
            CREATE DBF (SCW460S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW460S8) EXCLUSIVE ALIAS SCW460S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW460S8
         THIS.GX_SfAlias = "SCW460S8"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04602" , @HStmt_W04602 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGENCBL2","W04602","",GX_CURSOR_TYPE_READONLY,@HStmt_W04602) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[TAGAsiItNr], T1.[TAGAsiTip], T1.[TAGAsiNI], T1.[EmpCod], T1.[TAGNi], T1.[TAGAsiCTaN], "
                  cmdbuf = cmdbuf + "  T1.[TAGAsiHabe], T1.[TAGAsiDebe], T1.[TAGAsiItDs], T2.[TAGAsiFch] FROM ([TASIGES1] "
                  cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [TASIGES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TAGNi] "
                  cmdbuf = cmdbuf + "  = T1.[TAGNi] AND T2.[TAGAsiTip] = T1.[TAGAsiTip] AND T2.[TAGAsiNI] = T1.[TAGAsiNI]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[TAGNi] = ? and T1.[TAGAsiCTaN] = ? ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[TAGNi], T1.[TAGAsiCTaN]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04602,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04602,15)
                  THISFORM.GX_DB_BindColsW04602_01 ()
                  THISFORM.GX_DB_BindParmW04602_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04602,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1380TAGNi = THISFORM.A1380TAGNi
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04602,2,@AuxA1380TAGNi,0)
               THISFORM.A1380TAGNi = AuxA1380TAGNi
               AuxA1385TAGAs = THISFORM.A1385TAGAs
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04602,3,AuxA1385TAGAs,12,0)
               THISFORM.A1385TAGAs = AuxA1385TAGAs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04602 = Gx_err
               THISFORM.GX_DB_GetW04602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04602 = Gx_err
                  THISFORM.GX_DB_GetW04602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04602 <> 101
               BRKVCS2 = .F.
               THISFORM.A1381TAGAs = THISFORM.Buf_W04602_1381TAGAsiTip
               THISFORM.A1382TAGAs = THISFORM.Buf_W04602_1382TAGAsiNI
               THISFORM.A1387TAGAs = THISFORM.Buf_W04602_1387TAGAsiHabe
               THISFORM.A1386TAGAs = THISFORM.Buf_W04602_1386TAGAsiDebe
               THISFORM.A1393TAGAs = THISFORM.Buf_W04602_1393TAGAsiItDs
               THISFORM.A1390TAGAs = THISFORM.Buf_W04602_1390TAGAsiFch
               THISFORM.A1390TAGAs = THISFORM.Buf_W04602_1390TAGAsiFch
               GX_SFLOAD = 0
               THISFORM.U12VCS2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04602 = Gx_err
               THISFORM.GX_DB_GetW04602_01 ()
            ENDDO
         ENDIF
      ENDPROC
