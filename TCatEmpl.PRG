      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02302" , @HStmt_T02302 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCATEMPL","T02302","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02302) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod] FROM [EMPRES] (UPDLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02302,cmdbuf)
            THISFORM.GX_DB_BindColsT02302_01 ()
            THISFORM.GX_DB_BindParmT02302_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02303" , @HStmt_T02303 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCATEMPL","T02303","",GX_CURSOR_TYPE_READONLY,@HStmt_T02303) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod] FROM [EMPRES] (NOLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02303,cmdbuf)
            THISFORM.GX_DB_BindColsT02303_01 ()
            THISFORM.GX_DB_BindParmT02303_01 ()
         ENDIF
         GXTB.ShowMode()
      ENDPROC
      PROCEDURE Init
         GXForm::Init
      ENDPROC
      PROCEDURE Destroy
         THISFORM.ResetFKeys()
      ENDPROC
      PROCEDURE Activate
         IF THISFORM.GX_init_activate
            IF THISFORM.Gx_mode <> "DSP"
            ENDIF
            IF TYPE( "OCT230" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            THISFORM.SetLevel( 53 )
            THISFORM.GX_last_fld_lvl = 53
            IF ! THISFORM.InitLevels( 53 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            IF THISFORM. cCT230A2 .MV(5) != 0
               THISFORM.SaveMode( "INS" ,"")
            ELSE
               THISFORM.LoadObj(4)
            ENDIF
            GXForm::Activate
         ENDIF
         THISFORM.ClearFrmTBar
         THISFORM.GxMenuBar.Clear
         THISFORM.SetMBTimer()
         gxMB = "OFF"
         THISFORM.GxMenuBar.Set(gxMB)
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         THISFORM.SetFKeys()
         DO CASE
            CASE THISFORM.GX_Curr_Level = 53
               THISFORM.SaveMode( THIS.GX_mode ,"")
         ENDCASE
         GXTB.ShowMode()
         GXTB.Clear()
         GXTB.ShowSB()
         IF THISFORM.Gx_Mode = "DSP"
            THISFORM. cCT230R7 .Enabled = .F.
            THISFORM. cCT230R6 .Enabled = .F.
            THISFORM. cCT230V9 .Enabled = .F.
            THISFORM. cCT230V17 .Enabled = .F.
            THISFORM. cCT230V7 .Enabled = .F.
            THISFORM. cCT230B2 .Enabled = .F.
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         THISFORM.SetFKeys()
      ENDPROC
      PROCEDURE LoadMenuBar
         THISFORM.GxMenuBar.Clear
         THISFORM.ClearFrmTBar
         RELEASE GX_FrmTBar
         THISFORM.GxMenuBar.Set("Off")
      ENDPROC
      PROCEDURE SetMBTimer
         THISFORM.GXMBTime.Interval = 50
         THISFORM.GXMBTime.FirstTime = .T.
      ENDPROC
      PROCEDURE GXMBTime.Timer
         IF THISFORM.GXMBTime.FirstTime == .T.
            THISFORM.GXMBTime.FirstTime = .F.
            THISFORM.GXMBTime.Interval = 1000000
            THISFORM.LoadMenuBar
         ENDIF
      ENDPROC
