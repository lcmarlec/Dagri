      PROCEDURE cCT230B2.GotFocus
         THISFORM.gx_over_OK = .F.
         IF ! MDOWN() .and. (THISFORM.gx_frmReadkey = 9 .or. THISFORM.gx_frmReadkey = 13)
            gx_val_ret = THISFORM.validobj2( THISFORM.GX_lastvld, THIS.GxObjOrder , THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .F., .F., .F.)
               RETURN
            ELSE
               NODEFAULT
               IF gx_val_ret = -2
                  RETURN
               ENDIF
               IF THISFORM.GX_Curr_Level = 53
                  THISFORM.GX_lastvld = 0
               ENDIF
               IF THISFORM.gx_manual_setfocus
                  THISFORM.gx_manual_setfocus = .F.
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 53
                     THISFORM.SetFocusEnabled( THISFORM. cCT230A2 .TabIndex, 0, +1, .F., .T., .F. )
                  OTHERWISE
                     RETURN
               ENDCASE
            ENDIF
         ENDIF
      ENDPROC
      PROCEDURE cCT230B2.Click
         GXO_Area = SELECT()
         THISFORM.gx_over_OK = .T.
         DO CASE
         ENDCASE
         gx_val_ret = THISFORM.validobj2( THISFORM.GX_lastvld, THIS.GxObjOrder , THIS.GxObjOrder)
         IF gx_val_ret >= 0
            THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .F., .F., .F.)
            RETURN
         ELSE
            IF gx_val_ret = -2
               RETURN
            ENDIF
         ENDIF
         THISFORM.gx_over_OK = .F.
         IF THISFORM.GX_Curr_Level = 53
            THISFORM.GX_lastvld = 0
         ENDIF
         DO CASE
            CASE THISFORM.GX_Curr_Level = 53
               THISFORM.SetFocusEnabled( THISFORM. cCT230A2 .TabIndex, 0, +1, .F., .T., .F. )
         ENDCASE
      ENDPROC
      PROCEDURE cCT230B3.Click
         IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
            RETURN
         ENDIF
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02303) , "TCATEMPL" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02302) , "TCATEMPL" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT230A2 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         THISFORM.ReleaseAll()
      ENDPROC
      PROCEDURE SetFKeys
         IF EMPTY(THISFORM.GX_CurrentEvent)
            ON KEY LABEL F1 *
            ON KEY LABEL F2 *
            ON KEY LABEL F3 *
            ON KEY LABEL F4 *
            ON KEY LABEL F5 OCT230.FunctionKey5
            ON KEY LABEL F6 *
            ON KEY LABEL F7 *
            ON KEY LABEL F8 *
            ON KEY LABEL F9 *
            ON KEY LABEL F10 *
            ON KEY LABEL F11 *
            ON KEY LABEL F12 *
            ON KEY LABEL F1
         ENDIF
      ENDPROC
      PROCEDURE ResetFKeys
         ON KEY LABEL F5 *
         ON KEY LABEL F1
      ENDPROC
      PROCEDURE KeyPress
         LPARAMETERS gxKeyCode, gxShiftCtrlAlt
         THISFORM.gx_frmReadkey = gxKeyCode
         DO CASE
            CASE gxKeyCode = 29   && First
               THIS. DoFirst()
            CASE gxKeyCode = 31   && Previous
               THIS. DoPrevious()
            CASE gxKeyCode = 30   && Next
               THIS. DoNext()
            CASE gxKeyCode = 23   && Last
               THIS. DoLast()
            CASE gxKeyCode = 27   && Escape
               IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
                  RETURN
               ENDIF
               gx_a_trn = .F.
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02303) , "TCATEMPL" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02302) , "TCATEMPL" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT230A2 .AfterTrn()
                  DO CASE
                     CASE THISFORM.GX_Mode = "INS"
                     CASE THISFORM.GX_Mode = "UPD"
                     CASE THISFORM.GX_Mode = "DLT"
                  ENDCASE
                  IF THISFORM.GX_Exit_GotFocus
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
                  gx_a_trn = .T.
               ENDIF
               THISFORM.ReleaseAll()
         ENDCASE
      ENDPROC
      PROCEDURE FunctionKey5
         ON KEY LABEL F5
         THISFORM.GX_on_button = .T.
         THISFORM.gx_force_refresh = .f.
         THISFORM. DoRefresh ()
         THISFORM.GX_on_button = .F.
         THISFORM.SetFKeys()
      ENDPROC
      PROCEDURE FunctionKey4
