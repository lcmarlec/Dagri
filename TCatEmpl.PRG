      ENDPROC
      PROCEDURE DoNext
         LOCAL GXO_Area, gxO_Rec, GX_MVErr, GX_1stLvl
         GX_MVErr = 1
         GXO_Area = SELECT()
         gxO_Rec = 0
         GX_1stLvl = .F.
         THISFORM.LockScreen = .T.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 53
               THISFORM.SetFocusEnabled( THISFORM. cCT230A2 .TabIndex, 0, +1, .F., .T., .F. )
            OTHERWISE
               RETURN
         ENDCASE
         DO CASE
            CASE THISFORM.GX_Curr_Level = 53
