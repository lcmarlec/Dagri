      PROCEDURE InitLevel
         LPARAMETER gxILvl
         LOCAL gx_oMode
         IF gxILvl != 53
            RETURN .T.
         ENDIF
         GX_lastvld = 0
         THISFORM.gx_lastvld = THIS.GxObjOrder-1
         RETURN .T.
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         THISFORM. GXInLvl53 = .T.
         IF THISFORM.GX_last_fld_lvl = 53
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 53
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 53 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02303) , "TCATEMPL" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02302) , "TCATEMPL" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT230A2 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 53
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM. gx_53insert
            THISFORM. gx_53insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 53 )
            THISFORM. cCT230A2 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 53
            THISFORM.SetLevel( 53 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT230V9 .InitLevel( 53 )
            THISFORM.GX_last_fld_lvl = 53
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         SET TOPIC TO Emprnomb
         THISFORM.Gx_cursor = "THISFORM.AV9Emprnom"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
