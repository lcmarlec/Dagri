      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12822" , @HStmt_W12822 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0BR0","W12822","",GX_CURSOR_TYPE_READONLY,@HStmt_W12822) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PalEstUsuIns], [PalEstusuMod], [PalEstFchMod], [PalEstFchIns], [PalEstDsc], "
                  cmdbuf = cmdbuf + "  [PalEstId] FROM [PalEst] (FASTFIRSTROW NOLOCK) WHERE ([PalEstId] >= ?) AND ([PalEstDsc] "
                  cmdbuf = cmdbuf + "  like ?) AND ([PalEstUsuIns] like ?) AND ([PalEstFchIns] >= ?) AND ([PalEstusuMod] "
                  cmdbuf = cmdbuf + "  like ?) AND ([PalEstFchMod] >= ?) ORDER BY [PalEstId]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12822,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12822,9)
                  THISFORM.GX_DB_BindColsW12822_01 ()
                  THISFORM.GX_DB_BindParmW12822_01 ()
               ENDIF
               AuxAV5C3766 = THISFORM.AV5C3766
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12822,1,@AuxAV5C3766,0)
               THISFORM.AV5C3766 = AuxAV5C3766
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12822,2,PADR( TRIM(THISFORM.AV6C3767),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C3767),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12822,3,PADR( TRIM(THISFORM.AV7C3768),20, '%'),LEN(PADR( TRIM(THISFORM.AV7C3768),20, '%')),0)
               AuxAV8C3769 = THISFORM.AV8C3769
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12822,4,@AuxAV8C3769,0)
               THISFORM.AV8C3769 = AuxAV8C3769
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12822,5,PADR( TRIM(THISFORM.AV9C3770),20, '%'),LEN(PADR( TRIM(THISFORM.AV9C3770),20, '%')),0)
               AuxAV10C3771 = THISFORM.AV10C3771
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12822,6,@AuxAV10C3771,0)
               THISFORM.AV10C3771 = AuxAV10C3771
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12822 = Gx_err
               THISFORM.GX_DB_GetW12822_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12822 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12822) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12822 = Gx_err
                  THISFORM.GX_DB_GetW12822_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12822 <> 101
               BRKVZM2 = .F.
               THISFORM.A3768PalEs = THISFORM.Buf_W12822_3768PalEstUsuI
               THISFORM.A3770PalEs = THISFORM.Buf_W12822_3770PalEstusuM
               THISFORM.A3771PalEs = THISFORM.Buf_W12822_3771PalEstFchM
               THISFORM.A3769PalEs = THISFORM.Buf_W12822_3769PalEstFchI
               THISFORM.A3767PalEs = THISFORM.Buf_W12822_3767PalEstDsc
               THISFORM.A3766PalEs = THISFORM.Buf_W12822_3766PalEstId
               GX_SFLOAD = 0
               THISFORM.U12VZM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12822 = Gx_err
               THISFORM.GX_DB_GetW12822_01 ()
            ENDDO
         ENDIF
