      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S1525LlaNr
         LOCAL S1512LlaLi
         S2EmpCod = THISFORM.A2EmpCod
         S1525LlaNr = THISFORM.A1525LlaNr
         S1512LlaLi = THISFORM.A1512LlaLi
         THISFORM.A1512LlaLi = THISFORM.M1512LlaLi
         THISFORM. cCT150S54 .SaveTemp()
         THISFORM. cCT150S54 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT150S54 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT150S54 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT150S54 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1512LlaLi = THISFORM.A1512LlaLi
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT150S54 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT150S54 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1512LlaLi = THISFORM.A1512LlaLi
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT150S54 .Refresh()
               THISFORM. cCT150S54 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1525LlaNr = S1525LlaNr
               THISFORM.A1512LlaLi = S1512LlaLi
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT150S54 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT150S54 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1512LlaLi = THISFORM.A1512LlaLi
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT150S54 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S1512LlaLi = THISFORM.A1512LlaLi
            ENDDO
            IF sf_err != 0
               THISFORM. cCT150S54 .AppendRow()
               THISFORM. cCT150S54 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1525LlaNr = S1525LlaNr
               THISFORM.A1512LlaLi = S1512LlaLi
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1525LlaNr = S1525LlaNr
         THISFORM.A1512LlaLi = S1512LlaLi
         RETURN .F.
      ENDFUNC
