      PROCEDURE CreateTemp
         LOCAL SCW408S13
         SCW408S13 = ""
         IF USED( "SCW408S13" )
            SELECT SCW408S13
            SCW408S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW408S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA1295SLEN"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1296SLED"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW408S13 = GETE('z:\temp') + '\' + SCW408S13
            ENDIF
            CREATE DBF (SCW408S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW408S13) EXCLUSIVE ALIAS SCW408S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW408S13
         THIS.GX_SfAlias = "SCW408S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04082" , @HStmt_W04082 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKSLE","W04082","",GX_CURSOR_TYPE_READONLY,@HStmt_W04082) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntGruTip], T2.[EntCod], T1.[EmpCod], T1.[SLEEntGruT], T2.[EntRaz], T1.[SLEEntCod], "
                  cmdbuf = cmdbuf + "  T1.[SLEDsc], T1.[SLENro] FROM ([SLESTADO] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[SLEEntGruT] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[SLEEntCod]) WHERE T1.[EmpCod] = ? and T1.[SLEEntCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[SLEEntCod], T1.[SLENro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04082,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04082,10)
                  THISFORM.GX_DB_BindColsW04082_01 ()
                  THISFORM.GX_DB_BindParmW04082_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04082,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Entcod = THISFORM.AV20Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04082,2,@AuxAV20Entcod,0)
               THISFORM.AV20Entcod = AuxAV20Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04082 = Gx_err
               THISFORM.GX_DB_GetW04082_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV23Pgmnam = "WSkSLE"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04082 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04082) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04082 = Gx_err
                  THISFORM.GX_DB_GetW04082_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04082 <> 101
               BRKVBC2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W04082_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W04082_120EntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W04082_2EmpCod
               THISFORM.A1293SLEEn = THISFORM.Buf_W04082_1293SLEEntGruT
               THISFORM.A153EntRaz = THISFORM.Buf_W04082_153EntRaz
               THISFORM.A1294SLEEn = THISFORM.Buf_W04082_1294SLEEntCod
               THISFORM.A1296SLEDs = THISFORM.Buf_W04082_1296SLEDsc
               THISFORM.A1295SLENr = THISFORM.Buf_W04082_1295SLENro
               GX_SFLOAD = 0
               THISFORM.U14VBC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04082) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04082 = Gx_err
               THISFORM.GX_DB_GetW04082_01 ()
            ENDDO
         ENDIF
      ENDPROC
