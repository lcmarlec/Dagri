               THISFORM.A1078PenMo = AuxA1078PenMo
               AuxAV18C1082 = THISFORM.AV18C1082
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03092,3,@AuxAV18C1082,0)
               THISFORM.AV18C1082 = AuxAV18C1082
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03092,4,PADR( TRIM(THISFORM.AV17C1080),12, '%'),LEN(PADR( TRIM(THISFORM.AV17C1080),12, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03092 = Gx_err
               THISFORM.GX_DB_GetW03092_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03092 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03092) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03092 = Gx_err
                  THISFORM.GX_DB_GetW03092_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03092 <> 101
               BRKV8L2 = .F.
               THISFORM.A1080PenCt = THISFORM.Buf_W03092_1080PenCtaCod
               THISFORM.A1082PenPC = THISFORM.Buf_W03092_1082PenPCtaCod
               GX_SFLOAD = 0
               THISFORM.U12V8L2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03092) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03092 = Gx_err
               THISFORM.GX_DB_GetW03092_01 ()
            ENDDO
         ENDIF
      ENDPROC
