                  cmdbuf = cmdbuf + "  ON T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[FamCod] = ? or T1.[FamCod] = ?) AND (T1.[FamSubCod] = ? or T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[ArtDsc] like ?) AND (T1.[ArtVta] = 'S') ORDER BY T1.[ArtDsc]  "
