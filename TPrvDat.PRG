      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T04062,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA150EntGru = THISFORM.A150EntGru
            Gx_err = GX_DB_SetStr( HStmt_T04062,2,AuxA150EntGru,2,0)
            THISFORM.A150EntGru = AuxA150EntGru
            AuxA120EntCod = THISFORM.A120EntCod
            Gx_err = GX_DB_SetLong( HStmt_T04062,3,@AuxA120EntCod,0)
            THISFORM.A120EntCod = AuxA120EntCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T04062) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T04062 = Gx_err
            THISFORM.GX_DB_GetT04062_01 ()
            IF .NOT. THISFORM.T04062 <> 103
               DO GX_ERRMW WITH "ENTID reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T04062 = 101 .OR. THISFORM.Z153EntRaz <> THISFORM.Buf_T04062_153EntRaz
               DO GX_ERRMW WITH "ENTID fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04065" , @HStmt_T04065 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVDAT","T04065","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04065) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ENTID] ([EntCod], [EmpCod], [EntGruTip], [EntRaz], [EntCont], [EntTel], "
                  cmdbuf = cmdbuf + "  [EntEMa], [EntInd], [EntGruCod], [EntFan], [EntDom], [EntPaiCod], [EntPciCod], [EntMunCod], "
                  cmdbuf = cmdbuf + "  [EntPos], [EntFax], [EntCui], [EntFpa], [EntNIm], [EntOrd], [EntCIvCod], [EntObs], "
