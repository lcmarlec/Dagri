      PROCEDURE cCT406B3.Click
         IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
            RETURN
         ENDIF
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04063) , "TPRVDAT" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T04062) , "TPRVDAT" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT406A1993 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "UPD"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         THISFORM.ReleaseAll()
