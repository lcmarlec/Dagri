      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. GX_1Lvl_mode = PGx_mode
         THISFORM. Gx_mode = PGx_mode
         THISFORM. A120EntCod = PA120EntCod
         THISFORM. A2EmpCod = PA2EmpCod
         THISFORM. A150EntGru = PA150EntGru
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV17Usuari = PAV17Usuari
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04062" , @HStmt_T04062 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVDAT","T04062","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T04062) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EntCod], [EmpCod], [EntGruTip], [EntRaz], [EntCont], [EntTel], [EntEMa], "
            cmdbuf = cmdbuf + "  [EntInd] FROM [ENTID] (UPDLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04062,cmdbuf)
            THISFORM.GX_DB_BindColsT04062_01 ()
            THISFORM.GX_DB_BindParmT04062_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T04063" , @HStmt_T04063 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRVDAT","T04063","",GX_CURSOR_TYPE_READONLY,@HStmt_T04063) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EntCod], [EmpCod], [EntGruTip], [EntRaz], [EntCont], [EntTel], [EntEMa], "
            cmdbuf = cmdbuf + "  [EntInd] FROM [ENTID] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T04063,cmdbuf)
