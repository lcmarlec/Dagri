            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1251tExC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA3187tExC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT127S26 = GETE('z:\temp') + '\' + SCT127S26
            ENDIF
            CREATE DBF (SCT127S26) FROM ARRAY GX_STRUCT
            USE
            USE (SCT127S26) EXCLUSIVE ALIAS SCT127S26
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
