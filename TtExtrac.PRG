      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T012716" , @HStmt_T012716 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTEXTRAC","T012716","",GX_CURSOR_TYPE_READONLY,@HStmt_T012716) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [tExNroInt], [tExCtaCod], [tExCtaImp] FROM [TEXTRA1] (NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? AND [tExNroInt] = ? ORDER BY [EmpCod], [tExNroInt], [tExCtaCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T012716,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T012716,11)
                  THISFORM.GX_DB_BindColsT012716_01 ()
                  THISFORM.GX_DB_BindParmT012716_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T012716,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1238tExNr = THISFORM.A1238tExNr
               Gx_err = GX_DB_SetDouble( HStmt_T012716,2,@AuxA1238tExNr,0)
               THISFORM.A1238tExNr = AuxA1238tExNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T012716) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T012716 = Gx_err
               THISFORM.GX_DB_GetT012716_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T012716 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T012716) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T012716 = Gx_err
                  THISFORM.GX_DB_GetT012716_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T012716 <> 101
               BRK3J142 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT127S26.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T012716_1238tExNroInt = THISFORM.A1238tExNr .AND. THISFORM.Buf_T012716_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T012716) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T012716 = Gx_err
               THISFORM.GX_DB_GetT012716_01 ()
            ENDDO
         ENDIF
      ENDPROC
