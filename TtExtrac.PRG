            IF gx_ORec <> RECNO()
               THISFORM. cCT127S26 .Refresh()
               THISFORM. cCT127S26 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1238tExNr = S1238tExNr
               THISFORM.A1249tExCt = S1249tExCt
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT127S26 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT127S26 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1238tExNr = THISFORM.A1238tExNr .AND. S1249tExCt = THISFORM.A1249tExCt
