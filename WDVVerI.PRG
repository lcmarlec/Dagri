      PROCEDURE CreateTemp
         LOCAL SCW47S8
         SCW47S8 = ""
         IF USED( "SCW47S8" )
            SELECT SCW47S8
            SCW47S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW47S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA456DcVIm"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA457DcVIm"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA458DcVNi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA459DcVIm"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA2EmpCod"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA415DcVNr"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW47S8 = GETE('z:\temp') + '\' + SCW47S8
            ENDIF
            CREATE DBF (SCW47S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW47S8) EXCLUSIVE ALIAS SCW47S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW47S8
         THIS.GX_SfAlias = "SCW47S8"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00472" , @HStmt_W00472 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVVERI","W00472","",GX_CURSOR_TYPE_READONLY,@HStmt_W00472) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVNroInt], T1.[EmpCod], T1.[DcVImpCnt], T1.[DcVNim], T2.[ImpDsc] AS DcVImpDsc, "
                  cmdbuf = cmdbuf + "  T1.[DcVImpCod] AS DcVImpCod FROM ([DCVENT2] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [IMPUES] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[ImpCod] = T1.[DcVImpCod]) WHERE T1.[EmpCod] = ? and T1.[DcVNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[DcVNroInt], T1.[DcVImpCod], T1.[DcVNim]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00472,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00472,9)
                  THISFORM.GX_DB_BindColsW00472_01 ()
                  THISFORM.GX_DB_BindParmW00472_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00472,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxA415DcVNro = THISFORM.A415DcVNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00472,2,@AuxA415DcVNro,0)
               THISFORM.A415DcVNro = AuxA415DcVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00472) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00472 = Gx_err
               THISFORM.GX_DB_GetW00472_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WDVVerI"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00472 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00472) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00472 = Gx_err
                  THISFORM.GX_DB_GetW00472_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00472 <> 101
               BRKV1B2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W00472_2EmpCod
               THISFORM.A459DcVImp = THISFORM.Buf_W00472_459DcVImpCnt
               THISFORM.A458DcVNim = THISFORM.Buf_W00472_458DcVNim
               THISFORM.A457DcVImp = THISFORM.Buf_W00472_457DcVImpDsc
               THISFORM.A456DcVImp = THISFORM.Buf_W00472_456DcVImpCod
               THISFORM.A457DcVImp = THISFORM.Buf_W00472_457DcVImpDsc
               GX_SFLOAD = 0
               THISFORM.U13V1B2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00472) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00472 = Gx_err
               THISFORM.GX_DB_GetW00472_01 ()
            ENDDO
         ENDIF
      ENDPROC
