            cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [CIMCod] >= ? ORDER BY [EmpCod], [CIMCod] "
            cmdbuf = cmdbuf + "   "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03345,cmdbuf)
