      PROCEDURE CreateTemp
         LOCAL SCW933S22
         SCW933S22 = ""
         IF USED( "SCW933S22" )
            SELECT SCW933S22
            SCW933S22 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW933S22
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2861AntT"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 240
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2862AntN"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2863AntN"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2864AntT"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 240
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV21Obs"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 100
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW933S22 = GETE('z:\temp') + '\' + SCW933S22
            ENDIF
            CREATE DBF (SCW933S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW933S22) EXCLUSIVE ALIAS SCW933S22
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW933S22
         THIS.GX_SfAlias = "SCW933S22"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09332" , @HStmt_W09332 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WANTECED","W09332","",GX_CURSOR_TYPE_READONLY,@HStmt_W09332) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AntObs], [AntTObs], [AntNom], [AntNDoc], [AntTDoc] FROM [ANTECEDE] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE [AntNom] like ? ORDER BY [AntTDoc], [AntNDoc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09332,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09332,13)
                  THISFORM.GX_DB_BindColsW09332_01 ()
                  THISFORM.GX_DB_BindParmW09332_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09332,1,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09332 = Gx_err
               THISFORM.GX_DB_GetW09332_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WAnteced"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09332 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09332) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09332 = Gx_err
                  THISFORM.GX_DB_GetW09332_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09332 <> 101
               BRKVPX2 = .F.
               THISFORM.A2865AntOb = THISFORM.Buf_W09332_2865AntObs
               THISFORM.A2864AntTO = THISFORM.Buf_W09332_2864AntTObs
               THISFORM.A2863AntNo = THISFORM.Buf_W09332_2863AntNom
               THISFORM.A2862AntND = THISFORM.Buf_W09332_2862AntNDoc
               THISFORM.A2861AntTD = THISFORM.Buf_W09332_2861AntTDoc
               GX_SFLOAD = 0
               THISFORM.U17VPX2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09332 = Gx_err
               THISFORM.GX_DB_GetW09332_01 ()
            ENDDO
         ENDIF
      ENDPROC
