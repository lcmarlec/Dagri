      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01322" , @HStmt_W01322 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRORABM","W01322","",GX_CURSOR_TYPE_READONLY,@HStmt_W01322) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ROREntGruT] AS ROREntGruT, T1.[RORNroInt], T1.[ROREntCod] AS ROREntCod, "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T1.[RorfchRec], T1.[RORNroCtr], T1.[Moncod], T1.[ROREst], T2.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS ROREntRaz, T1.[RORFch], T1.[RORNro], T1.[RORSuc] FROM ([REMING] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[ROREntGruT] AND T2.[EntCod] = T1.[ROREntCod]) WHERE (T1.[EmpCod] = ? and T1.[RORNro] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[RORSuc] = ? or ? = 0) AND (T1.[ROREst] = ? or ? = 8) AND (T1.[ROREntCod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) AND (T1.[RorfchRec] >= ? and T1.[RorfchRec] <= ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[RORNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01322,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01322,14)
                  THISFORM.GX_DB_BindColsW01322_01 ()
                  THISFORM.GX_DB_BindParmW01322_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01322,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV24Desnro = THISFORM.AV24Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01322,2,@AuxAV24Desnro,0)
               THISFORM.AV24Desnro = AuxAV24Desnro
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01322,3,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01322,4,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01322,5,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01322,6,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV28Entcod = THISFORM.AV28Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01322,7,@AuxAV28Entcod,0)
               THISFORM.AV28Entcod = AuxAV28Entcod
               AuxAV28Entcod = THISFORM.AV28Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01322,8,@AuxAV28Entcod,0)
               THISFORM.AV28Entcod = AuxAV28Entcod
               AuxAV32Dsfch = THISFORM.AV32Dsfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01322,9,@AuxAV32Dsfch,0)
               THISFORM.AV32Dsfch = AuxAV32Dsfch
               AuxAV33Htafch = THISFORM.AV33Htafch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01322,10,@AuxAV33Htafch,0)
               THISFORM.AV33Htafch = AuxAV33Htafch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01322 = Gx_err
               THISFORM.GX_DB_GetW01322_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV39Pgmnam = "WRorAbm"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01322 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01322) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01322 = Gx_err
                  THISFORM.GX_DB_GetW01322_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01322 <> 101
               BRKV3O2 = .F.
               THISFORM.A883ROREnt = THISFORM.Buf_W01322_883ROREntGruT
               THISFORM.A881RORNro = THISFORM.Buf_W01322_881RORNroInt
               THISFORM.A884ROREnt = THISFORM.Buf_W01322_884ROREntCod
               THISFORM.A2EmpCod = THISFORM.Buf_W01322_2EmpCod
               THISFORM.A2101Rorfc = THISFORM.Buf_W01322_2101RorfchRec
               THISFORM.A882RORNro = THISFORM.Buf_W01322_882RORNroCtr
               THISFORM.A193Moncod = THISFORM.Buf_W01322_193Moncod
               THISFORM.A891ROREst = THISFORM.Buf_W01322_891ROREst
               THISFORM.A885ROREnt = THISFORM.Buf_W01322_885ROREntRaz
               THISFORM.A889RORFch = THISFORM.Buf_W01322_889RORFch
               THISFORM.A888RORNro = THISFORM.Buf_W01322_888RORNro
               THISFORM.A887RORSuc = THISFORM.Buf_W01322_887RORSuc
               THISFORM.A885ROREnt = THISFORM.Buf_W01322_885ROREntRaz
               GX_SFLOAD = 0
               THISFORM.U19V3O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01322 = Gx_err
               THISFORM.GX_DB_GetW01322_01 ()
            ENDDO
         ENDIF
      ENDPROC
