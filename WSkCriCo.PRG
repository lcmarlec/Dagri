      PROCEDURE CreateTemp
         LOCAL SCW417S8
         SCW417S8 = ""
         IF USED( "SCW417S8" )
            SELECT SCW417S8
            SCW417S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW417S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1318CRIC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1319CRID"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1320CRIT"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 240
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW417S8 = GETE('z:\temp') + '\' + SCW417S8
            ENDIF
            CREATE DBF (SCW417S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW417S8) EXCLUSIVE ALIAS SCW417S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW417S8
         THIS.GX_SfAlias = "SCW417S8"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04172" , @HStmt_W04172 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKCRICO","W04172","",GX_CURSOR_TYPE_READONLY,@HStmt_W04172) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CRITiMo], [CRIDsc], [CRICod] FROM [CRINTERN] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? ORDER BY [EmpCod], [CRICod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04172,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04172,15)
                  THISFORM.GX_DB_BindColsW04172_01 ()
                  THISFORM.GX_DB_BindParmW04172_01 ()
               ENDIF
               AuxAV11Emprco = THISFORM.AV11Emprco
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04172,1,@AuxAV11Emprco,0)
               THISFORM.AV11Emprco = AuxAV11Emprco
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04172 = Gx_err
               THISFORM.GX_DB_GetW04172_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV16Pgmnam = "WSkCriCo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04172 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04172) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04172 = Gx_err
                  THISFORM.GX_DB_GetW04172_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04172 <> 101
               BRKVBL2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W04172_2EmpCod
               THISFORM.A1320CRITi = THISFORM.Buf_W04172_1320CRITiMo
               THISFORM.A1319CRIDs = THISFORM.Buf_W04172_1319CRIDsc
               THISFORM.A1318CRICo = THISFORM.Buf_W04172_1318CRICod
               GX_SFLOAD = 0
               THISFORM.U14VBL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04172 = Gx_err
               THISFORM.GX_DB_GetW04172_01 ()
            ENDDO
         ENDIF
      ENDPROC
