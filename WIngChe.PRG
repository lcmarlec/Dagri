      PROCEDURE CreateTemp
         LOCAL SCW446S12
         SCW446S12 = ""
         IF USED( "SCW446S12" )
            SELECT SCW446S12
            SCW446S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW446S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA1015TTes"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1016TTes"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1034TTes"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV23Ttesi"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA1012TTes"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA621McoBc"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA624McoCt"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 1
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW446S12 = GETE('z:\temp') + '\' + SCW446S12
            ENDIF
            CREATE DBF (SCW446S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW446S12) EXCLUSIVE ALIAS SCW446S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW446S12
         THIS.GX_SfAlias = "SCW446S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04462" , @HStmt_W04462 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WINGCHE","W04462","",GX_CURSOR_TYPE_READONLY,@HStmt_W04462) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[TTesMonCod] AS TTesMonCod, T1.[EmpCod], T1.[TTesCotImp], T1.[TTesImp], "
                  cmdbuf = cmdbuf + "  T1.[TTesEntGru], T1.[TTesNroI], T3.[McoCta], T3.[McoBco], T1.[TTesLin], T2.[MonSim] "
                  cmdbuf = cmdbuf + "  AS TTesMonSim, T3.[MCoDsc] AS TTesMedDsc, T1.[TTesMedCod] AS TTesMedCod FROM (([TTESCYP1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) ON T2.[Moncod] = T1.[TTesMonCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [MEDCOB] T3 (NOLOCK) ON T3.[MCoCod] = T1.[TTesMedCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[TTesNroI] = ? ORDER BY T1.[EmpCod], T1.[TTesNroI], T1.[TTesLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04462,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04462,12)
                  THISFORM.GX_DB_BindColsW04462_01 ()
                  THISFORM.GX_DB_BindParmW04462_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04462,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV17Nroint = THISFORM.AV17Nroint
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04462,2,@AuxAV17Nroint,0)
               THISFORM.AV17Nroint = AuxAV17Nroint
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04462 = Gx_err
               THISFORM.GX_DB_GetW04462_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV37Pgmnam = "WIngChe"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04462 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04462) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04462 = Gx_err
                  THISFORM.GX_DB_GetW04462_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04462 <> 101
               BRKVCE2 = .F.
               THISFORM.AV23Ttesim = 0.00
               THISFORM.A1032TTesM = THISFORM.Buf_W04462_1032TTesMonCod
               THISFORM.A2EmpCod = THISFORM.Buf_W04462_2EmpCod
               THISFORM.A1035TTesC = THISFORM.Buf_W04462_1035TTesCotImp
               THISFORM.A1022TTesI = THISFORM.Buf_W04462_1022TTesImp
               THISFORM.A1028TTesE = THISFORM.Buf_W04462_1028TTesEntGru
               THISFORM.A1011TTesN = THISFORM.Buf_W04462_1011TTesNroI
               THISFORM.A624McoCta = THISFORM.Buf_W04462_624McoCta
               THISFORM.A621McoBco = THISFORM.Buf_W04462_621McoBco
               THISFORM.A1012TTesL = THISFORM.Buf_W04462_1012TTesLin
               THISFORM.A1034TTesM = THISFORM.Buf_W04462_1034TTesMonSim
               THISFORM.A1016TTesM = THISFORM.Buf_W04462_1016TTesMedDsc
               THISFORM.A1015TTesM = THISFORM.Buf_W04462_1015TTesMedCod
               THISFORM.A1034TTesM = THISFORM.Buf_W04462_1034TTesMonSim
               THISFORM.A624McoCta = THISFORM.Buf_W04462_624McoCta
               THISFORM.A621McoBco = THISFORM.Buf_W04462_621McoBco
               THISFORM.A1016TTesM = THISFORM.Buf_W04462_1016TTesMedDsc
               GX_SFLOAD = 0
               THISFORM.U17VCE2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04462) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04462 = Gx_err
               THISFORM.GX_DB_GetW04462_01 ()
            ENDDO
         ENDIF
      ENDPROC
