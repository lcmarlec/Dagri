         ENDIF
         THISFORM.Gx_cursor = "THISFORM.AV29Sel"
         THISFORM.cCW615S11 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW615S11 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW615S11 .GX_lastkey = 9.or. THISFORM.cCW615S11 .GX_lastkey = 13)
