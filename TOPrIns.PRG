         ENDIF
         THISFORM.gx_over_OK = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 84
               THISFORM.SetFocusEnabled( THISFORM. cCT82S48 .TabIndex, 0, +1, .F., .T., .F. )
            CASE THISFORM.GX_Curr_Level = 85
