      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S745OPrFam
         LOCAL S746OprFam
         LOCAL S747OprArt
         LOCAL S748OPrLot
         LOCAL S749OPrSLt
         LOCAL S763OprILi
         LOCAL S764OprIFa
         LOCAL S765OprIFa
         LOCAL S766OprIAr
         S2EmpCod = THISFORM.A2EmpCod
         S745OPrFam = THISFORM.A745OPrFam
         S746OprFam = THISFORM.A746OprFam
         S747OprArt = THISFORM.A747OprArt
         S748OPrLot = THISFORM.A748OPrLot
         S749OPrSLt = THISFORM.A749OPrSLt
         S763OprILi = THISFORM.A763OprILi
         S764OprIFa = THISFORM.A764OprIFa
         S765OprIFa = THISFORM.A765OprIFa
         S766OprIAr = THISFORM.A766OprIAr
         THISFORM.A763OprILi = THISFORM.M763OprILi
         THISFORM.A764OprIFa = THISFORM.M764OprIFa
         THISFORM.A765OprIFa = THISFORM.M765OprIFa
         THISFORM.A766OprIAr = THISFORM.M766OprIAr
         THISFORM. cCT82S48 .SaveTemp()
         THISFORM. cCT82S48 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT82S48 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT82S48 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT82S48 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S745OPrFam = THISFORM.A745OPrFam .AND. S746OprFam = THISFORM.A746OprFam .AND. S747OprArt = THISFORM.A747OprArt .AND. S748OPrLot = THISFORM.A748OPrLot
         Gx_fcond = Gx_fcond .AND. S749OPrSLt = THISFORM.A749OPrSLt .AND. S763OprILi = THISFORM.A763OprILi .AND. S764OprIFa = THISFORM.A764OprIFa .AND. S765OprIFa = THISFORM.A765OprIFa
         Gx_fcond = Gx_fcond .AND. S766OprIAr = THISFORM.A766OprIAr
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT82S48 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT82S48 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S745OPrFam = THISFORM.A745OPrFam .AND. S746OprFam = THISFORM.A746OprFam .AND. S747OprArt = THISFORM.A747OprArt .AND. S748OPrLot = THISFORM.A748OPrLot
            Gx_fcond = Gx_fcond .AND. S749OPrSLt = THISFORM.A749OPrSLt .AND. S763OprILi = THISFORM.A763OprILi .AND. S764OprIFa = THISFORM.A764OprIFa .AND. S765OprIFa = THISFORM.A765OprIFa
            Gx_fcond = Gx_fcond .AND. S766OprIAr = THISFORM.A766OprIAr
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT82S48 .Refresh()
               THISFORM. cCT82S48 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A745OPrFam = S745OPrFam
               THISFORM.A746OprFam = S746OprFam
               THISFORM.A747OprArt = S747OprArt
               THISFORM.A748OPrLot = S748OPrLot
               THISFORM.A749OPrSLt = S749OPrSLt
               THISFORM.A763OprILi = S763OprILi
               THISFORM.A764OprIFa = S764OprIFa
               THISFORM.A765OprIFa = S765OprIFa
               THISFORM.A766OprIAr = S766OprIAr
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT82S48 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT82S48 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S745OPrFam = THISFORM.A745OPrFam .AND. S746OprFam = THISFORM.A746OprFam .AND. S747OprArt = THISFORM.A747OprArt .AND. S748OPrLot = THISFORM.A748OPrLot
            Gx_fcond = Gx_fcond .AND. S749OPrSLt = THISFORM.A749OPrSLt .AND. S763OprILi = THISFORM.A763OprILi .AND. S764OprIFa = THISFORM.A764OprIFa .AND. S765OprIFa = THISFORM.A765OprIFa
            Gx_fcond = Gx_fcond .AND. S766OprIAr = THISFORM.A766OprIAr
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT82S48 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S745OPrFam = THISFORM.A745OPrFam .AND. S746OprFam = THISFORM.A746OprFam .AND. S747OprArt = THISFORM.A747OprArt .AND. S748OPrLot = THISFORM.A748OPrLot
               Gx_fcond = Gx_fcond .AND. S749OPrSLt = THISFORM.A749OPrSLt .AND. S763OprILi = THISFORM.A763OprILi .AND. S764OprIFa = THISFORM.A764OprIFa .AND. S765OprIFa = THISFORM.A765OprIFa
               Gx_fcond = Gx_fcond .AND. S766OprIAr = THISFORM.A766OprIAr
            ENDDO
            IF sf_err != 0
               THISFORM. cCT82S48 .AppendRow()
               THISFORM. cCT82S48 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A745OPrFam = S745OPrFam
               THISFORM.A746OprFam = S746OprFam
               THISFORM.A747OprArt = S747OprArt
               THISFORM.A748OPrLot = S748OPrLot
               THISFORM.A749OPrSLt = S749OPrSLt
               THISFORM.A763OprILi = S763OprILi
               THISFORM.A764OprIFa = S764OprIFa
               THISFORM.A765OprIFa = S765OprIFa
               THISFORM.A766OprIAr = S766OprIAr
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A745OPrFam = S745OPrFam
         THISFORM.A746OprFam = S746OprFam
         THISFORM.A747OprArt = S747OprArt
         THISFORM.A748OPrLot = S748OPrLot
         THISFORM.A749OPrSLt = S749OPrSLt
         THISFORM.A763OprILi = S763OprILi
         THISFORM.A764OprIFa = S764OprIFa
         THISFORM.A765OprIFa = S765OprIFa
         THISFORM.A766OprIAr = S766OprIAr
         RETURN .F.
      ENDFUNC
