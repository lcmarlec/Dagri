      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T008220" , @HStmt_T008220 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOPRINS","T008220","",GX_CURSOR_TYPE_READONLY,@HStmt_T008220) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [OPrFamCod], [OprFamSubC], [OprArtCod], [OPrLot], [OPrSLt], [OprILin], "
                  cmdbuf = cmdbuf + "  [OprIFamCod] AS OprIFamCod, [OprIFamSub] AS OprIFamSub, [OprIArtCod] AS OprIArtCod, "
                  cmdbuf = cmdbuf + "  [OprIArtCtr], [OprIFor1As], [OprIFor1Ct], [OprIFor1PT], [OpriLugCod], [OprIFor1Pr], "
                  cmdbuf = cmdbuf + "  [OprILotNro], [OprICnt], [OprIForSN] FROM [OPRINS] (NOLOCK) WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [OPrFamCod] = ? AND [OprFamSubC] = ? AND [OprArtCod] = ? AND [OPrLot] = ? AND [OPrSLt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [OPrFamCod], [OprFamSubC], [OprArtCod], [OPrLot], [OPrSLt], "
                  cmdbuf = cmdbuf + "  [OprILin], [OprIFamCod], [OprIFamSub], [OprIArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T008220,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T008220,9)
                  THISFORM.GX_DB_BindColsT008220_01 ()
                  THISFORM.GX_DB_BindParmT008220_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T008220,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA745OPrFam = THISFORM.A745OPrFam
               Gx_err = GX_DB_SetInt( HStmt_T008220,2,@AuxA745OPrFam,0)
               THISFORM.A745OPrFam = AuxA745OPrFam
               AuxA746OprFam = THISFORM.A746OprFam
               Gx_err = GX_DB_SetInt( HStmt_T008220,3,@AuxA746OprFam,0)
               THISFORM.A746OprFam = AuxA746OprFam
               AuxA747OprArt = THISFORM.A747OprArt
               Gx_err = GX_DB_SetInt( HStmt_T008220,4,@AuxA747OprArt,0)
               THISFORM.A747OprArt = AuxA747OprArt
               AuxA748OPrLot = THISFORM.A748OPrLot
               Gx_err = GX_DB_SetDate( HStmt_T008220,5,@AuxA748OPrLot,0)
               THISFORM.A748OPrLot = AuxA748OPrLot
               AuxA749OPrSLt = THISFORM.A749OPrSLt
               Gx_err = GX_DB_SetInt( HStmt_T008220,6,@AuxA749OPrSLt,0)
               THISFORM.A749OPrSLt = AuxA749OPrSLt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T008220) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T008220 = Gx_err
               THISFORM.GX_DB_GetT008220_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T008220 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T008220) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T008220 = Gx_err
                  THISFORM.GX_DB_GetT008220_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T008220 <> 101
               BRK2A85 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT82S48.Columns(4).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T008220) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T008220 = Gx_err
               THISFORM.GX_DB_GetT008220_01 ()
            ENDDO
         ENDIF
