            CASE THISFORM.GX_Curr_Level = 86
               THISFORM. cCT82S63 .GX_LastKey = 9
               THISFORM. cCT82S63 .Columns( THISFORM.cCT82S63.ToSetFocusEnabled(THISFORM.cCT82S63.ColumnCount+1, 1) ).SetFocus()
               RETURN
            CASE THISFORM.GX_Curr_Level = 85
               THISFORM. cCT82S48 .GX_LastKey = 9
               THISFORM. cCT82S48 .Columns( THISFORM.cCT82S48.ToSetFocusEnabled(THISFORM.cCT82S48.ColumnCount+1, 1) ).SetFocus()
               RETURN
         ENDCASE
         gx_val_ret = THISFORM.validobj2( THISFORM.GX_lastvld, THIS.GxObjOrder , THIS.GxObjOrder)
         IF gx_val_ret >= 0
            THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .F., .F., .F.)
            RETURN
         ELSE
            IF gx_val_ret = -2
               RETURN
