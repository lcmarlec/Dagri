                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [OPrFamCod] = ? AND [OprFamSubC] = ? AND [OprArtCod] "
                  cmdbuf = cmdbuf + "  = ? AND [OPrLot] = ? AND [OPrSLt] = ? ORDER BY [EmpCod], [OPrFamCod], [OprFamSubC], "
                  cmdbuf = cmdbuf + "  [OprArtCod], [OPrLot], [OPrSLt], [OprFLin], [OprFFamCod], [OprFFamSub], [OprFArtCod] "
                  cmdbuf = cmdbuf + "   "
