      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCT82S48 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 85
            IF THIS.gx_ret > 0
               gx_val_ret = THIS.gx_ret
            ELSE
               gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            ENDIF
            IF gx_val_ret >= 0
               IF THIS.GX_Mouse
                  THIS.GotMouseDown()
               ENDIF
               NODEFAULT
               IF gx_val_ret >= 0
                  IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                     THISFORM.ReleaseAll()
                  ENDIF
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
            IF THISFORM.GX_NewLastVld != -1
               THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
               THISFORM.GX_NewLastVld = -1
               NODEFAULT
               RETURN
            ENDIF
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 85 )
               RETURN
            ENDIF
            THISFORM. cCT82S48 .SaveKey()
         ENDIF
         gx_a_trn = .F.
         THISFORM. cCT82S48 .GX_focusInGrid = .T.
         IF THISFORM.GX_Mode != "INS"
            THISFORM. cCT82S48 . AfterRowColChange1()
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 85
            THISFORM.SetLevel( 85 )
            THISFORM.SetMode("", "N" )
            THISFORM. cCT82S48.Columns(1).Ctrl1 .InitLevel( 85 )
            THISFORM.GX_last_fld_lvl = 85
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A766OprIAr"
         THISFORM.cCT82S48 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCT82S48 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCT82S48 .GX_lastkey = 9.or. THISFORM.cCT82S48 .GX_lastkey = 13)
            IF ! THISFORM.cCT82S48 .GridValidObj( THISFORM.cCT82S48 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCT82S48 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         gxO_Area = SELECT()
         SELECT(gxO_Area)
         IF THISFORM.GX_Load_key
         ELSE
            THISFORM.GX_Load_key = .T.
            THISFORM.cCT82S48 .SetInLvl(.T.)
            THISFORM.cCT82S48 .GX_rec_modif = .T.
         ENDIF
         THISFORM. cCT82S48 .gx_can_changerow = .T.
