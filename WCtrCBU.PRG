                  cmdbuf = cmdbuf + "  [TraNom], [TraCod], [EmpCod] FROM [EMPLEADO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND ([TraCbuOk] + 10 <> 11) AND ([TraFEgr] = convert( DATETIME, '17530101', "
                  cmdbuf = cmdbuf + "  112 )) AND ([EECod] < 10) ORDER BY [EmpCod], [TraCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11052,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11052,13)
                  THISFORM.GX_DB_BindColsW11052_01 ()
                  THISFORM.GX_DB_BindParmW11052_01 ()
               ENDIF
               AuxAV5Emprcod = THISFORM.AV5Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11052,1,@AuxAV5Emprcod,0)
               THISFORM.AV5Emprcod = AuxAV5Emprcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11052 = Gx_err
               THISFORM.GX_DB_GetW11052_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11052 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11052) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11052 = Gx_err
                  THISFORM.GX_DB_GetW11052_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11052 <> 101
               BRKVUP2 = .F.
               THISFORM.A2291TraFE = THISFORM.Buf_W11052_2291TraFEgr
               THISFORM.A2280EECod = THISFORM.Buf_W11052_2280EECod
               THISFORM.A2542TraCt = THISFORM.Buf_W11052_2542TraCtBd
               THISFORM.A2541TraCt = THISFORM.Buf_W11052_2541TraCtBc
               THISFORM.A3263TraCb = THISFORM.Buf_W11052_3263TraCbuOk
               THISFORM.A2812TraCB = THISFORM.Buf_W11052_2812TraCBU
               THISFORM.A2312TraFV = THISFORM.Buf_W11052_2312TraFVL
               THISFORM.A564TraNom = THISFORM.Buf_W11052_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W11052_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W11052_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U14VUP2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11052 = Gx_err
               THISFORM.GX_DB_GetW11052_01 ()
            ENDDO
         ENDIF
      ENDPROC
