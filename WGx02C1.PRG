      PROCEDURE CreateTemp
         LOCAL SCW266S20
         SCW266S20 = ""
         IF USED( "SCW266S20" )
            SELECT SCW266S20
            SCW266S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW266S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA745OPrFa"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA746OprFa"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA747OprAr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA748OPrLo"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA749OPrSL"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA754OprHo"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW266S20 = GETE('z:\temp') + '\' + SCW266S20
            ENDIF
            CREATE DBF (SCW266S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW266S20) EXCLUSIVE ALIAS SCW266S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW266S20
         THIS.GX_SfAlias = "SCW266S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02662" , @HStmt_W02662 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02C1","W02662","",GX_CURSOR_TYPE_READONLY,@HStmt_W02662) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [OPrCnt], [OprHorFin], [OPrSLt], [OPrLot], [OprArtCod], [OprFamSubC], "
                  cmdbuf = cmdbuf + "  [OPrFamCod] FROM [OPROD] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [OPrFamCod] "
                  cmdbuf = cmdbuf + "  >= ? and [OprFamSubC] >= ? and [OprArtCod] >= ? and [OPrLot] >= ? and [OPrSLt] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([OPrCnt] >= ?) ORDER BY [EmpCod], [OPrFamCod], [OprFamSubC], [OprArtCod], "
                  cmdbuf = cmdbuf + "  [OPrLot], [OPrSLt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02662,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02662,9)
                  THISFORM.GX_DB_BindColsW02662_01 ()
                  THISFORM.GX_DB_BindParmW02662_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02662,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C745 = THISFORM.AV5C745
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02662,2,@AuxAV5C745,0)
               THISFORM.AV5C745 = AuxAV5C745
               AuxAV6C746 = THISFORM.AV6C746
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02662,3,@AuxAV6C746,0)
               THISFORM.AV6C746 = AuxAV6C746
               AuxAV7C747 = THISFORM.AV7C747
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02662,4,@AuxAV7C747,0)
               THISFORM.AV7C747 = AuxAV7C747
               AuxAV8C748 = THISFORM.AV8C748
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02662,5,@AuxAV8C748,0)
               THISFORM.AV8C748 = AuxAV8C748
               AuxAV9C749 = THISFORM.AV9C749
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02662,6,@AuxAV9C749,0)
               THISFORM.AV9C749 = AuxAV9C749
               AuxAV10C751 = THISFORM.AV10C751
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02662,7,@AuxAV10C751,0)
               THISFORM.AV10C751 = AuxAV10C751
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02662 = Gx_err
               THISFORM.GX_DB_GetW02662_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02662 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02662) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02662 = Gx_err
                  THISFORM.GX_DB_GetW02662_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02662 <> 101
               BRKV7E2 = .F.
               THISFORM.A751OPrCnt = THISFORM.Buf_W02662_751OPrCnt
               THISFORM.A754OprHor = THISFORM.Buf_W02662_754OprHorFin
               THISFORM.A749OPrSLt = THISFORM.Buf_W02662_749OPrSLt
               THISFORM.A748OPrLot = THISFORM.Buf_W02662_748OPrLot
               THISFORM.A747OprArt = THISFORM.Buf_W02662_747OprArtCod
               THISFORM.A746OprFam = THISFORM.Buf_W02662_746OprFamSubC
               THISFORM.A745OPrFam = THISFORM.Buf_W02662_745OPrFamCod
               GX_SFLOAD = 0
               THISFORM.U12V7E2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02662 = Gx_err
               THISFORM.GX_DB_GetW02662_01 ()
            ENDDO
         ENDIF
      ENDPROC
