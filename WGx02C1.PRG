         THISFORM. cCW266S20 . AfterRowColChange()
         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW266A2 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A745OPrFam"
         THISFORM.cCW266S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW266S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW266S20 .GX_lastkey = 9.or. THISFORM.cCW266S20 .GX_lastkey = 13)
            IF ! THISFORM.cCW266S20 .GridValidObj( THISFORM.cCW266S20 .ColumnCount + 1)
               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW266S20 .GridValidObj(THIS.GXColumnNo)
