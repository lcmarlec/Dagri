               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03272) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03272 = Gx_err
            THISFORM.GX_DB_GetT03272_01 ()
            IF .NOT. THISFORM.T03272 <> 103
               DO GX_ERRMW WITH "TIPOSPER reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03272 = 101 .OR. THISFORM.Z3098PerTi <> THISFORM.Buf_T03272_3098PerTipDes
               DO GX_ERRMW WITH "TIPOSPER fue modificada."
