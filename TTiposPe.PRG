               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03276" , @HStmt_T03276 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTIPOSPE","T03276","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03276) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [TIPOSPER] SET [PerTipDes]=?  WHERE [PerTipId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03276,cmdbuf)
                  THISFORM.GX_DB_BindParmT03276_01 ()
               ENDIF
               AuxA3098PerTi = THISFORM.A3098PerTi
               Gx_err = GX_DB_SetStr( HStmt_T03276,1,AuxA3098PerTi,50,0)
               THISFORM.A3098PerTi = AuxA3098PerTi
               AuxA3097PerTi = THISFORM.A3097PerTi
               Gx_err = GX_DB_SetStr( HStmt_T03276,2,AuxA3097PerTi,3,0)
               THISFORM.A3097PerTi = AuxA3097PerTi
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03276) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03276 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03276) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03277" , @HStmt_T03277 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTIPOSPE","T03277","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03277) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [TIPOSPER]  WHERE [PerTipId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03277,cmdbuf)
                  THISFORM.GX_DB_BindParmT03277_01 ()
               ENDIF
               AuxA3097PerTi = THISFORM.A3097PerTi
               Gx_err = GX_DB_SetStr( HStmt_T03277,1,AuxA3097PerTi,3,0)
               THISFORM.A3097PerTi = AuxA3097PerTi
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03277) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03277 = Gx_err
               THISFORM.T03272 = iif( THISFORM.T03277 = 0 , 104 , THISFORM.T03277 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03277) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = THISFORM.A3097PerTi
         ENDIF
         IF EMPTY( THISFORM.A3097PerTi ) .AND. .T.
            DO GX_ERRMW WITH "El Código del tipo de pericia no puede estar vacío"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV21Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "AUSEN" , Aux1 , "TipPer" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV21Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT327V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 359 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.U13932 ()
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
