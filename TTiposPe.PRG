                  THISFORM. cCT327A3097 . ZM93359 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC93359 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03278" , @HStmt_T03278 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTIPOSPE","T03278","",GX_CURSOR_TYPE_READONLY,@HStmt_T03278) ,  ,  ,  , CS_SQLSRV , 0 )
