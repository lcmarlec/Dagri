                  THISFORM.GX_DB_BindParmT03278_01 ()
               ENDIF
               AuxBuf_T03273_3097PerTipId = THISFORM.Buf_T03273_3097PerTipId
               Gx_err = GX_DB_SetStr( HStmt_T03278,1,AuxBuf_T03273_3097PerTipId,LEN(AuxBuf_T03273_3097PerTipId),0)
               THISFORM.Buf_T03273_3097PerTipId = AuxBuf_T03273_3097PerTipId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03278) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03278 = Gx_err
               THISFORM.GX_DB_GetT03278_01 ()
               IF THISFORM.T03278 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03278) , "TTIPOSPE" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " Pericias "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03278) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT327A3097 . ZM93359 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC93359 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT327A3098 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE93359 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC93359 ()
                  RETURN
               ENDIF
               THISFORM.cCT327A3097.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03273) , "TTIPOSPE" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03272) , "TTIPOSPE" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT327A3098 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT327A3097 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
