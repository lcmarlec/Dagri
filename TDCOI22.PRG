      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011028" , @HStmt_T011028 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCOI22","T011028","",GX_CURSOR_TYPE_READONLY,@HStmt_T011028) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin], [TdcCnt], [TdcTotLiA], [TdcObsLin], "
                  cmdbuf = cmdbuf + "  [TdcPrc] FROM [TDCOM2] (NOLOCK) WHERE [EmpCod] = ? AND [TdcNroInt] = ? AND [TdcRORNroI] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011028,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011028,8)
                  THISFORM.GX_DB_BindColsT011028_01 ()
                  THISFORM.GX_DB_BindParmT011028_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011028,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA380TdcNro = THISFORM.A380TdcNro
               Gx_err = GX_DB_SetDouble( HStmt_T011028,2,@AuxA380TdcNro,0)
               THISFORM.A380TdcNro = AuxA380TdcNro
               AuxA406TdcROR = THISFORM.A406TdcROR
               Gx_err = GX_DB_SetDouble( HStmt_T011028,3,@AuxA406TdcROR,0)
               THISFORM.A406TdcROR = AuxA406TdcROR
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011028) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011028 = Gx_err
               THISFORM.GX_DB_GetT011028_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011028 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011028) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011028 = Gx_err
                  THISFORM.GX_DB_GetT011028_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011028 <> 101
               BRK3241 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT110Tb30.cCT110Pg41Tb30.cCT110S42.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T011028_406TdcRORNroI = THISFORM.A406TdcROR .AND. THISFORM.Buf_T011028_380TdcNroInt = THISFORM.A380TdcNro .AND. THISFORM.Buf_T011028_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011028) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011028 = Gx_err
               THISFORM.GX_DB_GetT011028_01 ()
            ENDDO
         ENDIF
      ENDPROC
