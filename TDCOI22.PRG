      PROCEDURE CreateTemp
         LOCAL SCT110S42
         SCT110S42 = ""
         IF USED( "SCT110S42" )
            SELECT SCT110S42
            SCT110S42 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT110S42
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA408TdcRO"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA409TdcOb"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA411TdcPr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 15
            GX_STRUCT[ 3 ,4]= 4

            GX_STRUCT[ 4 ,1]= "sA410TdcCn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 4

            GX_STRUCT[ 5 ,1]= "sA412TdcTo"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT110S42 = GETE('z:\temp') + '\' + SCT110S42
            ENDIF
            CREATE DBF (SCT110S42) FROM ARRAY GX_STRUCT
            USE
            USE (SCT110S42) EXCLUSIVE ALIAS SCT110S42
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT110S42
         THIS.GX_SfAlias = "SCT110S42"
      ENDPROC
