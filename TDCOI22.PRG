            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A412TdcTot"
         THISFORM.cCT110Tb30.cCT110Pg41Tb30.cCT110S42 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCT110Tb30.cCT110Pg41Tb30.cCT110S42 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCT110Tb30.cCT110Pg41Tb30.cCT110S42 .GX_lastkey = 9.or. THISFORM.cCT110Tb30.cCT110Pg41Tb30.cCT110S42 .GX_lastkey = 13)
