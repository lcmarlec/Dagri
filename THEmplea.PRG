                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02529) , "THEMPLEA" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT252A2453 .AfterTrn()
                  DO CASE
                     CASE THISFORM.GX_Mode = "INS"
                     CASE THISFORM.GX_Mode = "UPD"
                        THISFORM.ReleaseAll()
                     CASE THISFORM.GX_Mode = "DLT"
                        THISFORM.ReleaseAll()
                  ENDCASE
                  IF THISFORM.GX_Exit_GotFocus
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
                  THISFORM. cCT252Tb14 .GXOldPage = 1
                  THISFORM. cCT252Tb14 .ActivePage = 1
                  gx_a_trn = .T.
               ENDIF
