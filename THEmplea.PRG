      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025220" , @HStmt_T025220 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"THEMPLEA","T025220","",GX_CURSOR_TYPE_READONLY,@HStmt_T025220) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TraCod], [HTraFch], [HTraFtip], [HtraFTD], [HTraFNDoc], [HTraFNom], "
                  cmdbuf = cmdbuf + "  [HTraFFNa], [HTraFEC], [HTrafObs] FROM [HEMPLEA1] (NOLOCK) WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [TraCod] = ? AND [HTraFch] = ? ORDER BY [EmpCod], [TraCod], [HTraFch], [HTraFtip], "
                  cmdbuf = cmdbuf + "  [HtraFTD], [HTraFNDoc]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T025220,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T025220,12)
                  THISFORM.GX_DB_BindColsT025220_01 ()
                  THISFORM.GX_DB_BindParmT025220_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T025220,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               Gx_err = GX_DB_SetLong( HStmt_T025220,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               AuxA2452HTraF = THISFORM.A2452HTraF
               Gx_err = GX_DB_SetDateTime( HStmt_T025220,3,@AuxA2452HTraF,0)
               THISFORM.A2452HTraF = AuxA2452HTraF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T025220) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025220 = Gx_err
               THISFORM.GX_DB_GetT025220_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T025220 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025220) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T025220 = Gx_err
                  THISFORM.GX_DB_GetT025220_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T025220 <> 101
               BRK70325 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT252Tb14.cCT252Pg136Tb14.cCT252S137.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025220) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025220 = Gx_err
               THISFORM.GX_DB_GetT025220_01 ()
            ENDDO
         ENDIF
      ENDPROC
