            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
