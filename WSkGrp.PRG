            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA612GruNi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA609GruTi"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW150S16 = GETE('z:\temp') + '\' + SCW150S16
            ENDIF
            CREATE DBF (SCW150S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW150S16) EXCLUSIVE ALIAS SCW150S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW150S16
