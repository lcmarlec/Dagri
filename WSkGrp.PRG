      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01502" , @HStmt_W01502 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKGRP","W01502","",GX_CURSOR_TYPE_READONLY,@HStmt_W01502) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [GruTip], [EmpCod], [GruNim], [GruDsc], [GruCod] FROM [GRUPO] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([GruTip] = ?) AND ([EmpCod] = ?) AND ([GruDsc] like ?) ORDER BY [GruTip], "
                  cmdbuf = cmdbuf + "  [GruDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01502,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01502,15)
                  THISFORM.GX_DB_BindColsW01502_01 ()
                  THISFORM.GX_DB_BindParmW01502_01 ()
               ENDIF
               AuxA609GruTip = THISFORM.A609GruTip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01502,1,AuxA609GruTip,2,0)
               THISFORM.A609GruTip = AuxA609GruTip
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01502,2,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01502,3,PADR( TRIM(THISFORM.AV11Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV11Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01502 = Gx_err
               THISFORM.GX_DB_GetW01502_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV16Pgmnam = "WSkGrp"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01502 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01502) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01502 = Gx_err
                  THISFORM.GX_DB_GetW01502_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01502 <> 101
               BRKV462 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W01502_2EmpCod
               THISFORM.A612GruNim = THISFORM.Buf_W01502_612GruNim
               THISFORM.A611GruDsc = THISFORM.Buf_W01502_611GruDsc
               THISFORM.A610GruCod = THISFORM.Buf_W01502_610GruCod
               GX_SFLOAD = 0
               THISFORM.U15V462 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01502 = Gx_err
               THISFORM.GX_DB_GetW01502_01 ()
            ENDDO
         ENDIF
      ENDPROC
