               RETURN
            ENDIF
         ELSE
            IF ! THISFORM.cCW150S16 .GridValidObj(THIS.GXColumnNo)
               RETURN
            ENDIF
         ENDIF
         THISFORM.GX_Load_key=.T.
         THISFORM. cCW150S16 .gx_can_changerow = .T.
         CGXTextBoxSf ::GotFocus
         THISFORM.LockScreen = .F.
      ENDPROC
