      PROCEDURE CreateTemp
         LOCAL SCW1262S20
         SCW1262S20 = ""
         IF USED( "SCW1262S20" )
            SELECT SCW1262S20
            SCW1262S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1262S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3705UbiI"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 9
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3706UbiP"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3707UbiE"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3708UbiN"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3709Ubiu"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 20
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3710UbiF"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 21
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1262S20 = GETE('z:\temp') + '\' + SCW1262S20
            ENDIF
            CREATE DBF (SCW1262S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1262S20) EXCLUSIVE ALIAS SCW1262S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1262S20
         THIS.GX_SfAlias = "SCW1262S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12622" , @HStmt_W12622 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0BN2","W12622","",GX_CURSOR_TYPE_READONLY,@HStmt_W12622) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AlmId], [AlmSecId], [UbiFchIns], [UbiusuIns], [UbiNiv], [UbiEst], [UbiPas], "
                  cmdbuf = cmdbuf + "  [UbiId] FROM [AlmacenSectorUbicacion] (FASTFIRSTROW NOLOCK) WHERE ([AlmId] = ? and "
                  cmdbuf = cmdbuf + "  [AlmSecId] = ? and [UbiId] >= ?) AND ([UbiPas] >= ?) AND ([UbiEst] >= ?) AND ([UbiNiv] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([UbiusuIns] like ?) ORDER BY [AlmId], [AlmSecId], [UbiId]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12622,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12622,9)
                  THISFORM.GX_DB_BindColsW12622_01 ()
                  THISFORM.GX_DB_BindParmW12622_01 ()
               ENDIF
               AuxA3693Almac = THISFORM.A3693Almac
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12622,1,@AuxA3693Almac,0)
               THISFORM.A3693Almac = AuxA3693Almac
               AuxA3699AlmSe = THISFORM.A3699AlmSe
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12622,2,@AuxA3699AlmSe,0)
               THISFORM.A3699AlmSe = AuxA3699AlmSe
               AuxAV5C3705 = THISFORM.AV5C3705
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12622,3,@AuxAV5C3705,0)
               THISFORM.AV5C3705 = AuxAV5C3705
               AuxAV6C3706 = THISFORM.AV6C3706
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12622,4,@AuxAV6C3706,0)
               THISFORM.AV6C3706 = AuxAV6C3706
               AuxAV7C3707 = THISFORM.AV7C3707
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12622,5,@AuxAV7C3707,0)
               THISFORM.AV7C3707 = AuxAV7C3707
               AuxAV8C3708 = THISFORM.AV8C3708
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12622,6,@AuxAV8C3708,0)
               THISFORM.AV8C3708 = AuxAV8C3708
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12622,7,PADR( TRIM(THISFORM.AV9C3709),20, '%'),LEN(PADR( TRIM(THISFORM.AV9C3709),20, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12622 = Gx_err
               THISFORM.GX_DB_GetW12622_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12622 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12622) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12622 = Gx_err
                  THISFORM.GX_DB_GetW12622_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12622 <> 101
               BRKVZ22 = .F.
               THISFORM.A3710UbiFc = THISFORM.Buf_W12622_3710UbiFchIns
               THISFORM.A3709Ubius = THISFORM.Buf_W12622_3709UbiusuIns
               THISFORM.A3708UbiNi = THISFORM.Buf_W12622_3708UbiNiv
               THISFORM.A3707UbiEs = THISFORM.Buf_W12622_3707UbiEst
               THISFORM.A3706UbiPa = THISFORM.Buf_W12622_3706UbiPas
               THISFORM.A3705UbiId = THISFORM.Buf_W12622_3705UbiId
               GX_SFLOAD = 0
               THISFORM.U12VZ22 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12622) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12622 = Gx_err
               THISFORM.GX_DB_GetW12622_01 ()
            ENDDO
         ENDIF
      ENDPROC
