      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00592" , @HStmt_W00592 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFACTU3","W00592","",GX_CURSOR_TYPE_READONLY,@HStmt_W00592) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RVtNroInt], T1.[EmpCod], T1.[RVtEntGruT] AS RVtEntGruT, T1.[RvtLE], T1.[RvtFac], "
                  cmdbuf = cmdbuf + "  T1.[RvtCtrl], T1.[RVtEst], T1.[RVtFch], T1.[RVtNro], T1.[RVtSuc], T3.[EntLgDom], "
                  cmdbuf = cmdbuf + "  T1.[RVtEntLgCo] AS RVtEntLgCo, T2.[EntRaz] AS RVtEntRaz, T1.[RVtEntCod] AS RVtEntCod "
                  cmdbuf = cmdbuf + "  FROM (([REMVTA] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[EntGruTip] = T1.[RVtEntGruT] AND T2.[EntCod] = T1.[RVtEntCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CLTES] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[RVtEntGruT] AND T3.[EntCod] = T1.[RVtEntCod] AND T3.[EntLgCod] = T1.[RVtEntLgCo]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[RVtEntCod] = ?) AND (T1.[RVtEst] = 1) AND (T1.[RVtFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[RVtFch] <= ?) AND (T1.[RVtEntGruT] = 'CL') AND (T1.[RVtEntLgCo] = "
                  cmdbuf = cmdbuf + "  ? or ? = 0) AND (T1.[RVtSuc] = 1) ORDER BY T1.[EmpCod], T1.[RVtEntCod], T1.[RVtEntLgCo], "
                  cmdbuf = cmdbuf + "  T1.[RVtFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00592,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00592,14)
                  THISFORM.GX_DB_BindColsW00592_01 ()
                  THISFORM.GX_DB_BindParmW00592_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00592,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV15Entcod = THISFORM.AV15Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00592,2,@AuxAV15Entcod,0)
               THISFORM.AV15Entcod = AuxAV15Entcod
               AuxAV12Fecdes = THISFORM.AV12Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00592,3,@AuxAV12Fecdes,0)
               THISFORM.AV12Fecdes = AuxAV12Fecdes
               AuxAV13Fechas = THISFORM.AV13Fechas
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00592,4,@AuxAV13Fechas,0)
               THISFORM.AV13Fechas = AuxAV13Fechas
               AuxAV16Entlgc = THISFORM.AV16Entlgc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00592,5,@AuxAV16Entlgc,0)
               THISFORM.AV16Entlgc = AuxAV16Entlgc
               AuxAV16Entlgc = THISFORM.AV16Entlgc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00592,6,@AuxAV16Entlgc,0)
               THISFORM.AV16Entlgc = AuxAV16Entlgc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00592 = Gx_err
               THISFORM.GX_DB_GetW00592_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WFactu3"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00592 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00592) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00592 = Gx_err
                  THISFORM.GX_DB_GetW00592_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00592 <> 101
               BRKV1N2 = .F.
               THISFORM.AV30F = SPACE(2)
               THISFORM.AV11Sel = 0
               THISFORM.A908RVtNro = THISFORM.Buf_W00592_908RVtNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W00592_2EmpCod
