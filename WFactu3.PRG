      ***********************
      PROCEDURE U12V1N2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'ACTUALIZAR'" )
         * 'Actualizar' Routine
         IF THISFORM.AV16Entlgc > 0
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.AV7Emprcod
            Aux1 = THISFORM.AV5Fechasi
            Aux2 = THISFORM.AV23Suc
            DO WSelSuc WITH Aux0 , Aux1 , Aux2
            THISFORM.AV7Emprcod = Aux0
            THISFORM.AV5Fechasi = Aux1
            THISFORM.AV23Suc = Aux2
            THISFORM. cCW59S31 .RestoreGridPos()
            GX_rploop = .T.
            THISFORM.AV34GXLvl1 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00593" , @HStmt_W00593 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFACTU3","W00593","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00593) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [NumCod], [NumSuc] FROM [NUMERA] (NOLOCK) WHERE [EmpCod] = ? and "
               cmdbuf = cmdbuf + "  [NumCod] = 'FVA' and [NumSuc] = ? ORDER BY [EmpCod]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00593,cmdbuf)
               THISFORM.GX_DB_BindColsW00593_01 ()
               THISFORM.GX_DB_BindParmW00593_01 ()
            ENDIF
            AuxA2EmpCod = THISFORM.A2EmpCod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00593,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxAV23Suc = THISFORM.AV23Suc
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00593,2,@AuxAV23Suc,0)
            THISFORM.AV23Suc = AuxAV23Suc
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00593) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W00593 = Gx_err
            THISFORM.GX_DB_GetW00593_01 ()
            DO WHILE THISFORM.W00593 <> 101
               THISFORM.A677NumCod = THISFORM.Buf_W00593_677NumCod
               THISFORM.A679NumSuc = THISFORM.Buf_W00593_679NumSuc
               THISFORM.AV34GXLvl1 = 1
               THISFORM.AV14Ok = "S"
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00593) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV34GXLvl1 = 0
               THISFORM.AV14Ok = "N"
            ENDIF
            IF THISFORM.AV14Ok = "N"
               THISFORM.SaveTblPos()
               DO Werrores WITH "Sucursal Inválida !!! " , "R"
               THISFORM. cCW59S31 .RestoreGridPos()
               GX_rploop = .T.
            ELSE
               THISFORM.AV20I = 0
               LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
               GX_SFERR = 0
               Gx_fel_sel = .T.
               gxO_Rec = 0
               SELECT( THISFORM.cCW59S31 .GX_SfAlias)
               gxO_Rec1 = IIF(EOF(), 0, RECNO())
               THISFORM.cCW59S31.SF (8, @GX_SFERR)
               DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
                  THISFORM.cCW59S31.SF (3, @GX_SFERR)
                  THISFORM.cCW59S31 .SaveGridPos()
                  IF THISFORM.AV11Sel = 1
                     THISFORM.AV20I = THISFORM.AV20I + 1
                     IF THISFORM.AV20I < 10
                        THISFORM.AV19Rvtni[THISFORM.AV20I] = THISFORM.A908RVtNro
                     ELSE
                        IF THISFORM.AV20I = 10
                           DO GX_ERRMW WITH "Solo se Puede Seleccionar hasta 9 remitos"
                        ENDIF
                     ENDIF
                  ENDIF
                  IF Gx_fel_sel
                     THISFORM.cCW59S31 .RestoreGridPos()
                     THISFORM.cCW59S31.SF (4, @GX_SFERR)
                     THISFORM.cCW59S31.SF (9, @GX_SFERR)
                  ENDIF
               ENDDO
               THISFORM.cCW59S31 .ResetSavedGridPos()
               SELECT( THISFORM.cCW59S31 .GX_SfAlias)
               IF gxO_Rec1 != 0
                  GOTO (gxO_Rec1)
                  THISFORM.cCW59S31.SF (3, @GX_SFERR)
               ENDIF
               IF THISFORM.AV20I > 0
                  IF THISFORM.AV20I > 9
                     THISFORM.AV20I = 9
                  ENDIF
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV7Emprcod
                  Aux2 = THISFORM.AV23Suc
                  DIMENSION Aux3[99]
                  =ACOPY( THISFORM.AV19Rvtni , Aux3 )
                  Aux4 = THISFORM.AV20I
                  Aux5 = THISFORM.AV5Fechasi
                  Aux6 = THISFORM.AV10Usuari
                  DO PFcRVFnc WITH Aux0 , 1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6
                  THISFORM.AV7Emprcod = Aux0
                  THISFORM.AV23Suc = Aux2
                  =ACOPY( Aux3 , THISFORM.AV19Rvtni )
                  THISFORM.AV20I = Aux4
                  THISFORM.AV5Fechasi = Aux5
                  THISFORM.AV10Usuari = Aux6
                  THISFORM. cCW59S31 .RestoreGridPos()
                  GX_rploop = .T.
               ENDIF
            ENDIF
            THISFORM.GX_Refresh = 1   &&& Refresh
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

