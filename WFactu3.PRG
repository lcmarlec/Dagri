               THISFORM.A915RVtFch = THISFORM.Buf_W00592_915RVtFch
               THISFORM.A914RVtNro = THISFORM.Buf_W00592_914RVtNro
               THISFORM.A913RVtSuc = THISFORM.Buf_W00592_913RVtSuc
               THISFORM.A178EntLgD = THISFORM.Buf_W00592_178EntLgDom
               THISFORM.A912RVtEnt = THISFORM.Buf_W00592_912RVtEntLgCo
               THISFORM.A911RVtEnt = THISFORM.Buf_W00592_911RVtEntRaz
               THISFORM.A910RVtEnt = THISFORM.Buf_W00592_910RVtEntCod
               THISFORM.A911RVtEnt = THISFORM.Buf_W00592_911RVtEntRaz
               THISFORM.A178EntLgD = THISFORM.Buf_W00592_178EntLgDom
               GX_SFLOAD = 0
               THISFORM.U21V1N2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00592 = Gx_err
               THISFORM.GX_DB_GetW00592_01 ()
            ENDDO
         ENDIF
