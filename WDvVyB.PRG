      ***********************
      PROCEDURE U24VHV2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         DO CASE
            CASE THISFORM.A466DcVEst = 1 .AND. THISFORM.A470DcVTot <> 0
               THISFORM.AV11Estado = "Pendiente "
            CASE THISFORM.A466DcVEst = 2 .OR. ( THISFORM.A466DcVEst = 1 .AND. THISFORM.A470DcVTot = 0 )
               THISFORM.AV11Estado = "Cancelado "
            CASE THISFORM.A466DcVEst = 9
               THISFORM.AV11Estado = "Anulado "
         ENDCASE
         THISFORM.AV32Rcvnro = 0
         THISFORM.AV33Rcvfch = CTOD("  /  /  ")
         IF THISFORM.A1208DcvTi = "RC"
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06433" , @HStmt_W06433 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVVYB","W06433","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W06433) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [RCVNroI], [RcVUsu], [RCVNroCli], [RcvFchCli] FROM [RECIBOS] (NOLOCK) "
               cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [RCVNroI] = ? ORDER BY [EmpCod], [RCVNroI]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06433,cmdbuf)
               THISFORM.GX_DB_BindColsW06433_01 ()
               THISFORM.GX_DB_BindParmW06433_01 ()
            ENDIF
            AuxA2EmpCod = THISFORM.A2EmpCod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06433,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA415DcVNro = THISFORM.A415DcVNro
            THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06433,2,@AuxA415DcVNro,0)
            THISFORM.A415DcVNro = AuxA415DcVNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06433) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W06433 = Gx_err
            THISFORM.GX_DB_GetW06433_01 ()
            DO WHILE THISFORM.W06433 <> 101
               THISFORM.A858RCVNro = THISFORM.Buf_W06433_858RCVNroI
               THISFORM.A1735RcVUs = THISFORM.Buf_W06433_1735RcVUsu
               THISFORM.A1198RCVNr = THISFORM.Buf_W06433_1198RCVNroCli
               THISFORM.A1213RcvFc = THISFORM.Buf_W06433_1213RcvFchCli
               THISFORM.AV32Rcvnro = THISFORM.A1198RCVNr
               THISFORM.AV33Rcvfch = THISFORM.A1213RcvFc
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W06433) ,  ,  ,  , CS_SQLSRV ,  )
         ENDIF
         IF THISFORM.cCW643S12 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW643S12 .GX_rec_loaded =  THISFORM.cCW643S12 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW643S12 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW643S12 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

