      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08372" , @HStmt_W08372 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSELENVI","W08372","",GX_CURSOR_TYPE_READONLY,@HStmt_W08372) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EnvClt], [EmpCod], [EnvEst], [EnvObs], [EnvFch] FROM [ENVIOS] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [EnvClt] = ?) AND ([EnvEst] = ? or ? = 0) ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [EnvClt], [EnvFch] DESC  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08372,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08372,12)
                  THISFORM.GX_DB_BindColsW08372_01 ()
                  THISFORM.GX_DB_BindParmW08372_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08372,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV22Envclt = THISFORM.AV22Envclt
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08372,2,@AuxAV22Envclt,0)
               THISFORM.AV22Envclt = AuxAV22Envclt
               AuxAV24Envest = THISFORM.AV24Envest
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08372,3,@AuxAV24Envest,0)
               THISFORM.AV24Envest = AuxAV24Envest
               AuxAV24Envest = THISFORM.AV24Envest
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08372,4,@AuxAV24Envest,0)
               THISFORM.AV24Envest = AuxAV24Envest
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08372 = Gx_err
               THISFORM.GX_DB_GetW08372_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08372 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08372) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08372 = Gx_err
                  THISFORM.GX_DB_GetW08372_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08372 <> 101
               BRKVN92 = .F.
               THISFORM.A2581EnvCl = THISFORM.Buf_W08372_2581EnvClt
               THISFORM.A2EmpCod = THISFORM.Buf_W08372_2EmpCod
               THISFORM.A2583EnvEs = THISFORM.Buf_W08372_2583EnvEst
               THISFORM.A2584EnvOb = THISFORM.Buf_W08372_2584EnvObs
               THISFORM.A2582EnvFc = THISFORM.Buf_W08372_2582EnvFch
               GX_SFLOAD = 0
               THISFORM.U14VN92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08372 = Gx_err
               THISFORM.GX_DB_GetW08372_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         THISFORM.A2581EnvCl = THISFORM.Buf_W08372_2581EnvClt
         THISFORM.A2EmpCod = THISFORM.Buf_W08372_2EmpCod
         THISFORM.A2583EnvEs = THISFORM.Buf_W08372_2583EnvEst
         THISFORM.A2584EnvOb = THISFORM.Buf_W08372_2584EnvObs
