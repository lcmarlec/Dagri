      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW837S16 .GX_SfAlias)
            GO TOP
            THISFORM.cCW837S16 .Refresh()
         ENDIF
         THISFORM. cCW837S16 .GXSetRepos( .F. )
