      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA2582EnvF WITH THISFORM.A2582EnvFc
         REPLACE sA2584EnvO WITH THISFORM.A2584EnvOb
         REPLACE sA2583EnvE WITH THISFORM.cCW837S16.Columns(3).Ctrl1.ValToText(THISFORM.A2583EnvEs)
         REPLACE sA2EmpCod WITH THISFORM.A2EmpCod
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A2582EnvFc = sA2582EnvF
         THISFORM.A2584EnvOb = sA2584EnvO
         THISFORM.A2583EnvEs = THISFORM.cCW837S16.Columns(3).Ctrl1.TextToVal(sA2583EnvE,"int",1)
         THISFORM.A2EmpCod = sA2EmpCod
      ENDPROC
