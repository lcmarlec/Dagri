      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02736" , @HStmt_T02736 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TREIPER","T02736","",GX_CURSOR_TYPE_READONLY,@HStmt_T02736) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [ReIRoI], [ReINroI], [ReiPer] AS ReiPer, [ReiPerObs] FROM [REINCID3] "
            cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE [EmpCod] >= ? and [ReIRoI] >= ? and [ReINroI] >= ? and "
            cmdbuf = cmdbuf + "  [ReiPer] >= ? ORDER BY [EmpCod], [ReIRoI], [ReINroI], [ReiPer]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02736,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02736,100)
            THISFORM.GX_DB_BindColsT02736_01 ()
            THISFORM.GX_DB_BindParmT02736_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2EmpCod = 0
                  THISFORM.A2617ReIRo = SPACE(1)
                  THISFORM.A2616ReINr = 0
                  THISFORM.A2647ReiPe = 0
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
