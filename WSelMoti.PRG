      PROCEDURE CreateTemp
         LOCAL SCW859S10
         SCW859S10 = ""
         IF USED( "SCW859S10" )
            SELECT SCW859S10
            SCW859S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW859S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "VAV28Cauco"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2267CAuD"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 50
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV26Sel"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2266CAuC"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW859S10 = GETE('z:\temp') + '\' + SCW859S10
            ENDIF
            CREATE DBF (SCW859S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCW859S10) EXCLUSIVE ALIAS SCW859S10
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW859S10
         THIS.GX_SfAlias = "SCW859S10"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08592" , @HStmt_W08592 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSELMOTI","W08592","",GX_CURSOR_TYPE_READONLY,@HStmt_W08592) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CAuDsc], [CAuCod] FROM [CAUSENTI] (NOLOCK) WHERE ([EmpCod] = ?) "
                  cmdbuf = cmdbuf + "  AND ([CAuDsc] like ?) ORDER BY [EmpCod], [CAuCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08592,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08592,14)
                  THISFORM.GX_DB_BindColsW08592_01 ()
                  THISFORM.GX_DB_BindParmW08592_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08592,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08592,2,PADR( TRIM(THISFORM.AV22Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV22Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08592 = Gx_err
               THISFORM.GX_DB_GetW08592_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV31Pgmnam = "WSelMoti"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08592 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08592) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08592 = Gx_err
                  THISFORM.GX_DB_GetW08592_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08592 <> 101
               BRKVNV2 = .F.
               THISFORM.AV26Sel = 0
               THISFORM.A2EmpCod = THISFORM.Buf_W08592_2EmpCod
               THISFORM.A2267CAuDs = THISFORM.Buf_W08592_2267CAuDsc
               THISFORM.A2266CAuCo = THISFORM.Buf_W08592_2266CAuCod
               GX_SFLOAD = 0
               THISFORM.U15VNV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08592) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08592 = Gx_err
               THISFORM.GX_DB_GetW08592_01 ()
            ENDDO
         ENDIF
      ENDPROC
