               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03822,2,@AuxA1238tExNr,0)
               THISFORM.A1238tExNr = AuxA1238tExNr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03822,3,PADR( TRIM(THISFORM.AV5C1249),12, '%'),LEN(PADR( TRIM(THISFORM.AV5C1249),12, '%')),0)
               AuxAV6C1251 = THISFORM.AV6C1251
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03822,4,@AuxAV6C1251,0)
               THISFORM.AV6C1251 = AuxAV6C1251
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03822 = Gx_err
               THISFORM.GX_DB_GetW03822_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03822 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03822) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03822 = Gx_err
                  THISFORM.GX_DB_GetW03822_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03822 <> 101
               BRKVAM2 = .F.
               THISFORM.A1251tExCt = THISFORM.Buf_W03822_1251tExCtaImp
               THISFORM.A1249tExCt = THISFORM.Buf_W03822_1249tExCtaCod
               GX_SFLOAD = 0
               THISFORM.U12VAM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03822 = Gx_err
               THISFORM.GX_DB_GetW03822_01 ()
            ENDDO
         ENDIF
      ENDPROC
