      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06292" , @HStmt_W06292 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAJA","W06292","",GX_CURSOR_TYPE_READONLY,@HStmt_W06292) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CajMot], [CajObs], [CajNI], [CajSNI], [EmpCod], [CajNro], [CajUsu], [CajSdo], "
                  cmdbuf = cmdbuf + "  [CajImp], [CajIoE], [CajHor], [CajFch] FROM [CAJA] (NOLOCK) WHERE ([EmpCod] = ? "
                  cmdbuf = cmdbuf + "  and [CajFch] <= ?) AND ([CajIoE] = ? or ? = 'T') AND ([CajUsu] = ? or ? = ' ') AND "
                  cmdbuf = cmdbuf + "  ([CajFch] >= ?) ORDER BY [EmpCod], [CajFch] DESC, [CajHor] DESC  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06292,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06292,13)
                  THISFORM.GX_DB_BindColsW06292_01 ()
                  THISFORM.GX_DB_BindParmW06292_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06292,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Fecha = THISFORM.AV21Fecha
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06292,2,@AuxAV21Fecha,0)
               THISFORM.AV21Fecha = AuxAV21Fecha
               AuxAV23Cajioe = THISFORM.AV23Cajioe
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06292,3,AuxAV23Cajioe,1,0)
               THISFORM.AV23Cajioe = AuxAV23Cajioe
               AuxAV23Cajioe = THISFORM.AV23Cajioe
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06292,4,AuxAV23Cajioe,1,0)
               THISFORM.AV23Cajioe = AuxAV23Cajioe
               AuxAV22Cajusu = THISFORM.AV22Cajusu
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06292,5,AuxAV22Cajusu,10,0)
               THISFORM.AV22Cajusu = AuxAV22Cajusu
               AuxAV22Cajusu = THISFORM.AV22Cajusu
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06292,6,AuxAV22Cajusu,10,0)
               THISFORM.AV22Cajusu = AuxAV22Cajusu
               AuxAV24Fechad = THISFORM.AV24Fechad
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06292,7,@AuxAV24Fechad,0)
               THISFORM.AV24Fechad = AuxAV24Fechad
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06292 = Gx_err
               THISFORM.GX_DB_GetW06292_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WCaja"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06292 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06292) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06292 = Gx_err
                  THISFORM.GX_DB_GetW06292_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06292 <> 101
               BRKVHH2 = .F.
               THISFORM.A1901CajMo = THISFORM.Buf_W06292_1901CajMot
               THISFORM.A1902CajOb = THISFORM.Buf_W06292_1902CajObs
               THISFORM.A1897CajNI = THISFORM.Buf_W06292_1897CajNI
               THISFORM.A1898CajSN = THISFORM.Buf_W06292_1898CajSNI
               THISFORM.A2EmpCod = THISFORM.Buf_W06292_2EmpCod
               THISFORM.A1899CajNr = THISFORM.Buf_W06292_1899CajNro
               THISFORM.A1905CajUs = THISFORM.Buf_W06292_1905CajUsu
               THISFORM.A1915CajSd = THISFORM.Buf_W06292_1915CajSdo
               THISFORM.A1904CajIm = THISFORM.Buf_W06292_1904CajImp
               THISFORM.A1903CajIo = THISFORM.Buf_W06292_1903CajIoE
               THISFORM.A1906CajHo = THISFORM.Buf_W06292_1906CajHor
               THISFORM.A1896CajFc = THISFORM.Buf_W06292_1896CajFch
               GX_SFLOAD = 0
               THISFORM.U17VHH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06292) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06292 = Gx_err
               THISFORM.GX_DB_GetW06292_01 ()
            ENDDO
         ENDIF
