         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07372 <> 101
               BRKVKH2 = .F.
               THISFORM.A1852EntLg = THISFORM.Buf_W07372_1852EntLgGrpNo
               THISFORM.A1845EntLg = THISFORM.Buf_W07372_1845EntLgGrpOf
               THISFORM.A120EntCod = THISFORM.Buf_W07372_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W07372_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W07372_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VKH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07372 = Gx_err
               THISFORM.GX_DB_GetW07372_01 ()
            ENDDO
         ENDIF
      ENDPROC
