      PROCEDURE CreateTemp
         LOCAL SCW49S10
         SCW49S10 = ""
         IF USED( "SCW49S10" )
            SELECT SCW49S10
            SCW49S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW49S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA199CtaNr"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA200CtaDe"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW49S10 = GETE('z:\temp') + '\' + SCW49S10
            ENDIF
            CREATE DBF (SCW49S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCW49S10) EXCLUSIVE ALIAS SCW49S10
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW49S10
         THIS.GX_SfAlias = "SCW49S10"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00492" , @HStmt_W00492 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WELECTA","W00492","",GX_CURSOR_TYPE_READONLY,@HStmt_W00492) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PCtaNro], T2.[PCtaDes], T1.[CtaDes], T1.[CtaNro] FROM ([CTA00] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [PCTA] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[PCtaNro] = T1.[PCtaNro]) WHERE (T1.[PCtaNro] = ?) AND (T1.[CtaNro] >= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[PCtaNro], T1.[CtaNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00492,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00492,12)
                  THISFORM.GX_DB_BindColsW00492_01 ()
                  THISFORM.GX_DB_BindParmW00492_01 ()
               ENDIF
               AuxA198PCtaNr = THISFORM.A198PCtaNr
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00492,1,@AuxA198PCtaNr,0)
               THISFORM.A198PCtaNr = AuxA198PCtaNr
               AuxAV20Ctanro = THISFORM.AV20Ctanro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00492,2,AuxAV20Ctanro,12,0)
               THISFORM.AV20Ctanro = AuxAV20Ctanro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00492 = Gx_err
               THISFORM.GX_DB_GetW00492_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WEleCta"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00492 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00492) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00492 = Gx_err
                  THISFORM.GX_DB_GetW00492_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00492 <> 101
               BRKV1D2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W00492_2EmpCod
               THISFORM.A210PCtaDe = THISFORM.Buf_W00492_210PCtaDes
               THISFORM.A200CtaDes = THISFORM.Buf_W00492_200CtaDes
               THISFORM.A199CtaNro = THISFORM.Buf_W00492_199CtaNro
               THISFORM.A210PCtaDe = THISFORM.Buf_W00492_210PCtaDes
               GX_SFLOAD = 0
               THISFORM.U15V1D2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00492 = Gx_err
               THISFORM.GX_DB_GetW00492_01 ()
            ENDDO
         ENDIF
      ENDPROC
