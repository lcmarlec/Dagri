      PROCEDURE CreateTemp
         LOCAL SCW444S10
         SCW444S10 = ""
         IF USED( "SCW444S10" )
            SELECT SCW444S10
            SCW444S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW444S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA1368AsiT"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1369AsiT"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW444S10 = GETE('z:\temp') + '\' + SCW444S10
            ENDIF
            CREATE DBF (SCW444S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCW444S10) EXCLUSIVE ALIAS SCW444S10
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW444S10
         THIS.GX_SfAlias = "SCW444S10"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04442" , @HStmt_W04442 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WASITPO","W04442","",GX_CURSOR_TYPE_READONLY,@HStmt_W04442) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EjeNro], [AsiTDes], [AsiTCod] FROM [ASITPO] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [EjeNro] = ? ORDER BY [EmpCod], [EjeNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04442,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04442,11)
                  THISFORM.GX_DB_BindColsW04442_01 ()
                  THISFORM.GX_DB_BindParmW04442_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04442,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA548EjeNro = THISFORM.A548EjeNro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04442,2,@AuxA548EjeNro,0)
               THISFORM.A548EjeNro = AuxA548EjeNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04442 = Gx_err
               THISFORM.GX_DB_GetW04442_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WAsitpo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04442 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04442) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04442 = Gx_err
                  THISFORM.GX_DB_GetW04442_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04442 <> 101
               BRKVCC2 = .F.
               THISFORM.A1369AsiTD = THISFORM.Buf_W04442_1369AsiTDes
               THISFORM.A1368AsiTC = THISFORM.Buf_W04442_1368AsiTCod
               GX_SFLOAD = 0
               THISFORM.U18VCC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04442 = Gx_err
               THISFORM.GX_DB_GetW04442_01 ()
            ENDDO
         ENDIF
      ENDPROC
