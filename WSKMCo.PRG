      PROCEDURE CreateTemp
         LOCAL SCW153S16
         SCW153S16 = ""
         IF USED( "SCW153S16" )
            SELECT SCW153S16
            SCW153S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW153S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA619MCoCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA620MCoDs"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA622McoBc"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW153S16 = GETE('z:\temp') + '\' + SCW153S16
            ENDIF
            CREATE DBF (SCW153S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW153S16) EXCLUSIVE ALIAS SCW153S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW153S16
         THIS.GX_SfAlias = "SCW153S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01532" , @HStmt_W01532 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKMCO","W01532","",GX_CURSOR_TYPE_READONLY,@HStmt_W01532) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[McoCtaCta] AS McoCtaCta, T1.[McoVta], T1.[McoCom], T2.[BcoCod] AS McoBcoCod, "
                  cmdbuf = cmdbuf + "  T1.[MCoDsc], T1.[MCoCod] FROM ([MEDCOB] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CTAS] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[BcoCta] = T1.[McoCtaCta]) WHERE (T1.[MCoDsc] like ?) AND (( T1.[McoCom] "
                  cmdbuf = cmdbuf + "  = 'S' and ? = 'C') or ( T1.[McoVta] = 'S' and ? = 'V') or ? = 'T') ORDER BY T1.[MCoDsc] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01532,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01532,14)
                  THISFORM.GX_DB_BindColsW01532_01 ()
                  THISFORM.GX_DB_BindParmW01532_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01532,1,PADR( TRIM(THISFORM.AV12Desde),30, '%'),LEN(PADR( TRIM(THISFORM.AV12Desde),30, '%')),0)
               AuxAV14Que = THISFORM.AV14Que
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01532,2,AuxAV14Que,1,0)
               THISFORM.AV14Que = AuxAV14Que
               AuxAV14Que = THISFORM.AV14Que
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01532,3,AuxAV14Que,1,0)
               THISFORM.AV14Que = AuxAV14Que
               AuxAV14Que = THISFORM.AV14Que
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01532,4,AuxAV14Que,1,0)
               THISFORM.AV14Que = AuxAV14Que
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01532 = Gx_err
               THISFORM.GX_DB_GetW01532_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV18Pgmnam = "WSKMCo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01532 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01532) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01532 = Gx_err
                  THISFORM.GX_DB_GetW01532_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01532 <> 101
               BRKV492 = .F.
               THISFORM.A625McoCta = THISFORM.Buf_W01532_625McoCtaCta
               THISFORM.A1210McoVt = THISFORM.Buf_W01532_1210McoVta
               THISFORM.A1209McoCo = THISFORM.Buf_W01532_1209McoCom
               THISFORM.A622McoBco = THISFORM.Buf_W01532_622McoBcoCod
               THISFORM.A620MCoDsc = THISFORM.Buf_W01532_620MCoDsc
               THISFORM.A619MCoCod = THISFORM.Buf_W01532_619MCoCod
               THISFORM.A622McoBco = THISFORM.Buf_W01532_622McoBcoCod
               GX_SFLOAD = 0
               THISFORM.U14V492 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01532 = Gx_err
               THISFORM.GX_DB_GetW01532_01 ()
            ENDDO
         ENDIF
      ENDPROC
