               AuxAV10C3103 = THISFORM.AV10C3103
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12222,6,@AuxAV10C3103,0)
               THISFORM.AV10C3103 = AuxAV10C3103
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12222,7,PADR( TRIM(THISFORM.AV11C3105),3, '%'),LEN(PADR( TRIM(THISFORM.AV11C3105),3, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12222) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12222 = Gx_err
               THISFORM.GX_DB_GetW12222_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12222 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12222) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12222 = Gx_err
                  THISFORM.GX_DB_GetW12222_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12222 <> 101
               BRKVXY2 = .F.
               THISFORM.A3101PerPt = THISFORM.Buf_W12222_3101PerPtoNom
               THISFORM.A3103PerFc = THISFORM.Buf_W12222_3103PerFch
               THISFORM.A3105PerEs = THISFORM.Buf_W12222_3105PerEst
               THISFORM.A3102PerPt = THISFORM.Buf_W12222_3102PerPtoTel
               THISFORM.A561TraCod = THISFORM.Buf_W12222_561TraCod
               THISFORM.A3099PerID = THISFORM.Buf_W12222_3099PerID
               THISFORM.A2EmpCod = THISFORM.Buf_W12222_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VXY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12222) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12222 = Gx_err
               THISFORM.GX_DB_GetW12222_01 ()
            ENDDO
         ENDIF
      ENDPROC
