      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02082,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA2035HCamP = THISFORM.A2035HCamP
            Gx_err = GX_DB_SetStr( HStmt_T02082,2,AuxA2035HCamP,8,0)
            THISFORM.A2035HCamP = AuxA2035HCamP
            AuxA2036HCamF = THISFORM.A2036HCamF
            Gx_err = GX_DB_SetDateTime( HStmt_T02082,3,@AuxA2036HCamF,0)
            THISFORM.A2036HCamF = AuxA2036HCamF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02082) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02082 = Gx_err
            THISFORM.GX_DB_GetT02082_01 ()
            IF .NOT. THISFORM.T02082 <> 103
               DO GX_ERRMW WITH "CAMHIS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02082 = 101 .OR. THISFORM.Z2037HCamD <> THISFORM.Buf_T02082_2037HCamDsc
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2042HCamV <> THISFORM.Buf_T02082_2042HCamVde
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2048HCamA <> THISFORM.Buf_T02082_2048HCamAnio
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2053HCamC <> THISFORM.Buf_T02082_2053HCamCol
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2058HCamF <> THISFORM.Buf_T02082_2058HCamFacN
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2063HCamS <> THISFORM.Buf_T02082_2063HCamSegR
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2068HCamN <> THISFORM.Buf_T02082_2068HCamNro
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2773HCamP <> THISFORM.Buf_T02082_2773HCamPatRen
               DO GX_ERRMW WITH "CAMHIS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02086" , @HStmt_T02086 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMHIS","T02086","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02086) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CAMHIS] ([EmpCod], [HCamPat], [HCamFch], [HCamDsc], [HCamVTV], [HCamHab], "
                  cmdbuf = cmdbuf + "  [HCamSeg], [HCamTRu], [HCamVde], [HCamCarg], [HCamMun], [HCamObs], [HCamChfC], [HCamChfN], "
                  cmdbuf = cmdbuf + "  [HCamAnio], [HCamMar], [HCamMod], [HCamMotN], [HCamChaN], [HCamCol], [HCamSegC], "
                  cmdbuf = cmdbuf + "  [HCamSegF], [HCamSegE], [HCamFacS], [HCamFacN], [HCamFacF], [HCamFacP], [HCamVTVR], "
                  cmdbuf = cmdbuf + "  [HCamTRuR], [HCamSegR], [HCamHabR], [HCamVdeR], [HCamCarR], [HCamMunR], [HCamNro], "
                  cmdbuf = cmdbuf + "  [HCamUsu], [HCamHabCab], [HCamHabCR], [HCamPatVto], [HCamPatRen]) VALUES (?, ?, "
                  cmdbuf = cmdbuf + "  ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
                  cmdbuf = cmdbuf + "  ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02086,cmdbuf)
                  THISFORM.GX_DB_BindParmT02086_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02086,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
