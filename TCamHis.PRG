               THISFORM.A2036HCamF = AuxA2036HCamF
               AuxA2037HCamD = THISFORM.A2037HCamD
               Gx_err = GX_DB_SetStr( HStmt_T02086,4,AuxA2037HCamD,30,0)
               THISFORM.A2037HCamD = AuxA2037HCamD
               AuxA2038HCamV = THISFORM.A2038HCamV
               Gx_err = GX_DB_SetDate( HStmt_T02086,5,@AuxA2038HCamV,0)
