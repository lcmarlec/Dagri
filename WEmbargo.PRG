      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12132" , @HStmt_W12132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMBARGO","W12132","",GX_CURSOR_TYPE_READONLY,@HStmt_W12132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[EbgNroInt], T1.[EbgEst], T1.[EbgSld], T1.[EbgImp], T1.[EbgPorc], "
                  cmdbuf = cmdbuf + "  T1.[EbgMot], T1.[EbgExp], T1.[EbgFch], T2.[TraNom], T1.[TraCod] FROM ([EMBARGO] "
                  cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [EMPLEADO] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TraCod] "
                  cmdbuf = cmdbuf + "  = T1.[TraCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[TraCod] = ? or ? = 0) AND (UPPER(T2.[TraNom]) "
                  cmdbuf = cmdbuf + "  like UPPER(?)) AND (? = 0 or T1.[EbgEst] = ?) ORDER BY T1.[EmpCod], T1.[EbgNroInt] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12132,13)
                  THISFORM.GX_DB_BindColsW12132_01 ()
                  THISFORM.GX_DB_BindParmW12132_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12132,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12132,2,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12132,3,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12132,4,PADR( TRIM(THISFORM.AV21Tranom),40, '%'),LEN(PADR( TRIM(THISFORM.AV21Tranom),40, '%')),0)
               AuxAV33Que = THISFORM.AV33Que
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12132,5,@AuxAV33Que,0)
               THISFORM.AV33Que = AuxAV33Que
               AuxAV33Que = THISFORM.AV33Que
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12132,6,@AuxAV33Que,0)
               THISFORM.AV33Que = AuxAV33Que
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12132 = Gx_err
               THISFORM.GX_DB_GetW12132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV42Pgmnam = "WEmbargo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12132 = Gx_err
                  THISFORM.GX_DB_GetW12132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12132 <> 101
               BRKVXP2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W12132_2EmpCod
               THISFORM.A3514EbgNr = THISFORM.Buf_W12132_3514EbgNroInt
               THISFORM.A3521EbgEs = THISFORM.Buf_W12132_3521EbgEst
               THISFORM.A3524EbgSl = THISFORM.Buf_W12132_3524EbgSld
               THISFORM.A3517EbgIm = THISFORM.Buf_W12132_3517EbgImp
               THISFORM.A3518EbgPo = THISFORM.Buf_W12132_3518EbgPorc
               THISFORM.A3522EbgMo = THISFORM.Buf_W12132_3522EbgMot
               THISFORM.A3515EbgEx = THISFORM.Buf_W12132_3515EbgExp
               THISFORM.A3516EbgFc = THISFORM.Buf_W12132_3516EbgFch
               THISFORM.A564TraNom = THISFORM.Buf_W12132_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W12132_561TraCod
               THISFORM.A564TraNom = THISFORM.Buf_W12132_564TraNom
               GX_SFLOAD = 0
               THISFORM.U19VXP2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12132 = Gx_err
               THISFORM.GX_DB_GetW12132_01 ()
            ENDDO
         ENDIF
      ENDPROC
