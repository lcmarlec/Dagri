      PROCEDURE CreateTemp
         LOCAL SCW194S20
         SCW194S20 = ""
         IF USED( "SCW194S20" )
            SELECT SCW194S20
            SCW194S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW194S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA150EntGr"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA120EntCo"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA151EntGr"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA157EntPa"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA163EntPo"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW194S20 = GETE('z:\temp') + '\' + SCW194S20
            ENDIF
            CREATE DBF (SCW194S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW194S20) EXCLUSIVE ALIAS SCW194S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW194S20
         THIS.GX_SfAlias = "SCW194S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01942" , @HStmt_W01942 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00F1","W01942","",GX_CURSOR_TYPE_READONLY,@HStmt_W01942) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntRaz], [EntFan], [EntCont], [EntPos], [EntPaiCod], [EntGruCod], "
                  cmdbuf = cmdbuf + "  [EntCod], [EntGruTip] FROM [ENTID] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND "
                  cmdbuf = cmdbuf + "  ([EntGruTip] like ?) AND ([EntCod] >= ?) AND ([EntGruCod] like ?) AND ([EntRaz] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EntFan] like ?) AND ([EntCont] like ?) ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01942,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01942,9)
                  THISFORM.GX_DB_BindColsW01942_01 ()
                  THISFORM.GX_DB_BindParmW01942_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01942,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01942,2,PADR( TRIM(THISFORM.AV5C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV5C150),2, '%')),0)
               AuxAV6C120 = THISFORM.AV6C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01942,3,@AuxAV6C120,0)
               THISFORM.AV6C120 = AuxAV6C120
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01942,4,PADR( TRIM(THISFORM.AV7C151),3, '%'),LEN(PADR( TRIM(THISFORM.AV7C151),3, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01942,5,PADR( TRIM(THISFORM.AV8C153),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C153),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01942,6,PADR( TRIM(THISFORM.AV9C154),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C154),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01942,7,PADR( TRIM(THISFORM.AV10C155),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C155),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01942) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01942 = Gx_err
               THISFORM.GX_DB_GetW01942_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01942 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01942) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01942 = Gx_err
                  THISFORM.GX_DB_GetW01942_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01942 <> 101
               BRKV5E2 = .F.
               THISFORM.A153EntRaz = THISFORM.Buf_W01942_153EntRaz
               THISFORM.A154EntFan = THISFORM.Buf_W01942_154EntFan
               THISFORM.A155EntCon = THISFORM.Buf_W01942_155EntCont
               THISFORM.A163EntPos = THISFORM.Buf_W01942_163EntPos
               THISFORM.A157EntPai = THISFORM.Buf_W01942_157EntPaiCod
               THISFORM.A151EntGru = THISFORM.Buf_W01942_151EntGruCod
               THISFORM.A120EntCod = THISFORM.Buf_W01942_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W01942_150EntGruTip
               GX_SFLOAD = 0
               THISFORM.U12V5E2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01942) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01942 = Gx_err
               THISFORM.GX_DB_GetW01942_01 ()
            ENDDO
         ENDIF
      ENDPROC
