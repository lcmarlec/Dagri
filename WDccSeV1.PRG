                  cmdbuf = cmdbuf + "  T2.[DcCNro], T2.[DcCSuc], T2.[DcCTip], T2.[DcCFec], T3.[EntRaz], T2.[EntCod] FROM "
                  cmdbuf = cmdbuf + "  (([DCCOM4] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[DcCNroInt] = T1.[DcCNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T2.[EntGruTip] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T2.[EntCod]) WHERE T1.[EmpCod] = ? and T1.[DcCNroInt] = ? ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03532,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03532,10)
                  THISFORM.GX_DB_BindColsW03532_01 ()
                  THISFORM.GX_DB_BindParmW03532_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03532,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03532,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03532 = Gx_err
               THISFORM.GX_DB_GetW03532_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV17Pgmnam = "WDccSeV1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03532 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03532) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03532 = Gx_err
                  THISFORM.GX_DB_GetW03532_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03532 <> 101
               BRKV9T2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W03532_150EntGruTip
               THISFORM.A374DcCCta = THISFORM.Buf_W03532_374DcCCtaCte
               THISFORM.A1072dccCh = THISFORM.Buf_W03532_1072dccChImp
               THISFORM.A1071dccch = THISFORM.Buf_W03532_1071dccchObs
               THISFORM.A1070dccch = THISFORM.Buf_W03532_1070dccchNro
               THISFORM.A1069dccch = THISFORM.Buf_W03532_1069dccchCta
               THISFORM.A1068DcCch = THISFORM.Buf_W03532_1068DcCchTip
               THISFORM.A349DccSer = THISFORM.Buf_W03532_349DccSer
               THISFORM.A372DcCFV = THISFORM.Buf_W03532_372DcCFV
               THISFORM.A352DcCNro = THISFORM.Buf_W03532_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W03532_350DcCSuc
               THISFORM.A348DcCTip = THISFORM.Buf_W03532_348DcCTip
               THISFORM.A347DcCFec = THISFORM.Buf_W03532_347DcCFec
               THISFORM.A153EntRaz = THISFORM.Buf_W03532_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W03532_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W03532_150EntGruTip
               THISFORM.A374DcCCta = THISFORM.Buf_W03532_374DcCCtaCte
               THISFORM.A349DccSer = THISFORM.Buf_W03532_349DccSer
               THISFORM.A372DcCFV = THISFORM.Buf_W03532_372DcCFV
               THISFORM.A352DcCNro = THISFORM.Buf_W03532_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W03532_350DcCSuc
               THISFORM.A348DcCTip = THISFORM.Buf_W03532_348DcCTip
               THISFORM.A347DcCFec = THISFORM.Buf_W03532_347DcCFec
               THISFORM.A120EntCod = THISFORM.Buf_W03532_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W03532_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U13V9T2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03532 = Gx_err
               THISFORM.GX_DB_GetW03532_01 ()
            ENDDO
         ENDIF
      ENDPROC
