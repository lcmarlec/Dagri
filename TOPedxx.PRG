      PROCEDURE AfterAllLevels
      LPARAMETER gx_Lvl
         IF gx_Lvl = 82
            IF .not. THISFORM. cCT81A735 .AfterLevel()
               THISFORM. cCT81A2 .SetFocus()
               RETURN .F.
            ENDIF
         ENDIF
         IF gx_Lvl = 83
            IF .not. THISFORM. cCT81S16.Columns(14).Ctrl1 .AfterLevel()
               THISFORM. cCT81S16 .SetFocus()
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
