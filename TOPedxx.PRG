      PROCEDURE DoPrompt
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         IF THISFORM.GX_Curr_Level = 82 .and. THISFORM.Gx_cursor = "THISFORM.A2EmpCod"
            THISFORM.GX_Load_Key = .F.
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A2EmpCod
            DO WGx01H0 WITH Aux0
            THISFORM.A2EmpCod = Aux0
            THISFORM. cCT81A2 .Refresh()
            RETURN
         ENDIF
         IF THISFORM.GX_Curr_Level = 83 .and. THISFORM.Gx_cursor = "THISFORM.A740OpeCpr"
            THISFORM. cCT81S16.Columns(10).Ctrl1 .InteractiveChange()
            IF THISFORM. cCT81S16 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_Load_Key = .F.
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A2EmpCod
            Aux1 = THISFORM.A740OpeCpr
            Aux2 = THISFORM.A741OpeCpr
            DO WGx00F1 WITH Aux0 , Aux1 , Aux2
            THISFORM.A2EmpCod = Aux0
            THISFORM.A740OpeCpr = Aux1
            THISFORM.A741OpeCpr = Aux2
            THISFORM. cCT81A2 .Refresh()
            IF  THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A740OpeCpr"
               THISFORM. cCT81S16.Columns(10).Ctrl1 .RefreshSfAtt()
            ENDIF
            IF  THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A741OpeCpr"
               THISFORM. cCT81S16.Columns(11).Ctrl1 .RefreshSfAtt()
            ENDIF
            THISFORM. cCT81S16 .GX_rec_modif = .T.
            THISFORM. cCT81S16 .GX_LastVld1 = THISFORM. cCT81S16.Columns(10).Ctrl1 .GXColumnNo - 1
            RETURN
         ENDIF
         IF THISFORM.GX_Curr_Level = 83 .and. THISFORM.Gx_cursor = "THISFORM.A3FamCod"
            THISFORM. cCT81S16.Columns(2).Ctrl1 .InteractiveChange()
            IF THISFORM. cCT81S16 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_Load_Key = .F.
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A2EmpCod
            Aux1 = THISFORM.A3FamCod
            Aux2 = THISFORM.A4FamSubCo
            Aux3 = THISFORM.A5ArtCod
            DO WGx0021 WITH Aux0 , Aux1 , Aux2 , Aux3
            THISFORM.A2EmpCod = Aux0
            THISFORM.A3FamCod = Aux1
            THISFORM.A4FamSubCo = Aux2
            THISFORM.A5ArtCod = Aux3
            THISFORM. cCT81A2 .Refresh()
            IF  THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3FamCod"
               THISFORM. cCT81S16.Columns(2).Ctrl1 .RefreshSfAtt()
            ENDIF
            IF  THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A4FamSubCo"
               THISFORM. cCT81S16.Columns(3).Ctrl1 .RefreshSfAtt()
            ENDIF
            IF  THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A5ArtCod"
               THISFORM. cCT81S16.Columns(4).Ctrl1 .RefreshSfAtt()
