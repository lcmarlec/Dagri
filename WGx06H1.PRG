               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07052,4,@AuxAV7C2098,0)
               THISFORM.AV7C2098 = AuxAV7C2098
               AuxAV8C2099 = THISFORM.AV8C2099
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07052,5,@AuxAV8C2099,0)
               THISFORM.AV8C2099 = AuxAV8C2099
               AuxAV9C2100 = THISFORM.AV9C2100
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07052,6,@AuxAV9C2100,0)
               THISFORM.AV9C2100 = AuxAV9C2100
               AuxAV10C2243 = THISFORM.AV10C2243
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07052,7,@AuxAV10C2243,0)
               THISFORM.AV10C2243 = AuxAV10C2243
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07052 = Gx_err
               THISFORM.GX_DB_GetW07052_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07052 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07052) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07052 = Gx_err
                  THISFORM.GX_DB_GetW07052_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07052 <> 101
               BRKVJL2 = .F.
               THISFORM.A2099xPciC = THISFORM.Buf_W07052_2099xPciCoU
               THISFORM.A2100xPciC = THISFORM.Buf_W07052_2100xPciCo2
               THISFORM.A2243xPciI = THISFORM.Buf_W07052_2243xPciIbB
               THISFORM.A2098xPcID = THISFORM.Buf_W07052_2098xPcIDGI
               THISFORM.A2097xPciI = THISFORM.Buf_W07052_2097xPciIbr
               THISFORM.A2096xPciD = THISFORM.Buf_W07052_2096xPciDsc
               THISFORM.A2081xPciC = THISFORM.Buf_W07052_2081xPciCod
               GX_SFLOAD = 0
               THISFORM.U12VJL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07052 = Gx_err
               THISFORM.GX_DB_GetW07052_01 ()
            ENDDO
         ENDIF
      ENDPROC
