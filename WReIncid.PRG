               THISFORM.AV26Reiroi = AuxAV26Reiroi
               AuxAV21Desdef = THISFORM.AV21Desdef
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08642,3,@AuxAV21Desdef,0)
               THISFORM.AV21Desdef = AuxAV21Desdef
               AuxAV22Hastaf = THISFORM.AV22Hastaf
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08642,4,@AuxAV22Hastaf,0)
               THISFORM.AV22Hastaf = AuxAV22Hastaf
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08642,5,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08642,6,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08642 = Gx_err
               THISFORM.GX_DB_GetW08642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WReIncid"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08642 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08642) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08642 = Gx_err
                  THISFORM.GX_DB_GetW08642_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08642 <> 101
               BRKVO02 = .F.
               THISFORM.A2626TpICo = THISFORM.Buf_W08642_2626TpICod
               THISFORM.A2616ReINr = THISFORM.Buf_W08642_2616ReINroI
               THISFORM.A2617ReIRo = THISFORM.Buf_W08642_2617ReIRoI
               THISFORM.A2622ReiEs = THISFORM.Buf_W08642_2622ReiEst
               THISFORM.A2641TpIDs = THISFORM.Buf_W08642_2641TpIDsc
               THISFORM.A2637ReILu = THISFORM.Buf_W08642_2637ReILug
               THISFORM.A2639ReIFc = THISFORM.Buf_W08642_2639ReIFch
               THISFORM.A2640ReINr = THISFORM.Buf_W08642_2640ReINro
               THISFORM.A2EmpCod = THISFORM.Buf_W08642_2EmpCod
               THISFORM.A2641TpIDs = THISFORM.Buf_W08642_2641TpIDsc
               GX_SFLOAD = 0
               THISFORM.U18VO02 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08642 = Gx_err
               THISFORM.GX_DB_GetW08642_01 ()
            ENDDO
         ENDIF
      ENDPROC
