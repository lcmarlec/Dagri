            GX_STRUCT[ 7 ,1]= "sA2547SldT"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 15
            GX_STRUCT[ 7 ,4]= 2

            GX_STRUCT[ 8 ,1]= "sA76BcoCta"
