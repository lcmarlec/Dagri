      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12832" , @HStmt_W12832 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSLDAUS","W12832","",GX_CURSOR_TYPE_READONLY,@HStmt_W12832) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[SldEst], T1.[SldObs], T1.[SldTipo], T1.[SldSec], T1.[SldEPer], "
                  cmdbuf = cmdbuf + "  T2.[BcoCtaNro], T1.[Sldenvio], T1.[BcoCta] FROM ([SLDENVIO] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CTAS] T2 (NOLOCK) ON T2.[BcoCta] = T1.[BcoCta]) WHERE (T1.[EmpCod] = "
                  cmdbuf = cmdbuf + "  ?) AND (T1.[Sldenvio] >= ?) AND (T1.[BcoCta] = ?) AND (T1.[SldTipo] = ? or ? = 'T') "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[SldEPer] DESC, T1.[SldSec] DESC  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12832,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12832,12)
                  THISFORM.GX_DB_BindColsW12832_01 ()
                  THISFORM.GX_DB_BindParmW12832_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12832,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W12832,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               AuxAV28Bcocta = THISFORM.AV28Bcocta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12832,3,@AuxAV28Bcocta,0)
               THISFORM.AV28Bcocta = AuxAV28Bcocta
               AuxAV29Sldtip = THISFORM.AV29Sldtip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12832,4,AuxAV29Sldtip,1,0)
               THISFORM.AV29Sldtip = AuxAV29Sldtip
               AuxAV29Sldtip = THISFORM.AV29Sldtip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12832,5,AuxAV29Sldtip,1,0)
               THISFORM.AV29Sldtip = AuxAV29Sldtip
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12832) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12832 = Gx_err
               THISFORM.GX_DB_GetW12832_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV36Pgmnam = "WSldAus"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12832 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12832) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12832 = Gx_err
                  THISFORM.GX_DB_GetW12832_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12832 <> 101
               BRKVZN2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W12832_2EmpCod
               THISFORM.A2550SldEs = THISFORM.Buf_W12832_2550SldEst
               THISFORM.A2549SldOb = THISFORM.Buf_W12832_2549SldObs
               THISFORM.A3421SldTi = THISFORM.Buf_W12832_3421SldTipo
               THISFORM.A2544SldSe = THISFORM.Buf_W12832_2544SldSec
               THISFORM.A2543SldEP = THISFORM.Buf_W12832_2543SldEPer
               THISFORM.A77BcoCtaN = THISFORM.Buf_W12832_77BcoCtaNro
               THISFORM.A2548Slden = THISFORM.Buf_W12832_2548Sldenvio
               THISFORM.A76BcoCta = THISFORM.Buf_W12832_76BcoCta
               THISFORM.A77BcoCtaN = THISFORM.Buf_W12832_77BcoCtaNro
               X25470 = 0.00
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A76BcoCta
               Aux2 = THISFORM.A2543SldEP
               Aux3 = THISFORM.A2544SldSe
               DO RSldTota WITH Aux0 , Aux1 , Aux2 , Aux3 , X25470
               THISFORM.A2EmpCod = Aux0
               THISFORM.A76BcoCta = Aux1
               THISFORM.A2543SldEP = Aux2
               THISFORM.A2544SldSe = Aux3
               THISFORM. cCW1283S20 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.A2547SldTo = X25470
               GX_SFLOAD = 0
               THISFORM.U20VZN2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12832) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12832 = Gx_err
               THISFORM.GX_DB_GetW12832_01 ()
            ENDDO
         ENDIF
      ENDPROC
