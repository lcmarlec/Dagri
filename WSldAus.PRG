            GX_STRUCT[ 9 ,3]= 1
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1283S20 = GETE('z:\temp') + '\' + SCW1283S20
            ENDIF
