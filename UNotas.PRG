                  cmdbuf = " SELECT T1.[EmpCod], T1.[NotIUsu], T1.[NotIObs], T1.[NotItFch], T2.[NotObs], T1.[NotFch], "
                  cmdbuf = cmdbuf + "  T3.[NotTemDsc], T1.[NotTemCod] FROM (([NOTAS1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [NOTAS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[NotTemCod] = T1.[NotTemCod] "
                  cmdbuf = cmdbuf + "  AND T2.[NotFch] = T1.[NotFch]) LEFT JOIN [NOTTEM] T3 (NOLOCK) ON T3.[NotTemCod] "
                  cmdbuf = cmdbuf + "  = T1.[NotTemCod]) WHERE (T1.[NotTemCod] = ? or ? = 0) AND (T1.[NotFch] >= ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[NotIUsu] = ? or ? > 4) ORDER BY T1.[EmpCod], T1.[NotTemCod], T1.[NotFch], T1.[NotItFch] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08523,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08523,11)
                  THISFORM.GX_DB_BindColsW08523_01 ()
                  THISFORM.GX_DB_BindParmW08523_01 ()
               ENDIF
               AuxAV21Nottem = THISFORM.AV21Nottem
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08523,1,@AuxAV21Nottem,0)
               THISFORM.AV21Nottem = AuxAV21Nottem
               AuxAV21Nottem = THISFORM.AV21Nottem
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08523,2,@AuxAV21Nottem,0)
               THISFORM.AV21Nottem = AuxAV21Nottem
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W08523,3,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               AuxAV17Usuari = THISFORM.AV17Usuari
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08523,4,AuxAV17Usuari,10,0)
               THISFORM.AV17Usuari = AuxAV17Usuari
               AuxAV18Nivel = THISFORM.AV18Nivel
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08523,5,@AuxAV18Nivel,0)
               THISFORM.AV18Nivel = AuxAV18Nivel
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08523) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08523 = Gx_err
               THISFORM.GX_DB_GetW08523_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "UNotas"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08523 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08523) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08523 = Gx_err
                  THISFORM.GX_DB_GetW08523_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08523 <> 101
               BRKVNO2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W08523_2EmpCod
               THISFORM.A2609NotIU = THISFORM.Buf_W08523_2609NotIUsu
               THISFORM.A2608NotIO = Gx_lvchar_to_char( THISFORM.Buf_W08523_2608NotIObs )
               THISFORM.A2607NotIt = THISFORM.Buf_W08523_2607NotItFch
               THISFORM.A2606NotOb = THISFORM.Buf_W08523_2606NotObs
               THISFORM.A2605NotFc = THISFORM.Buf_W08523_2605NotFch
               THISFORM.A2604NotTe = THISFORM.Buf_W08523_2604NotTemDsc
               THISFORM.A2603NotTe = THISFORM.Buf_W08523_2603NotTemCod
               THISFORM.A2606NotOb = THISFORM.Buf_W08523_2606NotObs
               THISFORM.A2604NotTe = THISFORM.Buf_W08523_2604NotTemDsc
               GX_SFLOAD = 0
               THISFORM.cCW852S19.Load ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08523) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08523 = Gx_err
               THISFORM.GX_DB_GetW08523_01 ()
            ENDDO
         ENDIF
      ENDPROC
