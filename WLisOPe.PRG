         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00792) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00792 = Gx_err
         THISFORM.GX_DB_GetW00792_01 ()
         DO WHILE THISFORM.W00792 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W00792_2EmpCod
            THISFORM.A3FamCod = THISFORM.Buf_W00792_3FamCod
