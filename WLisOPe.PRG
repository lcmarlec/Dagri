            cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [FamCod] = ? and [FamSubCod] = ? and [ArtCod] = ? ORDER BY "
            cmdbuf = cmdbuf + "  [EmpCod], [FamCod], [FamSubCod], [ArtCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00792,cmdbuf)
            THISFORM.GX_DB_BindColsW00792_01 ()
            THISFORM.GX_DB_BindParmW00792_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00792,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV17Desfam = THISFORM.AV17Desfam
