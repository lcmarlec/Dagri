         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW79V19.ISVALID" )
         THISFORM.AV28GXLvl1 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00792" , @HStmt_W00792 )
