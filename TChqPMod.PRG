      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T01242,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA121ChqNro = THISFORM.A121ChqNro
            Gx_err = GX_DB_SetDouble( HStmt_T01242,2,@AuxA121ChqNro,0)
            THISFORM.A121ChqNro = AuxA121ChqNro
            AuxA122ChqLin = THISFORM.A122ChqLin
            Gx_err = GX_DB_SetInt( HStmt_T01242,3,@AuxA122ChqLin,0)
            THISFORM.A122ChqLin = AuxA122ChqLin
            AuxA123ChqTip = THISFORM.A123ChqTip
            Gx_err = GX_DB_SetStr( HStmt_T01242,4,AuxA123ChqTip,1,0)
            THISFORM.A123ChqTip = AuxA123ChqTip
            AuxA124ChqCta = THISFORM.A124ChqCta
            Gx_err = GX_DB_SetInt( HStmt_T01242,5,@AuxA124ChqCta,0)
            THISFORM.A124ChqCta = AuxA124ChqCta
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01242) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01242 = Gx_err
            THISFORM.GX_DB_GetT01242_01 ()
            IF .NOT. THISFORM.T01242 <> 103
               DO GX_ERRMW WITH "CHQS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01242 = 101 .OR. THISFORM.Z126ChqBco <> THISFORM.Buf_T01242_126ChqBcoCod
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1663ChqCr <> THISFORM.Buf_T01242_1663ChqCruz
               DO GX_ERRMW WITH "CHQS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01246" , @HStmt_T01246 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCHQPMOD","T01246","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01246) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CHQS] ([EmpCod], [ChqNroI], [ChqLin], [ChqTip], [ChqCta], [ChqBcoCod], "
                  cmdbuf = cmdbuf + "  [ChqNro], [ChqImp], [ChqFchDeb], [ChqEst], [ChqCruz], [ChqImpreso], [ChqFchIng], "
                  cmdbuf = cmdbuf + "  [ChqSuc], [ChqTit], [ChqCliGrT], [ChqCliCod], [ChqNroReg], [ChqPrvGrT], [ChqPrvCod], "
                  cmdbuf = cmdbuf + "  [ChqFchEgr], [ChqBcoDepC], [ChqBcoCta], [ChqNoO], [ChqMonCod], [ChqCotImp], [ChqFchCB], "
