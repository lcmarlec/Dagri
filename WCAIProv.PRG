               THIS.GX_CUPOS = 0
               THISFORM.AV37Pgmnam = "WCAIProv"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04472 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04472) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04472 = Gx_err
                  THISFORM.GX_DB_GetW04472_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04472 <> 101
               BRKVCF2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W04472_150EntGruTip
