               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04472,5,@AuxAV21Sucdde,0)
               THISFORM.AV21Sucdde = AuxAV21Sucdde
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04472,6,PADR( TRIM(THISFORM.AV29Comcai),15, '%'),LEN(PADR( TRIM(THISFORM.AV29Comcai),15, '%')),0)
               AuxAV30Comcai = THISFORM.AV30Comcai
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04472,7,@AuxAV30Comcai,0)
               THISFORM.AV30Comcai = AuxAV30Comcai
