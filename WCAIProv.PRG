                  cmdbuf = cmdbuf + "  FROM [CAIPROV] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EntGruTip] = ? and "
                  cmdbuf = cmdbuf + "  [EntCod] = ? and [ComCAITipD] = ?) AND ([ComCAISuc] >= ?) AND ([ComCAINro] like "
                  cmdbuf = cmdbuf + "  ?) AND ([ComCaiNroD] <= ? or ? = 0) AND ([ComCAINroH] >= ? or ? = 0) AND ([ComCAIFchH] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ComCAIVeri] = ? or ? = 9) ORDER BY [EmpCod], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [ComCAITipD], [ComCAISer], [ComCAISuc], [ComCaiNroD]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04472,cmdbuf)
