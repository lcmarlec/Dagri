      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T027915" , @HStmt_T027915 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLLAPER","T027915","",GX_CURSOR_TYPE_READONLY,@HStmt_T027915) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [LlaNroI], [LlaPerCon] AS LlaPerCon, [Llaperusu], [LLaPerFyH], [LlaPerObs] "
                  cmdbuf = cmdbuf + "  FROM [LLAPER] (NOLOCK) WHERE [EmpCod] = ? AND [LlaNroI] = ? ORDER BY [EmpCod], [LlaNroI], "
                  cmdbuf = cmdbuf + "  [LlaPerCon]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T027915,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T027915,8)
                  THISFORM.GX_DB_BindColsT027915_01 ()
                  THISFORM.GX_DB_BindParmT027915_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T027915,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1525LlaNr = THISFORM.A1525LlaNr
               Gx_err = GX_DB_SetDouble( HStmt_T027915,2,@AuxA1525LlaNr,0)
               THISFORM.A1525LlaNr = AuxA1525LlaNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T027915) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T027915 = Gx_err
               THISFORM.GX_DB_GetT027915_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T027915 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T027915) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T027915 = Gx_err
                  THISFORM.GX_DB_GetT027915_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T027915 <> 101
               BRK7R307 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT279S10.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T027915) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T027915 = Gx_err
               THISFORM.GX_DB_GetT027915_01 ()
            ENDDO
         ENDIF
      ENDPROC
