      PROCEDURE CreateTemp
         LOCAL SCT279S10
         SCT279S10 = ""
         IF USED( "SCT279S10" )
            SELECT SCT279S10
            SCT279S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT279S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2677LlaP"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2678LlaP"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2679LlaP"
            GX_STRUCT[ 3 ,2]= "M"
            GX_STRUCT[ 3 ,3]= 100
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2680Llap"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2681LLaP"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 16
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT279S10 = GETE('z:\temp') + '\' + SCT279S10
            ENDIF
            CREATE DBF (SCT279S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCT279S10) EXCLUSIVE ALIAS SCT279S10
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT279S10
         THIS.GX_SfAlias = "SCT279S10"
      ENDPROC
