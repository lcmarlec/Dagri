         THISFORM.A2677LlaPe = THISFORM.M2677LlaPe
         THISFORM. cCT279S10 .SaveTemp()
         THISFORM. cCT279S10 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT279S10 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT279S10 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT279S10 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S2677LlaPe = THISFORM.A2677LlaPe
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT279S10 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT279S10 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S2677LlaPe = THISFORM.A2677LlaPe
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT279S10 .Refresh()
               THISFORM. cCT279S10 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1525LlaNr = S1525LlaNr
               THISFORM.A2677LlaPe = S2677LlaPe
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT279S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT279S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S2677LlaPe = THISFORM.A2677LlaPe
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT279S10 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1525LlaNr = THISFORM.A1525LlaNr .AND. S2677LlaPe = THISFORM.A2677LlaPe
            ENDDO
            IF sf_err != 0
               THISFORM. cCT279S10 .AppendRow()
               THISFORM. cCT279S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1525LlaNr = S1525LlaNr
               THISFORM.A2677LlaPe = S2677LlaPe
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1525LlaNr = S1525LlaNr
         THISFORM.A2677LlaPe = S2677LlaPe
         RETURN .F.
