      PROCEDURE CreateTemp
         LOCAL SCW414S16
         SCW414S16 = ""
         IF USED( "SCW414S16" )
            SELECT SCW414S16
            SCW414S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW414S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1318CRIC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1319CRID"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1320CRIT"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW414S16 = GETE('z:\temp') + '\' + SCW414S16
            ENDIF
            CREATE DBF (SCW414S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW414S16) EXCLUSIVE ALIAS SCW414S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW414S16
         THIS.GX_SfAlias = "SCW414S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04142" , @HStmt_W04142 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0471","W04142","",GX_CURSOR_TYPE_READONLY,@HStmt_W04142) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CRIPidPal], [CRITiMo], [CRIDsc], [CRICod] FROM [CRINTERN] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [CRICod] >= ?) AND ([CRIDsc] like ?) AND ([CRITiMo] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CRIPidPal] >= ?) ORDER BY [EmpCod], [CRICod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04142,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04142,9)
                  THISFORM.GX_DB_BindColsW04142_01 ()
                  THISFORM.GX_DB_BindParmW04142_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04142,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C1318 = THISFORM.AV5C1318
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04142,2,@AuxAV5C1318,0)
               THISFORM.AV5C1318 = AuxAV5C1318
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04142,3,PADR( TRIM(THISFORM.AV6C1319),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C1319),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04142,4,PADR( TRIM(THISFORM.AV7C1320),1, '%'),LEN(PADR( TRIM(THISFORM.AV7C1320),1, '%')),0)
               AuxAV8C3428 = THISFORM.AV8C3428
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04142,5,@AuxAV8C3428,0)
               THISFORM.AV8C3428 = AuxAV8C3428
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04142 = Gx_err
               THISFORM.GX_DB_GetW04142_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04142 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04142) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04142 = Gx_err
                  THISFORM.GX_DB_GetW04142_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04142 <> 101
               BRKVBI2 = .F.
               THISFORM.A3428CRIPi = THISFORM.Buf_W04142_3428CRIPidPal
               THISFORM.A1320CRITi = THISFORM.Buf_W04142_1320CRITiMo
               THISFORM.A1319CRIDs = THISFORM.Buf_W04142_1319CRIDsc
               THISFORM.A1318CRICo = THISFORM.Buf_W04142_1318CRICod
               GX_SFLOAD = 0
               THISFORM.U12VBI2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04142 = Gx_err
               THISFORM.GX_DB_GetW04142_01 ()
            ENDDO
         ENDIF
      ENDPROC
