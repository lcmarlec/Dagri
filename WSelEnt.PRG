      ***********************
      PROCEDURE cCW140V11.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW140V11.ISVALID" )
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01402" , @HStmt_W01402 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSELENT","W01402","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W01402) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01402,cmdbuf)
            THISFORM.GX_DB_BindColsW01402_01 ()
            THISFORM.GX_DB_BindParmW01402_01 ()
         ENDIF
         AuxAV7Emprcod = THISFORM.AV7Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01402,1,@AuxAV7Emprcod,0)
         THISFORM.AV7Emprcod = AuxAV7Emprcod
         AuxAV12Tipo = THISFORM.AV12Tipo
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01402,2,AuxAV12Tipo,2,0)
         THISFORM.AV12Tipo = AuxAV12Tipo
         AuxAV11Entida = THISFORM.AV11Entida
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01402,3,@AuxAV11Entida,0)
         THISFORM.AV11Entida = AuxAV11Entida
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01402) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W01402 = Gx_err
         THISFORM.GX_DB_GetW01402_01 ()
         DO WHILE THISFORM.W01402 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W01402_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W01402_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W01402_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W01402_153EntRaz
            THISFORM.AV13Nombre = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W01402) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.cCW140B5.GXSetFocus( )
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
