            GX_STRUCT[ 7 ,1]= "sA194MonDs"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 20
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT144S32 = GETE('z:\temp') + '\' + SCT144S32
            ENDIF
            CREATE DBF (SCT144S32) FROM ARRAY GX_STRUCT
            USE
