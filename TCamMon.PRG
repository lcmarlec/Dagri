      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S1083ECHNr
         LOCAL S1253EchMo
         S2EmpCod = THISFORM.A2EmpCod
         S1083ECHNr = THISFORM.A1083ECHNr
         S1253EchMo = THISFORM.A1253EchMo
         THISFORM.A1253EchMo = THISFORM.M1253EchMo
         THISFORM. cCT144S32 .SaveTemp()
         THISFORM. cCT144S32 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT144S32 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT144S32 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT144S32 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1253EchMo = THISFORM.A1253EchMo
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT144S32 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT144S32 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1253EchMo = THISFORM.A1253EchMo
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT144S32 .Refresh()
               THISFORM. cCT144S32 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1083ECHNr = S1083ECHNr
               THISFORM.A1253EchMo = S1253EchMo
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT144S32 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT144S32 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1253EchMo = THISFORM.A1253EchMo
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT144S32 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1083ECHNr = THISFORM.A1083ECHNr .AND. S1253EchMo = THISFORM.A1253EchMo
            ENDDO
            IF sf_err != 0
               THISFORM. cCT144S32 .AppendRow()
               THISFORM. cCT144S32 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1083ECHNr = S1083ECHNr
               THISFORM.A1253EchMo = S1253EchMo
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1083ECHNr = S1083ECHNr
         THISFORM.A1253EchMo = S1253EchMo
         RETURN .F.
      ENDFUNC
