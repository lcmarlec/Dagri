      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T014422" , @HStmt_T014422 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCAMMON","T014422","",GX_CURSOR_TYPE_READONLY,@HStmt_T014422) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [ECHNroInt], [EchMonCod], [EchMOnImp], [EchMonCot], [EchMonEgr] "
                  cmdbuf = cmdbuf + "  FROM [ENTCHE3] (NOLOCK) WHERE [EmpCod] = ? AND [ECHNroInt] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [ECHNroInt], [EchMonCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T014422,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T014422,9)
                  THISFORM.GX_DB_BindColsT014422_01 ()
                  THISFORM.GX_DB_BindParmT014422_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T014422,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1083ECHNr = THISFORM.A1083ECHNr
               Gx_err = GX_DB_SetDouble( HStmt_T014422,2,@AuxA1083ECHNr,0)
               THISFORM.A1083ECHNr = AuxA1083ECHNr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T014422) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T014422 = Gx_err
               THISFORM.GX_DB_GetT014422_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T014422 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T014422) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T014422 = Gx_err
                  THISFORM.GX_DB_GetT014422_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T014422 <> 101
               BRK40143 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT144S32.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T014422) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T014422 = Gx_err
               THISFORM.GX_DB_GetT014422_01 ()
            ENDDO
         ENDIF
      ENDPROC
