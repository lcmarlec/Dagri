         LOCAL gx_old_event
         THISFORM.SetEvent( "'ENTER'" )
         * 'Enter' Routine
         THISFORM.AV36I = 0
         IF THISFORM.AV27Artcod + THISFORM.AV29Famcod + THISFORM.AV28Famsub = 0
            DO GX_ERRMW WITH "Debe seleccionar un Artículo"
         ELSE
            IF THISFORM.AV30Descue = 0
               DO GX_ERRMW WITH "Debe Seleccionar un Descuento"
            ELSE
               IF THISFORM.AV30Descue > 100
                  DO GX_ERRMW WITH "No puede descontar mas del 100%"
               ELSE
                  THISFORM.Gx_msg = "Desea Descontar un " + str( THISFORM.AV30Descue , 5 , 2 ) + "% de la venta de " + ALLTRIM( THISFORM.AV26Artdsc ) + " ? "
                  Response = .T.
                  DO GX_CONFW WITH THISFORM.Gx_msg , Response
                  IF Response
                     THISFORM.AV36I = 0
                     THISFORM.AV37Rutas = 0
                     LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
                     GX_SFERR = 0
                     Gx_fel_sel = .T.
                     gxO_Rec = 0
                     SELECT( THISFORM.cCW552S28 .GX_SfAlias)
                     gxO_Rec1 = IIF(EOF(), 0, RECNO())
                     THISFORM.cCW552S28.SF (8, @GX_SFERR)
                     DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
                        THISFORM.cCW552S28.SF (3, @GX_SFERR)
                        THISFORM.cCW552S28 .SaveGridPos()
                        IF THISFORM.AV35Imprim = "S"
                           IF THISFORM.AV36I < 99
                              THISFORM.AV36I = THISFORM.AV36I + 1
                              THISFORM.AV37Rutas[THISFORM.AV36I] = THISFORM.A966RutCod
                              THISFORM.AV34Rutcod = THISFORM.A966RutCod
                              THISFORM.SaveTblPos()
                              Aux0 = THISFORM.AV11Emprco
                              Aux1 = THISFORM.AV29Famcod
                              Aux2 = THISFORM.AV28Famsub
                              Aux3 = THISFORM.AV27Artcod
                              Aux4 = THISFORM.AV24Clides
                              Aux5 = THISFORM.AV30Descue
                              Aux6 = THISFORM.AV31Fecha
                              Aux7 = THISFORM.AV32Redond
                              Aux8 = THISFORM.AV19Usuari
                              Aux9 = THISFORM.AV34Rutcod
                              Aux10 = THISFORM.AV42Excel
                              Aux11 = THISFORM.AV43Parcia
                              DO PDesMas WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6 , Aux7 , Aux8 , Aux9 , Aux10 , Aux11
                              THISFORM.AV11Emprco = Aux0
                              THISFORM.AV29Famcod = Aux1
                              THISFORM.AV28Famsub = Aux2
                              THISFORM.AV27Artcod = Aux3
                              THISFORM.AV24Clides = Aux4
                              THISFORM.AV30Descue = Aux5
                              THISFORM.AV31Fecha = Aux6
                              THISFORM.AV32Redond = Aux7
                              THISFORM.AV19Usuari = Aux8
                              THISFORM.AV34Rutcod = Aux9
                              THISFORM.AV42Excel = Aux10
                              THISFORM.AV43Parcia = Aux11
                              THISFORM. cCW552S28 .RestoreGridPos()
                              GX_rploop = .T.
                           ENDIF
                        ENDIF
                        IF Gx_fel_sel
                           THISFORM.cCW552S28 .RestoreGridPos()
                           THISFORM.cCW552S28.SF (4, @GX_SFERR)
                           THISFORM.cCW552S28.SF (9, @GX_SFERR)
                        ENDIF
                     ENDDO
                     THISFORM.cCW552S28 .ResetSavedGridPos()
                     SELECT( THISFORM.cCW552S28 .GX_SfAlias)
                     IF gxO_Rec1 != 0
                        GOTO (gxO_Rec1)
                        THISFORM.cCW552S28.SF (3, @GX_SFERR)
                     ENDIF
                  ENDIF
                  THISFORM.GX_Refresh = 2   &&& Refresh Keep
               ENDIF
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
