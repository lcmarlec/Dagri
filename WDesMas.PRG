            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05522" , @HStmt_W05522 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESMAS","W05522","",GX_CURSOR_TYPE_READONLY,@HStmt_W05522) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [RutCod] FROM [RUTAS] (FASTFIRSTROW NOLOCK) ORDER BY [EmpCod], [RutCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05522,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05522,11)
                  THISFORM.GX_DB_BindColsW05522_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05522 = Gx_err
               THISFORM.GX_DB_GetW05522_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV48Pgmnam = "WDesMas"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05522 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05522) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05522 = Gx_err
                  THISFORM.GX_DB_GetW05522_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05522 <> 101
               BRKVFC2 = .F.
               THISFORM.AV35Imprim = SPACE(1)
               THISFORM.A966RutCod = THISFORM.Buf_W05522_966RutCod
               GX_SFLOAD = 0
               THISFORM.U20VFC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05522) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05522 = Gx_err
               THISFORM.GX_DB_GetW05522_01 ()
            ENDDO
         ENDIF
      ENDPROC
