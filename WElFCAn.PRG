         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04203" , @HStmt_W04203 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WELFCAN","W04203","",GX_CURSOR_TYPE_READONLY,@HStmt_W04203) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [DcCNroInt], [EmpCod], [DcCSuc], [DcCNro], [EntCod], [DccArtPen] FROM [DCCOM] "
            cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND ([DcCSuc] >= ?) AND ([DcCNro] >= "
            cmdbuf = cmdbuf + "  ?) AND ([DcCNro] > 0) AND ([EntCod] = ?) AND ([DccArtPen] > 0) ORDER BY [EmpCod], "
            cmdbuf = cmdbuf + "  [DcCNroInt]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04203,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04203,15)
            THISFORM.GX_DB_BindColsW04203_01 ()
            THISFORM.GX_DB_BindParmW04203_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04203,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV13Dessuc = THISFORM.AV13Dessuc
