         THISFORM.AV13Dessuc = AuxAV13Dessuc
         AuxAV14Desnro = THISFORM.AV14Desnro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04203,3,@AuxAV14Desnro,0)
         THISFORM.AV14Desnro = AuxAV14Desnro
         AuxAV11Desprv = THISFORM.AV11Desprv
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04203,4,@AuxAV11Desprv,0)
         THISFORM.AV11Desprv = AuxAV11Desprv
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04203) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W04203 = Gx_err
         THISFORM.GX_DB_GetW04203_01 ()
         DO WHILE THISFORM.W04203 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W04203_2EmpCod
            THISFORM.A350DcCSuc = THISFORM.Buf_W04203_350DcCSuc
            THISFORM.A352DcCNro = THISFORM.Buf_W04203_352DcCNro
            THISFORM.A120EntCod = THISFORM.Buf_W04203_120EntCod
            THISFORM.A1264DccAr = THISFORM.Buf_W04203_1264DccArtPen
            THISFORM.AV26GXLvl4 = 1
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04203) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W04203 = Gx_err
            THISFORM.GX_DB_GetW04203_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W04203) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV26GXLvl4 = 0
            THISFORM.ReleaseAll()
            RETURN
         ENDIF
