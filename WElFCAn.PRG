      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04202" , @HStmt_W04202 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WELFCAN","W04202","",GX_CURSOR_TYPE_READONLY,@HStmt_W04202) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[EntGruTip], T1.[DcCNroInt], T1.[DccArtPen], T1.[DcCFec], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz], T1.[EntCod], T1.[DcCNro], T1.[DcCSuc], T1.[DccTipRed] FROM ([DCCOM] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[EntGruTip] = T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[DcCSuc] >= ?) AND (T1.[DcCNro] >= ? and T1.[DcCNro] > 0) AND (T1.[EntCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[DccArtPen] > 0) ORDER BY T1.[EmpCod], T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04202,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04202,15)
                  THISFORM.GX_DB_BindColsW04202_01 ()
                  THISFORM.GX_DB_BindParmW04202_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04202,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV13Dessuc = THISFORM.AV13Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04202,2,@AuxAV13Dessuc,0)
               THISFORM.AV13Dessuc = AuxAV13Dessuc
               AuxAV14Desnro = THISFORM.AV14Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04202,3,@AuxAV14Desnro,0)
               THISFORM.AV14Desnro = AuxAV14Desnro
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04202,4,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04202) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04202 = Gx_err
               THISFORM.GX_DB_GetW04202_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WElFCAn"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04202 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04202) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04202 = Gx_err
                  THISFORM.GX_DB_GetW04202_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04202 <> 101
               BRKVBO2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W04202_2EmpCod
               THISFORM.A150EntGru = THISFORM.Buf_W04202_150EntGruTip
               THISFORM.A346DcCNro = THISFORM.Buf_W04202_346DcCNroInt
               THISFORM.A1264DccAr = THISFORM.Buf_W04202_1264DccArtPen
               THISFORM.A347DcCFec = THISFORM.Buf_W04202_347DcCFec
               THISFORM.A153EntRaz = THISFORM.Buf_W04202_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W04202_120EntCod
               THISFORM.A352DcCNro = THISFORM.Buf_W04202_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W04202_350DcCSuc
               THISFORM.A1322DccTi = THISFORM.Buf_W04202_1322DccTipRed
               THISFORM.A153EntRaz = THISFORM.Buf_W04202_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U17VBO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04202) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04202 = Gx_err
               THISFORM.GX_DB_GetW04202_01 ()
            ENDDO
         ENDIF
      ENDPROC
