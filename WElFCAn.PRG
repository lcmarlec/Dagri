      PROCEDURE CreateTemp
         LOCAL SCW420S17
         SCW420S17 = ""
         IF USED( "SCW420S17" )
            SELECT SCW420S17
            SCW420S17 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW420S17
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA1322DccT"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 2
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA350DcCSu"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 5
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA352DcCNr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 9
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA120EntCo"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA153EntRa"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA347DcCFe"
            GX_STRUCT[ 6 ,2]= "D"
            GX_STRUCT[ 6 ,3]= 8
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA1264DccA"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 4

            GX_STRUCT[ 8 ,1]= "sA346DcCNr"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 0

            GX_STRUCT[ 9 ,1]= "sA150EntGr"
            GX_STRUCT[ 9 ,2]= "C"
            GX_STRUCT[ 9 ,3]= 2
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW420S17 = GETE('z:\temp') + '\' + SCW420S17
            ENDIF
            CREATE DBF (SCW420S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCW420S17) EXCLUSIVE ALIAS SCW420S17
