      ***********************
      PROCEDURE U18VBG2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04125" , @HStmt_W04125 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREMINT","W04125","",GX_CURSOR_TYPE_READONLY,@HStmt_W04125) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[RILin], T1.[FamCod], T1.[FamSubCod], T1.[EmpCod], T1.[RINroInt], T1.[ArtCod], "
            cmdbuf = cmdbuf + "  T2.[ArtDsc], T1.[RITraz], T1.[RICnt] FROM ([REMINT1] T1 (NOLOCK) LEFT JOIN [ARTICS] "
            cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] "
            cmdbuf = cmdbuf + "  = T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) WHERE T1.[EmpCod] = ? and T1.[RINroInt] "
            cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[RINroInt]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04125,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04125,15)
            THISFORM.GX_DB_BindColsW04125_01 ()
            THISFORM.GX_DB_BindParmW04125_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04125,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA1306RINro = THISFORM.A1306RINro
         THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04125,2,@AuxA1306RINro,0)
         THISFORM.A1306RINro = AuxA1306RINro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04125) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W04125 = Gx_err
         THISFORM.GX_DB_GetW04125_01 ()
         DO WHILE THISFORM.W04125 <> 101
            THISFORM.A3FamCod = THISFORM.Buf_W04125_3FamCod
            THISFORM.A4FamSubCo = THISFORM.Buf_W04125_4FamSubCod
            THISFORM.A5ArtCod = THISFORM.Buf_W04125_5ArtCod
            THISFORM.A6ArtDsc = THISFORM.Buf_W04125_6ArtDsc
            THISFORM.A3000RITra = THISFORM.Buf_W04125_3000RITraz
            THISFORM.A1321RICnt = THISFORM.Buf_W04125_1321RICnt
            THISFORM.A6ArtDsc = THISFORM.Buf_W04125_6ArtDsc
            THISFORM.AV29Artcod = THISFORM.A5ArtCod
            THISFORM.AV34Artdsc = THISFORM.A6ArtDsc
            THISFORM.AV27Ritraz = THISFORM.A3000RITra
            THISFORM.AV28Ricnt = THISFORM.A1321RICnt
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04125) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W04125 = Gx_err
            THISFORM.GX_DB_GetW04125_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W04125) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.cCW412S30 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW412S30 .GX_rec_loaded =  THISFORM.cCW412S30 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW412S30 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW412S30 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

