         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04124" , @HStmt_W04124 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREMINT","W04124","",GX_CURSOR_TYPE_READONLY,@HStmt_W04124) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RINroInt], T1.[EmpCod], T1.[LiPrCod], T2.[LiPrDsc], T5.[CRITiMo], T1.[RIEst], "
                  cmdbuf = cmdbuf + "  T3.[LugDsc] AS RiLugHtaD, T1.[RILugHta] AS RILugHta, T4.[LugDsc] AS RiLugDdeD, T1.[RILugDde] "
                  cmdbuf = cmdbuf + "  AS RILugDde, T1.[RIObs], T5.[CRIDsc], T1.[CRICod], T1.[RiHora], T1.[RIFch], T1.[RINro] "
                  cmdbuf = cmdbuf + "  FROM (((([REMINT] T1 (NOLOCK) LEFT JOIN [LIPROD] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[LiPrCod] = T1.[LiPrCod]) LEFT JOIN [LUGALM] T3 (NOLOCK) ON T3.[EmpCod] = "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] AND T3.[LugCod] = T1.[RILugHta]) LEFT JOIN [LUGALM] T4 (NOLOCK) ON T4.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T4.[LugCod] = T1.[RILugDde]) LEFT JOIN [CRINTERN] T5 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T5.[EmpCod] = T1.[EmpCod] AND T5.[CRICod] = T1.[CRICod]) WHERE (T1.[EmpCod] = "
                  cmdbuf = cmdbuf + "  ?) AND (T1.[RIEst] > 0) AND (T1.[RIFch] >= ?) AND (T1.[CRICod] = ? or ? = 0) AND "
                  cmdbuf = cmdbuf + "  (( T1.[LiPrCod] <> 'ZZ' and ? = 'V') or ( T1.[LiPrCod] = 'ZZ' and ? = 'C')) AND "
                  cmdbuf = cmdbuf + "  (T1.[RINro] >= ?) AND (T1.[RiHora] >= ?) AND (T1.[LiPrCod] = ? or ? = '  ') ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[RINroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04124,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04124,15)
                  THISFORM.GX_DB_BindColsW04124_01 ()
                  THISFORM.GX_DB_BindParmW04124_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04124,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV17Fecdes = THISFORM.AV17Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04124,2,@AuxAV17Fecdes,0)
               THISFORM.AV17Fecdes = AuxAV17Fecdes
               AuxAV25Cricod = THISFORM.AV25Cricod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04124,3,@AuxAV25Cricod,0)
               THISFORM.AV25Cricod = AuxAV25Cricod
               AuxAV25Cricod = THISFORM.AV25Cricod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04124,4,@AuxAV25Cricod,0)
               THISFORM.AV25Cricod = AuxAV25Cricod
               AuxAV24Sistem = THISFORM.AV24Sistem
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04124,5,AuxAV24Sistem,1,0)
               THISFORM.AV24Sistem = AuxAV24Sistem
               AuxAV24Sistem = THISFORM.AV24Sistem
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04124,6,AuxAV24Sistem,1,0)
               THISFORM.AV24Sistem = AuxAV24Sistem
               AuxAV26Rinrod = THISFORM.AV26Rinrod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04124,7,@AuxAV26Rinrod,0)
               THISFORM.AV26Rinrod = AuxAV26Rinrod
               AuxAV31Rihora = THISFORM.AV31Rihora
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04124,8,AuxAV31Rihora,8,0)
               THISFORM.AV31Rihora = AuxAV31Rihora
               AuxAV33Liprco = THISFORM.AV33Liprco
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04124,9,AuxAV33Liprco,4,0)
               THISFORM.AV33Liprco = AuxAV33Liprco
               AuxAV33Liprco = THISFORM.AV33Liprco
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04124,10,AuxAV33Liprco,4,0)
               THISFORM.AV33Liprco = AuxAV33Liprco
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04124) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04124 = Gx_err
               THISFORM.GX_DB_GetW04124_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV37Pgmnam = "WRemInt"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04124 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04124) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04124 = Gx_err
                  THISFORM.GX_DB_GetW04124_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04124 <> 101
               BRKVBG2 = .F.
               THISFORM.A1306RINro = THISFORM.Buf_W04124_1306RINroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W04124_2EmpCod
               THISFORM.A2867LiPrC = THISFORM.Buf_W04124_2867LiPrCod
               THISFORM.A2868LiPrD = THISFORM.Buf_W04124_2868LiPrDsc
               THISFORM.A1320CRITi = THISFORM.Buf_W04124_1320CRITiMo
               THISFORM.A1310RIEst = THISFORM.Buf_W04124_1310RIEst
               THISFORM.A1315RiLug = THISFORM.Buf_W04124_1315RiLugHtaD
               THISFORM.A1314RILug = THISFORM.Buf_W04124_1314RILugHta
               THISFORM.A1313RiLug = THISFORM.Buf_W04124_1313RiLugDdeD
               THISFORM.A1312RILug = THISFORM.Buf_W04124_1312RILugDde
               THISFORM.A1311RIObs = THISFORM.Buf_W04124_1311RIObs
               THISFORM.A1319CRIDs = THISFORM.Buf_W04124_1319CRIDsc
               THISFORM.A1318CRICo = THISFORM.Buf_W04124_1318CRICod
               THISFORM.A1584RiHor = THISFORM.Buf_W04124_1584RiHora
               THISFORM.A1308RIFch = THISFORM.Buf_W04124_1308RIFch
               THISFORM.A1317RINro = THISFORM.Buf_W04124_1317RINro
               THISFORM.A2868LiPrD = THISFORM.Buf_W04124_2868LiPrDsc
               THISFORM.A1315RiLug = THISFORM.Buf_W04124_1315RiLugHtaD
               THISFORM.A1313RiLug = THISFORM.Buf_W04124_1313RiLugDdeD
               THISFORM.A1320CRITi = THISFORM.Buf_W04124_1320CRITiMo
               THISFORM.A1319CRIDs = THISFORM.Buf_W04124_1319CRIDsc
               GX_SFLOAD = 0
               THISFORM.U18VBG2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04124) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04124 = Gx_err
               THISFORM.GX_DB_GetW04124_01 ()
            ENDDO
         ENDIF
      ENDPROC
