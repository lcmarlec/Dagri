            Gx_err = GX_DB_Set_StmtCmdText( HStmt_P04146,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_P04146,100)
            GX_DB_BindColsP04146_01 ()
            GX_DB_BindParmP04146_01 ()
         ENDIF
         Gx_err = GX_DB_SetInt( HStmt_P04146,1,@AV10Empcod,0)
         Gx_err = GX_DB_SetInt( HStmt_P04146,2,@AV11Talbco,0)
         Gx_err = GX_DB_SetDouble( HStmt_P04146,3,@RV14Talchq,0)
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_P04146) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P04146 = Gx_err
         GX_DB_GetP04146_01 ()
         DO WHILE P04146 <> 101
            R1723TalNr = Buf_P04146_1723TalNroDde
            R1726TalHa = Buf_P04146_1726TalHab
            R1729TalCh = Buf_P04146_1729TalChqEst
            R1727TalCh = Buf_P04146_1727TalChqNro
            R1721TalBc = Buf_P04146_1721TalBcoCta
            R2EmpCod = Buf_P04146_2EmpCod
            R1726TalHa = Buf_P04146_1726TalHab
            RV24GXLvl5 = 1
            IF R1729TalCh <> 0
               AV9Ok = 0
            ENDIF
            * Exit For each command. Update data (if necessary), close cursors & exit.
            EXIT
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_P04146) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            P04146 = Gx_err
            GX_DB_GetP04146_01 ()
            IF UserCancel
               EXIT
            ENDIF
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P04146) ,  ,  ,  , CS_SQLSRV ,  )
         LEVEL6 = .F.
         IF RV24GXLvl5 = 0
            AV9Ok = 9
         ENDIF
   ENDCASE
   DO EPBI0
   RETURN
   DO EPBI0
   RETURN
   GX_retp = 0
* End Program

