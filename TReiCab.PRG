      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02705,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA2617ReIRo = THISFORM.A2617ReIRo
            Gx_err = GX_DB_SetStr( HStmt_T02705,2,AuxA2617ReIRo,1,0)
            THISFORM.A2617ReIRo = AuxA2617ReIRo
            AuxA2616ReINr = THISFORM.A2616ReINr
            Gx_err = GX_DB_SetDouble( HStmt_T02705,3,@AuxA2616ReINr,0)
            THISFORM.A2616ReINr = AuxA2616ReINr
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02705) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02705 = Gx_err
            THISFORM.GX_DB_GetT02705_01 ()
            IF .NOT. THISFORM.T02705 <> 103
               DO GX_ERRMW WITH "REINCID reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02705 = 101 .OR. THISFORM.Z2622ReiEs <> THISFORM.Buf_T02705_2622ReiEst
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2634ReIEn <> THISFORM.Buf_T02705_2634ReIEntLG
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2639ReIFc <> THISFORM.Buf_T02705_2639ReIFch
               DO GX_ERRMW WITH "REINCID fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T027013" , @HStmt_T027013 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TREICAB","T027013","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T027013) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [REINCID] ([ReIRoI], [ReINroI], [EmpCod], [ReiEst], [ReIACP], [ReiObsDet], "
