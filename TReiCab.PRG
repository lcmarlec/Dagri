      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T027019" , @HStmt_T027019 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TREICAB","T027019","",GX_CURSOR_TYPE_READONLY,@HStmt_T027019) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [ReIRoI], [ReINroI], [FamCod], [FamSubCod], [ArtCod], [ReIArtLot], "
                  cmdbuf = cmdbuf + "  [ReiArtCnt], [ReiMues], [ReIArtVto] FROM [REINCID4] (NOLOCK) WHERE [EmpCod] = ? "
                  cmdbuf = cmdbuf + "  AND [ReIRoI] = ? AND [ReINroI] = ? ORDER BY [EmpCod], [ReIRoI], [ReINroI], [FamCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod], [ArtCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T027019,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T027019,12)
                  THISFORM.GX_DB_BindColsT027019_01 ()
                  THISFORM.GX_DB_BindParmT027019_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T027019,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2617ReIRo = THISFORM.A2617ReIRo
               Gx_err = GX_DB_SetStr( HStmt_T027019,2,AuxA2617ReIRo,1,0)
               THISFORM.A2617ReIRo = AuxA2617ReIRo
               AuxA2616ReINr = THISFORM.A2616ReINr
               Gx_err = GX_DB_SetDouble( HStmt_T027019,3,@AuxA2616ReINr,0)
               THISFORM.A2616ReINr = AuxA2616ReINr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T027019) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T027019 = Gx_err
               THISFORM.GX_DB_GetT027019_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T027019 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T027019) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T027019 = Gx_err
                  THISFORM.GX_DB_GetT027019_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T027019 <> 101
               BRK7I308 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT270Tb28.cCT270Pg40Tb28.cCT270S42.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T027019_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T027019_2616ReINroI = THISFORM.A2616ReINr .AND. THISFORM.Buf_T027019_2617ReIRoI = THISFORM.A2617ReIRo
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T027019) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T027019 = Gx_err
               THISFORM.GX_DB_GetT027019_01 ()
            ENDDO
         ENDIF
      ENDPROC
