      PROCEDURE CreateTemp
         LOCAL SCW725S18
         SCW725S18 = ""
         IF USED( "SCW725S18" )
            SELECT SCW725S18
            SCW725S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW725S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "VAV28Dccsu"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 5
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV29Dccnr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 9
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV32Dccfe"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV30Entco"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV31Entra"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV24Dccne"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "VAV25Dccne"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 2

            GX_STRUCT[ 8 ,1]= "VAV26Dccdi"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 2

            GX_STRUCT[ 9 ,1]= "VAV27Dccnr"
            GX_STRUCT[ 9 ,2]= "N"
            GX_STRUCT[ 9 ,3]= 12
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW725S18 = GETE('z:\temp') + '\' + SCW725S18
            ENDIF
            CREATE DBF (SCW725S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW725S18) EXCLUSIVE ALIAS SCW725S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW725S18
         THIS.GX_SfAlias = "SCW725S18"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV24Dccnet = 0.00
               THISFORM.AV26Dccdif = 0.00
               GX_SFLOAD = 0
               THISFORM.U15VK52 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
