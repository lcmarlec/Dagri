      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV28Dccsuc = 0
         THISFORM.AV29Dccnro = 0
         THISFORM.AV32Dccfec = CTOD("  /  /  ")
         THISFORM.AV30Entcod = 0
         THISFORM.AV31Entraz = SPACE(40)
         THISFORM.AV24Dccnet = 0.00
         THISFORM.AV25Dccnet = 0.00
         THISFORM.AV26Dccdif = 0.00
         THISFORM.AV27Dccnro = 0
         THIS.SaveTemp()
