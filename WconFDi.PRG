      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV28Dccsu WITH THISFORM.AV28Dccsuc
         REPLACE VAV29Dccnr WITH THISFORM.AV29Dccnro
         REPLACE VAV32Dccfe WITH THISFORM.AV32Dccfec
         REPLACE VAV30Entco WITH THISFORM.AV30Entcod
         REPLACE VAV31Entra WITH THISFORM.AV31Entraz
         REPLACE VAV24Dccne WITH THISFORM.AV24Dccnet
         REPLACE VAV25Dccne WITH THISFORM.AV25Dccnet
