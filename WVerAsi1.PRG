                  cmdbuf = cmdbuf + "  T1.[AsiNroInt], T1.[AsiItNro], T1.[AsiGesHb], T1.[AsiGesDb], T1.[AsiGesDes], T4.[CtaDes], "
                  cmdbuf = cmdbuf + "  T3.[CtaNro] FROM ((([ASIEN2] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EJE] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EjeNro] = T1.[EjeNro]) LEFT JOIN [ASIEN1] T3 "
                  cmdbuf = cmdbuf + "  (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EjeNro] = T1.[EjeNro] AND T3.[AsiCod] "
                  cmdbuf = cmdbuf + "  = T1.[AsiCod] AND T3.[AsiNroInt] = T1.[AsiNroInt] AND T3.[AsiItNro] = T1.[AsiItNro]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CTA00] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[PCtaNro] = T2.[PCtaNro] "
                  cmdbuf = cmdbuf + "  AND T4.[CtaNro] = T3.[CtaNro]) WHERE T1.[EmpCod] = ? and T1.[EjeNro] = ? and T1.[AsiCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[AsiNroInt] = ? and T1.[AsiItNro] = ? ORDER BY T1.[EmpCod], T1.[EjeNro], "
                  cmdbuf = cmdbuf + "  T1.[AsiCod], T1.[AsiNroInt], T1.[AsiItNro]  "
