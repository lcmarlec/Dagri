      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T028621" , @HStmt_T028621 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDSPVTA","T028621","",GX_CURSOR_TYPE_READONLY,@HStmt_T028621) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [DspNroAn], [DspNroAd], [DspNroTip], [DspNroReg], [DspNroDC], [DcVNroInt], "
                  cmdbuf = cmdbuf + "  [DcvNroII], [DspDvTot] FROM [DSPVTA2] (NOLOCK) WHERE [EmpCod] = ? AND [DspNroAn] "
                  cmdbuf = cmdbuf + "  = ? AND [DspNroAd] = ? AND [DspNroTip] = ? AND [DspNroReg] = ? AND [DspNroDC] = "
                  cmdbuf = cmdbuf + "  ? AND [DcVNroInt] = ? ORDER BY [EmpCod], [DspNroAn], [DspNroAd], [DspNroTip], [DspNroReg], "
                  cmdbuf = cmdbuf + "  [DspNroDC], [DcVNroInt], [DcvNroII]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T028621,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T028621,9)
                  THISFORM.GX_DB_BindColsT028621_01 ()
                  THISFORM.GX_DB_BindParmT028621_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T028621,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2783DspNr = THISFORM.A2783DspNr
               Gx_err = GX_DB_SetInt( HStmt_T028621,2,@AuxA2783DspNr,0)
               THISFORM.A2783DspNr = AuxA2783DspNr
               AuxA2784DspNr = THISFORM.A2784DspNr
               Gx_err = GX_DB_SetStr( HStmt_T028621,3,AuxA2784DspNr,3,0)
               THISFORM.A2784DspNr = AuxA2784DspNr
               AuxA2785DspNr = THISFORM.A2785DspNr
               Gx_err = GX_DB_SetStr( HStmt_T028621,4,AuxA2785DspNr,4,0)
               THISFORM.A2785DspNr = AuxA2785DspNr
               AuxA2786DspNr = THISFORM.A2786DspNr
               Gx_err = GX_DB_SetLong( HStmt_T028621,5,@AuxA2786DspNr,0)
               THISFORM.A2786DspNr = AuxA2786DspNr
               AuxA2807DspNr = THISFORM.A2807DspNr
               Gx_err = GX_DB_SetStr( HStmt_T028621,6,AuxA2807DspNr,1,0)
               THISFORM.A2807DspNr = AuxA2807DspNr
               AuxA415DcVNro = THISFORM.A415DcVNro
               Gx_err = GX_DB_SetDouble( HStmt_T028621,7,@AuxA415DcVNro,0)
               THISFORM.A415DcVNro = AuxA415DcVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T028621) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T028621 = Gx_err
               THISFORM.GX_DB_GetT028621_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T028621 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T028621) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T028621 = Gx_err
                  THISFORM.GX_DB_GetT028621_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T028621 <> 101
               BRK7Y318 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT286S51.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T028621) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T028621 = Gx_err
               THISFORM.GX_DB_GetT028621_01 ()
            ENDDO
         ENDIF
