      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T036814" , @HStmt_T036814 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPRESTAC","T036814","",GX_CURSOR_TYPE_READONLY,@HStmt_T036814) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TraCod], [PreFch], [PreCuoNro], [PrecuoAA], [PreCuoMM], [PreCuoImp], "
                  cmdbuf = cmdbuf + "  [PreCuoDes], [PreCuoCon] FROM [PRESTA1] (NOLOCK) WHERE [EmpCod] = ? AND [TraCod] "
                  cmdbuf = cmdbuf + "  = ? AND [PreFch] = ? ORDER BY [EmpCod], [TraCod], [PreFch], [PreCuoNro]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T036814,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T036814,9)
                  THISFORM.GX_DB_BindColsT036814_01 ()
                  THISFORM.GX_DB_BindParmT036814_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T036814,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA561TraCod = THISFORM.A561TraCod
               Gx_err = GX_DB_SetLong( HStmt_T036814,2,@AuxA561TraCod,0)
               THISFORM.A561TraCod = AuxA561TraCod
               AuxA2755PreFc = THISFORM.A2755PreFc
               Gx_err = GX_DB_SetDateTime( HStmt_T036814,3,@AuxA2755PreFc,0)
               THISFORM.A2755PreFc = AuxA2755PreFc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T036814) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T036814 = Gx_err
               THISFORM.GX_DB_GetT036814_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T036814 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T036814) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T036814 = Gx_err
                  THISFORM.GX_DB_GetT036814_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T036814 <> 101
               BRKA8392 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT368S18.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T036814) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T036814 = Gx_err
               THISFORM.GX_DB_GetT036814_01 ()
            ENDDO
         ENDIF
      ENDPROC
