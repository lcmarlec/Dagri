      PROCEDURE CreateTemp
         LOCAL SCW696S20
         SCW696S20 = ""
         IF USED( "SCW696S20" )
            SELECT SCW696S20
            SCW696S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW696S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2113xEmp"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2103xPlV"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2104xPlV"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2105xLpv"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2122xLpv"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW696S20 = GETE('z:\temp') + '\' + SCW696S20
            ENDIF
            CREATE DBF (SCW696S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW696S20) EXCLUSIVE ALIAS SCW696S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW696S20
         THIS.GX_SfAlias = "SCW696S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06962" , @HStmt_W06962 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06J0","W06962","",GX_CURSOR_TYPE_READONLY,@HStmt_W06962) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [lpvret2], [lpvret], [lpvret1], [lpvfch], [plventcod], [plvgrutip], [empcod] "
                  cmdbuf = cmdbuf + "  FROM [lpvclt] (FASTFIRSTROW NOLOCK) WHERE ([empcod] >= ?) AND ([plvgrutip] like "
                  cmdbuf = cmdbuf + "  ?) AND ([plventcod] >= ?) AND ([lpvfch] >= ?) AND ([lpvret1] >= ?) AND ([lpvret2] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([lpvret] >= ?) ORDER BY [empcod], [plvgrutip], [plventcod], [lpvfch] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06962,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06962,9)
                  THISFORM.GX_DB_BindColsW06962_01 ()
                  THISFORM.GX_DB_BindParmW06962_01 ()
               ENDIF
               AuxAV5C2113 = THISFORM.AV5C2113
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06962,1,@AuxAV5C2113,0)
               THISFORM.AV5C2113 = AuxAV5C2113
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06962,2,PADR( TRIM(THISFORM.AV6C2103),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C2103),2, '%')),0)
               AuxAV7C2104 = THISFORM.AV7C2104
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06962,3,@AuxAV7C2104,0)
               THISFORM.AV7C2104 = AuxAV7C2104
               AuxAV8C2105 = THISFORM.AV8C2105
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06962,4,@AuxAV8C2105,0)
               THISFORM.AV8C2105 = AuxAV8C2105
               AuxAV9C2122 = THISFORM.AV9C2122
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06962,5,@AuxAV9C2122,0)
               THISFORM.AV9C2122 = AuxAV9C2122
               AuxAV10C2123 = THISFORM.AV10C2123
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06962,6,@AuxAV10C2123,0)
               THISFORM.AV10C2123 = AuxAV10C2123
               AuxAV11C2124 = THISFORM.AV11C2124
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06962,7,@AuxAV11C2124,0)
               THISFORM.AV11C2124 = AuxAV11C2124
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06962 = Gx_err
               THISFORM.GX_DB_GetW06962_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06962 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06962) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06962 = Gx_err
                  THISFORM.GX_DB_GetW06962_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06962 <> 101
               BRKVJC2 = .F.
               THISFORM.A2123xLpvR = THISFORM.Buf_W06962_2123xLpvRet2
               THISFORM.A2124xLpvR = THISFORM.Buf_W06962_2124xLpvRet
               THISFORM.A2122xLpvR = THISFORM.Buf_W06962_2122xLpvRet1
               THISFORM.A2105xLpvF = THISFORM.Buf_W06962_2105xLpvFch
               THISFORM.A2104xPlVE = THISFORM.Buf_W06962_2104xPlVEntCod
               THISFORM.A2103xPlVG = THISFORM.Buf_W06962_2103xPlVGruTip
               THISFORM.A2113xEmpC = THISFORM.Buf_W06962_2113xEmpCod
               GX_SFLOAD = 0
               THISFORM.U12VJC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06962 = Gx_err
               THISFORM.GX_DB_GetW06962_01 ()
            ENDDO
         ENDIF
      ENDPROC
