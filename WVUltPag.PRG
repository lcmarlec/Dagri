                  cmdbuf = " SELECT [OPaNroI], [EmpCod], [OpaEntCod], [OpaEntGruT], [OpaTot], [OpaFch], [OPaNro] "
                  cmdbuf = cmdbuf + "  FROM [OPAGOS] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [OpaEntGruT] = ? and "
                  cmdbuf = cmdbuf + "  [OpaEntCod] = ? and [OpaFch] >= ? ORDER BY [EmpCod], [OpaEntGruT], [OpaEntCod], "
                  cmdbuf = cmdbuf + "  [OpaFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08422,cmdbuf)
