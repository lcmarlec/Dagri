         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R06018) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL8 = .F.
   ENDIF
   DO CASE
