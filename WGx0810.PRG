         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08342" , @HStmt_W08342 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0810","W08342","",GX_CURSOR_TYPE_READONLY,@HStmt_W08342) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EnvObs], [EnvEst], [EnvFch], [EnvClt], [EmpCod] FROM [ENVIOS] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ? and [EnvClt] >= ? and [EnvFch] >= ?) AND ([EnvEst] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([EnvObs] like ?) ORDER BY [EmpCod], [EnvClt], [EnvFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08342,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08342,9)
                  THISFORM.GX_DB_BindColsW08342_01 ()
                  THISFORM.GX_DB_BindParmW08342_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08342,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C2581 = THISFORM.AV6C2581
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08342,2,@AuxAV6C2581,0)
