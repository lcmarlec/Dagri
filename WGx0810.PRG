               AuxAV8C2583 = THISFORM.AV8C2583
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08342,4,@AuxAV8C2583,0)
               THISFORM.AV8C2583 = AuxAV8C2583
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08342,5,PADR( TRIM(THISFORM.AV9C2584),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C2584),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08342 = Gx_err
               THISFORM.GX_DB_GetW08342_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08342 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
