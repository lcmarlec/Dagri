            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW731S20 = GETE('z:\temp') + '\' + SCW731S20
            ENDIF
            CREATE DBF (SCW731S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW731S20) EXCLUSIVE ALIAS SCW731S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW731S20
         THIS.GX_SfAlias = "SCW731S20"
