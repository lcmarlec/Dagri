         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2200acoNo"
         THISFORM.cCW731S20 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW731S20 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW731S20 .GX_lastkey = 9.or. THISFORM.cCW731S20 .GX_lastkey = 13)
