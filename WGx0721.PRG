      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07312" , @HStmt_W07312 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0721","W07312","",GX_CURSOR_TYPE_READONLY,@HStmt_W07312) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [acoDir], [acoTel], [acoObs], [acoCui], [acoRegVto], [acoNom], [acoCod] "
                  cmdbuf = cmdbuf + "  FROM [ACOM] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [acoCod] >= ?) AND ([acoDir] "
                  cmdbuf = cmdbuf + "  like ?) AND ([acoTel] like ?) AND ([acoObs] like ?) AND ([acoCui] >= ?) AND ([acoRegVto] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [acoCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07312,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07312,9)
                  THISFORM.GX_DB_BindColsW07312_01 ()
                  THISFORM.GX_DB_BindParmW07312_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07312,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C2199 = THISFORM.AV5C2199
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07312,2,@AuxAV5C2199,0)
               THISFORM.AV5C2199 = AuxAV5C2199
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07312,3,PADR( TRIM(THISFORM.AV6C2201),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C2201),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07312,4,PADR( TRIM(THISFORM.AV7C2202),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C2202),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07312,5,PADR( TRIM(THISFORM.AV8C2203),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C2203),40, '%')),0)
               AuxAV9C2204 = THISFORM.AV9C2204
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07312,6,@AuxAV9C2204,0)
               THISFORM.AV9C2204 = AuxAV9C2204
               AuxAV10C2209 = THISFORM.AV10C2209
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W07312,7,@AuxAV10C2209,0)
               THISFORM.AV10C2209 = AuxAV10C2209
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07312 = Gx_err
               THISFORM.GX_DB_GetW07312_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07312 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07312) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07312 = Gx_err
                  THISFORM.GX_DB_GetW07312_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07312 <> 101
               BRKVKB2 = .F.
               THISFORM.A2201acoDi = THISFORM.Buf_W07312_2201acoDir
               THISFORM.A2202acoTe = THISFORM.Buf_W07312_2202acoTel
               THISFORM.A2203acoOb = THISFORM.Buf_W07312_2203acoObs
               THISFORM.A2204acoCu = THISFORM.Buf_W07312_2204acoCui
               THISFORM.A2209acoRe = THISFORM.Buf_W07312_2209acoRegVto
               THISFORM.A2200acoNo = THISFORM.Buf_W07312_2200acoNom
               THISFORM.A2199acoCo = THISFORM.Buf_W07312_2199acoCod
               GX_SFLOAD = 0
               THISFORM.U12VKB2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07312) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07312 = Gx_err
               THISFORM.GX_DB_GetW07312_01 ()
            ENDDO
         ENDIF
      ENDPROC
