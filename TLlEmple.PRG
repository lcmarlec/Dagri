               THISFORM.A3085LLePa = AuxA3085LLePa
               AuxA3086LLeMs = THISFORM.A3086LLeMs
               Gx_err = GX_DB_SetStr( HStmt_T03256,7,AuxA3086LLeMs,999,0)
