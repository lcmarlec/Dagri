      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03256" , @HStmt_T03256 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLLEMPLE","T03256","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03256) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [LLEMPLEA] ([EmpCod], [LLeFch], [TraCod], [LleFR], [LleNom], [LLePar], "
                  cmdbuf = cmdbuf + "  [LLeMsj]) VALUES (?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03256,cmdbuf)
                  THISFORM.GX_DB_BindParmT03256_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03256,1,@AuxA2EmpCod,0)
