            THISFORM.A3083LLeFc = AuxA3083LLeFc
            AuxA561TraCod = THISFORM.A561TraCod
            Gx_err = GX_DB_SetLong( HStmt_T03252,3,@AuxA561TraCod,0)
            THISFORM.A561TraCod = AuxA561TraCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03252) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03252 = Gx_err
            THISFORM.GX_DB_GetT03252_01 ()
            IF .NOT. THISFORM.T03252 <> 103
               DO GX_ERRMW WITH "LLEMPLEA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03252 = 101 .OR. THISFORM.Z3167LleFR <> THISFORM.Buf_T03252_3167LleFR
               DO GX_ERRMW WITH "LLEMPLEA fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
