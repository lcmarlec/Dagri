               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WCIMovRe"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10953 = 101
                  GX_CUERR = 100
               ELSE
