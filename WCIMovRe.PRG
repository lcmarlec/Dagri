                  cmdbuf = " SELECT T1.[CIOKFch], T1.[CIOK], T1.[CISdo], T1.[CIEgr], T1.[CIIng], T1.[CamPat], "
                  cmdbuf = cmdbuf + "  T2.[TraNom], T1.[TraCod], T1.[CIObs], T3.[CIMDsc], T1.[CIMCod], T1.[CINro], T1.[CIHor], "
                  cmdbuf = cmdbuf + "  T1.[CIFch], T1.[CISNI], T1.[CINI], T1.[CICod], T1.[EmpCod] FROM (([CIMOV] T1 (NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [EMPLEADO] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TraCod] = "
                  cmdbuf = cmdbuf + "  T1.[TraCod]) LEFT JOIN [CIMOTIV] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[CIMCod] "
                  cmdbuf = cmdbuf + "  = T1.[CIMCod]) WHERE (T1.[EmpCod] = ? and T1.[CICod] = ? and T1.[CIFch] >= ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[CIOK] = ? or ? = 9) AND (T1.[CIFch] <= ?) ORDER BY T1.[EmpCod], T1.[CICod], "
                  cmdbuf = cmdbuf + "  T1.[CIFch], T1.[CIHor]  "
