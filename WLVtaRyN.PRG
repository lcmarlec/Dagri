      ***********************
      PROCEDURE cCW595V26.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW595V26.ISVALID" )
         IF THISFORM.AV26Clides = 0
            THISFORM.AV43Cliraz = "Todos "
         ELSE
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05954" , @HStmt_W05954 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLVTARYN","W05954","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05954) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
               cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'CL' and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
               cmdbuf = cmdbuf + "   "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05954,cmdbuf)
               THISFORM.GX_DB_BindColsW05954_01 ()
               THISFORM.GX_DB_BindParmW05954_01 ()
            ENDIF
            AuxAV8Emprcod = THISFORM.AV8Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05954,1,@AuxAV8Emprcod,0)
            THISFORM.AV8Emprcod = AuxAV8Emprcod
            AuxAV26Clides = THISFORM.AV26Clides
            THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05954,2,@AuxAV26Clides,0)
            THISFORM.AV26Clides = AuxAV26Clides
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05954) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W05954 = Gx_err
            THISFORM.GX_DB_GetW05954_01 ()
            DO WHILE THISFORM.W05954 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W05954_2EmpCod
               THISFORM.A150EntGru = THISFORM.Buf_W05954_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W05954_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W05954_153EntRaz
               THISFORM.AV43Cliraz = THISFORM.A153EntRaz
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05954) ,  ,  ,  , CS_SQLSRV ,  )
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

