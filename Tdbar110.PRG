               Gx_err = GX_DB_SetLong( HStmt_T00256,6,@AuxA251APCodP,0)
               THISFORM.A251APCodP = AuxA251APCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00256) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00256 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00256) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00257" , @HStmt_T00257 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBAR110","T00257","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00257) ,  ,  ,  , CS_SQLSRV , 0 )
