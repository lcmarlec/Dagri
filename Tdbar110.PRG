               ENDDO
               THISFORM.T00257 = Gx_err
               THISFORM.T00252 = iif( THISFORM.T00257 = 0 , 104 , THISFORM.T00257 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00257) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
