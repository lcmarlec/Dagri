               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00252) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00252 = Gx_err
            THISFORM.GX_DB_GetT00252_01 ()
            IF .NOT. THISFORM.T00252 <> 103
               DO GX_ERRMW WITH "DBAR1100 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00252 = 101 .OR. THISFORM.Z252APCodA <> THISFORM.Buf_T00252_252APCodAxP
               DO GX_ERRMW WITH "DBAR1100 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00255" , @HStmt_T00255 )
