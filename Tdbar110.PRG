                  IF GX_MVErr = 0
                     GX_MVErr = THISFORM. cCT25A251 .MV( 6 )
                  ENDIF
               ENDIF
            OTHERWISE
               THISFORM.LockScreen = .F.
               RETURN
         ENDCASE
         IF GX_MVErr != 0
            IF (! GX_1stLvl .and. gxO_Rec != 0) .or. (GX_1stLvl .and. gxO_Rec > 0)
               IF gxO_Rec != 0
