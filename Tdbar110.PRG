      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 22
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT25A250 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 22
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA250APCodA = THISFORM.A250APCodA
                  Gx_err = GX_DB_SetLong( HStmt_T00253,1,@AuxA250APCodA,0)
                  THISFORM.A250APCodA = AuxA250APCodA
                  AuxA251APCodP = THISFORM.A251APCodP
                  Gx_err = GX_DB_SetLong( HStmt_T00253,2,@AuxA251APCodP,0)
                  THISFORM.A251APCodP = AuxA251APCodP
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00253) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00253 = Gx_err
                  THISFORM.GX_DB_GetT00253_01 ()
                  THISFORM. cCT25A251 . ZM0P22 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0P22 ()
               THISFORM. cCT25A251 . ZM0P22 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0P22 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT25A253 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0P22 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0P22 ()
                  RETURN
               ENDIF
               THISFORM.cCT25A251.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00253) , "TDBAR110" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00252) , "TDBAR110" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT25A253 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT25A250 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

