      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00254" , @HStmt_T00254 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBAR110","T00254","",GX_CURSOR_TYPE_READONLY,@HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [APCodArt], [APCodPro], [APCodAxP], [APPrecxP], [APFamCod], [APFamSub] FROM "
            cmdbuf = cmdbuf + "  [DBAR1100] (FASTFIRSTROW NOLOCK) WHERE [APCodArt] >= ? and [APCodPro] >= ? ORDER "
            cmdbuf = cmdbuf + "  BY [APCodArt], [APCodPro]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00254,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00254,100)
            THISFORM.GX_DB_BindColsT00254_01 ()
            THISFORM.GX_DB_BindParmT00254_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A250APCodA = 0
                  THISFORM.A251APCodP = 0
               ENDIF
               AuxA250APCodA = THISFORM.A250APCodA
               Gx_err = GX_DB_SetLong( HStmt_T00254,1,@AuxA250APCodA,0)
               THISFORM.A250APCodA = AuxA250APCodA
               AuxA251APCodP = THISFORM.A251APCodP
               Gx_err = GX_DB_SetLong( HStmt_T00254,2,@AuxA251APCodP,0)
               THISFORM.A251APCodP = AuxA251APCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00254 = Gx_err
               THISFORM.GX_DB_GetT00254_01 ()
               Gx_fcond = THISFORM.T00254 <> 101
            CASE GXOP = 2 && Next record
               M251APCodP = THISFORM.A251APCodP
               THISFORM.A251APCodP = 0
               AuxA250APCodA = THISFORM.A250APCodA
               Gx_err = GX_DB_SetLong( HStmt_T00254,1,@AuxA250APCodA,0)
               THISFORM.A250APCodA = AuxA250APCodA
               AuxA251APCodP = THISFORM.A251APCodP
               Gx_err = GX_DB_SetLong( HStmt_T00254,2,@AuxA251APCodP,0)
               THISFORM.A251APCodP = AuxA251APCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00254 = Gx_err
               THISFORM.GX_DB_GetT00254_01 ()
               THISFORM.A251APCodP = M251APCodP
               DO WHILE THISFORM.T00254 = 0 .AND. THISFORM.A250APCodA >= THISFORM.Buf_T00254_250APCodArt .AND. THISFORM.A251APCodP >= THISFORM.Buf_T00254_251APCodPro
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00254 = Gx_err
                  THISFORM.GX_DB_GetT00254_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00254 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A250APCodA = 0
               THISFORM.A251APCodP = 0
               AuxA250APCodA = THISFORM.A250APCodA
               Gx_err = GX_DB_SetLong( HStmt_T00254,1,@AuxA250APCodA,0)
               THISFORM.A250APCodA = AuxA250APCodA
               AuxA251APCodP = THISFORM.A251APCodP
               Gx_err = GX_DB_SetLong( HStmt_T00254,2,@AuxA251APCodP,0)
               THISFORM.A251APCodP = AuxA251APCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00254 = Gx_err
               THISFORM.GX_DB_GetT00254_01 ()
               DO WHILE THISFORM.T00254 = 0
                  THISFORM.A250APCodA = THISFORM.Buf_T00254_250APCodArt
                  THISFORM.A251APCodP = THISFORM.Buf_T00254_251APCodPro
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00254 = Gx_err
                  THISFORM.GX_DB_GetT00254_01 ()
               ENDDO
               AuxA250APCodA = THISFORM.A250APCodA
               Gx_err = GX_DB_SetLong( HStmt_T00254,1,@AuxA250APCodA,0)
               THISFORM.A250APCodA = AuxA250APCodA
               AuxA251APCodP = THISFORM.A251APCodP
               Gx_err = GX_DB_SetLong( HStmt_T00254,2,@AuxA251APCodP,0)
               THISFORM.A251APCodP = AuxA251APCodP
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00254) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00254 = Gx_err
               THISFORM.GX_DB_GetT00254_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A250APCodA = THISFORM.Buf_T00254_250APCodArt
               THISFORM.A251APCodP = THISFORM.Buf_T00254_251APCodPro
               THISFORM.A252APCodA = THISFORM.Buf_T00254_252APCodAxP
               THISFORM.A253APPrec = THISFORM.Buf_T00254_253APPrecxP
               THISFORM.A254APFamC = THISFORM.Buf_T00254_254APFamCod
               THISFORM.A255APFamS = THISFORM.Buf_T00254_255APFamSub
         ENDCASE
         Gx_fcond = THISFORM.T00254 <> 101 .AND. THISFORM.T00254 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

