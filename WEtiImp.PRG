      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09772" , @HStmt_W09772 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WETIIMP","W09772","",GX_CURSOR_TYPE_READONLY,@HStmt_W09772) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[FamCod], T1.[FamSubCod], T1.[EtADoc], T1.[EtACnt], T2.[ArtEtiTam], T1.[EtAVenc], "
                  cmdbuf = cmdbuf + "  T1.[EtALote], T1.[EtaElab], T2.[ArtDsc], T1.[ArtCod], T1.[EtALin], T1.[LiPrCod], "
                  cmdbuf = cmdbuf + "  T3.[LiPrDsc], T1.[EtAFch], T1.[EmpCod] FROM (([ETIART1] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [LIPROD] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[LiPrCod] = T1.[LiPrCod]) WHERE "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] = ? and T1.[EtAFch] >= ? ORDER BY T1.[EmpCod], T1.[EtAFch], T1.[LiPrCod], "
                  cmdbuf = cmdbuf + "  T1.[EtALin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09772,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09772,14)
                  THISFORM.GX_DB_BindColsW09772_01 ()
                  THISFORM.GX_DB_BindParmW09772_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09772,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV17Fecdes = THISFORM.AV17Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09772,2,@AuxAV17Fecdes,0)
               THISFORM.AV17Fecdes = AuxAV17Fecdes
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09772) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09772 = Gx_err
               THISFORM.GX_DB_GetW09772_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WEtiImp"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09772 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09772) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09772 = Gx_err
                  THISFORM.GX_DB_GetW09772_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09772 <> 101
               BRKVR52 = .F.
               THISFORM.A3FamCod = THISFORM.Buf_W09772_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W09772_4FamSubCod
               THISFORM.A2975EtADo = THISFORM.Buf_W09772_2975EtADoc
               THISFORM.A2974EtACn = THISFORM.Buf_W09772_2974EtACnt
               THISFORM.A2982ArtEt = THISFORM.Buf_W09772_2982ArtEtiTam
               THISFORM.A2973EtAVe = THISFORM.Buf_W09772_2973EtAVenc
               THISFORM.A2972EtALo = THISFORM.Buf_W09772_2972EtALote
               THISFORM.A2971EtaEl = THISFORM.Buf_W09772_2971EtaElab
               THISFORM.A6ArtDsc = THISFORM.Buf_W09772_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W09772_5ArtCod
               THISFORM.A2970EtALi = THISFORM.Buf_W09772_2970EtALin
               THISFORM.A2867LiPrC = THISFORM.Buf_W09772_2867LiPrCod
               THISFORM.A2868LiPrD = THISFORM.Buf_W09772_2868LiPrDsc
               THISFORM.A2969EtAFc = THISFORM.Buf_W09772_2969EtAFch
               THISFORM.A2EmpCod = THISFORM.Buf_W09772_2EmpCod
               THISFORM.A2982ArtEt = THISFORM.Buf_W09772_2982ArtEtiTam
               THISFORM.A6ArtDsc = THISFORM.Buf_W09772_6ArtDsc
               THISFORM.A2868LiPrD = THISFORM.Buf_W09772_2868LiPrDsc
               THISFORM.VEVR52976 ( THISFORM.A2EmpCod , THISFORM.A2969EtAFc , THISFORM.A2867LiPrC , THISFORM.A2970EtALi )
               GX_SFLOAD = 0
               THISFORM.U16VR52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09772) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09772 = Gx_err
               THISFORM.GX_DB_GetW09772_01 ()
            ENDDO
         ENDIF
