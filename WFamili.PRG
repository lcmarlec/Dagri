      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00602" , @HStmt_W00602 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFAMILI","W00602","",GX_CURSOR_TYPE_READONLY,@HStmt_W00602) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [FamDsc], [FamCod] FROM [FAMILS] (FASTFIRSTROW NOLOCK) WHERE [FamDsc] like "
                  cmdbuf = cmdbuf + "  ? ORDER BY [FamDsc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00602,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00602,15)
                  THISFORM.GX_DB_BindColsW00602_01 ()
                  THISFORM.GX_DB_BindParmW00602_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00602,1,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00602 = Gx_err
               THISFORM.GX_DB_GetW00602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WFamili"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00602 = Gx_err
                  THISFORM.GX_DB_GetW00602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00602 <> 101
               BRKV1O2 = .F.
               THISFORM.A15FamDsc = THISFORM.Buf_W00602_15FamDsc
               THISFORM.A3FamCod = THISFORM.Buf_W00602_3FamCod
               GX_SFLOAD = 0
               THISFORM.U19V1O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00602 = Gx_err
               THISFORM.GX_DB_GetW00602_01 ()
            ENDDO
         ENDIF
      ENDPROC
