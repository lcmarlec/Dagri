      PROCEDURE CreateTemp
         LOCAL SCW1286S16
         SCW1286S16 = ""
         IF USED( "SCW1286S16" )
            SELECT SCW1286S16
            SCW1286S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1286S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA966RutCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV21Chfco"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV22Chfno"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV27Pedfc"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2EmpCod"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1286S16 = GETE('z:\temp') + '\' + SCW1286S16
            ENDIF
            CREATE DBF (SCW1286S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1286S16) EXCLUSIVE ALIAS SCW1286S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1286S16
         THIS.GX_SfAlias = "SCW1286S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12862" , @HStmt_W12862 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRUTSIND","W12862","",GX_CURSOR_TYPE_READONLY,@HStmt_W12862) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[ChfNom] AS RutChfNom, T1.[EmpCod], T1.[RutCod], T1.[RutChfCod] AS RutChfCod "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[ChfCod] = T1.[RutChfCod]) ORDER BY T1.[EmpCod], T1.[RutCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12862,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12862,14)
                  THISFORM.GX_DB_BindColsW12862_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12862) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12862 = Gx_err
               THISFORM.GX_DB_GetW12862_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV30Pgmnam = "WRutSinD"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12862 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12862 <> 101
               BRKVZQ2 = .F.
               THISFORM.AV21Chfcod = 0
               THISFORM.AV22Chfnom = SPACE(40)
               THISFORM.A1217RutCh = THISFORM.Buf_W12862_1217RutChfNom
               THISFORM.A2EmpCod = THISFORM.Buf_W12862_2EmpCod
               THISFORM.A966RutCod = THISFORM.Buf_W12862_966RutCod
               THISFORM.A1216RutCh = THISFORM.Buf_W12862_1216RutChfCod
               THISFORM.A1217RutCh = THISFORM.Buf_W12862_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U13VZQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKVZQ2
                  BRKVZQ2 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12862) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12862 = Gx_err
                  THISFORM.GX_DB_GetW12862_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
