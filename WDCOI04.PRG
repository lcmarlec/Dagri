      ***********************
      PROCEDURE U11V112
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "START" )
         * Start Routine
         THISFORM.AV15Totalp = 0
         THISFORM.AV21Totala = THISFORM.AV16Totald - THISFORM.AV20Totalg - THISFORM.AV27Retib - THISFORM.AV28Impiva - THISFORM.AV29Impsus - THISFORM.AV31Imp742 - THISFORM.AV33Ret316 - THISFORM.AV34Retibm - THISFORM.AV35Retcab - THISFORM.AV36Retibl + THISFORM.AV40Impiba
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV7Emprcod
         Aux1 = THISFORM.AV8Emprnom
         DO RLeeEmp WITH Aux0 , Aux1
         THISFORM.AV7Emprcod = Aux0
         THISFORM.AV8Emprnom = Aux1
         THISFORM. cCW37S16 .RestoreGridPos()
         GX_rploop = .T.
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV7Emprcod
         Aux3 = THISFORM.AV37Parval
         DO RParam WITH Aux0 , "CHEQELEC" , "MEDIO" , Aux3
         THISFORM.AV7Emprcod = Aux0
         THISFORM.AV37Parval = Aux3
         THISFORM. cCW37S16 .RestoreGridPos()
         GX_rploop = .T.
         THISFORM.AV38Chelec = val( THISFORM.AV37Parval )
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00373" , @HStmt_W00373 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCOI04","W00373","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00373) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00373,cmdbuf)
            THISFORM.GX_DB_BindColsW00373_01 ()
            THISFORM.GX_DB_BindParmW00373_01 ()
         ENDIF
         AuxAV7Emprcod = THISFORM.AV7Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00373,1,@AuxAV7Emprcod,0)
         THISFORM.AV7Emprcod = AuxAV7Emprcod
         AuxAV25Entgru = THISFORM.AV25Entgru
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00373,2,AuxAV25Entgru,2,0)
         THISFORM.AV25Entgru = AuxAV25Entgru
         AuxAV10Entcod = THISFORM.AV10Entcod
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00373,3,@AuxAV10Entcod,0)
         THISFORM.AV10Entcod = AuxAV10Entcod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00373) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00373 = Gx_err
         THISFORM.GX_DB_GetW00373_01 ()
         DO WHILE THISFORM.W00373 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W00373_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W00373_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W00373_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W00373_153EntRaz
            THISFORM.AV11Entraz = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
