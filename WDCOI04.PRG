      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00372" , @HStmt_W00372 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCOI04","W00372","",GX_CURSOR_TYPE_READONLY,@HStmt_W00372) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[TTesNro], T1.[TTesNroSub], T1.[TTesNroI], T1.[TTesCotImp], "
                  cmdbuf = cmdbuf + "  T4.[McoCta], T4.[McoBco], T1.[TTesLin], T1.[TTesModif], T1.[TTesMonCod] AS TTesMonCod, "
                  cmdbuf = cmdbuf + "  T2.[MonSim] AS TTesMonSim, T1.[TTesImp], T1.[TTesFchDeb], T1.[TTesBcoCta], T3.[BcoDsc] "
                  cmdbuf = cmdbuf + "  AS TTesBcoDsc, T1.[TTesBcoCod] AS TTesBcoCod, T4.[MCoDsc] AS TTesMedDsc, T1.[TTesMedCod] "
                  cmdbuf = cmdbuf + "  AS TTesMedCod FROM ((([TTESCYP1] T1 (NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) ON T2.[Moncod] "
                  cmdbuf = cmdbuf + "  = T1.[TTesMonCod]) LEFT JOIN [BANCOS] T3 (NOLOCK) ON T3.[BcoCod] = T1.[TTesBcoCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [MEDCOB] T4 (NOLOCK) ON T4.[MCoCod] = T1.[TTesMedCod]) WHERE T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[TTesNroI] = ? ORDER BY T1.[EmpCod], T1.[TTesNroI], T1.[TTesLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00372,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00372,9)
                  THISFORM.GX_DB_BindColsW00372_01 ()
                  THISFORM.GX_DB_BindParmW00372_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00372,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV17Nroint = THISFORM.AV17Nroint
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00372,2,@AuxAV17Nroint,0)
               THISFORM.AV17Nroint = AuxAV17Nroint
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00372 = Gx_err
               THISFORM.GX_DB_GetW00372_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV49Pgmnam = "WDCOI04"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00372 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00372) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00372 = Gx_err
                  THISFORM.GX_DB_GetW00372_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00372 <> 101
               BRKV112 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W00372_2EmpCod
               THISFORM.A1020TTesN = THISFORM.Buf_W00372_1020TTesNro
               THISFORM.A1021TTesN = THISFORM.Buf_W00372_1021TTesNroSub
               THISFORM.A1011TTesN = THISFORM.Buf_W00372_1011TTesNroI
               THISFORM.A1035TTesC = THISFORM.Buf_W00372_1035TTesCotImp
               THISFORM.A624McoCta = THISFORM.Buf_W00372_624McoCta
               THISFORM.A621McoBco = THISFORM.Buf_W00372_621McoBco
               THISFORM.A1012TTesL = THISFORM.Buf_W00372_1012TTesLin
               THISFORM.A3460TTesM = THISFORM.Buf_W00372_3460TTesModif
               THISFORM.A1032TTesM = THISFORM.Buf_W00372_1032TTesMonCod
               THISFORM.A1034TTesM = THISFORM.Buf_W00372_1034TTesMonSim
               THISFORM.A1022TTesI = THISFORM.Buf_W00372_1022TTesImp
               THISFORM.A1023TTesF = THISFORM.Buf_W00372_1023TTesFchDeb
               THISFORM.A1019TTesB = THISFORM.Buf_W00372_1019TTesBcoCta
               THISFORM.A1018TTesB = THISFORM.Buf_W00372_1018TTesBcoDsc
               THISFORM.A1017TTesB = THISFORM.Buf_W00372_1017TTesBcoCod
               THISFORM.A1016TTesM = THISFORM.Buf_W00372_1016TTesMedDsc
               THISFORM.A1015TTesM = THISFORM.Buf_W00372_1015TTesMedCod
               THISFORM.A1034TTesM = THISFORM.Buf_W00372_1034TTesMonSim
               THISFORM.A1018TTesB = THISFORM.Buf_W00372_1018TTesBcoDsc
               THISFORM.A624McoCta = THISFORM.Buf_W00372_624McoCta
               THISFORM.A621McoBco = THISFORM.Buf_W00372_621McoBco
               THISFORM.A1016TTesM = THISFORM.Buf_W00372_1016TTesMedDsc
               GX_SFLOAD = 0
               THISFORM.U17V112 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00372 = Gx_err
               THISFORM.GX_DB_GetW00372_01 ()
            ENDDO
         ENDIF
      ENDPROC
