      PROCEDURE CreateTemp
         LOCAL SCW1027S20
         SCW1027S20 = ""
         IF USED( "SCW1027S20" )
            SELECT SCW1027S20
            SCW1027S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1027S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA561TraCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2266CAuC"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2272AusF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2274AusC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA2275AusV"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "sA2279Aust"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1027S20 = GETE('z:\temp') + '\' + SCW1027S20
            ENDIF
            CREATE DBF (SCW1027S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1027S20) EXCLUSIVE ALIAS SCW1027S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1027S20
         THIS.GX_SfAlias = "SCW1027S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10272" , @HStmt_W10272 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0771","W10272","",GX_CURSOR_TYPE_READONLY,@HStmt_W10272) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [Austem], [AusVal], [AusCnt], [AusFch], [CAuCod], [TraCod] FROM "
                  cmdbuf = cmdbuf + "  [AUSENTIS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [TraCod] >= ?) AND ([CAuCod] "
                  cmdbuf = cmdbuf + "  like ?) AND ([AusFch] >= ?) AND ([AusCnt] >= ?) AND ([AusVal] >= ?) AND ([Austem] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [TraCod], [CAuCod], [AusFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10272,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10272,9)
                  THISFORM.GX_DB_BindColsW10272_01 ()
                  THISFORM.GX_DB_BindParmW10272_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10272,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C561 = THISFORM.AV5C561
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10272,2,@AuxAV5C561,0)
               THISFORM.AV5C561 = AuxAV5C561
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10272,3,PADR( TRIM(THISFORM.AV6C2266),4, '%'),LEN(PADR( TRIM(THISFORM.AV6C2266),4, '%')),0)
               AuxAV7C2272 = THISFORM.AV7C2272
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10272,4,@AuxAV7C2272,0)
               THISFORM.AV7C2272 = AuxAV7C2272
               AuxAV8C2274 = THISFORM.AV8C2274
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10272,5,@AuxAV8C2274,0)
               THISFORM.AV8C2274 = AuxAV8C2274
               AuxAV9C2275 = THISFORM.AV9C2275
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W10272,6,@AuxAV9C2275,0)
               THISFORM.AV9C2275 = AuxAV9C2275
               AuxAV10C2279 = THISFORM.AV10C2279
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10272,7,@AuxAV10C2279,0)
               THISFORM.AV10C2279 = AuxAV10C2279
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10272 = Gx_err
               THISFORM.GX_DB_GetW10272_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10272 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10272) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10272 = Gx_err
                  THISFORM.GX_DB_GetW10272_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10272 <> 101
               BRKVSJ2 = .F.
               THISFORM.A2279Auste = THISFORM.Buf_W10272_2279Austem
               THISFORM.A2275AusVa = THISFORM.Buf_W10272_2275AusVal
               THISFORM.A2274AusCn = THISFORM.Buf_W10272_2274AusCnt
               THISFORM.A2272AusFc = THISFORM.Buf_W10272_2272AusFch
               THISFORM.A2266CAuCo = THISFORM.Buf_W10272_2266CAuCod
               THISFORM.A561TraCod = THISFORM.Buf_W10272_561TraCod
               GX_SFLOAD = 0
               THISFORM.U12VSJ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10272 = Gx_err
               THISFORM.GX_DB_GetW10272_01 ()
            ENDDO
         ENDIF
      ENDPROC
