               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02972 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02972) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02972 = Gx_err
                  THISFORM.GX_DB_GetW02972_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02972 <> 101
               BRKV892 = .F.
               THISFORM.AV25Fam = 0
               THISFORM.AV26Famsub = 0
               THISFORM.AV27Artcod = 0
               THISFORM.AV28Artdsc = SPACE(50)
               THISFORM.AV45Rvtcnt = 0.0000
               THISFORM.AV29Rvtcnt = 0.0000
               THISFORM.A912RVtEnt = THISFORM.Buf_W02972_912RVtEntLgCo
               THISFORM.A908RVtNro = THISFORM.Buf_W02972_908RVtNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W02972_2EmpCod
               THISFORM.A921RVtPed = THISFORM.Buf_W02972_921RVtPedNro
               THISFORM.A909RVtEnt = THISFORM.Buf_W02972_909RVtEntGruT
               THISFORM.A2822Entlg = THISFORM.Buf_W02972_2822EntlgObs
               THISFORM.A924RvtOrd = THISFORM.Buf_W02972_924RvtOrden
               THISFORM.A2498RvtOr = THISFORM.Buf_W02972_2498RvtOrd12
               THISFORM.A925RvtPid = THISFORM.Buf_W02972_925RvtPidio
               THISFORM.A922RVtObs = THISFORM.Buf_W02972_922RVtObs
               THISFORM.A926RvtIng = THISFORM.Buf_W02972_926RvtIngreso
               THISFORM.A927RvtImp = THISFORM.Buf_W02972_927RvtImprimi
               THISFORM.A178EntLgD = THISFORM.Buf_W02972_178EntLgDom
               THISFORM.A917RVtEst = THISFORM.Buf_W02972_917RVtEst
               THISFORM.A915RVtFch = THISFORM.Buf_W02972_915RVtFch
               THISFORM.A911RVtEnt = THISFORM.Buf_W02972_911RVtEntRaz
               THISFORM.A910RVtEnt = THISFORM.Buf_W02972_910RVtEntCod
               THISFORM.A914RVtNro = THISFORM.Buf_W02972_914RVtNro
               THISFORM.A913RVtSuc = THISFORM.Buf_W02972_913RVtSuc
               THISFORM.A911RVtEnt = THISFORM.Buf_W02972_911RVtEntRaz
               THISFORM.A2822Entlg = THISFORM.Buf_W02972_2822EntlgObs
               THISFORM.A178EntLgD = THISFORM.Buf_W02972_178EntLgDom
               GX_SFLOAD = 0
               THISFORM.U18V892 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
      ENDPROC
