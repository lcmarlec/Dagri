      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01982" , @HStmt_T01982 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCCOBRAN","T01982","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01982) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod] FROM [EMPRES] (UPDLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01982,cmdbuf)
            THISFORM.GX_DB_BindColsT01982_01 ()
            THISFORM.GX_DB_BindParmT01982_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01983" , @HStmt_T01983 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCCOBRAN","T01983","",GX_CURSOR_TYPE_READONLY,@HStmt_T01983) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod] FROM [EMPRES] (NOLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01983,cmdbuf)
            THISFORM.GX_DB_BindColsT01983_01 ()
            THISFORM.GX_DB_BindParmT01983_01 ()
         ENDIF
         GXTB.ShowMode()
      ENDPROC
      PROCEDURE Init
         GXForm::Init
      ENDPROC
      PROCEDURE Destroy
         THISFORM.ResetFKeys()
      ENDPROC
      PROCEDURE Activate
         IF THISFORM.GX_init_activate
            IF THISFORM.Gx_mode <> "DSP"
            ENDIF
            IF TYPE( "OCT198" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            THISFORM.SetLevel( 53 )
            THISFORM.GX_last_fld_lvl = 53
            IF ! THISFORM.InitLevels( 53 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            IF THISFORM. cCT198A2 .MV(5) != 0
               THISFORM.SaveMode( "INS" ,"")
            ELSE
               THISFORM.LoadObj(4)
            ENDIF
            GXForm::Activate
         ENDIF
         THISFORM.ClearFrmTBar
         THISFORM.GxMenuBar.Clear
         THISFORM.SetMBTimer()
         gxMB = "OFF"
         THISFORM.GxMenuBar.Set(gxMB)
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         THISFORM.SetFKeys()
         DO CASE
            CASE THISFORM.GX_Curr_Level = 53
               THISFORM.SaveMode( THIS.GX_mode ,"")
         ENDCASE
         GXTB.ShowMode()
         GXTB.Clear()
         GXTB.ShowSB()
         IF THISFORM.Gx_Mode = "DSP"
            THISFORM. cCT198R7 .Enabled = .F.
            THISFORM. cCT198R6 .Enabled = .F.
            THISFORM. cCT198V7 .Enabled = .F.
            THISFORM. cCT198V9 .Enabled = .F.
            THISFORM. cCT198V8 .Enabled = .F.
            THISFORM. cCT198B2 .Enabled = .F.
         ENDIF
      ENDPROC
      PROCEDURE GotFocus
         THISFORM.SetFKeys()
      ENDPROC
      PROCEDURE LoadMenuBar
         THISFORM.GxMenuBar.Clear
         THISFORM.ClearFrmTBar
         RELEASE GX_FrmTBar
         THISFORM.GxMenuBar.Set("Off")
      ENDPROC
