               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03802,6,PADR( TRIM(THISFORM.AV10C1227),30, '%'),LEN(PADR( TRIM(THISFORM.AV10C1227),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03802,7,PADR( TRIM(THISFORM.AV11C1228),40, '%'),LEN(PADR( TRIM(THISFORM.AV11C1228),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03802 = Gx_err
               THISFORM.GX_DB_GetW03802_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03802 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03802) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03802 = Gx_err
                  THISFORM.GX_DB_GetW03802_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03802 <> 101
               BRKVAK2 = .F.
               THISFORM.A1226ExtMo = THISFORM.Buf_W03802_1226ExtMotCod
               THISFORM.A1227ExtMo = THISFORM.Buf_W03802_1227ExtMotDsc
               THISFORM.A1228ExtOb = THISFORM.Buf_W03802_1228ExtObs
               THISFORM.A1225ExtFc = THISFORM.Buf_W03802_1225ExtFch
               THISFORM.A1224ExtNr = THISFORM.Buf_W03802_1224ExtNroT
               THISFORM.A1223ExtNr = THISFORM.Buf_W03802_1223ExtNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W03802_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VAK2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03802) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03802 = Gx_err
               THISFORM.GX_DB_GetW03802_01 ()
            ENDDO
         ENDIF
      ENDPROC
