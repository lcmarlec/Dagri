               THISFORM.AV6C2122 = AuxAV6C2122
               AuxAV7C2123 = THISFORM.AV7C2123
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07132,6,@AuxAV7C2123,0)
               THISFORM.AV7C2123 = AuxAV7C2123
               AuxAV8C2124 = THISFORM.AV8C2124
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07132,7,@AuxAV8C2124,0)
               THISFORM.AV8C2124 = AuxAV8C2124
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07132 = Gx_err
               THISFORM.GX_DB_GetW07132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07132 = Gx_err
                  THISFORM.GX_DB_GetW07132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07132 <> 101
               BRKVJT2 = .F.
               THISFORM.A2124xLpvR = THISFORM.Buf_W07132_2124xLpvRet
               THISFORM.A2123xLpvR = THISFORM.Buf_W07132_2123xLpvRet2
               THISFORM.A2122xLpvR = THISFORM.Buf_W07132_2122xLpvRet1
               THISFORM.A2105xLpvF = THISFORM.Buf_W07132_2105xLpvFch
               GX_SFLOAD = 0
               THISFORM.U12VJT2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07132 = Gx_err
               THISFORM.GX_DB_GetW07132_01 ()
            ENDDO
         ENDIF
      ENDPROC
