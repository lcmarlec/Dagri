      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09962" , @HStmt_W09962 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09M2","W09962","",GX_CURSOR_TYPE_READONLY,@HStmt_W09962) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PaiCod], [PciCod], [EmpCod], [EntCui], [CMAnio] FROM [CM052] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE [EmpCod] = ? and [EntCui] = ? and [CMAnio] >= ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [EntCui], [CMAnio]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09962,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09962,9)
                  THISFORM.GX_DB_BindColsW09962_01 ()
                  THISFORM.GX_DB_BindParmW09962_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09962,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09962,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               AuxAV5C3011 = THISFORM.AV5C3011
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09962,3,@AuxAV5C3011,0)
               THISFORM.AV5C3011 = AuxAV5C3011
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09962) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09962 = Gx_err
               THISFORM.GX_DB_GetW09962_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09962 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09962) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09962 = Gx_err
                  THISFORM.GX_DB_GetW09962_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09962 <> 101
               BRKVRO2 = .F.
               THISFORM.A3011CMAni = THISFORM.Buf_W09962_3011CMAnio
               GX_SFLOAD = 0
               THISFORM.U12VRO2 ()
               THIS.GX_CUPOS = 0
