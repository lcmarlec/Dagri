            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2EmpCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW833S11 = GETE('z:\temp') + '\' + SCW833S11
            ENDIF
            CREATE DBF (SCW833S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW833S11) EXCLUSIVE ALIAS SCW833S11
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW833S11
         THIS.GX_SfAlias = "SCW833S11"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08332" , @HStmt_W08332 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WENVIOS","W08332","",GX_CURSOR_TYPE_READONLY,@HStmt_W08332) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RutChfCod] AS RutChfCod, T1.[RutCod], T2.[ChfNom] AS RutChfNom "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[ChfCod] = T1.[RutChfCod]) ORDER BY T1.[EmpCod], T1.[RutCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08332,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08332,11)
                  THISFORM.GX_DB_BindColsW08332_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08332 = Gx_err
               THISFORM.GX_DB_GetW08332_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WEnvios"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08332 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08332 <> 101
               BRKVN52 = .F.
               THISFORM.AV21Chfcod = 0
               THISFORM.AV22Chfnom = SPACE(40)
               THISFORM.A2EmpCod = THISFORM.Buf_W08332_2EmpCod
               THISFORM.A1216RutCh = THISFORM.Buf_W08332_1216RutChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W08332_966RutCod
               THISFORM.A1217RutCh = THISFORM.Buf_W08332_1217RutChfNom
               THISFORM.A1217RutCh = THISFORM.Buf_W08332_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U16VN52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKVN52
                  BRKVN52 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08332) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08332 = Gx_err
                  THISFORM.GX_DB_GetW08332_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         THISFORM.A2EmpCod = THISFORM.Buf_W08332_2EmpCod
         THISFORM.A1216RutCh = THISFORM.Buf_W08332_1216RutChfCod
