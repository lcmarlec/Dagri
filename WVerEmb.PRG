      PROCEDURE CreateTemp
         LOCAL SCW1068S13
         SCW1068S13 = ""
         IF USED( "SCW1068S13" )
            SELECT SCW1068S13
            SCW1068S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1068S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2516EmbR"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2514EmbF"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2515EmbO"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA93ChfNom"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2200acoN"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1068S13 = GETE('z:\temp') + '\' + SCW1068S13
            ENDIF
            CREATE DBF (SCW1068S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1068S13) EXCLUSIVE ALIAS SCW1068S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1068S13
         THIS.GX_SfAlias = "SCW1068S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10682" , @HStmt_W10682 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WVEREMB","W10682","",GX_CURSOR_TYPE_READONLY,@HStmt_W10682) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmbChfCod], T2.[ChfCod], T3.[RutCod], T3.[acoCod], T1.[EmpCod], T4.[acoNom], "
                  cmdbuf = cmdbuf + "  T2.[ChfNom], T1.[EmbOrd], T1.[EmbFch], T1.[EmbRutCod] FROM ((([EMBARQUE] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[ChfCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmbChfCod]) LEFT JOIN [RUTAS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[RutCod] = T1.[EmbRutCod]) LEFT JOIN [ACOM] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T4.[acoCod] = T3.[acoCod]) WHERE (T1.[EmpCod] = ? and T1.[EmbRutCod] >= ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[EmbFch] >= ?) ORDER BY T1.[EmpCod], T1.[EmbRutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10682,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10682,12)
                  THISFORM.GX_DB_BindColsW10682_01 ()
                  THISFORM.GX_DB_BindParmW10682_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10682,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV27Rutcod = THISFORM.AV27Rutcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10682,2,@AuxAV27Rutcod,0)
               THISFORM.AV27Rutcod = AuxAV27Rutcod
               AuxAV26Fecdes = THISFORM.AV26Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10682,3,@AuxAV26Fecdes,0)
               THISFORM.AV26Fecdes = AuxAV26Fecdes
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10682 = Gx_err
               THISFORM.GX_DB_GetW10682_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WVerEmb"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10682 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10682) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10682 = Gx_err
                  THISFORM.GX_DB_GetW10682_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10682 <> 101
               BRKVTO2 = .F.
               THISFORM.A2517EmbCh = THISFORM.Buf_W10682_2517EmbChfCod
               THISFORM.A92ChfCod = THISFORM.Buf_W10682_92ChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W10682_966RutCod
               THISFORM.A2199acoCo = THISFORM.Buf_W10682_2199acoCod
               THISFORM.A2EmpCod = THISFORM.Buf_W10682_2EmpCod
               THISFORM.A2200acoNo = THISFORM.Buf_W10682_2200acoNom
               THISFORM.A93ChfNom = THISFORM.Buf_W10682_93ChfNom
               THISFORM.A2515EmbOr = THISFORM.Buf_W10682_2515EmbOrd
               THISFORM.A2514EmbFc = THISFORM.Buf_W10682_2514EmbFch
               THISFORM.A2516EmbRu = THISFORM.Buf_W10682_2516EmbRutCod
               THISFORM.A93ChfNom = THISFORM.Buf_W10682_93ChfNom
               THISFORM.A2199acoCo = THISFORM.Buf_W10682_2199acoCod
               THISFORM.A2200acoNo = THISFORM.Buf_W10682_2200acoNom
               GX_SFLOAD = 0
               THISFORM.U15VTO2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10682 = Gx_err
               THISFORM.GX_DB_GetW10682_01 ()
            ENDDO
         ENDIF
      ENDPROC
