               THISFORM.W09882 = Gx_err
               THISFORM.GX_DB_GetW09882_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09882 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09882) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09882 = Gx_err
                  THISFORM.GX_DB_GetW09882_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09882 <> 101
               BRKVRG2 = .F.
               THISFORM.A2996EICoe = THISFORM.Buf_W09882_2996EICoef2
               THISFORM.A2995EICoe = THISFORM.Buf_W09882_2995EICoef1
               THISFORM.A2994EIBas = THISFORM.Buf_W09882_2994EIBase
               THISFORM.A2993EIDde = THISFORM.Buf_W09882_2993EIDde
               GX_SFLOAD = 0
               THISFORM.U12VRG2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09882) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09882 = Gx_err
               THISFORM.GX_DB_GetW09882_01 ()
            ENDDO
         ENDIF
      ENDPROC
