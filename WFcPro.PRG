         THISFORM.SetEvent( "'CIERRE'" )
         * 'CIERRE' Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07364" , @HStmt_W07364 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFCPRO","W07364","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W07364) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EmpVtaCie] FROM [EMPRES] (NOLOCK) WHERE [EmpCod] = ? ORDER BY [EmpCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07364,cmdbuf)
            THISFORM.GX_DB_BindColsW07364_01 ()
            THISFORM.GX_DB_BindParmW07364_01 ()
         ENDIF
         AuxAV7Emprcod = THISFORM.AV7Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07364,1,@AuxAV7Emprcod,0)
         THISFORM.AV7Emprcod = AuxAV7Emprcod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07364) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W07364 = Gx_err
         THISFORM.GX_DB_GetW07364_01 ()
         DO WHILE THISFORM.W07364 <> 101
            THISFORM.A1206EmpVt = THISFORM.Buf_W07364_1206EmpVtaCie
            THISFORM.AV36Empvta = THISFORM.A1206EmpVt
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W07364) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.EndEvent()
      ENDPROC

