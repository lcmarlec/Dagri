               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFCPRO","W07363","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W07363) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [RCVNroI], [RcVUsu], [RCVNroCli], [RcvFchCli] FROM [RECIBOS] (NOLOCK) "
               cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [RCVNroI] = ? ORDER BY [EmpCod], [RCVNroI]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07363,cmdbuf)
               THISFORM.GX_DB_BindColsW07363_01 ()
               THISFORM.GX_DB_BindParmW07363_01 ()
            ENDIF
            AuxA2EmpCod = THISFORM.A2EmpCod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07363,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA415DcVNro = THISFORM.A415DcVNro
            THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07363,2,@AuxA415DcVNro,0)
            THISFORM.A415DcVNro = AuxA415DcVNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07363) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W07363 = Gx_err
            THISFORM.GX_DB_GetW07363_01 ()
            DO WHILE THISFORM.W07363 <> 101
               THISFORM.A858RCVNro = THISFORM.Buf_W07363_858RCVNroI
               THISFORM.A1735RcVUs = THISFORM.Buf_W07363_1735RcVUsu
               THISFORM.A1198RCVNr = THISFORM.Buf_W07363_1198RCVNroCli
               THISFORM.A1213RcvFc = THISFORM.Buf_W07363_1213RcvFchCli
               THISFORM.AV32Rcvnro = THISFORM.A1198RCVNr
               THISFORM.AV33Rcvfch = THISFORM.A1213RcvFc
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W07363) ,  ,  ,  , CS_SQLSRV ,  )
         ENDIF
         IF THISFORM.cCW736S12 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW736S12 .GX_rec_loaded =  THISFORM.cCW736S12 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW736S12 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW736S12 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

