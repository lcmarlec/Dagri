               THISFORM.A2230DcvFc = THISFORM.Buf_W07362_2230DcvFchPro
               THISFORM.A418DcVEnt = THISFORM.Buf_W07362_418DcVEntRaz
               GX_SFLOAD = 0
               THISFORM.U17VKG2 ()
               THIS.GX_CUPOS = 0
               DO CASE
