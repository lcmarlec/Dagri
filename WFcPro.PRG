               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07362" , @HStmt_W07362 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFCPRO","W07362","",GX_CURSOR_TYPE_READONLY,@HStmt_W07362) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[DcVNroInt], T1.[DcVEst], T1.[DcVSer], T1.[DcVNro], T1.[DcVFch], "
                  cmdbuf = cmdbuf + "  T1.[DcVTip], T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVFCo], T1.[DcVFaturo], T1.[DcVTotSld], "
                  cmdbuf = cmdbuf + "  T1.[DcvEmbarqu], T1.[DcVTot], T2.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, "
                  cmdbuf = cmdbuf + "  T1.[DCVNroPro], T1.[DcvTipRed], T1.[DcvFchPro] FROM ([DCVENT] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[DcVEntGruT] AND T2.[EntCod] = T1.[DcVEntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[DcvFchPro] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[DcVEntCod] = ? or ? = 0) AND (T1.[DCVNroPro] = ? or ? = 0) AND (T1.[DcVTot] "
                  cmdbuf = cmdbuf + "  >= ? or ? = 0) AND (T1.[DcVTot] <= ? or ? = 0) AND (T1.[DcVEst] = 0) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[DcVFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07362,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07362,16)
                  THISFORM.GX_DB_BindColsW07362_01 ()
                  THISFORM.GX_DB_BindParmW07362_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07362,1,@AuxA2EmpCod,0)
