      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10392" , @HStmt_W10392 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLLEMVIS","W10392","",GX_CURSOR_TYPE_READONLY,@HStmt_W10392) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[UsuVisto], T1.[UsuCod], T3.[LLeMsj], T3.[LleFR], T2.[TraNom], "
                  cmdbuf = cmdbuf + "  T1.[TraCod], T1.[LLeFch] FROM (([LLEUSU] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EMPLEADO] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[TraCod] = T1.[TraCod]) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [LLEMPLEA] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[LLeFch] = T1.[LLeFch] "
                  cmdbuf = cmdbuf + "  AND T3.[TraCod] = T1.[TraCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[UsuCod] = ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[UsuVisto] = 0) ORDER BY T1.[EmpCod], T1.[LLeFch], T1.[TraCod], T1.[UsuCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10392,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10392,17)
                  THISFORM.GX_DB_BindColsW10392_01 ()
                  THISFORM.GX_DB_BindParmW10392_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10392,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV17Usuari = THISFORM.AV17Usuari
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10392,2,AuxAV17Usuari,10,0)
               THISFORM.AV17Usuari = AuxAV17Usuari
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10392) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10392 = Gx_err
               THISFORM.GX_DB_GetW10392_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WLLEmVis"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10392 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10392) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10392 = Gx_err
                  THISFORM.GX_DB_GetW10392_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10392 <> 101
               BRKVSV2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W10392_2EmpCod
               THISFORM.A3089UsuVi = THISFORM.Buf_W10392_3089UsuVisto
               THISFORM.A64UsuCod = THISFORM.Buf_W10392_64UsuCod
               THISFORM.A3086LLeMs = THISFORM.Buf_W10392_3086LLeMsj
               THISFORM.A3167LleFR = THISFORM.Buf_W10392_3167LleFR
               THISFORM.A564TraNom = THISFORM.Buf_W10392_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W10392_561TraCod
               THISFORM.A3083LLeFc = THISFORM.Buf_W10392_3083LLeFch
               THISFORM.A564TraNom = THISFORM.Buf_W10392_564TraNom
               THISFORM.A3086LLeMs = THISFORM.Buf_W10392_3086LLeMsj
               THISFORM.A3167LleFR = THISFORM.Buf_W10392_3167LleFR
               GX_SFLOAD = 0
               THISFORM.U17VSV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10392) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10392 = Gx_err
               THISFORM.GX_DB_GetW10392_01 ()
            ENDDO
         ENDIF
      ENDPROC
