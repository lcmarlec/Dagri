            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA2EmpCod"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 4
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1039S14 = GETE('z:\temp') + '\' + SCW1039S14
            ENDIF
            CREATE DBF (SCW1039S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1039S14) EXCLUSIVE ALIAS SCW1039S14
         ENDIF
