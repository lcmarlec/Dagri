                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPEDCCAE","W10782","",GX_CURSOR_TYPE_READONLY,@HStmt_W10782) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcCEst], T1.[EmpCod], T1.[DcCTip], T1.[EntGruTip], T1.[DcCNroInt], T1.[DcCTot], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz], T1.[EntCod], T1.[DcCNro], T1.[DcCSuc], T1.[DccSer], T1.[DccTipRed], "
                  cmdbuf = cmdbuf + "  T1.[DcCFec] FROM ([DCCOM] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[EntCod]) WHERE (T1.[EmpCod] = ? and T1.[DcCFec] >= ?) AND (T1.[EntCod] = ? "
                  cmdbuf = cmdbuf + "  or ? = 0) AND (T1.[DcCSuc] = ? or ? = 0) AND (T1.[DcCNro] = 0) AND (T1.[DcCTot] "
                  cmdbuf = cmdbuf + "  >= ? or ? = 0) AND (T1.[DcCTot] <= ? or ? = 0) AND (T1.[DcCEst] = 0) AND (T1.[DccTipRed] "
                  cmdbuf = cmdbuf + "  = ? or ? = 'TT') AND (SUBSTRING(T1.[DcCTip], 3, 1) = 'P') AND (T1.[DcCFec] <= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[DcCFec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10782,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10782,15)
                  THISFORM.GX_DB_BindColsW10782_01 ()
                  THISFORM.GX_DB_BindParmW10782_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10782,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV15Desfch = THISFORM.AV15Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10782,2,@AuxAV15Desfch,0)
