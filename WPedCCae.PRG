               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10782,12,AuxAV39Tipodo,2,0)
               THISFORM.AV39Tipodo = AuxAV39Tipodo
               AuxAV22Hasfch = THISFORM.AV22Hasfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10782,13,@AuxAV22Hasfch,0)
               THISFORM.AV22Hasfch = AuxAV22Hasfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10782) ,  ,  ,  , CS_SQLSRV ,  )
