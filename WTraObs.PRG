         REPLACE sA2571traf WITH gxDtTtoC(THISFORM.A2571trafc,8,8)
         REPLACE sA2572TraO WITH THISFORM.A2572TraOb
         REPLACE sA2575TraF WITH gxDtTtoC(THISFORM.A2575TraFc,8,8)
         REPLACE sA2573TraO WITH THISFORM.A2573TraOb
         REPLACE sA2574TraN WITH THISFORM.A2574TraNr
         REPLACE sA561TraCo WITH THISFORM.A561TraCod
         REPLACE sA2EmpCod WITH THISFORM.A2EmpCod
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A2571trafc = GXDTCTOT(sA2571traf)
         THISFORM.A2572TraOb = sA2572TraO
         THISFORM.A2575TraFc = GXDTCTOT(sA2575TraF)
         THISFORM.A2573TraOb = sA2573TraO
         THISFORM.A2574TraNr = sA2574TraN
         THISFORM.A561TraCod = sA561TraCo
         THISFORM.A2EmpCod = sA2EmpCod
      ENDPROC
      PROCEDURE LoadVarFromCtrl
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A2571trafc = CTOT("  /  /  ")
         THISFORM.A2572TraOb = SPACE(10)
         THISFORM.A2575TraFc = CTOT("  /  /  ")
         THISFORM.A2573TraOb = SPACE(1000)
         THISFORM.A2574TraNr = 0
         THISFORM.A561TraCod = 0
         THISFORM.A2EmpCod = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
      PROCEDURE BeforeRowChange
      ENDPROC
      PROCEDURE AfterRowChange
      ENDPROC
      PROCEDURE DblClick
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE Click
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE CallRefreshEvent
         THISFORM.cCW860S18.GXRefreshEvt ()
      ENDPROC
      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW860S18 .GX_SfAlias)
            GO TOP
            THISFORM.cCW860S18 .Refresh()
         ENDIF
         THISFORM. cCW860S18 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW860S18 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
