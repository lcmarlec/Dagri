            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WTRAOBS","W08603","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W08603) ,  ,  ,  , CS_SQLSRV ,  )
