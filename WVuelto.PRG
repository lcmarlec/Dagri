                  RETURN
               ENDIF
            OTHERWISE
               IF THISFORM.AV41Entciv <> 1
                  THISFORM.Gx_msg = "Ingresa $" + str( THISFORM.AV25Efecti , 9 , 2 ) + " Vuelto " + str( THISFORM.AV25Efecti - THISFORM.AV24Total , 9 , 2 )
                  THISFORM.Refresh()
                  Response = .T.
                  DO GX_CONFW WITH THISFORM.Gx_msg , Response
                  IF Response
                     THISFORM.AV26Flag = 1
                     THISFORM.ReleaseAll()
                     RETURN
                  ENDIF
               ELSE
                  THISFORM.AV26Flag = 1
                  THISFORM.ReleaseAll()
                  RETURN
               ENDIF
         ENDCASE
