               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T01602) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T01602 = Gx_err
            THISFORM.GX_DB_GetT01602_01 ()
            IF .NOT. THISFORM.T01602 <> 103
               DO GX_ERRMW WITH "CODPOS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T01602 = 101 .OR. THISFORM.Z1656CPPai <> THISFORM.Buf_T01602_1656CPPaiCod
               DO GX_ERRMW WITH "CODPOS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
