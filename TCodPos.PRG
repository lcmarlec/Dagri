               Gx_err = GX_DB_SetStr( HStmt_T01609,3,AuxA1653CPLoc,40,0)
               THISFORM.A1653CPLoc = AuxA1653CPLoc
               AuxA1658CPPci = THISFORM.A1658CPPci
               Gx_err = GX_DB_SetStr( HStmt_T01609,4,AuxA1658CPPci,4,0)
               THISFORM.A1658CPPci = AuxA1658CPPci
               AuxA1675CPPCo = THISFORM.A1675CPPCo
               Gx_err = GX_DB_SetStr( HStmt_T01609,5,AuxA1675CPPCo,1,0)
               THISFORM.A1675CPPCo = AuxA1675CPPCo
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01609,6,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1652CPCod = THISFORM.A1652CPCod
               Gx_err = GX_DB_SetStr( HStmt_T01609,7,AuxA1652CPCod,8,0)
               THISFORM.A1652CPCod = AuxA1652CPCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T01609) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T01609 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T01609) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
