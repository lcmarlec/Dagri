               ENDIF
               AuxA1656CPPai = THISFORM.A1656CPPai
               Gx_err = GX_DB_SetStr( HStmt_T01609,1,AuxA1656CPPai,4,0)
               THISFORM.A1656CPPai = AuxA1656CPPai
