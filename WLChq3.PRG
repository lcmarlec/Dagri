      ***********************
      PROCEDURE cCW70V12.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW70V12.ISVALID" )
         THISFORM.AV40GXLvl2 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00703" , @HStmt_W00703 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLCHQ3","W00703","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00703) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00703,cmdbuf)
            THISFORM.GX_DB_BindColsW00703_01 ()
            THISFORM.GX_DB_BindParmW00703_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00703,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV31Chqcli = THISFORM.AV31Chqcli
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00703,2,AuxAV31Chqcli,2,0)
         THISFORM.AV31Chqcli = AuxAV31Chqcli
         AuxAV12Despro = THISFORM.AV12Despro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00703,3,@AuxAV12Despro,0)
         THISFORM.AV12Despro = AuxAV12Despro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00703) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00703 = Gx_err
         THISFORM.GX_DB_GetW00703_01 ()
         DO WHILE THISFORM.W00703 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W00703_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W00703_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W00703_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W00703_153EntRaz
            THISFORM.AV40GXLvl2 = 1
            THISFORM.AV18Desraz = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00703) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV40GXLvl2 = 0
            IF THISFORM.AV12Despro = 0
               THISFORM.AV18Desraz = "Todos "
            ELSE
               THISFORM.AV18Desraz = "No Existe "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

