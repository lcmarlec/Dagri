***********************
PROCEDURE U11B12
***********************

   * 'DCCOM' Routine
   LEVEL5 = .T.
   DO GX_CSC01
   IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P03977" , @HStmt_P03977 )
      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PAJUANC","P03977","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P03977) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT [EmpCod], [DcCTip], [DccSer], [DcCSuc], [DcCNro], [DcCEst], [DcCNroInt] FROM "
      cmdbuf = cmdbuf + "  [DCCOM] (UPDLOCK) WHERE ([EmpCod] = ?) AND (([DcCTip] = 'AJUS') AND ([DccSer] = "
      cmdbuf = cmdbuf + "  'X') AND ([DcCSuc] = 0) AND ([DcCNro] = ?)) ORDER BY [EmpCod], [DcCNroInt]  "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_P03977,cmdbuf)
      GX_DB_BindColsP03977_01 ()
      GX_DB_BindParmP03977_01 ()
   ENDIF
   Gx_err = GX_DB_SetInt( HStmt_P03977,1,@AV10Emprco,0)
   Gx_err = GX_DB_SetLong( HStmt_P03977,2,@AV9Nrorcv,0)
   Gx_eop = 1
   DO WHILE Gx_eop != 0
      Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_P03977) ,  ,  ,  , CS_SQLSRV ,  )
   ENDDO
   P03977 = Gx_err
   GX_DB_GetP03977_01 ()
   DO WHILE P03977 <> 101
      R2EmpCod = Buf_P03977_2EmpCod
      R348DcCTip = Buf_P03977_348DcCTip
      R349DccSer = Buf_P03977_349DccSer
      R350DcCSuc = Buf_P03977_350DcCSuc
      R352DcCNro = Buf_P03977_352DcCNro
      R373DcCEst = Buf_P03977_373DcCEst
      R346DcCNro = Buf_P03977_346DcCNroInt
      IF R348DcCTip = "AJUS"
         IF R349DccSer = "X"
            IF R350DcCSuc = 0
               IF R352DcCNro = AV9Nrorcv
                  IF AV14Que = "A"
                     R373DcCEst = 9
                  ELSE
                     DO GX_CSC01
                     IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P03978" , @HStmt_P03978 )
                        Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PAJUANC","P03978","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P03978) ,  ,  ,  , CS_SQLSRV ,  )
                        cmdbuf = " DELETE FROM [DCCOM]  WHERE [EmpCod] = ? AND [DcCNroInt] = ? "
                        Gx_err = GX_DB_Set_StmtCmdText( HStmt_P03978,cmdbuf)
                        GX_DB_BindParmP03978_01 ()
                     ENDIF
                     Gx_err = GX_DB_SetInt( HStmt_P03978,1,@R2EmpCod,0)
                     Gx_err = GX_DB_SetDouble( HStmt_P03978,2,@R346DcCNro,0)
                     Gx_eop = 1
                     DO WHILE Gx_eop != 0
                        Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P03978) ,  ,  ,  , CS_SQLSRV ,  )
                     ENDDO
                     P03978 = Gx_err
                     PRIVATE P03977
                     P03977 = iif( P03978 = 0 , 104 , P03978 )
                     Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P03978) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDIF
                  DO GX_CSC01
                  IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P03979" , @HStmt_P03979 )
                     Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PAJUANC","P03979","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P03979) ,  ,  ,  , CS_SQLSRV ,  )
                     cmdbuf = " UPDATE [DCCOM] SET [DcCEst]=?  WHERE [EmpCod] = ? AND [DcCNroInt] = ? "
                     Gx_err = GX_DB_Set_StmtCmdText( HStmt_P03979,cmdbuf)
                     GX_DB_BindParmP03979_01 ()
                  ENDIF
                  Gx_err = GX_DB_SetInt( HStmt_P03979,1,@R373DcCEst,0)
                  Gx_err = GX_DB_SetInt( HStmt_P03979,2,@R2EmpCod,0)
                  Gx_err = GX_DB_SetDouble( HStmt_P03979,3,@R346DcCNro,0)
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P03979) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  P03979 = Gx_err
                  Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P03979) ,  ,  ,  , CS_SQLSRV ,  )
               ENDIF
            ENDIF
         ENDIF
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_P03977) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      P03977 = Gx_err
      GX_DB_GetP03977_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P03977) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL5 = .F.
RETURN
