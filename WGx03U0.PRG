               THISFORM.AV8C829 = AuxAV8C829
               AuxAV9C830 = THISFORM.AV9C830
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03732,5,@AuxAV9C830,0)
               THISFORM.AV9C830 = AuxAV9C830
               AuxAV10C831 = THISFORM.AV10C831
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03732,6,@AuxAV10C831,0)
               THISFORM.AV10C831 = AuxAV10C831
               AuxAV11C795 = THISFORM.AV11C795
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W03732,7,@AuxAV11C795,0)
               THISFORM.AV11C795 = AuxAV11C795
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03732 = Gx_err
               THISFORM.GX_DB_GetW03732_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03732 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03732) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03732 = Gx_err
                  THISFORM.GX_DB_GetW03732_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03732 <> 101
               BRKVAD2 = .F.
               THISFORM.A795PedFch = THISFORM.Buf_W03732_795PedFch
               THISFORM.A831PedNro = THISFORM.Buf_W03732_831PedNroRto
               THISFORM.A830PedSuc = THISFORM.Buf_W03732_830PedSucRto
               THISFORM.A829PedNro = THISFORM.Buf_W03732_829PedNroFac
               THISFORM.A828PedSuc = THISFORM.Buf_W03732_828PedSucFac
               THISFORM.A1219LPedN = THISFORM.Buf_W03732_1219LPedNI
               THISFORM.A2EmpCod = THISFORM.Buf_W03732_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VAD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03732) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03732 = Gx_err
               THISFORM.GX_DB_GetW03732_01 ()
            ENDDO
         ENDIF
      ENDPROC
