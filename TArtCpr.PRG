      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 1
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT2A3 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT2A3 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 1
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA2EmpCod = THISFORM.A2EmpCod
                  Gx_err = GX_DB_SetInt( HStmt_T00023,1,@AuxA2EmpCod,0)
                  THISFORM.A2EmpCod = AuxA2EmpCod
                  AuxA3FamCod = THISFORM.A3FamCod
                  Gx_err = GX_DB_SetInt( HStmt_T00023,2,@AuxA3FamCod,0)
                  THISFORM.A3FamCod = AuxA3FamCod
                  AuxA4FamSubCo = THISFORM.A4FamSubCo
                  Gx_err = GX_DB_SetInt( HStmt_T00023,3,@AuxA4FamSubCo,0)
                  THISFORM.A4FamSubCo = AuxA4FamSubCo
                  AuxA5ArtCod = THISFORM.A5ArtCod
                  Gx_err = GX_DB_SetInt( HStmt_T00023,4,@AuxA5ArtCod,0)
                  THISFORM.A5ArtCod = AuxA5ArtCod
                  AuxA7ArtCprGr = THISFORM.A7ArtCprGr
                  Gx_err = GX_DB_SetStr( HStmt_T00023,5,AuxA7ArtCprGr,2,0)
                  THISFORM.A7ArtCprGr = AuxA7ArtCprGr
                  AuxA8ArtCprCo = THISFORM.A8ArtCprCo
                  Gx_err = GX_DB_SetLong( HStmt_T00023,6,@AuxA8ArtCprCo,0)
                  THISFORM.A8ArtCprCo = AuxA8ArtCprCo
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00023) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00023 = Gx_err
                  THISFORM.GX_DB_GetT00023_01 ()
                  THISFORM. cCT2A8 . ZM021 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC021 ()
               THISFORM. cCT2A8 . ZM021 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC021 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT2A10 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE021 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC021 ()
                  RETURN
               ENDIF
               THISFORM.cCT2A8.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00023) , "TARTCPR" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00022) , "TARTCPR" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00024) , "TARTCPR" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00025) , "TARTCPR" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT2A10 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT2A3 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

