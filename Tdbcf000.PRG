      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 24
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT27A258 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 24
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA258VECodC = THISFORM.A258VECodC
                  Gx_err = GX_DB_SetInt( HStmt_T00273,1,@AuxA258VECodC,0)
                  THISFORM.A258VECodC = AuxA258VECodC
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00273) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00273 = Gx_err
                  THISFORM.GX_DB_GetT00273_01 ()
                  THISFORM. cCT27A258 . ZM0R24 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0R24 ()
               THISFORM. cCT27A258 . ZM0R24 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0R24 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT27A259 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0R24 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0R24 ()
                  RETURN
               ENDIF
               THISFORM.cCT27A258.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00273) , "TDBCF000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00272) , "TDBCF000" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT27A259 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT27A258 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

