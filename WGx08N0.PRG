      PROCEDURE CreateTemp
         LOCAL SCW898S20
         SCW898S20 = ""
         IF USED( "SCW898S20" )
            SELECT SCW898S20
            SCW898S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW898S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA561TraCo"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2755PreF"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 19
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2757PreI"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA2760PreF"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW898S20 = GETE('z:\temp') + '\' + SCW898S20
            ENDIF
            CREATE DBF (SCW898S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW898S20) EXCLUSIVE ALIAS SCW898S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW898S20
         THIS.GX_SfAlias = "SCW898S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08982" , @HStmt_W08982 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX08N0","W08982","",GX_CURSOR_TYPE_READONLY,@HStmt_W08982) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PreObs], [PreCuo], [PreFDde], [PreImp], [PreFch], [TraCod], [EmpCod] FROM "
                  cmdbuf = cmdbuf + "  [PRESTAMO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [TraCod] >= ? and [PreFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PreObs] like ?) AND ([PreImp] >= ?) AND ([PreCuo] >= ?) AND ([PreFDde] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [TraCod], [PreFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08982,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08982,9)
                  THISFORM.GX_DB_BindColsW08982_01 ()
                  THISFORM.GX_DB_BindParmW08982_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08982,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C561 = THISFORM.AV6C561
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08982,2,@AuxAV6C561,0)
               THISFORM.AV6C561 = AuxAV6C561
               AuxAV7C2755 = THISFORM.AV7C2755
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W08982,3,@AuxAV7C2755,0)
               THISFORM.AV7C2755 = AuxAV7C2755
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08982,4,PADR( TRIM(THISFORM.AV8C2756),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C2756),40, '%')),0)
               AuxAV9C2757 = THISFORM.AV9C2757
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08982,5,@AuxAV9C2757,0)
               THISFORM.AV9C2757 = AuxAV9C2757
               AuxAV10C2759 = THISFORM.AV10C2759
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08982,6,@AuxAV10C2759,0)
               THISFORM.AV10C2759 = AuxAV10C2759
               AuxAV11C2760 = THISFORM.AV11C2760
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08982,7,@AuxAV11C2760,0)
               THISFORM.AV11C2760 = AuxAV11C2760
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08982 = Gx_err
               THISFORM.GX_DB_GetW08982_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08982 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08982) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08982 = Gx_err
                  THISFORM.GX_DB_GetW08982_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08982 <> 101
               BRKVOY2 = .F.
               THISFORM.A2756PreOb = THISFORM.Buf_W08982_2756PreObs
               THISFORM.A2759PreCu = THISFORM.Buf_W08982_2759PreCuo
               THISFORM.A2760PreFD = THISFORM.Buf_W08982_2760PreFDde
               THISFORM.A2757PreIm = THISFORM.Buf_W08982_2757PreImp
               THISFORM.A2755PreFc = THISFORM.Buf_W08982_2755PreFch
               THISFORM.A561TraCod = THISFORM.Buf_W08982_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W08982_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VOY2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08982 = Gx_err
               THISFORM.GX_DB_GetW08982_01 ()
            ENDDO
         ENDIF
      ENDPROC
