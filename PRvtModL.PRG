   ENDDO
   P08566 = Gx_err
   GX_DB_GetP08566_01 ()
   DO WHILE P08566 <> 101
      R929RVtCnt = Buf_P08566_929RVtCnt
      R928RVtLin = Buf_P08566_928RVtLin
      IF R929RVtCnt = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P08567" , @HStmt_P08567 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PRVTMODL","P08567","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P08567) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " DELETE FROM [REMVTA1]  WHERE [EmpCod] = ? AND [RVtNroInt] = ? AND [RVtLin] = ? "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_P08567,cmdbuf)
            GX_DB_BindParmP08567_01 ()
         ENDIF
         Gx_err = GX_DB_SetInt( HStmt_P08567,1,@A2EmpCod,0)
         Gx_err = GX_DB_SetDouble( HStmt_P08567,2,@A908RVtNro,0)
         Gx_err = GX_DB_SetInt( HStmt_P08567,3,@R928RVtLin,0)
