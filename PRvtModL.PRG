         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P08567) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P08567 = Gx_err
         PRIVATE P08566
         P08566 = iif( P08567 = 0 , 104 , P08567 )
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P08567) ,  ,  ,  , CS_SQLSRV ,  )
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_P08566) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
