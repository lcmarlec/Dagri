      PROCEDURE CreateTemp
         LOCAL SCW1214S17
         SCW1214S17 = ""
         IF USED( "SCW1214S17" )
            SELECT SCW1214S17
            SCW1214S17 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1214S17
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "VAV40Ebgpa"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV43Ebgpa"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV42Ebgpa"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV44Ebgpa"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "VAV32Sel"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1214S17 = GETE('z:\temp') + '\' + SCW1214S17
            ENDIF
            CREATE DBF (SCW1214S17) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1214S17) EXCLUSIVE ALIAS SCW1214S17
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1214S17
         THIS.GX_SfAlias = "SCW1214S17"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12142" , @HStmt_W12142 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMBCUO","W12142","",GX_CURSOR_TYPE_READONLY,@HStmt_W12142) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[EbgNroInt], T1.[EbgPorc], T1.[EbgImp], T1.[TraCod], T2.[TraNom] "
                  cmdbuf = cmdbuf + "  FROM ([EMBARGO] T1 (NOLOCK) LEFT JOIN [EMPLEADO] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[TraCod] = T1.[TraCod]) ORDER BY T1.[EmpCod], T1.[EbgNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12142,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12142,12)
                  THISFORM.GX_DB_BindColsW12142_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12142 = Gx_err
               THISFORM.GX_DB_GetW12142_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV48Pgmnam = "WEmbCuo"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12142 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12142) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12142 = Gx_err
                  THISFORM.GX_DB_GetW12142_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12142 <> 101
               BRKVXQ2 = .F.
               THISFORM.AV32Sel = 0
               THISFORM.A2EmpCod = THISFORM.Buf_W12142_2EmpCod
               THISFORM.A3514EbgNr = THISFORM.Buf_W12142_3514EbgNroInt
               THISFORM.A3518EbgPo = THISFORM.Buf_W12142_3518EbgPorc
               THISFORM.A3517EbgIm = THISFORM.Buf_W12142_3517EbgImp
               THISFORM.A561TraCod = THISFORM.Buf_W12142_561TraCod
               THISFORM.A564TraNom = THISFORM.Buf_W12142_564TraNom
               THISFORM.A564TraNom = THISFORM.Buf_W12142_564TraNom
               GX_SFLOAD = 0
               THISFORM.U18VXQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12142 = Gx_err
               THISFORM.GX_DB_GetW12142_01 ()
            ENDDO
         ENDIF
      ENDPROC
