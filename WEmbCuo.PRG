            THISFORM.A2EmpCod = THISFORM.Buf_W12143_2EmpCod
            THISFORM.A3514EbgNr = THISFORM.Buf_W12143_3514EbgNroInt
            THISFORM.A3529EbgPa = THISFORM.Buf_W12143_3529EbgPag
            THISFORM.A3534EbgPa = THISFORM.Buf_W12143_3534EbgPagFC
            THISFORM.A3530EbgPa = THISFORM.Buf_W12143_3530EbgPagFch
            THISFORM.A3531EbgPa = THISFORM.Buf_W12143_3531EbgPagImp
            THISFORM.AV40Ebgpag = THISFORM.A3529EbgPa
            THISFORM.AV42Ebgpag = THISFORM.A3534EbgPa
            THISFORM.AV43Ebgpag = THISFORM.A3530EbgPa
            THISFORM.AV44Ebgpag = THISFORM.A3531EbgPa
            IF THISFORM.cCW1214S17 .GX_rec_loaded >= 10000
               DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
               GX_SFLOAD = 2
            ELSE
               THISFORM.cCW1214S17 .GX_rec_loaded =  THISFORM.cCW1214S17 .GX_rec_loaded + 1
               SELECT( THISFORM.cCW1214S17 .GX_SfAlias)
               GX_SFLOAD = 1
               APPEND BLANK
               THISFORM.cCW1214S17 .SaveTemp()
            ENDIF
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
