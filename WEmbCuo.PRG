            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12143) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W12143 = Gx_err
            THISFORM.GX_DB_GetW12143_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W12143) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.GX_in_event = .F.
