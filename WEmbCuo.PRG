            cmdbuf = cmdbuf + "  [EMBARGO1] (NOLOCK) WHERE [EmpCod] = ? and [EbgNroInt] = ? ORDER BY [EmpCod], [EbgNroInt], "
            cmdbuf = cmdbuf + "  [EbgPag]  "
