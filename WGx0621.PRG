      PROCEDURE CreateTemp
         LOCAL SCW617S20
         SCW617S20 = ""
         IF USED( "SCW617S20" )
            SELECT SCW617S20
            SCW617S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW617S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3FamCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA4FamSubC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA5ArtCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1866OfvF"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA150EntGr"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 2
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1854GrpO"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 3
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW617S20 = GETE('z:\temp') + '\' + SCW617S20
            ENDIF
            CREATE DBF (SCW617S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW617S20) EXCLUSIVE ALIAS SCW617S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW617S20
         THIS.GX_SfAlias = "SCW617S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06172" , @HStmt_W06172 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0621","W06172","",GX_CURSOR_TYPE_READONLY,@HStmt_W06172) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntCod], [GrpOf], [EntGruTip], [OfvFDe], [ArtCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [FamCod] FROM [OFVTA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [FamCod] >= "
                  cmdbuf = cmdbuf + "  ? and [FamSubCod] >= ? and [ArtCod] >= ? and [OfvFDe] >= ?) AND ([EntGruTip] like "
                  cmdbuf = cmdbuf + "  ?) AND ([EntCod] >= ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfvFDe], "
                  cmdbuf = cmdbuf + "  [EntGruTip], [EntCod], [GrpOf]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06172,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06172,9)
                  THISFORM.GX_DB_BindColsW06172_01 ()
                  THISFORM.GX_DB_BindParmW06172_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06172,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C3 = THISFORM.AV5C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06172,2,@AuxAV5C3,0)
               THISFORM.AV5C3 = AuxAV5C3
               AuxAV6C4 = THISFORM.AV6C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06172,3,@AuxAV6C4,0)
               THISFORM.AV6C4 = AuxAV6C4
               AuxAV7C5 = THISFORM.AV7C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06172,4,@AuxAV7C5,0)
               THISFORM.AV7C5 = AuxAV7C5
               AuxAV8C1866 = THISFORM.AV8C1866
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06172,5,@AuxAV8C1866,0)
               THISFORM.AV8C1866 = AuxAV8C1866
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06172,6,PADR( TRIM(THISFORM.AV9C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV9C150),2, '%')),0)
               AuxAV10C120 = THISFORM.AV10C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W06172,7,@AuxAV10C120,0)
               THISFORM.AV10C120 = AuxAV10C120
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06172 = Gx_err
               THISFORM.GX_DB_GetW06172_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06172 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06172) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06172 = Gx_err
                  THISFORM.GX_DB_GetW06172_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06172 <> 101
               BRKVH52 = .F.
               THISFORM.A120EntCod = THISFORM.Buf_W06172_120EntCod
               THISFORM.A1854GrpOf = THISFORM.Buf_W06172_1854GrpOf
               THISFORM.A150EntGru = THISFORM.Buf_W06172_150EntGruTip
               THISFORM.A1866OfvFD = THISFORM.Buf_W06172_1866OfvFDe
               THISFORM.A5ArtCod = THISFORM.Buf_W06172_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W06172_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W06172_3FamCod
               GX_SFLOAD = 0
               THISFORM.U12VH52 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06172) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06172 = Gx_err
               THISFORM.GX_DB_GetW06172_01 ()
            ENDDO
         ENDIF
      ENDPROC
