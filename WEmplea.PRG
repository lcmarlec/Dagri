               AuxAV26Tracui = THISFORM.AV26Tracui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00532,6,@AuxAV26Tracui,0)
               THISFORM.AV26Tracui = AuxAV26Tracui
               AuxAV27Tradni = THISFORM.AV27Tradni
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00532,7,@AuxAV27Tradni,0)
               THISFORM.AV27Tradni = AuxAV27Tradni
