               THISFORM.A3455TraEs = THISFORM.Buf_W00532_3455TraEst
               THISFORM.A566TraTel = THISFORM.Buf_W00532_566TraTel
               THISFORM.A563TraDir = THISFORM.Buf_W00532_563TraDir
               THISFORM.A564TraNom = THISFORM.Buf_W00532_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W00532_561TraCod
               THISFORM.A2281EEDsc = THISFORM.Buf_W00532_2281EEDsc
               GX_SFLOAD = 0
               THISFORM.U26V1H2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00532) ,  ,  ,  , CS_SQLSRV ,  )
