               THISFORM.AV28Traest = AuxAV28Traest
               AuxAV28Traest = THISFORM.AV28Traest
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00532,10,@AuxAV28Traest,0)
               THISFORM.AV28Traest = AuxAV28Traest
               AuxAV30Traemb = THISFORM.AV30Traemb
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00532,11,@AuxAV30Traemb,0)
               THISFORM.AV30Traemb = AuxAV30Traemb
