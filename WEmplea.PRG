               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00532,17,@AuxAV35Veract,0)
               THISFORM.AV35Veract = AuxAV35Veract
               AuxAV36Texto = THISFORM.AV36Texto
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00532,18,AuxAV36Texto,40,0)
               THISFORM.AV36Texto = AuxAV36Texto
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00532,19,PADR( TRIM(THISFORM.AV36Texto),40, '%'),LEN(PADR( TRIM(THISFORM.AV36Texto),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00532,20,PADR( TRIM(THISFORM.AV36Texto),40, '%'),LEN(PADR( TRIM(THISFORM.AV36Texto),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00532,21,PADR( TRIM(THISFORM.AV36Texto),40, '%'),LEN(PADR( TRIM(THISFORM.AV36Texto),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00532,22,PADR( TRIM(THISFORM.AV36Texto),40, '%'),LEN(PADR( TRIM(THISFORM.AV36Texto),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00532) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00532 = Gx_err
               THISFORM.GX_DB_GetW00532_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV40Pgmnam = "WEmplea"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00532 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00532) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00532 = Gx_err
                  THISFORM.GX_DB_GetW00532_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00532 <> 101
               BRKV1H2 = .F.
               THISFORM.A2291TraFE = THISFORM.Buf_W00532_2291TraFEgr
               THISFORM.A2EmpCod = THISFORM.Buf_W00532_2EmpCod
