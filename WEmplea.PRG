            THISFORM.DoU18V1H2()
            RETURN .T.
         ENDIF
         IF UPPER( "Obsevac." ) == UPPER(gx_evt_to_run)
            THISFORM.DoU19V1H2()
            RETURN .T.
         ENDIF
         IF UPPER( "Form. Entr. Ropa" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU20V1H2()
            RETURN .T.
         ENDIF
         IF UPPER( "pericias" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU21V1H2()
            RETURN .T.
         ENDIF
         IF UPPER( "Imprimir Legajo" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU22V1H2()
            RETURN .T.
         ENDIF
         IF UPPER( "Listado de familiares" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU23V1H2()
