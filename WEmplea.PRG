               AuxAV31Eecod = THISFORM.AV31Eecod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00532,13,@AuxAV31Eecod,0)
               THISFORM.AV31Eecod = AuxAV31Eecod
               AuxAV31Eecod = THISFORM.AV31Eecod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00532,14,@AuxAV31Eecod,0)
               THISFORM.AV31Eecod = AuxAV31Eecod
               AuxAV35Veract = THISFORM.AV35Veract
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00532,15,@AuxAV35Veract,0)
               THISFORM.AV35Veract = AuxAV35Veract
