         IF THISFORM.GX_last_fld_lvl != 2
            THISFORM. cCW53V9 .InitLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2281EEDsc"
         THISFORM.cCW53S16 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW53S16 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW53S16 .GX_lastkey = 9.or. THISFORM.cCW53S16 .GX_lastkey = 13)
