      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00532" , @HStmt_W00532 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMPLEA","W00532","",GX_CURSOR_TYPE_READONLY,@HStmt_W00532) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[TraFEgr], T1.[EmpCod], T2.[EEDsc], T1.[EECod], T1.[TraDNI], T1.[TraObs], "
                  cmdbuf = cmdbuf + "  T1.[TraCui], T1.[TraEmb], T1.[TraEst], T1.[TraTel], T1.[TraDir], T1.[TraNom], T1.[TraCod] "
                  cmdbuf = cmdbuf + "  FROM ([EMPLEADO] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EMPEMP] T2 (NOLOCK) ON T2.[EECod] "
                  cmdbuf = cmdbuf + "  = T1.[EECod]) WHERE (T1.[EmpCod] = ?) AND (UPPER(T1.[TraNom]) like UPPER(?)) AND "
                  cmdbuf = cmdbuf + "  (T1.[TraCod] = ? or ? = 0) AND (T1.[TraCui] = ? or ? = 0) AND (T1.[TraDNI] = ? or "
                  cmdbuf = cmdbuf + "  ? = 0) AND (T1.[TraEst] = ? or ? = 9) AND (T1.[TraEmb] = ? or ? = 9) AND (T1.[EECod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) AND (? = 9 or ( T1.[TraFEgr] = convert( DATETIME, '17530101', 112 "
                  cmdbuf = cmdbuf + "  ) and ? = 1) or ( T1.[TraFEgr] <> convert( DATETIME, '17530101', 112 ) and ? = 2)) "
                  cmdbuf = cmdbuf + "  AND (? = ' ' or T1.[TraNom] like '%' + RTRIM(CAST(? AS char(40))) + '%' or T1.[TraDir] "
                  cmdbuf = cmdbuf + "  like '%' + RTRIM(CAST(? AS char(40))) + '%' or T1.[TraTel] like '%' + RTRIM(CAST(? "
                  cmdbuf = cmdbuf + "  AS char(40))) + '%' or T1.[TraObs] like '%' + RTRIM(CAST(? AS char(40))) + '%') "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[TraNom]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00532,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00532,16)
                  THISFORM.GX_DB_BindColsW00532_01 ()
                  THISFORM.GX_DB_BindParmW00532_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00532,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00532,2,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00532,3,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
