                  cmdbuf = " SELECT T3.[OcoEntGruT] AS OcoEntGruT, T1.[EmpCod], T1.[OCoNroInt], T1.[OCoFEn], T1.[OCoCnt], "
                  cmdbuf = cmdbuf + "  T4.[EntTel], T3.[OcoTip], T3.[OCoNro], T3.[OcoSucOpe], T3.[OcoNroOpe], T3.[OcoObs], "
                  cmdbuf = cmdbuf + "  T3.[OcoEntCod] AS OcoEntCod, T3.[OCoEst], T1.[OCoPrc], T2.[ArtDsc], T1.[OcoArtCpr], "
                  cmdbuf = cmdbuf + "  T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T1.[OCoLin], T3.[OCoSuc], T3.[OCoFch] "
                  cmdbuf = cmdbuf + "  FROM ((([OCOMPN1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [OCOMPN] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T3.[OCoNroInt] = T1.[OCoNroInt]) LEFT JOIN [ENTID] T4 (NOLOCK) ON T4.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T4.[EntGruTip] = T3.[OcoEntGruT] AND T4.[EntCod] = T3.[OcoEntCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[OCoNroInt] = ?) AND (T1.[OCoCnt] <> 0 or Not (T1.[OCoFEn] "
                  cmdbuf = cmdbuf + "  = convert( DATETIME, '17530101', 112 ))) ORDER BY T1.[EmpCod], T1.[OCoNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06062,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06062,12)
                  THISFORM.GX_DB_BindColsW06062_01 ()
                  THISFORM.GX_DB_BindParmW06062_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06062,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA682OCoNro = THISFORM.A682OCoNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06062,2,@AuxA682OCoNro,0)
               THISFORM.A682OCoNro = AuxA682OCoNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06062) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06062 = Gx_err
               THISFORM.GX_DB_GetW06062_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_date = DATE()
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06062 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06062) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06062 = Gx_err
                  THISFORM.GX_DB_GetW06062_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06062 <> 101
               BRKVGU2 = .F.
               THISFORM.AV24Ocofep = CTOD("  /  /  ")
