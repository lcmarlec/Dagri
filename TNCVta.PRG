         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A5ArtCod"
            THISFORM.A5ArtCod = THISFORM.Buf_T006918_5ArtCod
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A649TDVCnt"
            THISFORM.A649TDVCnt = THISFORM.Buf_T006918_649TDVCnt
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A650TDVPrc"
            THISFORM.A650TDVPrc = THISFORM.Buf_T006918_650TDVPrc
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A664TDVOfe"
            THISFORM.A664TDVOfe = THISFORM.Buf_T006918_664TDVOfe
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A665TDVPrc"
            THISFORM.A665TDVPrc = THISFORM.Buf_T006918_665TDVPrcOri
         ENDIF
      ENDPROC
