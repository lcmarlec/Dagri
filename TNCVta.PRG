      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T006918" , @HStmt_T006918 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNCVTA","T006918","",GX_CURSOR_TYPE_READONLY,@HStmt_T006918) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TDVNroInt], [TDVLIn], [FamCod], [FamSubCod], [ArtCod], [TDVCnt], "
                  cmdbuf = cmdbuf + "  [TDVPrc], [TDVOfe], [TDVPrcOri] FROM [TDVENT1] (NOLOCK) WHERE [EmpCod] = ? AND [TDVNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [TDVNroInt], [TDVLIn]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T006918,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T006918,9)
                  THISFORM.GX_DB_BindColsT006918_01 ()
                  THISFORM.GX_DB_BindParmT006918_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T006918,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA473TDVNro = THISFORM.A473TDVNro
               Gx_err = GX_DB_SetDouble( HStmt_T006918,2,@AuxA473TDVNro,0)
               THISFORM.A473TDVNro = AuxA473TDVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T006918) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T006918 = Gx_err
               THISFORM.GX_DB_GetT006918_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T006918 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T006918) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T006918 = Gx_err
                  THISFORM.GX_DB_GetT006918_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T006918 <> 101
               BRK1X66 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT69S56.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T006918) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T006918 = Gx_err
               THISFORM.GX_DB_GetT006918_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A648TDVLIn"
            THISFORM.A648TDVLIn = THISFORM.Buf_T006918_648TDVLIn
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3FamCod"
            THISFORM.A3FamCod = THISFORM.Buf_T006918_3FamCod
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A4FamSubCo"
            THISFORM.A4FamSubCo = THISFORM.Buf_T006918_4FamSubCod
