               SCW2S2 = GETE('z:\temp') + '\' + SCW2S2
            ENDIF
            CREATE DBF (SCW2S2) FROM ARRAY GX_STRUCT
            USE
            USE (SCW2S2) EXCLUSIVE ALIAS SCW2S2
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW2S2
         THIS.GX_SfAlias = "SCW2S2"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00022" , @HStmt_W00022 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WARCHIV1","W00022","",GX_CURSOR_TYPE_READONLY,@HStmt_W00022) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DcVLIn], [EmpCod], [DcVNroInt], [DcVCnt], [ArtCod], [FamSubCod], [FamCod] "
                  cmdbuf = cmdbuf + "  FROM [DCVENT1] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [DcVNroInt] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00022,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00022,14)
                  THISFORM.GX_DB_BindColsW00022_01 ()
                  THISFORM.GX_DB_BindParmW00022_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00022,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA415DcVNro = THISFORM.A415DcVNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00022,2,@AuxA415DcVNro,0)
               THISFORM.A415DcVNro = AuxA415DcVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00022 = Gx_err
               THISFORM.GX_DB_GetW00022_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00022 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00022) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00022 = Gx_err
                  THISFORM.GX_DB_GetW00022_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00022 <> 101
               BRKV022 = .F.
               THISFORM.A446DcVCnt = THISFORM.Buf_W00022_446DcVCnt
               THISFORM.A5ArtCod = THISFORM.Buf_W00022_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W00022_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W00022_3FamCod
               GX_SFLOAD = 0
               THISFORM.U11V022 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00022 = Gx_err
               THISFORM.GX_DB_GetW00022_01 ()
            ENDDO
         ENDIF
      ENDPROC
