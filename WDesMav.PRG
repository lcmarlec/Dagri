      ***********************
      PROCEDURE U18VFI2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         THISFORM.AV23Total = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05583" , @HStmt_W05583 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESMAV","W05583","",GX_CURSOR_TYPE_READONLY,@HStmt_W05583) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EntGruTip], [EntCod], [EntLgCod], [DMSec], [DMInd], [EmpCod], [DMNroI], [DMCntNva], "
            cmdbuf = cmdbuf + "  [DMCntO] FROM [DESMAS1] (NOLOCK) WHERE [EmpCod] = ? and [DMNroI] = ? ORDER BY [EmpCod], "
            cmdbuf = cmdbuf + "  [DMNroI]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05583,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05583,13)
            THISFORM.GX_DB_BindColsW05583_01 ()
            THISFORM.GX_DB_BindParmW05583_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05583,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA1690DMNro = THISFORM.A1690DMNro
         THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W05583,2,@AuxA1690DMNro,0)
         THISFORM.A1690DMNro = AuxA1690DMNro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05583) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05583 = Gx_err
         THISFORM.GX_DB_GetW05583_01 ()
         DO WHILE THISFORM.W05583 <> 101
            THISFORM.A1700DMCnt = THISFORM.Buf_W05583_1700DMCntNva
            THISFORM.A1699DMCnt = THISFORM.Buf_W05583_1699DMCntO
            THISFORM.AV23Total = THISFORM.AV23Total + THISFORM.A1699DMCnt - THISFORM.A1700DMCnt
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05583) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W05583 = Gx_err
            THISFORM.GX_DB_GetW05583_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05583) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.cCW558S16 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW558S16 .GX_rec_loaded =  THISFORM.cCW558S16 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW558S16 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW558S16 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

