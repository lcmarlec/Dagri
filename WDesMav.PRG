      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05582" , @HStmt_W05582 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESMAV","W05582","",GX_CURSOR_TYPE_READONLY,@HStmt_W05582) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[FamCod], T1.[FamSubCod], T1.[DMNroI], T1.[EmpCod], T1.[DMEst], T1.[DMPorc], "
                  cmdbuf = cmdbuf + "  T2.[ArtDsc], T1.[ArtCod], T1.[DMNro], T1.[DMFch] FROM ([DESMAS] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] "
                  cmdbuf = cmdbuf + "  = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ?) AND (T1.[DMFch] >= ?) AND (T1.[DMNro] >= ?) AND (T1.[ArtCod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) ORDER BY T1.[EmpCod], T1.[DMNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05582,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05582,13)
                  THISFORM.GX_DB_BindColsW05582_01 ()
                  THISFORM.GX_DB_BindParmW05582_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05582,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Fecha = THISFORM.AV21Fecha
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W05582,2,@AuxAV21Fecha,0)
               THISFORM.AV21Fecha = AuxAV21Fecha
               AuxAV22Dmnro = THISFORM.AV22Dmnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05582,3,@AuxAV22Dmnro,0)
               THISFORM.AV22Dmnro = AuxAV22Dmnro
               AuxAV24Artcod = THISFORM.AV24Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05582,4,@AuxAV24Artcod,0)
               THISFORM.AV24Artcod = AuxAV24Artcod
               AuxAV24Artcod = THISFORM.AV24Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05582,5,@AuxAV24Artcod,0)
               THISFORM.AV24Artcod = AuxAV24Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05582 = Gx_err
               THISFORM.GX_DB_GetW05582_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WDesMav"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05582 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05582) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05582 = Gx_err
                  THISFORM.GX_DB_GetW05582_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05582 <> 101
               BRKVFI2 = .F.
               THISFORM.A3FamCod = THISFORM.Buf_W05582_3FamCod
