            GX_STRUCT[ 5 ,1]= "sA630McoEm"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT61S24 = GETE('z:\temp') + '\' + SCT61S24
            ENDIF
            CREATE DBF (SCT61S24) FROM ARRAY GX_STRUCT
            USE
