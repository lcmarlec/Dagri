         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT61S24
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA629McoEm"
