      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T006116" , @HStmt_T006116 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TMEDCOB","T006116","",GX_CURSOR_TYPE_READONLY,@HStmt_T006116) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [MCoCod], [McoEmpCod], [McoMonCod] AS McoMonCod, [McoEmpCta] FROM [MEDCOB1] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [MCoCod] = ? ORDER BY [MCoCod], [McoEmpCod], [McoMonCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T006116,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T006116,6)
                  THISFORM.GX_DB_BindColsT006116_01 ()
                  THISFORM.GX_DB_BindParmT006116_01 ()
               ENDIF
               AuxA619MCoCod = THISFORM.A619MCoCod
               Gx_err = GX_DB_SetInt( HStmt_T006116,1,@AuxA619MCoCod,0)
               THISFORM.A619MCoCod = AuxA619MCoCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T006116) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T006116 = Gx_err
               THISFORM.GX_DB_GetT006116_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T006116 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T006116) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T006116 = Gx_err
                  THISFORM.GX_DB_GetT006116_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T006116 <> 101
               BRK1P162 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT61S24.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T006116) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T006116 = Gx_err
               THISFORM.GX_DB_GetT006116_01 ()
            ENDDO
         ENDIF
      ENDPROC
