      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R09932) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R09932 = Gx_err
      GX_DB_GetR09932_01 ()
      IF UserCancel
