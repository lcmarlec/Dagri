   RV9Docexce.cells(RV11Fila,6).Text = space( 50 )
   RV9Docexce.cells(RV11Fila,7).Text = space( 30 )
   RV9Docexce.save( )
   RV9Docexce.close( )
   RV10E = opendocument( AV8Planill )
   DO EPRL0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

