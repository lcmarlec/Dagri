      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R09932) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   RV11Fila = RV11Fila + 1
   RV9Docexce.cells(RV11Fila,1).Text = space( 40 )
   RV9Docexce.cells(RV11Fila,2).Text = space( 25 )
   RV9Docexce.cells(RV11Fila,3).Text = space( 25 )
