                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T028811) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T028811 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T028811) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T028812" , @HStmt_T028812 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TREINABM","T028812","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T028812) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [REINCID]  WHERE [EmpCod] = ? AND [ReIRoI] = ? AND [ReINroI] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T028812,cmdbuf)
                  THISFORM.GX_DB_BindParmT028812_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T028812,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2617ReIRo = THISFORM.A2617ReIRo
               Gx_err = GX_DB_SetStr( HStmt_T028812,2,AuxA2617ReIRo,1,0)
               THISFORM.A2617ReIRo = AuxA2617ReIRo
               AuxA2616ReINr = THISFORM.A2616ReINr
               Gx_err = GX_DB_SetDouble( HStmt_T028812,3,@AuxA2616ReINr,0)
               THISFORM.A2616ReINr = AuxA2616ReINr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T028812) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T028812 = Gx_err
               THISFORM.T02882 = iif( THISFORM.T028812 = 0 , 104 , THISFORM.T028812 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T028812) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
