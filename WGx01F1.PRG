      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02322" , @HStmt_W02322 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01F1","W02322","",GX_CURSOR_TYPE_READONLY,@HStmt_W02322) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EjeFin], [PCtaNro], [EjeNroInt], [EjeIni], [EjeDes], [EjeNro] FROM "
                  cmdbuf = cmdbuf + "  [EJE] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EjeNro] >= ?) AND ([EjeDes] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EjeIni] >= ?) AND ([EjeFin] >= ?) AND ([PCtaNro] >= ?) AND ([EjeNroInt] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [EjeNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02322,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02322,9)
                  THISFORM.GX_DB_BindColsW02322_01 ()
                  THISFORM.GX_DB_BindParmW02322_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02322,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C548 = THISFORM.AV5C548
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02322,2,@AuxAV5C548,0)
               THISFORM.AV5C548 = AuxAV5C548
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02322,3,PADR( TRIM(THISFORM.AV6C549),30, '%'),LEN(PADR( TRIM(THISFORM.AV6C549),30, '%')),0)
               AuxAV7C550 = THISFORM.AV7C550
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02322,4,@AuxAV7C550,0)
               THISFORM.AV7C550 = AuxAV7C550
               AuxAV8C551 = THISFORM.AV8C551
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02322,5,@AuxAV8C551,0)
               THISFORM.AV8C551 = AuxAV8C551
               AuxAV9C198 = THISFORM.AV9C198
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02322,6,@AuxAV9C198,0)
               THISFORM.AV9C198 = AuxAV9C198
               AuxAV10C552 = THISFORM.AV10C552
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02322,7,@AuxAV10C552,0)
               THISFORM.AV10C552 = AuxAV10C552
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02322 = Gx_err
               THISFORM.GX_DB_GetW02322_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02322 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02322) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02322 = Gx_err
                  THISFORM.GX_DB_GetW02322_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02322 <> 101
               BRKV6G2 = .F.
               THISFORM.A551EjeFin = THISFORM.Buf_W02322_551EjeFin
               THISFORM.A198PCtaNr = THISFORM.Buf_W02322_198PCtaNro
               THISFORM.A552EjeNro = THISFORM.Buf_W02322_552EjeNroInt
               THISFORM.A550EjeIni = THISFORM.Buf_W02322_550EjeIni
               THISFORM.A549EjeDes = THISFORM.Buf_W02322_549EjeDes
               THISFORM.A548EjeNro = THISFORM.Buf_W02322_548EjeNro
               GX_SFLOAD = 0
               THISFORM.U12V6G2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02322) ,  ,  ,  , CS_SQLSRV ,  )
