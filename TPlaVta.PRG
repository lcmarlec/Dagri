            THISFORM.T00915 = Gx_err
            THISFORM.GX_DB_GetT00915_01 ()
            IF .NOT. THISFORM.T00915 <> 103
               DO GX_ERRMW WITH "PLAVTA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00915 = 101 .OR. THISFORM.Buf_T00915_1885PlvObs <> THISFORM.Z1885PlvOb .OR. THISFORM.Buf_T00915_1850PlVRet1 <> THISFORM.Z1850PlVRe .OR. THISFORM.Buf_T00915_1851PlVRet2 <> THISFORM.Z1851PlVRe .OR. THISFORM.Buf_T00915_1645PlVRet <> THISFORM.Z1645PlVRe
