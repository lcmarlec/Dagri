      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00919" , @HStmt_T00919 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPLAVTA","T00919","",1,@HStmt_T00919) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO PLAVTA (EmpCod, PlVGruTip, PlVEntCod, PlvObs, PlVRet1, PlVRet2, PlVRet) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?, ?) "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_T00919,cmdbuf) ,  ,  ,  , CS_SQLSRV , 0 )
                  THISFORM.GX_DB_BindParmT00919_01 ( HStmt_T00919 )
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00919,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA836PlVGru = THISFORM.A836PlVGru
               Gx_err = GX_DB_SetStr( HStmt_T00919,2,AuxA836PlVGru,2,0)
               THISFORM.A836PlVGru = AuxA836PlVGru
               AuxA837PlVEnt = THISFORM.A837PlVEnt
               Gx_err = GX_DB_SetLong( HStmt_T00919,3,@AuxA837PlVEnt,0)
               THISFORM.A837PlVEnt = AuxA837PlVEnt
               AuxA1885PlvOb = THISFORM.A1885PlvOb
               Gx_err = GX_DB_SetStr( HStmt_T00919,4,AuxA1885PlvOb,40,0)
               THISFORM.A1885PlvOb = AuxA1885PlvOb
               AuxA1850PlVRe = THISFORM.A1850PlVRe
               Gx_err = GX_DB_SetDouble( HStmt_T00919,5,@AuxA1850PlVRe,0)
               THISFORM.A1850PlVRe = AuxA1850PlVRe
               AuxA1851PlVRe = THISFORM.A1851PlVRe
               Gx_err = GX_DB_SetDouble( HStmt_T00919,6,@AuxA1851PlVRe,0)
               THISFORM.A1851PlVRe = AuxA1851PlVRe
               AuxA1645PlVRe = THISFORM.A1645PlVRe
               Gx_err = GX_DB_SetDouble( HStmt_T00919,7,@AuxA1645PlVRe,0)
               THISFORM.A1645PlVRe = AuxA1645PlVRe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00919) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00919 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00919) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00919 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T009110" , @HStmt_T009110 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPLAVTA","T009110","",1,@HStmt_T009110) ,  ,  ,  , CS_SQLSRV , 0 )
