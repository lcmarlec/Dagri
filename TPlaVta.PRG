      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T009115" , @HStmt_T009115 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPLAVTA","T009115","",0,@HStmt_T009115) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT EmpCod, PlVGruTip, PlVEntCod, FamCod, FamSubCod, ArtCod, PlvArtRet, PlvArtRet1, "
                  cmdbuf = cmdbuf + "  PlvArtRet2, PlVPrcReal, PlVPrc, PlvInd  FROM PLAVTA1 (NOLOCK) WHERE EmpCod = ? AND "
                  cmdbuf = cmdbuf + "  PlVGruTip = ? AND PlVEntCod = ? ORDER BY EmpCod, PlVGruTip, PlVEntCod, FamCod, FamSubCod, "
                  cmdbuf = cmdbuf + "  ArtCod   "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_T009115,cmdbuf) ,  ,  ,  , CS_SQLSRV , 0 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtFetchSize( HStmt_T009115,14) ,  ,  ,  , CS_SQLSRV , 0 )
                  THISFORM.GX_DB_BindColsT00912_01 ( HStmt_T009115 )
                  THISFORM.GX_DB_BindParmT009115_01 ( HStmt_T009115 )
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T009115,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA836PlVGru = THISFORM.A836PlVGru
               Gx_err = GX_DB_SetStr( HStmt_T009115,2,AuxA836PlVGru,2,0)
               THISFORM.A836PlVGru = AuxA836PlVGru
               AuxA837PlVEnt = THISFORM.A837PlVEnt
               Gx_err = GX_DB_SetLong( HStmt_T009115,3,@AuxA837PlVEnt,0)
               THISFORM.A837PlVEnt = AuxA837PlVEnt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T009115) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009115 = Gx_err
               THISFORM.GX_DB_GetT009115_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T009115 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009115) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T009115 = Gx_err
                  THISFORM.GX_DB_GetT009115_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T009115 <> 101
               BRK2J93 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT91S15.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T009115_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009115) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009115 = Gx_err
               THISFORM.GX_DB_GetT009115_01 ()
            ENDDO
         ENDIF
      ENDPROC
