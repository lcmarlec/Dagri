      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S836PlVGru
         LOCAL S837PlVEnt
         LOCAL S3FamCod
         LOCAL S4FamSubCo
         LOCAL S5ArtCod
         S2EmpCod = THISFORM.A2EmpCod
         S836PlVGru = THISFORM.A836PlVGru
         S837PlVEnt = THISFORM.A837PlVEnt
         S3FamCod = THISFORM.A3FamCod
         S4FamSubCo = THISFORM.A4FamSubCo
         S5ArtCod = THISFORM.A5ArtCod
         THISFORM.A3FamCod = THISFORM.M3FamCod
         THISFORM.A4FamSubCo = THISFORM.M4FamSubCo
         THISFORM.A5ArtCod = THISFORM.M5ArtCod
         THISFORM. cCT91S15 .SaveTemp()
         THISFORM. cCT91S15 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT91S15 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT91S15 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT91S15 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S836PlVGru = THISFORM.A836PlVGru .AND. S837PlVEnt = THISFORM.A837PlVEnt .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
         Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT91S15 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT91S15 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S836PlVGru = THISFORM.A836PlVGru .AND. S837PlVEnt = THISFORM.A837PlVEnt .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
            Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT91S15 .Refresh()
               THISFORM. cCT91S15 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A836PlVGru = S836PlVGru
               THISFORM.A837PlVEnt = S837PlVEnt
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT91S15 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT91S15 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S836PlVGru = THISFORM.A836PlVGru .AND. S837PlVEnt = THISFORM.A837PlVEnt .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
            Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT91S15 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S836PlVGru = THISFORM.A836PlVGru .AND. S837PlVEnt = THISFORM.A837PlVEnt .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
               Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT91S15 .AppendRow()
               THISFORM. cCT91S15 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A836PlVGru = S836PlVGru
               THISFORM.A837PlVEnt = S837PlVEnt
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A836PlVGru = S836PlVGru
         THISFORM.A837PlVEnt = S837PlVEnt
         THISFORM.A3FamCod = S3FamCod
         THISFORM.A4FamSubCo = S4FamSubCo
         THISFORM.A5ArtCod = S5ArtCod
         RETURN .F.
      ENDFUNC
