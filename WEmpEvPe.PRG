      PROCEDURE CreateTemp
         LOCAL SCW1025S14
         SCW1025S14 = ""
         IF USED( "SCW1025S14" )
            SELECT SCW1025S14
            SCW1025S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1025S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA561TraCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA564TraNo"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2290TraF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV27Diast"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3053TraE"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3054TraE"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 254
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA2EmpCod"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 4
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1025S14 = GETE('z:\temp') + '\' + SCW1025S14
            ENDIF
            CREATE DBF (SCW1025S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1025S14) EXCLUSIVE ALIAS SCW1025S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1025S14
         THIS.GX_SfAlias = "SCW1025S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10252" , @HStmt_W10252 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMPEVPE","W10252","",GX_CURSOR_TYPE_READONLY,@HStmt_W10252) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [TraFEgr], [EmpCod], [TraEvaCom], [TraEva], [TraFIng], [TraNom], [TraCod] "
                  cmdbuf = cmdbuf + "  FROM [EMPLEADO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ?) AND (UPPER([TraNom]) "
                  cmdbuf = cmdbuf + "  like UPPER(?)) AND ([TraCod] = ? or ? = 0) AND ([TraFIng] > ? and ? = 1 or ? = 0) "
                  cmdbuf = cmdbuf + "  AND ([TraFEgr] = convert( DATETIME, '17530101', 112 ) or [TraFEgr] IS NULL) AND "
                  cmdbuf = cmdbuf + "  ([TraEva] <> 1 or [TraEva] = convert(int, 0) or [TraEva] IS NULL or ? = 0) ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [TraNom]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10252,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10252,13)
                  THISFORM.GX_DB_BindColsW10252_01 ()
                  THISFORM.GX_DB_BindParmW10252_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10252,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10252,2,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10252,3,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10252,4,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV28Tresme = THISFORM.AV28Tresme
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W10252,5,@AuxAV28Tresme,0)
               THISFORM.AV28Tresme = AuxAV28Tresme
               AuxAV32Confil = THISFORM.AV32Confil
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10252,6,@AuxAV32Confil,0)
               THISFORM.AV32Confil = AuxAV32Confil
               AuxAV32Confil = THISFORM.AV32Confil
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10252,7,@AuxAV32Confil,0)
               THISFORM.AV32Confil = AuxAV32Confil
               AuxAV32Confil = THISFORM.AV32Confil
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10252,8,@AuxAV32Confil,0)
               THISFORM.AV32Confil = AuxAV32Confil
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10252 = Gx_err
               THISFORM.GX_DB_GetW10252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV36Pgmnam = "WEmpEvPe"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10252 = Gx_err
                  THISFORM.GX_DB_GetW10252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10252 <> 101
               BRKVSH2 = .F.
               THISFORM.AV27Diastr = 0
               THISFORM.A2291TraFE = THISFORM.Buf_W10252_2291TraFEgr
               THISFORM.A2EmpCod = THISFORM.Buf_W10252_2EmpCod
               THISFORM.A3054TraEv = THISFORM.Buf_W10252_3054TraEvaCom
               THISFORM.A3053TraEv = THISFORM.Buf_W10252_3053TraEva
               THISFORM.A2290TraFI = THISFORM.Buf_W10252_2290TraFIng
               THISFORM.A564TraNom = THISFORM.Buf_W10252_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W10252_561TraCod
               IF THISFORM.A2290TraFI + 60 < DATE() .AND. THISFORM.AV32Confil = 1 .OR. THISFORM.AV32Confil = 0
                  GX_SFLOAD = 0
                  THISFORM.U19VSH2 ()
                  THIS.GX_CUPOS = 0
                  DO CASE
                     CASE GX_SFLOAD = 1
                        GX_CUERR = 0
                        EXIT
                     CASE GX_SFLOAD = 2
                        GX_CUERR = 100
                        EXIT
                  ENDCASE
                  IF UserCancel
                     EXIT
                  ENDIF
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10252 = Gx_err
               THISFORM.GX_DB_GetW10252_01 ()
            ENDDO
         ENDIF
      ENDPROC
