      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "Modificar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VSH2()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU18VSH2()
            RETURN .T.
         ENDIF
         IF UPPER( "Ver" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VSH2()
            RETURN .T.
         ENDIF
         IF UPPER( "evaluar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VSH2()
            RETURN .T.
         ENDIF
         IF UPPER( "anular" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VSH2()
            RETURN .T.
         ENDIF
         IF UPPER( "verEmpleado" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU17VSH2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
