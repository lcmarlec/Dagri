               THISFORM.AV6C561 = AuxAV6C561
               AuxAV7C2755 = THISFORM.AV7C2755
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W11822,3,@AuxAV7C2755,0)
               THISFORM.AV7C2755 = AuxAV7C2755
               AuxAV8C3432 = THISFORM.AV8C3432
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11822,4,@AuxAV8C3432,0)
               THISFORM.AV8C3432 = AuxAV8C3432
               AuxAV9C3433 = THISFORM.AV9C3433
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W11822,5,@AuxAV9C3433,0)
               THISFORM.AV9C3433 = AuxAV9C3433
               AuxAV10C3434 = THISFORM.AV10C3434
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11822,6,@AuxAV10C3434,0)
               THISFORM.AV10C3434 = AuxAV10C3434
               AuxAV11C3435 = THISFORM.AV11C3435
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11822,7,@AuxAV11C3435,0)
               THISFORM.AV11C3435 = AuxAV11C3435
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11822 = Gx_err
               THISFORM.GX_DB_GetW11822_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11822 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11822) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11822 = Gx_err
                  THISFORM.GX_DB_GetW11822_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11822 <> 101
               BRKVWU2 = .F.
               THISFORM.A3433PreCu = THISFORM.Buf_W11822_3433PreCuoImp
               THISFORM.A3434Precu = THISFORM.Buf_W11822_3434PrecuoAA
               THISFORM.A3435PreCu = THISFORM.Buf_W11822_3435PreCuoMM
               THISFORM.A3432PreCu = THISFORM.Buf_W11822_3432PreCuoNro
               THISFORM.A2755PreFc = THISFORM.Buf_W11822_2755PreFch
               THISFORM.A561TraCod = THISFORM.Buf_W11822_561TraCod
               THISFORM.A2EmpCod = THISFORM.Buf_W11822_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VWU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11822) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11822 = Gx_err
               THISFORM.GX_DB_GetW11822_01 ()
            ENDDO
         ENDIF
      ENDPROC
