      PROCEDURE CreateTemp
         LOCAL SCW1043S12
         SCW1043S12 = ""
         IF USED( "SCW1043S12" )
            SELECT SCW1043S12
            SCW1043S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1043S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3FamCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA4FamSubC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA5ArtCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1464ArtC"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 15
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA6ArtDsc"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 50
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA23ArtStk"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 14
            GX_STRUCT[ 6 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW1043S12 = GETE('z:\temp') + '\' + SCW1043S12
            ENDIF
            CREATE DBF (SCW1043S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1043S12) EXCLUSIVE ALIAS SCW1043S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1043S12
         THIS.GX_SfAlias = "SCW1043S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W10432" , @HStmt_W10432 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WARTSTKA","W10432","",GX_CURSOR_TYPE_READONLY,@HStmt_W10432) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ArtVta], [ArtPtoRep], [ArtInhab], [ArtStk], [ArtDsc], [ArtCodBar], "
                  cmdbuf = cmdbuf + "  [ArtCod], [FamSubCod], [FamCod] FROM [ARTICS] (NOLOCK) WHERE ([EmpCod] = ?) AND "
                  cmdbuf = cmdbuf + "  (( [FamCod] >= ? and ? = 0) or ( [FamCod] = ? and [FamSubCod] >= ? and ? <> 0)) "
                  cmdbuf = cmdbuf + "  AND ([ArtCod] >= ?) AND ([ArtDsc] like ?) AND ([ArtVta] = ?) AND ([ArtStk] < [ArtPtoRep] "
                  cmdbuf = cmdbuf + "  or ( [ArtCodBar] = ? and ? <> ' ')) AND ([ArtCodBar] = ? or ? = ' ') AND ([ArtInhab] "
                  cmdbuf = cmdbuf + "  = 0) ORDER BY [EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10432,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10432,13)
                  THISFORM.GX_DB_BindColsW10432_01 ()
                  THISFORM.GX_DB_BindParmW10432_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV18Desfam = THISFORM.AV18Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,2,@AuxAV18Desfam,0)
               THISFORM.AV18Desfam = AuxAV18Desfam
               AuxAV19Desfam = THISFORM.AV19Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,3,@AuxAV19Desfam,0)
               THISFORM.AV19Desfam = AuxAV19Desfam
               AuxAV18Desfam = THISFORM.AV18Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,4,@AuxAV18Desfam,0)
               THISFORM.AV18Desfam = AuxAV18Desfam
               AuxAV19Desfam = THISFORM.AV19Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,5,@AuxAV19Desfam,0)
               THISFORM.AV19Desfam = AuxAV19Desfam
               AuxAV19Desfam = THISFORM.AV19Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,6,@AuxAV19Desfam,0)
               THISFORM.AV19Desfam = AuxAV19Desfam
               AuxAV20Descod = THISFORM.AV20Descod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10432,7,@AuxAV20Descod,0)
               THISFORM.AV20Descod = AuxAV20Descod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10432,8,PADR( TRIM(THISFORM.AV16Desdsc),50, '%'),LEN(PADR( TRIM(THISFORM.AV16Desdsc),50, '%')),0)
               AuxAV21Tipart = THISFORM.AV21Tipart
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10432,9,AuxAV21Tipart,1,0)
               THISFORM.AV21Tipart = AuxAV21Tipart
               AuxAV26Artcod = THISFORM.AV26Artcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10432,10,AuxAV26Artcod,15,0)
               THISFORM.AV26Artcod = AuxAV26Artcod
               AuxAV26Artcod = THISFORM.AV26Artcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10432,11,AuxAV26Artcod,15,0)
               THISFORM.AV26Artcod = AuxAV26Artcod
               AuxAV26Artcod = THISFORM.AV26Artcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10432,12,AuxAV26Artcod,15,0)
               THISFORM.AV26Artcod = AuxAV26Artcod
               AuxAV26Artcod = THISFORM.AV26Artcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10432,13,AuxAV26Artcod,15,0)
               THISFORM.AV26Artcod = AuxAV26Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10432 = Gx_err
               THISFORM.GX_DB_GetW10432_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WArtStkA"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10432 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10432) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10432 = Gx_err
                  THISFORM.GX_DB_GetW10432_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10432 <> 101
               BRKVSZ2 = .F.
               THISFORM.A28ArtVta = THISFORM.Buf_W10432_28ArtVta
               THISFORM.A22ArtPtoR = THISFORM.Buf_W10432_22ArtPtoRep
               THISFORM.A1460ArtIn = THISFORM.Buf_W10432_1460ArtInhab
               THISFORM.A23ArtStk = THISFORM.Buf_W10432_23ArtStk
               THISFORM.A6ArtDsc = THISFORM.Buf_W10432_6ArtDsc
               THISFORM.A1464ArtCo = THISFORM.Buf_W10432_1464ArtCodBar
               THISFORM.A5ArtCod = THISFORM.Buf_W10432_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W10432_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W10432_3FamCod
               GX_SFLOAD = 0
               THISFORM.U19VSZ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10432 = Gx_err
               THISFORM.GX_DB_GetW10432_01 ()
            ENDDO
         ENDIF
      ENDPROC
