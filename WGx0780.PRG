      PROCEDURE CreateTemp
         LOCAL SCW766S18
         SCW766S18 = ""
         IF USED( "SCW766S18" )
            SELECT SCW766S18
            SCW766S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW766S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA2280EECo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2284EECU"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 11
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW766S18 = GETE('z:\temp') + '\' + SCW766S18
            ENDIF
            CREATE DBF (SCW766S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW766S18) EXCLUSIVE ALIAS SCW766S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW766S18
         THIS.GX_SfAlias = "SCW766S18"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07662" , @HStmt_W07662 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0780","W07662","",GX_CURSOR_TYPE_READONLY,@HStmt_W07662) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EEDsc], [EEContacto], [EEDireccio], [EETelefono], [EECUIT], [EECod] FROM "
                  cmdbuf = cmdbuf + "  [EMPEMP] (FASTFIRSTROW NOLOCK) WHERE ([EECod] >= ?) AND ([EEDsc] like ?) AND ([EEContacto] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EEDireccio] like ?) AND ([EECUIT] >= ?) AND ([EETelefono] like ?) "
                  cmdbuf = cmdbuf + "  ORDER BY [EECod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07662,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07662,9)
                  THISFORM.GX_DB_BindColsW07662_01 ()
                  THISFORM.GX_DB_BindParmW07662_01 ()
               ENDIF
               AuxAV5C2280 = THISFORM.AV5C2280
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07662,1,@AuxAV5C2280,0)
               THISFORM.AV5C2280 = AuxAV5C2280
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07662,2,PADR( TRIM(THISFORM.AV6C2281),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C2281),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07662,3,PADR( TRIM(THISFORM.AV7C2282),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C2282),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07662,4,PADR( TRIM(THISFORM.AV8C2283),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C2283),40, '%')),0)
               AuxAV9C2284 = THISFORM.AV9C2284
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07662,5,@AuxAV9C2284,0)
               THISFORM.AV9C2284 = AuxAV9C2284
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07662,6,PADR( TRIM(THISFORM.AV10C2285),40, '%'),LEN(PADR( TRIM(THISFORM.AV10C2285),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07662 = Gx_err
               THISFORM.GX_DB_GetW07662_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07662 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07662) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07662 = Gx_err
                  THISFORM.GX_DB_GetW07662_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07662 <> 101
               BRKVLA2 = .F.
               THISFORM.A2281EEDsc = THISFORM.Buf_W07662_2281EEDsc
               THISFORM.A2282EECon = THISFORM.Buf_W07662_2282EEContacto
               THISFORM.A2283EEDir = THISFORM.Buf_W07662_2283EEDireccio
               THISFORM.A2285EETel = THISFORM.Buf_W07662_2285EETelefono
               THISFORM.A2284EECUI = THISFORM.Buf_W07662_2284EECUIT
               THISFORM.A2280EECod = THISFORM.Buf_W07662_2280EECod
               GX_SFLOAD = 0
               THISFORM.U12VLA2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07662) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07662 = Gx_err
               THISFORM.GX_DB_GetW07662_01 ()
            ENDDO
         ENDIF
      ENDPROC
