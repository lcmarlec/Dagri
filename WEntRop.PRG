      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08452" , @HStmt_W08452 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WENTROP","W08452","",GX_CURSOR_TYPE_READONLY,@HStmt_W08452) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RopObs], T1.[RopCnt], T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[FamCod], T1.[RopFch], T1.[RopFchEnt], T3.[TraNom], T1.[TraCod] FROM (([ENTREGA] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] "
                  cmdbuf = cmdbuf + "  = T1.[ArtCod]) LEFT JOIN [EMPLEADO] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[TraCod] = T1.[TraCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[RopFchEnt] >= ?) AND "
                  cmdbuf = cmdbuf + "  (T1.[TraCod] = ? or ? = 0) AND (UPPER(T3.[TraNom]) like UPPER(?)) AND (T1.[ArtCod] "
                  cmdbuf = cmdbuf + "  = ? or ? = 0) ORDER BY T1.[EmpCod], T1.[TraCod], T1.[RopFch], T1.[FamCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08452,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08452,13)
                  THISFORM.GX_DB_BindColsW08452_01 ()
                  THISFORM.GX_DB_BindParmW08452_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08452,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08452,2,@AuxAV20Desde,0)
               THISFORM.AV20Desde = AuxAV20Desde
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08452,3,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               AuxAV23Tracod = THISFORM.AV23Tracod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08452,4,@AuxAV23Tracod,0)
               THISFORM.AV23Tracod = AuxAV23Tracod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08452,5,PADR( TRIM(THISFORM.AV21Tranom),40, '%'),LEN(PADR( TRIM(THISFORM.AV21Tranom),40, '%')),0)
               AuxAV26Artcod = THISFORM.AV26Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08452,6,@AuxAV26Artcod,0)
               THISFORM.AV26Artcod = AuxAV26Artcod
               AuxAV26Artcod = THISFORM.AV26Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08452,7,@AuxAV26Artcod,0)
               THISFORM.AV26Artcod = AuxAV26Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08452) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08452 = Gx_err
               THISFORM.GX_DB_GetW08452_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV32Pgmnam = "WEntRop"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08452 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08452) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08452 = Gx_err
                  THISFORM.GX_DB_GetW08452_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08452 <> 101
               BRKVNH2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W08452_2EmpCod
               THISFORM.A2593RopOb = THISFORM.Buf_W08452_2593RopObs
               THISFORM.A2594RopCn = THISFORM.Buf_W08452_2594RopCnt
               THISFORM.A6ArtDsc = THISFORM.Buf_W08452_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W08452_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W08452_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W08452_3FamCod
               THISFORM.A2592RopFc = THISFORM.Buf_W08452_2592RopFch
               THISFORM.A3772RopFc = THISFORM.Buf_W08452_3772RopFchEnt
               THISFORM.A564TraNom = THISFORM.Buf_W08452_564TraNom
               THISFORM.A561TraCod = THISFORM.Buf_W08452_561TraCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W08452_6ArtDsc
               THISFORM.A564TraNom = THISFORM.Buf_W08452_564TraNom
               GX_SFLOAD = 0
               THISFORM.U19VNH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08452) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08452 = Gx_err
               THISFORM.GX_DB_GetW08452_01 ()
            ENDDO
         ENDIF
      ENDPROC
