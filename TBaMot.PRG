               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03856" , @HStmt_T03856 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBAMOT","T03856","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03856) ,  ,  ,  , CS_SQLSRV , 0 )
