      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 403
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT385A3553 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT385A3553 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 403
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3553BaCod = THISFORM.A3553BaCod
                  Gx_err = GX_DB_SetInt( HStmt_T03853,1,@AuxA3553BaCod,0)
                  THISFORM.A3553BaCod = AuxA3553BaCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03853) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03853 = Gx_err
                  THISFORM.GX_DB_GetT03853_01 ()
                  THISFORM. cCT385A3553 . ZMAP403 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCAP403 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03858" , @HStmt_T03858 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBAMOT","T03858","",GX_CURSOR_TYPE_READONLY,@HStmt_T03858) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod] FROM [TRABAJA] (NOLOCK) WHERE [BaCod] = ?  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03858,cmdbuf)
                  THISFORM.GX_DB_BindColsT03858_01 ()
                  THISFORM.GX_DB_BindParmT03858_01 ()
               ENDIF
               AuxBuf_T03853_3553BaCod = THISFORM.Buf_T03853_3553BaCod
               Gx_err = GX_DB_SetInt( HStmt_T03858,1,@AuxBuf_T03853_3553BaCod,0)
               THISFORM.Buf_T03853_3553BaCod = AuxBuf_T03853_3553BaCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03858) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03858 = Gx_err
               THISFORM.GX_DB_GetT03858_01 ()
               IF THISFORM.T03858 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03858) , "TBAMOT" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " TraBaja "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03858) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT385A3553 . ZMAP403 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAP403 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT385A3554 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEAP403 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAP403 ()
                  RETURN
               ENDIF
               THISFORM.cCT385A3553.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03853) , "TBAMOT" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03852) , "TBAMOT" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT385A3554 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT385A3553 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

