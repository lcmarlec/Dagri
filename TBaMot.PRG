                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03855,cmdbuf)
                  THISFORM.GX_DB_BindParmT03855_01 ()
               ENDIF
               AuxA3553BaCod = THISFORM.A3553BaCod
