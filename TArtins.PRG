      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV11Numero = str( THISFORM.AV12Famcod , 4 ) + " " + str( THISFORM.AV13Famsub , 4 ) + " " + str( THISFORM.A5ArtCod , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV7Emprcod
            Aux3 = THISFORM.AV11Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV10Audobs
            Aux6 = THISFORM.AV9Usuario
            DO PAuditor WITH "TABL" , Aux1 , "ARTI" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV7Emprcod = Aux1
            THISFORM.AV11Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV10Audobs = Aux5
            THISFORM.AV9Usuario = Aux6
            THISFORM. cCT4V9 .Refresh()
         ENDIF
         IF .T. .AND. THISFORM.AV14Artcod = THISFORM.A5ArtCod .AND. THISFORM.A28ArtVta = "S"
            THISFORM.SaveTblPos()
            Aux0 = THISFORM.A2EmpCod
            Aux3 = THISFORM.A5ArtCod
            DO PSkNro WITH Aux0 , "ART" , 2 , Aux3 , 1
            THISFORM.A2EmpCod = Aux0
            THISFORM.A5ArtCod = Aux3
            THISFORM. cCT4A2 .Refresh()
            THISFORM. cCT4A5 .Refresh()
         ENDIF
         RETURN .T.
