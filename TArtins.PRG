      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
               IF .T.
                  THISFORM.SaveTblPos()
                  Aux1 = THISFORM.A3FamCod
                  Aux2 = THISFORM.A4FamSubCo
                  Aux3 = THISFORM.A5ArtCod
                  Aux4 = THISFORM.A2EmpCod
                  Aux5 = THISFORM.AV6Fechasi
                  Aux6 = THISFORM.AV9Usuario
                  DO TArtics WITH "UPD" , Aux1 , Aux2 , Aux3 , Aux4 , Aux5 , Aux6
                  THISFORM.A3FamCod = Aux1
                  THISFORM.A4FamSubCo = Aux2
                  THISFORM.A5ArtCod = Aux3
                  THISFORM.A2EmpCod = Aux4
                  THISFORM.AV6Fechasi = Aux5
                  THISFORM.AV9Usuario = Aux6
                  THISFORM. cCT4A3 .Refresh()
                  THISFORM. cCT4A4 .Refresh()
                  THISFORM. cCT4A5 .Refresh()
                  THISFORM. cCT4A2 .Refresh()
                  THISFORM. cCT4V6 .Refresh()
                  THISFORM. cCT4V9 .Refresh()
               ENDIF
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
