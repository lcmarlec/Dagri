      PROCEDURE Activate
         IF THISFORM.GX_init_activate
            IF THISFORM.Gx_mode <> "DSP"
               THISFORM.AV10Audobs = "Actualización de datos de Artículo "
               THISFORM.AV19Pgmnam = "TArtins"
               IF THISFORM.Gx_mode = 'DLT' .OR. THISFORM.Gx_mode = 'UPD'
                  THISFORM.A3FamCod = THISFORM.AV12Famcod
               ENDIF
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00045,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00045) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00045 = Gx_err
               THISFORM.GX_DB_GetT00045_01 ()
               THISFORM.A15FamDsc = THISFORM.Buf_T00045_15FamDsc
               IF THISFORM.Gx_mode = 'DLT' .OR. THISFORM.Gx_mode = 'UPD'
