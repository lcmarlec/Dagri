               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00044) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00044 = Gx_err
               THISFORM.GX_DB_GetT00044_01 ()
               THISFORM.A24ArtCpr = THISFORM.AV16Artcpr
               THISFORM.A28ArtVta = THISFORM.AV17Artvta
               IF THISFORM.A28ArtVta = "S"
                  THISFORM.A20ArtCtrS = "G"
               ENDIF
               DO CASE
                  CASE THISFORM.A28ArtVta = "S"
                     THISFORM.A19ArtTip = "PF"
                  CASE THISFORM.A24ArtCpr = "S"
                     THISFORM.A19ArtTip = "MP"
               ENDCASE
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               THISFORM.Gx_mode = "UPD"
               IF THISFORM.Gx_mode = 'DLT' .OR. THISFORM.Gx_mode = 'UPD'
                  THISFORM.A3FamCod = THISFORM.AV12Famcod
               ENDIF
               THISFORM. cCT4A3 .Refresh()
               IF THISFORM.Gx_mode = 'DLT' .OR. THISFORM.Gx_mode = 'UPD'
                  THISFORM.A4FamSubCo = THISFORM.AV13Famsub
               ENDIF
               THISFORM. cCT4A4 .Refresh()
               IF THISFORM.Gx_mode = 'INS' .AND. EMPTY( THISFORM.A5ArtCod ) .AND. .T.
                  THISFORM.A5ArtCod = THISFORM.AV14Artcod
               ENDIF
               THISFORM. cCT4A5 .Refresh()
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00044,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00044) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00044 = Gx_err
               THISFORM.GX_DB_GetT00044_01 ()
               IF THISFORM.T00044 = 101
                  DO GX_ERRMW WITH "No existe Empres" + "."
                  GX_buttpress = 0
                  RETURN .F.
               ENDIF
               THISFORM.Gx_mode = "DSP"
            ENDIF
            THISFORM.U11042 ()
            IF TYPE( "OCT4" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            THISFORM.SetLevel( 2 )
            THISFORM.GX_last_fld_lvl = 2
            IF ! THISFORM.InitLevels( 2 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               IF THISFORM. cCT4A5 .MV(5) != 0
                  THISFORM.SaveMode( "INS" ,"")
               ELSE
                  THISFORM.LoadObj(4)
               ENDIF
            ENDIF
