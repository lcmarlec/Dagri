         THISFORM. A2EmpCod = PA2EmpCod
         THISFORM. AV6Fechasi = PAV6Fechasi
         THISFORM. AV16Artcpr = PAV16Artcpr
         THISFORM. AV17Artvta = PAV17Artvta
         THISFORM. AV9Usuario = PAV9Usuario
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00042" , @HStmt_T00042 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTINS","T00042","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00042) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCpr], [ArtVta], [ArtCtrStk], "
            cmdbuf = cmdbuf + "  [ArtTip], [ArtDsc], [ArtNim], [ArtUni], [ArtPtoRep], [ArtStk], [ArtCodBar] FROM "
            cmdbuf = cmdbuf + "  [ARTICS] (UPDLOCK) WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00042,cmdbuf)
            THISFORM.GX_DB_BindColsT00042_01 ()
            THISFORM.GX_DB_BindParmT00042_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00043" , @HStmt_T00043 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTINS","T00043","",GX_CURSOR_TYPE_READONLY,@HStmt_T00043) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCpr], [ArtVta], [ArtCtrStk], "
            cmdbuf = cmdbuf + "  [ArtTip], [ArtDsc], [ArtNim], [ArtUni], [ArtPtoRep], [ArtStk], [ArtCodBar] FROM "
            cmdbuf = cmdbuf + "  [ARTICS] (NOLOCK) WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] "
            cmdbuf = cmdbuf + "  = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00043,cmdbuf)
            THISFORM.GX_DB_BindColsT00043_01 ()
            THISFORM.GX_DB_BindParmT00043_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00044" , @HStmt_T00044 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTINS","T00044","",GX_CURSOR_TYPE_READONLY,@HStmt_T00044) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod] FROM [EMPRES] (NOLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00044,cmdbuf)
            THISFORM.GX_DB_BindColsT00044_01 ()
            THISFORM.GX_DB_BindParmT00044_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00045" , @HStmt_T00045 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTINS","T00045","",GX_CURSOR_TYPE_READONLY,@HStmt_T00045) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [FamDsc] FROM [FAMILS] (NOLOCK) WHERE [FamCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00045,cmdbuf)
            THISFORM.GX_DB_BindColsT00045_01 ()
            THISFORM.GX_DB_BindParmT00045_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00046" , @HStmt_T00046 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTINS","T00046","",GX_CURSOR_TYPE_READONLY,@HStmt_T00046) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [FamSubDsc] FROM [SUBFAM] (NOLOCK) WHERE [FamCod] = ? AND [FamSubCod] = ? "
            cmdbuf = cmdbuf + "   "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00046,cmdbuf)
