      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05552" , @HStmt_W05552 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00G1","W05552","",GX_CURSOR_TYPE_READONLY,@HStmt_W05552) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [EntLgDsc], [EntLgDom], [EntLgFVt], [EntLgMunCo], [EntLgPciCo], "
                  cmdbuf = cmdbuf + "  [EntLgPaiCo], [EntLgCod], [EntCod], [EntGruTip] FROM [CLTES] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE ([EmpCod] = ?) AND ([EntGruTip] like ?) AND ([EntCod] >= ?) AND ([EntLgCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([EntLgDsc] like ?) AND ([EntLgDom] like ?) AND ([EntLgPaiCo] like ?) "
                  cmdbuf = cmdbuf + "  ORDER BY [EmpCod], [EntGruTip], [EntCod], [EntLgCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05552,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05552,9)
                  THISFORM.GX_DB_BindColsW05552_01 ()
                  THISFORM.GX_DB_BindParmW05552_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05552,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05552,2,PADR( TRIM(THISFORM.AV5C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV5C150),2, '%')),0)
               AuxAV6C120 = THISFORM.AV6C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05552,3,@AuxAV6C120,0)
               THISFORM.AV6C120 = AuxAV6C120
               AuxAV7C176 = THISFORM.AV7C176
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05552,4,@AuxAV7C176,0)
               THISFORM.AV7C176 = AuxAV7C176
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05552,5,PADR( TRIM(THISFORM.AV8C177),30, '%'),LEN(PADR( TRIM(THISFORM.AV8C177),30, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05552,6,PADR( TRIM(THISFORM.AV9C178),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C178),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05552,7,PADR( TRIM(THISFORM.AV10C179),4, '%'),LEN(PADR( TRIM(THISFORM.AV10C179),4, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05552) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05552 = Gx_err
               THISFORM.GX_DB_GetW05552_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05552 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05552) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05552 = Gx_err
                  THISFORM.GX_DB_GetW05552_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
