      PROCEDURE Option2.LostFocus
         THIS.Parent.LostFocus
      ENDPROC
      PROCEDURE Option2.GotFocus
         THIS.Parent.gx_current_option = 2
         THIS.Parent.GotFocus
      ENDPROC
      PROCEDURE Option2.KeyPress(gx_key, gx_shift)
         THISFORM.gx_ctrReadkey = gx_key
         IF gx_key = 13
            NODEFAULT
            KEYBOARD "{TAB}"
         ENDIF
      ENDPROC
      PROCEDURE LoadLocalVar
         THISFORM.AV18Orden = THIS.GetValue()
      ENDPROC
      PROCEDURE Refresh
         THIS.SetValue( THISFORM.AV18Orden )
         CGXRadioButton ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
   ENDDEFINE
