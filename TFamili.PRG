         THISFORM.A3FamCod = AuxA3FamCod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00533) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDDO
         THISFORM.T00533 = Gx_err
         THISFORM.GX_DB_GetT00533_01 ()
         THISFORM. cCT53A3 . ZM1H55 ( 7 )
         IF THISFORM.T00533 <> 101
