      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 55
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT53A3 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT53A3 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 55
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3FamCod = THISFORM.A3FamCod
                  Gx_err = GX_DB_SetInt( HStmt_T00533,1,@AuxA3FamCod,0)
                  THISFORM.A3FamCod = AuxA3FamCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00533) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00533 = Gx_err
                  THISFORM.GX_DB_GetT00533_01 ()
                  THISFORM. cCT53A3 . ZM1H55 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC1H55 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00538" , @HStmt_T00538 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TFAMILI","T00538","",GX_CURSOR_TYPE_READONLY,@HStmt_T00538) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [FamCod] FROM [SUBFAM] (NOLOCK) WHERE [FamCod] = ?  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00538,cmdbuf)
                  THISFORM.GX_DB_BindColsT00538_01 ()
                  THISFORM.GX_DB_BindParmT00538_01 ()
               ENDIF
               AuxBuf_T00533_3FamCod = THISFORM.Buf_T00533_3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00538,1,@AuxBuf_T00533_3FamCod,0)
               THISFORM.Buf_T00533_3FamCod = AuxBuf_T00533_3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00538) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00538 = Gx_err
               THISFORM.GX_DB_GetT00538_01 ()
               IF THISFORM.T00538 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00538) , "TFAMILI" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " SubFam "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00538) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT53A3 . ZM1H55 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1H55 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT53A15 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE1H55 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC1H55 ()
                  RETURN
               ENDIF
               THISFORM.cCT53A3.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00533) , "TFAMILI" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00532) , "TFAMILI" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT53A15 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT53A3 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

