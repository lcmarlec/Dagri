      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA3FamCod = THISFORM.A3FamCod
            Gx_err = GX_DB_SetInt( HStmt_T00532,1,@AuxA3FamCod,0)
            THISFORM.A3FamCod = AuxA3FamCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00532) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00532 = Gx_err
            THISFORM.GX_DB_GetT00532_01 ()
            IF .NOT. THISFORM.T00532 <> 103
               DO GX_ERRMW WITH "FAMILS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00532 = 101 .OR. THISFORM.Z15FamDsc <> THISFORM.Buf_T00532_15FamDsc
               DO GX_ERRMW WITH "FAMILS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00535" , @HStmt_T00535 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TFAMILI","T00535","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00535) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [FAMILS] ([FamCod], [FamDsc]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00535,cmdbuf)
                  THISFORM.GX_DB_BindParmT00535_01 ()
               ENDIF
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00535,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA15FamDsc = THISFORM.A15FamDsc
               Gx_err = GX_DB_SetStr( HStmt_T00535,2,AuxA15FamDsc,40,0)
               THISFORM.A15FamDsc = AuxA15FamDsc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00535) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00535 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00535) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00535 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00536" , @HStmt_T00536 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TFAMILI","T00536","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00536) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [FAMILS] SET [FamDsc]=?  WHERE [FamCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00536,cmdbuf)
                  THISFORM.GX_DB_BindParmT00536_01 ()
               ENDIF
               AuxA15FamDsc = THISFORM.A15FamDsc
               Gx_err = GX_DB_SetStr( HStmt_T00536,1,AuxA15FamDsc,40,0)
               THISFORM.A15FamDsc = AuxA15FamDsc
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00536,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00536) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00536 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00536) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00537" , @HStmt_T00537 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TFAMILI","T00537","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00537) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [FAMILS]  WHERE [FamCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00537,cmdbuf)
                  THISFORM.GX_DB_BindParmT00537_01 ()
               ENDIF
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00537,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00537) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00537 = Gx_err
               THISFORM.T00532 = iif( THISFORM.T00537 = 0 , 104 , THISFORM.T00537 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00537) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A3FamCod , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "TABL" , Aux1 , "FLIA" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT53V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 55 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
