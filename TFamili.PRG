      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00534" , @HStmt_T00534 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TFAMILI","T00534","",GX_CURSOR_TYPE_READONLY,@HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [FamCod], [FamDsc] FROM [FAMILS] (FASTFIRSTROW NOLOCK) WHERE [FamCod] >= ? "
            cmdbuf = cmdbuf + "  ORDER BY [FamCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00534,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00534,100)
            THISFORM.GX_DB_BindColsT00534_01 ()
            THISFORM.GX_DB_BindParmT00534_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A3FamCod = 0
               ENDIF
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00534,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00534 = Gx_err
               THISFORM.GX_DB_GetT00534_01 ()
               Gx_fcond = THISFORM.T00534 <> 101
            CASE GXOP = 2 && Next record
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00534,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00534 = Gx_err
               THISFORM.GX_DB_GetT00534_01 ()
               DO WHILE THISFORM.T00534 = 0 .AND. THISFORM.A3FamCod >= THISFORM.Buf_T00534_3FamCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00534 = Gx_err
                  THISFORM.GX_DB_GetT00534_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00534 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A3FamCod = 0
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00534,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00534 = Gx_err
               THISFORM.GX_DB_GetT00534_01 ()
               DO WHILE THISFORM.T00534 = 0
                  THISFORM.A3FamCod = THISFORM.Buf_T00534_3FamCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00534 = Gx_err
                  THISFORM.GX_DB_GetT00534_01 ()
               ENDDO
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T00534,1,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00534) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00534 = Gx_err
               THISFORM.GX_DB_GetT00534_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A3FamCod = THISFORM.Buf_T00534_3FamCod
               THISFORM.A15FamDsc = THISFORM.Buf_T00534_15FamDsc
         ENDCASE
         Gx_fcond = THISFORM.T00534 <> 101 .AND. THISFORM.T00534 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

      ***********************
      PROCEDURE ZM1H55
      ***********************

         PARAMETERS GX_JID
         IF GX_JID = 7 .OR. GX_JID = 0
            THISFORM.Z15FamDsc = THISFORM.Buf_T00533_15FamDsc
         ENDIF
      RETURN

