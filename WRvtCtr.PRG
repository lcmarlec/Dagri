      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08302" , @HStmt_W08302 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRVTCTR","W08302","",GX_CURSOR_TYPE_READONLY,@HStmt_W08302) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RVtEntGruT] AS RVtEntGruT, T1.[RVtEntLgCo] AS RVtEntLgCo, T1.[RVtPedNro], "
                  cmdbuf = cmdbuf + "  T1.[RVtNroInt], T1.[RvtCtrl], T1.[RVtEst], T1.[RvtSegObs2], T1.[RvtLE], T1.[RvtFac], "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T1.[RvtSegObs1], T3.[EntLgDom], T2.[EntRaz] AS RVtEntRaz, T1.[RVtEntCod] "
                  cmdbuf = cmdbuf + "  AS RVtEntCod, T1.[RVtFch], T1.[RVtNro], T1.[RVtSuc] FROM (([REMVTA] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[RVtEntGruT] AND T2.[EntCod] = T1.[RVtEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[RVtEntGruT] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[RVtEntCod] AND T3.[EntLgCod] = T1.[RVtEntLgCo]) WHERE (T1.[EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[RVtFch] >= ?) AND (T1.[RVtEntCod] >= ?) AND (T1.[RVtEntCod] <= ? or ? = 0) AND "
                  cmdbuf = cmdbuf + "  (T1.[RvtCtrl] < 1) AND (T1.[RVtPedNro] = ? or ? = 0) AND (T1.[RVtEst] = 1) AND (T1.[RVtNro] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[RVtNro] <= ?) AND (T1.[RVtFch] <= ?) ORDER BY T1.[EmpCod], T1.[RVtFch], "
                  cmdbuf = cmdbuf + "  T1.[RVtSuc], T1.[RVtNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08302,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08302,13)
                  THISFORM.GX_DB_BindColsW08302_01 ()
                  THISFORM.GX_DB_BindParmW08302_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08302,1,@AuxAV8Emprcod,0)
