      PROCEDURE CreateTemp
         LOCAL SCW61S19
         SCW61S19 = ""
         IF USED( "SCW61S19" )
            SELECT SCW61S19
            SCW61S19 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW61S19
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA586ForFa"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA587ForFa"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA588ForAr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA589ForAr"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA591ForFc"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA590ForNr"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA594ForDi"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 1
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW61S19 = GETE('z:\temp') + '\' + SCW61S19
            ENDIF
            CREATE DBF (SCW61S19) FROM ARRAY GX_STRUCT
            USE
            USE (SCW61S19) EXCLUSIVE ALIAS SCW61S19
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW61S19
         THIS.GX_SfAlias = "SCW61S19"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00612" , @HStmt_W00612 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFORPRO","W00612","",GX_CURSOR_TYPE_READONLY,@HStmt_W00612) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[ForDis], T1.[ForNro], T1.[ForFch], T2.[ArtDsc] AS ForArtDsc, "
                  cmdbuf = cmdbuf + "  T1.[ForArtCod] AS ForArtCod, T1.[ForFamSubC] AS ForFamSubC, T1.[ForFamCod] AS ForFamCod "
                  cmdbuf = cmdbuf + "  FROM ([FORPRO] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[FamCod] = T1.[ForFamCod] AND T2.[FamSubCod] = T1.[ForFamSubC] "
                  cmdbuf = cmdbuf + "  AND T2.[ArtCod] = T1.[ForArtCod]) WHERE (T1.[EmpCod] = ? and T1.[ForFamCod] >= ? "
                  cmdbuf = cmdbuf + "  and T1.[ForFamSubC] >= ? and T1.[ForArtCod] >= ?) AND (T1.[ForFch] >= ?) ORDER BY "
                  cmdbuf = cmdbuf + "  T1.[EmpCod], T1.[ForFamCod], T1.[ForFamSubC], T1.[ForArtCod], T1.[ForNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00612,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00612,15)
                  THISFORM.GX_DB_BindColsW00612_01 ()
                  THISFORM.GX_DB_BindParmW00612_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00612,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV13Desfam = THISFORM.AV13Desfam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00612,2,@AuxAV13Desfam,0)
               THISFORM.AV13Desfam = AuxAV13Desfam
               AuxAV14Dessub = THISFORM.AV14Dessub
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00612,3,@AuxAV14Dessub,0)
               THISFORM.AV14Dessub = AuxAV14Dessub
               AuxAV15Descod = THISFORM.AV15Descod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00612,4,@AuxAV15Descod,0)
               THISFORM.AV15Descod = AuxAV15Descod
               AuxAV12Desfec = THISFORM.AV12Desfec
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00612,5,@AuxAV12Desfec,0)
               THISFORM.AV12Desfec = AuxAV12Desfec
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00612) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00612 = Gx_err
               THISFORM.GX_DB_GetW00612_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV21Pgmnam = "WForPro"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00612 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00612) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00612 = Gx_err
                  THISFORM.GX_DB_GetW00612_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00612 <> 101
               BRKV1P2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W00612_2EmpCod
               THISFORM.A594ForDis = THISFORM.Buf_W00612_594ForDis
               THISFORM.A590ForNro = THISFORM.Buf_W00612_590ForNro
               THISFORM.A591ForFch = THISFORM.Buf_W00612_591ForFch
               THISFORM.A589ForArt = THISFORM.Buf_W00612_589ForArtDsc
               THISFORM.A588ForArt = THISFORM.Buf_W00612_588ForArtCod
               THISFORM.A587ForFam = THISFORM.Buf_W00612_587ForFamSubC
               THISFORM.A586ForFam = THISFORM.Buf_W00612_586ForFamCod
               THISFORM.A589ForArt = THISFORM.Buf_W00612_589ForArtDsc
               GX_SFLOAD = 0
               THISFORM.U18V1P2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00612) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00612 = Gx_err
               THISFORM.GX_DB_GetW00612_01 ()
            ENDDO
         ENDIF
      ENDPROC
