            SELECT ( THISFORM.cCW1261S20 .GX_SfAlias)
            GO TOP
            THISFORM.cCW1261S20 .Refresh()
         ENDIF
         THISFORM. cCW1261S20 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW1261S20 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
