         SELECT (THIS.GX_SfAlias)
         REPLACE sA3356CarN WITH THISFORM.A3356CarNr
         REPLACE sA3670CarH WITH THISFORM.A3670CarHo
         REPLACE VAV31Sel WITH THISFORM.cCW1277S15.Columns(3).Ctrl1.ValToText(THISFORM.AV31Sel)
         REPLACE sA3359CarR WITH THISFORM.A3359CarRu
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A3356CarNr = sA3356CarN
         THISFORM.A3670CarHo = sA3670CarH
         THISFORM.AV31Sel = THISFORM.cCW1277S15.Columns(3).Ctrl1.TextToVal(VAV31Sel,"int",1)
         THISFORM.A3359CarRu = sA3359CarR
      ENDPROC
      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 3
            THISFORM.AV31Sel = THISFORM.cCW1277S15.Columns(3).Ctrl1.TextToVal(THIS.Column3.Ctrl1.Value,"int",1)
         ENDIF
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A3356CarNr = SPACE(15)
         THISFORM.A3670CarHo = SPACE(8)
         THISFORM.AV31Sel = 0
         THISFORM.A3359CarRu = 0
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
      PROCEDURE BeforeRowChange
      ENDPROC
      PROCEDURE AfterRowChange
      ENDPROC
      PROCEDURE DblClick
         THISFORM.U12VZH2 ()
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE Click
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE CallRefreshEvent
         THISFORM.cCW1277S15.GXRefreshEvt ()
      ENDPROC
      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW1277S15 .GX_SfAlias)
            GO TOP
            THISFORM.cCW1277S15 .Refresh()
         ENDIF
         THISFORM. cCW1277S15 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW1277S15 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
