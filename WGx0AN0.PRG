      PROCEDURE CreateTemp
         LOCAL SCW1158S20
         SCW1158S20 = ""
         IF USED( "SCW1158S20" )
            SELECT SCW1158S20
            SCW1158S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1158S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3356CarN"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 15
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3357CarF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3358CarO"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3359CarR"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3671CarE"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 2
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1158S20 = GETE('z:\temp') + '\' + SCW1158S20
            ENDIF
            CREATE DBF (SCW1158S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1158S20) EXCLUSIVE ALIAS SCW1158S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1158S20
         THIS.GX_SfAlias = "SCW1158S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11582" , @HStmt_W11582 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0AN0","W11582","",GX_CURSOR_TYPE_READONLY,@HStmt_W11582) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CarHor], [CarEst], [CarRut], [CarOrd], [CarFch], [CarNro], [EmpCod] FROM "
                  cmdbuf = cmdbuf + "  [CARGA] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([CarNro] like ?) AND ([CarFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([CarOrd] >= ?) AND ([CarRut] >= ?) AND ([CarHor] like ?) AND ([CarEst] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [CarNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11582,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11582,9)
                  THISFORM.GX_DB_BindColsW11582_01 ()
                  THISFORM.GX_DB_BindParmW11582_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11582,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11582,2,PADR( TRIM(THISFORM.AV6C3356),15, '%'),LEN(PADR( TRIM(THISFORM.AV6C3356),15, '%')),0)
               AuxAV7C3357 = THISFORM.AV7C3357
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11582,3,@AuxAV7C3357,0)
               THISFORM.AV7C3357 = AuxAV7C3357
               AuxAV8C3358 = THISFORM.AV8C3358
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11582,4,@AuxAV8C3358,0)
               THISFORM.AV8C3358 = AuxAV8C3358
               AuxAV9C3359 = THISFORM.AV9C3359
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11582,5,@AuxAV9C3359,0)
               THISFORM.AV9C3359 = AuxAV9C3359
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11582,6,PADR( TRIM(THISFORM.AV10C3670),8, '%'),LEN(PADR( TRIM(THISFORM.AV10C3670),8, '%')),0)
               AuxAV11C3671 = THISFORM.AV11C3671
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11582,7,@AuxAV11C3671,0)
               THISFORM.AV11C3671 = AuxAV11C3671
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11582 = Gx_err
               THISFORM.GX_DB_GetW11582_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11582 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11582) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11582 = Gx_err
                  THISFORM.GX_DB_GetW11582_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11582 <> 101
               BRKVW62 = .F.
               THISFORM.A3670CarHo = THISFORM.Buf_W11582_3670CarHor
               THISFORM.A3671CarEs = THISFORM.Buf_W11582_3671CarEst
               THISFORM.A3359CarRu = THISFORM.Buf_W11582_3359CarRut
               THISFORM.A3358CarOr = THISFORM.Buf_W11582_3358CarOrd
               THISFORM.A3357CarFc = THISFORM.Buf_W11582_3357CarFch
               THISFORM.A3356CarNr = THISFORM.Buf_W11582_3356CarNro
               THISFORM.A2EmpCod = THISFORM.Buf_W11582_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VW62 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11582 = Gx_err
               THISFORM.GX_DB_GetW11582_01 ()
            ENDDO
         ENDIF
      ENDPROC
