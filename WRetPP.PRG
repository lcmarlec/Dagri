      ***********************
      PROCEDURE U12VXD2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         Response = .T.
         DO GX_CONFW WITH 'Confirma la actualizacion de datos?' , Response
         IF Response
            LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
            GX_SFERR = 0
            Gx_fel_sel = .T.
            gxO_Rec = 0
            SELECT( THISFORM.cCW1201S10 .GX_SfAlias)
            gxO_Rec1 = IIF(EOF(), 0, RECNO())
            THISFORM.cCW1201S10.SF (8, @GX_SFERR)
            DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
               THISFORM.cCW1201S10.SF (3, @GX_SFERR)
               THISFORM.cCW1201S10 .SaveGridPos()
               IF THISFORM.AV18Retfch <> THISFORM.A3469Retfc .OR. THISFORM.AV19Retfch <> THISFORM.A3464RetFc
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV8Emprcod
                  Aux1 = THISFORM.A937RetNro
                  Aux2 = THISFORM.AV18Retfch
                  Aux3 = THISFORM.AV19Retfch
                  Aux4 = THISFORM.AV24Usuari
                  DO PRetPP WITH Aux0 , Aux1 , Aux2 , Aux3 , Aux4
                  THISFORM.AV8Emprcod = Aux0
                  THISFORM.A937RetNro = Aux1
                  THISFORM.AV18Retfch = Aux2
                  THISFORM.AV19Retfch = Aux3
                  THISFORM.AV24Usuari = Aux4
                  THISFORM. cCW1201S10 .RestoreGridPos()
                  THISFORM. cCW1201S10.Columns(8).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW1201S10.Columns(9).Ctrl1 .RefreshSfAtt()
                  THISFORM. cCW1201S10 .GX_rec_modif = .T.
                  THISFORM. cCW1201S10 .GX_LastVld1 = THISFORM. cCW1201S10.Columns(8).Ctrl1 .GXColumnNo - 1
                  GX_rploop = .T.
               ENDIF
               IF Gx_fel_sel
                  THISFORM.cCW1201S10 .RestoreGridPos()
                  THISFORM.cCW1201S10.SF (4, @GX_SFERR)
                  THISFORM.cCW1201S10.SF (9, @GX_SFERR)
               ENDIF
            ENDDO
            THISFORM.cCW1201S10 .ResetSavedGridPos()
            SELECT( THISFORM.cCW1201S10 .GX_SfAlias)
            IF gxO_Rec1 != 0
               GOTO (gxO_Rec1)
               THISFORM.cCW1201S10.SF (3, @GX_SFERR)
            ENDIF
         ENDIF
         THISFORM.GX_Refresh = 2   &&& Refresh Keep
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

