      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12012" , @HStmt_W12012 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRETPP","W12012","",GX_CURSOR_TYPE_READONLY,@HStmt_W12012) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RetEntGruT] AS RetEntGruT, T1.[EmpCod], T1.[RetNroI], T1.[RetFchPag], "
                  cmdbuf = cmdbuf + "  T1.[Retfchinf], T1.[RetAnt], T1.[RetNIRc], T1.[RetEst], T1.[RetTot], T1.[RetFch], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz] AS RetEntRaz, T1.[RetEntCod] AS RetEntCod, T1.[RetNro], T1.[RetSer], "
                  cmdbuf = cmdbuf + "  T1.[RetTip] FROM ([RETEN] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[RetEntGruT] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[RetEntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[RetFch] >= ?) AND (T1.[RetNro] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[RetEntCod] = ? or ? = convert(int, 0)) AND (? = 9 or ( T1.[Retfchinf] "
                  cmdbuf = cmdbuf + "  = convert( DATETIME, '17530101', 112 ) and ? = 1) or ( T1.[RetFchPag] = convert( "
                  cmdbuf = cmdbuf + "  DATETIME, '17530101', 112 ) and ? = 0)) AND (T1.[RetTip] = 'RET742' or T1.[RetTip] "
                  cmdbuf = cmdbuf + "  = 'RETSUS') AND (T1.[RetEst] < 9) ORDER BY T1.[EmpCod], T1.[RetNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12012,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12012,15)
                  THISFORM.GX_DB_BindColsW12012_01 ()
                  THISFORM.GX_DB_BindParmW12012_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12012,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Desfch = THISFORM.AV21Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12012,2,@AuxAV21Desfch,0)
               THISFORM.AV21Desfch = AuxAV21Desfch
               AuxAV20Desnro = THISFORM.AV20Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12012,3,@AuxAV20Desnro,0)
               THISFORM.AV20Desnro = AuxAV20Desnro
               AuxAV23Desprv = THISFORM.AV23Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12012,4,@AuxAV23Desprv,0)
               THISFORM.AV23Desprv = AuxAV23Desprv
               AuxAV23Desprv = THISFORM.AV23Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12012,5,@AuxAV23Desprv,0)
               THISFORM.AV23Desprv = AuxAV23Desprv
               AuxAV22Estado = THISFORM.AV22Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12012,6,@AuxAV22Estado,0)
               THISFORM.AV22Estado = AuxAV22Estado
               AuxAV22Estado = THISFORM.AV22Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12012,7,@AuxAV22Estado,0)
               THISFORM.AV22Estado = AuxAV22Estado
               AuxAV22Estado = THISFORM.AV22Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12012,8,@AuxAV22Estado,0)
               THISFORM.AV22Estado = AuxAV22Estado
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12012) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12012 = Gx_err
               THISFORM.GX_DB_GetW12012_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WRetPP"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12012 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12012) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12012 = Gx_err
                  THISFORM.GX_DB_GetW12012_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12012 <> 101
               BRKVXD2 = .F.
               THISFORM.AV18Retfch = CTOD("  /  /  ")
               THISFORM.AV19Retfch = CTOD("  /  /  ")
               THISFORM.A941RetEnt = THISFORM.Buf_W12012_941RetEntGruT
               THISFORM.A2EmpCod = THISFORM.Buf_W12012_2EmpCod
               THISFORM.A937RetNro = THISFORM.Buf_W12012_937RetNroI
               THISFORM.A3464RetFc = THISFORM.Buf_W12012_3464RetFchPag
               THISFORM.A3469Retfc = THISFORM.Buf_W12012_3469Retfchinf
               THISFORM.A959RetAnt = THISFORM.Buf_W12012_959RetAnt
               THISFORM.A948RetNIR = THISFORM.Buf_W12012_948RetNIRc
               THISFORM.A940RetEst = THISFORM.Buf_W12012_940RetEst
               THISFORM.A958RetTot = THISFORM.Buf_W12012_958RetTot
               THISFORM.A938RetFch = THISFORM.Buf_W12012_938RetFch
               THISFORM.A943RetEnt = THISFORM.Buf_W12012_943RetEntRaz
               THISFORM.A942RetEnt = THISFORM.Buf_W12012_942RetEntCod
               THISFORM.A947RetNro = THISFORM.Buf_W12012_947RetNro
               THISFORM.A945RetSer = THISFORM.Buf_W12012_945RetSer
               THISFORM.A944RetTip = THISFORM.Buf_W12012_944RetTip
               THISFORM.A943RetEnt = THISFORM.Buf_W12012_943RetEntRaz
               GX_SFLOAD = 0
               THISFORM.U17VXD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12012) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12012 = Gx_err
               THISFORM.GX_DB_GetW12012_01 ()
            ENDDO
         ENDIF
      ENDPROC
