      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04272" , @HStmt_W04272 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04B2","W04272","",GX_CURSOR_TYPE_READONLY,@HStmt_W04272) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[Moncod], T1.[EmpCod], T1.[EjeNro], T1.[AsiTMonCod], T2.[MonDsc], T1.[AsiTUsu], "
                  cmdbuf = cmdbuf + "  T1.[AsiTDate], T1.[AsiTDes], T1.[AsiTCod] FROM ([ASITPO] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [MONEDA] T2 (NOLOCK) ON T2.[Moncod] = T1.[AsiTMonCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[EjeNro] = ? and T1.[AsiTCod] >= ?) AND (T1.[AsiTMonCod] >= ?) AND (T2.[MonDsc] "
                  cmdbuf = cmdbuf + "  like ?) AND (T1.[AsiTUsu] like ?) AND (T1.[AsiTDate] >= ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[EjeNro], T1.[AsiTCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04272,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04272,8)
                  THISFORM.GX_DB_BindColsW04272_01 ()
                  THISFORM.GX_DB_BindParmW04272_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04272,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA548EjeNro = THISFORM.A548EjeNro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04272,2,@AuxA548EjeNro,0)
               THISFORM.A548EjeNro = AuxA548EjeNro
               AuxAV20C1368 = THISFORM.AV20C1368
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04272,3,@AuxAV20C1368,0)
               THISFORM.AV20C1368 = AuxAV20C1368
               AuxAV19C1370 = THISFORM.AV19C1370
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04272,4,@AuxAV19C1370,0)
               THISFORM.AV19C1370 = AuxAV19C1370
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04272,5,PADR( TRIM(THISFORM.AV18C1351),40, '%'),LEN(PADR( TRIM(THISFORM.AV18C1351),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04272,6,PADR( TRIM(THISFORM.AV17C1372),10, '%'),LEN(PADR( TRIM(THISFORM.AV17C1372),10, '%')),0)
               AuxAV16C1373 = THISFORM.AV16C1373
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04272,7,@AuxAV16C1373,0)
               THISFORM.AV16C1373 = AuxAV16C1373
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04272 = Gx_err
               THISFORM.GX_DB_GetW04272_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04272 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04272) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04272 = Gx_err
                  THISFORM.GX_DB_GetW04272_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04272 <> 101
               BRKVBV2 = .F.
               THISFORM.A193Moncod = THISFORM.Buf_W04272_193Moncod
               THISFORM.A1370AsiTM = THISFORM.Buf_W04272_1370AsiTMonCod
               THISFORM.A194MonDsc = THISFORM.Buf_W04272_194MonDsc
               THISFORM.A1372AsiTU = THISFORM.Buf_W04272_1372AsiTUsu
               THISFORM.A1373AsiTD = THISFORM.Buf_W04272_1373AsiTDate
               THISFORM.A1369AsiTD = THISFORM.Buf_W04272_1369AsiTDes
               THISFORM.A1368AsiTC = THISFORM.Buf_W04272_1368AsiTCod
               THISFORM.A194MonDsc = THISFORM.Buf_W04272_194MonDsc
               GX_SFLOAD = 0
               THISFORM.U12VBV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04272) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04272 = Gx_err
               THISFORM.GX_DB_GetW04272_01 ()
            ENDDO
         ENDIF
