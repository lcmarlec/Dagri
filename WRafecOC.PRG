      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06742" , @HStmt_W06742 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRAFECOC","W06742","",GX_CURSOR_TYPE_READONLY,@HStmt_W06742) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[RORLin], T1.[EmpCod], T1.[RORNroInt], T1.[ROROCoNI], T1.[RORLes], T1.[RORCnt], "
                  cmdbuf = cmdbuf + "  T3.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod], T2.[RORFch], T2.[RORNro], "
                  cmdbuf = cmdbuf + "  T2.[RORSuc], T2.[RORror] FROM (([REMING1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [REMING] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[RORNroInt] = T1.[RORNroInt]) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] "
                  cmdbuf = cmdbuf + "  AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[ROROCoNI] = ?) AND (T1.[RORCnt] <> 0) ORDER BY T1.[EmpCod], T1.[RORNroInt], "
                  cmdbuf = cmdbuf + "  T1.[RORLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06742,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06742,16)
                  THISFORM.GX_DB_BindColsW06742_01 ()
                  THISFORM.GX_DB_BindParmW06742_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06742,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV18Oconro = THISFORM.AV18Oconro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06742,2,@AuxAV18Oconro,0)
               THISFORM.AV18Oconro = AuxAV18Oconro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06742 = Gx_err
               THISFORM.GX_DB_GetW06742_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WRafecOC"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06742 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06742) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06742 = Gx_err
                  THISFORM.GX_DB_GetW06742_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06742 <> 101
               BRKVIQ2 = .F.
               THISFORM.AV24Dccnro = 0
               THISFORM.A2EmpCod = THISFORM.Buf_W06742_2EmpCod
               THISFORM.A881RORNro = THISFORM.Buf_W06742_881RORNroInt
               THISFORM.A894ROROCo = THISFORM.Buf_W06742_894ROROCoNI
               THISFORM.A900RORLes = THISFORM.Buf_W06742_900RORLes
               THISFORM.A897RORCnt = THISFORM.Buf_W06742_897RORCnt
               THISFORM.A6ArtDsc = THISFORM.Buf_W06742_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W06742_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W06742_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W06742_3FamCod
               THISFORM.A889RORFch = THISFORM.Buf_W06742_889RORFch
               THISFORM.A888RORNro = THISFORM.Buf_W06742_888RORNro
               THISFORM.A887RORSuc = THISFORM.Buf_W06742_887RORSuc
               THISFORM.A886RORror = THISFORM.Buf_W06742_886RORror
               THISFORM.A889RORFch = THISFORM.Buf_W06742_889RORFch
               THISFORM.A888RORNro = THISFORM.Buf_W06742_888RORNro
               THISFORM.A887RORSuc = THISFORM.Buf_W06742_887RORSuc
               THISFORM.A886RORror = THISFORM.Buf_W06742_886RORror
               THISFORM.A6ArtDsc = THISFORM.Buf_W06742_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U14VIQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06742) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06742 = Gx_err
               THISFORM.GX_DB_GetW06742_01 ()
            ENDDO
