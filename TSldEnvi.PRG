      PROCEDURE CreateTemp
         LOCAL SCT259S24
         SCT259S24 = ""
         IF USED( "SCT259S24" )
            SELECT SCT259S24
            SCT259S24 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT259S24
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA561TraCo"
