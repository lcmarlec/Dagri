               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02597) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02598) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02599) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02594) , "TSLDENVI" )
               IF TYPE( "HConn_Default" ) = "N"
                  IF GXCONNECTED
                     Gx_Err = Gx_odbc_mrc( GX_DB_ConnRollback(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDIF
               ENDIF
            ELSE
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02596) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02595) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02593) , "TSLDENVI" )
