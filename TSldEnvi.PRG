      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T025917" , @HStmt_T025917 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSLDENVI","T025917","",GX_CURSOR_TYPE_READONLY,@HStmt_T025917) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [BcoCta], [SldEPer], [SldSec], [TraCod], [SldTpoI], [SldTpo], [SldImp] "
                  cmdbuf = cmdbuf + "  FROM [SLDENVI1] (NOLOCK) WHERE [EmpCod] = ? AND [BcoCta] = ? AND [SldEPer] = ? AND "
                  cmdbuf = cmdbuf + "  [SldSec] = ? ORDER BY [EmpCod], [BcoCta], [SldEPer], [SldSec], [TraCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T025917,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T025917,14)
                  THISFORM.GX_DB_BindColsT025917_01 ()
                  THISFORM.GX_DB_BindParmT025917_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T025917,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA76BcoCta = THISFORM.A76BcoCta
               Gx_err = GX_DB_SetInt( HStmt_T025917,2,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxA2543SldEP = THISFORM.A2543SldEP
               Gx_err = GX_DB_SetLong( HStmt_T025917,3,@AuxA2543SldEP,0)
               THISFORM.A2543SldEP = AuxA2543SldEP
               AuxA2544SldSe = THISFORM.A2544SldSe
               Gx_err = GX_DB_SetInt( HStmt_T025917,4,@AuxA2544SldSe,0)
               THISFORM.A2544SldSe = AuxA2544SldSe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T025917) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025917 = Gx_err
               THISFORM.GX_DB_GetT025917_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T025917 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025917) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T025917 = Gx_err
                  THISFORM.GX_DB_GetT025917_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T025917 <> 101
               BRK77284 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT259S24.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T025917_2544SldSec = THISFORM.A2544SldSe .AND. THISFORM.Buf_T025917_2543SldEPer = THISFORM.A2543SldEP .AND. THISFORM.Buf_T025917_76BcoCta = THISFORM.A76BcoCta .AND. THISFORM.Buf_T025917_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T025917) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T025917 = Gx_err
               THISFORM.GX_DB_GetT025917_01 ()
            ENDDO
         ENDIF
      ENDPROC
