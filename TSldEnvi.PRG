            GX_STRUCT[ 3 ,1]= "sA2545SldT"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 240
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3440SldT"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 240
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2546SldI"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 15
            GX_STRUCT[ 5 ,4]= 2

            GX_STRUCT[ 6 ,1]= "sA2781TraC"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 3
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA2291TraF"
            GX_STRUCT[ 7 ,2]= "D"
            GX_STRUCT[ 7 ,3]= 8
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA3263TraC"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 1
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT259S24 = GETE('z:\temp') + '\' + SCT259S24
            ENDIF
            CREATE DBF (SCT259S24) FROM ARRAY GX_STRUCT
            USE
            USE (SCT259S24) EXCLUSIVE ALIAS SCT259S24
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
