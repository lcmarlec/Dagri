               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02598) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02599) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02594) , "TSLDENVI" )
               IF TYPE( "HConn_Default" ) = "N"
                  IF GXCONNECTED
                     Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDIF
               ENDIF
               THISFORM. cCT259A2821 .AfterTrn()
               DO CASE
                  CASE THISFORM.GX_Mode = "INS"
                     THISFORM.ReleaseAll()
                  CASE THISFORM.GX_Mode = "UPD"
                     THISFORM.ReleaseAll()
                  CASE THISFORM.GX_Mode = "DLT"
                     THISFORM.ReleaseAll()
               ENDCASE
            ENDIF
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 283
            IF ! THISFORM. gx_283insert
               THISFORM.SetLevel( 283 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_283insert
            THISFORM. gx_283insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 283 )
            THISFORM. cCT259A2543 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
