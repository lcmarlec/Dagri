      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl = 283
            IF ! THISFORM. gx_283insert
               THISFORM.SetLevel( 283 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 283
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 283 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Response = .T.
            DO GX_CONFW WITH 'Confirma la transacción?' , Response
            Gx_ucfrm  = .T.
            IF .NOT. Response
               * Rollback TRANSACTION
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02596) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02595) , "TSLDENVI" )
               Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02593) , "TSLDENVI" )
