            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S76BcoCta = THISFORM.A76BcoCta .AND. S2543SldEP = THISFORM.A2543SldEP .AND. S2544SldSe = THISFORM.A2544SldSe .AND. S561TraCod = THISFORM.A561TraCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT259S24 .Refresh()
               THISFORM. cCT259S24 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A76BcoCta = S76BcoCta
               THISFORM.A2543SldEP = S2543SldEP
               THISFORM.A2544SldSe = S2544SldSe
               THISFORM.A561TraCod = S561TraCod
