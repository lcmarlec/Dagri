         THISFORM.LockScreen = .T.
         THISFORM. cCT259S24 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT259S24 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S76BcoCta = THISFORM.A76BcoCta .AND. S2543SldEP = THISFORM.A2543SldEP .AND. S2544SldSe = THISFORM.A2544SldSe .AND. S561TraCod = THISFORM.A561TraCod
