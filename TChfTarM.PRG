            THISFORM.A1822chTKg = THISFORM.Buf_T018217_1822chTKgMunCo
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A1823ChTTa"
