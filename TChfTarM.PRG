      PROCEDURE CreateTemp
         LOCAL SCT182S10
         SCT182S10 = ""
         IF USED( "SCT182S10" )
            SELECT SCT182S10
            SCT182S10 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT182S10
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA1822chTK"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1826chtk"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 70
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1823ChTT"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 4

            GX_STRUCT[ 4 ,1]= "sA635MunCo"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA633PciCo"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA631PaiCo"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA636MunDs"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 70
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('c:\temp')
               SCT182S10 = GETE('c:\temp') + '\' + SCT182S10
            ENDIF
            CREATE DBF (SCT182S10) FROM ARRAY GX_STRUCT
            USE
            USE (SCT182S10) EXCLUSIVE ALIAS SCT182S10
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT182S10
         THIS.GX_SfAlias = "SCT182S10"
      ENDPROC
