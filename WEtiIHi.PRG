               THISFORM. cCW983A2976 .Refresh()
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09832 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09832) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09832 = Gx_err
                  THISFORM.GX_DB_GetW09832_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09832 <> 101
               BRKVRB2 = .F.
               THISFORM.A3FamCod = THISFORM.Buf_W09832_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W09832_4FamSubCod
               THISFORM.A2974EtACn = THISFORM.Buf_W09832_2974EtACnt
               THISFORM.A2973EtAVe = THISFORM.Buf_W09832_2973EtAVenc
               THISFORM.A2972EtALo = THISFORM.Buf_W09832_2972EtALote
               THISFORM.A2971EtaEl = THISFORM.Buf_W09832_2971EtaElab
               THISFORM.A6ArtDsc = THISFORM.Buf_W09832_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W09832_5ArtCod
               THISFORM.A2868LiPrD = THISFORM.Buf_W09832_2868LiPrDsc
               THISFORM.A2981ETAIC = THISFORM.Buf_W09832_2981ETAICnt
               THISFORM.A2980EtAIF = THISFORM.Buf_W09832_2980EtAIFH
               THISFORM.A2979ETAIU = THISFORM.Buf_W09832_2979ETAIUsu
               THISFORM.A2868LiPrD = THISFORM.Buf_W09832_2868LiPrDsc
               THISFORM.A3FamCod = THISFORM.Buf_W09832_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W09832_4FamSubCod
               THISFORM.A2974EtACn = THISFORM.Buf_W09832_2974EtACnt
               THISFORM.A2973EtAVe = THISFORM.Buf_W09832_2973EtAVenc
               THISFORM.A2972EtALo = THISFORM.Buf_W09832_2972EtALote
               THISFORM.A2971EtaEl = THISFORM.Buf_W09832_2971EtaElab
               THISFORM.A5ArtCod = THISFORM.Buf_W09832_5ArtCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W09832_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U13VRB2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09832) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09832 = Gx_err
               THISFORM.GX_DB_GetW09832_01 ()
            ENDDO
         ENDIF
