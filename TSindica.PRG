      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2299SCoCo = THISFORM.A2299SCoCo
            Gx_err = GX_DB_SetLong( HStmt_T02362,1,@AuxA2299SCoCo,0)
            THISFORM.A2299SCoCo = AuxA2299SCoCo
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02362) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02362 = Gx_err
            THISFORM.GX_DB_GetT02362_01 ()
            IF .NOT. THISFORM.T02362 <> 103
               DO GX_ERRMW WITH "SINDICAT reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02362 = 101 .OR. THISFORM.Z2300ScoDs <> THISFORM.Buf_T02362_2300ScoDsc
               DO GX_ERRMW WITH "SINDICAT fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02365" , @HStmt_T02365 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSINDICA","T02365","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02365) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [SINDICAT] ([SCoCod], [ScoDsc], [ScoDir], [ScoContact], [ScoTel]) VALUES "
                  cmdbuf = cmdbuf + "  (?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02365,cmdbuf)
                  THISFORM.GX_DB_BindParmT02365_01 ()
               ENDIF
               AuxA2299SCoCo = THISFORM.A2299SCoCo
               Gx_err = GX_DB_SetLong( HStmt_T02365,1,@AuxA2299SCoCo,0)
               THISFORM.A2299SCoCo = AuxA2299SCoCo
               AuxA2300ScoDs = THISFORM.A2300ScoDs
               Gx_err = GX_DB_SetStr( HStmt_T02365,2,AuxA2300ScoDs,40,0)
               THISFORM.A2300ScoDs = AuxA2300ScoDs
               AuxA2301ScoDi = THISFORM.A2301ScoDi
               Gx_err = GX_DB_SetStr( HStmt_T02365,3,AuxA2301ScoDi,40,0)
               THISFORM.A2301ScoDi = AuxA2301ScoDi
               AuxA2302ScoCo = THISFORM.A2302ScoCo
               Gx_err = GX_DB_SetStr( HStmt_T02365,4,AuxA2302ScoCo,40,0)
               THISFORM.A2302ScoCo = AuxA2302ScoCo
               AuxA2303ScoTe = THISFORM.A2303ScoTe
               Gx_err = GX_DB_SetStr( HStmt_T02365,5,AuxA2303ScoTe,40,0)
               THISFORM.A2303ScoTe = AuxA2303ScoTe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02365) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02365 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02365) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02365 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02366" , @HStmt_T02366 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSINDICA","T02366","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02366) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [SINDICAT] SET [ScoDsc]=?, [ScoDir]=?, [ScoContact]=?, [ScoTel]=?  WHERE [SCoCod] "
                  cmdbuf = cmdbuf + "  = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02366,cmdbuf)
                  THISFORM.GX_DB_BindParmT02366_01 ()
               ENDIF
               AuxA2300ScoDs = THISFORM.A2300ScoDs
               Gx_err = GX_DB_SetStr( HStmt_T02366,1,AuxA2300ScoDs,40,0)
               THISFORM.A2300ScoDs = AuxA2300ScoDs
               AuxA2301ScoDi = THISFORM.A2301ScoDi
               Gx_err = GX_DB_SetStr( HStmt_T02366,2,AuxA2301ScoDi,40,0)
               THISFORM.A2301ScoDi = AuxA2301ScoDi
               AuxA2302ScoCo = THISFORM.A2302ScoCo
               Gx_err = GX_DB_SetStr( HStmt_T02366,3,AuxA2302ScoCo,40,0)
               THISFORM.A2302ScoCo = AuxA2302ScoCo
               AuxA2303ScoTe = THISFORM.A2303ScoTe
               Gx_err = GX_DB_SetStr( HStmt_T02366,4,AuxA2303ScoTe,40,0)
               THISFORM.A2303ScoTe = AuxA2303ScoTe
               AuxA2299SCoCo = THISFORM.A2299SCoCo
               Gx_err = GX_DB_SetLong( HStmt_T02366,5,@AuxA2299SCoCo,0)
               THISFORM.A2299SCoCo = AuxA2299SCoCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02366) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02366 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02366) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02367" , @HStmt_T02367 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSINDICA","T02367","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02367) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [SINDICAT]  WHERE [SCoCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02367,cmdbuf)
                  THISFORM.GX_DB_BindParmT02367_01 ()
               ENDIF
               AuxA2299SCoCo = THISFORM.A2299SCoCo
               Gx_err = GX_DB_SetLong( HStmt_T02367,1,@AuxA2299SCoCo,0)
               THISFORM.A2299SCoCo = AuxA2299SCoCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02367) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02367 = Gx_err
               THISFORM.T02362 = iif( THISFORM.T02367 = 0 , 104 , THISFORM.T02367 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02367) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
