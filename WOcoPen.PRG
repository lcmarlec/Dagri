      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00992" , @HStmt_W00992 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOCOPEN","W00992","",GX_CURSOR_TYPE_READONLY,@HStmt_W00992) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[OCoEst], T1.[OcoEntGruT] AS OcoEntGruT, T1.[OCoNroInt], T1.[Oco11], "
                  cmdbuf = cmdbuf + "  T2.[EntRaz] AS OcoEntRaz, T1.[OcoEntCod] AS OcoEntCod, T1.[OcoTip], T1.[OCoFch], "
                  cmdbuf = cmdbuf + "  T1.[OCoNro], T1.[OCoSuc] FROM ([OCOMPN] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[OcoEntGruT] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[OcoEntCod]) WHERE (T1.[EmpCod] = ? and T1.[OCoEst] >= 0 and T1.[OCoSuc] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OCoNro] >= ?) AND (T1.[OCoNro] > 0) AND (T1.[OcoEntCod] = ? or ( ? = "
                  cmdbuf = cmdbuf + "  0 and ? = 0)) AND (T1.[OcoTip] = ? or ? = 'T') AND (T1.[OCoFch] >= ?) AND (T1.[Oco11] "
                  cmdbuf = cmdbuf + "  + ? = 0 or ? + T1.[Oco11] = 2) AND (T1.[OCoEst] < 2) ORDER BY T1.[EmpCod], T1.[OCoEst], "
                  cmdbuf = cmdbuf + "  T1.[OCoSuc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00992,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00992,14)
                  THISFORM.GX_DB_BindColsW00992_01 ()
                  THISFORM.GX_DB_BindParmW00992_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00992,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV13Dessuc = THISFORM.AV13Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00992,2,@AuxAV13Dessuc,0)
               THISFORM.AV13Dessuc = AuxAV13Dessuc
               AuxAV14Desnro = THISFORM.AV14Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00992,3,@AuxAV14Desnro,0)
               THISFORM.AV14Desnro = AuxAV14Desnro
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00992,4,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV11Desprv = THISFORM.AV11Desprv
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00992,5,@AuxAV11Desprv,0)
               THISFORM.AV11Desprv = AuxAV11Desprv
               AuxAV23Sin = THISFORM.AV23Sin
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00992,6,@AuxAV23Sin,0)
               THISFORM.AV23Sin = AuxAV23Sin
               AuxAV20Ocotip = THISFORM.AV20Ocotip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00992,7,AuxAV20Ocotip,1,0)
               THISFORM.AV20Ocotip = AuxAV20Ocotip
               AuxAV20Ocotip = THISFORM.AV20Ocotip
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00992,8,AuxAV20Ocotip,1,0)
               THISFORM.AV20Ocotip = AuxAV20Ocotip
               AuxAV21Desfch = THISFORM.AV21Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00992,9,@AuxAV21Desfch,0)
               THISFORM.AV21Desfch = AuxAV21Desfch
               AuxAV22Oco11 = THISFORM.AV22Oco11
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00992,10,@AuxAV22Oco11,0)
               THISFORM.AV22Oco11 = AuxAV22Oco11
               AuxAV22Oco11 = THISFORM.AV22Oco11
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00992,11,@AuxAV22Oco11,0)
               THISFORM.AV22Oco11 = AuxAV22Oco11
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00992) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00992 = Gx_err
               THISFORM.GX_DB_GetW00992_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WOcoPen"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00992 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00992) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00992 = Gx_err
                  THISFORM.GX_DB_GetW00992_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00992 <> 101
               BRKV2R2 = .F.
               THISFORM.AV15Estado = SPACE(20)
               THISFORM.A690OCoEst = THISFORM.Buf_W00992_690OCoEst
               THISFORM.A683OcoEnt = THISFORM.Buf_W00992_683OcoEntGruT
               THISFORM.A682OCoNro = THISFORM.Buf_W00992_682OCoNroInt
               THISFORM.A3543Oco11 = THISFORM.Buf_W00992_3543Oco11
               THISFORM.A685OcoEnt = THISFORM.Buf_W00992_685OcoEntRaz
               THISFORM.A684OcoEnt = THISFORM.Buf_W00992_684OcoEntCod
               THISFORM.A691OcoTip = THISFORM.Buf_W00992_691OcoTip
               THISFORM.A688OCoFch = THISFORM.Buf_W00992_688OCoFch
               THISFORM.A687OCoNro = THISFORM.Buf_W00992_687OCoNro
               THISFORM.A686OCoSuc = THISFORM.Buf_W00992_686OCoSuc
               THISFORM.A685OcoEnt = THISFORM.Buf_W00992_685OcoEntRaz
               GX_SFLOAD = 0
               THISFORM.U22V2R2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00992) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00992 = Gx_err
               THISFORM.GX_DB_GetW00992_01 ()
            ENDDO
         ENDIF
      ENDPROC
