                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCprGrT], [ArtCprPrc], [ArtCprArt], "
                  cmdbuf = cmdbuf + "  [ArtCprCod] FROM [ARTICS1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [FamCod] "
                  cmdbuf = cmdbuf + "  = ? and [FamSubCod] = ? and [ArtCod] = ? and [ArtCprGrT] = ? and [ArtCprCod] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([ArtCprArt] like ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], "
                  cmdbuf = cmdbuf + "  [ArtCprGrT], [ArtCprCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01692,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01692,8)
                  THISFORM.GX_DB_BindColsW01692_01 ()
                  THISFORM.GX_DB_BindParmW01692_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01692,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
