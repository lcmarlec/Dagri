               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01692,5,AuxA7ArtCprGr,2,0)
               THISFORM.A7ArtCprGr = AuxA7ArtCprGr
               AuxAV16C8 = THISFORM.AV16C8
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01692,6,@AuxAV16C8,0)
               THISFORM.AV16C8 = AuxAV16C8
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01692,7,PADR( TRIM(THISFORM.AV15C10),12, '%'),LEN(PADR( TRIM(THISFORM.AV15C10),12, '%')),0)
               Gx_eop = 1
