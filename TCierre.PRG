      PROCEDURE SetMode(gxType,gxLvl)
         gxO_Rec = 0
         IF THISFORM.GX_Curr_Level = 53
            THISFORM.SaveMode( THISFORM.GX_1Lvl_mode, "EOF")
            RETURN
         ENDIF
         DO CASE
            CASE THISFORM.GX_Curr_Level = 53
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T0120101" , @HStmt_T0120101 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCIERRE","T0120101","",GX_CURSOR_TYPE_READONLY,@HStmt_T0120101) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EmpNom], [EmpVtaCie], [EmpComCie], [EmpOCoCie], [EmpRecCie], [EmpInsCie], "
                  cmdbuf = cmdbuf + "  [EmpAusCie], [EmpRtCCie], [EmpRTCICie], [EmpRTCSCie], [EmpPIBCie], [EmpCntCie] FROM "
                  cmdbuf = cmdbuf + "  [EMPRES] (NOLOCK) WHERE [EmpCod] = ?  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T0120101,cmdbuf)
                  THISFORM.GX_DB_BindColsT0120101_01 ()
                  THISFORM.GX_DB_BindParmT0120101_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T0120101,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T0120101) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T0120101 = Gx_err
               THISFORM.GX_DB_GetT0120101_01 ()
               gx_NewMode = "UPD"
               IF .not. THISFORM.T0120101 <> 101
                  gx_NewMode = "INS"
               ENDIF
               IF THIS.AMode
                  THISFORM.SaveMode(gx_NewMode, "")
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T0120101) ,  ,  ,  , CS_SQLSRV , 0 )
               RETURN
         ENDCASE
         GXForm::SetMode(gxType,gxLvl)
         IF gxO_Rec != 0
            GOTO (gxO_Rec)
         ENDIF
