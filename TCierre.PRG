      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. GX_1Lvl_mode = PGx_mode
         THISFORM. Gx_mode = PGx_mode
         THISFORM. AV8Emprcod = PAV8Emprcod
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV17Usuari = PAV17Usuari
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01202" , @HStmt_T01202 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCIERRE","T01202","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01202) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EmpNom], [EmpVtaCie], [EmpComCie], [EmpOCoCie], [EmpRecCie], [EmpInsCie], "
            cmdbuf = cmdbuf + "  [EmpAusCie], [EmpRtCCie], [EmpRTCICie], [EmpRTCSCie], [EmpPIBCie], [EmpCntCie] FROM "
            cmdbuf = cmdbuf + "  [EMPRES] (UPDLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01202,cmdbuf)
            THISFORM.GX_DB_BindColsT01202_01 ()
            THISFORM.GX_DB_BindParmT01202_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01203" , @HStmt_T01203 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCIERRE","T01203","",GX_CURSOR_TYPE_READONLY,@HStmt_T01203) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [EmpNom], [EmpVtaCie], [EmpComCie], [EmpOCoCie], [EmpRecCie], [EmpInsCie], "
            cmdbuf = cmdbuf + "  [EmpAusCie], [EmpRtCCie], [EmpRTCICie], [EmpRTCSCie], [EmpPIBCie], [EmpCntCie] FROM "
            cmdbuf = cmdbuf + "  [EMPRES] (NOLOCK) WHERE [EmpCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01203,cmdbuf)
            THISFORM.GX_DB_BindColsT01203_01 ()
            THISFORM.GX_DB_BindParmT01203_01 ()
         ENDIF
         GXTB.ShowMode()
      ENDPROC
      PROCEDURE Init
         GXForm::Init
      ENDPROC
      PROCEDURE Destroy
         THISFORM.ResetFKeys()
      ENDPROC
      PROCEDURE Activate
         IF THISFORM.GX_init_activate
            IF THISFORM.Gx_mode <> "DSP"
               THISFORM.AV21Pgmnam = "TCierre"
               THISFORM.A2EmpCod = THISFORM.AV8Emprcod
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               THISFORM.Gx_mode = "UPD"
               THISFORM.A2EmpCod = THISFORM.AV8Emprcod
               THISFORM. cCT120A2 .Refresh()
               THISFORM.Gx_mode = "DSP"
            ENDIF
            THISFORM.U113C2 ()
            IF TYPE( "OCT120" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            THISFORM.SetLevel( 53 )
            THISFORM.GX_last_fld_lvl = 53
            IF ! THISFORM.InitLevels( 53 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            IF THISFORM.Gx_mode = "DSP"
               IF THISFORM. cCT120A2 .MV(5) != 0
                  THISFORM.SaveMode( "INS" ,"")
               ELSE
                  THISFORM.LoadObj(4)
               ENDIF
            ENDIF
            GXForm::Activate
         ENDIF
         THISFORM.ClearFrmTBar
         THISFORM.GxMenuBar.Clear
         THISFORM.SetMBTimer()
         gxMB = "OFF"
         THISFORM.GxMenuBar.Set(gxMB)
         IF THISFORM.GX_Mode = "DLT"
