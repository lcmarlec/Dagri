            cmdbuf = cmdbuf + "  AS ChqBcoCod, [ChqOrden], [ChqSuc], [ChqNro], [ChqTit], [ChqImp], [ChqFchDeb], [ChqCliGrT] "
            cmdbuf = cmdbuf + "  AS ChqCliGrT, [ChqCliCod] AS ChqCliCod, [ChqEst], [ChqNroReg], [ChqPrvGrT] AS ChqPrvGrT, "
            cmdbuf = cmdbuf + "  [ChqPrvCod] AS ChqPrvCod, [ChqFchEgr], [ChqBcoDepC] AS ChqBcoDepC, [ChqBcoCta], "
            cmdbuf = cmdbuf + "  [ChqNoO], [ChqMonCod] AS ChqMonCod, [ChqCotImp], [ChqFchCB], [ChqCruz], [ChqImpreso], "
            cmdbuf = cmdbuf + "  [ChqRE], [ChrREGrT], [ChqRECo], [ChqREFc] FROM [CHQS] (FASTFIRSTROW NOLOCK) WHERE "
            cmdbuf = cmdbuf + "  [EmpCod] >= ? and [ChqNroI] >= ? and [ChqLin] >= ? and [ChqTip] >= ? and [ChqCta] "
            cmdbuf = cmdbuf + "  >= ? ORDER BY [EmpCod], [ChqNroI], [ChqLin], [ChqTip], [ChqCta]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00159,cmdbuf)
