      ***********************
      PROCEDURE U27V3H2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01253" , @HStmt_W01253 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPLAVTA","W01253","",GX_CURSOR_TYPE_READONLY,@HStmt_W01253) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[EmpCod], T1.[PlVGruTip] AS PlVGruTip, T1.[PlVEntCod] AS PlVEntCod, T2.[EntRaz] "
            cmdbuf = cmdbuf + "  AS PlVEntRaz, T2.[EntBon] FROM ([PLAVTA] T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
            cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[PlVGruTip] AND T2.[EntCod] "
            cmdbuf = cmdbuf + "  = T1.[PlVEntCod]) WHERE T1.[EmpCod] = ? and T1.[PlVGruTip] = ? and T1.[PlVEntCod] "
            cmdbuf = cmdbuf + "  >= ? ORDER BY T1.[EmpCod], T1.[PlVGruTip], T1.[PlVEntCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01253,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01253,15)
            THISFORM.GX_DB_BindColsW01253_01 ()
            THISFORM.GX_DB_BindParmW01253_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
