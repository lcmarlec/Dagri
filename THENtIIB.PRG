            cmdbuf = cmdbuf + "  >= ? and [EntGruTip] = ? and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02394,cmdbuf)
