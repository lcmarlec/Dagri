            THISFORM.A2EmpCod = Aux1
            THISFORM.A7ArtCprGr = Aux2
            THISFORM.A8ArtCprCo = Aux3
            THISFORM.AV5Fechasi = Aux4
            THISFORM.AV10Usuari = Aux5
            THISFORM. cCW143S13 .RestoreGridPos()
            GX_rploop = .T.
            THISFORM.GX_Refresh = 1   &&& Refresh
