      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01432" , @HStmt_W01432 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKARXPR","W01432","",GX_CURSOR_TYPE_READONLY,@HStmt_W01432) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[ArtCprGrT] AS ArtCprGrT, T1.[ArtCprCod] AS ArtCprCod, T3.[EntRaz] "
                  cmdbuf = cmdbuf + "  AS ArtCprNom, T1.[ArtCprArt], T2.[ArtObs], T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], "
                  cmdbuf = cmdbuf + "  T1.[FamCod] FROM (([ARTICS1] T1 (NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ArtCod] = T1.[ArtCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T3.[EntGruTip] = T1.[ArtCprGrT] AND T3.[EntCod] = T1.[ArtCprCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[ArtCprGrT] = ? and T1.[ArtCprCod] = ?) AND (T2.[ArtDsc] like ? or T2.[ArtObs] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY T1.[EmpCod], T1.[ArtCprGrT], T1.[ArtCprCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01432,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01432,14)
                  THISFORM.GX_DB_BindColsW01432_01 ()
                  THISFORM.GX_DB_BindParmW01432_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01432,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA7ArtCprGr = THISFORM.A7ArtCprGr
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01432,2,AuxA7ArtCprGr,2,0)
               THISFORM.A7ArtCprGr = AuxA7ArtCprGr
               AuxA8ArtCprCo = THISFORM.A8ArtCprCo
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01432,3,@AuxA8ArtCprCo,0)
               THISFORM.A8ArtCprCo = AuxA8ArtCprCo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01432,4,PADR( TRIM(THISFORM.AV18Artdsc),50, '%'),LEN(PADR( TRIM(THISFORM.AV18Artdsc),50, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01432,5,PADR( TRIM(THISFORM.AV18Artdsc),50, '%'),LEN(PADR( TRIM(THISFORM.AV18Artdsc),50, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01432) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01432 = Gx_err
               THISFORM.GX_DB_GetW01432_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV22Pgmnam = "WSKArxPr"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01432 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01432) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01432 = Gx_err
                  THISFORM.GX_DB_GetW01432_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01432 <> 101
               BRKV3Z2 = .F.
               THISFORM.A9ArtCprNo = THISFORM.Buf_W01432_9ArtCprNom
               THISFORM.A10ArtCprA = THISFORM.Buf_W01432_10ArtCprArt
               THISFORM.A2764ArtOb = Gx_lvchar_to_char( THISFORM.Buf_W01432_2764ArtObs )
               THISFORM.A6ArtDsc = THISFORM.Buf_W01432_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W01432_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01432_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01432_3FamCod
               THISFORM.A2764ArtOb = Gx_lvchar_to_char( THISFORM.Buf_W01432_2764ArtObs )
               THISFORM.A6ArtDsc = THISFORM.Buf_W01432_6ArtDsc
               THISFORM.A9ArtCprNo = THISFORM.Buf_W01432_9ArtCprNom
               GX_SFLOAD = 0
               THISFORM.U15V3Z2 ()
