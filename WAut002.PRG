      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00072" , @HStmt_W00072 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WAUT002","W00072","",GX_CURSOR_TYPE_READONLY,@HStmt_W00072) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T3.[EmpNom], T2.[UsuNombre], T1.[UsuCod] FROM (([USU001] T1 (NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [USU002] T2 (NOLOCK) ON T2.[UsuCod] = T1.[UsuCod]) LEFT JOIN [EMPRES] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod]) WHERE (T1.[EmpCod] = ?) AND (T2.[UsuNombre] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY T1.[EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00072,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00072,11)
                  THISFORM.GX_DB_BindColsW00072_01 ()
                  THISFORM.GX_DB_BindParmW00072_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00072,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00072,2,PADR( TRIM(THISFORM.AV18Usunom),30, '%'),LEN(PADR( TRIM(THISFORM.AV18Usunom),30, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00072 = Gx_err
               THISFORM.GX_DB_GetW00072_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV40Pgmnam = "WAut002"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00072 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00072) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00072 = Gx_err
                  THISFORM.GX_DB_GetW00072_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00072 <> 101
               BRKV072 = .F.
