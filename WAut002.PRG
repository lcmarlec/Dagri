         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W00073) ,  ,  ,  , CS_SQLSRV ,  )
         IF ( THISFORM.AV16Asig > 0 .AND. THISFORM.AV19Ver = "SI" ) .OR. ( THISFORM.AV16Asig = 0 .AND. THISFORM.AV19Ver = "-" ) .OR. THISFORM.AV19Ver = "TO"
