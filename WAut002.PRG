            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00073) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W00073 = Gx_err
         THISFORM.GX_DB_GetW00073_01 ()
         DO WHILE THISFORM.W00073 <> 101
            THISFORM.A74AutNive = THISFORM.Buf_W00073_74AutNivel
            THISFORM.A66ObjCodA = THISFORM.Buf_W00073_66ObjCodAut
            THISFORM.A64UsuCod = THISFORM.Buf_W00073_64UsuCod
