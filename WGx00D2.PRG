               AuxAV7C104 = THISFORM.AV7C104
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01902,5,@AuxAV7C104,0)
               THISFORM.AV7C104 = AuxAV7C104
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01902,6,PADR( TRIM(THISFORM.AV8C105),10, '%'),LEN(PADR( TRIM(THISFORM.AV8C105),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01902,7,PADR( TRIM(THISFORM.AV9C106),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C106),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01902) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01902 = Gx_err
               THISFORM.GX_DB_GetW01902_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01902 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01902) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01902 = Gx_err
                  THISFORM.GX_DB_GetW01902_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01902 <> 101
               BRKV5A2 = .F.
               THISFORM.A106TChqTi = THISFORM.Buf_W01902_106TChqTit
               THISFORM.A105TChqNr = THISFORM.Buf_W01902_105TChqNro
               THISFORM.A104TChqSu = THISFORM.Buf_W01902_104TChqSuc
               THISFORM.A102TChqBc = THISFORM.Buf_W01902_102TChqBcoCod
               THISFORM.A101TChqLi = THISFORM.Buf_W01902_101TChqLin
               GX_SFLOAD = 0
               THISFORM.U12V5A2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01902) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01902 = Gx_err
               THISFORM.GX_DB_GetW01902_01 ()
            ENDDO
         ENDIF
      ENDPROC
