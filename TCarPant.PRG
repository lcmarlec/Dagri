         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T035614" , @HStmt_T035614 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCARPANT","T035614","",GX_CURSOR_TYPE_READONLY,@HStmt_T035614) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [CarPedCar], [CarPedFch], [CarPedGruT], [CarPedEnt], [CarpedSuc], "
                  cmdbuf = cmdbuf + "  [CarPedSec], [CarPedInd], [FamCod], [FamSubCod], [ArtCod], [CarPedPal], [CArriTraz] "
                  cmdbuf = cmdbuf + "  FROM [CARPED1] (NOLOCK) WHERE [EmpCod] = ? AND [CarPedCar] = ? AND [CarPedFch] = "
                  cmdbuf = cmdbuf + "  ? AND [CarPedGruT] = ? AND [CarPedEnt] = ? AND [CarpedSuc] = ? AND [CarPedSec] = "
                  cmdbuf = cmdbuf + "  ? AND [CarPedInd] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] = ? AND "
                  cmdbuf = cmdbuf + "  [CarPedPal] = ? ORDER BY [EmpCod], [CarPedCar], [CarPedFch], [CarPedGruT], [CarPedEnt], "
                  cmdbuf = cmdbuf + "  [CarpedSuc], [CarPedSec], [CarPedInd], [FamCod], [FamSubCod], [ArtCod], [CarPedPal], "
                  cmdbuf = cmdbuf + "  [CArriTraz]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T035614,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T035614,9)
                  THISFORM.GX_DB_BindColsT035614_01 ()
                  THISFORM.GX_DB_BindParmT035614_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T035614,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3340CarPe = THISFORM.A3340CarPe
               Gx_err = GX_DB_SetStr( HStmt_T035614,2,AuxA3340CarPe,15,0)
               THISFORM.A3340CarPe = AuxA3340CarPe
               AuxA3343CarPe = THISFORM.A3343CarPe
               Gx_err = GX_DB_SetDate( HStmt_T035614,3,@AuxA3343CarPe,0)
               THISFORM.A3343CarPe = AuxA3343CarPe
               AuxA3344CarPe = THISFORM.A3344CarPe
               Gx_err = GX_DB_SetStr( HStmt_T035614,4,AuxA3344CarPe,2,0)
               THISFORM.A3344CarPe = AuxA3344CarPe
               AuxA3345CarPe = THISFORM.A3345CarPe
               Gx_err = GX_DB_SetLong( HStmt_T035614,5,@AuxA3345CarPe,0)
               THISFORM.A3345CarPe = AuxA3345CarPe
               AuxA3346Carpe = THISFORM.A3346Carpe
               Gx_err = GX_DB_SetInt( HStmt_T035614,6,@AuxA3346Carpe,0)
               THISFORM.A3346Carpe = AuxA3346Carpe
               AuxA3347CarPe = THISFORM.A3347CarPe
               Gx_err = GX_DB_SetInt( HStmt_T035614,7,@AuxA3347CarPe,0)
               THISFORM.A3347CarPe = AuxA3347CarPe
               AuxA3348CarPe = THISFORM.A3348CarPe
               Gx_err = GX_DB_SetInt( HStmt_T035614,8,@AuxA3348CarPe,0)
               THISFORM.A3348CarPe = AuxA3348CarPe
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T035614,9,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T035614,10,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T035614,11,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA3341CarPe = THISFORM.A3341CarPe
               Gx_err = GX_DB_SetStr( HStmt_T035614,12,AuxA3341CarPe,16,0)
               THISFORM.A3341CarPe = AuxA3341CarPe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T035614) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T035614 = Gx_err
               THISFORM.GX_DB_GetT035614_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T035614 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T035614) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T035614 = Gx_err
                  THISFORM.GX_DB_GetT035614_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T035614 <> 101
               BRK9W387 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT356S34.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T035614) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T035614 = Gx_err
               THISFORM.GX_DB_GetT035614_01 ()
            ENDDO
         ENDIF
      ENDPROC
