      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "SkDesdePrv" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VEL2()
            RETURN .T.
         ENDIF
         IF UPPER( "Aceptar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VEL2()
            RETURN .T.
         ENDIF
         IF UPPER( "Salir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VEL2()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU18VEL2()
            RETURN .T.
         ENDIF
         IF UPPER( "Obs. Prov. " ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VEL2()
            RETURN .T.
         ENDIF
         IF UPPER( "Visualizar" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VEL2()
            RETURN .T.
         ENDIF
         IF UPPER( "Precios de Insumos (Excel)" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU17VEL2()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
