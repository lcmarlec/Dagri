      ***********************
      PROCEDURE U20VEL2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'RAZON'" )
         * 'RAZON' Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05253" , @HStmt_W05253 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPRECIOC","W05253","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05253) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'PR' and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05253,cmdbuf)
            THISFORM.GX_DB_BindColsW05253_01 ()
            THISFORM.GX_DB_BindParmW05253_01 ()
         ENDIF
         AuxAV8Empcod = THISFORM.AV8Empcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05253,1,@AuxAV8Empcod,0)
         THISFORM.AV8Empcod = AuxAV8Empcod
         AuxAV17Despro = THISFORM.AV17Despro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05253,2,@AuxAV17Despro,0)
         THISFORM.AV17Despro = AuxAV17Despro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05253) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05253 = Gx_err
         THISFORM.GX_DB_GetW05253_01 ()
         DO WHILE THISFORM.W05253 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W05253_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W05253_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W05253_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W05253_153EntRaz
            THISFORM.AV18Desraz = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W05253) ,  ,  ,  , CS_SQLSRV ,  )
         THISFORM.EndEvent()
      ENDPROC

