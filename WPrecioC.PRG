      PROCEDURE CreateTemp
         LOCAL SCW525S13
         SCW525S13 = ""
         IF USED( "SCW525S13" )
            SELECT SCW525S13
            SCW525S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW525S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3FamCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA4FamSubC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA5ArtCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA6ArtDsc"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 50
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA11ArtCpr"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 15
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA10ArtCpr"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW525S13 = GETE('z:\temp') + '\' + SCW525S13
            ENDIF
            CREATE DBF (SCW525S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW525S13) EXCLUSIVE ALIAS SCW525S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW525S13
         THIS.GX_SfAlias = "SCW525S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05252" , @HStmt_W05252 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPRECIOC","W05252","",GX_CURSOR_TYPE_READONLY,@HStmt_W05252) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ArtCprCod], T1.[ArtCprGrT], T1.[EmpCod], T1.[ArtCprArt], T1.[ArtCprPrc], "
                  cmdbuf = cmdbuf + "  T2.[ArtDsc], T1.[ArtCod], T1.[FamSubCod], T1.[FamCod] FROM ([ARTICS1] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] "
                  cmdbuf = cmdbuf + "  = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] = T1.[ArtCod]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[ArtCprGrT] = 'PR') AND (T1.[ArtCprCod] = ? or ? = "
                  cmdbuf = cmdbuf + "  0) AND (T1.[ArtCod] = ? or ? = 0) AND (T2.[ArtDsc] like ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[ArtCprGrT], T1.[ArtCprCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05252,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05252,12)
                  THISFORM.GX_DB_BindColsW05252_01 ()
                  THISFORM.GX_DB_BindParmW05252_01 ()
               ENDIF
               AuxAV8Empcod = THISFORM.AV8Empcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05252,1,@AuxAV8Empcod,0)
               THISFORM.AV8Empcod = AuxAV8Empcod
               AuxAV17Despro = THISFORM.AV17Despro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05252,2,@AuxAV17Despro,0)
               THISFORM.AV17Despro = AuxAV17Despro
               AuxAV17Despro = THISFORM.AV17Despro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05252,3,@AuxAV17Despro,0)
               THISFORM.AV17Despro = AuxAV17Despro
               AuxAV9Artcod = THISFORM.AV9Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05252,4,@AuxAV9Artcod,0)
               THISFORM.AV9Artcod = AuxAV9Artcod
               AuxAV9Artcod = THISFORM.AV9Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05252,5,@AuxAV9Artcod,0)
               THISFORM.AV9Artcod = AuxAV9Artcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05252,6,PADR( TRIM(THISFORM.AV22Artdsc),50, '%'),LEN(PADR( TRIM(THISFORM.AV22Artdsc),50, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05252 = Gx_err
               THISFORM.GX_DB_GetW05252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WPrecioC"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05252 = Gx_err
                  THISFORM.GX_DB_GetW05252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05252 <> 101
               BRKVEL2 = .F.
               THISFORM.A8ArtCprCo = THISFORM.Buf_W05252_8ArtCprCod
               THISFORM.A7ArtCprGr = THISFORM.Buf_W05252_7ArtCprGrT
               THISFORM.A2EmpCod = THISFORM.Buf_W05252_2EmpCod
               THISFORM.A10ArtCprA = THISFORM.Buf_W05252_10ArtCprArt
               THISFORM.A11ArtCprP = THISFORM.Buf_W05252_11ArtCprPrc
               THISFORM.A6ArtDsc = THISFORM.Buf_W05252_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W05252_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W05252_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W05252_3FamCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W05252_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U19VEL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05252 = Gx_err
               THISFORM.GX_DB_GetW05252_01 ()
            ENDDO
         ENDIF
      ENDPROC
