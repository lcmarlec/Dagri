      PROCEDURE CreateTemp
         LOCAL SCW490S18
         SCW490S18 = ""
         IF USED( "SCW490S18" )
            SELECT SCW490S18
            SCW490S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW490S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1492LlaT"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 14
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1493LlaF"
            GX_STRUCT[ 3 ,2]= "D"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1494LlaH"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1512LlaL"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW490S18 = GETE('z:\temp') + '\' + SCW490S18
            ENDIF
            CREATE DBF (SCW490S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW490S18) EXCLUSIVE ALIAS SCW490S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW490S18
         THIS.GX_SfAlias = "SCW490S18"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04902" , @HStmt_W04902 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04S0","W04902","",GX_CURSOR_TYPE_READONLY,@HStmt_W04902) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[LlaNroI], T2.[LlaTReCod], T1.[LlaLin], T2.[LlaHor], T2.[LlaFch], T2.[LlaTel1], "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] FROM ([LLAITEM] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [LLANVO] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[LlaNroI] = T1.[LlaNroI]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  >= ? and T2.[LlaTel1] >= ? and T2.[LlaFch] >= ?) AND (T2.[LlaTel1] >= ?) AND (T2.[LlaFch] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T2.[LlaHor] like ?) AND (T1.[LlaLin] >= ?) AND (T2.[LlaTReCod] >= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T2.[LlaTel1], T2.[LlaFch], T2.[LlaHor], T1.[LlaLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04902,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04902,8)
                  THISFORM.GX_DB_BindColsW04902_01 ()
                  THISFORM.GX_DB_BindParmW04902_01 ()
               ENDIF
               AuxAV20C2 = THISFORM.AV20C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04902,1,@AuxAV20C2,0)
               THISFORM.AV20C2 = AuxAV20C2
               AuxAV19C1492 = THISFORM.AV19C1492
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04902,2,AuxAV19C1492,14,0)
               THISFORM.AV19C1492 = AuxAV19C1492
               AuxAV18C1493 = THISFORM.AV18C1493
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04902,3,@AuxAV18C1493,0)
               THISFORM.AV18C1493 = AuxAV18C1493
               AuxAV19C1492 = THISFORM.AV19C1492
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04902,4,AuxAV19C1492,14,0)
               THISFORM.AV19C1492 = AuxAV19C1492
               AuxAV18C1493 = THISFORM.AV18C1493
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04902,5,@AuxAV18C1493,0)
               THISFORM.AV18C1493 = AuxAV18C1493
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04902,6,PADR( TRIM(THISFORM.AV17C1494),8, '%'),LEN(PADR( TRIM(THISFORM.AV17C1494),8, '%')),0)
               AuxAV16C1512 = THISFORM.AV16C1512
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04902,7,@AuxAV16C1512,0)
               THISFORM.AV16C1512 = AuxAV16C1512
               AuxAV15C1513 = THISFORM.AV15C1513
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04902,8,@AuxAV15C1513,0)
               THISFORM.AV15C1513 = AuxAV15C1513
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04902) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04902 = Gx_err
               THISFORM.GX_DB_GetW04902_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04902 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04902) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04902 = Gx_err
                  THISFORM.GX_DB_GetW04902_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04902 <> 101
               BRKVDM2 = .F.
               THISFORM.A1525LlaNr = THISFORM.Buf_W04902_1525LlaNroI
               THISFORM.A1513LlaTR = THISFORM.Buf_W04902_1513LlaTReCod
               THISFORM.A1512LlaLi = THISFORM.Buf_W04902_1512LlaLin
               THISFORM.A1494LlaHo = THISFORM.Buf_W04902_1494LlaHor
               THISFORM.A1493LlaFc = THISFORM.Buf_W04902_1493LlaFch
               THISFORM.A1492LlaTe = THISFORM.Buf_W04902_1492LlaTel1
               THISFORM.A2EmpCod = THISFORM.Buf_W04902_2EmpCod
               THISFORM.A1513LlaTR = THISFORM.Buf_W04902_1513LlaTReCod
               THISFORM.A1494LlaHo = THISFORM.Buf_W04902_1494LlaHor
               THISFORM.A1493LlaFc = THISFORM.Buf_W04902_1493LlaFch
               THISFORM.A1492LlaTe = THISFORM.Buf_W04902_1492LlaTel1
               GX_SFLOAD = 0
               THISFORM.U12VDM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04902) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04902 = Gx_err
               THISFORM.GX_DB_GetW04902_01 ()
            ENDDO
         ENDIF
      ENDPROC
