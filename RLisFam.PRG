         RV63Docexc.cells(RV22Fila,RV56Col).Text = "Hijo/a"
      ENDIF
      RV56Col = RV56Col + 1
      IF R2841TraFT = 1
         RV63Docexc.cells(RV22Fila,RV56Col).Text = "C.I."
      ELSE
         RV63Docexc.cells(RV22Fila,RV56Col).Text = "D.N.I."
      ENDIF
      RV56Col = RV56Col + 1
      RV63Docexc.cells(RV22Fila,RV56Col).Number = R2842TraFN
      RV56Col = RV56Col + 1
      RV63Docexc.cells(RV22Fila,RV56Col).Text = ALLTRIM( R2843TraFN )
      RV56Col = RV56Col + 1
      RV63Docexc.cells(RV22Fila,RV56Col).Text = ALLTRIM( R2845TraFE )
      RV56Col = RV56Col + 1
      RV63Docexc.cells(RV22Fila,RV56Col).Date = R2844TraFF
      RV22Fila = RV22Fila + 1
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R11882) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R11882 = Gx_err
      GX_DB_GetR11882_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R11882) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   RV22Fila = RV22Fila + 1
   RV63Docexc.cells(RV22Fila,1).Text = space( 40 )
   RV63Docexc.cells(RV22Fila,2).Text = space( 25 )
   RV63Docexc.cells(RV22Fila,3).Text = space( 70 )
   RV63Docexc.cells(RV22Fila,4).Text = space( 40 )
   RV63Docexc.cells(RV22Fila,5).Text = space( 40 )
   RV63Docexc.save( )
   RV63Docexc.close( )
   RV64E = opendocument( AV41Planil )
   DO EPX00
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

