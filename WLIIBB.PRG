      PROCEDURE cCW346V23.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW346V23.ISVALID" )
         IF THISFORM.AV23Despro = 0
            THISFORM.AV24Desraz = "Todos "
         ELSE
            THISFORM.AV36GXLvl1 = 0
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03463" , @HStmt_W03463 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLIIBB","W03463","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W03463) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
               cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'CL' and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
               cmdbuf = cmdbuf + "   "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03463,cmdbuf)
               THISFORM.GX_DB_BindColsW03463_01 ()
               THISFORM.GX_DB_BindParmW03463_01 ()
            ENDIF
            AuxAV8Emprcod = THISFORM.AV8Emprcod
            THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03463,1,@AuxAV8Emprcod,0)
            THISFORM.AV8Emprcod = AuxAV8Emprcod
            AuxAV23Despro = THISFORM.AV23Despro
            THISFORM.Gx_err = GX_DB_SetLong( HStmt_W03463,2,@AuxAV23Despro,0)
            THISFORM.AV23Despro = AuxAV23Despro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03463) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W03463 = Gx_err
            THISFORM.GX_DB_GetW03463_01 ()
            DO WHILE THISFORM.W03463 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W03463_2EmpCod
               THISFORM.A150EntGru = THISFORM.Buf_W03463_150EntGruTip
               THISFORM.A120EntCod = THISFORM.Buf_W03463_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W03463_153EntRaz
               THISFORM.AV36GXLvl1 = 1
               THISFORM.AV24Desraz = THISFORM.A153EntRaz
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W03463) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV36GXLvl1 = 0
               THISFORM.AV24Desraz = "No Existe "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

