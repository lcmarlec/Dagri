               Gx_err = GX_DB_SetDouble( HStmt_T00427,2,@AuxA473TDVNro,0)
               THISFORM.A473TDVNro = AuxA473TDVNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00427) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00427 = Gx_err
               THISFORM.T00422 = iif( THISFORM.T00427 = 0 , 104 , THISFORM.T00427 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00427) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV17Tdvtip = THISFORM.A476TDVTip
         ENDIF
         DO CASE
            CASE ( THISFORM.A477TDVSer = "A" .OR. THISFORM.A476TDVTip = "FCME" ) .AND. .T.
               THISFORM.AV13Ok = "A"
            CASE THISFORM.A477TDVSer <> "A" .AND. THISFORM.A476TDVTip <> "FCME" .AND. .T.
               THISFORM.AV13Ok = "S"
         ENDCASE
         IF .T.
            THISFORM.AV10Numero = GXDTOC( THISFORM.A474TDVFch ) + " " + str( THISFORM.A479TDVNro , 8 ) + " " + str( THISFORM.A478TDVSuc , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV7Emprcod
            Aux3 = THISFORM.AV10Numero
            Aux5 = THISFORM.AV19Audobs
            Aux6 = THISFORM.AV9Usuario
            DO PAuditor WITH "VTAS" , Aux1 , "PDCVM01" , Aux3 , "INS" , Aux5 , Aux6
            THISFORM.AV7Emprcod = Aux1
            THISFORM.AV10Numero = Aux3
            THISFORM.AV19Audobs = Aux5
            THISFORM.AV9Usuario = Aux6
            THISFORM. cCT42V9 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 46 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
