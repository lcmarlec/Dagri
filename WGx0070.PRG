               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01852 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01852) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01852 = Gx_err
                  THISFORM.GX_DB_GetW01852_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01852 <> 101
               BRKV552 = .F.
               THISFORM.A80BcoAut = THISFORM.Buf_W01852_80BcoAut
               THISFORM.A81BcoNroU = THISFORM.Buf_W01852_81BcoNroUlt
               THISFORM.A233BcoMon = THISFORM.Buf_W01852_233BcoMonCod
               THISFORM.A86BcoCod = THISFORM.Buf_W01852_86BcoCod
               THISFORM.A78BcoSuc = THISFORM.Buf_W01852_78BcoSuc
               THISFORM.A77BcoCtaN = THISFORM.Buf_W01852_77BcoCtaNro
               THISFORM.A76BcoCta = THISFORM.Buf_W01852_76BcoCta
               GX_SFLOAD = 0
               THISFORM.U12V552 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01852) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01852 = Gx_err
               THISFORM.GX_DB_GetW01852_01 ()
            ENDDO
         ENDIF
      ENDPROC
