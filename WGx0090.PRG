               AuxAV5C86 = THISFORM.AV5C86
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01872,1,@AuxAV5C86,0)
               THISFORM.AV5C86 = AuxAV5C86
               Gx_eop = 1
