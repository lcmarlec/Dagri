                  ENDDO
                  THISFORM.W01872 = Gx_err
                  THISFORM.GX_DB_GetW01872_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
