      gxPrnObj.GXEndDoc( GxHDC , @GXAuxPrn_Flag)
      gxPrnObj.GXEndPrn( GxHDC , @GXAuxPrn_Flag)
      GXPrn_Flag = GXAuxPrn_Flag
      PRIVATE GXCallFrm
      IF PROGRAM(0) = "MENU"
         GXCallFrm = _SCREEN.ActiveForm
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 0
         ENDIF
      ENDIF
      DO WHILE gxPrnObj.GxIsAliveDoc( GxHDC ) != 0
         WAIT "" TIMEOUT 1
         DOEVENTS
      ENDDO
      RELEASE WINDOW _WMSG
      IF PROGRAM(0) = "MENU"
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 1
         ENDIF
      ENDIF
   ELSE
      SET DEVICE TO SCREEN
      RptView = .T.
   ENDIF
   DO CDI60
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

