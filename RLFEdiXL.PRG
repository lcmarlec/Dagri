      R418DcVEnt = Buf_R09892_418DcVEntRaz
      R420DcVEnt = Buf_R09892_420DcVEntLgDo
      IF R3125DcvFE > RV18Fecha .AND. ( AV19Cuitcl = 0 .OR. R166EntCui = AV19Cuitcl )
         RV16Docexc.cells(RV14Fila,1).Date = R421DcVFch
         RV16Docexc.cells(RV14Fila,2).Text = ALLTRIM( R1208DcvTi )
         RV16Docexc.cells(RV14Fila,3).Text = ALLTRIM( R423DcVSer )
         RV16Docexc.cells(RV14Fila,4).Number = R424DcVSuc
         RV16Docexc.cells(RV14Fila,5).Number = R425DcVNro
         RV16Docexc.cells(RV14Fila,6).Number = R417DcVEnt
         RV16Docexc.cells(RV14Fila,7).Text = ALLTRIM( R418DcVEnt )
         RV16Docexc.cells(RV14Fila,8).Number = R419DcVEnt
         RV16Docexc.cells(RV14Fila,9).Text = ALLTRIM( R420DcVEnt )
