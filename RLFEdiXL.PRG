      Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"RLFEDIXL","R09892","",GX_CURSOR_TYPE_READONLY_NOTNESTED,@HStmt_R09892) ,  ,  ,  , CS_SQLSRV ,  )
      cmdbuf = " SELECT T1.[DcVNroInt], T1.[DcVEntGruT] AS DcVEntGruT, T2.[EntCui], T1.[DcvFEKriko], "
      cmdbuf = cmdbuf + "  T1.[DcvTipRed], T1.[DcVEntCod] AS DcVEntCod, T2.[EntRaz] AS DcVEntRaz, T1.[DcVEntLgCo] "
      cmdbuf = cmdbuf + "  AS DcVEntLgCo, T3.[EntLgDom] AS DcVEntLgDo, T1.[DcVTot], T1.[DcvIdKriko], T1.[DcVNro], "
      cmdbuf = cmdbuf + "  T1.[DcVSuc], T1.[DcVSer], T1.[DcVTip], T1.[DcVFch], T1.[EmpCod] FROM (([DCVENT] "
      cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
      cmdbuf = cmdbuf + "  = T1.[DcVEntGruT] AND T2.[EntCod] = T1.[DcVEntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) "
      cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[DcVEntGruT] AND T3.[EntCod] "
      cmdbuf = cmdbuf + "  = T1.[DcVEntCod] AND T3.[EntLgCod] = T1.[DcVEntLgCo]) WHERE (T1.[EmpCod] = ? and "
      cmdbuf = cmdbuf + "  T1.[DcVFch] >= ? and T1.[DcVTip] = ?) AND (T1.[DcVFch] <= ?) ORDER BY T1.[EmpCod], "
      cmdbuf = cmdbuf + "  T1.[DcVFch], T1.[DcVTip], T1.[DcVSer], T1.[DcVSuc], T1.[DcVNro]  "
      Gx_err = GX_DB_Set_StmtCmdText( HStmt_R09892,cmdbuf)
      Gx_err = GX_DB_Set_StmtFetchSize( HStmt_R09892,100)
      GX_DB_BindColsR09892_01 ()
      GX_DB_BindParmR09892_01 ()
   ENDIF
   Gx_err = GX_DB_SetInt( HStmt_R09892,1,@AV8Emprcod,0)
   Gx_err = GX_DB_SetDate( HStmt_R09892,2,@AV9Fecdesd,0)
