         R718OPaNro = Buf_R08383_718OPaNro
         RV33GXLvl7 = 1
         RV21Opanro = R718OPaNro
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         * Exiting from a For First loop.
         EXIT
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08383) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL3 = .F.
      IF RV33GXLvl7 = 0
         RV21Opanro = 0
      ENDIF
      RV23I = RV23I + 1
      IF R940RetEst < 9
         RV25Docexc.cells(RV23I,1).Date = R938RetFch
         RV25Docexc.cells(RV23I,2).Number = R947RetNro
         RV25Docexc.cells(RV23I,3).Number = R942RetEnt
         RV25Docexc.cells(RV23I,4).Text = ALLTRIM( R943RetEnt )
         RV25Docexc.cells(RV23I,5).Number = R166EntCui
         RV25Docexc.cells(RV23I,6).Number = RV21Opanro
         RV25Docexc.cells(RV23I,7).Number = R958RetTot
         RV19Total = RV19Total + R958RetTot
      ELSE
         RV25Docexc.cells(RV23I,1).Date = R938RetFch
         RV25Docexc.cells(RV23I,2).Number = R947RetNro
         RV25Docexc.cells(RV23I,3).Number = 0
         RV25Docexc.cells(RV23I,4).Text = " Anulada "
         RV25Docexc.cells(RV23I,5).Text = " "
         RV25Docexc.cells(RV23I,6).Number = RV21Opanro
         RV25Docexc.cells(RV23I,7).Number = 0
      ENDIF
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R08382) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R08382 = Gx_err
      GX_DB_GetR08382_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R08382) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL2 = .F.
   RV23I = RV23I + 1
   RV25Docexc.cells(RV23I,1).Text = space( 30 )
   RV25Docexc.cells(RV23I,2).Text = space( 25 )
   RV25Docexc.cells(RV23I,3).Text = space( 30 )
   RV25Docexc.cells(RV23I,4).Text = space( 80 )
   RV25Docexc.cells(RV23I,5).Text = space( 30 )
   RV25Docexc.cells(RV23I,6).Text = space( 20 )
   RV25Docexc.cells(RV23I,7).Text = space( 25 )
   RV25Docexc.save( )
   RV25Docexc.close( )
   RV27E = opendocument( AV26Planil )
   DO EPNA0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

