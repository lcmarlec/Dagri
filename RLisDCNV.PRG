      R1435ActDs = Buf_R04744_1435ActDsc
      R610GruCod = Buf_R04744_610GruCod
      R609GruTip = Buf_R04744_609GruTip
      R2EmpCod = Buf_R04744_2EmpCod
      R1435ActDs = Buf_R04744_1435ActDsc
