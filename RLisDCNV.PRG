      cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [ACTIVIDA] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[ActCod] "
      cmdbuf = cmdbuf + "  = T1.[ActCod]) WHERE T1.[EmpCod] = ? and T1.[GruTip] = 'PR' and T1.[GruCod] = ? "
      cmdbuf = cmdbuf + "  ORDER BY T1.[EmpCod], T1.[GruTip], T1.[GruCod]  "
