      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T01296" , @HStmt_T01296 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCBMOT","T01296","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01296) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CBMOT] ([EmpCod], [CBMCod], [CBMDsc], [CBMCta], [CBMSuma], [CBMRest]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T01296,cmdbuf)
                  THISFORM.GX_DB_BindParmT01296_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T01296,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1287CBMCo = THISFORM.A1287CBMCo
               Gx_err = GX_DB_SetInt( HStmt_T01296,2,@AuxA1287CBMCo,0)
