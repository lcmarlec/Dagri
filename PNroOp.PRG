            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "P02076" , @HStmt_P02076 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"PNROOP","P02076","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_P02076) ,  ,  ,  , CS_SQLSRV ,  )
