               Gx_err = GX_DB_Set_StmtCmdText( HStmt_P02076,cmdbuf)
               GX_DB_BindParmP02076_01 ()
            ENDIF
            Gx_err = GX_DB_SetDouble( HStmt_P02076,1,@R1198RCVNr,0)
            Gx_err = GX_DB_SetDate( HStmt_P02076,2,@R1213RcvFc,0)
