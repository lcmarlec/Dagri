            ENDDO
            P02076 = Gx_err
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P02076) ,  ,  ,  , CS_SQLSRV ,  )
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
            IF UserCancel
               EXIT
            ENDIF
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P02074) ,  ,  ,  , CS_SQLSRV ,  )
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P02075) ,  ,  ,  , CS_SQLSRV ,  )
