               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09852,3,@AuxAV7C2984,0)
               THISFORM.AV7C2984 = AuxAV7C2984
               AuxAV8C2985 = THISFORM.AV8C2985
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09852,4,@AuxAV8C2985,0)
               THISFORM.AV8C2985 = AuxAV8C2985
               AuxAV9C2986 = THISFORM.AV9C2986
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09852,5,@AuxAV9C2986,0)
               THISFORM.AV9C2986 = AuxAV9C2986
               AuxAV10C2987 = THISFORM.AV10C2987
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W09852,6,@AuxAV10C2987,0)
               THISFORM.AV10C2987 = AuxAV10C2987
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09852,7,PADR( TRIM(THISFORM.AV11C2988),1, '%'),LEN(PADR( TRIM(THISFORM.AV11C2988),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09852) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09852 = Gx_err
               THISFORM.GX_DB_GetW09852_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09852 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09852) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09852 = Gx_err
                  THISFORM.GX_DB_GetW09852_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09852 <> 101
               BRKVRD2 = .F.
               THISFORM.A2986FchVi = THISFORM.Buf_W09852_2986FchVigDde
               THISFORM.A2987FchVi = THISFORM.Buf_W09852_2987FchVigHta
               THISFORM.A2988TipoC = THISFORM.Buf_W09852_2988TipoContr
               THISFORM.A2985RetIb = THISFORM.Buf_W09852_2985RetIb
               THISFORM.A2984perIb = THISFORM.Buf_W09852_2984perIb
               THISFORM.A2983perio = THISFORM.Buf_W09852_2983periodo
               THISFORM.A2658CUIT = THISFORM.Buf_W09852_2658CUIT
               GX_SFLOAD = 0
               THISFORM.U12VRD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09852) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09852 = Gx_err
               THISFORM.GX_DB_GetW09852_01 ()
            ENDDO
         ENDIF
      ENDPROC
