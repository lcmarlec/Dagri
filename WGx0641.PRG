                  cmdbuf = cmdbuf + "  like ?) AND ([ParModFch] >= ?) ORDER BY [EmpCod], [ParCod], [ParSCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11282,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11282,9)
                  THISFORM.GX_DB_BindColsW11282_01 ()
                  THISFORM.GX_DB_BindParmW11282_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11282,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11282,2,PADR( TRIM(THISFORM.AV5C1888),10, '%'),LEN(PADR( TRIM(THISFORM.AV5C1888),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11282,3,PADR( TRIM(THISFORM.AV6C1889),10, '%'),LEN(PADR( TRIM(THISFORM.AV6C1889),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11282,4,PADR( TRIM(THISFORM.AV7C2213),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C2213),10, '%')),0)
               AuxAV8C2214 = THISFORM.AV8C2214
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W11282,5,@AuxAV8C2214,0)
               THISFORM.AV8C2214 = AuxAV8C2214
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11282,6,PADR( TRIM(THISFORM.AV9C2215),10, '%'),LEN(PADR( TRIM(THISFORM.AV9C2215),10, '%')),0)
               AuxAV10C2216 = THISFORM.AV10C2216
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W11282,7,@AuxAV10C2216,0)
               THISFORM.AV10C2216 = AuxAV10C2216
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11282) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11282 = Gx_err
               THISFORM.GX_DB_GetW11282_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11282 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11282) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11282 = Gx_err
                  THISFORM.GX_DB_GetW11282_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11282 <> 101
               BRKVVC2 = .F.
               THISFORM.A2214ParAl = THISFORM.Buf_W11282_2214ParAltFch
               THISFORM.A2215ParMo = THISFORM.Buf_W11282_2215ParModUsu
               THISFORM.A2216ParMo = THISFORM.Buf_W11282_2216ParModFch
               THISFORM.A2217ParVi = THISFORM.Buf_W11282_2217ParVis
               THISFORM.A2213ParAl = THISFORM.Buf_W11282_2213ParAltUsu
               THISFORM.A1889ParSC = THISFORM.Buf_W11282_1889ParSCod
               THISFORM.A1888ParCo = THISFORM.Buf_W11282_1888ParCod
               GX_SFLOAD = 0
               THISFORM.U12VVC2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11282) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11282 = Gx_err
               THISFORM.GX_DB_GetW11282_01 ()
            ENDDO
         ENDIF
      ENDPROC
