            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
