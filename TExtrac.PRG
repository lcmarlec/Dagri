         * Search in Sub-File
         SELECT (THISFORM. cCT126S38 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT126S38 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT126S38 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1223ExtNr = THISFORM.A1223ExtNr .AND. S1230ExtCt = THISFORM.A1230ExtCt
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT126S38 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT126S38 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1223ExtNr = THISFORM.A1223ExtNr .AND. S1230ExtCt = THISFORM.A1230ExtCt
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT126S38 .Refresh()
               THISFORM. cCT126S38 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1223ExtNr = S1223ExtNr
               THISFORM.A1230ExtCt = S1230ExtCt
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT126S38 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT126S38 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1223ExtNr = THISFORM.A1223ExtNr .AND. S1230ExtCt = THISFORM.A1230ExtCt
            DO WHILE sf_err = 0 .and. !GX_fcond
