      Gxline = "<tr><td>" + R1289CBMCt + "</td><td>" + str( R1287CBMCo , 4 ) + "</td><td>" + R1288CBMDs + "</td><td>" + "Conc. Banc." + "</td><td>" + RV22Ok + "</td></tr>"
      * User Code
      fputs(gxArch, gxline)
      * Check if program is canceled.
      DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
      IF UserCancel
         EXIT
      ENDIF
      Gx_eop = 1
      DO WHILE Gx_eop != 0
         Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R05329) ,  ,  ,  , CS_SQLSRV ,  )
      ENDDO
      R05329 = Gx_err
      GX_DB_GetR05329_01 ()
      IF UserCancel
         EXIT
      ENDIF
   ENDDO
   Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_R05329) ,  ,  ,  , CS_SQLSRV ,  )
   LEVEL9 = .F.
   * User Code
   fclose(gxArch)
   RV25I = opendocument( Gxarchivo )
   DO EPES0
   DO ReleaseReport IN GXForm.prg
   RETURN
   GX_retp = 0
* End Program

