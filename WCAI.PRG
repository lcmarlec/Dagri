      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04212" , @HStmt_W04212 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCAI","W04212","",GX_CURSOR_TYPE_READONLY,@HStmt_W04212) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CAIVig], [CAINro], [CAIFchHta], [CAIFchDde], [CAINroHta], [CAINroDde], "
                  cmdbuf = cmdbuf + "  [CAISuc], [CAISer], [CAITipDoc] FROM [CAI] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [CAITipDoc] = ?) AND ([CAISuc] = ? or ? = 0) AND ([CAIVig] = 'S' or ? = "
                  cmdbuf = cmdbuf + "  'N') ORDER BY [EmpCod], [CAITipDoc], [CAISer], [CAISuc], [CAINroDde]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04212,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04212,10)
                  THISFORM.GX_DB_BindColsW04212_01 ()
                  THISFORM.GX_DB_BindParmW04212_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04212,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV20Desde = THISFORM.AV20Desde
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04212,2,AuxAV20Desde,2,0)
               THISFORM.AV20Desde = AuxAV20Desde
               AuxAV21Sucdde = THISFORM.AV21Sucdde
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04212,3,@AuxAV21Sucdde,0)
               THISFORM.AV21Sucdde = AuxAV21Sucdde
               AuxAV21Sucdde = THISFORM.AV21Sucdde
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04212,4,@AuxAV21Sucdde,0)
               THISFORM.AV21Sucdde = AuxAV21Sucdde
               AuxAV22Caivig = THISFORM.AV22Caivig
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04212,5,AuxAV22Caivig,1,0)
               THISFORM.AV22Caivig = AuxAV22Caivig
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04212 = Gx_err
               THISFORM.GX_DB_GetW04212_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WCAI"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04212 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04212) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04212 = Gx_err
                  THISFORM.GX_DB_GetW04212_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04212 <> 101
               BRKVBP2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W04212_2EmpCod
               THISFORM.A1884CAIVi = THISFORM.Buf_W04212_1884CAIVig
               THISFORM.A1339CAINr = THISFORM.Buf_W04212_1339CAINro
               THISFORM.A1338CAIFc = THISFORM.Buf_W04212_1338CAIFchHta
               THISFORM.A1337CAIFc = THISFORM.Buf_W04212_1337CAIFchDde
               THISFORM.A1343CAINr = THISFORM.Buf_W04212_1343CAINroHta
               THISFORM.A1342CAINr = THISFORM.Buf_W04212_1342CAINroDde
               THISFORM.A1341CAISu = THISFORM.Buf_W04212_1341CAISuc
               THISFORM.A1376CAISe = THISFORM.Buf_W04212_1376CAISer
               THISFORM.A1340CAITi = THISFORM.Buf_W04212_1340CAITipDoc
               GX_SFLOAD = 0
               THISFORM.U16VBP2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04212) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04212 = Gx_err
               THISFORM.GX_DB_GetW04212_01 ()
            ENDDO
         ENDIF
      ENDPROC
