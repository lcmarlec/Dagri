               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02566" , @HStmt_T02566 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESNV","T02566","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02566) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CLTES] ([EmpCod], [EntGruTip], [EntCod], [EntLgCod], [EntLgDsc], [EntLgDom], "
                  cmdbuf = cmdbuf + "  [EntLgCop], [EntLgPaiCo], [EntLgPciCo], [EntLgMunCo], [EntLgCont], [EntLgTel], [EntLgFVt], "
                  cmdbuf = cmdbuf + "  [EntLgVdrCo], [EntLgOrden], [Entlgloc], [EntLgCIvCo], [EntLgIBRet], [EntLgGrpOf], "
                  cmdbuf = cmdbuf + "  [EntLgInhab], [entLgInhMo], [EntLgEan], [EntLgIBTuc], [EntLgPos], [EntLgBcoEx], "
                  cmdbuf = cmdbuf + "  [EntLgDNro], [EntlgObs], [EntLgMisEx], [EntLgMEV]) VALUES (?, ?, ?, ?, ?, ?, ?, "
                  cmdbuf = cmdbuf + "  ' ', ' ', ' ', ' ', ' ', ' ', convert(int, 0), ' ', ' ', convert(int, 0), ' ', convert(int, "
                  cmdbuf = cmdbuf + "  0), ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ', convert(int, 0), convert( DATETIME, "
                  cmdbuf = cmdbuf + "  '17530101', 112 )) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02566,cmdbuf)
                  THISFORM.GX_DB_BindParmT02566_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02566,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T02566,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T02566,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA176EntLgC = THISFORM.A176EntLgC
               Gx_err = GX_DB_SetInt( HStmt_T02566,4,@AuxA176EntLgC,0)
               THISFORM.A176EntLgC = AuxA176EntLgC
               AuxA177EntLgD = THISFORM.A177EntLgD
               Gx_err = GX_DB_SetStr( HStmt_T02566,5,AuxA177EntLgD,30,0)
               THISFORM.A177EntLgD = AuxA177EntLgD
               AuxA178EntLgD = THISFORM.A178EntLgD
               Gx_err = GX_DB_SetStr( HStmt_T02566,6,AuxA178EntLgD,40,0)
               THISFORM.A178EntLgD = AuxA178EntLgD
               AuxA2504EntLg = THISFORM.A2504EntLg
               Gx_err = GX_DB_SetInt( HStmt_T02566,7,@AuxA2504EntLg,0)
               THISFORM.A2504EntLg = AuxA2504EntLg
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02566) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02566 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02566) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02566 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02567" , @HStmt_T02567 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESNV","T02567","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02567) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [CLTES] SET [EntLgDsc]=?, [EntLgDom]=?, [EntLgCop]=?  WHERE [EmpCod] = ? AND "
                  cmdbuf = cmdbuf + "  [EntGruTip] = ? AND [EntCod] = ? AND [EntLgCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02567,cmdbuf)
                  THISFORM.GX_DB_BindParmT02567_01 ()
               ENDIF
               AuxA177EntLgD = THISFORM.A177EntLgD
               Gx_err = GX_DB_SetStr( HStmt_T02567,1,AuxA177EntLgD,30,0)
               THISFORM.A177EntLgD = AuxA177EntLgD
               AuxA178EntLgD = THISFORM.A178EntLgD
               Gx_err = GX_DB_SetStr( HStmt_T02567,2,AuxA178EntLgD,40,0)
               THISFORM.A178EntLgD = AuxA178EntLgD
               AuxA2504EntLg = THISFORM.A2504EntLg
               Gx_err = GX_DB_SetInt( HStmt_T02567,3,@AuxA2504EntLg,0)
               THISFORM.A2504EntLg = AuxA2504EntLg
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02567,4,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T02567,5,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T02567,6,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA176EntLgC = THISFORM.A176EntLgC
               Gx_err = GX_DB_SetInt( HStmt_T02567,7,@AuxA176EntLgC,0)
               THISFORM.A176EntLgC = AuxA176EntLgC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02567) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02567 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02567) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02568" , @HStmt_T02568 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCLTESNV","T02568","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02568) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CLTES]  WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? AND "
                  cmdbuf = cmdbuf + "  [EntLgCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02568,cmdbuf)
                  THISFORM.GX_DB_BindParmT02568_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02568,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T02568,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T02568,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               AuxA176EntLgC = THISFORM.A176EntLgC
               Gx_err = GX_DB_SetInt( HStmt_T02568,4,@AuxA176EntLgC,0)
               THISFORM.A176EntLgC = AuxA176EntLgC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02568) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02568 = Gx_err
               THISFORM.T02562 = iif( THISFORM.T02568 = 0 , 104 , THISFORM.T02568 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02568) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A120EntCod , 6 ) + "-" + str( THISFORM.A176EntLgC , 3 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "TABL" , Aux1 , "CLTESUC" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT256V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 16 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
