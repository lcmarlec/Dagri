      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.A2504EntLg
         THIS.SetTabOrder
         THIS.GX_OldValue = THISFORM.A2504EntLg
         THIS.GX_Level = 16
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         THISFORM. GXInLvl16 = .T.
         IF THISFORM.GX_last_fld_lvl = 16
            IF ! THISFORM. gx_16insert
               THISFORM.SetLevel( 16 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 16
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 16 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02563) , "TCLTESNV" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02562) , "TCLTESNV" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02564) , "TCLTESNV" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT256A2504 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 16
            IF ! THISFORM. gx_16insert
               THISFORM.SetLevel( 16 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_16insert
            THISFORM. gx_16insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 16 )
            THISFORM. cCT256A176 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 16
            THISFORM.SetLevel( 16 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT256A120 .InitLevel( 16 )
            THISFORM.GX_last_fld_lvl = 16
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2504EntLg"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl16
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_16insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_16insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_16insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_16insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT256A176 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_16insert = .F.
               THISFORM.gx_insert = THISFORM. gx_16insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02562,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA150EntGru = THISFORM.A150EntGru
            Gx_err = GX_DB_SetStr( HStmt_T02562,2,AuxA150EntGru,2,0)
            THISFORM.A150EntGru = AuxA150EntGru
            AuxA120EntCod = THISFORM.A120EntCod
            Gx_err = GX_DB_SetLong( HStmt_T02562,3,@AuxA120EntCod,0)
            THISFORM.A120EntCod = AuxA120EntCod
            AuxA176EntLgC = THISFORM.A176EntLgC
            Gx_err = GX_DB_SetInt( HStmt_T02562,4,@AuxA176EntLgC,0)
            THISFORM.A176EntLgC = AuxA176EntLgC
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02562) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02562 = Gx_err
            THISFORM.GX_DB_GetT02562_01 ()
            IF .NOT. THISFORM.T02562 <> 103
               DO GX_ERRMW WITH "CLTES reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02562 = 101 .OR. THISFORM.Z177EntLgD <> THISFORM.Buf_T02562_177EntLgDsc
               DO GX_ERRMW WITH "CLTES fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
