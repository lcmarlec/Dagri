         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A402TdcNim"
            THISFORM.A402TdcNim = THISFORM.Buf_T012519_402TdcNim
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A404TdcImp"
            THISFORM.A404TdcImp = THISFORM.Buf_T012519_404TdcImpCnt
         ENDIF
