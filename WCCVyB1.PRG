      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A1960CCRcv = 0
         THISFORM.A1961CCChq = 0
         THISFORM.A1937CCChq = SPACE(10)
         THISFORM.A1949CCEnt = 0
         THISFORM.A1950CCEnt = SPACE(40)
         THISFORM.A1938CCDes = SPACE(50)
         THISFORM.A1943CCImp = 0.00
         THISFORM.A1940CCImp = 0.00
         THISFORM.A1939CCFch = CTOD("  /  /  ")
         THISFORM.A1945CCPag = 0
         THISFORM.A2EmpCod = 0
         THISFORM.A1946CCVdr = 0
         THISFORM.A1935CCRcv = 0
         THISFORM.A1936CCRcv = 0
         THISFORM.A1959CCChq = 0
