      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA260CLCodC = THISFORM.A260CLCodC
            Gx_err = GX_DB_SetLong( HStmt_T00282,1,@AuxA260CLCodC,0)
            THISFORM.A260CLCodC = AuxA260CLCodC
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00282) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00282 = Gx_err
            THISFORM.GX_DB_GetT00282_01 ()
            IF .NOT. THISFORM.T00282 <> 103
               DO GX_ERRMW WITH "DBCL0000 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00282 = 101 .OR. THISFORM.Z261CLRazC <> THISFORM.Buf_T00282_261CLRazCli
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z266CLTelC <> THISFORM.Buf_T00282_266CLTelCom
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z271CLTipC <> THISFORM.Buf_T00282_271CLTipCli
               DO GX_ERRMW WITH "DBCL0000 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00285" , @HStmt_T00285 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBCL000","T00285","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00285) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [DBCL0000] ([CLCodCli], [CLRazCli], [CLNomFan], [CLDomLeg], [CLCPoLeg], "
                  cmdbuf = cmdbuf + "  [CLPrvLeg], [CLTelCom], [CLTelFax], [CLCuiCli], [CLCatIva], [CLPlazop], [CLTipCli]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00285,cmdbuf)
                  THISFORM.GX_DB_BindParmT00285_01 ()
               ENDIF
               AuxA260CLCodC = THISFORM.A260CLCodC
               Gx_err = GX_DB_SetLong( HStmt_T00285,1,@AuxA260CLCodC,0)
               THISFORM.A260CLCodC = AuxA260CLCodC
               AuxA261CLRazC = THISFORM.A261CLRazC
               Gx_err = GX_DB_SetStr( HStmt_T00285,2,AuxA261CLRazC,30,0)
               THISFORM.A261CLRazC = AuxA261CLRazC
               AuxA262CLNomF = THISFORM.A262CLNomF
               Gx_err = GX_DB_SetStr( HStmt_T00285,3,AuxA262CLNomF,25,0)
               THISFORM.A262CLNomF = AuxA262CLNomF
               AuxA263CLDomL = THISFORM.A263CLDomL
               Gx_err = GX_DB_SetStr( HStmt_T00285,4,AuxA263CLDomL,30,0)
               THISFORM.A263CLDomL = AuxA263CLDomL
               AuxA264CLCPoL = THISFORM.A264CLCPoL
               Gx_err = GX_DB_SetInt( HStmt_T00285,5,@AuxA264CLCPoL,0)
               THISFORM.A264CLCPoL = AuxA264CLCPoL
               AuxA265CLPrvL = THISFORM.A265CLPrvL
               Gx_err = GX_DB_SetStr( HStmt_T00285,6,AuxA265CLPrvL,4,0)
               THISFORM.A265CLPrvL = AuxA265CLPrvL
               AuxA266CLTelC = THISFORM.A266CLTelC
               Gx_err = GX_DB_SetStr( HStmt_T00285,7,AuxA266CLTelC,30,0)
               THISFORM.A266CLTelC = AuxA266CLTelC
               AuxA267CLTelF = THISFORM.A267CLTelF
               Gx_err = GX_DB_SetStr( HStmt_T00285,8,AuxA267CLTelF,30,0)
               THISFORM.A267CLTelF = AuxA267CLTelF
               AuxA268CLCuiC = THISFORM.A268CLCuiC
               Gx_err = GX_DB_SetDouble( HStmt_T00285,9,@AuxA268CLCuiC,0)
               THISFORM.A268CLCuiC = AuxA268CLCuiC
               AuxA269CLCatI = THISFORM.A269CLCatI
               Gx_err = GX_DB_SetInt( HStmt_T00285,10,@AuxA269CLCatI,0)
               THISFORM.A269CLCatI = AuxA269CLCatI
               AuxA270CLPlaz = THISFORM.A270CLPlaz
               Gx_err = GX_DB_SetInt( HStmt_T00285,11,@AuxA270CLPlaz,0)
               THISFORM.A270CLPlaz = AuxA270CLPlaz
               AuxA271CLTipC = THISFORM.A271CLTipC
               Gx_err = GX_DB_SetInt( HStmt_T00285,12,@AuxA271CLTipC,0)
               THISFORM.A271CLTipC = AuxA271CLTipC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00285) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00285 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00285) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00285 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00286" , @HStmt_T00286 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBCL000","T00286","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00286) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [DBCL0000] SET [CLRazCli]=?, [CLNomFan]=?, [CLDomLeg]=?, [CLCPoLeg]=?, [CLPrvLeg]=?, "
                  cmdbuf = cmdbuf + "  [CLTelCom]=?, [CLTelFax]=?, [CLCuiCli]=?, [CLCatIva]=?, [CLPlazop]=?, [CLTipCli]=? "
                  cmdbuf = cmdbuf + "   WHERE [CLCodCli] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00286,cmdbuf)
                  THISFORM.GX_DB_BindParmT00286_01 ()
               ENDIF
               AuxA261CLRazC = THISFORM.A261CLRazC
               Gx_err = GX_DB_SetStr( HStmt_T00286,1,AuxA261CLRazC,30,0)
               THISFORM.A261CLRazC = AuxA261CLRazC
               AuxA262CLNomF = THISFORM.A262CLNomF
               Gx_err = GX_DB_SetStr( HStmt_T00286,2,AuxA262CLNomF,25,0)
