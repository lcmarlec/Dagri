      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 25
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT28A260 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 25
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA260CLCodC = THISFORM.A260CLCodC
                  Gx_err = GX_DB_SetLong( HStmt_T00283,1,@AuxA260CLCodC,0)
                  THISFORM.A260CLCodC = AuxA260CLCodC
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00283) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00283 = Gx_err
                  THISFORM.GX_DB_GetT00283_01 ()
                  THISFORM. cCT28A260 . ZM0S25 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0S25 ()
               THISFORM. cCT28A260 . ZM0S25 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0S25 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT28A271 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0S25 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0S25 ()
                  RETURN
               ENDIF
               THISFORM.cCT28A260.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00283) , "TDBCL000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00282) , "TDBCL000" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT28A271 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT28A260 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

