      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00284" , @HStmt_T00284 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDBCL000","T00284","",GX_CURSOR_TYPE_READONLY,@HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [CLCodCli], [CLRazCli], [CLNomFan], [CLDomLeg], [CLCPoLeg], [CLPrvLeg], [CLTelCom], "
            cmdbuf = cmdbuf + "  [CLTelFax], [CLCuiCli], [CLCatIva], [CLPlazop], [CLTipCli] FROM [DBCL0000] (FASTFIRSTROW "
            cmdbuf = cmdbuf + "  NOLOCK) WHERE [CLCodCli] >= ? ORDER BY [CLCodCli]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00284,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00284,100)
            THISFORM.GX_DB_BindColsT00284_01 ()
            THISFORM.GX_DB_BindParmT00284_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A260CLCodC = 0
               ENDIF
               AuxA260CLCodC = THISFORM.A260CLCodC
               Gx_err = GX_DB_SetLong( HStmt_T00284,1,@AuxA260CLCodC,0)
               THISFORM.A260CLCodC = AuxA260CLCodC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00284 = Gx_err
               THISFORM.GX_DB_GetT00284_01 ()
               Gx_fcond = THISFORM.T00284 <> 101
            CASE GXOP = 2 && Next record
               AuxA260CLCodC = THISFORM.A260CLCodC
               Gx_err = GX_DB_SetLong( HStmt_T00284,1,@AuxA260CLCodC,0)
               THISFORM.A260CLCodC = AuxA260CLCodC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00284 = Gx_err
               THISFORM.GX_DB_GetT00284_01 ()
               DO WHILE THISFORM.T00284 = 0 .AND. THISFORM.A260CLCodC >= THISFORM.Buf_T00284_260CLCodCli
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00284 = Gx_err
                  THISFORM.GX_DB_GetT00284_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00284 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A260CLCodC = 0
               AuxA260CLCodC = THISFORM.A260CLCodC
               Gx_err = GX_DB_SetLong( HStmt_T00284,1,@AuxA260CLCodC,0)
               THISFORM.A260CLCodC = AuxA260CLCodC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00284 = Gx_err
               THISFORM.GX_DB_GetT00284_01 ()
               DO WHILE THISFORM.T00284 = 0
                  THISFORM.A260CLCodC = THISFORM.Buf_T00284_260CLCodCli
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00284 = Gx_err
                  THISFORM.GX_DB_GetT00284_01 ()
               ENDDO
               AuxA260CLCodC = THISFORM.A260CLCodC
               Gx_err = GX_DB_SetLong( HStmt_T00284,1,@AuxA260CLCodC,0)
               THISFORM.A260CLCodC = AuxA260CLCodC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00284) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00284 = Gx_err
               THISFORM.GX_DB_GetT00284_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A260CLCodC = THISFORM.Buf_T00284_260CLCodCli
               THISFORM.A261CLRazC = THISFORM.Buf_T00284_261CLRazCli
               THISFORM.A262CLNomF = THISFORM.Buf_T00284_262CLNomFan
               THISFORM.A263CLDomL = THISFORM.Buf_T00284_263CLDomLeg
               THISFORM.A264CLCPoL = THISFORM.Buf_T00284_264CLCPoLeg
               THISFORM.A265CLPrvL = THISFORM.Buf_T00284_265CLPrvLeg
               THISFORM.A266CLTelC = THISFORM.Buf_T00284_266CLTelCom
               THISFORM.A267CLTelF = THISFORM.Buf_T00284_267CLTelFax
               THISFORM.A268CLCuiC = THISFORM.Buf_T00284_268CLCuiCli
               THISFORM.A269CLCatI = THISFORM.Buf_T00284_269CLCatIva
               THISFORM.A270CLPlaz = THISFORM.Buf_T00284_270CLPlazop
               THISFORM.A271CLTipC = THISFORM.Buf_T00284_271CLTipCli
         ENDCASE
         Gx_fcond = THISFORM.T00284 <> 101 .AND. THISFORM.T00284 <> 101
         IF .NOT. Gx_fcond
