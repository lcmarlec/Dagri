      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.AV35Nroope = 0
         THISFORM.A2911McoTi = SPACE(2)
         THISFORM.A2912McoSe = SPACE(1)
         THISFORM.A2913McoSu = 0
         THISFORM.A2914McoNr = 0
         THISFORM.A2915McoFc = CTOD("  /  /  ")
         THISFORM.AV29Monsim = SPACE(3)
