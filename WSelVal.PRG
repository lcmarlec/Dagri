      PROCEDURE LoadVarFromCtrl
         IF THIS.ActiveColumn = 7
            THISFORM.AV29Monsim = THIS.Column7.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 10
            THISFORM.AV43Impori = THIS.Column10.Ctrl1.Value
         ENDIF
         IF THIS.ActiveColumn = 11
            THISFORM.AV28Sel = THISFORM.cCW1191S28.Columns(11).Ctrl1.TextToVal(THIS.Column11.Ctrl1.Value,"int",1)
         ENDIF
