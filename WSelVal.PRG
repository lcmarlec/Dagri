      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW1191S28 .GX_SfAlias)
            GO TOP
            THISFORM.cCW1191S28 .Refresh()
         ENDIF
         THISFORM. cCW1191S28 .GXSetRepos( .F. )
