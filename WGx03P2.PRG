               THISFORM.AV9C1192 = AuxAV9C1192
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03402) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03402 = Gx_err
               THISFORM.GX_DB_GetW03402_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03402 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03402) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03402 = Gx_err
                  THISFORM.GX_DB_GetW03402_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03402 <> 101
               BRKV9G2 = .F.
               THISFORM.A1192dcvCh = THISFORM.Buf_W03402_1192dcvChNroI
               THISFORM.A1191dcvCh = THISFORM.Buf_W03402_1191dcvChImp
               THISFORM.A1190dcvch = THISFORM.Buf_W03402_1190dcvchObs
               THISFORM.A1189dcVch = THISFORM.Buf_W03402_1189dcVchNro
               THISFORM.A1188dcVch = THISFORM.Buf_W03402_1188dcVchNroRe
               GX_SFLOAD = 0
               THISFORM.U12V9G2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03402) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03402 = Gx_err
               THISFORM.GX_DB_GetW03402_01 ()
            ENDDO
         ENDIF
      ENDPROC
