      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02754" , @HStmt_T02754 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSECTOR","T02754","",GX_CURSOR_TYPE_READONLY,@HStmt_T02754) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [SecCod], [SecDsc] FROM [SECTOR] (FASTFIRSTROW NOLOCK) WHERE [SecCod] >= ? "
            cmdbuf = cmdbuf + "  ORDER BY [SecCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02754,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02754,100)
            THISFORM.GX_DB_BindColsT02754_01 ()
            THISFORM.GX_DB_BindParmT02754_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2651SecCo = 0
