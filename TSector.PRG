               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2652SecDs"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl304
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF EMPTY( THISFORM.A2652SecDs )
            DO GX_ERRMW WITH "Debe ingresar un nombre de sector  !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_304insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_304insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_304insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_304insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT275A2651 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_304insert = .F.
               THISFORM.gx_insert = THISFORM. gx_304insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2651SecCo = THISFORM.A2651SecCo
            Gx_err = GX_DB_SetInt( HStmt_T02752,1,@AuxA2651SecCo,0)
            THISFORM.A2651SecCo = AuxA2651SecCo
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02752) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02752 = Gx_err
            THISFORM.GX_DB_GetT02752_01 ()
            IF .NOT. THISFORM.T02752 <> 103
               DO GX_ERRMW WITH "SECTOR reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02752 = 101 .OR. THISFORM.Z2652SecDs <> THISFORM.Buf_T02752_2652SecDsc
               DO GX_ERRMW WITH "SECTOR fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02755" , @HStmt_T02755 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSECTOR","T02755","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02755) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [SECTOR] ([SecCod], [SecDsc]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02755,cmdbuf)
                  THISFORM.GX_DB_BindParmT02755_01 ()
               ENDIF
               AuxA2651SecCo = THISFORM.A2651SecCo
               Gx_err = GX_DB_SetInt( HStmt_T02755,1,@AuxA2651SecCo,0)
               THISFORM.A2651SecCo = AuxA2651SecCo
               AuxA2652SecDs = THISFORM.A2652SecDs
               Gx_err = GX_DB_SetStr( HStmt_T02755,2,AuxA2652SecDs,40,0)
               THISFORM.A2652SecDs = AuxA2652SecDs
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02755) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02755 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02755) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02755 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02756" , @HStmt_T02756 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSECTOR","T02756","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02756) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [SECTOR] SET [SecDsc]=?  WHERE [SecCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02756,cmdbuf)
                  THISFORM.GX_DB_BindParmT02756_01 ()
               ENDIF
               AuxA2652SecDs = THISFORM.A2652SecDs
               Gx_err = GX_DB_SetStr( HStmt_T02756,1,AuxA2652SecDs,40,0)
               THISFORM.A2652SecDs = AuxA2652SecDs
               AuxA2651SecCo = THISFORM.A2651SecCo
               Gx_err = GX_DB_SetInt( HStmt_T02756,2,@AuxA2651SecCo,0)
               THISFORM.A2651SecCo = AuxA2651SecCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02756) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02756 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02756) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02757" , @HStmt_T02757 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TSECTOR","T02757","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02757) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [SECTOR]  WHERE [SecCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02757,cmdbuf)
                  THISFORM.GX_DB_BindParmT02757_01 ()
               ENDIF
               AuxA2651SecCo = THISFORM.A2651SecCo
               Gx_err = GX_DB_SetInt( HStmt_T02757,1,@AuxA2651SecCo,0)
               THISFORM.A2651SecCo = AuxA2651SecCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02757) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02757 = Gx_err
               THISFORM.T02752 = iif( THISFORM.T02757 = 0 , 104 , THISFORM.T02757 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02757) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A2651SecCo , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "MAES" , Aux1 , "SECTOR" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT275V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 304 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
