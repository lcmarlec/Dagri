      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T007816" , @HStmt_T007816 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOFERTA","T007816","",GX_CURSOR_TYPE_READONLY,@HStmt_T007816) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfeFDe], [EntGruTip], [EntCod], "
                  cmdbuf = cmdbuf + "  [EntLgCod] FROM [OFERTA1] (NOLOCK) WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] "
                  cmdbuf = cmdbuf + "  = ? AND [ArtCod] = ? AND [OfeFDe] = ? AND [EntGruTip] = ? AND [EntCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfeFDe], [EntGruTip], [EntCod], [EntLgCod] "
                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007816,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007816,11)
                  THISFORM.GX_DB_BindColsT007816_01 ()
                  THISFORM.GX_DB_BindParmT007816_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T007816,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T007816,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T007816,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T007816,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               AuxA705OfeFDe = THISFORM.A705OfeFDe
               Gx_err = GX_DB_SetDate( HStmt_T007816,5,@AuxA705OfeFDe,0)
               THISFORM.A705OfeFDe = AuxA705OfeFDe
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T007816,6,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T007816,7,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007816) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007816 = Gx_err
               THISFORM.GX_DB_GetT007816_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T007816 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007816) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T007816 = Gx_err
                  THISFORM.GX_DB_GetT007816_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T007816 <> 101
               BRK2679 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT78S36.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T007816_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007816) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007816 = Gx_err
               THISFORM.GX_DB_GetT007816_01 ()
            ENDDO
         ENDIF
      ENDPROC
