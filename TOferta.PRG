      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         SELECT ( THISFORM.cCT78S36 .GX_SfAlias)
         THIS.GX_mouse = .F.
         IF MDOWN()
            gx_dummy_var = 1
            THIS.GX_mouse = .T.
         ENDIF
         ON KEY LABEL ENTER
         IF THIS.GX_Valid_SetFocus
            RETURN
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 79
            IF THIS.gx_ret > 0
               gx_val_ret = THIS.gx_ret
            ELSE
               gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.Parent.Parent.GxObjOrder)
            ENDIF
            IF gx_val_ret >= 0
               IF THIS.GX_Mouse
                  THIS.GotMouseDown()
               ENDIF
               NODEFAULT
               IF gx_val_ret >= 0
                  IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                     THISFORM.ReleaseAll()
                  ENDIF
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
            IF THISFORM.GX_NewLastVld != -1
               THISFORM.GX_LastVld = THISFORM.GX_NewLastVld
               THISFORM.GX_NewLastVld = -1
               NODEFAULT
               RETURN
            ENDIF
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 79 )
               RETURN
            ENDIF
            THISFORM. cCT78S36 .SaveKey()
         ENDIF
         gx_a_trn = .F.
         THISFORM. cCT78S36 .GX_focusInGrid = .T.
         IF THISFORM.GX_Mode != "INS"
            THISFORM. cCT78S36 . AfterRowColChange1()
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 79
            THISFORM.SetLevel( 79 )
            THISFORM.SetMode("", "N" )
            THISFORM. cCT78S36.Columns(1).Ctrl1 .InitLevel( 79 )
            THISFORM.GX_last_fld_lvl = 79
         ELSE
            IF gx_a_trn
