         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT78S36 .Refresh()
               THISFORM. cCT78S36 .AfterRowColChange1()
