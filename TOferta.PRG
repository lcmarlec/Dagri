            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2817EntLg"
         THISFORM.cCT78S36 .SaveFocus(THIS.GXColumnNo)
         IF ( THISFORM.cCT78S36 .GX_lastkey = 9.or. THISFORM.cCT78S36 .GX_lastkey = 13) .and. THISFORM.Gx_load_key
            THISFORM.cCT78S36 .GridValidObj( THISFORM.cCT78S36 .ColumnCount + 1)
         ENDIF
