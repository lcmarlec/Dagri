         THISFORM.LockScreen = .T.
         THISFORM. cCT78S36 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT78S36 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S705OfeFDe = THISFORM.A705OfeFDe
