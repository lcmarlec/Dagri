      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06442" , @HStmt_W06442 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCONAUD1","W06442","",GX_CURSOR_TYPE_READONLY,@HStmt_W06442) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [AudSist], [AudEmpCod], [AudWrk], [AudObs], [AudNro], [AudCodObj], [AudUsu], "
                  cmdbuf = cmdbuf + "  [Audtime], [AudCodAct], [AudFch] FROM [AUDIT] (FASTFIRSTROW NOLOCK) WHERE ([AudEmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [AudFch] >= ?) AND ([AudCodAct] <> 'AL' or ? = 'A') AND ([AudFch] <= ?) "
                  cmdbuf = cmdbuf + "  ORDER BY [AudEmpCod], [AudFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06442,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06442,14)
                  THISFORM.GX_DB_BindColsW06442_01 ()
                  THISFORM.GX_DB_BindParmW06442_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06442,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV24Audfch = THISFORM.AV24Audfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06442,2,@AuxAV24Audfch,0)
               THISFORM.AV24Audfch = AuxAV24Audfch
               AuxAV26Tipo = THISFORM.AV26Tipo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06442,3,AuxAV26Tipo,1,0)
               THISFORM.AV26Tipo = AuxAV26Tipo
               AuxAV25Audfch = THISFORM.AV25Audfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06442,4,@AuxAV25Audfch,0)
               THISFORM.AV25Audfch = AuxAV25Audfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06442 = Gx_err
               THISFORM.GX_DB_GetW06442_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WConAud1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06442 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06442) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06442 = Gx_err
                  THISFORM.GX_DB_GetW06442_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06442 <> 101
               BRKVHW2 = .F.
               THISFORM.A47AudEmpC = THISFORM.Buf_W06442_47AudEmpCod
               THISFORM.A53AudWrk = THISFORM.Buf_W06442_53AudWrk
               THISFORM.A13AudObs = THISFORM.Buf_W06442_13AudObs
               THISFORM.A14AudNro = THISFORM.Buf_W06442_14AudNro
               THISFORM.A51AudCodO = THISFORM.Buf_W06442_51AudCodObj
               THISFORM.A52AudUsu = THISFORM.Buf_W06442_52AudUsu
               THISFORM.A49Audtime = THISFORM.Buf_W06442_49Audtime
               THISFORM.A50AudCodA = THISFORM.Buf_W06442_50AudCodAct
               THISFORM.A48AudFch = THISFORM.Buf_W06442_48AudFch
               IF GXSSRCH( THISFORM.AV29Usuari , ALLTRIM( THISFORM.A52AudUsu ) ) <> 0
                  GX_SFLOAD = 0
                  THISFORM.U13VHW2 ()
                  THIS.GX_CUPOS = 0
                  DO CASE
                     CASE GX_SFLOAD = 1
                        GX_CUERR = 0
                        EXIT
                     CASE GX_SFLOAD = 2
                        GX_CUERR = 100
                        EXIT
                  ENDCASE
                  IF UserCancel
                     EXIT
                  ENDIF
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06442) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06442 = Gx_err
               THISFORM.GX_DB_GetW06442_01 ()
            ENDDO
         ENDIF
      ENDPROC
