      PROCEDURE CreateTemp
         LOCAL SCW644S8
         SCW644S8 = ""
         IF USED( "SCW644S8" )
            SELECT SCW644S8
            SCW644S8 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW644S8
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA48AudFch"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA50AudCod"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 240
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA49Audtim"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA52AudUsu"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 10
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA51AudCod"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA14AudNro"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 30
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA13AudObs"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 60
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA53AudWrk"
            GX_STRUCT[ 8 ,2]= "C"
            GX_STRUCT[ 8 ,3]= 10
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW644S8 = GETE('z:\temp') + '\' + SCW644S8
            ENDIF
            CREATE DBF (SCW644S8) FROM ARRAY GX_STRUCT
            USE
            USE (SCW644S8) EXCLUSIVE ALIAS SCW644S8
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW644S8
