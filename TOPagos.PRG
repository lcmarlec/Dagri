      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S708OPaNro
         LOCAL S719OPaNro
         S2EmpCod = THISFORM.A2EmpCod
         S708OPaNro = THISFORM.A708OPaNro
         S719OPaNro = THISFORM.A719OPaNro
         THISFORM.A2EmpCod = THISFORM.M2EmpCod
         THISFORM.A708OPaNro = THISFORM.M708OPaNro
         THISFORM.A727OPaSig = THISFORM.M727OPaSig
         THISFORM.A725OPaImp = THISFORM.M725OPaImp
         THISFORM.A720OpaNro = THISFORM.M720OpaNro
         THISFORM.A724OPaNro = THISFORM.M724OPaNro
         THISFORM.A719OPaNro = THISFORM.M719OPaNro
         THISFORM. cCT79S24 .SaveTemp()
         THISFORM. cCT79S24 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT79S24 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT79S24 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT79S24 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S708OPaNro = THISFORM.A708OPaNro .AND. S719OPaNro = THISFORM.A719OPaNro
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT79S24 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT79S24 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S708OPaNro = THISFORM.A708OPaNro .AND. S719OPaNro = THISFORM.A719OPaNro
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT79S24 .Refresh()
               THISFORM. cCT79S24 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A708OPaNro = S708OPaNro
               THISFORM.A719OPaNro = S719OPaNro
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT79S24 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT79S24 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S708OPaNro = THISFORM.A708OPaNro .AND. S719OPaNro = THISFORM.A719OPaNro
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT79S24 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S708OPaNro = THISFORM.A708OPaNro .AND. S719OPaNro = THISFORM.A719OPaNro
            ENDDO
            IF sf_err != 0
               THISFORM. cCT79S24 .AppendRow()
               THISFORM. cCT79S24 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A708OPaNro = S708OPaNro
               THISFORM.A719OPaNro = S719OPaNro
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A708OPaNro = S708OPaNro
         THISFORM.A719OPaNro = S719OPaNro
         RETURN .F.
      ENDFUNC
