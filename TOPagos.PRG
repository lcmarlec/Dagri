      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T00795,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA708OPaNro = THISFORM.A708OPaNro
            Gx_err = GX_DB_SetDouble( HStmt_T00795,2,@AuxA708OPaNro,0)
            THISFORM.A708OPaNro = AuxA708OPaNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00795) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00795 = Gx_err
            THISFORM.GX_DB_GetT00795_01 ()
            IF .NOT. THISFORM.T00795 <> 103
               DO GX_ERRMW WITH "OPAGOS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00795 = 101 .OR. THISFORM.Z709OpaFch <> THISFORM.Buf_T00795_709OpaFch
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z715OPaTip <> THISFORM.Buf_T00795_715OPaTip
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1214OpaFc <> THISFORM.Buf_T00795_1214OpaFchPrv
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2394OpaSw <> THISFORM.Buf_T00795_2394OpaSwif
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2509OpaRe <> THISFORM.Buf_T00795_2509OpaRetenid
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z729OpaTot <> THISFORM.Buf_T00795_729OpaTot
               DO GX_ERRMW WITH "OPAGOS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00799" , @HStmt_T00799 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOPAGOS","T00799","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00799) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [OPAGOS] ([EmpCod], [OPaNroI], [OpaFch], [OpaFchCon], [OpaEst], [OpaEntGruT], "
                  cmdbuf = cmdbuf + "  [OpaEntCod], [OPaTip], [OPaSer], [OPaSuc], [OPaNro], [OpaNroPrv], [OpaFchPrv], [OpaNroDef], "
                  cmdbuf = cmdbuf + "  [OpaObs], [OpaUsu], [OpaEsp], [OpaSwif], [OpaMon], [OpaImpOri], [OpaCanOri], [OpaCotiz], "
                  cmdbuf = cmdbuf + "  [OpaRetenid], [OpaAjuCta], [OPaFeMail], [OpaSGM], [OpaRGN], [OpaTot], [OpaSld], "
                  cmdbuf = cmdbuf + "  [OpaFchCB], [OpaNroPr1], [OpaFchPr1], [OpaSwifFch]) VALUES (?, ?, ?, ?, ?, ?, ?, "
                  cmdbuf = cmdbuf + "  ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, convert( "
                  cmdbuf = cmdbuf + "  DATETIME, '17530101', 112 )) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00799,cmdbuf)
                  THISFORM.GX_DB_BindParmT00799_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T00799,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA708OPaNro = THISFORM.A708OPaNro
               Gx_err = GX_DB_SetDouble( HStmt_T00799,2,@AuxA708OPaNro,0)
               THISFORM.A708OPaNro = AuxA708OPaNro
               AuxA709OpaFch = THISFORM.A709OpaFch
               Gx_err = GX_DB_SetDate( HStmt_T00799,3,@AuxA709OpaFch,0)
               THISFORM.A709OpaFch = AuxA709OpaFch
               AuxA710OpaFch = THISFORM.A710OpaFch
               Gx_err = GX_DB_SetDate( HStmt_T00799,4,@AuxA710OpaFch,0)
               THISFORM.A710OpaFch = AuxA710OpaFch
               AuxA711OpaEst = THISFORM.A711OpaEst
