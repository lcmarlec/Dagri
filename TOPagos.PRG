      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T007915" , @HStmt_T007915 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOPAGOS","T007915","",GX_CURSOR_TYPE_READONLY,@HStmt_T007915) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [OPaNroI], [OPaNroLin], [OpaNroIImp] AS OpaNroIImp, [OPaImpImp], "
                  cmdbuf = cmdbuf + "  [OpaNetImp], [OPaSig] FROM [OPAGOS1] (NOLOCK) WHERE [EmpCod] = ? AND [OPaNroI] = "
                  cmdbuf = cmdbuf + "  ? ORDER BY [EmpCod], [OPaNroI], [OPaNroLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T007915,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T007915,4)
                  THISFORM.GX_DB_BindColsT007915_01 ()
                  THISFORM.GX_DB_BindParmT007915_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T007915,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA708OPaNro = THISFORM.A708OPaNro
               Gx_err = GX_DB_SetDouble( HStmt_T007915,2,@AuxA708OPaNro,0)
               THISFORM.A708OPaNro = AuxA708OPaNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T007915) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T007915 = Gx_err
               THISFORM.GX_DB_GetT007915_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T007915 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T007915) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T007915 = Gx_err
                  THISFORM.GX_DB_GetT007915_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T007915 <> 101
               BRK2781 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
