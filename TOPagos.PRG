               Gx_err = GX_DB_SetLong( HStmt_T00799,7,@AuxA713OpaEnt,0)
               THISFORM.A713OpaEnt = AuxA713OpaEnt
               AuxA715OPaTip = THISFORM.A715OPaTip
               Gx_err = GX_DB_SetStr( HStmt_T00799,8,AuxA715OPaTip,4,0)
               THISFORM.A715OPaTip = AuxA715OPaTip
               AuxA716OPaSer = THISFORM.A716OPaSer
