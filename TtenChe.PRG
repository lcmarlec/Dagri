      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011337" , @HStmt_T011337 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTENCHE","T011337","",GX_CURSOR_TYPE_READONLY,@HStmt_T011337) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [tECHNroInt], [tEchMonCod] AS tEchMonCod, [tEchMOnImp], [tEchMonCot] "
                  cmdbuf = cmdbuf + "  FROM [TENCHE] (NOLOCK) WHERE [EmpCod] = ? AND [tECHNroInt] = ? ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [tECHNroInt], [tEchMonCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011337,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011337,6)
                  THISFORM.GX_DB_BindColsT011337_01 ()
                  THISFORM.GX_DB_BindParmT011337_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011337,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1103tECHN = THISFORM.A1103tECHN
               Gx_err = GX_DB_SetDouble( HStmt_T011337,2,@AuxA1103tECHN,0)
               THISFORM.A1103tECHN = AuxA1103tECHN
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011337) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011337 = Gx_err
               THISFORM.GX_DB_GetT011337_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011337 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011337) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011337 = Gx_err
                  THISFORM.GX_DB_GetT011337_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011337 <> 101
               BRK35144 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT113Tb18.cCT113Pg37Tb18.cCT113S38.Columns(1).Ctrl1 .LoadObj(2)
