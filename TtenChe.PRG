      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011342" , @HStmt_T011342 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTENCHE","T011342","",GX_CURSOR_TYPE_READONLY,@HStmt_T011342) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [tECHNroInt], [tEchCtaCod] AS tEchCtaCod, [tEchCtaImp] FROM [PENCHE2] "
                  cmdbuf = cmdbuf + "  (NOLOCK) WHERE [EmpCod] = ? AND [tECHNroInt] = ? ORDER BY [EmpCod], [tECHNroInt], "
                  cmdbuf = cmdbuf + "  [tEchCtaCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011342,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011342,6)
                  THISFORM.GX_DB_BindColsT011342_01 ()
                  THISFORM.GX_DB_BindParmT011342_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011342,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1103tECHN = THISFORM.A1103tECHN
               Gx_err = GX_DB_SetDouble( HStmt_T011342,2,@AuxA1103tECHN,0)
               THISFORM.A1103tECHN = AuxA1103tECHN
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011342) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011342 = Gx_err
               THISFORM.GX_DB_GetT011342_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011342 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011342) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011342 = Gx_err
                  THISFORM.GX_DB_GetT011342_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011342 <> 101
               BRK35124 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T011342_1103tECHNroInt = THISFORM.A1103tECHN .AND. THISFORM.Buf_T011342_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011342) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011342 = Gx_err
               THISFORM.GX_DB_GetT011342_01 ()
            ENDDO
         ENDIF
      ENDPROC
