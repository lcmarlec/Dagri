               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T011337_1103tECHNroInt = THISFORM.A1103tECHN .AND. THISFORM.Buf_T011337_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
