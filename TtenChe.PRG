               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011327,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1103tECHN = THISFORM.A1103tECHN
               Gx_err = GX_DB_SetDouble( HStmt_T011327,2,@AuxA1103tECHN,0)
               THISFORM.A1103tECHN = AuxA1103tECHN
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011327) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011327 = Gx_err
               THISFORM.GX_DB_GetT011327_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011327 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011327) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011327 = Gx_err
                  THISFORM.GX_DB_GetT011327_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011327 <> 101
               BRK35123 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT113Tb18.cCT113Pg19Tb18.cCT113S20.Columns(3).Ctrl1 .LoadObj(2)
