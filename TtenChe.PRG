         THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .SaveTemp()
         THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1103tECHN = THISFORM.A1103tECHN .AND. S1118tEchC = THISFORM.A1118tEchC
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1103tECHN = THISFORM.A1103tECHN .AND. S1118tEchC = THISFORM.A1118tEchC
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .Refresh()
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1103tECHN = S1103tECHN
               THISFORM.A1118tEchC = S1118tEchC
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1103tECHN = THISFORM.A1103tECHN .AND. S1118tEchC = THISFORM.A1118tEchC
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S1103tECHN = THISFORM.A1103tECHN .AND. S1118tEchC = THISFORM.A1118tEchC
            ENDDO
            IF sf_err != 0
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .AppendRow()
               THISFORM. cCT113Tb18.cCT113Pg55Tb18.cCT113S56 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A1103tECHN = S1103tECHN
               THISFORM.A1118tEchC = S1118tEchC
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A1103tECHN = S1103tECHN
