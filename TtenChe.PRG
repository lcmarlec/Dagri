                  cmdbuf = cmdbuf + "  [tEchBcoMon], [tEchSuc], [tEchNumAut], [tEchCtaChN], [tEchNroCh], [tEchNroReg], "
                  cmdbuf = cmdbuf + "  [tEchOrden], [tEchOrde2], [tEchCruz], [tEChImp], [tEChFchDeb] FROM [PENCHE1] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [tECHNroInt] = ? ORDER BY [EmpCod], [tECHNroInt], [tEChLin], "
                  cmdbuf = cmdbuf + "  [tEchTip], [tEchCtaCh]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011327,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011327,6)
                  THISFORM.GX_DB_BindColsT011327_01 ()
