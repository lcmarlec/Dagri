                  cmdbuf = cmdbuf + "  T2.[DcCSuc] AS DceDcSuc, T2.[DccSer] AS DceDcSer, T2.[DccTipRed] AS DceDcTpo, T1.[DcEGruTip] "
                  cmdbuf = cmdbuf + "  AS DcEGruTip, T3.[EntRaz] AS DcEEntRaz, T1.[DcEEntCod] AS DcEEntCod, T1.[DcECarNro], "
                  cmdbuf = cmdbuf + "  T4.[DesRaz] AS DcEDesRaz, T1.[DcEDesCod] AS DcEDesCod, T1.[DcEEmbFch], T1.[DcEOfiFch], "
                  cmdbuf = cmdbuf + "  T1.[DcENroDC], T1.[DcENroReg], T1.[DcENroTip], T1.[DcENroAd], T1.[DcENroAn] FROM "
                  cmdbuf = cmdbuf + "  ((([DCDESPA1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[DcCNroInt] = T1.[DceDcNroIn]) LEFT JOIN [ENTID] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T1.[DcEGruTip] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[DcEEntCod]) LEFT JOIN [DSPCHANT] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] "
