            IF ! THISFORM.InitLevels( 2 )
               THISFORM.ReleaseAll()
               RETURN
            ENDIF
            THISFORM.LoadMenuBar()
            THISFORM.SetLevel( 2 )
            THISFORM.U11VM02 ()
            IF TYPE( "OCW792" ) = "U"
               RETURN
            ENDIF
            THISFORM.GXShow()
            THISFORM.DoRefresh()
            SELECT(THISFORM. cCW792S20 .GX_SfAlias)
            IF EOF()
               DO GX_MSGW WITH "No hay registros que cumplan la condicion"
            ELSE
               IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
                  DO GX_MSGW WITH ""
               ENDIF
            ENDIF
            IF THISFORM.GX_SetFocus_Allowed
               THISFORM. cCW792S20 .SetFocus()
            ENDIF
            GXForm::Activate
         ENDIF
         THISFORM.ClearFrmTBar
         THISFORM.GxMenuBar.Clear
         THISFORM.SetMBTimer()
         gxMB = "OFF"
         THISFORM.GxMenuBar.Set(gxMB)
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         THISFORM.SetFKeys()
         GXTB.HideMode()
         IF GXTB.GetMessageValue() != "No hay registros que cumplan la condicion"
            GXTB.HideSB()
         ENDIF
      ENDPROC
