      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01542" , @HStmt_W01542 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKMUN","W01542","",0,@HStmt_W01542) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT PaiCod, PciCod, MunAba, MunDsc, MunCod  FROM MUNI (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ( PaiCod = ? ) AND ( PciCod = ? ) AND ( MunDsc LIKE ? ) ORDER BY MunDsc   "
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtCmdText( HStmt_W01542,cmdbuf) ,  ,  ,  , CS_SQLSRV ,  )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Set_StmtFetchSize( HStmt_W01542,13) ,  ,  ,  , CS_SQLSRV ,  )
                  THISFORM.GX_DB_BindColsW01542_01 ( HStmt_W01542 )
                  THISFORM.GX_DB_BindParmW01542_01 ( HStmt_W01542 )
               ENDIF
               AuxA631PaiCod = THISFORM.A631PaiCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01542,1,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               AuxA633PciCod = THISFORM.A633PciCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01542,2,AuxA633PciCod,4,0)
               THISFORM.A633PciCod = AuxA633PciCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01542,3,PADR( TRIM(THISFORM.AV20Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01542 = Gx_err
               THISFORM.GX_DB_GetW01542_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01542 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01542) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01542 = Gx_err
                  THISFORM.GX_DB_GetW01542_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01542 <> 101
               BRKV4A2 = .F.
               THISFORM.A637MunAba = THISFORM.Buf_W01542_637MunAba
               THISFORM.A636MunDsc = THISFORM.Buf_W01542_636MunDsc
               THISFORM.A635MunCod = THISFORM.Buf_W01542_635MunCod
               IF THISFORM.Buf_W01542_631PaiCod = THISFORM.A631PaiCod
                  IF THISFORM.Buf_W01542_633PciCod = THISFORM.A633PciCod
                     IF GX_CSLKE(THISFORM.A636MunDsc, TRIM(THISFORM.AV20Desde)+[%])
                        GX_SFLOAD = 0
                        THISFORM.U15V4A2 ()
                        THIS.GX_CUPOS = 0
                        DO CASE
                           CASE GX_SFLOAD = 1
                              GX_CUERR = 0
                              EXIT
                           CASE GX_SFLOAD = 2
                              GX_CUERR = 100
                              EXIT
                        ENDCASE
                        IF UserCancel
                           EXIT
                        ENDIF
                     ENDIF
                  ENDIF
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01542 = Gx_err
               THISFORM.GX_DB_GetW01542_01 ()
            ENDDO
         ENDIF
      ENDPROC
