            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTRCHQ","T02075","",GX_CURSOR_TYPE_READONLY,@HStmt_T02075) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [AuxCod], [AuxNom], [AuxDir], [AuxTel], [auxcuit], [AuxObs] FROM "
            cmdbuf = cmdbuf + "  [ENTRCHQ] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? and [AuxCod] >= ? ORDER BY [EmpCod], "
            cmdbuf = cmdbuf + "  [AuxCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02075,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02075,100)
            THISFORM.GX_DB_BindColsT02075_01 ()
            THISFORM.GX_DB_BindParmT02075_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A1994AuxCo = 0
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02075,1,@AuxA2EmpCod,0)
