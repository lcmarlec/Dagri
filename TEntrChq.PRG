               AuxA1994AuxCo = THISFORM.A1994AuxCo
               Gx_err = GX_DB_SetInt( HStmt_T02075,2,@AuxA1994AuxCo,0)
               THISFORM.A1994AuxCo = AuxA1994AuxCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02075) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02075 = Gx_err
               THISFORM.GX_DB_GetT02075_01 ()
               THISFORM.A1994AuxCo = M1994AuxCo
               DO WHILE THISFORM.T02075 = 0 .AND. THISFORM.A2EmpCod = THISFORM.Buf_T02075_2EmpCod .AND. THISFORM.A1994AuxCo >= THISFORM.Buf_T02075_1994AuxCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02075) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02075 = Gx_err
                  THISFORM.GX_DB_GetT02075_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02075 <> 101 .AND. THISFORM.Buf_T02075_2EmpCod = THISFORM.A2EmpCod
               DO WHILE Gx_fcond
                  Gx_fcond = THISFORM.Buf_T02075_2EmpCod = THISFORM.A2EmpCod
                  IF Gx_fcond
                     EXIT
                  ELSE
                     Gx_eop = 1
                     DO WHILE Gx_eop != 0
                        Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02075) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDDO
                     THISFORM.T02075 = Gx_err
                     THISFORM.GX_DB_GetT02075_01 ()
                  ENDIF
                  Gx_fcond = THISFORM.T02075 <> 101 .AND. THISFORM.Buf_T02075_2EmpCod = THISFORM.A2EmpCod
               ENDDO
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A1994AuxCo = 0
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02075,1,@AuxA2EmpCod,0)
