      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02076" , @HStmt_T02076 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTRCHQ","T02076","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02076) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ENTRCHQ] ([EmpCod], [AuxCod], [AuxNom], [AuxDir], [AuxTel], [auxcuit], "
                  cmdbuf = cmdbuf + "  [AuxObs]) VALUES (?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02076,cmdbuf)
                  THISFORM.GX_DB_BindParmT02076_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02076,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1994AuxCo = THISFORM.A1994AuxCo
               Gx_err = GX_DB_SetInt( HStmt_T02076,2,@AuxA1994AuxCo,0)
               THISFORM.A1994AuxCo = AuxA1994AuxCo
               AuxA1995AuxNo = THISFORM.A1995AuxNo
               Gx_err = GX_DB_SetStr( HStmt_T02076,3,AuxA1995AuxNo,30,0)
               THISFORM.A1995AuxNo = AuxA1995AuxNo
               AuxA1998AuxDi = THISFORM.A1998AuxDi
               Gx_err = GX_DB_SetStr( HStmt_T02076,4,AuxA1998AuxDi,50,0)
               THISFORM.A1998AuxDi = AuxA1998AuxDi
               AuxA1996AuxTe = THISFORM.A1996AuxTe
               Gx_err = GX_DB_SetDouble( HStmt_T02076,5,@AuxA1996AuxTe,0)
               THISFORM.A1996AuxTe = AuxA1996AuxTe
               AuxA2005auxcu = THISFORM.A2005auxcu
               Gx_err = GX_DB_SetDouble( HStmt_T02076,6,@AuxA2005auxcu,0)
               THISFORM.A2005auxcu = AuxA2005auxcu
               AuxA1997AuxOb = THISFORM.A1997AuxOb
               Gx_err = GX_DB_SetStr( HStmt_T02076,7,AuxA1997AuxOb,50,0)
               THISFORM.A1997AuxOb = AuxA1997AuxOb
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02076) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02076 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02076) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02076 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02077" , @HStmt_T02077 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTRCHQ","T02077","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02077) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [ENTRCHQ] SET [AuxNom]=?, [AuxDir]=?, [AuxTel]=?, [auxcuit]=?, [AuxObs]=? "
                  cmdbuf = cmdbuf + "   WHERE [EmpCod] = ? AND [AuxCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02077,cmdbuf)
                  THISFORM.GX_DB_BindParmT02077_01 ()
               ENDIF
               AuxA1995AuxNo = THISFORM.A1995AuxNo
               Gx_err = GX_DB_SetStr( HStmt_T02077,1,AuxA1995AuxNo,30,0)
               THISFORM.A1995AuxNo = AuxA1995AuxNo
               AuxA1998AuxDi = THISFORM.A1998AuxDi
               Gx_err = GX_DB_SetStr( HStmt_T02077,2,AuxA1998AuxDi,50,0)
               THISFORM.A1998AuxDi = AuxA1998AuxDi
               AuxA1996AuxTe = THISFORM.A1996AuxTe
               Gx_err = GX_DB_SetDouble( HStmt_T02077,3,@AuxA1996AuxTe,0)
               THISFORM.A1996AuxTe = AuxA1996AuxTe
               AuxA2005auxcu = THISFORM.A2005auxcu
               Gx_err = GX_DB_SetDouble( HStmt_T02077,4,@AuxA2005auxcu,0)
               THISFORM.A2005auxcu = AuxA2005auxcu
               AuxA1997AuxOb = THISFORM.A1997AuxOb
               Gx_err = GX_DB_SetStr( HStmt_T02077,5,AuxA1997AuxOb,50,0)
               THISFORM.A1997AuxOb = AuxA1997AuxOb
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02077,6,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1994AuxCo = THISFORM.A1994AuxCo
               Gx_err = GX_DB_SetInt( HStmt_T02077,7,@AuxA1994AuxCo,0)
               THISFORM.A1994AuxCo = AuxA1994AuxCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02077) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02077 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02077) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02078" , @HStmt_T02078 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TENTRCHQ","T02078","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02078) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [ENTRCHQ]  WHERE [EmpCod] = ? AND [AuxCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02078,cmdbuf)
                  THISFORM.GX_DB_BindParmT02078_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02078,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1994AuxCo = THISFORM.A1994AuxCo
               Gx_err = GX_DB_SetInt( HStmt_T02078,2,@AuxA1994AuxCo,0)
               THISFORM.A1994AuxCo = AuxA1994AuxCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02078) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02078 = Gx_err
               THISFORM.T02072 = iif( THISFORM.T02078 = 0 , 104 , THISFORM.T02078 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02078) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A1994AuxCo , 3 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV18Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "BCOS" , Aux1 , "AUXILIAR" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV18Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT207V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 230 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
