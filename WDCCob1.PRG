                  cmdbuf = " SELECT T1.[TTesMonCod] AS TTesMonCod, T1.[EmpCod], T1.[TTesCotImp], T1.[TTesImp], "
                  cmdbuf = cmdbuf + "  T3.[McoMBc], T1.[TTesEntGru], T1.[TTesNroI], T3.[McoCta], T3.[McoBco], T1.[TTesLin], "
                  cmdbuf = cmdbuf + "  T2.[MonSim] AS TTesMonSim, T3.[MCoDsc] AS TTesMedDsc, T1.[TTesMedCod] AS TTesMedCod "
                  cmdbuf = cmdbuf + "  FROM (([TTESCYP1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) ON T2.[Moncod] "
                  cmdbuf = cmdbuf + "  = T1.[TTesMonCod]) LEFT JOIN [MEDCOB] T3 (NOLOCK) ON T3.[MCoCod] = T1.[TTesMedCod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[TTesNroI] = ? ORDER BY T1.[EmpCod], T1.[TTesNroI], "
                  cmdbuf = cmdbuf + "  T1.[TTesLin]  "
