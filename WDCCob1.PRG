      ***********************
      PROCEDURE U12V0U2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "'CONFIRMAR'" )
         * 'Confirmar' Routine
         THISFORM.AV19Ok = "N"
         DO CASE
            CASE EMPTY( THISFORM.AV33Fchdef )
               DO GX_ERRMW WITH "Debe Ingresar Fecha del Recibo OFICIAL"
               THISFORM.cCW30V33.GXSetFocus( )
            CASE THISFORM.AV28Fechao > THISFORM.AV5Fechasi
               DO GX_ERRMW WITH "Fecha O/P Posterior al día de hoy"
            CASE THISFORM.AV33Fchdef <= THISFORM.AV34Fchrec
               DO GX_ERRMW WITH "Fecha OFICIAL Anterior al Cierre"
               THISFORM.cCW30V33.GXSetFocus( )
            CASE THISFORM.AV33Fchdef > THISFORM.AV5Fechasi
               DO GX_ERRMW WITH "Fecha OFICIAL Posterior al día de hoy"
               THISFORM.cCW30V33.GXSetFocus( )
            CASE THISFORM.AV33Fchdef < THISFORM.AV45Fchmin
               DO GX_ERRMW WITH "Fecha Oficial Anterior a factura(s) pagada(s). " + GXDTOC( THISFORM.AV45Fchmin )
               THISFORM.cCW30V33.GXSetFocus( )
            CASE THISFORM.AV46Entciv = 7 .AND. ( THISFORM.AV39Rcvimp = 0 .OR. THISFORM.AV38Rcvcot = 0 ) .AND. THISFORM.AV15Totalp <> 0
               THISFORM.AV19Ok = "S"
               LOCAL GX_SFERR, Gx_fel_sel, gxO_Rec, gxO_Rec1
               GX_SFERR = 0
               Gx_fel_sel = .T.
               gxO_Rec = 0
               SELECT( THISFORM.cCW30S15 .GX_SfAlias)
               gxO_Rec1 = IIF(EOF(), 0, RECNO())
               THISFORM.cCW30S15.SF (8, @GX_SFERR)
               DO WHILE GX_SFERR = 0 .AND. .NOT. UserCancel
                  THISFORM.cCW30S15.SF (3, @GX_SFERR)
                  THISFORM.cCW30S15 .SaveGridPos()
                  IF THISFORM.AV47Mcombc = "S"
                     THISFORM.AV19Ok = "N"
                     * Exit For each command. Update data (if necessary), close cursors & exit.
                     EXIT
                  ENDIF
                  IF Gx_fel_sel
                     THISFORM.cCW30S15 .RestoreGridPos()
                     THISFORM.cCW30S15.SF (4, @GX_SFERR)
                     THISFORM.cCW30S15.SF (9, @GX_SFERR)
                  ENDIF
               ENDDO
               THISFORM.cCW30S15 .ResetSavedGridPos()
               SELECT( THISFORM.cCW30S15 .GX_SfAlias)
               IF gxO_Rec1 != 0
                  GOTO (gxO_Rec1)
                  THISFORM.cCW30S15.SF (3, @GX_SFERR)
               ENDIF
               IF THISFORM.AV19Ok = "N"
                  DO GX_ERRMW WITH "Debe Ingresar Moneda, Cotización e Importe Original "
                  THISFORM.cCW30V40.GXSetFocus( )
               ENDIF
            OTHERWISE
               THISFORM.AV19Ok = "S"
         ENDCASE
         IF THISFORM.AV19Ok = "S"
            IF EMPTY( THISFORM.AV33Fchdef )
               DO GX_ERRMW WITH "Debe Ingresar Fecha del Recibo OFICIAL"
               THISFORM.AV19Ok = "N"
            ELSE
               THISFORM.AV19Ok = "S"
               IF ( THISFORM.AV16Totald - THISFORM.AV20Totalr ) <> THISFORM.AV15Totalp .AND. THISFORM.AV18Contad = "S"
                  THISFORM.SaveTblPos()
                  DO Werrores WITH "Debe cancelar el Total" , "R"
                  THISFORM. cCW30S15 .RestoreGridPos()
                  GX_rploop = .T.
                  THISFORM.AV19Ok = "N"
               ELSE
                  IF THISFORM.AV32Recdef = 0
                     THISFORM.Gx_msg = "No ingreso número de Recibo Oficial. Es Correcto ?"
                     THISFORM.AV19Ok = "N"
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.Gx_msg
                     Aux1 = THISFORM.AV19Ok
                     DO WMsgCnf WITH Aux0 , Aux1
                     THISFORM.Gx_msg = Aux0
                     THISFORM.AV19Ok = Aux1
                     THISFORM. cCW30S15 .RestoreGridPos()
                     GX_rploop = .T.
                  ENDIF
                  IF THISFORM.AV19Ok = "S"
                     IF THISFORM.AV26Recibo = 0
                        THISFORM.Gx_msg = "No ingresó Número de O/P. Es Correcto ?"
                        THISFORM.SaveTblPos()
                        Aux0 = THISFORM.Gx_msg
                        Aux1 = THISFORM.AV19Ok
                        DO WMsgCnf WITH Aux0 , Aux1
                        THISFORM.Gx_msg = Aux0
                        THISFORM.AV19Ok = Aux1
                        THISFORM. cCW30S15 .RestoreGridPos()
                        GX_rploop = .T.
                        IF THISFORM.AV19Ok = "S"
                           THISFORM.AV26Recibo = -10
                        ENDIF
                     ENDIF
                     IF THISFORM.AV19Ok = "S"
                        IF round( THISFORM.AV16Totald - THISFORM.AV20Totalr , 2 ) <> round( THISFORM.AV15Totalp , 2 )
                           IF THISFORM.AV16Totald - THISFORM.AV20Totalr > THISFORM.AV15Totalp
                              THISFORM.Gx_msg = "¿Acepta Cobrar $" + str( THISFORM.AV16Totald - THISFORM.AV20Totalr - THISFORM.AV15Totalp , 10 , 2 ) + " de menos ? "
                           ELSE
                              THISFORM.Gx_msg = "¿Genera un Recibo con $" + str( THISFORM.AV16Totald - THISFORM.AV20Totalr - THISFORM.AV15Totalp , 10 , 2 ) + " a Cuenta ? "
                           ENDIF
                           THISFORM.SaveTblPos()
                           Aux0 = THISFORM.Gx_msg
                           Aux1 = THISFORM.AV19Ok
                           DO WMsgCnf WITH Aux0 , Aux1
                           THISFORM.Gx_msg = Aux0
                           THISFORM.AV19Ok = Aux1
                           THISFORM. cCW30S15 .RestoreGridPos()
                           GX_rploop = .T.
                        ENDIF
                     ENDIF
                     IF THISFORM.AV19Ok = "S"
                        IF TYPE( "HConn_Default" ) = "N"
                           IF GXCONNECTED
                              Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
                           ENDIF
                        ENDIF
                        THISFORM.AV25Recibo = THISFORM.AV26Recibo
                        THISFORM.AV27Fechac = THISFORM.AV28Fechao
                        THISFORM.AV30Recibo = THISFORM.AV32Recdef
                        THISFORM.AV31Fechad = THISFORM.AV33Fchdef
                        THISFORM.AV35Rcvobs = THISFORM.AV36Obs
                        THISFORM.AV44Cotiz = THISFORM.AV38Rcvcot
                        THISFORM.AV43Impori = THISFORM.AV39Rcvimp
                        THISFORM.AV42Monori = THISFORM.AV40Rcvmon
                        THISFORM.ReleaseAll()
                        RETURN
                     ENDIF
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

