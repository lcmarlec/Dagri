                  cmdbuf = cmdbuf + "  = ? AND [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], [EntMcoDias], [EntMCoCod], "
                  cmdbuf = cmdbuf + "  [EntMcoCta], [EntMcoMonc]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T034548,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T034548,8)
                  THISFORM.GX_DB_BindColsT034548_01 ()
                  THISFORM.GX_DB_BindParmT034548_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T034548,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T034548,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T034548,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T034548) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034548 = Gx_err
               THISFORM.GX_DB_GetT034548_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T034548 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034548) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T034548 = Gx_err
                  THISFORM.GX_DB_GetT034548_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T034548 <> 101
               BRK9L94 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT345Tb11.cCT345Pg109Tb11.cCT345S115.Columns(5).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T034548_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034548) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034548 = Gx_err
               THISFORM.GX_DB_GetT034548_01 ()
            ENDDO
         ENDIF
      ENDPROC
