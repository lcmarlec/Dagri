               Gx_err = GX_DB_SetLong( HStmt_T034534,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T034534) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034534 = Gx_err
               THISFORM.GX_DB_GetT034534_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T034534 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034534) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T034534 = Gx_err
                  THISFORM.GX_DB_GetT034534_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T034534 <> 101
               BRK9L321 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT345Tb11.cCT345Pg153Tb11.cCT345S154.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
