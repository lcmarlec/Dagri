                  cmdbuf = " SELECT [EmpCod], [EntGruTip] AS EntGruTip, [EntCod], [EntMcoDias], [EntMCoCod] AS "
                  cmdbuf = cmdbuf + "  EntMCoCod, [EntMcoCta] AS EntMcoCta, [EntMcoMonc] AS EntMcoMonc, [EntMcoBcoC] AS "
