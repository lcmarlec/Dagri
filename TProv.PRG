      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T034534" , @HStmt_T034534 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPROV","T034534","",GX_CURSOR_TYPE_READONLY,@HStmt_T034534) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip] AS EntGruTip, [EntCod], [DRCod] FROM [PROVES3] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod], [DRCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T034534,cmdbuf)
