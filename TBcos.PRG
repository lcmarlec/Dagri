         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00113) , "TBCOS" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00112) , "TBCOS" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT11A87 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 9
            IF ! THISFORM. gx_9insert
               THISFORM.SetLevel( 9 )
               THISFORM.SetMode("EOF", "1" )
               CGXTextBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_9insert
            THISFORM. gx_9insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 9 )
            THISFORM. cCT11A86 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 9
            THISFORM.SetLevel( 9 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT11A86 .InitLevel( 9 )
            THISFORM.GX_last_fld_lvl = 9
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A87BcoDsc"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXTextBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl9
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF EMPTY( THISFORM.A87BcoDsc )
            DO GX_ERRMW WITH "Debe Ingresar el Nombre del Banco !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_9insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_9insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_9insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_9insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT11A86 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_9insert = .F.
               THISFORM.gx_insert = THISFORM. gx_9insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXTextBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA86BcoCod = THISFORM.A86BcoCod
            Gx_err = GX_DB_SetInt( HStmt_T00112,1,@AuxA86BcoCod,0)
            THISFORM.A86BcoCod = AuxA86BcoCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00112) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00112 = Gx_err
            THISFORM.GX_DB_GetT00112_01 ()
            IF .NOT. THISFORM.T00112 <> 103
               DO GX_ERRMW WITH "BANCOS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00112 = 101 .OR. THISFORM.Z87BcoDsc <> THISFORM.Buf_T00112_87BcoDsc
               DO GX_ERRMW WITH "BANCOS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00115" , @HStmt_T00115 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBCOS","T00115","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00115) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [BANCOS] ([BcoCod], [BcoDsc]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00115,cmdbuf)
                  THISFORM.GX_DB_BindParmT00115_01 ()
               ENDIF
               AuxA86BcoCod = THISFORM.A86BcoCod
               Gx_err = GX_DB_SetInt( HStmt_T00115,1,@AuxA86BcoCod,0)
               THISFORM.A86BcoCod = AuxA86BcoCod
               AuxA87BcoDsc = THISFORM.A87BcoDsc
               Gx_err = GX_DB_SetStr( HStmt_T00115,2,AuxA87BcoDsc,40,0)
               THISFORM.A87BcoDsc = AuxA87BcoDsc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00115) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00115 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00115) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T00115 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00116" , @HStmt_T00116 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBCOS","T00116","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00116) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [BANCOS] SET [BcoDsc]=?  WHERE [BcoCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00116,cmdbuf)
                  THISFORM.GX_DB_BindParmT00116_01 ()
               ENDIF
               AuxA87BcoDsc = THISFORM.A87BcoDsc
               Gx_err = GX_DB_SetStr( HStmt_T00116,1,AuxA87BcoDsc,40,0)
               THISFORM.A87BcoDsc = AuxA87BcoDsc
               AuxA86BcoCod = THISFORM.A86BcoCod
               Gx_err = GX_DB_SetInt( HStmt_T00116,2,@AuxA86BcoCod,0)
               THISFORM.A86BcoCod = AuxA86BcoCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00116) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00116 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00116) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00117" , @HStmt_T00117 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TBCOS","T00117","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T00117) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [BANCOS]  WHERE [BcoCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00117,cmdbuf)
                  THISFORM.GX_DB_BindParmT00117_01 ()
               ENDIF
               AuxA86BcoCod = THISFORM.A86BcoCod
               Gx_err = GX_DB_SetInt( HStmt_T00117,1,@AuxA86BcoCod,0)
               THISFORM.A86BcoCod = AuxA86BcoCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T00117) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00117 = Gx_err
               THISFORM.T00112 = iif( THISFORM.T00117 = 0 , 104 , THISFORM.T00117 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T00117) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV12Numero = str( THISFORM.A86BcoCod , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV12Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV11Audobs
            Aux6 = THISFORM.AV10Usuari
            DO PAuditor WITH "TABL" , Aux1 , "BCO" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV12Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV11Audobs = Aux5
            THISFORM.AV10Usuari = Aux6
            THISFORM. cCT11V10 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 9 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
