               IF THISFORM.AMode
                  gx_lmode = "INS"
               ENDIF
            ENDIF
            IF THISFORM.GX_curr_level = 9
               THISFORM.SaveMode( gx_lmode ,"")
            ENDIF
            gx_UseTblVar = .F.
         ELSE
            IF THISFORM.GX_curr_level = 9
               THISFORM.SetMode("EOF", "1" )
            ENDIF
         ENDIF
         IF THISFORM.Gx_mode = "INS"
            IF (( gxLoadType = 0 .or. gxLoadType = 2) .and. THISFORM.AMode ) .or. gxLoadType = 4
               THISFORM.A86BcoCod = 0
            ENDIF
            THISFORM.A87BcoDsc = SPACE(40)
         ENDIF
         IF THISFORM.Gx_mode != "INS"
            Is_updated = .F.
            GX_OLDPOS = 0
