                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T03384) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
