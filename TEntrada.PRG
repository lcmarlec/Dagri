                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03383) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03383 = Gx_err
                  THISFORM.GX_DB_GetT03383_01 ()
                  THISFORM. cCT338A3230 . ZM9E370 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC9E370 ()
               THISFORM. cCT338A3230 . ZM9E370 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC9E370 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT338A3403 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE9E370 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC9E370 ()
                  RETURN
               ENDIF
               THISFORM.cCT338A3230.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03383) , "TENTRADA" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03382) , "TENTRADA" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT338A3403 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT338A3230 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
