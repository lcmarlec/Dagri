         DO CASE
            CASE THISFORM.GX_Curr_Level = 370
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT338A3230 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 370
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3230Palle = THISFORM.A3230Palle
                  Gx_err = GX_DB_SetStr( HStmt_T03383,1,AuxA3230Palle,16,0)
                  THISFORM.A3230Palle = AuxA3230Palle
