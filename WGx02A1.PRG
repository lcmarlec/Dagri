      PROCEDURE CreateTemp
         LOCAL SCW260S20
         SCW260S20 = ""
         IF USED( "SCW260S20" )
            SELECT SCW260S20
            SCW260S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW260S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA731OpeNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA732OPeSu"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA701OPeNr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 8
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA733OpeFc"
            GX_STRUCT[ 4 ,2]= "D"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA734OpeTL"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW260S20 = GETE('z:\temp') + '\' + SCW260S20
            ENDIF
            CREATE DBF (SCW260S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW260S20) EXCLUSIVE ALIAS SCW260S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW260S20
         THIS.GX_SfAlias = "SCW260S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02602" , @HStmt_W02602 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02A1","W02602","",GX_CURSOR_TYPE_READONLY,@HStmt_W02602) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [OpeEst], [OpeTLi], [OpeFch], [OPeNro], [OPeSuc], [OpeNroInt] FROM "
                  cmdbuf = cmdbuf + "  [OPEDIS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [OpeNroInt] >= ?) AND ([OPeSuc] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([OPeNro] >= ?) AND ([OpeFch] >= ?) AND ([OpeTLi] >= ?) AND ([OpeEst] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [OpeNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02602,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02602,8)
                  THISFORM.GX_DB_BindColsW02602_01 ()
                  THISFORM.GX_DB_BindParmW02602_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02602,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV20C731 = THISFORM.AV20C731
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02602,2,@AuxAV20C731,0)
               THISFORM.AV20C731 = AuxAV20C731
               AuxAV19C732 = THISFORM.AV19C732
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02602,3,@AuxAV19C732,0)
               THISFORM.AV19C732 = AuxAV19C732
               AuxAV18C701 = THISFORM.AV18C701
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02602,4,@AuxAV18C701,0)
               THISFORM.AV18C701 = AuxAV18C701
               AuxAV17C733 = THISFORM.AV17C733
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02602,5,@AuxAV17C733,0)
               THISFORM.AV17C733 = AuxAV17C733
               AuxAV16C734 = THISFORM.AV16C734
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02602,6,@AuxAV16C734,0)
               THISFORM.AV16C734 = AuxAV16C734
               AuxAV15C735 = THISFORM.AV15C735
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02602,7,@AuxAV15C735,0)
               THISFORM.AV15C735 = AuxAV15C735
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02602 = Gx_err
               THISFORM.GX_DB_GetW02602_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02602 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02602) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02602 = Gx_err
                  THISFORM.GX_DB_GetW02602_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02602 <> 101
               BRKV782 = .F.
               THISFORM.A735OpeEst = THISFORM.Buf_W02602_735OpeEst
               THISFORM.A734OpeTLi = THISFORM.Buf_W02602_734OpeTLi
               THISFORM.A733OpeFch = THISFORM.Buf_W02602_733OpeFch
               THISFORM.A701OPeNro = THISFORM.Buf_W02602_701OPeNro
               THISFORM.A732OPeSuc = THISFORM.Buf_W02602_732OPeSuc
               THISFORM.A731OpeNro = THISFORM.Buf_W02602_731OpeNroInt
               GX_SFLOAD = 0
               THISFORM.U12V782 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02602) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02602 = Gx_err
               THISFORM.GX_DB_GetW02602_01 ()
            ENDDO
         ENDIF
      ENDPROC
