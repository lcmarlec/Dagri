      PROCEDURE CreateTemp
         LOCAL SCW454S20
         SCW454S20 = ""
         IF USED( "SCW454S20" )
            SELECT SCW454S20
            SCW454S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW454S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1441TmpF"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1442TmpH"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1443TmpU"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1451TmpE"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1444TmpC"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1446TmpN"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW454S20 = GETE('z:\temp') + '\' + SCW454S20
            ENDIF
            CREATE DBF (SCW454S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW454S20) EXCLUSIVE ALIAS SCW454S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW454S20
         THIS.GX_SfAlias = "SCW454S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04542" , @HStmt_W04542 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04N0","W04542","",GX_CURSOR_TYPE_READONLY,@HStmt_W04542) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [TmpNroLin], [TmpFchLin], [TmpNILin], [TmpCta], [TmpEmpCod], [TmpUsu], [TmpHor], "
                  cmdbuf = cmdbuf + "  [TmpFch] FROM [TMPCONTA] (FASTFIRSTROW NOLOCK) WHERE ([TmpFch] >= ?) AND ([TmpHor] "
                  cmdbuf = cmdbuf + "  like ?) AND ([TmpUsu] like ?) AND ([TmpEmpCod] >= ?) AND ([TmpCta] like ?) AND ([TmpFchLin] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([TmpNILin] >= ?) ORDER BY [TmpFch], [TmpHor], [TmpUsu], [TmpEmpCod], "
                  cmdbuf = cmdbuf + "  [TmpCta], [TmpFchLin], [TmpNILin], [TmpNroLin]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04542,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04542,8)
                  THISFORM.GX_DB_BindColsW04542_01 ()
                  THISFORM.GX_DB_BindParmW04542_01 ()
               ENDIF
               AuxAV21C1441 = THISFORM.AV21C1441
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04542,1,@AuxAV21C1441,0)
               THISFORM.AV21C1441 = AuxAV21C1441
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04542,2,PADR( TRIM(THISFORM.AV20C1442),8, '%'),LEN(PADR( TRIM(THISFORM.AV20C1442),8, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04542,3,PADR( TRIM(THISFORM.AV19C1443),10, '%'),LEN(PADR( TRIM(THISFORM.AV19C1443),10, '%')),0)
               AuxAV18C1451 = THISFORM.AV18C1451
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04542,4,@AuxAV18C1451,0)
               THISFORM.AV18C1451 = AuxAV18C1451
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04542,5,PADR( TRIM(THISFORM.AV17C1444),12, '%'),LEN(PADR( TRIM(THISFORM.AV17C1444),12, '%')),0)
               AuxAV16C1445 = THISFORM.AV16C1445
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04542,6,@AuxAV16C1445,0)
               THISFORM.AV16C1445 = AuxAV16C1445
               AuxAV15C1446 = THISFORM.AV15C1446
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04542,7,@AuxAV15C1446,0)
               THISFORM.AV15C1446 = AuxAV15C1446
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04542 = Gx_err
               THISFORM.GX_DB_GetW04542_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04542 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04542) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04542 = Gx_err
                  THISFORM.GX_DB_GetW04542_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04542 <> 101
               BRKVCM2 = .F.
               THISFORM.A1447TmpNr = THISFORM.Buf_W04542_1447TmpNroLin
               THISFORM.A1445TmpFc = THISFORM.Buf_W04542_1445TmpFchLin
               THISFORM.A1446TmpNI = THISFORM.Buf_W04542_1446TmpNILin
               THISFORM.A1444TmpCt = THISFORM.Buf_W04542_1444TmpCta
               THISFORM.A1451TmpEm = THISFORM.Buf_W04542_1451TmpEmpCod
               THISFORM.A1443TmpUs = THISFORM.Buf_W04542_1443TmpUsu
               THISFORM.A1442TmpHo = THISFORM.Buf_W04542_1442TmpHor
               THISFORM.A1441TmpFc = THISFORM.Buf_W04542_1441TmpFch
               GX_SFLOAD = 0
               THISFORM.U12VCM2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04542 = Gx_err
               THISFORM.GX_DB_GetW04542_01 ()
            ENDDO
         ENDIF
      ENDPROC
