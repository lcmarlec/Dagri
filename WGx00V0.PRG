      PROCEDURE CreateTemp
         LOCAL SCW213S14
         SCW213S14 = ""
         IF USED( "SCW213S14" )
            SELECT SCW213S14
            SCW213S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW213S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA335C15CO"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 5
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA336C15PE"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA337C15AC"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 2

            GX_STRUCT[ 4 ,1]= "sA338C15PA"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW213S14 = GETE('z:\temp') + '\' + SCW213S14
            ENDIF
            CREATE DBF (SCW213S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW213S14) EXCLUSIVE ALIAS SCW213S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW213S14
         THIS.GX_SfAlias = "SCW213S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02132" , @HStmt_W02132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00V0","W02132","",GX_CURSOR_TYPE_READONLY,@HStmt_W02132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [C15PAGADO], [C15ACUMUL], [C15PERIOD], [C15CODPRO] FROM [DC1500] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([C15CODPRO] >= ?) AND ([C15PERIOD] like ?) AND ([C15ACUMUL] >= ?) "
                  cmdbuf = cmdbuf + "  AND ([C15PAGADO] >= ?) ORDER BY [C15CODPRO], [C15PERIOD]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02132,8)
                  THISFORM.GX_DB_BindColsW02132_01 ()
                  THISFORM.GX_DB_BindParmW02132_01 ()
               ENDIF
               AuxAV18C335 = THISFORM.AV18C335
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02132,1,@AuxAV18C335,0)
               THISFORM.AV18C335 = AuxAV18C335
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02132,2,PADR( TRIM(THISFORM.AV17C336),6, '%'),LEN(PADR( TRIM(THISFORM.AV17C336),6, '%')),0)
               AuxAV16C337 = THISFORM.AV16C337
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02132,3,@AuxAV16C337,0)
               THISFORM.AV16C337 = AuxAV16C337
               AuxAV15C338 = THISFORM.AV15C338
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02132,4,@AuxAV15C338,0)
               THISFORM.AV15C338 = AuxAV15C338
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02132 = Gx_err
               THISFORM.GX_DB_GetW02132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02132 = Gx_err
                  THISFORM.GX_DB_GetW02132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02132 <> 101
               BRKV5X2 = .F.
               THISFORM.A338C15PAG = THISFORM.Buf_W02132_338C15PAGADO
               THISFORM.A337C15ACU = THISFORM.Buf_W02132_337C15ACUMUL
               THISFORM.A336C15PER = THISFORM.Buf_W02132_336C15PERIOD
               THISFORM.A335C15COD = THISFORM.Buf_W02132_335C15CODPRO
               GX_SFLOAD = 0
               THISFORM.U12V5X2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02132 = Gx_err
               THISFORM.GX_DB_GetW02132_01 ()
            ENDDO
         ENDIF
      ENDPROC
