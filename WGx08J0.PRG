      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08792" , @HStmt_W08792 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX08J0","W08792","",GX_CURSOR_TYPE_READONLY,@HStmt_W08792) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [Llaperusu], [LLaPerFyH], [LlaPerCon], [LlaNroI], [EmpCod] FROM [LLAPER] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ? and [LlaNroI] >= ?) AND ([LlaPerCon] like ?) AND ([Llaperusu] "
                  cmdbuf = cmdbuf + "  like ?) AND ([LLaPerFyH] >= ?) ORDER BY [EmpCod], [LlaNroI], [LlaPerCon]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08792,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08792,9)
                  THISFORM.GX_DB_BindColsW08792_01 ()
                  THISFORM.GX_DB_BindParmW08792_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08792,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C1525 = THISFORM.AV6C1525
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08792,2,@AuxAV6C1525,0)
               THISFORM.AV6C1525 = AuxAV6C1525
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08792,3,PADR( TRIM(THISFORM.AV7C2677),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C2677),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08792,4,PADR( TRIM(THISFORM.AV8C2680),10, '%'),LEN(PADR( TRIM(THISFORM.AV8C2680),10, '%')),0)
               AuxAV9C2681 = THISFORM.AV9C2681
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W08792,5,@AuxAV9C2681,0)
               THISFORM.AV9C2681 = AuxAV9C2681
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08792 = Gx_err
               THISFORM.GX_DB_GetW08792_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08792 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08792) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08792 = Gx_err
                  THISFORM.GX_DB_GetW08792_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08792 <> 101
               BRKVOF2 = .F.
               THISFORM.A2680Llape = THISFORM.Buf_W08792_2680Llaperusu
               THISFORM.A2681LLaPe = THISFORM.Buf_W08792_2681LLaPerFyH
               THISFORM.A2677LlaPe = THISFORM.Buf_W08792_2677LlaPerCon
               THISFORM.A1525LlaNr = THISFORM.Buf_W08792_1525LlaNroI
               THISFORM.A2EmpCod = THISFORM.Buf_W08792_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VOF2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08792 = Gx_err
               THISFORM.GX_DB_GetW08792_01 ()
            ENDDO
         ENDIF
      ENDPROC
