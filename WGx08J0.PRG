      PROCEDURE CreateTemp
         LOCAL SCW879S16
         SCW879S16 = ""
         IF USED( "SCW879S16" )
            SELECT SCW879S16
            SCW879S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW879S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1525LlaN"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2677LlaP"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW879S16 = GETE('z:\temp') + '\' + SCW879S16
            ENDIF
            CREATE DBF (SCW879S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW879S16) EXCLUSIVE ALIAS SCW879S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW879S16
         THIS.GX_SfAlias = "SCW879S16"
