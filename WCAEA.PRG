                  cmdbuf = cmdbuf + "  [CAEAOrd], [CAEAOK]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W10162,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10162,14)
                  THISFORM.GX_DB_BindColsW10162_01 ()
                  THISFORM.GX_DB_BindParmW10162_01 ()
               ENDIF
               AuxAV41Caeapd = THISFORM.AV41Caeapd
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10162,1,@AuxAV41Caeapd,0)
               THISFORM.AV41Caeapd = AuxAV41Caeapd
               AuxAV42Caeaph = THISFORM.AV42Caeaph
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W10162,2,@AuxAV42Caeaph,0)
               THISFORM.AV42Caeaph = AuxAV42Caeaph
               AuxAV49Caeaok = THISFORM.AV49Caeaok
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10162,3,@AuxAV49Caeaok,0)
               THISFORM.AV49Caeaok = AuxAV49Caeaok
               AuxAV43Caeaha = THISFORM.AV43Caeaha
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10162,4,AuxAV43Caeaha,1,0)
               THISFORM.AV43Caeaha = AuxAV43Caeaha
               AuxAV43Caeaha = THISFORM.AV43Caeaha
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10162,5,AuxAV43Caeaha,1,0)
               THISFORM.AV43Caeaha = AuxAV43Caeaha
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10162 = Gx_err
               THISFORM.GX_DB_GetW10162_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV55Pgmnam = "WCAEA"
               THISFORM.Gx_date = DATE()
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10162 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10162) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10162 = Gx_err
                  THISFORM.GX_DB_GetW10162_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10162 <> 101
               BRKVS82 = .F.
               THISFORM.AV40Caeaco = SPACE(40)
               THISFORM.A2428CAEAO = THISFORM.Buf_W10162_2428CAEAOK
               THISFORM.A3041CAEAH = THISFORM.Buf_W10162_3041CAEAHab
               THISFORM.A2433CAEAF = THISFORM.Buf_W10162_2433CAEAFHta
               THISFORM.A2431CAEAF = THISFORM.Buf_W10162_2431CAEAFDde
               THISFORM.A2430CAEAN = THISFORM.Buf_W10162_2430CAEANro
               THISFORM.A2427CAEAO = THISFORM.Buf_W10162_2427CAEAOrd
               THISFORM.A2426CAEAP = THISFORM.Buf_W10162_2426CAEAPer
               GX_SFLOAD = 0
               THISFORM.U15VS82 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10162) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10162 = Gx_err
               THISFORM.GX_DB_GetW10162_01 ()
            ENDDO
         ENDIF
      ENDPROC
