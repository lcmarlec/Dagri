      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08582" , @HStmt_W08582 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREQSER","W08582","",GX_CURSOR_TYPE_READONLY,@HStmt_W08582) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[DcCFec], T2.[EntReqOk], T1.[EntGruTip], T1.[DcCTip], T1.[DcCNroInt], "
                  cmdbuf = cmdbuf + "  T1.[DccReqOk], T1.[DcCEst], T2.[EntRaz], T1.[EntCod], T1.[DcCFecOri], T1.[DcCNro], "
                  cmdbuf = cmdbuf + "  T1.[DcCSuc], T1.[DccSer], T1.[DccTipRed] FROM ([DCCOM] T1 (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[DccSer] "
                  cmdbuf = cmdbuf + "  = ? or ? = ' ') AND (T1.[DcCSuc] = ? or ? = 0) AND (T1.[DcCNro] >= ?) AND (T1.[DcCEst] "
                  cmdbuf = cmdbuf + "  > 0) AND (T1.[DcCEst] < 9) AND (T1.[DcCFec] >= ?) AND (T1.[DccReqOk] = ? or ? = "
                  cmdbuf = cmdbuf + "  9) AND (T1.[EntCod] = ? or ? = 0) AND (T1.[DccTipRed] = 'FC') AND (T2.[EntReqOk] "
                  cmdbuf = cmdbuf + "  = 1) ORDER BY T1.[EmpCod], T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08582,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08582,15)
                  THISFORM.GX_DB_BindColsW08582_01 ()
                  THISFORM.GX_DB_BindParmW08582_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08582,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV36Serie = THISFORM.AV36Serie
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08582,2,AuxAV36Serie,1,0)
               THISFORM.AV36Serie = AuxAV36Serie
               AuxAV36Serie = THISFORM.AV36Serie
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08582,3,AuxAV36Serie,1,0)
               THISFORM.AV36Serie = AuxAV36Serie
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08582,4,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08582,5,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV24Desnro = THISFORM.AV24Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08582,6,@AuxAV24Desnro,0)
               THISFORM.AV24Desnro = AuxAV24Desnro
               AuxAV34Rorfch = THISFORM.AV34Rorfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08582,7,@AuxAV34Rorfch,0)
               THISFORM.AV34Rorfch = AuxAV34Rorfch
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08582,8,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08582,9,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV28Entcod = THISFORM.AV28Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08582,10,@AuxAV28Entcod,0)
               THISFORM.AV28Entcod = AuxAV28Entcod
               AuxAV28Entcod = THISFORM.AV28Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08582,11,@AuxAV28Entcod,0)
               THISFORM.AV28Entcod = AuxAV28Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08582 = Gx_err
               THISFORM.GX_DB_GetW08582_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV39Pgmnam = "WReqSer"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08582 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08582) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08582 = Gx_err
                  THISFORM.GX_DB_GetW08582_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08582 <> 101
               BRKVNU2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W08582_2EmpCod
               THISFORM.A347DcCFec = THISFORM.Buf_W08582_347DcCFec
               THISFORM.A2612EntRe = THISFORM.Buf_W08582_2612EntReqOk
               THISFORM.A150EntGru = THISFORM.Buf_W08582_150EntGruTip
               THISFORM.A348DcCTip = THISFORM.Buf_W08582_348DcCTip
               THISFORM.A346DcCNro = THISFORM.Buf_W08582_346DcCNroInt
