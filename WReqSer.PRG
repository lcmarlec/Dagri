               THISFORM.A373DcCEst = THISFORM.Buf_W08582_373DcCEst
               THISFORM.A153EntRaz = THISFORM.Buf_W08582_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W08582_120EntCod
               THISFORM.A2278DcCFe = THISFORM.Buf_W08582_2278DcCFecOri
               THISFORM.A352DcCNro = THISFORM.Buf_W08582_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W08582_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W08582_349DccSer
               THISFORM.A1322DccTi = THISFORM.Buf_W08582_1322DccTipRed
               THISFORM.A2612EntRe = THISFORM.Buf_W08582_2612EntReqOk
               THISFORM.A153EntRaz = THISFORM.Buf_W08582_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U18VNU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08582 = Gx_err
               THISFORM.GX_DB_GetW08582_01 ()
            ENDDO
         ENDIF
