      PROCEDURE CreateTemp
         LOCAL SCW149S13
         SCW149S13 = ""
         IF USED( "SCW149S13" )
            SELECT SCW149S13
            SCW149S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW149S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA590ForNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA591ForFc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA586ForFa"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA587ForFa"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA588ForAr"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA589ForAr"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 40
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA593ForCn"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW149S13 = GETE('z:\temp') + '\' + SCW149S13
            ENDIF
            CREATE DBF (SCW149S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW149S13) EXCLUSIVE ALIAS SCW149S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW149S13
         THIS.GX_SfAlias = "SCW149S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01492" , @HStmt_W01492 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKFOR","W01492","",GX_CURSOR_TYPE_READONLY,@HStmt_W01492) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[ForDis], T1.[ForCnt], T2.[ArtDsc] AS ForArtDsc, T1.[ForArtCod] "
                  cmdbuf = cmdbuf + "  AS ForArtCod, T1.[ForFamSubC] AS ForFamSubC, T1.[ForFamCod] AS ForFamCod, T1.[ForFch], "
                  cmdbuf = cmdbuf + "  T1.[ForNro] FROM ([FORPRO] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[ForFamCod] AND T2.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = T1.[ForFamSubC] AND T2.[ArtCod] = T1.[ForArtCod]) WHERE (T1.[EmpCod] = ? and T1.[ForFamCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[ForFamSubC] = ? and T1.[ForArtCod] = ?) AND (T1.[ForDis] = 'S') ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01492,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01492,16)
                  THISFORM.GX_DB_BindColsW01492_01 ()
                  THISFORM.GX_DB_BindParmW01492_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01492,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV19Famcod = THISFORM.AV19Famcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01492,2,@AuxAV19Famcod,0)
               THISFORM.AV19Famcod = AuxAV19Famcod
               AuxAV20Famsub = THISFORM.AV20Famsub
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01492,3,@AuxAV20Famsub,0)
               THISFORM.AV20Famsub = AuxAV20Famsub
               AuxAV21Artcod = THISFORM.AV21Artcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01492,4,@AuxAV21Artcod,0)
               THISFORM.AV21Artcod = AuxAV21Artcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01492 = Gx_err
               THISFORM.GX_DB_GetW01492_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WSKFor"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01492 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01492) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01492 = Gx_err
                  THISFORM.GX_DB_GetW01492_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01492 <> 101
               BRKV452 = .F.
               THISFORM.A594ForDis = THISFORM.Buf_W01492_594ForDis
               THISFORM.A593ForCnt = THISFORM.Buf_W01492_593ForCnt
               THISFORM.A589ForArt = THISFORM.Buf_W01492_589ForArtDsc
               THISFORM.A588ForArt = THISFORM.Buf_W01492_588ForArtCod
               THISFORM.A587ForFam = THISFORM.Buf_W01492_587ForFamSubC
               THISFORM.A586ForFam = THISFORM.Buf_W01492_586ForFamCod
               THISFORM.A591ForFch = THISFORM.Buf_W01492_591ForFch
               THISFORM.A590ForNro = THISFORM.Buf_W01492_590ForNro
               THISFORM.A589ForArt = THISFORM.Buf_W01492_589ForArtDsc
               GX_SFLOAD = 0
               THISFORM.U15V452 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01492 = Gx_err
               THISFORM.GX_DB_GetW01492_01 ()
            ENDDO
         ENDIF
      ENDPROC
