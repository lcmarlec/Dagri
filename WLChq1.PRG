      ENDPROC
      PROCEDURE Refresh
         THIS.SetValue( THISFORM.AV36Chqsre )
         CGXComboBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         * Call Load for WKP
         IF THISFORM.GX_1_accepted
            THISFORM.LoadObj(0)
            THISFORM.Refresh()
         ENDIF
      RETURN .T.
      ENDPROC
