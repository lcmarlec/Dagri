      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.AV36Chqsre
         THIS.AddData( 0 , "No incluídos" )
         THIS.AddData( 1 , "Incluídos" )
         THIS.AddData( 2 , "Sólo reEntregados" )
         THIS.InitControl()
         THIS.LoadLocalVar()
         CGXComboBox ::Init
         THIS.GX_OldValue = THISFORM.AV36Chqsre
         THIS.GX_Level = 2
      ENDPROC
      PROCEDURE GotFocus
         CGXComboBox ::GotFocus
         THIS.GXGotFocus()
         IF THISFORM.GX_NewLastVld > - 1
            THISFORM.GX_lastvld = THISFORM.GX_NewLastVld
            THISFORM.GX_NewLastVld = -1
            NODEFAULT
            RETURN
         ENDIF
         SET TOPIC TO Chqsreent
         THISFORM.Gx_cursor = "THISFORM.AV36Chqsre"
         THISFORM.SetFKeys()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
      ENDPROC
      PROCEDURE LostFocus
         IF ! MDOWN() .and. (LASTKEY() = 9 .or. LASTKEY() = 13)
            THISFORM.DoEnter()
         ENDIF
