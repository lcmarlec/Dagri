         THISFORM.AV43GXLvl4 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02922" , @HStmt_W02922 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLCHQ1","W02922","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W02922) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[BcoCod], T1.[BcoCta], T1.[BcoCtaCie], T2.[BcoDsc], T1.[BcoCtaNro] FROM "
            cmdbuf = cmdbuf + "  ([CTAS] T1 (NOLOCK) LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[BcoCod]) "
            cmdbuf = cmdbuf + "  WHERE T1.[BcoCta] = ? ORDER BY T1.[BcoCta]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02922,cmdbuf)
            THISFORM.GX_DB_BindColsW02922_01 ()
            THISFORM.GX_DB_BindParmW02922_01 ()
         ENDIF
         AuxAV27Cta = THISFORM.AV27Cta
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02922,1,@AuxAV27Cta,0)
         THISFORM.AV27Cta = AuxAV27Cta
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02922) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W02922 = Gx_err
         THISFORM.GX_DB_GetW02922_01 ()
         DO WHILE THISFORM.W02922 <> 101
            THISFORM.A86BcoCod = THISFORM.Buf_W02922_86BcoCod
            THISFORM.A76BcoCta = THISFORM.Buf_W02922_76BcoCta
            THISFORM.A1478BcoCt = THISFORM.Buf_W02922_1478BcoCtaCie
