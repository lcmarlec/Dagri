            THISFORM.A77BcoCtaN = THISFORM.Buf_W02922_77BcoCtaNro
            THISFORM.A87BcoDsc = THISFORM.Buf_W02922_87BcoDsc
            THISFORM.AV43GXLvl4 = 1
            THISFORM.AV28Banco = ALLTRIM( THISFORM.A77BcoCtaN ) + " " + ALLTRIM( THISFORM.A87BcoDsc )
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W02922) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV43GXLvl4 = 0
            THISFORM.AV27Cta = 0
            THISFORM.AV28Banco = "Cuenta Inexistente "
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
