                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WIMPCHE1","W02952","",GX_CURSOR_TYPE_READONLY,@HStmt_W02952) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ChqLin], [ChqTip], [ChqImpreso], [ChqTit], [ChqCta], [EmpCod], [ChqNroI], "
                  cmdbuf = cmdbuf + "  [ChqImp], [ChqFchDeb], [ChqPrvGrT], [ChqPrvCod], [ChqNro] FROM [CHQS] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ? and [ChqCta] = ? and [ChqNro] >= ?) AND ([ChqImpreso] "
                  cmdbuf = cmdbuf + "  = 0) AND ([ChqNro] <= ?) ORDER BY [EmpCod], [ChqCta], [ChqNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02952,cmdbuf)
