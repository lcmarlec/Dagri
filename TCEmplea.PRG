      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02312,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA2263CEmCo = THISFORM.A2263CEmCo
            Gx_err = GX_DB_SetStr( HStmt_T02312,2,AuxA2263CEmCo,4,0)
            THISFORM.A2263CEmCo = AuxA2263CEmCo
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02312) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02312 = Gx_err
            THISFORM.GX_DB_GetT02312_01 ()
            IF .NOT. THISFORM.T02312 <> 103
               DO GX_ERRMW WITH "CEMPLEAD reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02312 = 101 .OR. THISFORM.Z2264CEmDs <> THISFORM.Buf_T02312_2264CEmDsc
               DO GX_ERRMW WITH "CEMPLEAD fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02316" , @HStmt_T02316 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCEMPLEA","T02316","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02316) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CEMPLEAD] ([EmpCod], [CEmCod], [CEmDsc], [CEmVal]) VALUES (?, ?, ?, "
                  cmdbuf = cmdbuf + "  ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02316,cmdbuf)
                  THISFORM.GX_DB_BindParmT02316_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02316,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2263CEmCo = THISFORM.A2263CEmCo
               Gx_err = GX_DB_SetStr( HStmt_T02316,2,AuxA2263CEmCo,4,0)
               THISFORM.A2263CEmCo = AuxA2263CEmCo
               AuxA2264CEmDs = THISFORM.A2264CEmDs
               Gx_err = GX_DB_SetStr( HStmt_T02316,3,AuxA2264CEmDs,60,0)
               THISFORM.A2264CEmDs = AuxA2264CEmDs
               AuxA2265CEmVa = THISFORM.A2265CEmVa
               Gx_err = GX_DB_SetDouble( HStmt_T02316,4,@AuxA2265CEmVa,0)
               THISFORM.A2265CEmVa = AuxA2265CEmVa
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02316) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02316 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02316) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T02316 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02317" , @HStmt_T02317 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCEMPLEA","T02317","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02317) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [CEMPLEAD] SET [CEmDsc]=?, [CEmVal]=?  WHERE [EmpCod] = ? AND [CEmCod] = ? "
                  cmdbuf = cmdbuf + "  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02317,cmdbuf)
                  THISFORM.GX_DB_BindParmT02317_01 ()
               ENDIF
               AuxA2264CEmDs = THISFORM.A2264CEmDs
               Gx_err = GX_DB_SetStr( HStmt_T02317,1,AuxA2264CEmDs,60,0)
               THISFORM.A2264CEmDs = AuxA2264CEmDs
               AuxA2265CEmVa = THISFORM.A2265CEmVa
               Gx_err = GX_DB_SetDouble( HStmt_T02317,2,@AuxA2265CEmVa,0)
               THISFORM.A2265CEmVa = AuxA2265CEmVa
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02317,3,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2263CEmCo = THISFORM.A2263CEmCo
               Gx_err = GX_DB_SetStr( HStmt_T02317,4,AuxA2263CEmCo,4,0)
               THISFORM.A2263CEmCo = AuxA2263CEmCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02317) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02317 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02317) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02318" , @HStmt_T02318 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCEMPLEA","T02318","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02318) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CEMPLEAD]  WHERE [EmpCod] = ? AND [CEmCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02318,cmdbuf)
                  THISFORM.GX_DB_BindParmT02318_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02318,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2263CEmCo = THISFORM.A2263CEmCo
               Gx_err = GX_DB_SetStr( HStmt_T02318,2,AuxA2263CEmCo,4,0)
               THISFORM.A2263CEmCo = AuxA2263CEmCo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02318) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02318 = Gx_err
               THISFORM.T02312 = iif( THISFORM.T02318 = 0 , 104 , THISFORM.T02318 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02318) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
