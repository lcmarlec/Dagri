                  cmdbuf = cmdbuf + "  >= ?) AND ([DcVEntGruT] like ?) AND ([DcVEntCod] >= ?) AND ([DcVEntLgCo] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([DcVFch] >= ?) AND ([DcVTip] like ?) AND ([DcVTot] = ?) ORDER BY [EmpCod], [DcVNroInt] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02242,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02242,8)
                  THISFORM.GX_DB_BindColsW02242_01 ()
                  THISFORM.GX_DB_BindParmW02242_01 ()
