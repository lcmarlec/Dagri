      PROCEDURE CreateTemp
         LOCAL SCW1110S20
         SCW1110S20 = ""
         IF USED( "SCW1110S20" )
            SELECT SCW1110S20
            SCW1110S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1110S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3284CACU"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 11
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA3285CATi"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3286CASu"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 5
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3287CANr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 9
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA3288CAFc"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3290CAMo"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 3
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1110S20 = GETE('z:\temp') + '\' + SCW1110S20
            ENDIF
            CREATE DBF (SCW1110S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1110S20) EXCLUSIVE ALIAS SCW1110S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1110S20
         THIS.GX_SfAlias = "SCW1110S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11102" , @HStmt_W11102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0AF0","W11102","",GX_CURSOR_TYPE_READONLY,@HStmt_W11102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CACAE], [CAMon], [CAFch], [CANro], [CASuc], [CATipo], [CACUIT] FROM [COMPAFIP] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([CACUIT] >= ? and [CATipo] >= ? and [CASuc] >= ? and "
                  cmdbuf = cmdbuf + "  [CANro] >= ?) AND ([CAFch] >= ?) AND ([CACAE] like ?) AND ([CAMon] >= ?) ORDER BY "
                  cmdbuf = cmdbuf + "  [CACUIT], [CATipo], [CASuc], [CANro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11102,9)
                  THISFORM.GX_DB_BindColsW11102_01 ()
                  THISFORM.GX_DB_BindParmW11102_01 ()
               ENDIF
               AuxAV5C3284 = THISFORM.AV5C3284
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W11102,1,@AuxAV5C3284,0)
               THISFORM.AV5C3284 = AuxAV5C3284
               AuxAV6C3285 = THISFORM.AV6C3285
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11102,2,@AuxAV6C3285,0)
               THISFORM.AV6C3285 = AuxAV6C3285
               AuxAV7C3286 = THISFORM.AV7C3286
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11102,3,@AuxAV7C3286,0)
               THISFORM.AV7C3286 = AuxAV7C3286
               AuxAV8C3287 = THISFORM.AV8C3287
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W11102,4,@AuxAV8C3287,0)
               THISFORM.AV8C3287 = AuxAV8C3287
               AuxAV9C3288 = THISFORM.AV9C3288
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11102,5,@AuxAV9C3288,0)
               THISFORM.AV9C3288 = AuxAV9C3288
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11102,6,PADR( TRIM(THISFORM.AV10C3289),15, '%'),LEN(PADR( TRIM(THISFORM.AV10C3289),15, '%')),0)
               AuxAV11C3290 = THISFORM.AV11C3290
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11102,7,@AuxAV11C3290,0)
               THISFORM.AV11C3290 = AuxAV11C3290
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11102 = Gx_err
               THISFORM.GX_DB_GetW11102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11102 = Gx_err
                  THISFORM.GX_DB_GetW11102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11102 <> 101
               BRKVUU2 = .F.
               THISFORM.A3289CACAE = THISFORM.Buf_W11102_3289CACAE
               THISFORM.A3290CAMon = THISFORM.Buf_W11102_3290CAMon
               THISFORM.A3288CAFch = THISFORM.Buf_W11102_3288CAFch
               THISFORM.A3287CANro = THISFORM.Buf_W11102_3287CANro
               THISFORM.A3286CASuc = THISFORM.Buf_W11102_3286CASuc
               THISFORM.A3285CATip = THISFORM.Buf_W11102_3285CATipo
               THISFORM.A3284CACUI = THISFORM.Buf_W11102_3284CACUIT
               GX_SFLOAD = 0
               THISFORM.U12VUU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11102 = Gx_err
               THISFORM.GX_DB_GetW11102_01 ()
            ENDDO
         ENDIF
      ENDPROC
