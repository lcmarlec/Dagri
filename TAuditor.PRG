         Gx_fcond = S46AudSist = THISFORM.A46AudSist .AND. S47AudEmpC = THISFORM.A47AudEmpC .AND. S48AudFch = THISFORM.A48AudFch .AND. S49Audtime = THISFORM.A49Audtime .AND. S51AudCodO = THISFORM.A51AudCodO
         Gx_fcond = Gx_fcond .AND. S14AudNro = THISFORM.A14AudNro .AND. S52AudUsu = THISFORM.A52AudUsu
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT7S9 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT7S9 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S46AudSist = THISFORM.A46AudSist .AND. S47AudEmpC = THISFORM.A47AudEmpC .AND. S48AudFch = THISFORM.A48AudFch .AND. S49Audtime = THISFORM.A49Audtime .AND. S51AudCodO = THISFORM.A51AudCodO
            Gx_fcond = Gx_fcond .AND. S14AudNro = THISFORM.A14AudNro .AND. S52AudUsu = THISFORM.A52AudUsu
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT7S9 .Refresh()
               THISFORM. cCT7S9 .AfterRowColChange1()
               THISFORM.A46AudSist = S46AudSist
               THISFORM.A47AudEmpC = S47AudEmpC
