               THISFORM.A49Audtime = S49Audtime
               THISFORM.A51AudCodO = S51AudCodO
               THISFORM.A14AudNro = S14AudNro
               THISFORM.A52AudUsu = S52AudUsu
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT7S9 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT7S9 .LoadRec(2, @sf_err)
            Gx_fcond = S46AudSist = THISFORM.A46AudSist .AND. S47AudEmpC = THISFORM.A47AudEmpC .AND. S48AudFch = THISFORM.A48AudFch .AND. S49Audtime = THISFORM.A49Audtime .AND. S51AudCodO = THISFORM.A51AudCodO
            Gx_fcond = Gx_fcond .AND. S14AudNro = THISFORM.A14AudNro .AND. S52AudUsu = THISFORM.A52AudUsu
            DO WHILE sf_err = 0 .and. !GX_fcond
