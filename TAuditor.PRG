      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T00077" , @HStmt_T00077 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TAUDITOR","T00077","",GX_CURSOR_TYPE_READONLY,@HStmt_T00077) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [AudSist], [AudEmpCod], [AudFch], [Audtime], [AudCodObj], [AudNro], [AudUsu], "
                  cmdbuf = cmdbuf + "  [AudCodAct], [AudObs], [AudWrk] FROM [AUDIT] (NOLOCK) ORDER BY [AudSist], [AudEmpCod], "
                  cmdbuf = cmdbuf + "  [AudFch], [Audtime], [AudCodObj], [AudNro], [AudUsu]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T00077,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T00077,16)
                  THISFORM.GX_DB_BindColsT00077_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00077) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00077 = Gx_err
               THISFORM.GX_DB_GetT00077_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T00077 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00077) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00077 = Gx_err
                  THISFORM.GX_DB_GetT00077_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T00077 <> 101
               BRK074 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT7S9.Columns(9).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00077) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00077 = Gx_err
               THISFORM.GX_DB_GetT00077_01 ()
            ENDDO
         ENDIF
      ENDPROC
