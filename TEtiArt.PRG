      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T030920" , @HStmt_T030920 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TETIART","T030920","",GX_CURSOR_TYPE_READONLY,@HStmt_T030920) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EtAFch], [LiPrCod], [EtALin], [ETAIUsu], [EtAIFH], [ETAICnt] FROM "
                  cmdbuf = cmdbuf + "  [ETIART2] (NOLOCK) WHERE [EmpCod] = ? AND [EtAFch] = ? AND [LiPrCod] = ? AND [EtALin] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [EtAFch], [LiPrCod], [EtALin], [ETAIUsu], [EtAIFH]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T030920,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T030920,9)
                  THISFORM.GX_DB_BindColsT030920_01 ()
                  THISFORM.GX_DB_BindParmT030920_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T030920,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2969EtAFc = THISFORM.A2969EtAFc
               Gx_err = GX_DB_SetDate( HStmt_T030920,2,@AuxA2969EtAFc,0)
               THISFORM.A2969EtAFc = AuxA2969EtAFc
               AuxA2867LiPrC = THISFORM.A2867LiPrC
               Gx_err = GX_DB_SetStr( HStmt_T030920,3,AuxA2867LiPrC,4,0)
               THISFORM.A2867LiPrC = AuxA2867LiPrC
               AuxA2970EtALi = THISFORM.A2970EtALi
               Gx_err = GX_DB_SetInt( HStmt_T030920,4,@AuxA2970EtALi,0)
               THISFORM.A2970EtALi = AuxA2970EtALi
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T030920) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030920 = Gx_err
               THISFORM.GX_DB_GetT030920_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T030920 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030920) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T030920 = Gx_err
                  THISFORM.GX_DB_GetT030920_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T030920 <> 101
               BRK8L343 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT309S44.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF .T.
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T030920) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T030920 = Gx_err
               THISFORM.GX_DB_GetT030920_01 ()
            ENDDO
         ENDIF
      ENDPROC
