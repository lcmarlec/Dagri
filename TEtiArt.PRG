      PROCEDURE CreateTemp
         LOCAL SCT309S44
         SCT309S44 = ""
         IF USED( "SCT309S44" )
            SELECT SCT309S44
            SCT309S44 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT309S44
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2979ETAI"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2980EtAI"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 16
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2981ETAI"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT309S44 = GETE('z:\temp') + '\' + SCT309S44
            ENDIF
            CREATE DBF (SCT309S44) FROM ARRAY GX_STRUCT
            USE
            USE (SCT309S44) EXCLUSIVE ALIAS SCT309S44
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT309S44
         THIS.GX_SfAlias = "SCT309S44"
      ENDPROC
