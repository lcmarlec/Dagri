      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07862" , @HStmt_W07862 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKDSP","W07862","",GX_CURSOR_TYPE_READONLY,@HStmt_W07862) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DesObs], [DesCui], [DesTel], [DesRaz], [DesCod] FROM [DSPCHANT] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [DesCod] >= ?) AND ([DesRaz] like "
                  cmdbuf = cmdbuf + "  ? or (? = ' ')) AND ([DesCui] = ? or (? = convert(int, 0))) ORDER BY [EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07862,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07862,16)
                  THISFORM.GX_DB_BindColsW07862_01 ()
                  THISFORM.GX_DB_BindParmW07862_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07862,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV23Descod = THISFORM.AV23Descod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07862,2,@AuxAV23Descod,0)
               THISFORM.AV23Descod = AuxAV23Descod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07862,3,PADR( TRIM(THISFORM.AV18Desraz),40, '%'),LEN(PADR( TRIM(THISFORM.AV18Desraz),40, '%')),0)
               AuxAV18Desraz = THISFORM.AV18Desraz
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07862,4,AuxAV18Desraz,40,0)
               THISFORM.AV18Desraz = AuxAV18Desraz
               AuxAV21Descui = THISFORM.AV21Descui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07862,5,@AuxAV21Descui,0)
               THISFORM.AV21Descui = AuxAV21Descui
               AuxAV21Descui = THISFORM.AV21Descui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W07862,6,@AuxAV21Descui,0)
               THISFORM.AV21Descui = AuxAV21Descui
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07862) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07862 = Gx_err
               THISFORM.GX_DB_GetW07862_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WSkDsp"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07862 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07862) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07862 = Gx_err
                  THISFORM.GX_DB_GetW07862_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07862 <> 101
               BRKVLU2 = .F.
               THISFORM.A2348DesOb = THISFORM.Buf_W07862_2348DesObs
               THISFORM.A2347DesCu = THISFORM.Buf_W07862_2347DesCui
               THISFORM.A2346DesTe = THISFORM.Buf_W07862_2346DesTel
               THISFORM.A2344DesRa = THISFORM.Buf_W07862_2344DesRaz
               THISFORM.A2343DesCo = THISFORM.Buf_W07862_2343DesCod
               GX_SFLOAD = 0
               THISFORM.U15VLU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07862) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07862 = Gx_err
               THISFORM.GX_DB_GetW07862_01 ()
            ENDDO
         ENDIF
      ENDPROC
