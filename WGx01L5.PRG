      PROCEDURE CreateTemp
         LOCAL SCW237S20
         SCW237S20 = ""
         IF USED( "SCW237S20" )
            SELECT SCW237S20
            SCW237S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW237S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA595For1F"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA596For1F"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA597For1A"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA600For1P"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 8
            GX_STRUCT[ 4 ,4]= 4

            GX_STRUCT[ 5 ,1]= "sA603For1M"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW237S20 = GETE('z:\temp') + '\' + SCW237S20
            ENDIF
            CREATE DBF (SCW237S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW237S20) EXCLUSIVE ALIAS SCW237S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW237S20
         THIS.GX_SfAlias = "SCW237S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02372" , @HStmt_W02372 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01L5","W02372","",GX_CURSOR_TYPE_READONLY,@HStmt_W02372) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ForFamCod], [ForFamSubC], [ForArtCod], [ForNro], [For1Mer], [For1Por], "
                  cmdbuf = cmdbuf + "  [For1ArtCod], [For1FamSub], [For1FamCod] FROM [FORPRO1] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? and [ForFamCod] = ? and [ForFamSubC] = ? and [ForArtCod] = ? and [ForNro] "
                  cmdbuf = cmdbuf + "  = ? and [For1FamCod] >= ? and [For1FamSub] >= ? ORDER BY [EmpCod], [ForFamCod], "
                  cmdbuf = cmdbuf + "  [ForFamSubC], [ForArtCod], [ForNro], [For1FamCod], [For1FamSub], [For1ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02372,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02372,8)
                  THISFORM.GX_DB_BindColsW02372_01 ()
                  THISFORM.GX_DB_BindParmW02372_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA586ForFam = THISFORM.A586ForFam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,2,@AuxA586ForFam,0)
               THISFORM.A586ForFam = AuxA586ForFam
               AuxA587ForFam = THISFORM.A587ForFam
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,3,@AuxA587ForFam,0)
               THISFORM.A587ForFam = AuxA587ForFam
               AuxA588ForArt = THISFORM.A588ForArt
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,4,@AuxA588ForArt,0)
               THISFORM.A588ForArt = AuxA588ForArt
               AuxA590ForNro = THISFORM.A590ForNro
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,5,@AuxA590ForNro,0)
               THISFORM.A590ForNro = AuxA590ForNro
               AuxAV16C595 = THISFORM.AV16C595
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,6,@AuxAV16C595,0)
               THISFORM.AV16C595 = AuxAV16C595
               AuxAV15C596 = THISFORM.AV15C596
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02372,7,@AuxAV15C596,0)
               THISFORM.AV15C596 = AuxAV15C596
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02372 = Gx_err
               THISFORM.GX_DB_GetW02372_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02372 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02372) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02372 = Gx_err
                  THISFORM.GX_DB_GetW02372_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02372 <> 101
               BRKV6L2 = .F.
               THISFORM.A603For1Me = THISFORM.Buf_W02372_603For1Mer
               THISFORM.A600For1Po = THISFORM.Buf_W02372_600For1Por
               THISFORM.A597For1Ar = THISFORM.Buf_W02372_597For1ArtCod
               THISFORM.A596For1Fa = THISFORM.Buf_W02372_596For1FamSub
               THISFORM.A595For1Fa = THISFORM.Buf_W02372_595For1FamCod
               GX_SFLOAD = 0
               THISFORM.U12V6L2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02372 = Gx_err
               THISFORM.GX_DB_GetW02372_01 ()
            ENDDO
         ENDIF
      ENDPROC
