                  cmdbuf = " SELECT [AVLista1], [AVCodImp], [AVCanxBl], [AVKgsxBL], [AVUniMed], [AVDesArt], [AVCodArt] "
                  cmdbuf = cmdbuf + "  FROM [DBAR0000] (FASTFIRSTROW NOLOCK) WHERE ([AVCodArt] >= ?) AND ([AVDesArt] like "
                  cmdbuf = cmdbuf + "  ?) AND ([AVUniMed] like ?) AND ([AVLista1] >= ?) AND ([AVCodImp] >= ?) AND ([AVCanxBl] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([AVKgsxBL] >= ?) ORDER BY [AVCodArt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02032,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02032,8)
