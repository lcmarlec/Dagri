               THISFORM.AV16C241 = AuxAV16C241
               AuxAV15C242 = THISFORM.AV15C242
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02032,7,@AuxAV15C242,0)
               THISFORM.AV15C242 = AuxAV15C242
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02032) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02032 = Gx_err
               THISFORM.GX_DB_GetW02032_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02032 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02032) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02032 = Gx_err
                  THISFORM.GX_DB_GetW02032_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02032 <> 101
               BRKV5N2 = .F.
