               AuxAV21C236 = THISFORM.AV21C236
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02032,1,@AuxAV21C236,0)
               THISFORM.AV21C236 = AuxAV21C236
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02032,2,PADR( TRIM(THISFORM.AV20C237),30, '%'),LEN(PADR( TRIM(THISFORM.AV20C237),30, '%')),0)
