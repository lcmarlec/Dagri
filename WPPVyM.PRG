      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11652" , @HStmt_W11652 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPPVYM","W11652","",GX_CURSOR_TYPE_READONLY,@HStmt_W11652) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[FamCod], T1.[FamSubCod], T1.[PPEst], T1.[PPFch], T1.[EmpCod], T1.[PPObs], "
                  cmdbuf = cmdbuf + "  T1.[PPVnc], T1.[PPLote], T1.[PPEmb], T1.[PPCnt], T1.[LiPrCod], T3.[ArtDsc], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[PPID], T1.[PPVer], T2.[LiPrDsc], T1.[PPOrd] FROM (([PARPROD1] T1 (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) LEFT JOIN [LIPROD] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[LiPrCod] "
                  cmdbuf = cmdbuf + "  = T1.[LiPrCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[FamCod] = T1.[FamCod] AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = "
                  cmdbuf = cmdbuf + "  T1.[ArtCod]) WHERE (T1.[EmpCod] = ? and T1.[PPFch] = ? and T1.[PPVer] = ?) AND (T1.[PPEst] "
                  cmdbuf = cmdbuf + "  < 9) AND (T1.[LiPrCod] = ? or ? = 'XX') ORDER BY T1.[EmpCod], T1.[PPFch], T1.[PPVer], "
                  cmdbuf = cmdbuf + "  T1.[PPOrd]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11652,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11652,14)
                  THISFORM.GX_DB_BindColsW11652_01 ()
                  THISFORM.GX_DB_BindParmW11652_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11652,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Ppfch = THISFORM.AV21Ppfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11652,2,@AuxAV21Ppfch,0)
               THISFORM.AV21Ppfch = AuxAV21Ppfch
               AuxAV22Ppver = THISFORM.AV22Ppver
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11652,3,@AuxAV22Ppver,0)
               THISFORM.AV22Ppver = AuxAV22Ppver
               AuxAV24Liprco = THISFORM.AV24Liprco
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11652,4,AuxAV24Liprco,4,0)
               THISFORM.AV24Liprco = AuxAV24Liprco
               AuxAV24Liprco = THISFORM.AV24Liprco
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11652,5,AuxAV24Liprco,4,0)
               THISFORM.AV24Liprco = AuxAV24Liprco
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11652 = Gx_err
               THISFORM.GX_DB_GetW11652_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WPPVyM"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11652 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11652) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11652 = Gx_err
                  THISFORM.GX_DB_GetW11652_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11652 <> 101
               BRKVWD2 = .F.
               THISFORM.A3FamCod = THISFORM.Buf_W11652_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W11652_4FamSubCod
               THISFORM.A3376PPEst = THISFORM.Buf_W11652_3376PPEst
               THISFORM.A3365PPFch = THISFORM.Buf_W11652_3365PPFch
               THISFORM.A2EmpCod = THISFORM.Buf_W11652_2EmpCod
               THISFORM.A3375PPObs = THISFORM.Buf_W11652_3375PPObs
               THISFORM.A3374PPVnc = THISFORM.Buf_W11652_3374PPVnc
               THISFORM.A3373PPLot = THISFORM.Buf_W11652_3373PPLote
               THISFORM.A3385PPEmb = THISFORM.Buf_W11652_3385PPEmb
               THISFORM.A3372PPCnt = THISFORM.Buf_W11652_3372PPCnt
               THISFORM.A2867LiPrC = THISFORM.Buf_W11652_2867LiPrCod
               THISFORM.A6ArtDsc = THISFORM.Buf_W11652_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W11652_5ArtCod
               THISFORM.A3369PPID = THISFORM.Buf_W11652_3369PPID
               THISFORM.A3366PPVer = THISFORM.Buf_W11652_3366PPVer
               THISFORM.A2868LiPrD = THISFORM.Buf_W11652_2868LiPrDsc
               THISFORM.A3370PPOrd = THISFORM.Buf_W11652_3370PPOrd
               THISFORM.A2868LiPrD = THISFORM.Buf_W11652_2868LiPrDsc
               THISFORM.A6ArtDsc = THISFORM.Buf_W11652_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U19VWD2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11652) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11652 = Gx_err
               THISFORM.GX_DB_GetW11652_01 ()
            ENDDO
         ENDIF
      ENDPROC
