      PROCEDURE CreateTemp
         LOCAL SCW734S22
         SCW734S22 = ""
         IF USED( "SCW734S22" )
            SELECT SCW734S22
            SCW734S22 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW734S22
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA1888ParC"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 10
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1889ParS"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 10
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1890ParD"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 50
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1891ParV"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 140
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2217ParV"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW734S22 = GETE('z:\temp') + '\' + SCW734S22
            ENDIF
            CREATE DBF (SCW734S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW734S22) EXCLUSIVE ALIAS SCW734S22
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW734S22
         THIS.GX_SfAlias = "SCW734S22"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07342" , @HStmt_W07342 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPARAM","W07342","",GX_CURSOR_TYPE_READONLY,@HStmt_W07342) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ParVis], [ParValor], [ParDesc], [ParSCod], [ParCod] FROM [PARAM] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([ParDesc] like ?) AND ([ParCod] like ?) AND ([ParSCod] "
                  cmdbuf = cmdbuf + "  like ?) AND ([ParCod] like 'BCOEX%' or ? = 0) AND ([ParVis] = 1) ORDER BY [EmpCod], "
                  cmdbuf = cmdbuf + "  [ParCod], [ParSCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07342,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07342,13)
                  THISFORM.GX_DB_BindColsW07342_01 ()
                  THISFORM.GX_DB_BindParmW07342_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07342,1,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07342,2,PADR( TRIM(THISFORM.AV23Parcod),10, '%'),LEN(PADR( TRIM(THISFORM.AV23Parcod),10, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07342,3,PADR( TRIM(THISFORM.AV24Parsco),10, '%'),LEN(PADR( TRIM(THISFORM.AV24Parsco),10, '%')),0)
               AuxAV25Nivexp = THISFORM.AV25Nivexp
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07342,4,@AuxAV25Nivexp,0)
               THISFORM.AV25Nivexp = AuxAV25Nivexp
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07342 = Gx_err
               THISFORM.GX_DB_GetW07342_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV29Pgmnam = "WParam"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07342 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07342) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07342 = Gx_err
                  THISFORM.GX_DB_GetW07342_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07342 <> 101
               BRKVKE2 = .F.
               THISFORM.A2217ParVi = THISFORM.Buf_W07342_2217ParVis
               THISFORM.A1891ParVa = THISFORM.Buf_W07342_1891ParValor
               THISFORM.A1890ParDe = THISFORM.Buf_W07342_1890ParDesc
               THISFORM.A1889ParSC = THISFORM.Buf_W07342_1889ParSCod
               THISFORM.A1888ParCo = THISFORM.Buf_W07342_1888ParCod
               GX_SFLOAD = 0
               THISFORM.U17VKE2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07342 = Gx_err
               THISFORM.GX_DB_GetW07342_01 ()
            ENDDO
         ENDIF
      ENDPROC
