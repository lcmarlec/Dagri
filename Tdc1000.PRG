               IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
                  RETURN
               ENDIF
               gx_a_trn = .F.
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00313) , "TDC1000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00312) , "TDC1000" )
