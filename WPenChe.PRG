      PROCEDURE CreateTemp
         LOCAL SCW307S13
         SCW307S13 = ""
         IF USED( "SCW307S13" )
            SELECT SCW307S13
            SCW307S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW307S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA1080PenC"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1081PenC"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW307S13 = GETE('z:\temp') + '\' + SCW307S13
            ENDIF
            CREATE DBF (SCW307S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW307S13) EXCLUSIVE ALIAS SCW307S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW307S13
         THIS.GX_SfAlias = "SCW307S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03072" , @HStmt_W03072 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPENCHE","W03072","",GX_CURSOR_TYPE_READONLY,@HStmt_W03072) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PenMotCod], T1.[PenPCtaCod] AS PenPCtaCod, T3.[PenEmplead], "
                  cmdbuf = cmdbuf + "  T2.[CtaDes] AS PenCtaDsc, T1.[PenCtaCod] AS PenCtaCod, T3.[PenMotDsc] FROM (([PENTCHE1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CTA00] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[PCtaNro] = T1.[PenPCtaCod] AND T2.[CtaNro] = T1.[PenCtaCod]) LEFT JOIN [PENTCHE] "
                  cmdbuf = cmdbuf + "  T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[PenMotCod] = T1.[PenMotCod] AND "
                  cmdbuf = cmdbuf + "  T3.[PenPCtaCod] = T1.[PenPCtaCod]) WHERE T1.[EmpCod] = ? and T1.[PenMotCod] = ? "
                  cmdbuf = cmdbuf + "  and T1.[PenPCtaCod] = ? ORDER BY T1.[EmpCod], T1.[PenMotCod], T1.[PenPCtaCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03072,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03072,8)
                  THISFORM.GX_DB_BindColsW03072_01 ()
                  THISFORM.GX_DB_BindParmW03072_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03072,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1078PenMo = THISFORM.A1078PenMo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03072,2,@AuxA1078PenMo,0)
               THISFORM.A1078PenMo = AuxA1078PenMo
               AuxA1082PenPC = THISFORM.A1082PenPC
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03072,3,@AuxA1082PenPC,0)
               THISFORM.A1082PenPC = AuxA1082PenPC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03072 = Gx_err
               THISFORM.GX_DB_GetW03072_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03072 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03072) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03072 = Gx_err
                  THISFORM.GX_DB_GetW03072_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03072 <> 101
               BRKV8J2 = .F.
               THISFORM.A3065PenEm = THISFORM.Buf_W03072_3065PenEmplead
               THISFORM.A1081PenCt = THISFORM.Buf_W03072_1081PenCtaDsc
               THISFORM.A1080PenCt = THISFORM.Buf_W03072_1080PenCtaCod
               THISFORM.A1079PenMo = THISFORM.Buf_W03072_1079PenMotDsc
               THISFORM.A1081PenCt = THISFORM.Buf_W03072_1081PenCtaDsc
               THISFORM.A3065PenEm = THISFORM.Buf_W03072_3065PenEmplead
               THISFORM.A1079PenMo = THISFORM.Buf_W03072_1079PenMotDsc
               GX_SFLOAD = 0
               THISFORM.U12V8J2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03072) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03072 = Gx_err
               THISFORM.GX_DB_GetW03072_01 ()
            ENDDO
         ENDIF
      ENDPROC
