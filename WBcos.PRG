      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00112" , @HStmt_W00112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WBCOS","W00112","",GX_CURSOR_TYPE_READONLY,@HStmt_W00112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [BcoDsc], [BcoCod] FROM [BANCOS] (FASTFIRSTROW NOLOCK) WHERE UPPER([BcoDsc]) "
                  cmdbuf = cmdbuf + "  like UPPER(?) ORDER BY [BcoCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00112,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00112,15)
                  THISFORM.GX_DB_BindColsW00112_01 ()
                  THISFORM.GX_DB_BindParmW00112_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00112,1,PADR( TRIM(THISFORM.AV11Desde),40, '%'),LEN(PADR( TRIM(THISFORM.AV11Desde),40, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00112 = Gx_err
               THISFORM.GX_DB_GetW00112_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV18Pgmnam = "WBcos"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00112 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00112) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00112 = Gx_err
                  THISFORM.GX_DB_GetW00112_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00112 <> 101
               BRKV0B2 = .F.
               THISFORM.A87BcoDsc = THISFORM.Buf_W00112_87BcoDsc
               THISFORM.A86BcoCod = THISFORM.Buf_W00112_86BcoCod
               GX_SFLOAD = 0
               THISFORM.U18V0B2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00112) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00112 = Gx_err
               THISFORM.GX_DB_GetW00112_01 ()
            ENDDO
         ENDIF
