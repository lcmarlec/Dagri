               THISFORM. cCT285S10 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A2774CuoId = S2774CuoId
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A150EntGru = S150EntGru
