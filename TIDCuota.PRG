         S2774CuoId = THISFORM.A2774CuoId
         THISFORM.A2774CuoId = THISFORM.M2774CuoId
         THISFORM. cCT285S10 .SaveTemp()
         THISFORM. cCT285S10 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT285S10 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT285S10 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT285S10 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2774CuoId = THISFORM.A2774CuoId
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT285S10 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT285S10 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2774CuoId = THISFORM.A2774CuoId
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT285S10 .Refresh()
               THISFORM. cCT285S10 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
