               THISFORM.A2774CuoId = S2774CuoId
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT285S10 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT285S10 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2774CuoId = THISFORM.A2774CuoId
