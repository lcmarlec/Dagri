               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S2774CuoId = THISFORM.A2774CuoId
            ENDDO
            IF sf_err != 0
