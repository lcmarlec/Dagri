                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [CuoId], [CuoUsuAl], [CuoFchAl], [CuoUsuMod], "
                  cmdbuf = cmdbuf + "  [CuoFchMod], [CuoDsc] FROM [PROVES2] (NOLOCK) WHERE [EmpCod] = ? AND [EntGruTip] "
                  cmdbuf = cmdbuf + "  = ? AND [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod], [CuoId]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02858,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02858,9)
                  THISFORM.GX_DB_BindColsT02858_01 ()
                  THISFORM.GX_DB_BindParmT02858_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02858,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T02858,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T02858,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02858) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02858 = Gx_err
               THISFORM.GX_DB_GetT02858_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T02858 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02858) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02858 = Gx_err
                  THISFORM.GX_DB_GetT02858_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T02858 <> 101
               BRK7X312 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT285S10.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T02858_120EntCod = THISFORM.A120EntCod .AND. THISFORM.Buf_T02858_150EntGruTip = THISFORM.A150EntGru .AND. THISFORM.Buf_T02858_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02858) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02858 = Gx_err
               THISFORM.GX_DB_GetT02858_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2774CuoId"
            THISFORM.A2774CuoId = THISFORM.Buf_T02858_2774CuoId
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2776CuoUs"
            THISFORM.A2776CuoUs = THISFORM.Buf_T02858_2776CuoUsuAl
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2777CuoFc"
            THISFORM.A2777CuoFc = THISFORM.Buf_T02858_2777CuoFchAl
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2778CuoUs"
            THISFORM.A2778CuoUs = THISFORM.Buf_T02858_2778CuoUsuMod
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2779CuoFc"
            THISFORM.A2779CuoFc = THISFORM.Buf_T02858_2779CuoFchMod
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A2775CuoDs"
            THISFORM.A2775CuoDs = THISFORM.Buf_T02858_2775CuoDsc
         ENDIF
      ENDPROC
