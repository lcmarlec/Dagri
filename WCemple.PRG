      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07502" , @HStmt_W07502 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WCEMPLE","W07502","",GX_CURSOR_TYPE_READONLY,@HStmt_W07502) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CEmDsc], [CEmCod] FROM [CEMPLEAD] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ?) AND ([CEmDsc] like ?) ORDER BY [EmpCod], [CEmCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07502,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07502,8)
                  THISFORM.GX_DB_BindColsW07502_01 ()
                  THISFORM.GX_DB_BindParmW07502_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07502,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07502,2,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07502 = Gx_err
               THISFORM.GX_DB_GetW07502_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WCemple"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07502 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07502) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07502 = Gx_err
                  THISFORM.GX_DB_GetW07502_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07502 <> 101
               BRKVKU2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W07502_2EmpCod
               THISFORM.A2264CEmDs = THISFORM.Buf_W07502_2264CEmDsc
               THISFORM.A2263CEmCo = THISFORM.Buf_W07502_2263CEmCod
               GX_SFLOAD = 0
               THISFORM.U17VKU2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07502) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07502 = Gx_err
               THISFORM.GX_DB_GetW07502_01 ()
            ENDDO
         ENDIF
