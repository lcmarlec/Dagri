      PROCEDURE CreateTemp
         LOCAL SCW104S19
         SCW104S19 = ""
         IF USED( "SCW104S19" )
            SELECT SCW104S19
            SCW104S19 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW104S19
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA701OPeNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA4FamSubC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3FamCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA5ArtCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA6ArtDsc"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 50
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA737OpeCn"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 4

            GX_STRUCT[ 7 ,1]= "sA738OpeFE"
            GX_STRUCT[ 7 ,2]= "D"
            GX_STRUCT[ 7 ,3]= 8
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA731OpeNr"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW104S19 = GETE('z:\temp') + '\' + SCW104S19
            ENDIF
            CREATE DBF (SCW104S19) FROM ARRAY GX_STRUCT
            USE
            USE (SCW104S19) EXCLUSIVE ALIAS SCW104S19
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW104S19
         THIS.GX_SfAlias = "SCW104S19"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01042" , @HStmt_W01042 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPEDIS","W01042","",GX_CURSOR_TYPE_READONLY,@HStmt_W01042) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[OpeLin], T1.[EmpCod], T2.[OPeSuc], T1.[OpeLEs], T1.[OpeNroInt], T1.[OpeFEn], "
                  cmdbuf = cmdbuf + "  T1.[OpeCnt], T3.[ArtDsc], T1.[ArtCod], T1.[FamCod], T1.[FamSubCod], T2.[OPeNro] "
                  cmdbuf = cmdbuf + "  FROM (([OPEDIS1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [OPEDIS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[OpeNroInt] = T1.[OpeNroInt]) LEFT JOIN [ARTICS] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[FamCod] AND T3.[FamSubCod] = "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod] AND T3.[ArtCod] = T1.[ArtCod]) WHERE (T2.[OPeSuc] = ?) AND (T2.[OPeNro] "
                  cmdbuf = cmdbuf + "  >= ?) AND (T1.[OpeLEs] = ? or ? = 8) ORDER BY T1.[EmpCod], T1.[OpeNroInt], T1.[OpeLin] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01042,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01042,15)
                  THISFORM.GX_DB_BindColsW01042_01 ()
                  THISFORM.GX_DB_BindParmW01042_01 ()
               ENDIF
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01042,1,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV24Desnro = THISFORM.AV24Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01042,2,@AuxAV24Desnro,0)
               THISFORM.AV24Desnro = AuxAV24Desnro
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01042,3,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01042,4,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01042 = Gx_err
               THISFORM.GX_DB_GetW01042_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WOpedis"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01042 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01042) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01042 = Gx_err
                  THISFORM.GX_DB_GetW01042_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01042 <> 101
               BRKV2W2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W01042_2EmpCod
               THISFORM.A732OPeSuc = THISFORM.Buf_W01042_732OPeSuc
               THISFORM.A739OpeLEs = THISFORM.Buf_W01042_739OpeLEs
               THISFORM.A731OpeNro = THISFORM.Buf_W01042_731OpeNroInt
               THISFORM.A738OpeFEn = THISFORM.Buf_W01042_738OpeFEn
               THISFORM.A737OpeCnt = THISFORM.Buf_W01042_737OpeCnt
               THISFORM.A6ArtDsc = THISFORM.Buf_W01042_6ArtDsc
               THISFORM.A5ArtCod = THISFORM.Buf_W01042_5ArtCod
               THISFORM.A3FamCod = THISFORM.Buf_W01042_3FamCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01042_4FamSubCod
               THISFORM.A701OPeNro = THISFORM.Buf_W01042_701OPeNro
               THISFORM.A732OPeSuc = THISFORM.Buf_W01042_732OPeSuc
               THISFORM.A701OPeNro = THISFORM.Buf_W01042_701OPeNro
               THISFORM.A6ArtDsc = THISFORM.Buf_W01042_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U17V2W2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01042 = Gx_err
               THISFORM.GX_DB_GetW01042_01 ()
            ENDDO
         ENDIF
      ENDPROC
