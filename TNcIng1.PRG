      PROCEDURE CreateTemp
         LOCAL SCT65S9
         SCT65S9 = ""
         IF USED( "SCT65S9" )
            SELECT SCT65S9
            SCT65S9 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT65S9
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA483TDVIm"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA484TDVIm"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA485TDVNi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA486TDVIm"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 13
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCT65S9 = GETE('z:\temp') + '\' + SCT65S9
            ENDIF
            CREATE DBF (SCT65S9) FROM ARRAY GX_STRUCT
            USE
            USE (SCT65S9) EXCLUSIVE ALIAS SCT65S9
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT65S9
         THIS.GX_SfAlias = "SCT65S9"
      ENDPROC
