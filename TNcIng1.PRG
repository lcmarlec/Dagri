         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A485TDVNim"
            THISFORM.A485TDVNim = THISFORM.Buf_T006515_485TDVNim
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A486TDVImp"
            THISFORM.A486TDVImp = THISFORM.Buf_T006515_486TDVImpCnt
         ENDIF
      ENDPROC
