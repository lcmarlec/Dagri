                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03933) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03933 = Gx_err
                  THISFORM.GX_DB_GetT03933_01 ()
                  THISFORM. cCT393A3646 . ZMAX414 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCAX414 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T039310" , @HStmt_T039310 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TETIQUET","T039310","",GX_CURSOR_TYPE_READONLY,@HStmt_T039310) ,  ,  ,  , CS_SQLSRV , 0 )
