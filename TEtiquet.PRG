                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T039310,cmdbuf)
                  THISFORM.GX_DB_BindColsT039310_01 ()
                  THISFORM.GX_DB_BindParmT039310_01 ()
               ENDIF
               AuxBuf_T03933_2EmpCod = THISFORM.Buf_T03933_2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T039310,1,@AuxBuf_T03933_2EmpCod,0)
               THISFORM.Buf_T03933_2EmpCod = AuxBuf_T03933_2EmpCod
               AuxBuf_T03933_3646EtiTraz = THISFORM.Buf_T03933_3646EtiTraz
               Gx_err = GX_DB_SetStr( HStmt_T039310,2,AuxBuf_T03933_3646EtiTraz,LEN(AuxBuf_T03933_3646EtiTraz),0)
               THISFORM.Buf_T03933_3646EtiTraz = AuxBuf_T03933_3646EtiTraz
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T039310) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T039310 = Gx_err
               THISFORM.GX_DB_GetT039310_01 ()
               IF THISFORM.T039310 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T039310) , "TETIQUET" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " EtiUbic "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T039310) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT393A3646 . ZMAX414 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAX414 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT393A3745 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEAX414 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCAX414 ()
                  RETURN
               ENDIF
               THISFORM.cCT393A3646.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03933) , "TETIQUET" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03932) , "TETIQUET" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03934) , "TETIQUET" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03935) , "TETIQUET" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT393A3745 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT393A2 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
