      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01372" , @HStmt_W01372 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WRUTVTA","W01372","",GX_CURSOR_TYPE_READONLY,@HStmt_W01372) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [RutCod] FROM [RUTAS] (FASTFIRSTROW NOLOCK) WHERE [EmpCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [RutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01372,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01372,16)
                  THISFORM.GX_DB_BindColsW01372_01 ()
                  THISFORM.GX_DB_BindParmW01372_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01372,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01372 = Gx_err
               THISFORM.GX_DB_GetW01372_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WRutVta"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01372 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01372) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01372 = Gx_err
                  THISFORM.GX_DB_GetW01372_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01372 <> 101
               BRKV3T2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W01372_2EmpCod
               THISFORM.A966RutCod = THISFORM.Buf_W01372_966RutCod
               GX_SFLOAD = 0
               THISFORM.U18V3T2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01372) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01372 = Gx_err
               THISFORM.GX_DB_GetW01372_01 ()
            ENDDO
         ENDIF
