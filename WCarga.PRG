            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1150S11 = GETE('z:\temp') + '\' + SCW1150S11
            ENDIF
            CREATE DBF (SCW1150S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1150S11) EXCLUSIVE ALIAS SCW1150S11
         ENDIF
