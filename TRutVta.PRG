      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S966RutCod
         LOCAL S120EntCod
         LOCAL S176EntLgC
         S2EmpCod = THISFORM.A2EmpCod
         S966RutCod = THISFORM.A966RutCod
         S120EntCod = THISFORM.A120EntCod
         S176EntLgC = THISFORM.A176EntLgC
         THISFORM.A120EntCod = THISFORM.M120EntCod
         THISFORM.A153EntRaz = THISFORM.M153EntRaz
         THISFORM.A176EntLgC = THISFORM.M176EntLgC
         THISFORM. cCT99S19 .SaveTemp()
         THISFORM. cCT99S19 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT99S19 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT99S19 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT99S19 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S966RutCod = THISFORM.A966RutCod .AND. S120EntCod = THISFORM.A120EntCod .AND. S176EntLgC = THISFORM.A176EntLgC
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT99S19 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT99S19 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S966RutCod = THISFORM.A966RutCod .AND. S120EntCod = THISFORM.A120EntCod .AND. S176EntLgC = THISFORM.A176EntLgC
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT99S19 .Refresh()
               THISFORM. cCT99S19 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A966RutCod = S966RutCod
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A176EntLgC = S176EntLgC
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT99S19 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT99S19 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S966RutCod = THISFORM.A966RutCod .AND. S120EntCod = THISFORM.A120EntCod .AND. S176EntLgC = THISFORM.A176EntLgC
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT99S19 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S966RutCod = THISFORM.A966RutCod .AND. S120EntCod = THISFORM.A120EntCod .AND. S176EntLgC = THISFORM.A176EntLgC
            ENDDO
            IF sf_err != 0
               THISFORM. cCT99S19 .AppendRow()
               THISFORM. cCT99S19 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A966RutCod = S966RutCod
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A176EntLgC = S176EntLgC
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A966RutCod = S966RutCod
         THISFORM.A120EntCod = S120EntCod
         THISFORM.A176EntLgC = S176EntLgC
         RETURN .F.
      ENDFUNC
