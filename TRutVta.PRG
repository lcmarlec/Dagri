      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T009918" , @HStmt_T009918 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TRUTVTA","T009918","",GX_CURSOR_TYPE_READONLY,@HStmt_T009918) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [RutCod], [EntCod], [EntLgCod], [EntGruTip], [RutHab], [RutPri] "
                  cmdbuf = cmdbuf + "  FROM [RUTVTA] (NOLOCK) WHERE [EmpCod] = ? AND [RutCod] = ? ORDER BY [EmpCod], [RutCod], "
                  cmdbuf = cmdbuf + "  [EntCod], [EntLgCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T009918,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T009918,13)
                  THISFORM.GX_DB_BindColsT009918_01 ()
                  THISFORM.GX_DB_BindParmT009918_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T009918,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA966RutCod = THISFORM.A966RutCod
               Gx_err = GX_DB_SetInt( HStmt_T009918,2,@AuxA966RutCod,0)
               THISFORM.A966RutCod = AuxA966RutCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T009918) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009918 = Gx_err
               THISFORM.GX_DB_GetT009918_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T009918 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009918) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T009918 = Gx_err
                  THISFORM.GX_DB_GetT009918_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T009918 <> 101
               BRK2R106 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT99S19.Columns(3).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T009918_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T009918) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009918 = Gx_err
               THISFORM.GX_DB_GetT009918_01 ()
            ENDDO
         ENDIF
      ENDPROC
