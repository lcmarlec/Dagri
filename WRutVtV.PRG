                  cmdbuf = cmdbuf + "  T3.[EntLgDsc], T1.[EntLgCod], T2.[EntRaz], T1.[EntCod], T4.[RutChfCod] AS RutChfCod, "
                  cmdbuf = cmdbuf + "  T7.[ChfNom] AS RutChfNom FROM (((((([RUTVTA] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[EntGruTip] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[EntCod]) LEFT JOIN [CLTES] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T3.[EntGruTip] = T1.[EntGruTip] AND T3.[EntCod] = T1.[EntCod] AND T3.[EntLgCod] "
                  cmdbuf = cmdbuf + "  = T1.[EntLgCod]) LEFT JOIN [RUTAS] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T4.[RutCod] = T1.[RutCod]) LEFT JOIN [CAMION] T5 (NOLOCK) ON T5.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T5.[CamPat] = T4.[CamPat]) LEFT JOIN [ACOM] T6 (NOLOCK) ON T6.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T6.[acoCod] = T4.[acoCod]) LEFT JOIN [CHOFER] T7 (NOLOCK) ON T7.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T7.[ChfCod] = T4.[RutChfCod]) WHERE T1.[EmpCod] = ? and T1.[RutCod] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[RutCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01382,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01382,12)
                  THISFORM.GX_DB_BindColsW01382_01 ()
                  THISFORM.GX_DB_BindParmW01382_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01382,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA966RutCod = THISFORM.A966RutCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01382,2,@AuxA966RutCod,0)
               THISFORM.A966RutCod = AuxA966RutCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01382) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01382 = Gx_err
               THISFORM.GX_DB_GetW01382_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV13Pgmnam = "WRutVtV"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01382 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01382) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01382 = Gx_err
                  THISFORM.GX_DB_GetW01382_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01382 <> 101
               BRKV3U2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W01382_150EntGruTip
               THISFORM.A1665CamDs = THISFORM.Buf_W01382_1665CamDsc
               THISFORM.A1664CamPa = THISFORM.Buf_W01382_1664CamPat
               THISFORM.A2199acoCo = THISFORM.Buf_W01382_2199acoCod
               THISFORM.A2200acoNo = THISFORM.Buf_W01382_2200acoNom
               THISFORM.A186EntLgT = THISFORM.Buf_W01382_186EntLgTel
               THISFORM.A185EntLgC = THISFORM.Buf_W01382_185EntLgCont
               THISFORM.A968RutHab = THISFORM.Buf_W01382_968RutHab
               THISFORM.A967RutPri = THISFORM.Buf_W01382_967RutPri
               THISFORM.A178EntLgD = THISFORM.Buf_W01382_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W01382_177EntLgDsc
               THISFORM.A176EntLgC = THISFORM.Buf_W01382_176EntLgCod
               THISFORM.A153EntRaz = THISFORM.Buf_W01382_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W01382_120EntCod
               THISFORM.A1216RutCh = THISFORM.Buf_W01382_1216RutChfCod
               THISFORM.A1217RutCh = THISFORM.Buf_W01382_1217RutChfNom
               THISFORM.A153EntRaz = THISFORM.Buf_W01382_153EntRaz
               THISFORM.A186EntLgT = THISFORM.Buf_W01382_186EntLgTel
               THISFORM.A185EntLgC = THISFORM.Buf_W01382_185EntLgCont
               THISFORM.A178EntLgD = THISFORM.Buf_W01382_178EntLgDom
               THISFORM.A177EntLgD = THISFORM.Buf_W01382_177EntLgDsc
               THISFORM.A1664CamPa = THISFORM.Buf_W01382_1664CamPat
               THISFORM.A2199acoCo = THISFORM.Buf_W01382_2199acoCod
               THISFORM.A1216RutCh = THISFORM.Buf_W01382_1216RutChfCod
               THISFORM.A1665CamDs = THISFORM.Buf_W01382_1665CamDsc
               THISFORM.A2200acoNo = THISFORM.Buf_W01382_2200acoNom
               THISFORM.A1217RutCh = THISFORM.Buf_W01382_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U14V3U2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01382) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01382 = Gx_err
               THISFORM.GX_DB_GetW01382_01 ()
            ENDDO
         ENDIF
      ENDPROC
