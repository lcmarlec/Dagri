      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T00935,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA858RCVNro = THISFORM.A858RCVNro
            Gx_err = GX_DB_SetDouble( HStmt_T00935,2,@AuxA858RCVNro,0)
            THISFORM.A858RCVNro = AuxA858RCVNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00935) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T00935 = Gx_err
            THISFORM.GX_DB_GetT00935_01 ()
            IF .NOT. THISFORM.T00935 <> 103
               DO GX_ERRMW WITH "RECIBOS reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T00935 = 101 .OR. THISFORM.Z859RCVFch <> THISFORM.Buf_T00935_859RCVFch
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z865RCVTip <> THISFORM.Buf_T00935_865RCVTip
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1197RCVNr <> THISFORM.Buf_T00935_1197RCVNroDef
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2891RcvCt <> THISFORM.Buf_T00935_2891RcvCtaAju
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z878RCVRet <> THISFORM.Buf_T00935_878RCVRet
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z1933RCVFC <> THISFORM.Buf_T00935_1933RCVFChCC
               DO GX_ERRMW WITH "RECIBOS fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

