                  cmdbuf = cmdbuf + "  [RCVVal], [RCVRet], [RCVTot], [RCVSld], [RCVFchCB], [RcVUsu], [RCVFChCC]) VALUES "
                  cmdbuf = cmdbuf + "  (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, "
