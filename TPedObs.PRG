      PROCEDURE KeyPress
         LPARAMETERS gxKeyCode, gxShiftCtrlAlt
         THISFORM.gx_frmReadkey = gxKeyCode
         DO CASE
            CASE gxKeyCode = 29   && First
               THIS. DoFirst()
            CASE gxKeyCode = 31   && Previous
               THIS. DoPrevious()
            CASE gxKeyCode = 30   && Next
               THIS. DoNext()
            CASE gxKeyCode = 23   && Last
               THIS. DoLast()
            CASE gxKeyCode = 27   && Escape
               IF ! THISFORM.AfterLevel(THISFORM.GX_Curr_Level,-1)
                  RETURN
               ENDIF
               gx_a_trn = .F.
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00903) , "TPEDOBS" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00902) , "TPEDOBS" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00904) , "TPEDOBS" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00905) , "TPEDOBS" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00906) , "TPEDOBS" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT90A833 .AfterTrn()
                  DO CASE
                     CASE THISFORM.GX_Mode = "INS"
                        THISFORM.ReleaseAll()
                     CASE THISFORM.GX_Mode = "UPD"
                        THISFORM.ReleaseAll()
                     CASE THISFORM.GX_Mode = "DLT"
                        THISFORM.ReleaseAll()
                  ENDCASE
                  IF THISFORM.GX_Exit_GotFocus
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
                  gx_a_trn = .T.
                  IF ! THISFORM. cCT90V9 .ValidKey()
                     THISFORM.ReleaseAll()
                     RETURN
                  ENDIF
               ENDIF
               THISFORM.ReleaseAll()
         ENDCASE
      ENDPROC
