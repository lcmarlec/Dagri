               THISFORM.A802PedSuc = AuxA802PedSuc
               AuxA809PedSec = THISFORM.A809PedSec
               Gx_err = GX_DB_SetInt( HStmt_T009010,6,@AuxA809PedSec,0)
               THISFORM.A809PedSec = AuxA809PedSec
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T009010) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T009010 = Gx_err
               THISFORM.T00902 = iif( THISFORM.T009010 = 0 , 104 , THISFORM.T009010 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T009010) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV20Flag = THISFORM.AV24Vflag
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 136 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
