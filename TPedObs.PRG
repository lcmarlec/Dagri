      PROCEDURE cCT90A808.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCT90A808.ISVALID" )
         IF THISFORM.AV24Vflag > 1
            IF THISFORM.A808PedFVT = "RF" .OR. THISFORM.A808PedFVT = "FR"
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux3 = THISFORM.AV22Nr
               DO PSkNro WITH Aux0 , "RVT" , 1 , Aux3 , 0
               THISFORM.A2EmpCod = Aux0
               THISFORM.AV22Nr = Aux3
            ENDIF
            IF THISFORM.A808PedFVT = "FF" .OR. THISFORM.A808PedFVT = "FR"
               DO CASE
                  CASE THISFORM.A1334EntLg = 1 .OR. THISFORM.A1334EntLg = 3
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.AV8Emprcod
                     Aux1 = THISFORM.AV7Fechasi
                     Aux2 = THISFORM.AV21Suc
                     DO WSelSuc WITH Aux0 , Aux1 , Aux2
                     THISFORM.AV8Emprcod = Aux0
                     THISFORM.AV7Fechasi = Aux1
                     THISFORM.AV21Suc = Aux2
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.A2EmpCod
                     Aux2 = THISFORM.AV21Suc
                     Aux3 = THISFORM.AV23Nf
                     DO PSkNro WITH Aux0 , "FVA" , Aux2 , Aux3 , 0
                     THISFORM.A2EmpCod = Aux0
                     THISFORM.AV21Suc = Aux2
                     THISFORM.AV23Nf = Aux3
                  CASE THISFORM.A1334EntLg = 7 .OR. THISFORM.A1334EntLg = 6
                     THISFORM.AV21Suc = 1000
                     THISFORM.AV29Parval = SPACE(140)
                     IF THISFORM.A1334EntLg = 7
                        THISFORM.SaveTblPos()
                        Aux0 = THISFORM.AV8Emprcod
                        Aux3 = THISFORM.AV29Parval
                        DO RParam WITH Aux0 , "FACTELEC" , "EXTERIOR" , Aux3
                        THISFORM.AV8Emprcod = Aux0
                        THISFORM.AV29Parval = Aux3
                     ELSE
                        THISFORM.SaveTblPos()
                        Aux0 = THISFORM.AV8Emprcod
                        Aux3 = THISFORM.AV29Parval
                        DO RParam WITH Aux0 , "FACTELEC" , "SUR" , Aux3
                        THISFORM.AV8Emprcod = Aux0
                        THISFORM.AV29Parval = Aux3
                     ENDIF
                     IF val( THISFORM.AV29Parval ) > THISFORM.AV21Suc
                        THISFORM.AV21Suc = val( THISFORM.AV29Parval )
                     ENDIF
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.A2EmpCod
                     Aux2 = THISFORM.AV21Suc
                     Aux3 = THISFORM.AV23Nf
                     DO PSkNro WITH Aux0 , "FVE" , Aux2 , Aux3 , 0
                     THISFORM.A2EmpCod = Aux0
                     THISFORM.AV21Suc = Aux2
                     THISFORM.AV23Nf = Aux3
                  OTHERWISE
                     THISFORM.AV30Fecha = GXYMDTD5(2012,08,01)
                     IF THISFORM.AV7Fechasi < THISFORM.AV30Fecha
                        THISFORM.AV21Suc = 15
                     ELSE
                        THISFORM.AV21Suc = 18
                     ENDIF
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.A2EmpCod
                     Aux2 = THISFORM.AV21Suc
                     Aux3 = THISFORM.AV23Nf
                     DO PSkNro WITH Aux0 , "FVB" , Aux2 , Aux3 , 0
                     THISFORM.A2EmpCod = Aux0
                     THISFORM.AV21Suc = Aux2
                     THISFORM.AV23Nf = Aux3
               ENDCASE
            ENDIF
         ENDIF
         IF THISFORM.AV23Nf = 0
            THISFORM.cCT90L17.Enabled = 0
            THISFORM.cCT90V21.Enabled = 0
         ENDIF
         IF THISFORM.AV22Nr = 0
            THISFORM.cCT90L20.Enabled = 0
            THISFORM.cCT90V22.Enabled = 0
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

