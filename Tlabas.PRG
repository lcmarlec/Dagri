      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T011617" , @HStmt_T011617 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TLABAS","T011617","",GX_CURSOR_TYPE_READONLY,@HStmt_T011617) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [LabaNroInt], [LabaEntGru] AS LabaEntGru, [LabaEntCod] AS LabaEntCod, "
                  cmdbuf = cmdbuf + "  [LabaLgCod] AS LabaLgCod, [LabaFFch], [LabaFTip], [LabaFSer], [LabaFSuc], [LabaFNro], "
                  cmdbuf = cmdbuf + "  [LabaFNroI], [LabaTot] FROM [LABAS1] (NOLOCK) WHERE [EmpCod] = ? AND [LabaNroInt] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY [EmpCod], [LabaNroInt], [LabaEntGru], [LabaEntCod], [LabaLgCod], [LabaFFch], "
                  cmdbuf = cmdbuf + "  [LabaFTip], [LabaFSer], [LabaFSuc], [LabaFNro]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T011617,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T011617,12)
                  THISFORM.GX_DB_BindColsT011617_01 ()
                  THISFORM.GX_DB_BindParmT011617_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T011617,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1140LabaN = THISFORM.A1140LabaN
               Gx_err = GX_DB_SetDouble( HStmt_T011617,2,@AuxA1140LabaN,0)
               THISFORM.A1140LabaN = AuxA1140LabaN
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T011617) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011617 = Gx_err
               THISFORM.GX_DB_GetT011617_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T011617 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011617) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T011617 = Gx_err
                  THISFORM.GX_DB_GetT011617_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T011617 <> 101
               BRK38129 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT116S15.Columns(11).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T011617_1140LabaNroInt = THISFORM.A1140LabaN .AND. THISFORM.Buf_T011617_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T011617) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T011617 = Gx_err
               THISFORM.GX_DB_GetT011617_01 ()
            ENDDO
         ENDIF
      ENDPROC
