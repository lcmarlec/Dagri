      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01122" , @HStmt_W01122 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODIN","W01122","",GX_CURSOR_TYPE_READONLY,@HStmt_W01122) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T3.[FamCod], T3.[FamSubCod], T3.[ArtCod], T1.[EmpCod], T1.[OPrFamCod], T1.[OprFamSubC], "
                  cmdbuf = cmdbuf + "  T1.[OprArtCod], T1.[OPrLot], T1.[OPrSLt], T1.[OprIFor1Pr], T1.[OprIForSN], T1.[OprILin], "
                  cmdbuf = cmdbuf + "  T4.[OPrRes] AS OPrRes, T1.[OprICnt], T2.[ArtDsc] AS OprIArtDsc, T1.[OprIArtCod] "
                  cmdbuf = cmdbuf + "  AS OprIArtCod, T1.[OprIFamSub] AS OprIFamSub, T1.[OprIFamCod] AS OprIFamCod, T4.[OprPri], "
                  cmdbuf = cmdbuf + "  T5.[UsuNombre] AS OprResNom, T4.[OprHorIni], T4.[OPrForNro], T4.[OPrCnt], T3.[ArtDsc] "
                  cmdbuf = cmdbuf + "  FROM (((([OPRINS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[FamCod] = T1.[OprIFamCod] AND T2.[FamSubCod] = T1.[OprIFamSub] "
                  cmdbuf = cmdbuf + "  AND T2.[ArtCod] = T1.[OprIArtCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T3.[FamCod] = T1.[OPrFamCod] AND T3.[FamSubCod] = T1.[OprFamSubC] "
                  cmdbuf = cmdbuf + "  AND T3.[ArtCod] = T1.[OprArtCod]) LEFT JOIN [OPROD] T4 (NOLOCK) ON T4.[EmpCod] = "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] AND T4.[OPrFamCod] = T1.[OPrFamCod] AND T4.[OprFamSubC] = T1.[OprFamSubC] "
                  cmdbuf = cmdbuf + "  AND T4.[OprArtCod] = T1.[OprArtCod] AND T4.[OPrLot] = T1.[OPrLot] AND T4.[OPrSLt] "
                  cmdbuf = cmdbuf + "  = T1.[OPrSLt]) LEFT JOIN [USU002] T5 (NOLOCK) ON T5.[UsuCod] = T4.[OPrRes]) WHERE "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] = ? and T1.[OPrFamCod] = ? and T1.[OprFamSubC] = ? and T1.[OprArtCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OPrLot] = ? and T1.[OPrSLt] = ? and T1.[OprILin] = 0 ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[OPrFamCod], T1.[OprFamSubC], T1.[OprArtCod], T1.[OPrLot], T1.[OPrSLt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01122,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01122,14)
                  THISFORM.GX_DB_BindColsW01122_01 ()
                  THISFORM.GX_DB_BindParmW01122_01 ()
               ENDIF
