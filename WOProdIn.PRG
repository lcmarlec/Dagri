               THISFORM.A746OprFam = AuxA746OprFam
               AuxA747OprArt = THISFORM.A747OprArt
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01122,4,@AuxA747OprArt,0)
               THISFORM.A747OprArt = AuxA747OprArt
               AuxA748OPrLot = THISFORM.A748OPrLot
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W01122,5,@AuxA748OPrLot,0)
               THISFORM.A748OPrLot = AuxA748OPrLot
               AuxA749OPrSLt = THISFORM.A749OPrSLt
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01122,6,@AuxA749OPrSLt,0)
               THISFORM.A749OPrSLt = AuxA749OPrSLt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01122) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01122 = Gx_err
               THISFORM.GX_DB_GetW01122_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WOProdIn"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01122 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
