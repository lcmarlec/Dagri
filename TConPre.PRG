                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03658,cmdbuf)
                  THISFORM.GX_DB_BindColsT03658_01 ()
                  THISFORM.GX_DB_BindParmT03658_01 ()
               ENDIF
               AuxBuf_T03653_3430ConPreId = THISFORM.Buf_T03653_3430ConPreId
               Gx_err = GX_DB_SetInt( HStmt_T03658,1,@AuxBuf_T03653_3430ConPreId,0)
               THISFORM.Buf_T03653_3430ConPreId = AuxBuf_T03653_3430ConPreId
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03658) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03658 = Gx_err
               THISFORM.GX_DB_GetT03658_01 ()
               IF THISFORM.T03658 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03658) , "TCONPRE" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " Prestamo "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03658) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT365A3430 . ZMA5391 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCA5391 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT365A3431 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DEA5391 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DCA5391 ()
                  RETURN
               ENDIF
               THISFORM.cCT365A3430.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03653) , "TCONPRE" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03652) , "TCONPRE" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT365A3431 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT365A3430 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

