      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03655" , @HStmt_T03655 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCONPRE","T03655","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03655) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CONPRE] ([ConPreId], [ConPreDsc]) VALUES (?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03655,cmdbuf)
                  THISFORM.GX_DB_BindParmT03655_01 ()
               ENDIF
               AuxA3430ConPr = THISFORM.A3430ConPr
               Gx_err = GX_DB_SetInt( HStmt_T03655,1,@AuxA3430ConPr,0)
               THISFORM.A3430ConPr = AuxA3430ConPr
               AuxA3431ConPr = THISFORM.A3431ConPr
               Gx_err = GX_DB_SetStr( HStmt_T03655,2,AuxA3431ConPr,30,0)
               THISFORM.A3431ConPr = AuxA3431ConPr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03655) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03655 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03655) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03655 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03656" , @HStmt_T03656 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCONPRE","T03656","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03656) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [CONPRE] SET [ConPreDsc]=?  WHERE [ConPreId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03656,cmdbuf)
                  THISFORM.GX_DB_BindParmT03656_01 ()
               ENDIF
               AuxA3431ConPr = THISFORM.A3431ConPr
               Gx_err = GX_DB_SetStr( HStmt_T03656,1,AuxA3431ConPr,30,0)
               THISFORM.A3431ConPr = AuxA3431ConPr
               AuxA3430ConPr = THISFORM.A3430ConPr
               Gx_err = GX_DB_SetInt( HStmt_T03656,2,@AuxA3430ConPr,0)
               THISFORM.A3430ConPr = AuxA3430ConPr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03656) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03656 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03656) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03657" , @HStmt_T03657 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCONPRE","T03657","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03657) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CONPRE]  WHERE [ConPreId] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03657,cmdbuf)
                  THISFORM.GX_DB_BindParmT03657_01 ()
               ENDIF
               AuxA3430ConPr = THISFORM.A3430ConPr
               Gx_err = GX_DB_SetInt( HStmt_T03657,1,@AuxA3430ConPr,0)
               THISFORM.A3430ConPr = AuxA3430ConPr
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03657) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03657 = Gx_err
               THISFORM.T03652 = iif( THISFORM.T03657 = 0 , 104 , THISFORM.T03657 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03657) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A3430ConPr , 4 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "AUSE" , Aux1 , "CONPRE" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT365V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 391 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
