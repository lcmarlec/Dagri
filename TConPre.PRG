      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA3430ConPr = THISFORM.A3430ConPr
            Gx_err = GX_DB_SetInt( HStmt_T03652,1,@AuxA3430ConPr,0)
            THISFORM.A3430ConPr = AuxA3430ConPr
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03652) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03652 = Gx_err
            THISFORM.GX_DB_GetT03652_01 ()
            IF .NOT. THISFORM.T03652 <> 103
               DO GX_ERRMW WITH "CONPRE reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03652 = 101 .OR. THISFORM.Z3431ConPr <> THISFORM.Buf_T03652_3431ConPreDsc
               DO GX_ERRMW WITH "CONPRE fue modificada."
               RETURN .F.
