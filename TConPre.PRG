         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 391
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT365A3430 .SetFocus()
                  RETURN
               ENDIF
               IF THISFORM.GX_1Lvl_mode != "DLT"
                  THISFORM. cCT365A3430 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 391
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA3430ConPr = THISFORM.A3430ConPr
                  Gx_err = GX_DB_SetInt( HStmt_T03653,1,@AuxA3430ConPr,0)
                  THISFORM.A3430ConPr = AuxA3430ConPr
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03653) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T03653 = Gx_err
                  THISFORM.GX_DB_GetT03653_01 ()
                  THISFORM. cCT365A3430 . ZMA5391 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DCA5391 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03658" , @HStmt_T03658 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCONPRE","T03658","",GX_CURSOR_TYPE_READONLY,@HStmt_T03658) ,  ,  ,  , CS_SQLSRV , 0 )
