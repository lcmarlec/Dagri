      PROCEDURE CreateTemp
         LOCAL SCW45S31
         SCW45S31 = ""
         IF USED( "SCW45S31" )
            SELECT SCW45S31
            SCW45S31 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW45S31
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "VAV25Dcvim"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV26Dcvim"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 20
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV27Dcvni"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV28Dcvim"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW45S31 = GETE('z:\temp') + '\' + SCW45S31
            ENDIF
            CREATE DBF (SCW45S31) FROM ARRAY GX_STRUCT
            USE
            USE (SCW45S31) EXCLUSIVE ALIAS SCW45S31
         ENDIF
