      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00452" , @HStmt_W00452 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVVER2","W00452","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00452) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVNroInt], T1.[EmpCod], T2.[EmpVtaCie], "
                  cmdbuf = cmdbuf + "  T4.[EntLgDNro], T4.[EntLgDom] AS DcVEntLgDo, T1.[DcvCAENro], T1.[DcVTip], T1.[DcvTrNC], "
                  cmdbuf = cmdbuf + "  T1.[DcvSrNC], T1.[DcvNrNC], T1.[DcvPerNC], T1.[DcvSolNC], T1.[DcvBaIm], T1.[DcVEst], "
                  cmdbuf = cmdbuf + "  T1.[DcvTipRed], T1.[DcVTot], T1.[DcVCtaCte], T1.[DcVFv], T1.[DcVEntLgCo] AS DcVEntLgCo, "
                  cmdbuf = cmdbuf + "  T3.[EntRaz] AS DcVEntRaz, T1.[DcVEntCod] AS DcVEntCod, T1.[DcVSer], T1.[DcVSuc], "
                  cmdbuf = cmdbuf + "  T1.[DcVNro], T1.[DcVFch] FROM ((([DCVENT] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [EMPRES] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T3.[EntGruTip] = T1.[DcVEntGruT] AND T3.[EntCod] = T1.[DcVEntCod]) "
                  cmdbuf = cmdbuf + "  LEFT JOIN [CLTES] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND T4.[EntGruTip] = "
                  cmdbuf = cmdbuf + "  T1.[DcVEntGruT] AND T4.[EntCod] = T1.[DcVEntCod] AND T4.[EntLgCod] = T1.[DcVEntLgCo]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[DcVNroInt] = ?) AND (T1.[DcVNro] = ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00452,cmdbuf)
                  THISFORM.GX_DB_BindColsW00452_01 ()
                  THISFORM.GX_DB_BindParmW00452_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00452,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV24Dcvnro = THISFORM.AV24Dcvnro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00452,2,@AuxAV24Dcvnro,0)
               THISFORM.AV24Dcvnro = AuxAV24Dcvnro
               AuxAV18Dcvnro = THISFORM.AV18Dcvnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W00452,3,@AuxAV18Dcvnro,0)
               THISFORM.AV18Dcvnro = AuxAV18Dcvnro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00452) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00452 = Gx_err
               THISFORM.GX_DB_GetW00452_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV39Pgmnam = "WDVVer2"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00452 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00452) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00452 = Gx_err
                  THISFORM.GX_DB_GetW00452_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00452 <> 101
               BRKV192 = .F.
               THISFORM.AV25Dcvimp = SPACE(6)
               THISFORM.AV26Dcvimp = SPACE(20)
               THISFORM.AV27Dcvnim = SPACE(12)
               THISFORM.AV28Dcvimp = 0.00
               THISFORM.A416DcVEnt = THISFORM.Buf_W00452_416DcVEntGruT
               THISFORM.A415DcVNro = THISFORM.Buf_W00452_415DcVNroInt
               THISFORM.A2EmpCod = THISFORM.Buf_W00452_2EmpCod
               THISFORM.A1206EmpVt = THISFORM.Buf_W00452_1206EmpVtaCie
               THISFORM.A2817EntLg = THISFORM.Buf_W00452_2817EntLgDNro
               THISFORM.A420DcVEnt = THISFORM.Buf_W00452_420DcVEntLgDo
               THISFORM.A2313DcvCA = THISFORM.Buf_W00452_2313DcvCAENro
               THISFORM.A422DcVTip = THISFORM.Buf_W00452_422DcVTip
               THISFORM.A3320DcvTr = THISFORM.Buf_W00452_3320DcvTrNC
               THISFORM.A3321DcvSr = THISFORM.Buf_W00452_3321DcvSrNC
               THISFORM.A3322DcvNr = THISFORM.Buf_W00452_3322DcvNrNC
               THISFORM.A3319DcvPe = THISFORM.Buf_W00452_3319DcvPerNC
               THISFORM.A3301DcvSo = THISFORM.Buf_W00452_3301DcvSolNC
               THISFORM.A3005DcvBa = THISFORM.Buf_W00452_3005DcvBaIm
               THISFORM.A466DcVEst = THISFORM.Buf_W00452_466DcVEst
               THISFORM.A1208DcvTi = THISFORM.Buf_W00452_1208DcvTipRed
               THISFORM.A464DcVTot = THISFORM.Buf_W00452_464DcVTot
               THISFORM.A467DcVCta = THISFORM.Buf_W00452_467DcVCtaCte
               THISFORM.A465DcVFv = THISFORM.Buf_W00452_465DcVFv
               THISFORM.A419DcVEnt = THISFORM.Buf_W00452_419DcVEntLgCo
               THISFORM.A418DcVEnt = THISFORM.Buf_W00452_418DcVEntRaz
               THISFORM.A417DcVEnt = THISFORM.Buf_W00452_417DcVEntCod
               THISFORM.A423DcVSer = THISFORM.Buf_W00452_423DcVSer
               THISFORM.A424DcVSuc = THISFORM.Buf_W00452_424DcVSuc
               THISFORM.A425DcVNro = THISFORM.Buf_W00452_425DcVNro
               THISFORM.A421DcVFch = THISFORM.Buf_W00452_421DcVFch
               THISFORM.A1206EmpVt = THISFORM.Buf_W00452_1206EmpVtaCie
               THISFORM.A418DcVEnt = THISFORM.Buf_W00452_418DcVEntRaz
               THISFORM.A2817EntLg = THISFORM.Buf_W00452_2817EntLgDNro
               THISFORM.A420DcVEnt = THISFORM.Buf_W00452_420DcVEntLgDo
               GX_SFLOAD = 0
               THISFORM.U19V192 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
      ENDPROC
