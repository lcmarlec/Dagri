      PROCEDURE CreateTemp
         LOCAL SCW679S20
         SCW679S20 = ""
         IF USED( "SCW679S20" )
            SELECT SCW679S20
            SCW679S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW679S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA354DcCRO"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA359DcCRO"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3FamCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA4FamSubC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA5ArtCod"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW679S20 = GETE('z:\temp') + '\' + SCW679S20
            ENDIF
            CREATE DBF (SCW679S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW679S20) EXCLUSIVE ALIAS SCW679S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW679S20
         THIS.GX_SfAlias = "SCW679S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06792" , @HStmt_W06792 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00Z2","W06792","",GX_CURSOR_TYPE_READONLY,@HStmt_W06792) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DcCNroInt], [ArtCod], [FamSubCod], [FamCod], [DcCRORLin], [DcCRORNroI] "
                  cmdbuf = cmdbuf + "  FROM [DCCOM2] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [DcCNroInt] = ? and "
                  cmdbuf = cmdbuf + "  [DcCRORNroI] >= ? and [DcCRORLin] >= ?) AND ([FamCod] >= ?) AND ([FamSubCod] >= "
                  cmdbuf = cmdbuf + "  ?) AND ([ArtCod] >= ?) ORDER BY [EmpCod], [DcCNroInt], [DcCRORNroI], [DcCRORLin] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06792,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06792,9)
                  THISFORM.GX_DB_BindColsW06792_01 ()
                  THISFORM.GX_DB_BindParmW06792_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06792,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06792,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               AuxAV5C354 = THISFORM.AV5C354
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W06792,3,@AuxAV5C354,0)
               THISFORM.AV5C354 = AuxAV5C354
               AuxAV6C359 = THISFORM.AV6C359
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06792,4,@AuxAV6C359,0)
               THISFORM.AV6C359 = AuxAV6C359
               AuxAV7C3 = THISFORM.AV7C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06792,5,@AuxAV7C3,0)
               THISFORM.AV7C3 = AuxAV7C3
               AuxAV8C4 = THISFORM.AV8C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06792,6,@AuxAV8C4,0)
               THISFORM.AV8C4 = AuxAV8C4
               AuxAV9C5 = THISFORM.AV9C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06792,7,@AuxAV9C5,0)
               THISFORM.AV9C5 = AuxAV9C5
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06792 = Gx_err
               THISFORM.GX_DB_GetW06792_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06792 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06792) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06792 = Gx_err
                  THISFORM.GX_DB_GetW06792_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06792 <> 101
               BRKVIV2 = .F.
               THISFORM.A5ArtCod = THISFORM.Buf_W06792_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W06792_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W06792_3FamCod
               THISFORM.A359DcCROR = THISFORM.Buf_W06792_359DcCRORLin
               THISFORM.A354DcCROR = THISFORM.Buf_W06792_354DcCRORNroI
               GX_SFLOAD = 0
               THISFORM.U12VIV2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06792) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06792 = Gx_err
               THISFORM.GX_DB_GetW06792_01 ()
            ENDDO
         ENDIF
      ENDPROC
