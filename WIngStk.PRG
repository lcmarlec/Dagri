      ***********************
      PROCEDURE cCW990V8.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW990V8.ISVALID" )
         THISFORM.AV32GXLvl3 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09903" , @HStmt_W09903 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WINGSTK","W09903","",GX_CURSOR_TYPE_READONLY,@HStmt_W09903) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[RILin], T1.[RINroInt], T3.[RILugHta] AS RILugHta, T1.[RicntIng], T1.[RICnt], "
            cmdbuf = cmdbuf + "  T1.[ArtCod], T2.[ArtCodBar], T2.[ArtDsc], T1.[FamCod], T1.[FamSubCod], T1.[RiLotFch], "
            cmdbuf = cmdbuf + "  T1.[RiLotNro], T1.[RiLotVnc], T4.[LugDsc] AS RiLugHtaD, T1.[RITraz], T1.[EmpCod] "
            cmdbuf = cmdbuf + "  FROM ((([REMINT1] T1 (NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
            cmdbuf = cmdbuf + "  AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] "
            cmdbuf = cmdbuf + "  = T1.[ArtCod]) LEFT JOIN [REMINT] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[RINroInt] "
            cmdbuf = cmdbuf + "  = T1.[RINroInt]) LEFT JOIN [LUGALM] T4 (NOLOCK) ON T4.[EmpCod] = T1.[EmpCod] AND "
            cmdbuf = cmdbuf + "  T4.[LugCod] = T3.[RILugHta]) WHERE (T1.[EmpCod] = ? and T1.[RITraz] = ?) AND (T1.[RICnt] "
            cmdbuf = cmdbuf + "  > T1.[RicntIng]) ORDER BY T1.[EmpCod], T1.[RITraz]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09903,cmdbuf)
            THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09903,100)
            THISFORM.GX_DB_BindColsW09903_01 ()
            THISFORM.GX_DB_BindParmW09903_01 ()
         ENDIF
         AuxAV10Emprco = THISFORM.AV10Emprco
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09903,1,@AuxAV10Emprco,0)
         THISFORM.AV10Emprco = AuxAV10Emprco
         AuxAV8Ritraz = THISFORM.AV8Ritraz
         THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09903,2,AuxAV8Ritraz,15,0)
         THISFORM.AV8Ritraz = AuxAV8Ritraz
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09903) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W09903 = Gx_err
         THISFORM.GX_DB_GetW09903_01 ()
         DO WHILE THISFORM.W09903 <> 101
            THISFORM.A1306RINro = THISFORM.Buf_W09903_1306RINroInt
            THISFORM.A1314RILug = THISFORM.Buf_W09903_1314RILugHta
            THISFORM.A3002Ricnt = THISFORM.Buf_W09903_3002RicntIng
            THISFORM.A1321RICnt = THISFORM.Buf_W09903_1321RICnt
            THISFORM.A5ArtCod = THISFORM.Buf_W09903_5ArtCod
            THISFORM.A1464ArtCo = THISFORM.Buf_W09903_1464ArtCodBar
            THISFORM.A6ArtDsc = THISFORM.Buf_W09903_6ArtDsc
            THISFORM.A3FamCod = THISFORM.Buf_W09903_3FamCod
            THISFORM.A4FamSubCo = THISFORM.Buf_W09903_4FamSubCod
            THISFORM.A1482RiLot = THISFORM.Buf_W09903_1482RiLotFch
            THISFORM.A1481RiLot = THISFORM.Buf_W09903_1481RiLotNro
            THISFORM.A1483RiLot = THISFORM.Buf_W09903_1483RiLotVnc
            THISFORM.A1315RiLug = THISFORM.Buf_W09903_1315RiLugHtaD
            THISFORM.A3000RITra = THISFORM.Buf_W09903_3000RITraz
            THISFORM.A2EmpCod = THISFORM.Buf_W09903_2EmpCod
            THISFORM.A1464ArtCo = THISFORM.Buf_W09903_1464ArtCodBar
            THISFORM.A6ArtDsc = THISFORM.Buf_W09903_6ArtDsc
            THISFORM.A1314RILug = THISFORM.Buf_W09903_1314RILugHta
            THISFORM.A1315RiLug = THISFORM.Buf_W09903_1315RiLugHtaD
            THISFORM.AV32GXLvl3 = 1
            THISFORM.AV21Artcod = THISFORM.A5ArtCod
            THISFORM.AV17Artcod = THISFORM.A1464ArtCo
            THISFORM.AV18Artdsc = THISFORM.A6ArtDsc
            THISFORM.AV20Famcod = THISFORM.A3FamCod
            THISFORM.AV19Famsub = THISFORM.A4FamSubCo
            THISFORM.AV23Rilotf = THISFORM.A1482RiLot
            THISFORM.AV22Rilotn = THISFORM.A1481RiLot
            THISFORM.AV24Rilotv = THISFORM.A1483RiLot
            THISFORM.AV25Rilugh = THISFORM.A1315RiLug
            THISFORM.AV15Cantid = THISFORM.A1321RICnt - THISFORM.A3002Ricnt
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09903) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W09903 = Gx_err
            THISFORM.GX_DB_GetW09903_01 ()
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W09903) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV32GXLvl3 = 0
            THISFORM.Refresh()
            DO GX_ERRMW WITH "No encontrado"
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
      ENDPROC

