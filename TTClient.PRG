      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02206" , @HStmt_T02206 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTCLIENT","T02206","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02206) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [TCLIENTE] ([EmpCod], [TcliNI], [TEntGruTip], [TEntCod], [TEntTLprc]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02206,cmdbuf)
                  THISFORM.GX_DB_BindParmT02206_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
