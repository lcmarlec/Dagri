               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02207" , @HStmt_T02207 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTCLIENT","T02207","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02207) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [TCLIENTE] SET [TEntTLprc]=?  WHERE [EmpCod] = ? AND [TcliNI] = ? AND [TEntGruTip] "
                  cmdbuf = cmdbuf + "  = ? AND [TEntCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02207,cmdbuf)
                  THISFORM.GX_DB_BindParmT02207_01 ()
               ENDIF
               AuxA2129TEntT = THISFORM.A2129TEntT
               Gx_err = GX_DB_SetStr( HStmt_T02207,1,AuxA2129TEntT,2,0)
