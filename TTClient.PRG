               THISFORM.A2129TEntT = AuxA2129TEntT
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02206) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02206 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02206) ,  ,  ,  , CS_SQLSRV , 0 )
