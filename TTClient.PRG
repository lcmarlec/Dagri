               AuxA2126TEntG = THISFORM.A2126TEntG
               Gx_err = GX_DB_SetStr( HStmt_T02207,4,AuxA2126TEntG,2,0)
               THISFORM.A2126TEntG = AuxA2126TEntG
               AuxA2127TEntC = THISFORM.A2127TEntC
               Gx_err = GX_DB_SetLong( HStmt_T02207,5,@AuxA2127TEntC,0)
               THISFORM.A2127TEntC = AuxA2127TEntC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02207) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02207 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02207) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02208" , @HStmt_T02208 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTCLIENT","T02208","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T02208) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [TCLIENTE]  WHERE [EmpCod] = ? AND [TcliNI] = ? AND [TEntGruTip] = ? "
                  cmdbuf = cmdbuf + "  AND [TEntCod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02208,cmdbuf)
                  THISFORM.GX_DB_BindParmT02208_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T02208,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2141TcliN = THISFORM.A2141TcliN
