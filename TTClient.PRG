               Gx_err = GX_DB_SetLong( HStmt_T02208,4,@AuxA2127TEntC,0)
               THISFORM.A2127TEntC = AuxA2127TEntC
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T02208) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02208 = Gx_err
               THISFORM.T02202 = iif( THISFORM.T02208 = 0 , 104 , THISFORM.T02208 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02208) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
