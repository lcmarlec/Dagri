                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01232,17)
                  THISFORM.GX_DB_BindColsW01232_01 ()
                  THISFORM.GX_DB_BindParmW01232_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01232,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01232 = Gx_err
               THISFORM.GX_DB_GetW01232_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV43Pgmnam = "WPedLis"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01232 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01232) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01232 = Gx_err
                  THISFORM.GX_DB_GetW01232_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01232 <> 101
               BRKV3F2 = .F.
               THISFORM.AV22Imprim = SPACE(1)
               THISFORM.A966RutCod = THISFORM.Buf_W01232_966RutCod
               GX_SFLOAD = 0
               THISFORM.U18V3F2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01232) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01232 = Gx_err
               THISFORM.GX_DB_GetW01232_01 ()
            ENDDO
         ENDIF
      ENDPROC
