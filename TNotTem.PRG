      ***********************
      FUNCTION MV
      ***********************

         PARAMETERS GXOP
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02654" , @HStmt_T02654 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNOTTEM","T02654","",GX_CURSOR_TYPE_READONLY,@HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [NotTemCod], [NotTemDsc] FROM [NOTTEM] (FASTFIRSTROW NOLOCK) WHERE [NotTemCod] "
            cmdbuf = cmdbuf + "  >= ? ORDER BY [NotTemCod]  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T02654,cmdbuf)
            Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T02654,100)
            THISFORM.GX_DB_BindColsT02654_01 ()
            THISFORM.GX_DB_BindParmT02654_01 ()
         ENDIF
         GX_MVRC = 0
         DO CASE
            CASE GXOP = 1 .OR. GXOP = 5 && Top of file | First Greater or Equal
               IF GXOP = 1 && Top of file
                  THISFORM.A2603NotTe = 0
               ENDIF
               AuxA2603NotTe = THISFORM.A2603NotTe
               Gx_err = GX_DB_SetLong( HStmt_T02654,1,@AuxA2603NotTe,0)
               THISFORM.A2603NotTe = AuxA2603NotTe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02654 = Gx_err
               THISFORM.GX_DB_GetT02654_01 ()
               Gx_fcond = THISFORM.T02654 <> 101
            CASE GXOP = 2 && Next record
               AuxA2603NotTe = THISFORM.A2603NotTe
               Gx_err = GX_DB_SetLong( HStmt_T02654,1,@AuxA2603NotTe,0)
               THISFORM.A2603NotTe = AuxA2603NotTe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02654 = Gx_err
               THISFORM.GX_DB_GetT02654_01 ()
               DO WHILE THISFORM.T02654 = 0 .AND. THISFORM.A2603NotTe >= THISFORM.Buf_T02654_2603NotTemCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02654 = Gx_err
                  THISFORM.GX_DB_GetT02654_01 ()
               ENDDO
               Gx_fcond = THISFORM.T02654 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A2603NotTe = 0
               AuxA2603NotTe = THISFORM.A2603NotTe
               Gx_err = GX_DB_SetLong( HStmt_T02654,1,@AuxA2603NotTe,0)
               THISFORM.A2603NotTe = AuxA2603NotTe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02654 = Gx_err
               THISFORM.GX_DB_GetT02654_01 ()
               DO WHILE THISFORM.T02654 = 0
                  THISFORM.A2603NotTe = THISFORM.Buf_T02654_2603NotTemCod
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T02654 = Gx_err
                  THISFORM.GX_DB_GetT02654_01 ()
               ENDDO
               AuxA2603NotTe = THISFORM.A2603NotTe
               Gx_err = GX_DB_SetLong( HStmt_T02654,1,@AuxA2603NotTe,0)
               THISFORM.A2603NotTe = AuxA2603NotTe
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02654) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02654 = Gx_err
               THISFORM.GX_DB_GetT02654_01 ()
            CASE GXOP = 6 && Get cursor fields
               THISFORM.A2603NotTe = THISFORM.Buf_T02654_2603NotTemCod
               THISFORM.A2604NotTe = THISFORM.Buf_T02654_2604NotTemDsc
         ENDCASE
         Gx_fcond = THISFORM.T02654 <> 101 .AND. THISFORM.T02654 <> 101
         IF .NOT. Gx_fcond
            GX_MVRC = 101
         ELSE
         ENDIF
      RETURN GX_MVRC

