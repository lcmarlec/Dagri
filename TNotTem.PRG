                  THISFORM.GX_DB_BindParmT02658_01 ()
               ENDIF
               AuxBuf_T02653_2603NotTemCod = THISFORM.Buf_T02653_2603NotTemCod
               Gx_err = GX_DB_SetLong( HStmt_T02658,1,@AuxBuf_T02653_2603NotTemCod,0)
               THISFORM.Buf_T02653_2603NotTemCod = AuxBuf_T02653_2603NotTemCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02658) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T02658 = Gx_err
               THISFORM.GX_DB_GetT02658_01 ()
               IF THISFORM.T02658 <> 101
                  THISFORM.SaveMode( "UPD" ,"")
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02658) , "TNOTTEM" )
                  DO GX_ERRMW WITH "Eliminacion invalida, hay informacion en" + " Notas Cabecera "
                  RETURN .F.
               ENDIF
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T02658) ,  ,  ,  , CS_SQLSRV , 0 )
               IF Gx_open
               ENDIF
               THISFORM. cCT265A2603 . ZM7D295 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC7D295 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT265A2604 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE7D295 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC7D295 ()
                  RETURN
               ENDIF
               THISFORM.cCT265A2603.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02653) , "TNOTTEM" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T02652) , "TNOTTEM" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT265A2604 .AfterTrn()
                  THISFORM.ReleaseAll()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT265A2603 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
