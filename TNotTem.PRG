                  THISFORM. cCT265A2603 . ZM7D295 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC7D295 ()
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T02658" , @HStmt_T02658 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNOTTEM","T02658","",GX_CURSOR_TYPE_READONLY,@HStmt_T02658) ,  ,  ,  , CS_SQLSRV , 0 )
