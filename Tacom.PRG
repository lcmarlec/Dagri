            THISFORM.T02262 = Gx_err
            THISFORM.GX_DB_GetT02262_01 ()
            IF .NOT. THISFORM.T02262 <> 103
               DO GX_ERRMW WITH "ACOM reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02262 = 101 .OR. THISFORM.Z2200acoNo <> THISFORM.Buf_T02262_2200acoNom
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z2209acoRe <> THISFORM.Buf_T02262_2209acoRegVto
