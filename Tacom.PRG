               Gx_err = GX_DB_SetStr( HStmt_T02266,6,AuxA2203acoOb,40,0)
               THISFORM.A2203acoOb = AuxA2203acoOb
               AuxA2204acoCu = THISFORM.A2204acoCu
               Gx_err = GX_DB_SetDouble( HStmt_T02266,7,@AuxA2204acoCu,0)
               THISFORM.A2204acoCu = AuxA2204acoCu
               AuxA2209acoRe = THISFORM.A2209acoRe
