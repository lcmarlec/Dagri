                  cmdbuf = cmdbuf + "  [ENTRCHQ] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [AuxCod] >= ?) AND ([AuxNom] "
                  cmdbuf = cmdbuf + "  like ?) AND ([AuxDir] like ?) AND ([AuxTel] >= ?) AND ([auxcuit] >= ?) AND ([AuxObs] "
                  cmdbuf = cmdbuf + "  like ?) ORDER BY [EmpCod], [AuxCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06642,cmdbuf)
