               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06642,7,PADR( TRIM(THISFORM.AV10C1997),50, '%'),LEN(PADR( TRIM(THISFORM.AV10C1997),50, '%')),0)
               Gx_eop = 1
