      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09472" , @HStmt_W09472 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPERCOMF","W09472","",GX_CURSOR_TYPE_READONLY,@HStmt_W09472) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EntGruTip], T1.[EmpCod], T1.[DcCTot], T1.[DcCNro], T1.[DcCSuc], T1.[DccSer], "
                  cmdbuf = cmdbuf + "  T1.[DccTipRed], T1.[DcCFec], T1.[DcCNroInt], T1.[EntCod], T2.[EntRaz] FROM ([DCCOM] "
                  cmdbuf = cmdbuf + "  T1 (NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[EntCod] "
                  cmdbuf = cmdbuf + "  = ?) ORDER BY T1.[EmpCod], T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09472,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09472,5)
                  THISFORM.GX_DB_BindColsW09472_01 ()
                  THISFORM.GX_DB_BindParmW09472_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09472,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV24Entcod = THISFORM.AV24Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09472,2,@AuxAV24Entcod,0)
               THISFORM.AV24Entcod = AuxAV24Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09472) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09472 = Gx_err
               THISFORM.GX_DB_GetW09472_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WPerComF"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09472 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09472) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09472 = Gx_err
                  THISFORM.GX_DB_GetW09472_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09472 <> 101
               BRKVQB3 = .F.
               THISFORM.AV22Sel = 0
               THISFORM.A150EntGru = THISFORM.Buf_W09472_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W09472_2EmpCod
               THISFORM.A371DcCTot = THISFORM.Buf_W09472_371DcCTot
               THISFORM.A352DcCNro = THISFORM.Buf_W09472_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W09472_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W09472_349DccSer
               THISFORM.A1322DccTi = THISFORM.Buf_W09472_1322DccTipRed
               THISFORM.A347DcCFec = THISFORM.Buf_W09472_347DcCFec
               THISFORM.A346DcCNro = THISFORM.Buf_W09472_346DcCNroInt
               THISFORM.A120EntCod = THISFORM.Buf_W09472_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W09472_153EntRaz
               THISFORM.A153EntRaz = THISFORM.Buf_W09472_153EntRaz
               GX_SFLOAD = 0
               THISFORM.cCW947S32.Load ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09472) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09472 = Gx_err
               THISFORM.GX_DB_GetW09472_01 ()
            ENDDO
         ENDIF
