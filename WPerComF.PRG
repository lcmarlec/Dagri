      PROCEDURE CreateTemp
         LOCAL SCW947S23
         SCW947S23 = ""
         IF USED( "SCW947S23" )
            SELECT SCW947S23
            SCW947S23 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW947S23
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "sA2885PCDC"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2886PCDC"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2887PCDC"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2888PCDC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2889PCDC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 9
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2890PCDC"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 12
            GX_STRUCT[ 6 ,4]= 2

            GX_STRUCT[ 7 ,1]= "sA2884PCDC"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW947S23 = GETE('z:\temp') + '\' + SCW947S23
            ENDIF
            CREATE DBF (SCW947S23) FROM ARRAY GX_STRUCT
            USE
            USE (SCW947S23) EXCLUSIVE ALIAS SCW947S23
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW947S23
         THIS.GX_SfAlias = "SCW947S23"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09473" , @HStmt_W09473 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPERCOMF","W09473","",GX_CURSOR_TYPE_READONLY,@HStmt_W09473) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PCNroInt], T3.[EntCod], T3.[DcCTot] AS PCDCTot, T3.[DcCNro] "
                  cmdbuf = cmdbuf + "  AS PCDCNro, T3.[DcCSuc] AS PCDCSuc, T3.[DccSer] AS PCDCSer, T3.[DccTipRed] AS PCDCTpo, "
                  cmdbuf = cmdbuf + "  T3.[DcCFec] AS PCDCFch, T1.[PCDCNI] AS PCDCNI, T2.[PCFch], T2.[PCNro], T2.[PCtotal] "
                  cmdbuf = cmdbuf + "  FROM (([PCFAC] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [PERCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[PCNroInt] = T1.[PCNroInt]) LEFT JOIN [DCCOM] T3 (NOLOCK) ON "
                  cmdbuf = cmdbuf + "  T3.[EmpCod] = T1.[EmpCod] AND T3.[DcCNroInt] = T1.[PCDCNI]) WHERE (T1.[EmpCod] = "
                  cmdbuf = cmdbuf + "  ? and T1.[PCNroInt] = ?) AND (T2.[EntCod] = ?) ORDER BY T1.[EmpCod], T1.[PCNroInt], "
                  cmdbuf = cmdbuf + "  T1.[PCDCNI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09473,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09473,5)
                  THISFORM.GX_DB_BindColsW09473_01 ()
                  THISFORM.GX_DB_BindParmW09473_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09473,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Pcnroi = THISFORM.AV19Pcnroi
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09473,2,@AuxAV19Pcnroi,0)
               THISFORM.AV19Pcnroi = AuxAV19Pcnroi
               AuxAV24Entcod = THISFORM.AV24Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W09473,3,@AuxAV24Entcod,0)
               THISFORM.AV24Entcod = AuxAV24Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09473) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09473 = Gx_err
               THISFORM.GX_DB_GetW09473_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WPerComF"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09473 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09473) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09473 = Gx_err
                  THISFORM.GX_DB_GetW09473_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09473 <> 101
               BRKVQB2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W09473_2EmpCod
               THISFORM.A2870PCNro = THISFORM.Buf_W09473_2870PCNroInt
               THISFORM.A120EntCod = THISFORM.Buf_W09473_120EntCod
               THISFORM.A2890PCDCT = THISFORM.Buf_W09473_2890PCDCTot
               THISFORM.A2889PCDCN = THISFORM.Buf_W09473_2889PCDCNro
               THISFORM.A2888PCDCS = THISFORM.Buf_W09473_2888PCDCSuc
               THISFORM.A2887PCDCS = THISFORM.Buf_W09473_2887PCDCSer
               THISFORM.A2886PCDCT = THISFORM.Buf_W09473_2886PCDCTpo
               THISFORM.A2885PCDCF = THISFORM.Buf_W09473_2885PCDCFch
               THISFORM.A2884PCDCN = THISFORM.Buf_W09473_2884PCDCNI
               THISFORM.A2871PCFch = THISFORM.Buf_W09473_2871PCFch
               THISFORM.A2872PCNro = THISFORM.Buf_W09473_2872PCNro
               THISFORM.A2873PCtot = THISFORM.Buf_W09473_2873PCtotal
               THISFORM.A2871PCFch = THISFORM.Buf_W09473_2871PCFch
               THISFORM.A2872PCNro = THISFORM.Buf_W09473_2872PCNro
               THISFORM.A2873PCtot = THISFORM.Buf_W09473_2873PCtotal
               THISFORM.A120EntCod = THISFORM.Buf_W09473_120EntCod
               THISFORM.A2890PCDCT = THISFORM.Buf_W09473_2890PCDCTot
               THISFORM.A2889PCDCN = THISFORM.Buf_W09473_2889PCDCNro
               THISFORM.A2888PCDCS = THISFORM.Buf_W09473_2888PCDCSuc
               THISFORM.A2887PCDCS = THISFORM.Buf_W09473_2887PCDCSer
               THISFORM.A2886PCDCT = THISFORM.Buf_W09473_2886PCDCTpo
               THISFORM.A2885PCDCF = THISFORM.Buf_W09473_2885PCDCFch
               GX_SFLOAD = 0
               THISFORM.cCW947S23.Load ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09473) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09473 = Gx_err
               THISFORM.GX_DB_GetW09473_01 ()
            ENDDO
         ENDIF
      ENDPROC
