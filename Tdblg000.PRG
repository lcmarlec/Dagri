                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T00294) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00294 = Gx_err
                  THISFORM.GX_DB_GetT00294_01 ()
               ENDDO
               Gx_fcond = THISFORM.T00294 <> 101
            CASE GXOP = 3 && Previous record
            CASE GXOP = 4 && Last record
               THISFORM.A272LGCodc = 0
               THISFORM.A273LGCodL = 0
               AuxA272LGCodc = THISFORM.A272LGCodc
               Gx_err = GX_DB_SetLong( HStmt_T00294,1,@AuxA272LGCodc,0)
