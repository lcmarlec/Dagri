               THISFORM.A273LGCodL = 0
               AuxA272LGCodc = THISFORM.A272LGCodc
               Gx_err = GX_DB_SetLong( HStmt_T00294,1,@AuxA272LGCodc,0)
               THISFORM.A272LGCodc = AuxA272LGCodc
               AuxA273LGCodL = THISFORM.A273LGCodL
               Gx_err = GX_DB_SetInt( HStmt_T00294,2,@AuxA273LGCodL,0)
               THISFORM.A273LGCodL = AuxA273LGCodL
