                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00294) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T00294 = Gx_err
               THISFORM.GX_DB_GetT00294_01 ()
               THISFORM.A273LGCodL = M273LGCodL
               DO WHILE THISFORM.T00294 = 0 .AND. THISFORM.A272LGCodc >= THISFORM.Buf_T00294_272LGCodcli .AND. THISFORM.A273LGCodL >= THISFORM.Buf_T00294_273LGCodLug
