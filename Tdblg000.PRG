      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 26
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT29A272 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 26
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA272LGCodc = THISFORM.A272LGCodc
                  Gx_err = GX_DB_SetLong( HStmt_T00293,1,@AuxA272LGCodc,0)
                  THISFORM.A272LGCodc = AuxA272LGCodc
                  AuxA273LGCodL = THISFORM.A273LGCodL
                  Gx_err = GX_DB_SetInt( HStmt_T00293,2,@AuxA273LGCodL,0)
                  THISFORM.A273LGCodL = AuxA273LGCodL
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00293) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00293 = Gx_err
                  THISFORM.GX_DB_GetT00293_01 ()
                  THISFORM. cCT29A273 . ZM0T26 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0T26 ()
               THISFORM. cCT29A273 . ZM0T26 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0T26 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT29A276 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0T26 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0T26 ()
                  RETURN
               ENDIF
               THISFORM.cCT29A273.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00293) , "TDBLG000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00292) , "TDBLG000" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT29A276 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT29A272 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
