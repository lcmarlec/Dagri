      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         THISFORM. GXInLvl15 = .T.
         IF THISFORM.GX_last_fld_lvl = 15
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 15
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 15 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01703) , "TOBSENTI" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T01702) , "TOBSENTI" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT170A1734 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
               CASE THISFORM.GX_Mode = "DLT"
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 15
            CGXTextBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
         ENDIF
         IF THISFORM. gx_15insert
            THISFORM. gx_15insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 15 )
            THISFORM. cCT170A120 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 15
            THISFORM.SetLevel( 15 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT170V7 .InitLevel( 15 )
            THISFORM.GX_last_fld_lvl = 15
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
