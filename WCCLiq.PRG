      PROCEDURE GXReposSf
         IF .T.;
            .and. EMPTY( THISFORM.AV103Ccimp ) ;
            .and. EMPTY( THISFORM.AV57Ccimp ) ;
            .and. EMPTY( THISFORM.AV57Ccimp ) ;
            .and. EMPTY( THISFORM.AV97Ccchqn ) ;
            .and. EMPTY( THISFORM.AV58Ccchqn ) ;
            .and. EMPTY( THISFORM.AV58Ccchqn ) ;
            .and. EMPTY( THISFORM.AV106Ccrcv ) ;
            .and. EMPTY( THISFORM.AV64Ccrcvn ) ;
            .and. EMPTY( THISFORM.AV64Ccrcvn ) ;
            .and. EMPTY( THISFORM.AV96Ccchqn ) ;
            .and. EMPTY( THISFORM.AV73Ccchqn ) ;
            .and. EMPTY( THISFORM.AV73Ccchqn ) ;
            .and. EMPTY( THISFORM.AV98Ccentc ) ;
            .and. EMPTY( THISFORM.AV74Ccentc ) ;
            .and. EMPTY( THISFORM.AV74Ccentc ) ;
            .and. .T.
            RETURN
         ENDIF
         SELECT ( THISFORM.cCW646S54 .GX_SfAlias)
         THISFORM.cCW646S54 .SF(8)
         LOCATE FOR ( VAV103Ccim >= THISFORM.AV57Ccimp .AND. THISFORM.AV57Ccimp <> 0 ) .OR. ( val( VAV97Ccchq ) >= THISFORM.AV58Ccchqn .AND. THISFORM.AV58Ccchqn <> 0 ) .OR. ( VAV106Ccrc >= THISFORM.AV64Ccrcvn .AND. THISFORM.AV64Ccrcvn > 0 ) .OR. ( VAV96Ccchq >= THISFORM.AV73Ccchqn .AND. THISFORM.AV73Ccchqn <> 0 ) .OR. ( VAV98Ccent >= THISFORM.AV74Ccentc .AND. THISFORM.AV74Ccentc <> 0 )
         IF EOF()
            GX_SFERR = 0
            IF RECCOUNT() = 0
               THISFORM.cCW646S54 .LoadRec(1, @GX_SFERR)
            ELSE
               THISFORM.cCW646S54 .LoadRec(2, @GX_SFERR)
            ENDIF
            SELECT ( THISFORM.cCW646S54 .GX_SfAlias)
            DO WHILE GX_SFERR = 0 .AND. .NOT. ( ( VAV103Ccim >= THISFORM.AV57Ccimp .AND. THISFORM.AV57Ccimp <> 0 ) .OR. ( val( VAV97Ccchq ) >= THISFORM.AV58Ccchqn .AND. THISFORM.AV58Ccchqn <> 0 ) .OR. ( VAV106Ccrc >= THISFORM.AV64Ccrcvn .AND. THISFORM.AV64Ccrcvn > 0 ) .OR. ( VAV96Ccchq >= THISFORM.AV73Ccchqn .AND. THISFORM.AV73Ccchqn <> 0 ) .OR. ( VAV98Ccent >= THISFORM.AV74Ccentc .AND. THISFORM.AV74Ccentc <> 0 ) )
               * Load Next Record in SubFile
               THISFORM.cCW646S54 .LoadRec(2, @GX_SFERR)
               SELECT ( THISFORM.cCW646S54 .GX_SfAlias)
            ENDDO
            IF EOF()
               SELECT(THISFORM. cCW646S54 .GX_SfAlias)
               IF EOF()
                  DO GX_MSGW WITH "No hay registros que cumplan la condicion"
               ELSE
                  IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
                     DO GX_MSGW WITH ""
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
         SELECT ( THISFORM.cCW646S54 .GX_SfAlias)
         THISFORM.cCW646S54 .SF(3)
         gxO_Rec = IIF( EOF(), 0, RECNO())
         THISFORM.cCW646S54 .Refresh()
         IF gxO_Rec != 0 .and. gxO_Rec <= RECCOUNT()
            GOTO (gxO_Rec)
            THISFORM. cCW646S54 .GX_need_load = .T.
            THISFORM. cCW646S54 .LoadGridRows()
            GOTO (gxO_Rec)
         ENDIF
         THISFORM. cCW646S54 .GXSetRepos( .F. )
      ENDPROC
