      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") != "N"
            PUBLIC GX_DSID
         ENDIF
         GX_DSID = THISFORM.DataSessionId
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         DO GX_CSC01
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03632" , @HStmt_T03632 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCARPED","T03632","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03632) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [CarPedCar], [CarPedFch], [CarPedGruT], [CarPedEnt], [CarpedSuc], "
            cmdbuf = cmdbuf + "  [CarPedSec], [CarPedInd], [FamCod], [FamSubCod], [ArtCod], [CArriTraz], [CarCarFch], "
            cmdbuf = cmdbuf + "  [CarClte], [CarPedCnt], [CarPedEst], [CarPedPik], [CarPedNro], [CarArtDsc], [CarPedCEn] "
            cmdbuf = cmdbuf + "  FROM [CARPED2] (UPDLOCK) WHERE [EmpCod] = ? AND [CarPedCar] = ? AND [CarPedFch] "
            cmdbuf = cmdbuf + "  = ? AND [CarPedGruT] = ? AND [CarPedEnt] = ? AND [CarpedSuc] = ? AND [CarPedSec] "
            cmdbuf = cmdbuf + "  = ? AND [CarPedInd] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] = ? AND "
            cmdbuf = cmdbuf + "  [CArriTraz] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03632,cmdbuf)
            THISFORM.GX_DB_BindColsT03632_01 ()
            THISFORM.GX_DB_BindParmT03632_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03633" , @HStmt_T03633 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCARPED","T03633","",GX_CURSOR_TYPE_READONLY,@HStmt_T03633) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod], [CarPedCar], [CarPedFch], [CarPedGruT], [CarPedEnt], [CarpedSuc], "
            cmdbuf = cmdbuf + "  [CarPedSec], [CarPedInd], [FamCod], [FamSubCod], [ArtCod], [CArriTraz], [CarCarFch], "
            cmdbuf = cmdbuf + "  [CarClte], [CarPedCnt], [CarPedEst], [CarPedPik], [CarPedNro], [CarArtDsc], [CarPedCEn] "
            cmdbuf = cmdbuf + "  FROM [CARPED2] (NOLOCK) WHERE [EmpCod] = ? AND [CarPedCar] = ? AND [CarPedFch] = "
            cmdbuf = cmdbuf + "  ? AND [CarPedGruT] = ? AND [CarPedEnt] = ? AND [CarpedSuc] = ? AND [CarPedSec] = "
            cmdbuf = cmdbuf + "  ? AND [CarPedInd] = ? AND [FamCod] = ? AND [FamSubCod] = ? AND [ArtCod] = ? AND "
            cmdbuf = cmdbuf + "  [CArriTraz] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03633,cmdbuf)
            THISFORM.GX_DB_BindColsT03633_01 ()
            THISFORM.GX_DB_BindParmT03633_01 ()
         ENDIF
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03634" , @HStmt_T03634 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCARPED","T03634","",GX_CURSOR_TYPE_READONLY,@HStmt_T03634) ,  ,  ,  , CS_SQLSRV , 0 )
            cmdbuf = " SELECT [EmpCod] FROM [ARTICS] (NOLOCK) WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] "
            cmdbuf = cmdbuf + "  = ? AND [ArtCod] = ?  "
            Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03634,cmdbuf)
            THISFORM.GX_DB_BindColsT03634_01 ()
            THISFORM.GX_DB_BindParmT03634_01 ()
