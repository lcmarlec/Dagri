         IF  THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A950RetNro"
            THISFORM. cCT96S54.Columns(1).Ctrl1 .RefreshSfAtt()
         ENDIF
