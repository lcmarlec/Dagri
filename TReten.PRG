      PROCEDURE CreateTemp
         LOCAL SCT96S54
         SCT96S54 = ""
         IF USED( "SCT96S54" )
            SELECT SCT96S54
            SCT96S54 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCT96S54
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 9 , 4]

            GX_STRUCT[ 1 ,1]= "sA950RetNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA951RetNr"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 12
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA952RetTi"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA953RetSe"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA954RetSu"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 5
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA955RetNr"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 9
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA956RetIm"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 12
            GX_STRUCT[ 7 ,4]= 2

            GX_STRUCT[ 8 ,1]= "sA3439RetI"
            GX_STRUCT[ 8 ,2]= "N"
            GX_STRUCT[ 8 ,3]= 12
            GX_STRUCT[ 8 ,4]= 2

            GX_STRUCT[ 9 ,1]= "sA957RetSi"
            GX_STRUCT[ 9 ,2]= "N"
            GX_STRUCT[ 9 ,3]= 2
            GX_STRUCT[ 9 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT96S54 = GETE('z:\temp') + '\' + SCT96S54
            ENDIF
            CREATE DBF (SCT96S54) FROM ARRAY GX_STRUCT
            USE
            USE (SCT96S54) EXCLUSIVE ALIAS SCT96S54
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT96S54
         THIS.GX_SfAlias = "SCT96S54"
      ENDPROC
