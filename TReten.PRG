         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A956RetImp"
            THISFORM.A956RetImp = THISFORM.Buf_T009616_956RetImpImp
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A3439RetIm"
            THISFORM.A3439RetIm = THISFORM.Buf_T009616_3439RetImpBas
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A957RetSig"
