      PROCEDURE DoNext
         LOCAL GXO_Area, gxO_Rec, GX_MVErr, GX_1stLvl
         GX_MVErr = 1
         GXO_Area = SELECT()
         gxO_Rec = 0
         GX_1stLvl = .F.
