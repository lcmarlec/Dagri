         DO CASE
            CASE THISFORM.GX_Curr_Level = 102
               THISFORM.SetFocusEnabled( THISFORM. cCT96A2 .TabIndex, 0, +1, .F., .T., .F. )
            OTHERWISE
               RETURN
         ENDCASE
         DO CASE
            CASE THISFORM.GX_Curr_Level = 103
               THISFORM. cCT96S54 . DoNext
            CASE THISFORM.GX_Curr_Level = 102
               GX_1stLvl = .T.
               gxO_rec = IIF( EOF() .or. BOF(), 0, RECNO() )
