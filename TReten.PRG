      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S937RetNro
         LOCAL S950RetNro
         S2EmpCod = THISFORM.A2EmpCod
         S937RetNro = THISFORM.A937RetNro
         S950RetNro = THISFORM.A950RetNro
         THISFORM.A950RetNro = THISFORM.M950RetNro
         THISFORM. cCT96S54 .SaveTemp()
         THISFORM. cCT96S54 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT96S54 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT96S54 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT96S54 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S937RetNro = THISFORM.A937RetNro .AND. S950RetNro = THISFORM.A950RetNro
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT96S54 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT96S54 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S937RetNro = THISFORM.A937RetNro .AND. S950RetNro = THISFORM.A950RetNro
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT96S54 .Refresh()
               THISFORM. cCT96S54 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A937RetNro = S937RetNro
               THISFORM.A950RetNro = S950RetNro
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT96S54 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT96S54 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S937RetNro = THISFORM.A937RetNro .AND. S950RetNro = THISFORM.A950RetNro
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT96S54 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S937RetNro = THISFORM.A937RetNro .AND. S950RetNro = THISFORM.A950RetNro
            ENDDO
            IF sf_err != 0
               THISFORM. cCT96S54 .AppendRow()
               THISFORM. cCT96S54 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A937RetNro = S937RetNro
               THISFORM.A950RetNro = S950RetNro
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A937RetNro = S937RetNro
         THISFORM.A950RetNro = S950RetNro
         RETURN .F.
      ENDFUNC
      FUNCTION SF_INSERT()
         LOCAL gxO_Area
         gxO_Area = SELECT()
         IF EMPTY(THISFORM. cCT96S54 .GX_SfAlias)
            RETURN
         ENDIF
         SELECT (THISFORM. cCT96S54 .GX_SfAlias)
