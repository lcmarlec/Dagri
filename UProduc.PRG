      PROCEDURE U14V3J2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         THISFORM.SaveTblPos()
         Aux0 = THISFORM.AV5Usuario
         Aux2 = THISFORM.AV10Emprco
         Aux3 = THISFORM.AV9Nivel
         DO RNivAcc WITH Aux0 , "WPARPROD" , Aux2 , Aux3
         THISFORM.AV5Usuario = Aux0
         THISFORM.AV10Emprco = Aux2
         THISFORM.AV9Nivel = Aux3
         THISFORM. cCW127S3 .RestoreGridPos()
         GX_rploop = .T.
         IF THISFORM.AV9Nivel <> 0
            THISFORM.AV8Titulo = "Partes de Producción "
            IF THISFORM.cCW127S3 .GX_rec_loaded >= 10000
               DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
               GX_SFLOAD = 2
            ELSE
               THISFORM.cCW127S3 .GX_rec_loaded =  THISFORM.cCW127S3 .GX_rec_loaded + 1
               SELECT( THISFORM.cCW127S3 .GX_SfAlias)
               GX_SFLOAD = 1
               APPEND BLANK
               THISFORM.cCW127S3 .SaveTemp()
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

      ***********************
      PROCEDURE U13V3J2
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "ENTER" )
         * Enter Routine
         GX_SFERR = 0
         gxO_Rec = 0
         gxO_Rec1 = 0
         Gx_fel_sel = .T.
         DO WHILE Gx_fel_sel
            Gx_fel_sel = .F.
            DO CASE
               CASE THISFORM.AV8Titulo = "Fórmulas de Producción "
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV10Emprco
                  Aux1 = THISFORM.AV11Fechas
                  Aux2 = THISFORM.AV5Usuario
                  DO WForPro WITH Aux0 , Aux1 , Aux2 , "WFORPRO"
                  THISFORM.AV10Emprco = Aux0
                  THISFORM.AV11Fechas = Aux1
                  THISFORM.AV5Usuario = Aux2
                  THISFORM. cCW127S3 .RestoreGridPos()
                  GX_rploop = .T.
               CASE THISFORM.AV8Titulo = "Ordenes de Producción "
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV10Emprco
                  Aux1 = THISFORM.AV11Fechas
                  Aux2 = THISFORM.AV5Usuario
                  DO WOProds WITH Aux0 , Aux1 , Aux2 , "WOPRODS"
                  THISFORM.AV10Emprco = Aux0
                  THISFORM.AV11Fechas = Aux1
                  THISFORM.AV5Usuario = Aux2
                  THISFORM. cCW127S3 .RestoreGridPos()
                  GX_rploop = .T.
               CASE THISFORM.AV8Titulo = "Tipos de Incidentes"
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV10Emprco
                  Aux1 = THISFORM.AV11Fechas
                  Aux2 = THISFORM.AV5Usuario
                  DO WTpoInc WITH Aux0 , Aux1 , Aux2 , "WTIPREC"
                  THISFORM.AV10Emprco = Aux0
                  THISFORM.AV11Fechas = Aux1
                  THISFORM.AV5Usuario = Aux2
                  THISFORM. cCW127S3 .RestoreGridPos()
                  GX_rploop = .T.
               CASE THISFORM.AV8Titulo = "Incidentes en Planta"
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV10Emprco
                  Aux1 = THISFORM.AV11Fechas
                  Aux2 = THISFORM.AV5Usuario
                  DO WReIncid WITH Aux0 , Aux1 , Aux2 , "WREINCID" , "I"
                  THISFORM.AV10Emprco = Aux0
                  THISFORM.AV11Fechas = Aux1
                  THISFORM.AV5Usuario = Aux2
                  THISFORM. cCW127S3 .RestoreGridPos()
                  GX_rploop = .T.
               CASE THISFORM.AV8Titulo = "Partes de Producción "
                  THISFORM.SaveTblPos()
                  Aux0 = THISFORM.AV10Emprco
                  Aux1 = THISFORM.AV11Fechas
                  Aux2 = THISFORM.AV5Usuario
                  DO WParProd WITH Aux0 , Aux1 , Aux2 , "WPARPROD"
                  THISFORM.AV10Emprco = Aux0
                  THISFORM.AV11Fechas = Aux1
                  THISFORM.AV5Usuario = Aux2
                  THISFORM. cCW127S3 .RestoreGridPos()
                  GX_rploop = .T.
               OTHERWISE
                  THISFORM.GX_Refresh = 1   &&& Refresh
            ENDCASE
            IF Gx_fel_sel
               THISFORM.cCW127S3 .RestoreGridPos()
               THISFORM.cCW127S3.SF (4, @GX_SFERR)
               THISFORM.cCW127S3.SF (9, @GX_SFERR)
            ENDIF
         ENDDO
         THISFORM.cCW127S3 .ResetSavedGridPos()
         SELECT( THISFORM.cCW127S3 .GX_SfAlias)
         IF gxO_Rec1 != 0
            GOTO (gxO_Rec1)
            THISFORM.cCW127S3.SF (3, @GX_SFERR)
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

