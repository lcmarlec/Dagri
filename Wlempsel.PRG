            THISFORM. cCW1008S8 .Gx_rec_modif = .T.
            THISFORM. cCW1008S8 .GX_LastVld1 = 0
            THISFORM.GX_CF_Load_Enabled = .F.
            THISFORM. cCW1008S8 .GridValidObj(THIS.GXColumnNo)
            IF THISFORM. cCW1008S8 .Gx_ValidFailed
               RETURN
            ENDIF
            THISFORM.GX_CF_Load_Enabled = .T.
            THISFORM.GX_Is_Updated = .T.
