      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE VAV13Rutco WITH THISFORM.AV13Rutcod
         REPLACE VAV14Chfco WITH THISFORM.AV14Chfcod
         REPLACE VAV15Chfno WITH THISFORM.AV15Chfnom
