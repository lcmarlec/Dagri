      PROCEDURE CreateTemp
         LOCAL SCW136S7
         SCW136S7 = ""
         IF USED( "SCW136S7" )
            SELECT SCW136S7
            SCW136S7 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW136S7
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "VAV13Rutco"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV14Chfco"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV15Chfno"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW136S7 = GETE('z:\temp') + '\' + SCW136S7
            ENDIF
            CREATE DBF (SCW136S7) FROM ARRAY GX_STRUCT
            USE
            USE (SCW136S7) EXCLUSIVE ALIAS SCW136S7
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW136S7
         THIS.GX_SfAlias = "SCW136S7"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               THISFORM.AV14Chfcod = 0
               GX_SFLOAD = 0
               THISFORM.U15V3S2 ()
               GX_CUERR = 0
            CASE GX_CUOPER = 2
               * Next Record
               GX_CUERR = 100
         ENDCASE
      ENDPROC
