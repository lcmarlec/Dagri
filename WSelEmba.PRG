      PROCEDURE CreateTemp
         LOCAL SCW813S15
         SCW813S15 = ""
         IF USED( "SCW813S15" )
            SELECT SCW813S15
            SCW813S15 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW813S15
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA2516EmbR"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2514EmbF"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2515EmbO"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA93ChfNom"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2200acoN"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA3283EmbP"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW813S15 = GETE('z:\temp') + '\' + SCW813S15
            ENDIF
            CREATE DBF (SCW813S15) FROM ARRAY GX_STRUCT
            USE
            USE (SCW813S15) EXCLUSIVE ALIAS SCW813S15
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW813S15
         THIS.GX_SfAlias = "SCW813S15"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08132" , @HStmt_W08132 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSELEMBA","W08132","",GX_CURSOR_TYPE_READONLY,@HStmt_W08132) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmbChfCod], T2.[ChfCod], T3.[RutCod], T3.[acoCod], T1.[EmpCod], T1.[EmbPreemb], "
                  cmdbuf = cmdbuf + "  T4.[acoNom], T2.[ChfNom], T1.[EmbOrd], T1.[EmbFch], T1.[EmbRutCod] FROM ((([EMBARQUE] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[ChfCod] = T1.[EmbChfCod]) LEFT JOIN [RUTAS] T3 (NOLOCK) ON T3.[EmpCod] = "
                  cmdbuf = cmdbuf + "  T1.[EmpCod] AND T3.[RutCod] = T1.[EmbRutCod]) LEFT JOIN [ACOM] T4 (NOLOCK) ON T4.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T4.[acoCod] = T3.[acoCod]) WHERE (T1.[EmpCod] = ? and T1.[EmbFch] "
                  cmdbuf = cmdbuf + "  = ?) AND (T1.[EmbRutCod] = ?) ORDER BY T1.[EmpCod], T1.[EmbFch], T1.[EmbOrd], T1.[EmbRutCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08132,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08132,12)
                  THISFORM.GX_DB_BindColsW08132_01 ()
                  THISFORM.GX_DB_BindParmW08132_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08132,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Embfch = THISFORM.AV19Embfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08132,2,@AuxAV19Embfch,0)
               THISFORM.AV19Embfch = AuxAV19Embfch
               AuxAV21Embrut = THISFORM.AV21Embrut
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08132,3,@AuxAV21Embrut,0)
               THISFORM.AV21Embrut = AuxAV21Embrut
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08132 = Gx_err
               THISFORM.GX_DB_GetW08132_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV28Pgmnam = "WSelEmba"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08132 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08132) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08132 = Gx_err
                  THISFORM.GX_DB_GetW08132_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08132 <> 101
               BRKVML2 = .F.
               THISFORM.A2517EmbCh = THISFORM.Buf_W08132_2517EmbChfCod
               THISFORM.A92ChfCod = THISFORM.Buf_W08132_92ChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W08132_966RutCod
               THISFORM.A2199acoCo = THISFORM.Buf_W08132_2199acoCod
               THISFORM.A2EmpCod = THISFORM.Buf_W08132_2EmpCod
               THISFORM.A3283EmbPr = THISFORM.Buf_W08132_3283EmbPreemb
               THISFORM.A2200acoNo = THISFORM.Buf_W08132_2200acoNom
               THISFORM.A93ChfNom = THISFORM.Buf_W08132_93ChfNom
               THISFORM.A2515EmbOr = THISFORM.Buf_W08132_2515EmbOrd
               THISFORM.A2514EmbFc = THISFORM.Buf_W08132_2514EmbFch
               THISFORM.A2516EmbRu = THISFORM.Buf_W08132_2516EmbRutCod
               THISFORM.A93ChfNom = THISFORM.Buf_W08132_93ChfNom
               THISFORM.A2199acoCo = THISFORM.Buf_W08132_2199acoCod
               THISFORM.A2200acoNo = THISFORM.Buf_W08132_2200acoNom
               GX_SFLOAD = 0
               THISFORM.U15VML2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08132) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08132 = Gx_err
               THISFORM.GX_DB_GetW08132_01 ()
            ENDDO
         ENDIF
      ENDPROC
