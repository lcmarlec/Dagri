               AuxA2609NotIU = THISFORM.A2609NotIU
               Gx_err = GX_DB_SetStr( HStmt_T026614,5,AuxA2609NotIU,10,0)
               THISFORM.A2609NotIU = AuxA2609NotIU
               AuxA2608NotIO = THISFORM.A2608NotIO
               Gx_err = GX_DB_SetStr( HStmt_T026614,6,AuxA2608NotIO,4096,0)
               THISFORM.A2608NotIO = AuxA2608NotIO
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T026614) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T026614 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T026614) ,  ,  ,  , CS_SQLSRV , 0 )
