                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T026615" , @HStmt_T026615 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNOTAS","T026615","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T026615) ,  ,  ,  , CS_SQLSRV , 0 )
