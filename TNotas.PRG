               AuxA2603NotTe = THISFORM.A2603NotTe
               Gx_err = GX_DB_SetLong( HStmt_T026615,4,@AuxA2603NotTe,0)
               THISFORM.A2603NotTe = AuxA2603NotTe
               AuxA2605NotFc = THISFORM.A2605NotFc
               Gx_err = GX_DB_SetDateTime( HStmt_T026615,5,@AuxA2605NotFc,0)
               THISFORM.A2605NotFc = AuxA2605NotFc
               AuxA2607NotIt = THISFORM.A2607NotIt
               Gx_err = GX_DB_SetDateTime( HStmt_T026615,6,@AuxA2607NotIt,0)
               THISFORM.A2607NotIt = AuxA2607NotIt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T026615) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T026615 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T026615) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T026616" , @HStmt_T026616 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNOTAS","T026616","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T026616) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [NOTAS1]  WHERE [EmpCod] = ? AND [NotTemCod] = ? AND [NotFch] = ? AND "
                  cmdbuf = cmdbuf + "  [NotItFch] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T026616,cmdbuf)
                  THISFORM.GX_DB_BindParmT026616_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T026616,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2603NotTe = THISFORM.A2603NotTe
               Gx_err = GX_DB_SetLong( HStmt_T026616,2,@AuxA2603NotTe,0)
               THISFORM.A2603NotTe = AuxA2603NotTe
               AuxA2605NotFc = THISFORM.A2605NotFc
               Gx_err = GX_DB_SetDateTime( HStmt_T026616,3,@AuxA2605NotFc,0)
               THISFORM.A2605NotFc = AuxA2605NotFc
               AuxA2607NotIt = THISFORM.A2607NotIt
               Gx_err = GX_DB_SetDateTime( HStmt_T026616,4,@AuxA2607NotIt,0)
               THISFORM.A2607NotIt = AuxA2607NotIt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T026616) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T026616 = Gx_err
               THISFORM.T02662 = iif( THISFORM.T026616 = 0 , 104 , THISFORM.T026616 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T026616) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
