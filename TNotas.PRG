            IF .NOT. THISFORM.T02662 <> 103
               DO GX_ERRMW WITH "NOTAS1 reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02662 = 101 .OR. THISFORM.Z2609NotIU <> THISFORM.Buf_T02662_2609NotIUsu
               DO GX_ERRMW WITH "NOTAS1 fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T026614" , @HStmt_T026614 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TNOTAS","T026614","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T026614) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [NOTAS1] ([EmpCod], [NotTemCod], [NotFch], [NotItFch], [NotIUsu], [NotIObs]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T026614,cmdbuf)
                  THISFORM.GX_DB_BindParmT026614_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
