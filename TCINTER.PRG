      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03332,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA3202CICod = THISFORM.A3202CICod
            Gx_err = GX_DB_SetInt( HStmt_T03332,2,@AuxA3202CICod,0)
            THISFORM.A3202CICod = AuxA3202CICod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03332) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03332 = Gx_err
            THISFORM.GX_DB_GetT03332_01 ()
            IF .NOT. THISFORM.T03332 <> 103
               DO GX_ERRMW WITH "CINTER reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03332 = 101 .OR. THISFORM.Z3203CIDsc <> THISFORM.Buf_T03332_3203CIDsc
               DO GX_ERRMW WITH "CINTER fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03336" , @HStmt_T03336 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCINTER","T03336","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03336) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [CINTER] ([EmpCod], [CICod], [CIDsc]) VALUES (?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03336,cmdbuf)
                  THISFORM.GX_DB_BindParmT03336_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03336,1,@AuxA2EmpCod,0)
