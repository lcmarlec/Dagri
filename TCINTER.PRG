               THISFORM.A3202CICod = AuxA3202CICod
               AuxA3203CIDsc = THISFORM.A3203CIDsc
               Gx_err = GX_DB_SetStr( HStmt_T03336,3,AuxA3203CIDsc,40,0)
               THISFORM.A3203CIDsc = AuxA3203CIDsc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03336) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03336 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03336) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03336 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03337" , @HStmt_T03337 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCINTER","T03337","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03337) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [CINTER] SET [CIDsc]=?  WHERE [EmpCod] = ? AND [CICod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03337,cmdbuf)
                  THISFORM.GX_DB_BindParmT03337_01 ()
               ENDIF
               AuxA3203CIDsc = THISFORM.A3203CIDsc
               Gx_err = GX_DB_SetStr( HStmt_T03337,1,AuxA3203CIDsc,40,0)
               THISFORM.A3203CIDsc = AuxA3203CIDsc
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03337,2,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3202CICod = THISFORM.A3202CICod
               Gx_err = GX_DB_SetInt( HStmt_T03337,3,@AuxA3202CICod,0)
               THISFORM.A3202CICod = AuxA3202CICod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03337) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03337 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03337) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03338" , @HStmt_T03338 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCINTER","T03338","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03338) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [CINTER]  WHERE [EmpCod] = ? AND [CICod] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03338,cmdbuf)
                  THISFORM.GX_DB_BindParmT03338_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03338,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3202CICod = THISFORM.A3202CICod
               Gx_err = GX_DB_SetInt( HStmt_T03338,2,@AuxA3202CICod,0)
               THISFORM.A3202CICod = AuxA3202CICod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03338) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03338 = Gx_err
               THISFORM.T03332 = iif( THISFORM.T03338 = 0 , 104 , THISFORM.T03338 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03338) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A3202CICod , 3 )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV22Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "TABL" , Aux1 , "CINTER" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV22Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT333V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 366 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
