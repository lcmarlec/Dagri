         LOCAL gx_old_event
         THISFORM.SetEvent( "'EMPLEADO'" )
         * 'EMPLEADO' Routine
         THISFORM.AV25Tranom = SPACE(40)
         THISFORM.AV58GXLvl5 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12042" , @HStmt_W12042 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLISFAM","W12042","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W12042) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [TraCod], [TraNom] FROM [EMPLEADO] (NOLOCK) WHERE [EmpCod] = ? and "
            cmdbuf = cmdbuf + "  [TraCod] = ? ORDER BY [EmpCod], [TraCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12042,cmdbuf)
            THISFORM.GX_DB_BindColsW12042_01 ()
            THISFORM.GX_DB_BindParmW12042_01 ()
         ENDIF
         AuxAV11Emprco = THISFORM.AV11Emprco
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12042,1,@AuxAV11Emprco,0)
         THISFORM.AV11Emprco = AuxAV11Emprco
         AuxAV24Tracod = THISFORM.AV24Tracod
