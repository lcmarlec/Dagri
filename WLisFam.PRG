         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12042) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W12042 = Gx_err
         THISFORM.GX_DB_GetW12042_01 ()
         DO WHILE THISFORM.W12042 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W12042_2EmpCod
            THISFORM.A561TraCod = THISFORM.Buf_W12042_561TraCod
            THISFORM.A564TraNom = THISFORM.Buf_W12042_564TraNom
