            THISFORM.AV25Tranom = THISFORM.A564TraNom
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W12042) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV58GXLvl5 = 0
            THISFORM.AV25Tranom = " "
         ENDIF
         THISFORM.EndEvent()
      ENDPROC

