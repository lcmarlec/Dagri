      PROCEDURE CreateTemp
         LOCAL SCW1202S22
         SCW1202S22 = ""
         IF USED( "SCW1202S22" )
            SELECT SCW1202S22
            SCW1202S22 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1202S22
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 8 , 4]

            GX_STRUCT[ 1 ,1]= "sA2536IBED"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2537IBEH"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3470IBEx"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2538IBEP"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA3471IBOb"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 100
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA2EmpCod"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "sA166EntCu"
            GX_STRUCT[ 7 ,2]= "N"
            GX_STRUCT[ 7 ,3]= 11
            GX_STRUCT[ 7 ,4]= 0

            GX_STRUCT[ 8 ,1]= "sA2535IBET"
            GX_STRUCT[ 8 ,2]= "C"
            GX_STRUCT[ 8 ,3]= 1
            GX_STRUCT[ 8 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1202S22 = GETE('z:\temp') + '\' + SCW1202S22
            ENDIF
            CREATE DBF (SCW1202S22) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1202S22) EXCLUSIVE ALIAS SCW1202S22
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1202S22
         THIS.GX_SfAlias = "SCW1202S22"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12022" , @HStmt_W12022 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WIVAEXEN","W12022","",GX_CURSOR_TYPE_READONLY,@HStmt_W12022) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [IBObs], [IBETpo], [IBEPor], [IBExe], [IBEHta], [IBEDde], [EntCui], [EmpCod] "
                  cmdbuf = cmdbuf + "  FROM [IBESP1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [EntCui] = ?) AND ([IBETpo] "
                  cmdbuf = cmdbuf + "  = ?) ORDER BY [EmpCod], [EntCui], [IBEDde], [IBETpo]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12022,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12022,13)
                  THISFORM.GX_DB_BindColsW12022_01 ()
                  THISFORM.GX_DB_BindParmW12022_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12022,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV21Entcui = THISFORM.AV21Entcui
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W12022,2,@AuxAV21Entcui,0)
               THISFORM.AV21Entcui = AuxAV21Entcui
               AuxAV22Ibetpo = THISFORM.AV22Ibetpo
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12022,3,AuxAV22Ibetpo,1,0)
               THISFORM.AV22Ibetpo = AuxAV22Ibetpo
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12022 = Gx_err
               THISFORM.GX_DB_GetW12022_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV26Pgmnam = "WIvaExen"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12022 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12022) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12022 = Gx_err
                  THISFORM.GX_DB_GetW12022_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12022 <> 101
               BRKVXE2 = .F.
               THISFORM.A3471IBObs = THISFORM.Buf_W12022_3471IBObs
               THISFORM.A2535IBETp = THISFORM.Buf_W12022_2535IBETpo
               THISFORM.A2538IBEPo = THISFORM.Buf_W12022_2538IBEPor
               THISFORM.A3470IBExe = THISFORM.Buf_W12022_3470IBExe
               THISFORM.A2537IBEHt = THISFORM.Buf_W12022_2537IBEHta
               THISFORM.A2536IBEDd = THISFORM.Buf_W12022_2536IBEDde
               THISFORM.A166EntCui = THISFORM.Buf_W12022_166EntCui
               THISFORM.A2EmpCod = THISFORM.Buf_W12022_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U17VXE2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12022) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12022 = Gx_err
               THISFORM.GX_DB_GetW12022_01 ()
            ENDDO
         ENDIF
      ENDPROC
