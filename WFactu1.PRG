      PROCEDURE CreateTemp
         LOCAL SCW57S12
         SCW57S12 = ""
         IF USED( "SCW57S12" )
            SELECT SCW57S12
            SCW57S12 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW57S12
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA966RutCo"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 3
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV21Chfco"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV22Chfno"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2EmpCod"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW57S12 = GETE('z:\temp') + '\' + SCW57S12
            ENDIF
            CREATE DBF (SCW57S12) FROM ARRAY GX_STRUCT
            USE
            USE (SCW57S12) EXCLUSIVE ALIAS SCW57S12
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW57S12
         THIS.GX_SfAlias = "SCW57S12"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00572" , @HStmt_W00572 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFACTU1","W00572","",GX_CURSOR_TYPE_READONLY,@HStmt_W00572) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[RutChfCod] AS RutChfCod, T1.[RutCod], T2.[ChfNom] AS RutChfNom "
                  cmdbuf = cmdbuf + "  FROM ([RUTAS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [CHOFER] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[ChfCod] = T1.[RutChfCod]) ORDER BY T1.[EmpCod], T1.[RutCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00572,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00572,14)
                  THISFORM.GX_DB_BindColsW00572_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00572 = Gx_err
               THISFORM.GX_DB_GetW00572_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WFactu1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00572 = 101
                  GX_CUERR = 100
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00572 <> 101
               BRKV1L2 = .F.
               THISFORM.AV21Chfcod = 0
               THISFORM.AV22Chfnom = SPACE(40)
               THISFORM.A2EmpCod = THISFORM.Buf_W00572_2EmpCod
               THISFORM.A1216RutCh = THISFORM.Buf_W00572_1216RutChfCod
               THISFORM.A966RutCod = THISFORM.Buf_W00572_966RutCod
               THISFORM.A1217RutCh = THISFORM.Buf_W00572_1217RutChfNom
               THISFORM.A1217RutCh = THISFORM.Buf_W00572_1217RutChfNom
               GX_SFLOAD = 0
               THISFORM.U15V1L2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               IF .NOT. BRKV1L2
                  BRKV1L2 = .T.
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00572) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00572 = Gx_err
                  THISFORM.GX_DB_GetW00572_01 ()
               ENDIF
            ENDDO
         ENDIF
      ENDPROC
