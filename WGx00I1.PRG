      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03102" , @HStmt_W03102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00I1","W03102","",GX_CURSOR_TYPE_READONLY,@HStmt_W03102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CtaDes], [CtaToC], [CtaNiv], [CtaSecBal], [CtaNro], [PCtaNro] FROM "
                  cmdbuf = cmdbuf + "  [CTA00] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [PCtaNro] >= ?) AND ([CtaNro] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CtaDes] like ?) AND ([CtaSecBal] >= ?) AND ([CtaToC] >= ?) AND ([CtaNiv] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [PCtaNro], [CtaNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03102,8)
                  THISFORM.GX_DB_BindColsW03102_01 ()
                  THISFORM.GX_DB_BindParmW03102_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03102,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV22C198 = THISFORM.AV22C198
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03102,2,@AuxAV22C198,0)
               THISFORM.AV22C198 = AuxAV22C198
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03102,3,PADR( TRIM(THISFORM.AV21C199),12, '%'),LEN(PADR( TRIM(THISFORM.AV21C199),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03102,4,PADR( TRIM(THISFORM.AV20C200),40, '%'),LEN(PADR( TRIM(THISFORM.AV20C200),40, '%')),0)
               AuxAV19C201 = THISFORM.AV19C201
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03102,5,@AuxAV19C201,0)
               THISFORM.AV19C201 = AuxAV19C201
               AuxAV18C202 = THISFORM.AV18C202
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03102,6,@AuxAV18C202,0)
               THISFORM.AV18C202 = AuxAV18C202
               AuxAV17C203 = THISFORM.AV17C203
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03102,7,@AuxAV17C203,0)
               THISFORM.AV17C203 = AuxAV17C203
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03102 = Gx_err
               THISFORM.GX_DB_GetW03102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03102 = Gx_err
                  THISFORM.GX_DB_GetW03102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03102 <> 101
               BRKV8M2 = .F.
               THISFORM.A200CtaDes = THISFORM.Buf_W03102_200CtaDes
               THISFORM.A202CtaToC = THISFORM.Buf_W03102_202CtaToC
               THISFORM.A203CtaNiv = THISFORM.Buf_W03102_203CtaNiv
               THISFORM.A201CtaSec = THISFORM.Buf_W03102_201CtaSecBal
               THISFORM.A199CtaNro = THISFORM.Buf_W03102_199CtaNro
               THISFORM.A198PCtaNr = THISFORM.Buf_W03102_198PCtaNro
               GX_SFLOAD = 0
               THISFORM.U12V8M2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03102) ,  ,  ,  , CS_SQLSRV ,  )
