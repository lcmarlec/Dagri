               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07932,6,PADR( TRIM(THISFORM.AV9C712),2, '%'),LEN(PADR( TRIM(THISFORM.AV9C712),2, '%')),0)
               AuxAV10C713 = THISFORM.AV10C713
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W07932,7,@AuxAV10C713,0)
               THISFORM.AV10C713 = AuxAV10C713
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07932) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07932 = Gx_err
               THISFORM.GX_DB_GetW07932_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07932 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07932) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07932 = Gx_err
                  THISFORM.GX_DB_GetW07932_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07932 <> 101
               BRKVM12 = .F.
               THISFORM.A711OpaEst = THISFORM.Buf_W07932_711OpaEst
               THISFORM.A713OpaEnt = THISFORM.Buf_W07932_713OpaEntCod
               THISFORM.A712OpaEnt = THISFORM.Buf_W07932_712OpaEntGruT
               THISFORM.A710OpaFch = THISFORM.Buf_W07932_710OpaFchCon
               THISFORM.A709OpaFch = THISFORM.Buf_W07932_709OpaFch
               THISFORM.A708OPaNro = THISFORM.Buf_W07932_708OPaNroI
               GX_SFLOAD = 0
               THISFORM.U12VM12 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07932) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07932 = Gx_err
               THISFORM.GX_DB_GetW07932_01 ()
            ENDDO
         ENDIF
      ENDPROC
