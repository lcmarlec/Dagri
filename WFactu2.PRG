               THISFORM.A177EntLgD = THISFORM.Buf_W00582_177EntLgDsc
               THISFORM.A802PedSuc = THISFORM.Buf_W00582_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W00582_798PedEntCod
               THISFORM.A818PedSuc = THISFORM.Buf_W00582_818PedSucTel
               THISFORM.A177EntLgD = THISFORM.Buf_W00582_177EntLgDsc
               X7990 = SPACE(40)
               THISFORM.SaveTblPos()
               Aux0 = THISFORM.A2EmpCod
               Aux1 = THISFORM.A797PedGru
               Aux2 = THISFORM.A798PedEnt
               DO RPedEntr WITH Aux0 , Aux1 , Aux2 , X7990
               THISFORM.A2EmpCod = Aux0
               THISFORM.A797PedGru = Aux1
               THISFORM.A798PedEnt = Aux2
               THISFORM. cCW58S19 .RestoreGridPos()
               GX_rploop = .T.
               THISFORM.A799PedEnt = X7990
               GX_SFLOAD = 0
               THISFORM.U20V1M2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
