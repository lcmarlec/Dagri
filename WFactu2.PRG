      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00582" , @HStmt_W00582 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WFACTU2","W00582","",GX_CURSOR_TYPE_READONLY,@HStmt_W00582) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[pedle], T1.[PedFac], T1.[PedNro], T1.[PedGruTip] AS PedGruTip, "
                  cmdbuf = cmdbuf + "  T1.[PedObs], T1.[PedFVT], T1.[PedFPrc], T1.[PedEst], T2.[EntLgTel] AS PedSucTel, "
                  cmdbuf = cmdbuf + "  T1.[PedOrd12], T1.[PedPri], T1.[PedSec], T1.[PedFch], T2.[EntLgDsc], T1.[PedSucCod] "
                  cmdbuf = cmdbuf + "  AS PedSucCod, T1.[PedEntCod] AS PedEntCod FROM ([PEDIDO1] T1 (NOLOCK) LEFT JOIN "
                  cmdbuf = cmdbuf + "  [CLTES] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[PedGruTip] "
                  cmdbuf = cmdbuf + "  AND T2.[EntCod] = T1.[PedEntCod] AND T2.[EntLgCod] = T1.[PedSucCod]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[PedNro] = ? and T1.[PedFch] >= ?) AND (T1.[PedEst] = 1) AND (( T1.[PedFVT] "
                  cmdbuf = cmdbuf + "  = 'FF' and ? = 'F') or ( ( T1.[PedFVT] = 'RF' or T1.[PedFVT] = 'RS') and ? = 'R') "
                  cmdbuf = cmdbuf + "  or ( T1.[PedFVT] = 'FR' and ? = 'A')) AND (T1.[PedFch] <= ?) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[PedNro], T1.[PedFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00582,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00582,16)
                  THISFORM.GX_DB_BindColsW00582_01 ()
                  THISFORM.GX_DB_BindParmW00582_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00582,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV19Pednro = THISFORM.AV19Pednro
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00582,2,@AuxAV19Pednro,0)
               THISFORM.AV19Pednro = AuxAV19Pednro
               AuxAV15Fecdes = THISFORM.AV15Fecdes
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00582,3,@AuxAV15Fecdes,0)
               THISFORM.AV15Fecdes = AuxAV15Fecdes
               AuxAV13Opcion = THISFORM.AV13Opcion
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00582,4,AuxAV13Opcion,1,0)
               THISFORM.AV13Opcion = AuxAV13Opcion
               AuxAV13Opcion = THISFORM.AV13Opcion
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00582,5,AuxAV13Opcion,1,0)
               THISFORM.AV13Opcion = AuxAV13Opcion
               AuxAV13Opcion = THISFORM.AV13Opcion
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W00582,6,AuxAV13Opcion,1,0)
               THISFORM.AV13Opcion = AuxAV13Opcion
               AuxAV16Fechas = THISFORM.AV16Fechas
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W00582,7,@AuxAV16Fechas,0)
               THISFORM.AV16Fechas = AuxAV16Fechas
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00582 = Gx_err
               THISFORM.GX_DB_GetW00582_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV33Pgmnam = "WFactu2"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00582 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00582) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00582 = Gx_err
                  THISFORM.GX_DB_GetW00582_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00582 <> 101
               BRKV1M2 = .F.
               THISFORM.AV30F = SPACE(2)
