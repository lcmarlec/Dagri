      PROCEDURE CreateTemp
         LOCAL SCW1205S20
         SCW1205S20 = ""
         IF USED( "SCW1205S20" )
            SELECT SCW1205S20
            SCW1205S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1205S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA150EntGr"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA120EntCo"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA843EntMc"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 3
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA844EntMC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1205S20 = GETE('z:\temp') + '\' + SCW1205S20
            ENDIF
            CREATE DBF (SCW1205S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1205S20) EXCLUSIVE ALIAS SCW1205S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1205S20
         THIS.GX_SfAlias = "SCW1205S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W12052" , @HStmt_W12052 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02M0","W12052","",GX_CURSOR_TYPE_READONLY,@HStmt_W12052) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EntMcoMonc], [EntMcoCta], [EntMCoCod], [EntMcoDias], [EntCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [PROVES] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([EntGruTip] "
                  cmdbuf = cmdbuf + "  like ?) AND ([EntCod] >= ?) AND ([EntMcoDias] >= ?) AND ([EntMCoCod] >= ?) AND ([EntMcoCta] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([EntMcoMonc] >= ?) ORDER BY [EmpCod], [EntGruTip], [EntCod], [EntMcoDias], "
                  cmdbuf = cmdbuf + "  [EntMCoCod], [EntMcoCta], [EntMcoMonc]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W12052,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W12052,9)
                  THISFORM.GX_DB_BindColsW12052_01 ()
                  THISFORM.GX_DB_BindParmW12052_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12052,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W12052,2,PADR( TRIM(THISFORM.AV6C150),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C150),2, '%')),0)
               AuxAV7C120 = THISFORM.AV7C120
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W12052,3,@AuxAV7C120,0)
               THISFORM.AV7C120 = AuxAV7C120
               AuxAV8C843 = THISFORM.AV8C843
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12052,4,@AuxAV8C843,0)
               THISFORM.AV8C843 = AuxAV8C843
               AuxAV9C844 = THISFORM.AV9C844
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12052,5,@AuxAV9C844,0)
               THISFORM.AV9C844 = AuxAV9C844
               AuxAV10C845 = THISFORM.AV10C845
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12052,6,@AuxAV10C845,0)
               THISFORM.AV10C845 = AuxAV10C845
               AuxAV11C846 = THISFORM.AV11C846
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12052,7,@AuxAV11C846,0)
               THISFORM.AV11C846 = AuxAV11C846
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12052 = Gx_err
               THISFORM.GX_DB_GetW12052_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12052 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12052) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12052 = Gx_err
                  THISFORM.GX_DB_GetW12052_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12052 <> 101
               BRKVXH2 = .F.
               THISFORM.A846EntMco = THISFORM.Buf_W12052_846EntMcoMonc
               THISFORM.A845EntMco = THISFORM.Buf_W12052_845EntMcoCta
               THISFORM.A844EntMCo = THISFORM.Buf_W12052_844EntMCoCod
               THISFORM.A843EntMco = THISFORM.Buf_W12052_843EntMcoDias
               THISFORM.A120EntCod = THISFORM.Buf_W12052_120EntCod
               THISFORM.A150EntGru = THISFORM.Buf_W12052_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W12052_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VXH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12052 = Gx_err
               THISFORM.GX_DB_GetW12052_01 ()
            ENDDO
         ENDIF
      ENDPROC
