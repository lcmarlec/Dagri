      FUNCTION MB_Local_Run
         LPARAMETER gx_evt_to_run
         IF UPPER( "Salir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU12VF92()
            RETURN .T.
         ENDIF
         IF UPPER( "QuePrograma" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU16VF92()
            RETURN .T.
         ENDIF
         IF UPPER( "SkDesdePrv" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU14VF92()
            RETURN .T.
         ENDIF
         IF UPPER( "SkPrvhas" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU15VF92()
            RETURN .T.
         ENDIF
         IF UPPER( "Imprimir" ) == UPPER(gx_evt_to_run)
            THISFORM.DoU13VF92()
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_HELP"
            THISFORM.DoHelp
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CLOSE"
            THISFORM.KeyPress(27,0)
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_CONFIRM"
            THISFORM.DoEnter
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_EXIT"
            THISFORM.DoShutDown
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_INDEX"
            SET TOPIC TO ""
            HELP
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_FIRST"
            THISFORM.DoFirst
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_PREV"
            THISFORM.DoPrevious
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_NEXT"
            THISFORM.DoNext
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_LAST"
            THISFORM.DoLast
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_DELREC"
            THISFORM.DoDelete
            RETURN .T.
         ENDIF
         IF UPPER(gx_evt_to_run) == "GX_REFRESH"
            THISFORM.DoRefresh
            RETURN .T.
         ENDIF
