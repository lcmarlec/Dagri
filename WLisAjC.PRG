      PROCEDURE cCW549V12.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW549V12.ISVALID" )
         THISFORM.AV29GXLvl1 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05492" , @HStmt_W05492 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLISAJC","W05492","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W05492) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'PR' and [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], [EntCod] "
            cmdbuf = cmdbuf + "   "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05492,cmdbuf)
            THISFORM.GX_DB_BindColsW05492_01 ()
            THISFORM.GX_DB_BindParmW05492_01 ()
         ENDIF
         AuxAV8Emprcod = THISFORM.AV8Emprcod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05492,1,@AuxAV8Emprcod,0)
         THISFORM.AV8Emprcod = AuxAV8Emprcod
         AuxAV12Despro = THISFORM.AV12Despro
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W05492,2,@AuxAV12Despro,0)
         THISFORM.AV12Despro = AuxAV12Despro
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05492) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W05492 = Gx_err
         THISFORM.GX_DB_GetW05492_01 ()
         DO WHILE THISFORM.W05492 <> 101
            THISFORM.A2EmpCod = THISFORM.Buf_W05492_2EmpCod
            THISFORM.A150EntGru = THISFORM.Buf_W05492_150EntGruTip
            THISFORM.A120EntCod = THISFORM.Buf_W05492_120EntCod
            THISFORM.A153EntRaz = THISFORM.Buf_W05492_153EntRaz
            THISFORM.AV29GXLvl1 = 1
            THISFORM.AV18Desraz = THISFORM.A153EntRaz
