      PROCEDURE CreateTemp
         LOCAL SCW998S14
         SCW998S14 = ""
         IF USED( "SCW998S14" )
            SELECT SCW998S14
            SCW998S14 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW998S14
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA166EntCu"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 11
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3011CMAn"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3013cm05"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW998S14 = GETE('z:\temp') + '\' + SCW998S14
            ENDIF
            CREATE DBF (SCW998S14) FROM ARRAY GX_STRUCT
            USE
            USE (SCW998S14) EXCLUSIVE ALIAS SCW998S14
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW998S14
         THIS.GX_SfAlias = "SCW998S14"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09982" , @HStmt_W09982 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09M0","W09982","",GX_CURSOR_TYPE_READONLY,@HStmt_W09982) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [cm05ok], [CMAnio], [EntCui], [EmpCod] FROM [CM05] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([EmpCod] >= ? and [EntCui] >= ? and [CMAnio] >= ?) AND ([cm05ok] >= ?) ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod], [EntCui], [CMAnio]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09982,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09982,9)
                  THISFORM.GX_DB_BindColsW09982_01 ()
                  THISFORM.GX_DB_BindParmW09982_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09982,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C166 = THISFORM.AV6C166
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09982,2,@AuxAV6C166,0)
               THISFORM.AV6C166 = AuxAV6C166
               AuxAV7C3011 = THISFORM.AV7C3011
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09982,3,@AuxAV7C3011,0)
               THISFORM.AV7C3011 = AuxAV7C3011
               AuxAV8C3013 = THISFORM.AV8C3013
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09982,4,@AuxAV8C3013,0)
               THISFORM.AV8C3013 = AuxAV8C3013
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09982 = Gx_err
               THISFORM.GX_DB_GetW09982_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09982 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09982) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09982 = Gx_err
                  THISFORM.GX_DB_GetW09982_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09982 <> 101
               BRKVRQ2 = .F.
               THISFORM.A3013cm05o = THISFORM.Buf_W09982_3013cm05ok
               THISFORM.A3011CMAni = THISFORM.Buf_W09982_3011CMAnio
               THISFORM.A166EntCui = THISFORM.Buf_W09982_166EntCui
               THISFORM.A2EmpCod = THISFORM.Buf_W09982_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VRQ2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09982) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09982 = Gx_err
               THISFORM.GX_DB_GetW09982_01 ()
            ENDDO
         ENDIF
      ENDPROC
