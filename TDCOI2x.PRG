      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T004016" , @HStmt_T004016 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCOI2X","T004016","",GX_CURSOR_TYPE_READONLY,@HStmt_T004016) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin], [TdcTotLiA], [FamCod], [FamSubCod], "
                  cmdbuf = cmdbuf + "  [ArtCod], [TdcRORCnt], [TdcCnt], [TdcRORPrcO], [TdcPrc] FROM [TDCOM2] (NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  [EmpCod] = ? AND [TdcNroInt] = ? ORDER BY [EmpCod], [TdcNroInt], [TdcRORNroI], [TdcRORLin] "
                  cmdbuf = cmdbuf + "   "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T004016,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T004016,14)
                  THISFORM.GX_DB_BindColsT004016_01 ()
                  THISFORM.GX_DB_BindParmT004016_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T004016,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA380TdcNro = THISFORM.A380TdcNro
               Gx_err = GX_DB_SetDouble( HStmt_T004016,2,@AuxA380TdcNro,0)
               THISFORM.A380TdcNro = AuxA380TdcNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T004016) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T004016 = Gx_err
               THISFORM.GX_DB_GetT004016_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T004016 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T004016) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T004016 = Gx_err
                  THISFORM.GX_DB_GetT004016_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T004016 <> 101
               BRK1441 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT40S26.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T004016_380TdcNroInt = THISFORM.A380TdcNro .AND. THISFORM.Buf_T004016_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T004016) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T004016 = Gx_err
               THISFORM.GX_DB_GetT004016_01 ()
            ENDDO
         ENDIF
      ENDPROC
