         LOCAL gxO_Area
         gxO_Area = SELECT()
         IF EMPTY(THISFORM. cCT40S26 .GX_SfAlias)
            RETURN
         ENDIF
         SELECT (THISFORM. cCT40S26 .GX_SfAlias)
