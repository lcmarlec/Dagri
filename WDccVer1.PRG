      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00332" , @HStmt_W00332 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCVER1","W00332","",GX_CURSOR_TYPE_READONLY,@HStmt_W00332) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[TesLin], T1.[TesMonCod] AS TesMonCod, T1.[EmpCod], T1.[TesNroI], T1.[TesImp], "
                  cmdbuf = cmdbuf + "  T2.[MonSim] AS TesMonSim, T1.[TesFchDeb], T1.[TesNro], T1.[TesBcoCta], T3.[BcoDsc] "
                  cmdbuf = cmdbuf + "  AS TesBcoDsc, T1.[TesBcoCod] AS TesBcoCod, T4.[MCoDsc] AS TesMedDsc, T1.[TesMedCod] "
                  cmdbuf = cmdbuf + "  AS TesMedCod FROM ((([TESCYP] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [MONEDA] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[Moncod] = T1.[TesMonCod]) LEFT JOIN [BANCOS] T3 (NOLOCK) ON T3.[BcoCod] = "
                  cmdbuf = cmdbuf + "  T1.[TesBcoCod]) LEFT JOIN [MEDCOB] T4 (NOLOCK) ON T4.[MCoCod] = T1.[TesMedCod]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[TesNroI] = ? ORDER BY T1.[EmpCod], T1.[TesNroI]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00332,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00332,14)
                  THISFORM.GX_DB_BindColsW00332_01 ()
                  THISFORM.GX_DB_BindParmW00332_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00332,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA985TesNro = THISFORM.A985TesNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W00332,2,@AuxA985TesNro,0)
               THISFORM.A985TesNro = AuxA985TesNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00332 = Gx_err
               THISFORM.GX_DB_GetW00332_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV15Pgmnam = "WDccVer1"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00332 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00332) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00332 = Gx_err
                  THISFORM.GX_DB_GetW00332_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00332 <> 101
               BRKV0X2 = .F.
               THISFORM.A1007TesMo = THISFORM.Buf_W00332_1007TesMonCod
               THISFORM.A996TesImp = THISFORM.Buf_W00332_996TesImp
               THISFORM.A1009TesMo = THISFORM.Buf_W00332_1009TesMonSim
               THISFORM.A997TesFch = THISFORM.Buf_W00332_997TesFchDeb
               THISFORM.A994TesNro = THISFORM.Buf_W00332_994TesNro
               THISFORM.A993TesBco = THISFORM.Buf_W00332_993TesBcoCta
               THISFORM.A992TesBco = THISFORM.Buf_W00332_992TesBcoDsc
               THISFORM.A991TesBco = THISFORM.Buf_W00332_991TesBcoCod
               THISFORM.A990TesMed = THISFORM.Buf_W00332_990TesMedDsc
               THISFORM.A989TesMed = THISFORM.Buf_W00332_989TesMedCod
               THISFORM.A1009TesMo = THISFORM.Buf_W00332_1009TesMonSim
               THISFORM.A992TesBco = THISFORM.Buf_W00332_992TesBcoDsc
               THISFORM.A990TesMed = THISFORM.Buf_W00332_990TesMedDsc
               GX_SFLOAD = 0
               THISFORM.U13V0X2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00332) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00332 = Gx_err
               THISFORM.GX_DB_GetW00332_01 ()
            ENDDO
         ENDIF
      ENDPROC
