         IF EMPTY( THISFORM.A2903ComPe ) .OR. THISFORM.A2903ComPe > THISFORM.A2904ComPe
            DO GX_ERRMW WITH "Debe ingresar Un Periodo válidao !!!"
            RETURN .F.
            AnyError = 1
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
