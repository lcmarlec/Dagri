      PROCEDURE Init
         THIS.GX_OldValue = THISFORM.A2906ComOb
         THIS.SetTabOrder
         THIS.GX_OldValue = THISFORM.A2906ComOb
         THIS.GX_Level = 334
      ENDPROC
      PROCEDURE GotFocus
         IF THISFORM.GX_Exit_GotFocus
            RETURN
         ENDIF
         THISFORM. GXInLvl334 = .T.
         IF THISFORM.GX_last_fld_lvl = 334
            IF ! THISFORM. gx_334insert
               THISFORM.SetLevel( 334 )
               THISFORM.SetMode("EOF", "1" )
               CGXEditBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         LOCAL gxO_Area
         IF THISFORM.GX_last_fld_lvl != 334
            IF .not. THISFORM.AfterLevel(THISFORM.GX_last_fld_lvl, 334 )
               RETURN
            ENDIF
         ENDIF
         gx_a_trn = .F.
         gx_a_trn = .F.
         IF THISFORM.GX_after_trn != 0
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03033) , "TCOMIDAL" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03032) , "TCOMIDAL" )
            Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03034) , "TCOMIDAL" )
            IF TYPE( "HConn_Default" ) = "N"
               IF GXCONNECTED
                  Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDIF
            ENDIF
            THISFORM. cCT303A2906 .AfterTrn()
            DO CASE
               CASE THISFORM.GX_Mode = "INS"
               CASE THISFORM.GX_Mode = "UPD"
                  THISFORM.ReleaseAll()
               CASE THISFORM.GX_Mode = "DLT"
                  THISFORM.ReleaseAll()
            ENDCASE
            IF THISFORM.GX_Exit_GotFocus
               RETURN
            ENDIF
            THISFORM.GX_after_trn = 0
            gx_a_trn = .T.
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 334
            IF ! THISFORM. gx_334insert
               THISFORM.SetLevel( 334 )
               THISFORM.SetMode("EOF", "1" )
               CGXEditBox ::GotFocus
               IF THISFORM.GX_Exit_GotFocus
                  THISFORM.GX_Exit_GotFocus = .F.
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ENDIF
         IF THISFORM. gx_334insert
            THISFORM. gx_334insert = .F.
            THISFORM.gx_insert = .F.
            THISFORM.SetLevel( 334 )
            THISFORM. cCT303A2902 .ClearLevel()
            THISFORM.SaveMode( "INS" ,"")
            THISFORM.LoadObj(1)
            CGXEditBox ::GotFocus
            IF THISFORM.GX_Exit_GotFocus
               THISFORM.GX_Exit_GotFocus = .F.
               NODEFAULT
               RETURN
            ENDIF
            THISFORM.gx_lastvld = THIS.GxObjOrder-1
            THISFORM.FormRefresh( .F. , .T. )
         ENDIF
         IF THISFORM.GX_last_fld_lvl != 334
            THISFORM.SetLevel( 334 )
            THISFORM.SetMode("EOF", "1" )
            THISFORM. cCT303A2899 .InitLevel( 334 )
            THISFORM.GX_last_fld_lvl = 334
            gx_val_ret = THISFORM.ValidObj2(THISFORM.gx_lastvld, THIS.gx_ctrl_FrmNo, THIS.GxObjOrder)
            IF gx_val_ret >= 0
               NODEFAULT
               IF ! THISFORM.SetFocusEnabled(gx_val_ret, 0, -1, .T., .F., .F.)
                  THISFORM.ReleaseAll()
               ENDIF
               RETURN
            ELSE
               IF gx_val_ret = -2
                  NODEFAULT
                  RETURN
               ENDIF
            ENDIF
         ELSE
            IF gx_a_trn
               gx_a_trn = .F.
            ENDIF
         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2906ComOb"
         THIS.GXGotFocus()
         ON KEY LABEL ENTER
         THISFORM.GX_1_accepted = .T.
         THISFORM.LockScreen = .F.
      ENDPROC
      PROCEDURE Refresh
         CGXEditBox ::Refresh()
      ENDPROC
      PROCEDURE ValidObj
         IF THISFORM.Gx_Mode = "DSP"
            RETURN .T.
         ENDIF
         IF .not. THISFORM. GXInLvl334
            RETURN .T.
         ENDIF
         THIS.WriteObj(THISFORM.GX_mode)
         IF THISFORM.GX_over_OK
            Response = .T.
         ELSE
            Response = .T.
         ENDIF
         IF Response
            IF ! THIS.AfterConfirm()
               RETURN .F.
            ENDIF
            THISFORM. gx_334insert = IIF(THISFORM.Gx_mode = "INS",.T.,.F.)
            THISFORM.gx_insert = THISFORM. gx_334insert
            THISFORM.GX_after_trn = 1
            THISFORM.GX_atrn_mode = THISFORM.GX_mode
            IF THIS.CheckTables()
               IF ! THIS.WriteToTbl(THISFORM.Gx_mode)
                  THISFORM. gx_334insert = .F.
                  THISFORM.gx_insert = THISFORM. gx_334insert
                  THISFORM.GX_lastvld = 0
                  THISFORM.GX_after_trn = 0
                  THISFORM.UpdForm
                  RETURN .F.
               ENDIF
               THISFORM. cCT303A2902 .UpdObj(THISFORM.Gx_Mode)
               THIS.After(THISFORM.GX_mode)
            ELSE
               THISFORM. gx_334insert = .F.
               THISFORM.gx_insert = THISFORM. gx_334insert
               THISFORM.GX_lastvld = 0
               THISFORM.GX_after_trn = 0
               THISFORM.UpdForm
               RETURN .F.
            ENDIF
         ELSE
            RETURN .F.
         ENDIF
      RETURN .T.
      ENDPROC
      PROCEDURE LoadObj(gxLoadType)
         LOCAL gxO_Area, gxO_Rec, gx_UseTblVar
         gxO_Area = SELECT()
         IF THISFORM.Gx_mode = "INS"
         ENDIF
         CGXEditBox ::LoadObj(gxLoadType)
         SELECT(gxO_Area)
      ENDPROC
      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03032,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA2899ComFc = THISFORM.A2899ComFc
            Gx_err = GX_DB_SetDate( HStmt_T03032,2,@AuxA2899ComFc,0)
            THISFORM.A2899ComFc = AuxA2899ComFc
            AuxA2900ComFc = THISFORM.A2900ComFc
            Gx_err = GX_DB_SetStr( HStmt_T03032,3,AuxA2900ComFc,1,0)
            THISFORM.A2900ComFc = AuxA2900ComFc
            AuxA2901ComFc = THISFORM.A2901ComFc
            Gx_err = GX_DB_SetInt( HStmt_T03032,4,@AuxA2901ComFc,0)
            THISFORM.A2901ComFc = AuxA2901ComFc
            AuxA2902ComFc = THISFORM.A2902ComFc
            Gx_err = GX_DB_SetLong( HStmt_T03032,5,@AuxA2902ComFc,0)
            THISFORM.A2902ComFc = AuxA2902ComFc
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03032) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03032 = Gx_err
            THISFORM.GX_DB_GetT03032_01 ()
            IF .NOT. THISFORM.T03032 <> 103
               DO GX_ERRMW WITH "COMIDA reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03032 = 101 .OR. THISFORM.Z2903ComPe <> THISFORM.Buf_T03032_2903ComPerDde
               DO GX_ERRMW WITH "COMIDA fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03036" , @HStmt_T03036 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOMIDAL","T03036","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03036) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [COMIDA] ([EmpCod], [ComFch], [ComFcSer], [ComFcSuc], [ComFcNro], [ComPerDde], "
                  cmdbuf = cmdbuf + "  [ComPerHta], [ComObs]) VALUES (?, ?, ?, ?, ?, ?, ?, ?) "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03036,cmdbuf)
                  THISFORM.GX_DB_BindParmT03036_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03036,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2899ComFc = THISFORM.A2899ComFc
               Gx_err = GX_DB_SetDate( HStmt_T03036,2,@AuxA2899ComFc,0)
               THISFORM.A2899ComFc = AuxA2899ComFc
               AuxA2900ComFc = THISFORM.A2900ComFc
               Gx_err = GX_DB_SetStr( HStmt_T03036,3,AuxA2900ComFc,1,0)
               THISFORM.A2900ComFc = AuxA2900ComFc
               AuxA2901ComFc = THISFORM.A2901ComFc
               Gx_err = GX_DB_SetInt( HStmt_T03036,4,@AuxA2901ComFc,0)
               THISFORM.A2901ComFc = AuxA2901ComFc
               AuxA2902ComFc = THISFORM.A2902ComFc
               Gx_err = GX_DB_SetLong( HStmt_T03036,5,@AuxA2902ComFc,0)
               THISFORM.A2902ComFc = AuxA2902ComFc
               AuxA2903ComPe = THISFORM.A2903ComPe
               Gx_err = GX_DB_SetDate( HStmt_T03036,6,@AuxA2903ComPe,0)
               THISFORM.A2903ComPe = AuxA2903ComPe
               AuxA2904ComPe = THISFORM.A2904ComPe
               Gx_err = GX_DB_SetDate( HStmt_T03036,7,@AuxA2904ComPe,0)
               THISFORM.A2904ComPe = AuxA2904ComPe
               AuxA2906ComOb = THISFORM.A2906ComOb
               Gx_err = GX_DB_SetStr( HStmt_T03036,8,AuxA2906ComOb,999,0)
               THISFORM.A2906ComOb = AuxA2906ComOb
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03036) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03036 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03036) ,  ,  ,  , CS_SQLSRV , 0 )
               IF THISFORM.T03036 <> 0
                  DO GX_ERRMW WITH "Ya existe el registro"
                  RETURN .F.
               ENDIF
            CASE Gx_mode = 'UPD'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03037" , @HStmt_T03037 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOMIDAL","T03037","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03037) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " UPDATE [COMIDA] SET [ComPerDde]=?, [ComPerHta]=?, [ComObs]=?  WHERE [EmpCod] = ? "
                  cmdbuf = cmdbuf + "  AND [ComFch] = ? AND [ComFcSer] = ? AND [ComFcSuc] = ? AND [ComFcNro] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03037,cmdbuf)
                  THISFORM.GX_DB_BindParmT03037_01 ()
               ENDIF
               AuxA2903ComPe = THISFORM.A2903ComPe
               Gx_err = GX_DB_SetDate( HStmt_T03037,1,@AuxA2903ComPe,0)
               THISFORM.A2903ComPe = AuxA2903ComPe
               AuxA2904ComPe = THISFORM.A2904ComPe
               Gx_err = GX_DB_SetDate( HStmt_T03037,2,@AuxA2904ComPe,0)
               THISFORM.A2904ComPe = AuxA2904ComPe
               AuxA2906ComOb = THISFORM.A2906ComOb
               Gx_err = GX_DB_SetStr( HStmt_T03037,3,AuxA2906ComOb,999,0)
               THISFORM.A2906ComOb = AuxA2906ComOb
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03037,4,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2899ComFc = THISFORM.A2899ComFc
               Gx_err = GX_DB_SetDate( HStmt_T03037,5,@AuxA2899ComFc,0)
               THISFORM.A2899ComFc = AuxA2899ComFc
               AuxA2900ComFc = THISFORM.A2900ComFc
               Gx_err = GX_DB_SetStr( HStmt_T03037,6,AuxA2900ComFc,1,0)
               THISFORM.A2900ComFc = AuxA2900ComFc
               AuxA2901ComFc = THISFORM.A2901ComFc
               Gx_err = GX_DB_SetInt( HStmt_T03037,7,@AuxA2901ComFc,0)
               THISFORM.A2901ComFc = AuxA2901ComFc
               AuxA2902ComFc = THISFORM.A2902ComFc
               Gx_err = GX_DB_SetLong( HStmt_T03037,8,@AuxA2902ComFc,0)
               THISFORM.A2902ComFc = AuxA2902ComFc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03037) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03037 = Gx_err
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03037) ,  ,  ,  , CS_SQLSRV , 0 )
            CASE Gx_mode = 'DLT'
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03038" , @HStmt_T03038 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TCOMIDAL","T03038","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03038) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [COMIDA]  WHERE [EmpCod] = ? AND [ComFch] = ? AND [ComFcSer] = ? AND "
                  cmdbuf = cmdbuf + "  [ComFcSuc] = ? AND [ComFcNro] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03038,cmdbuf)
                  THISFORM.GX_DB_BindParmT03038_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03038,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA2899ComFc = THISFORM.A2899ComFc
               Gx_err = GX_DB_SetDate( HStmt_T03038,2,@AuxA2899ComFc,0)
               THISFORM.A2899ComFc = AuxA2899ComFc
               AuxA2900ComFc = THISFORM.A2900ComFc
               Gx_err = GX_DB_SetStr( HStmt_T03038,3,AuxA2900ComFc,1,0)
               THISFORM.A2900ComFc = AuxA2900ComFc
               AuxA2901ComFc = THISFORM.A2901ComFc
               Gx_err = GX_DB_SetInt( HStmt_T03038,4,@AuxA2901ComFc,0)
               THISFORM.A2901ComFc = AuxA2901ComFc
               AuxA2902ComFc = THISFORM.A2902ComFc
               Gx_err = GX_DB_SetLong( HStmt_T03038,5,@AuxA2902ComFc,0)
               THISFORM.A2902ComFc = AuxA2902ComFc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03038) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03038 = Gx_err
               THISFORM.T03032 = iif( THISFORM.T03038 = 0 , 104 , THISFORM.T03038 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03038) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = THISFORM.A2900ComFc + " " + GXTrnsfm(THISFORM.A2901ComFc,"@L 9999" ) + "-" + GXTrnsfm(THISFORM.A2902ComFc,"@L 99999999" )
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV26Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "AUSEN" , Aux1 , "COMIDA" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV26Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT303V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 334 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.U148F2 ()
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
   ENDDEFINE
