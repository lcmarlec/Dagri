         ENDIF
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_R05075) ,  ,  ,  , CS_SQLSRV ,  )
