            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07285) ,  ,  ,  , CS_SQLSRV ,  )
            ENDDO
            THISFORM.W07285 = Gx_err
            THISFORM.GX_DB_GetW07285_01 ()
            DO WHILE THISFORM.W07285 <> 101
               THISFORM.A2EmpCod = THISFORM.Buf_W07285_2EmpCod
               THISFORM.A198PCtaNr = THISFORM.Buf_W07285_198PCtaNro
               THISFORM.A199CtaNro = THISFORM.Buf_W07285_199CtaNro
               THISFORM.A200CtaDes = THISFORM.Buf_W07285_200CtaDes
               THISFORM.AV53GXLvl1 = 1
               THISFORM.AV33Ctadsc = THISFORM.A200CtaDes
               * Check if program is canceled.
               DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
            Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W07285) ,  ,  ,  , CS_SQLSRV ,  )
            IF THISFORM.AV53GXLvl1 = 0
               THISFORM.AV33Ctadsc = "Cuenta Inexistente "
            ENDIF
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
         RETURN .T.
         THISFORM.EndEvent()
