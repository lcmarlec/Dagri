      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T03444,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA150EntGru = THISFORM.A150EntGru
            Gx_err = GX_DB_SetStr( HStmt_T03444,2,AuxA150EntGru,2,0)
            THISFORM.A150EntGru = AuxA150EntGru
            AuxA120EntCod = THISFORM.A120EntCod
            Gx_err = GX_DB_SetLong( HStmt_T03444,3,@AuxA120EntCod,0)
            THISFORM.A120EntCod = AuxA120EntCod
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T03444) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T03444 = Gx_err
            THISFORM.GX_DB_GetT03444_01 ()
            IF .NOT. THISFORM.T03444 <> 103
               DO GX_ERRMW WITH "ENTID reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T03444 = 101 .OR. THISFORM.Z153EntRaz <> THISFORM.Buf_T03444_153EntRaz
               DO GX_ERRMW WITH "ENTID fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
