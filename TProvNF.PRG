         * Search in Sub-File
         SELECT (THISFORM. cCT344S13 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT344S13 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT344S13 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S3307EntGr = THISFORM.A3307EntGr .AND. S3308EntCo = THISFORM.A3308EntCo
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT344S13 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT344S13 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S3307EntGr = THISFORM.A3307EntGr .AND. S3308EntCo = THISFORM.A3308EntCo
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT344S13 .Refresh()
               THISFORM. cCT344S13 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A3307EntGr = S3307EntGr
               THISFORM.A3308EntCo = S3308EntCo
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT344S13 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT344S13 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S3307EntGr = THISFORM.A3307EntGr .AND. S3308EntCo = THISFORM.A3308EntCo
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT344S13 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S150EntGru = THISFORM.A150EntGru .AND. S120EntCod = THISFORM.A120EntCod .AND. S3307EntGr = THISFORM.A3307EntGr .AND. S3308EntCo = THISFORM.A3308EntCo
            ENDDO
            IF sf_err != 0
               THISFORM. cCT344S13 .AppendRow()
               THISFORM. cCT344S13 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A150EntGru = S150EntGru
               THISFORM.A120EntCod = S120EntCod
               THISFORM.A3307EntGr = S3307EntGr
               THISFORM.A3308EntCo = S3308EntCo
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A150EntGru = S150EntGru
         THISFORM.A120EntCod = S120EntCod
         THISFORM.A3307EntGr = S3307EntGr
