      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T034412" , @HStmt_T034412 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPROVNF","T034412","",GX_CURSOR_TYPE_READONLY,@HStmt_T034412) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [EntGruTip], [EntCod], [EntGruDb], [EntCodDB] FROM [PROVES4] (NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? AND [EntGruTip] = ? AND [EntCod] = ? ORDER BY [EmpCod], [EntGruTip], "
                  cmdbuf = cmdbuf + "  [EntCod], [EntGruDb], [EntCodDB]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T034412,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T034412,7)
                  THISFORM.GX_DB_BindColsT034412_01 ()
                  THISFORM.GX_DB_BindParmT034412_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T034412,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA150EntGru = THISFORM.A150EntGru
               Gx_err = GX_DB_SetStr( HStmt_T034412,2,AuxA150EntGru,2,0)
               THISFORM.A150EntGru = AuxA150EntGru
               AuxA120EntCod = THISFORM.A120EntCod
               Gx_err = GX_DB_SetLong( HStmt_T034412,3,@AuxA120EntCod,0)
               THISFORM.A120EntCod = AuxA120EntCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T034412) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034412 = Gx_err
               THISFORM.GX_DB_GetT034412_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T034412 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034412) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T034412 = Gx_err
                  THISFORM.GX_DB_GetT034412_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T034412 <> 101
               BRK9K376 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT344S13.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T034412_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T034412_120EntCod = THISFORM.A120EntCod .AND. THISFORM.Buf_T034412_150EntGruTip = THISFORM.A150EntGru
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T034412) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T034412 = Gx_err
               THISFORM.GX_DB_GetT034412_01 ()
            ENDDO
         ENDIF
      ENDPROC
