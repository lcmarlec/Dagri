            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA3309EntR"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA3310EntC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCT344S13 = GETE('z:\temp') + '\' + SCT344S13
            ENDIF
            CREATE DBF (SCT344S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCT344S13) EXCLUSIVE ALIAS SCT344S13
            SET MULTILOCKS ON
            =CURSORSETPROP("Buffering", 3)
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCT344S13
