      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T03447" , @HStmt_T03447 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TPROVNF","T03447","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03447) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [ENTID] ([EntGruTip], [EntCod], [EmpCod], [EntRaz], [EntGruCod], [EntFan], "
                  cmdbuf = cmdbuf + "  [EntCont], [EntDom], [EntPaiCod], [EntPciCod], [EntMunCod], [EntPos], [EntTel], "
                  cmdbuf = cmdbuf + "  [EntFax], [EntCui], [EntEMa], [EntFpa], [EntNIm], [EntOrd], [EntCIvCod], [EntObs], "
                  cmdbuf = cmdbuf + "  [EntDesc], [EntFVt], [EntLocDsc], [EntGCo], [EntRetGan], [Enttd], [EntOrdObl], [EntObsFc], "
                  cmdbuf = cmdbuf + "  [EntIBNro], [EntIBRee], [EntIBRet], [EntSURet], [CtaCliCod], [EntPIBFR], [EntDcM], "
                  cmdbuf = cmdbuf + "  [EntCruz], [EntMen], [EntCred], [EntSer], [EntInhab], [entInhMot], [entCtrCai], "
                  cmdbuf = cmdbuf + "  [EntCuo], [EntCuoId], [entCtrIns], [EntId], [EntAba], [EntEAN], [EntRetGHa], [EntProt], "
                  cmdbuf = cmdbuf + "  [EntNoFac], [EntInd], [EntCPIB], [EntCRIB], [EntTLprc], [EntEsp], [EntRucTpo], [EntRucNro], "
                  cmdbuf = cmdbuf + "  [EntGanRed], [EntGanRDe], [EntGanRHa], [EntFVE], [EntNoIIBB], [EntTDoc], [EntRI3164], "
                  cmdbuf = cmdbuf + "  [EntReqDoc], [EntReqOk], [EntCPD], [EntIbLM], [EntPrMiEx], [EntPrMEF], [EntIBJur], "
                  cmdbuf = cmdbuf + "  [CPaCod], [EntCaRet], [EntExt], [EntRetGDe], [EntLapRet], [EntKrikos], [EntMonCat], "
                  cmdbuf = cmdbuf + "  [EntAlqMon], [EntAlqCot], [EntAlqImM], [EntPrcPac], [EntLiF], [EntBon], [EntLeye], "
