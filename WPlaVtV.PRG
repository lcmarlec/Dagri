      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01262" , @HStmt_W01262 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WPLAVTV","W01262","",GX_CURSOR_TYPE_READONLY,@HStmt_W01262) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[PlVGruTip] AS PlVGruTip, T1.[PlVEntCod] AS PlVEntCod, T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T1.[FamSubCod], T1.[FamCod], T4.[PlvObs], T2.[ArtVtaPrc], T2.[ArtVta], T1.[PlVPrcReal], "
                  cmdbuf = cmdbuf + "  T1.[PlVPrc], T2.[ArtDsc], T1.[PlvInd], T3.[EntRaz] AS PlVEntRaz FROM ((([PLAVTA1] "
                  cmdbuf = cmdbuf + "  T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  AND T2.[FamCod] = T1.[FamCod] AND T2.[FamSubCod] = T1.[FamSubCod] AND T2.[ArtCod] "
                  cmdbuf = cmdbuf + "  = T1.[ArtCod]) LEFT JOIN [ENTID] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] "
                  cmdbuf = cmdbuf + "  = T1.[PlVGruTip] AND T3.[EntCod] = T1.[PlVEntCod]) LEFT JOIN [PLAVTA] T4 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T4.[EmpCod] = T1.[EmpCod] AND T4.[PlVGruTip] = T1.[PlVGruTip] AND T4.[PlVEntCod] "
                  cmdbuf = cmdbuf + "  = T1.[PlVEntCod]) WHERE T1.[EmpCod] = ? and T1.[PlVGruTip] = ? and T1.[PlVEntCod] "
                  cmdbuf = cmdbuf + "  = ? ORDER BY T1.[EmpCod], T1.[PlVGruTip], T1.[PlVEntCod], T1.[PlvInd]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01262,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01262,15)
                  THISFORM.GX_DB_BindColsW01262_01 ()
                  THISFORM.GX_DB_BindParmW01262_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01262,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA836PlVGru = THISFORM.A836PlVGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01262,2,AuxA836PlVGru,2,0)
               THISFORM.A836PlVGru = AuxA836PlVGru
               AuxA837PlVEnt = THISFORM.A837PlVEnt
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01262,3,@AuxA837PlVEnt,0)
               THISFORM.A837PlVEnt = AuxA837PlVEnt
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01262 = Gx_err
               THISFORM.GX_DB_GetW01262_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_date = DATE()
               THISFORM.AV21Pgmnam = "WPlaVtV"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01262 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01262) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01262 = Gx_err
                  THISFORM.GX_DB_GetW01262_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01262 <> 101
               BRKV3I2 = .F.
               THISFORM.A5ArtCod = THISFORM.Buf_W01262_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01262_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01262_3FamCod
               THISFORM.A1885PlvOb = Gx_lvchar_to_char( THISFORM.Buf_W01262_1885PlvObs )
               THISFORM.A31ArtVtaP = THISFORM.Buf_W01262_31ArtVtaPrc
               THISFORM.A28ArtVta = THISFORM.Buf_W01262_28ArtVta
               THISFORM.A1328PlVPr = THISFORM.Buf_W01262_1328PlVPrcReal
               THISFORM.A839PlVPrc = THISFORM.Buf_W01262_839PlVPrc
               THISFORM.A6ArtDsc = THISFORM.Buf_W01262_6ArtDsc
               THISFORM.A1925PlvIn = THISFORM.Buf_W01262_1925PlvInd
               THISFORM.A838PlVEnt = THISFORM.Buf_W01262_838PlVEntRaz
               THISFORM.A31ArtVtaP = THISFORM.Buf_W01262_31ArtVtaPrc
               THISFORM.A28ArtVta = THISFORM.Buf_W01262_28ArtVta
               THISFORM.A6ArtDsc = THISFORM.Buf_W01262_6ArtDsc
               THISFORM.A838PlVEnt = THISFORM.Buf_W01262_838PlVEntRaz
               THISFORM.A1885PlvOb = Gx_lvchar_to_char( THISFORM.Buf_W01262_1885PlvObs )
               GX_SFLOAD = 0
               THISFORM.U17V3I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01262) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01262 = Gx_err
               THISFORM.GX_DB_GetW01262_01 ()
            ENDDO
         ENDIF
      ENDPROC
