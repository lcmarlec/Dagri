         REPLACE sA1109tECh WITH THISFORM.A1109tEChL
         REPLACE sA1110tEch WITH THISFORM.A1110tEchT
         REPLACE sA1111tEch WITH THISFORM.A1111tEchC
         REPLACE sA1112tEch WITH THISFORM.A1112tEchC
         REPLACE sA1113tEch WITH THISFORM.A1113tEchN
         REPLACE sA1114tEch WITH THISFORM.A1114tEchN
         REPLACE sA1117tECh WITH THISFORM.A1117tEChF
      ENDPROC
      PROCEDURE LoadVar
         SELECT (THIS.GX_SfAlias)
         THISFORM.A1109tEChL = sA1109tECh
         THISFORM.A1110tEchT = sA1110tEch
         THISFORM.A1111tEchC = sA1111tEch
         THISFORM.A1112tEchC = sA1112tEch
         THISFORM.A1113tEchN = sA1113tEch
         THISFORM.A1114tEchN = sA1114tEch
         THISFORM.A1117tEChF = sA1117tECh
      ENDPROC
      PROCEDURE LoadVarFromCtrl
      ENDPROC
      PROCEDURE ClearRow
         SELECT (THIS.GX_SfAlias)
         THISFORM.A1109tEChL = 0
         THISFORM.A1110tEchT = SPACE(1)
         THISFORM.A1111tEchC = 0
         THISFORM.A1112tEchC = SPACE(12)
         THISFORM.A1113tEchN = SPACE(10)
         THISFORM.A1114tEchN = 0
         THISFORM.A1117tEChF = CTOD("  /  /  ")
         THIS.SaveTemp()
      ENDPROC
      PROCEDURE When
         THISFORM.GX_SetFocus_Allowed = .F.
         IF (RECCOUNT() - THIS.GX_del_rec) <= 0 .OR. .NOT. THIS.SomethingAccepted() .or. THISFORM.GX_Refresh = 1
            THIS.Columns(1).Ctrl1.GotFocus()
         ENDIF
         THISFORM.FormRefresh( .F. , .T. )
         THISFORM.GX_SetFocus_Allowed = .T.
         IF THISFORM.GX_Curr_Level != 2
            THIS.gx_old_row = -1
         ENDIF
         RETURN CGxSubfile::When()
      ENDPROC
      PROCEDURE Valid
         THISFORM.GX_SetFocus_Allowed = .F.
         THISFORM.GX_SetFocus_Allowed = .T.
         CGXSubFile::Valid
      ENDPROC
      PROCEDURE BeforeRowChange
      ENDPROC
      PROCEDURE AfterRowChange
      ENDPROC
      PROCEDURE DblClick
         THISFORM.U11V8V2 ()
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE Click
         THISFORM.FormRefresh( .T. , .F. )
      ENDPROC
      PROCEDURE CallRefreshEvent
         THISFORM.cCW319S20.GXRefreshEvt ()
      ENDPROC
      PROCEDURE GXReposSf
         IF THISFORM.GX_Refresh = 1
            SELECT ( THISFORM.cCW319S20 .GX_SfAlias)
            GO TOP
            THISFORM.cCW319S20 .Refresh()
         ENDIF
         THISFORM. cCW319S20 .GXSetRepos( .F. )
      ENDPROC
      PROCEDURE NoDataMsg
         SELECT(THISFORM. cCW319S20 .GX_SfAlias)
         IF EOF()
            DO GX_MSGW WITH "No hay registros que cumplan la condicion"
         ELSE
            IF GXTB.GetMessageValue() == "No hay registros que cumplan la condicion"
               DO GX_MSGW WITH ""
            ENDIF
         ENDIF
      ENDPROC
