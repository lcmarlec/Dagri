      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03192" , @HStmt_W03192 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX03F2","W03192","",GX_CURSOR_TYPE_READONLY,@HStmt_W03192) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [tECHNroInt], [tEChFchDeb], [tEchNroReg], [tEchNroCh], [tEchCtaChN], "
                  cmdbuf = cmdbuf + "  [tEchCtaCh], [tEchTip], [tEChLin] FROM [PENCHE1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and [tECHNroInt] = ? and [tEChLin] >= ?) AND ([tEchTip] like ?) AND ([tEchCtaCh] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([tEchCtaChN] like ?) AND ([tEchNroCh] like ?) ORDER BY [EmpCod], [tECHNroInt], "
                  cmdbuf = cmdbuf + "  [tEChLin], [tEchTip], [tEchCtaCh]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03192,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03192,9)
                  THISFORM.GX_DB_BindColsW03192_01 ()
                  THISFORM.GX_DB_BindParmW03192_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03192,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1103tECHN = THISFORM.A1103tECHN
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03192,2,@AuxA1103tECHN,0)
               THISFORM.A1103tECHN = AuxA1103tECHN
               AuxAV5C1109 = THISFORM.AV5C1109
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03192,3,@AuxAV5C1109,0)
               THISFORM.AV5C1109 = AuxAV5C1109
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03192,4,PADR( TRIM(THISFORM.AV6C1110),1, '%'),LEN(PADR( TRIM(THISFORM.AV6C1110),1, '%')),0)
               AuxAV7C1111 = THISFORM.AV7C1111
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03192,5,@AuxAV7C1111,0)
               THISFORM.AV7C1111 = AuxAV7C1111
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03192,6,PADR( TRIM(THISFORM.AV8C1112),12, '%'),LEN(PADR( TRIM(THISFORM.AV8C1112),12, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03192,7,PADR( TRIM(THISFORM.AV9C1113),10, '%'),LEN(PADR( TRIM(THISFORM.AV9C1113),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03192 = Gx_err
               THISFORM.GX_DB_GetW03192_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03192 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03192) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03192 = Gx_err
                  THISFORM.GX_DB_GetW03192_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
