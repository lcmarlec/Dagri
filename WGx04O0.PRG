      PROCEDURE CreateTemp
         LOCAL SCW470S16
         SCW470S16 = ""
         IF USED( "SCW470S16" )
            SELECT SCW470S16
            SCW470S16 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW470S16
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1469CtaC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 6
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1470CtaC"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 40
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW470S16 = GETE('z:\temp') + '\' + SCW470S16
            ENDIF
            CREATE DBF (SCW470S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW470S16) EXCLUSIVE ALIAS SCW470S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW470S16
         THIS.GX_SfAlias = "SCW470S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04702" , @HStmt_W04702 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX04O0","W04702","",GX_CURSOR_TYPE_READONLY,@HStmt_W04702) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [CtaCliTel], [CtaCliCui], [CtaCliRaz], [CtaCliCod], [EmpCod] FROM [CTACLI] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [CtaCliCod] >= ?) AND ([CtaCliRaz] "
                  cmdbuf = cmdbuf + "  like ?) AND ([CtaCliTel] like ?) AND ([CtaCliCui] >= ?) ORDER BY [EmpCod], [CtaCliCod] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04702,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04702,9)
                  THISFORM.GX_DB_BindColsW04702_01 ()
                  THISFORM.GX_DB_BindParmW04702_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04702,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C1469 = THISFORM.AV6C1469
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04702,2,@AuxAV6C1469,0)
               THISFORM.AV6C1469 = AuxAV6C1469
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04702,3,PADR( TRIM(THISFORM.AV7C1470),40, '%'),LEN(PADR( TRIM(THISFORM.AV7C1470),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W04702,4,PADR( TRIM(THISFORM.AV8C1471),40, '%'),LEN(PADR( TRIM(THISFORM.AV8C1471),40, '%')),0)
               AuxAV9C1472 = THISFORM.AV9C1472
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W04702,5,@AuxAV9C1472,0)
               THISFORM.AV9C1472 = AuxAV9C1472
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04702 = Gx_err
               THISFORM.GX_DB_GetW04702_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04702 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04702) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04702 = Gx_err
                  THISFORM.GX_DB_GetW04702_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04702 <> 101
               BRKVD22 = .F.
               THISFORM.A1471CtaCl = THISFORM.Buf_W04702_1471CtaCliTel
               THISFORM.A1472CtaCl = THISFORM.Buf_W04702_1472CtaCliCui
               THISFORM.A1470CtaCl = THISFORM.Buf_W04702_1470CtaCliRaz
               THISFORM.A1469CtaCl = THISFORM.Buf_W04702_1469CtaCliCod
               THISFORM.A2EmpCod = THISFORM.Buf_W04702_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VD22 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04702 = Gx_err
               THISFORM.GX_DB_GetW04702_01 ()
            ENDDO
         ENDIF
      ENDPROC
