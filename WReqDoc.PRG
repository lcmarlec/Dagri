         * Refresh Routine
         IF THISFORM.AV28Entcod <> 0
            THISFORM.AV38Mensaj = "El proveedor tiene Pendientes de Pago "
            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08573" , @HStmt_W08573 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WREQDOC","W08573","",GX_CURSOR_TYPE_READONLY,@HStmt_W08573) ,  ,  ,  , CS_SQLSRV ,  )
               cmdbuf = " SELECT [DcCNroInt], [EmpCod], [EntGruTip], [EntCod], [DccTipRed], [DcCEst], [DcCTotSld], "
               cmdbuf = cmdbuf + "  [DcCNro], [DcCSuc], [DccSer] FROM [DCCOM] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] "
               cmdbuf = cmdbuf + "  = ?) AND ([EntGruTip] = ?) AND ([EntCod] = ?) AND ([DccTipRed] <> 'FC') AND ([DcCEst] "
               cmdbuf = cmdbuf + "  = 1) ORDER BY [EmpCod], [DcCNroInt]  "
               THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08573,cmdbuf)
               THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08573,15)
               THISFORM.GX_DB_BindColsW08573_01 ()
               THISFORM.GX_DB_BindParmW08573_01 ()
            ENDIF
