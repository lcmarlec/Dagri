               THISFORM.A352DcCNro = THISFORM.Buf_W08573_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W08573_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W08573_349DccSer
