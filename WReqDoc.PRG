                  cmdbuf = cmdbuf + "  T1.[EntGruTip] AND T2.[EntCod] = T1.[EntCod]) WHERE (T1.[EmpCod] = ?) AND (T1.[DccSer] "
                  cmdbuf = cmdbuf + "  = ? or ? = ' ') AND (T1.[DcCSuc] = ? or ? = 0) AND (T1.[DcCNro] >= ?) AND (T1.[DcCEst] "
                  cmdbuf = cmdbuf + "  > 0) AND (T1.[DcCEst] < 9) AND (T1.[DcCFec] >= ?) AND (T1.[DccReqPen] = ? or ? = "
                  cmdbuf = cmdbuf + "  9) AND (T1.[EntCod] = ? or ? = 0) AND (T1.[DccTipRed] = 'FC') AND (T2.[EntReqDoc] "
                  cmdbuf = cmdbuf + "  = 1) ORDER BY T1.[EmpCod], T1.[DcCNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08572,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08572,15)
                  THISFORM.GX_DB_BindColsW08572_01 ()
                  THISFORM.GX_DB_BindParmW08572_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08572,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV36Serie = THISFORM.AV36Serie
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08572,2,AuxAV36Serie,1,0)
               THISFORM.AV36Serie = AuxAV36Serie
               AuxAV36Serie = THISFORM.AV36Serie
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08572,3,AuxAV36Serie,1,0)
               THISFORM.AV36Serie = AuxAV36Serie
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08572,4,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV20Dessuc = THISFORM.AV20Dessuc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08572,5,@AuxAV20Dessuc,0)
               THISFORM.AV20Dessuc = AuxAV20Dessuc
               AuxAV24Desnro = THISFORM.AV24Desnro
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08572,6,@AuxAV24Desnro,0)
               THISFORM.AV24Desnro = AuxAV24Desnro
               AuxAV34Rorfch = THISFORM.AV34Rorfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08572,7,@AuxAV34Rorfch,0)
               THISFORM.AV34Rorfch = AuxAV34Rorfch
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08572,8,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV23Estado = THISFORM.AV23Estado
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08572,9,@AuxAV23Estado,0)
               THISFORM.AV23Estado = AuxAV23Estado
               AuxAV28Entcod = THISFORM.AV28Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08572,10,@AuxAV28Entcod,0)
               THISFORM.AV28Entcod = AuxAV28Entcod
               AuxAV28Entcod = THISFORM.AV28Entcod
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08572,11,@AuxAV28Entcod,0)
               THISFORM.AV28Entcod = AuxAV28Entcod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08572 = Gx_err
               THISFORM.GX_DB_GetW08572_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV41Pgmnam = "WReqDoc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08572 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08572) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08572 = Gx_err
                  THISFORM.GX_DB_GetW08572_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08572 <> 101
               BRKVNT2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W08572_150EntGruTip
               THISFORM.A348DcCTip = THISFORM.Buf_W08572_348DcCTip
               THISFORM.A2611EntRe = THISFORM.Buf_W08572_2611EntReqDoc
               THISFORM.A347DcCFec = THISFORM.Buf_W08572_347DcCFec
               THISFORM.A2EmpCod = THISFORM.Buf_W08572_2EmpCod
               THISFORM.A346DcCNro = THISFORM.Buf_W08572_346DcCNroInt
               THISFORM.A2610DccRe = THISFORM.Buf_W08572_2610DccReqPen
               THISFORM.A373DcCEst = THISFORM.Buf_W08572_373DcCEst
               THISFORM.A153EntRaz = THISFORM.Buf_W08572_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W08572_120EntCod
               THISFORM.A2278DcCFe = THISFORM.Buf_W08572_2278DcCFecOri
               THISFORM.A352DcCNro = THISFORM.Buf_W08572_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W08572_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W08572_349DccSer
               THISFORM.A1322DccTi = THISFORM.Buf_W08572_1322DccTipRed
               THISFORM.A2611EntRe = THISFORM.Buf_W08572_2611EntReqDoc
               THISFORM.A153EntRaz = THISFORM.Buf_W08572_153EntRaz
               GX_SFLOAD = 0
               THISFORM.U19VNT2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08572 = Gx_err
               THISFORM.GX_DB_GetW08572_01 ()
            ENDDO
         ENDIF
