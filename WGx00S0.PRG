      PROCEDURE CreateTemp
         LOCAL SCW210S20
         SCW210S20 = ""
         IF USED( "SCW210S20" )
            SELECT SCW210S20
            SCW210S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW210S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA291C10FE"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA292C10TI"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA293C10NU"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 13
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA294C10CO"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 5
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA296C10CA"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA303C10PL"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 4
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW210S20 = GETE('z:\temp') + '\' + SCW210S20
            ENDIF
            CREATE DBF (SCW210S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW210S20) EXCLUSIVE ALIAS SCW210S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW210S20
         THIS.GX_SfAlias = "SCW210S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02102" , @HStmt_W02102 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00S0","W02102","",GX_CURSOR_TYPE_READONLY,@HStmt_W02102) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [C10RAZPRO], [C10CUIPRO], [C10PLAZOP], [C10CATIVP], [C10CODPRO], [C10NUMDOC], "
                  cmdbuf = cmdbuf + "  [C10TIPDOC], [C10FECDOC] FROM [DC1000] (FASTFIRSTROW NOLOCK) WHERE ([C10FECDOC] "
                  cmdbuf = cmdbuf + "  >= ? and [C10TIPDOC] >= ?) AND ([C10NUMDOC] like ?) AND ([C10CODPRO] >= ?) AND ([C10RAZPRO] "
                  cmdbuf = cmdbuf + "  like ?) AND ([C10CATIVP] >= ?) AND ([C10CUIPRO] like ?) ORDER BY [C10FECDOC], [C10TIPDOC], "
                  cmdbuf = cmdbuf + "  [C10NUMDOC], [C10CODPRO]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02102,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02102,8)
                  THISFORM.GX_DB_BindColsW02102_01 ()
                  THISFORM.GX_DB_BindParmW02102_01 ()
               ENDIF
               AuxAV21C291 = THISFORM.AV21C291
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02102,1,@AuxAV21C291,0)
               THISFORM.AV21C291 = AuxAV21C291
               AuxAV20C292 = THISFORM.AV20C292
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02102,2,@AuxAV20C292,0)
               THISFORM.AV20C292 = AuxAV20C292
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02102,3,PADR( TRIM(THISFORM.AV19C293),13, '%'),LEN(PADR( TRIM(THISFORM.AV19C293),13, '%')),0)
               AuxAV18C294 = THISFORM.AV18C294
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02102,4,@AuxAV18C294,0)
               THISFORM.AV18C294 = AuxAV18C294
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02102,5,PADR( TRIM(THISFORM.AV17C295),30, '%'),LEN(PADR( TRIM(THISFORM.AV17C295),30, '%')),0)
               AuxAV16C296 = THISFORM.AV16C296
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02102,6,@AuxAV16C296,0)
               THISFORM.AV16C296 = AuxAV16C296
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02102,7,PADR( TRIM(THISFORM.AV15C297),14, '%'),LEN(PADR( TRIM(THISFORM.AV15C297),14, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02102 = Gx_err
               THISFORM.GX_DB_GetW02102_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02102 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02102) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02102 = Gx_err
                  THISFORM.GX_DB_GetW02102_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02102 <> 101
               BRKV5U2 = .F.
               THISFORM.A295C10RAZ = THISFORM.Buf_W02102_295C10RAZPRO
               THISFORM.A297C10CUI = THISFORM.Buf_W02102_297C10CUIPRO
               THISFORM.A303C10PLA = THISFORM.Buf_W02102_303C10PLAZOP
               THISFORM.A296C10CAT = THISFORM.Buf_W02102_296C10CATIVP
               THISFORM.A294C10COD = THISFORM.Buf_W02102_294C10CODPRO
               THISFORM.A293C10NUM = THISFORM.Buf_W02102_293C10NUMDOC
               THISFORM.A292C10TIP = THISFORM.Buf_W02102_292C10TIPDOC
               THISFORM.A291C10FEC = THISFORM.Buf_W02102_291C10FECDOC
               GX_SFLOAD = 0
               THISFORM.U12V5U2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02102) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02102 = Gx_err
               THISFORM.GX_DB_GetW02102_01 ()
            ENDDO
         ENDIF
      ENDPROC
