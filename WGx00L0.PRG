            GX_STRUCT[ 2 ,1]= "sA246ACDes"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 30
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW204S16 = GETE('z:\temp') + '\' + SCW204S16
            ENDIF
            CREATE DBF (SCW204S16) FROM ARRAY GX_STRUCT
            USE
            USE (SCW204S16) EXCLUSIVE ALIAS SCW204S16
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW204S16
         THIS.GX_SfAlias = "SCW204S16"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02042" , @HStmt_W02042 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00L0","W02042","",GX_CURSOR_TYPE_READONLY,@HStmt_W02042) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [ACCodImp], [ACFamCod], [ACFamSub], [ACDesArt], [ACCodArt] FROM [DBAR1000] "
                  cmdbuf = cmdbuf + "  (FASTFIRSTROW NOLOCK) WHERE ([ACCodArt] >= ?) AND ([ACDesArt] like ?) AND ([ACCodImp] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([ACFamCod] >= ?) AND ([ACFamSub] >= ?) ORDER BY [ACCodArt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02042,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02042,8)
                  THISFORM.GX_DB_BindColsW02042_01 ()
                  THISFORM.GX_DB_BindParmW02042_01 ()
               ENDIF
               AuxAV19C245 = THISFORM.AV19C245
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02042,1,@AuxAV19C245,0)
               THISFORM.AV19C245 = AuxAV19C245
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02042,2,PADR( TRIM(THISFORM.AV18C246),30, '%'),LEN(PADR( TRIM(THISFORM.AV18C246),30, '%')),0)
               AuxAV17C247 = THISFORM.AV17C247
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02042,3,@AuxAV17C247,0)
               THISFORM.AV17C247 = AuxAV17C247
               AuxAV16C248 = THISFORM.AV16C248
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02042,4,@AuxAV16C248,0)
               THISFORM.AV16C248 = AuxAV16C248
               AuxAV15C249 = THISFORM.AV15C249
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02042,5,@AuxAV15C249,0)
               THISFORM.AV15C249 = AuxAV15C249
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02042 = Gx_err
               THISFORM.GX_DB_GetW02042_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02042 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02042) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02042 = Gx_err
                  THISFORM.GX_DB_GetW02042_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02042 <> 101
               BRKV5O2 = .F.
               THISFORM.A247ACCodI = THISFORM.Buf_W02042_247ACCodImp
               THISFORM.A248ACFamC = THISFORM.Buf_W02042_248ACFamCod
               THISFORM.A249ACFamS = THISFORM.Buf_W02042_249ACFamSub
               THISFORM.A246ACDesA = THISFORM.Buf_W02042_246ACDesArt
               THISFORM.A245ACCodA = THISFORM.Buf_W02042_245ACCodArt
               GX_SFLOAD = 0
               THISFORM.U12V5O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02042) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02042 = Gx_err
               THISFORM.GX_DB_GetW02042_01 ()
            ENDDO
         ENDIF
      ENDPROC
