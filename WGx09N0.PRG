      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09972" , @HStmt_W09972 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX09N0","W09972","",GX_CURSOR_TYPE_READONLY,@HStmt_W09972) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [PciCod], [cmcoef], [PaiCod], [CMAnio], [EntCui], [EmpCod] FROM [CM052] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] >= ? and [EntCui] >= ? and [CMAnio] >= ?) AND ([PaiCod] "
                  cmdbuf = cmdbuf + "  like ?) AND ([PciCod] like ?) AND ([cmcoef] >= ?) ORDER BY [EmpCod], [EntCui], [CMAnio], "
                  cmdbuf = cmdbuf + "  [PaiCod], [PciCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09972,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09972,9)
                  THISFORM.GX_DB_BindColsW09972_01 ()
                  THISFORM.GX_DB_BindParmW09972_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09972,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C166 = THISFORM.AV6C166
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09972,2,@AuxAV6C166,0)
               THISFORM.AV6C166 = AuxAV6C166
               AuxAV7C3011 = THISFORM.AV7C3011
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09972,3,@AuxAV7C3011,0)
               THISFORM.AV7C3011 = AuxAV7C3011
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09972,4,PADR( TRIM(THISFORM.AV8C631),4, '%'),LEN(PADR( TRIM(THISFORM.AV8C631),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W09972,5,PADR( TRIM(THISFORM.AV9C633),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C633),4, '%')),0)
               AuxAV10C3012 = THISFORM.AV10C3012
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09972,6,@AuxAV10C3012,0)
               THISFORM.AV10C3012 = AuxAV10C3012
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09972) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09972 = Gx_err
               THISFORM.GX_DB_GetW09972_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09972 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09972) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09972 = Gx_err
                  THISFORM.GX_DB_GetW09972_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09972 <> 101
               BRKVRP2 = .F.
               THISFORM.A633PciCod = THISFORM.Buf_W09972_633PciCod
               THISFORM.A3012cmcoe = THISFORM.Buf_W09972_3012cmcoef
               THISFORM.A631PaiCod = THISFORM.Buf_W09972_631PaiCod
               THISFORM.A3011CMAni = THISFORM.Buf_W09972_3011CMAnio
               THISFORM.A166EntCui = THISFORM.Buf_W09972_166EntCui
               THISFORM.A2EmpCod = THISFORM.Buf_W09972_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VRP2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09972) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09972 = Gx_err
               THISFORM.GX_DB_GetW09972_01 ()
            ENDDO
         ENDIF
      ENDPROC
