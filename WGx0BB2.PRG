         THISFORM.A3567TraCe = sA3567TraC
         THISFORM.A3568TraCe = THISFORM.cCW1227S18.Columns(2).Ctrl1.TextToVal(sA3568TraC,"char",2)
         THISFORM.A3569TraCe = THISFORM.cCW1227S18.Columns(3).Ctrl1.TextToVal(sA3569TraC,"char",1)
         THISFORM.A3570TraCe = sA3570TraC
      ENDPROC
