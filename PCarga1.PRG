         Gx_err = GX_DB_SetStr( HStmt_P11296,2,R3356CarNr,15,0)
         Gx_err = GX_DB_SetDate( HStmt_P11296,3,@R3357CarFc,0)
         Gx_err = GX_DB_SetInt( HStmt_P11296,4,@R3358CarOr,0)
         Gx_err = GX_DB_SetInt( HStmt_P11296,5,@R3359CarRu,0)
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_P11296) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         P11296 = Gx_err
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P11296) ,  ,  ,  , CS_SQLSRV ,  )
         IF P11296 = 1
            Gx_err = 1
            Gx_emsg = "Ya existe el registro"
         ELSE
            Gx_err = 0
            Gx_emsg = ""
         ENDIF
         R2EmpCod = W2EmpCod
         * End Insert
         LEVEL5 = .F.
         R2EmpCod = W2EmpCod
         * Check if program is canceled.
         DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
         IF UserCancel
            EXIT
         ENDIF
         * Exiting from a For First loop.
         EXIT
         IF UserCancel
            EXIT
         ENDIF
      ENDDO
      Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_P11295) ,  ,  ,  , CS_SQLSRV ,  )
      LEVEL4 = .F.
   ENDIF
   DO EPVD0
   RETURN
   DO EPVD0
   RETURN
   GX_retp = 0
* End Program

***********************
PROCEDURE EPVD0
***********************

   IF TYPE( "HConn_Default" ) = "N"
      IF GXCONNECTED
         Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV ,  )
      ENDIF
   ENDIF
   DO CDVD0
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN
