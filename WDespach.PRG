      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W07842" , @HStmt_W07842 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDESPACH","W07842","",GX_CURSOR_TYPE_READONLY,@HStmt_W07842) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DesCui], [DesTel], [DesRaz], [DesCod] FROM [DSPCHANT] (FASTFIRSTROW "
                  cmdbuf = cmdbuf + "  NOLOCK) WHERE ([EmpCod] = ?) AND ([DesRaz] like ?) ORDER BY [EmpCod], [DesCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W07842,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W07842,12)
                  THISFORM.GX_DB_BindColsW07842_01 ()
                  THISFORM.GX_DB_BindParmW07842_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W07842,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W07842,2,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W07842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07842 = Gx_err
               THISFORM.GX_DB_GetW07842_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV25Pgmnam = "WDespach"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W07842 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07842) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W07842 = Gx_err
                  THISFORM.GX_DB_GetW07842_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W07842 <> 101
               BRKVLS2 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W07842_2EmpCod
               THISFORM.A2347DesCu = THISFORM.Buf_W07842_2347DesCui
               THISFORM.A2346DesTe = THISFORM.Buf_W07842_2346DesTel
               THISFORM.A2344DesRa = THISFORM.Buf_W07842_2344DesRaz
               THISFORM.A2343DesCo = THISFORM.Buf_W07842_2343DesCod
               GX_SFLOAD = 0
               THISFORM.U17VLS2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W07842) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W07842 = Gx_err
               THISFORM.GX_DB_GetW07842_01 ()
            ENDDO
         ENDIF
      ENDPROC
