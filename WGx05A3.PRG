      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W05452" , @HStmt_W05452 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX05A3","W05452","",GX_CURSOR_TYPE_READONLY,@HStmt_W05452) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [CamPat], [CamTip], [CamFch] FROM [CAMACC] (FASTFIRSTROW NOLOCK) "
                  cmdbuf = cmdbuf + "  WHERE [EmpCod] = ? and [CamPat] = ? and [CamTip] = ? and [CamFch] >= ? ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod], [CamPat], [CamTip], [CamFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W05452,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W05452,9)
                  THISFORM.GX_DB_BindColsW05452_01 ()
                  THISFORM.GX_DB_BindParmW05452_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W05452,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA1664CamPa = THISFORM.A1664CamPa
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05452,2,AuxA1664CamPa,8,0)
               THISFORM.A1664CamPa = AuxA1664CamPa
               AuxA1672CamTi = THISFORM.A1672CamTi
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W05452,3,AuxA1672CamTi,2,0)
               THISFORM.A1672CamTi = AuxA1672CamTi
               AuxAV5C1673 = THISFORM.AV5C1673
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W05452,4,@AuxAV5C1673,0)
               THISFORM.AV5C1673 = AuxAV5C1673
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W05452) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W05452 = Gx_err
               THISFORM.GX_DB_GetW05452_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W05452 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W05452) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W05452 = Gx_err
                  THISFORM.GX_DB_GetW05452_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W05452 <> 101
               BRKVF52 = .F.
               THISFORM.A1673CamFc = THISFORM.Buf_W05452_1673CamFch
               GX_SFLOAD = 0
               THISFORM.U12VF52 ()
