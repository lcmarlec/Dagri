      PROCEDURE CreateTemp
         LOCAL SCW270S20
         SCW270S20 = ""
         IF USED( "SCW270S20" )
            SELECT SCW270S20
            SCW270S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW270S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3FamCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA4FamSubC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA5ArtCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA839PlVPr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 4

            GX_STRUCT[ 5 ,1]= "sA1328PlVP"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 4

            GX_STRUCT[ 6 ,1]= "sA1646PlvA"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 5
            GX_STRUCT[ 6 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW270S20 = GETE('z:\temp') + '\' + SCW270S20
            ENDIF
            CREATE DBF (SCW270S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW270S20) EXCLUSIVE ALIAS SCW270S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW270S20
         THIS.GX_SfAlias = "SCW270S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02702" , @HStmt_W02702 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX02L3","W02702","",GX_CURSOR_TYPE_READONLY,@HStmt_W02702) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [PlVGruTip], [PlVEntCod], [PlvArtRet], [PlVPrcReal], [PlVPrc], [ArtCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod], [FamCod] FROM [PLAVTA1] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and "
                  cmdbuf = cmdbuf + "  [PlVGruTip] = ? and [PlVEntCod] = ? and [FamCod] >= ? and [FamSubCod] >= ? and [ArtCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PlVPrc] >= ?) ORDER BY [EmpCod], [PlVGruTip], [PlVEntCod], [FamCod], "
                  cmdbuf = cmdbuf + "  [FamSubCod], [ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02702,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02702,9)
                  THISFORM.GX_DB_BindColsW02702_01 ()
                  THISFORM.GX_DB_BindParmW02702_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02702,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA836PlVGru = THISFORM.A836PlVGru
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02702,2,AuxA836PlVGru,2,0)
               THISFORM.A836PlVGru = AuxA836PlVGru
               AuxA837PlVEnt = THISFORM.A837PlVEnt
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02702,3,@AuxA837PlVEnt,0)
               THISFORM.A837PlVEnt = AuxA837PlVEnt
               AuxAV5C3 = THISFORM.AV5C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02702,4,@AuxAV5C3,0)
               THISFORM.AV5C3 = AuxAV5C3
               AuxAV6C4 = THISFORM.AV6C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02702,5,@AuxAV6C4,0)
               THISFORM.AV6C4 = AuxAV6C4
               AuxAV7C5 = THISFORM.AV7C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02702,6,@AuxAV7C5,0)
               THISFORM.AV7C5 = AuxAV7C5
               AuxAV8C839 = THISFORM.AV8C839
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02702,7,@AuxAV8C839,0)
               THISFORM.AV8C839 = AuxAV8C839
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02702 = Gx_err
               THISFORM.GX_DB_GetW02702_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02702 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02702) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02702 = Gx_err
                  THISFORM.GX_DB_GetW02702_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02702 <> 101
               BRKV7I2 = .F.
               THISFORM.A1646PlvAr = THISFORM.Buf_W02702_1646PlvArtRet
               THISFORM.A1328PlVPr = THISFORM.Buf_W02702_1328PlVPrcReal
               THISFORM.A839PlVPrc = THISFORM.Buf_W02702_839PlVPrc
               THISFORM.A5ArtCod = THISFORM.Buf_W02702_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W02702_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W02702_3FamCod
               GX_SFLOAD = 0
               THISFORM.U12V7I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02702) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02702 = Gx_err
               THISFORM.GX_DB_GetW02702_01 ()
            ENDDO
         ENDIF
      ENDPROC
