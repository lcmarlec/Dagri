                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T03065) , "TPROMOD" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT306A464 .AfterTrn()
                  DO CASE
                     CASE THISFORM.GX_Mode = "INS"
                     CASE THISFORM.GX_Mode = "UPD"
                        THISFORM.ReleaseAll()
                     CASE THISFORM.GX_Mode = "DLT"
                        THISFORM.ReleaseAll()
                  ENDCASE
                  IF THISFORM.GX_Exit_GotFocus
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
                  gx_a_trn = .T.
                  IF ! THISFORM. cCT306V9 .ValidKey()
                     THISFORM.ReleaseAll()
                     RETURN
                  ENDIF
               ENDIF
               THISFORM.ReleaseAll()
         ENDCASE
