      PROCEDURE CreateTemp
         LOCAL SCW214S20
         SCW214S20 = ""
         IF USED( "SCW214S20" )
            SELECT SCW214S20
            SCW214S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW214S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA339C40FE"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA340C40CO"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 5
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA341C40PR"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 1
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA342C40NR"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 13
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA344C40IM"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 10
            GX_STRUCT[ 5 ,4]= 2

            IF '' <> GETE('z:\temp')
               SCW214S20 = GETE('z:\temp') + '\' + SCW214S20
            ENDIF
            CREATE DBF (SCW214S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW214S20) EXCLUSIVE ALIAS SCW214S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW214S20
         THIS.GX_SfAlias = "SCW214S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02142" , @HStmt_W02142 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX00W0","W02142","",GX_CURSOR_TYPE_READONLY,@HStmt_W02142) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [C40IMPGAN], [C40TIPDOC], [C40IMPTOT], [C40NRODOC], [C40PROCLI], [C40CODIGO], "
                  cmdbuf = cmdbuf + "  [C40FECDOC] FROM [DC4000] (FASTFIRSTROW NOLOCK) WHERE ([C40FECDOC] >= ? and [C40CODIGO] "
                  cmdbuf = cmdbuf + "  >= ? and [C40PROCLI] >= ?) AND ([C40NRODOC] like ?) AND ([C40TIPDOC] >= ?) AND ([C40IMPTOT] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([C40IMPGAN] >= ?) ORDER BY [C40FECDOC], [C40CODIGO], [C40PROCLI], [C40NRODOC], "
                  cmdbuf = cmdbuf + "  [C40TIPDOC]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02142,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02142,8)
                  THISFORM.GX_DB_BindColsW02142_01 ()
                  THISFORM.GX_DB_BindParmW02142_01 ()
               ENDIF
               AuxAV21C339 = THISFORM.AV21C339
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02142,1,@AuxAV21C339,0)
               THISFORM.AV21C339 = AuxAV21C339
               AuxAV20C340 = THISFORM.AV20C340
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02142,2,@AuxAV20C340,0)
               THISFORM.AV20C340 = AuxAV20C340
               AuxAV19C341 = THISFORM.AV19C341
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02142,3,@AuxAV19C341,0)
               THISFORM.AV19C341 = AuxAV19C341
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02142,4,PADR( TRIM(THISFORM.AV18C342),13, '%'),LEN(PADR( TRIM(THISFORM.AV18C342),13, '%')),0)
               AuxAV17C343 = THISFORM.AV17C343
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02142,5,@AuxAV17C343,0)
               THISFORM.AV17C343 = AuxAV17C343
               AuxAV16C344 = THISFORM.AV16C344
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02142,6,@AuxAV16C344,0)
               THISFORM.AV16C344 = AuxAV16C344
               AuxAV15C345 = THISFORM.AV15C345
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02142,7,@AuxAV15C345,0)
               THISFORM.AV15C345 = AuxAV15C345
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02142 = Gx_err
               THISFORM.GX_DB_GetW02142_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02142 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02142) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02142 = Gx_err
                  THISFORM.GX_DB_GetW02142_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02142 <> 101
               BRKV5Y2 = .F.
               THISFORM.A345C40IMP = THISFORM.Buf_W02142_345C40IMPGAN
               THISFORM.A343C40TIP = THISFORM.Buf_W02142_343C40TIPDOC
               THISFORM.A344C40IMP = THISFORM.Buf_W02142_344C40IMPTOT
               THISFORM.A342C40NRO = THISFORM.Buf_W02142_342C40NRODOC
               THISFORM.A341C40PRO = THISFORM.Buf_W02142_341C40PROCLI
               THISFORM.A340C40COD = THISFORM.Buf_W02142_340C40CODIGO
               THISFORM.A339C40FEC = THISFORM.Buf_W02142_339C40FECDOC
               GX_SFLOAD = 0
               THISFORM.U12V5Y2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02142) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02142 = Gx_err
               THISFORM.GX_DB_GetW02142_01 ()
            ENDDO
         ENDIF
      ENDPROC
