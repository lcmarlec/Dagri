      PROCEDURE CreateTemp
         LOCAL SCW275S20
         SCW275S20 = ""
         IF USED( "SCW275S20" )
            SELECT SCW275S20
            SCW275S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW275S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA415DcVNr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA416DcVEn"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA417DcVEn"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA419DcVEn"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA421DcVFc"
            GX_STRUCT[ 5 ,2]= "D"
            GX_STRUCT[ 5 ,3]= 8
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW275S20 = GETE('z:\temp') + '\' + SCW275S20
            ENDIF
            CREATE DBF (SCW275S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW275S20) EXCLUSIVE ALIAS SCW275S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW275S20
         THIS.GX_SfAlias = "SCW275S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02752" , @HStmt_W02752 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0161","W02752","",GX_CURSOR_TYPE_READONLY,@HStmt_W02752) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DcVTipaf], [DcVSeraf], [DcVFch], [DcVEntLgCo], [DcVEntCod], [DcVEntGruT], "
                  cmdbuf = cmdbuf + "  [DcVNroInt] FROM [DCVENT] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [DcVNroInt] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([DcVEntGruT] like ?) AND ([DcVEntCod] >= ?) AND ([DcVEntLgCo] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([DcVTipaf] like ?) AND ([DcVSeraf] like ?) ORDER BY [EmpCod], [DcVNroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02752,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02752,9)
                  THISFORM.GX_DB_BindColsW02752_01 ()
                  THISFORM.GX_DB_BindParmW02752_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02752,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C415 = THISFORM.AV5C415
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02752,2,@AuxAV5C415,0)
               THISFORM.AV5C415 = AuxAV5C415
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02752,3,PADR( TRIM(THISFORM.AV6C416),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C416),2, '%')),0)
               AuxAV7C417 = THISFORM.AV7C417
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W02752,4,@AuxAV7C417,0)
               THISFORM.AV7C417 = AuxAV7C417
               AuxAV8C419 = THISFORM.AV8C419
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02752,5,@AuxAV8C419,0)
               THISFORM.AV8C419 = AuxAV8C419
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02752,6,PADR( TRIM(THISFORM.AV9C426),4, '%'),LEN(PADR( TRIM(THISFORM.AV9C426),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W02752,7,PADR( TRIM(THISFORM.AV10C427),1, '%'),LEN(PADR( TRIM(THISFORM.AV10C427),1, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02752) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02752 = Gx_err
               THISFORM.GX_DB_GetW02752_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02752 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02752) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02752 = Gx_err
                  THISFORM.GX_DB_GetW02752_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02752 <> 101
               BRKV7N2 = .F.
               THISFORM.A426DcVTip = THISFORM.Buf_W02752_426DcVTipaf
               THISFORM.A427DcVSer = THISFORM.Buf_W02752_427DcVSeraf
               THISFORM.A421DcVFch = THISFORM.Buf_W02752_421DcVFch
               THISFORM.A419DcVEnt = THISFORM.Buf_W02752_419DcVEntLgCo
               THISFORM.A417DcVEnt = THISFORM.Buf_W02752_417DcVEntCod
               THISFORM.A416DcVEnt = THISFORM.Buf_W02752_416DcVEntGruT
               THISFORM.A415DcVNro = THISFORM.Buf_W02752_415DcVNroInt
               GX_SFLOAD = 0
               THISFORM.U12V7N2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02752) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02752 = Gx_err
               THISFORM.GX_DB_GetW02752_01 ()
            ENDDO
         ENDIF
      ENDPROC
