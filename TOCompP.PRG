      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S682OCoNro
         LOCAL S695OCoLin
         S2EmpCod = THISFORM.A2EmpCod
         S682OCoNro = THISFORM.A682OCoNro
         S695OCoLin = THISFORM.A695OCoLin
         THISFORM.A695OCoLin = THISFORM.M695OCoLin
         THISFORM. cCT183S17 .SaveTemp()
         THISFORM. cCT183S17 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT183S17 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT183S17 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT183S17 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT183S17 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT183S17 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT183S17 .Refresh()
               THISFORM. cCT183S17 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A682OCoNro = S682OCoNro
               THISFORM.A695OCoLin = S695OCoLin
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT183S17 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT183S17 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT183S17 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S682OCoNro = THISFORM.A682OCoNro .AND. S695OCoLin = THISFORM.A695OCoLin
            ENDDO
            IF sf_err != 0
               THISFORM. cCT183S17 .AppendRow()
               THISFORM. cCT183S17 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A682OCoNro = S682OCoNro
               THISFORM.A695OCoLin = S695OCoLin
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A682OCoNro = S682OCoNro
         THISFORM.A695OCoLin = S695OCoLin
         RETURN .F.
      ENDFUNC
