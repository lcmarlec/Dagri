      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T018319" , @HStmt_T018319 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TOCOMPP","T018319","",GX_CURSOR_TYPE_READONLY,@HStmt_T018319) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [OCoNroInt], [OCoLin], [OCOLInea], [FamCod], [FamSubCod], [ArtCod], "
                  cmdbuf = cmdbuf + "  [OcoArtCpr], [OcoLObs], [OCoCnt], [OCoCntEnt], [OCoPrc], [OcoPrcOri], [OcoPrcFcU], "
                  cmdbuf = cmdbuf + "  [OCoLEs] FROM [OCOMPN1] (NOLOCK) WHERE [EmpCod] = ? AND [OCoNroInt] = ? ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod], [OCoNroInt], [OCoLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T018319,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T018319,11)
                  THISFORM.GX_DB_BindColsT018319_01 ()
                  THISFORM.GX_DB_BindParmT018319_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T018319,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA682OCoNro = THISFORM.A682OCoNro
               Gx_err = GX_DB_SetDouble( HStmt_T018319,2,@AuxA682OCoNro,0)
               THISFORM.A682OCoNro = AuxA682OCoNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T018319) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T018319 = Gx_err
               THISFORM.GX_DB_GetT018319_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T018319 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T018319) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T018319 = Gx_err
                  THISFORM.GX_DB_GetT018319_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T018319 <> 101
               BRK5377 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT183S17.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T018319_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T018319_682OCoNroInt = THISFORM.A682OCoNro
                  SELECT (THIS.GX_SFAlias)
