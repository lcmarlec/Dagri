      PROCEDURE CreateTemp
         LOCAL SCW236S20
         SCW236S20 = ""
         IF USED( "SCW236S20" )
            SELECT SCW236S20
            SCW236S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW236S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA586ForFa"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA587ForFa"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA588ForAr"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA590ForNr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 4
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA593ForCn"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW236S20 = GETE('z:\temp') + '\' + SCW236S20
            ENDIF
            CREATE DBF (SCW236S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW236S20) EXCLUSIVE ALIAS SCW236S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW236S20
         THIS.GX_SfAlias = "SCW236S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W02362" , @HStmt_W02362 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX01K1","W02362","",GX_CURSOR_TYPE_READONLY,@HStmt_W02362) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ForFch], [ForCnt], [ForNro], [ForArtCod], [ForFamSubC], [ForFamCod] "
                  cmdbuf = cmdbuf + "  FROM [FORPRO] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [ForFamCod] >= ? and "
                  cmdbuf = cmdbuf + "  [ForFamSubC] >= ? and [ForArtCod] >= ? and [ForNro] >= ?) AND ([ForFch] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([ForCnt] >= ?) ORDER BY [EmpCod], [ForFamCod], [ForFamSubC], [ForArtCod], [ForNro] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W02362,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W02362,9)
                  THISFORM.GX_DB_BindColsW02362_01 ()
                  THISFORM.GX_DB_BindParmW02362_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02362,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C586 = THISFORM.AV5C586
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02362,2,@AuxAV5C586,0)
               THISFORM.AV5C586 = AuxAV5C586
               AuxAV6C587 = THISFORM.AV6C587
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02362,3,@AuxAV6C587,0)
               THISFORM.AV6C587 = AuxAV6C587
               AuxAV7C588 = THISFORM.AV7C588
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02362,4,@AuxAV7C588,0)
               THISFORM.AV7C588 = AuxAV7C588
               AuxAV8C590 = THISFORM.AV8C590
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W02362,5,@AuxAV8C590,0)
               THISFORM.AV8C590 = AuxAV8C590
               AuxAV9C591 = THISFORM.AV9C591
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W02362,6,@AuxAV9C591,0)
               THISFORM.AV9C591 = AuxAV9C591
               AuxAV10C593 = THISFORM.AV10C593
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W02362,7,@AuxAV10C593,0)
               THISFORM.AV10C593 = AuxAV10C593
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W02362) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02362 = Gx_err
               THISFORM.GX_DB_GetW02362_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W02362 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02362) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W02362 = Gx_err
                  THISFORM.GX_DB_GetW02362_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W02362 <> 101
               BRKV6K2 = .F.
               THISFORM.A591ForFch = THISFORM.Buf_W02362_591ForFch
               THISFORM.A593ForCnt = THISFORM.Buf_W02362_593ForCnt
               THISFORM.A590ForNro = THISFORM.Buf_W02362_590ForNro
               THISFORM.A588ForArt = THISFORM.Buf_W02362_588ForArtCod
               THISFORM.A587ForFam = THISFORM.Buf_W02362_587ForFamSubC
               THISFORM.A586ForFam = THISFORM.Buf_W02362_586ForFamCod
               GX_SFLOAD = 0
               THISFORM.U12V6K2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W02362) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W02362 = Gx_err
               THISFORM.GX_DB_GetW02362_01 ()
            ENDDO
         ENDIF
      ENDPROC
