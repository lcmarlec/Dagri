                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00342) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00342 = Gx_err
                  THISFORM.GX_DB_GetW00342_01 ()
