               THISFORM.A720OpaNro = AuxA720OpaNro
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00342) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00342 = Gx_err
               THISFORM.GX_DB_GetW00342_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV22Pgmnam = "WDcCVer2"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00342 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
