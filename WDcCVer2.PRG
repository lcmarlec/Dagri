      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00342" , @HStmt_W00342 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDCCVER2","W00342","",GX_CURSOR_TYPE_READONLY,@HStmt_W00342) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T1.[OpaNroIImp], T2.[OpaEst], T1.[OPaSig], T1.[OPaNroI], T1.[OPaNroLin], "
                  cmdbuf = cmdbuf + "  T2.[OpaTot], T1.[OPaImpImp], T2.[OpaNroPrv], T2.[OpaFchPrv], T2.[OpaFch], T2.[OPaNro], "
                  cmdbuf = cmdbuf + "  T2.[OPaSuc], T2.[OPaSer], T2.[OPaTip] FROM ([OPAGOS1] T1 (FASTFIRSTROW NOLOCK) LEFT "
                  cmdbuf = cmdbuf + "  JOIN [OPAGOS] T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[OPaNroI] = T1.[OPaNroI]) "
                  cmdbuf = cmdbuf + "  WHERE T1.[EmpCod] = ? and T1.[OpaNroIImp] = ? ORDER BY T1.[EmpCod], T1.[OpaNroIImp] "
                  cmdbuf = cmdbuf + "   "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00342,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00342,14)
