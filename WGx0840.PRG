                  cmdbuf = cmdbuf + "  [EmpCod] FROM [ENVIOS3] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ? and [EnvClt] "
                  cmdbuf = cmdbuf + "  >= ? and [EnvFch] >= ? and [PedFch] >= ?) AND ([PedGruTip] like ?) AND ([PedEntCod] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([PedSucCod] >= ?) ORDER BY [EmpCod], [EnvClt], [EnvFch], [PedFch], [PedGruTip], "
                  cmdbuf = cmdbuf + "  [PedEntCod], [PedSucCod], [PedSec]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08392,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08392,9)
                  THISFORM.GX_DB_BindColsW08392_01 ()
                  THISFORM.GX_DB_BindParmW08392_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08392,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               AuxAV6C2581 = THISFORM.AV6C2581
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08392,2,@AuxAV6C2581,0)
               THISFORM.AV6C2581 = AuxAV6C2581
               AuxAV7C2582 = THISFORM.AV7C2582
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08392,3,@AuxAV7C2582,0)
               THISFORM.AV7C2582 = AuxAV7C2582
               AuxAV8C795 = THISFORM.AV8C795
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W08392,4,@AuxAV8C795,0)
               THISFORM.AV8C795 = AuxAV8C795
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08392,5,PADR( TRIM(THISFORM.AV9C797),2, '%'),LEN(PADR( TRIM(THISFORM.AV9C797),2, '%')),0)
               AuxAV10C798 = THISFORM.AV10C798
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08392,6,@AuxAV10C798,0)
               THISFORM.AV10C798 = AuxAV10C798
               AuxAV11C802 = THISFORM.AV11C802
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08392,7,@AuxAV11C802,0)
               THISFORM.AV11C802 = AuxAV11C802
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08392) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08392 = Gx_err
               THISFORM.GX_DB_GetW08392_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08392 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08392) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08392 = Gx_err
                  THISFORM.GX_DB_GetW08392_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08392 <> 101
               BRKVNB2 = .F.
               THISFORM.A809PedSec = THISFORM.Buf_W08392_809PedSec
               THISFORM.A802PedSuc = THISFORM.Buf_W08392_802PedSucCod
               THISFORM.A798PedEnt = THISFORM.Buf_W08392_798PedEntCod
               THISFORM.A797PedGru = THISFORM.Buf_W08392_797PedGruTip
               THISFORM.A795PedFch = THISFORM.Buf_W08392_795PedFch
               THISFORM.A2582EnvFc = THISFORM.Buf_W08392_2582EnvFch
               THISFORM.A2581EnvCl = THISFORM.Buf_W08392_2581EnvClt
               THISFORM.A2EmpCod = THISFORM.Buf_W08392_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VNB2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08392) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08392 = Gx_err
               THISFORM.GX_DB_GetW08392_01 ()
            ENDDO
         ENDIF
      ENDPROC
