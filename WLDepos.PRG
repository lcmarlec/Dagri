      ***********************
      PROCEDURE cCW387V28.Isvalid
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "CCW387V28.ISVALID" )
         THISFORM.AV35GXLvl2 = 0
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03872" , @HStmt_W03872 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WLDEPOS","W03872","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W03872) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT T1.[BcoCod], T1.[BcoCta], T1.[BcoCtaNro], T2.[BcoDsc] FROM ([CTAS] T1 (NOLOCK) "
            cmdbuf = cmdbuf + "  LEFT JOIN [BANCOS] T2 (NOLOCK) ON T2.[BcoCod] = T1.[BcoCod]) WHERE T1.[BcoCta] = "
            cmdbuf = cmdbuf + "  ? ORDER BY T1.[BcoCta]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03872,cmdbuf)
            THISFORM.GX_DB_BindColsW03872_01 ()
            THISFORM.GX_DB_BindParmW03872_01 ()
         ENDIF
         AuxAV28Ctacod = THISFORM.AV28Ctacod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03872,1,@AuxAV28Ctacod,0)
         THISFORM.AV28Ctacod = AuxAV28Ctacod
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03872) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W03872 = Gx_err
         THISFORM.GX_DB_GetW03872_01 ()
         DO WHILE THISFORM.W03872 <> 101
            THISFORM.A86BcoCod = THISFORM.Buf_W03872_86BcoCod
            THISFORM.A76BcoCta = THISFORM.Buf_W03872_76BcoCta
            THISFORM.A77BcoCtaN = THISFORM.Buf_W03872_77BcoCtaNro
            THISFORM.A87BcoDsc = THISFORM.Buf_W03872_87BcoDsc
            THISFORM.A87BcoDsc = THISFORM.Buf_W03872_87BcoDsc
            THISFORM.AV35GXLvl2 = 1
            THISFORM.AV29Ctanro = THISFORM.A77BcoCtaN
            THISFORM.AV30Ctabco = THISFORM.A87BcoDsc
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W03872) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.AV35GXLvl2 = 0
            THISFORM.AV29Ctanro = "No Existe "
         ENDIF
