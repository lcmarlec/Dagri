   DO H7B0 WITH Gx_out , P_lines , 0, P_lines +1, .T., 0
   IF Gx_dvc = "PRN"
      GXAuxPrn_Flag = GXPrn_Flag
      gxPrnObj.GXEndDoc( GxHDC , @GXAuxPrn_Flag)
      gxPrnObj.GXEndPrn( GxHDC , @GXAuxPrn_Flag)
      GXPrn_Flag = GXAuxPrn_Flag
      PRIVATE GXCallFrm
      IF PROGRAM(0) = "MENU"
         GXCallFrm = _SCREEN.ActiveForm
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 0
         ENDIF
      ENDIF
      DO WHILE gxPrnObj.GxIsAliveDoc( GxHDC ) != 0
         WAIT "" TIMEOUT 1
         DOEVENTS
      ENDDO
      RELEASE WINDOW _WMSG
      IF PROGRAM(0) = "MENU"
         IF ! ISNULL(GXCallFrm)
            GXCallFrm.Enabled = 1
         ENDIF
      ENDIF
   ELSE
      SET DEVICE TO SCREEN
      RptView = .T.
   ENDIF
   DO CD7B0
   IF WEXIST( GX_newwin )
      RELEASE WINDOW (GX_newwin)
      IF !EMPTY( LastWin )
         ACTIVATE WINDOW (LastWin)
         MODIFY WINDOW (LastWin) CLOSE
      ENDIF
   ENDIF
RETURN

***********************
PROCEDURE H7B0
***********************

   PARAMETERS Gx_out, P_lines, Gx_line, Gx_inc, GX_footer, GX_inc_test

   Gx_line = Gx_line + Gx_inc
   IF Gx_line + GX_inc_test > P_lines
      IF Gx_page > 0
         Gx_line = P_lines
         IF Gx_dvc = "PRN" .and. Gx_pg_started
            GXAuxPrn_Flag = GXPrn_Flag
            gxPrnObj.GXEndPg( GxHDC , @GXAuxPrn_Flag)
            GXPrn_Flag = GXAuxPrn_Flag
            Gx_pg_started = .F.
         ENDIF
      ENDIF
      IF GX_footer
         RETURN
      ENDIF
      Gx_line = M_top
      Gx_page = Gx_page + 1
      IF Gx_dvc = "PRN" .and. .not. Gx_pg_started
         GXAuxPrn_Flag = GXPrn_Flag
         gxPrnObj.GXStartPg( GxHDC , @GXAuxPrn_Flag)
         GXPrn_Flag = GXAuxPrn_Flag
         Gx_pg_started = .T.
      ENDIF
      IF LEVEL1
         gxPrnObj.GxDwTextNB( GxHDC , [Vencimiento de Articulos] ,184,10+Gx_line,320,24+Gx_line , "Times New Roman",10 ,256 ,1,0,0,0 ,0 ,0,0,0 )
         gxPrnObj.GXDwLine( GxHDC ,183,24+Gx_line,324,24+Gx_line ,1 ,0,0,0 )
         gxPrnObj.GxDwTextNB( GxHDC , [Cod.] ,137,44+Gx_line,160,58+Gx_line , "Times New Roman",10 ,256 ,1,0,0,0 ,0 ,0,0,0 )
         gxPrnObj.GxDwTextNB( GxHDC , [Articulo ] ,167,44+Gx_line,215,58+Gx_line , "Times New Roman",10 ,256 ,1,0,0,0 ,0 ,0,0,0 )
         gxPrnObj.GxDwTextNB( GxHDC , [Venc.] ,467,44+Gx_line,496,58+Gx_line , "Times New Roman",10 ,256 ,1,0,0,0 ,0 ,0,0,0 )
         Gx_line = Gx_line + 60
      ENDIF
   ENDIF
RETURN
