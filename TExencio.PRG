                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TEXENCIO","T03469","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T03469) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " DELETE FROM [EXENCION]  WHERE [EmpCod] = ? AND [EntCui] = ? AND [PaiCod] = ? AND "
                  cmdbuf = cmdbuf + "  [PciCod] = ? AND [PciExFH] = ? "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T03469,cmdbuf)
                  THISFORM.GX_DB_BindParmT03469_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T03469,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA166EntCui = THISFORM.A166EntCui
               Gx_err = GX_DB_SetDouble( HStmt_T03469,2,@AuxA166EntCui,0)
               THISFORM.A166EntCui = AuxA166EntCui
               AuxA631PaiCod = THISFORM.A631PaiCod
               Gx_err = GX_DB_SetStr( HStmt_T03469,3,AuxA631PaiCod,4,0)
               THISFORM.A631PaiCod = AuxA631PaiCod
               AuxA633PciCod = THISFORM.A633PciCod
               Gx_err = GX_DB_SetStr( HStmt_T03469,4,AuxA633PciCod,4,0)
               THISFORM.A633PciCod = AuxA633PciCod
               AuxA3324PciEx = THISFORM.A3324PciEx
               Gx_err = GX_DB_SetDate( HStmt_T03469,5,@AuxA3324PciEx,0)
               THISFORM.A3324PciEx = AuxA3324PciEx
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtExecute( HStmt_T03469) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T03469 = Gx_err
               THISFORM.T03462 = iif( THISFORM.T03469 = 0 , 104 , THISFORM.T03469 )
               Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_T03469) ,  ,  ,  , CS_SQLSRV , 0 )
         ENDCASE
      RETURN .T.
      PROCEDURE After(gxmode)
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         DO CASE
            CASE gxmode = "INS"   && After insert
            CASE gxmode = "UPD"   && After update
            CASE gxmode = "DLT"   && After delete
         ENDCASE
      ENDPROC
      PROCEDURE AfterLevel()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterConfirm()
         IF THISFORM.Gx_mode = "DSP"
            RETURN .T.
         ENDIF
         IF .T.
            THISFORM.AV19Numero = str( THISFORM.A166EntCui , 11 ) + GXDTOC( THISFORM.A3324PciEx ) + THISFORM.A633PciCod
         ENDIF
         IF .T. .AND. (THISFORM.Gx_mode = 'UPD' .AND. THISFORM.GX_Is_Updated)
            THISFORM.SaveTblPos()
            Aux1 = THISFORM.AV8Emprcod
            Aux3 = THISFORM.AV19Numero
            Aux4 = THISFORM.Gx_mode
            Aux5 = THISFORM.AV25Audobs
            Aux6 = THISFORM.AV17Usuari
            DO PAuditor WITH "EXEN" , Aux1 , "CUIT" , Aux3 , Aux4 , Aux5 , Aux6
            THISFORM.AV8Emprcod = Aux1
            THISFORM.AV19Numero = Aux3
            THISFORM.Gx_mode = Aux4
            THISFORM.AV25Audobs = Aux5
            THISFORM.AV17Usuari = Aux6
            THISFORM. cCT346V17 .Refresh()
         ENDIF
         RETURN .T.
      ENDPROC
      PROCEDURE AfterTrn()
         LOCAL gx_oldLvl
         IF THISFORM.Gx_mode = "DSP"
            RETURN
         ENDIF
         gx_oldLvl = THISFORM.Gx_Curr_Level
         THISFORM.SetLevel( 377 )
         IF THISFORM.Gx_mode != "DLT"
            THISFORM.SaveMode( THISFORM.GX_atrn_mode ,"")
         ENDIF
         THISFORM.SetLevel(gx_oldLvl)
      ENDPROC
