         ENDIF
         THISFORM.Gx_cursor = "THISFORM.A2413WSHos"
         THISFORM.cCW801S22 .SaveFocus(THIS.GXColumnNo)
         IF  THISFORM.cCW801S22 .GX_lastVld1 >= THIS.GXColumnNo .and.( THISFORM.cCW801S22 .GX_lastkey = 9.or. THISFORM.cCW801S22 .GX_lastkey = 13)
