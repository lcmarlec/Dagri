      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08012" , @HStmt_W08012 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WWSERVIC","W08012","",GX_CURSOR_TYPE_READONLY,@HStmt_W08012) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [WSHost], [WSServID] FROM [WSERVICE] (FASTFIRSTROW NOLOCK) WHERE "
                  cmdbuf = cmdbuf + "  ([EmpCod] = ?) AND ([WSServID] like ?) ORDER BY [EmpCod], [WSServID]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08012,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08012,8)
                  THISFORM.GX_DB_BindColsW08012_01 ()
                  THISFORM.GX_DB_BindParmW08012_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08012,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08012,2,PADR( TRIM(THISFORM.AV20Desde),10, '%'),LEN(PADR( TRIM(THISFORM.AV20Desde),10, '%')),0)
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08012) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08012 = Gx_err
               THISFORM.GX_DB_GetW08012_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WWServic"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08012 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08012) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08012 = Gx_err
                  THISFORM.GX_DB_GetW08012_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08012 <> 101
               BRKVM92 = .F.
               THISFORM.A2EmpCod = THISFORM.Buf_W08012_2EmpCod
               THISFORM.A2413WSHos = THISFORM.Buf_W08012_2413WSHost
               THISFORM.A2412WSSer = THISFORM.Buf_W08012_2412WSServID
               GX_SFLOAD = 0
               THISFORM.U17VM92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
