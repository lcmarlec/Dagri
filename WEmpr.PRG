      PROCEDURE LoadObj(LoadType)
         * Default load for WKP
         GX_CUOPER = 1
         GX_CUERR = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00542" , @HStmt_W00542 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMPR","W00542","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W00542) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[EmpCod], T2.[PaiDsc] AS EmpPaiDsc, T1.[EmpCui], T1.[EmpGrC], T1.[EmpFchIni], "
                  cmdbuf = cmdbuf + "  T1.[EmpAct], T1.[EmpMai], T1.[EmpFax], T1.[EmpTel], T1.[EmpLoc], T1.[EmpDir], T3.[PciDsc] "
                  cmdbuf = cmdbuf + "  AS EmpPciDsc, T1.[EmpPciCod] AS EmpPciCod, T1.[EmpPaiCod] AS EmpPaiCod, T1.[EmpNom] "
                  cmdbuf = cmdbuf + "  FROM (([EMPRES] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [PAISES] T2 (NOLOCK) ON T2.[PaiCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpPaiCod]) LEFT JOIN [PCIAS] T3 (NOLOCK) ON T3.[PaiCod] = T1.[EmpPaiCod] "
                  cmdbuf = cmdbuf + "  AND T3.[PciCod] = T1.[EmpPciCod]) WHERE T1.[EmpCod] = ? ORDER BY T1.[EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00542,cmdbuf)
                  THISFORM.GX_DB_BindColsW00542_01 ()
                  THISFORM.GX_DB_BindParmW00542_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W00542,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00542) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
