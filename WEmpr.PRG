               THISFORM.A568EmpPai = THISFORM.Buf_W00542_568EmpPaiDsc
               THISFORM.A570EmpPci = THISFORM.Buf_W00542_570EmpPciDsc
               GX_SFLOAD = 1
               THISFORM.U13V1I2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               * Exiting from a For First loop.
               EXIT
            ENDDO
         ENDIF
         IF GX_CUERR != 0
            THISFORM.AV8Emprnom = SPACE(30)
