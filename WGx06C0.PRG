      PROCEDURE CreateTemp
         LOCAL SCW657S18
         SCW657S18 = ""
         IF USED( "SCW657S18" )
            SELECT SCW657S18
            SCW657S18 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW657S18
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 2 , 4]

            GX_STRUCT[ 1 ,1]= "sA1964DatT"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 20
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1965DatS"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW657S18 = GETE('z:\temp') + '\' + SCW657S18
            ENDIF
            CREATE DBF (SCW657S18) FROM ARRAY GX_STRUCT
            USE
            USE (SCW657S18) EXCLUSIVE ALIAS SCW657S18
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW657S18
         THIS.GX_SfAlias = "SCW657S18"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06572" , @HStmt_W06572 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06C0","W06572","",GX_CURSOR_TYPE_READONLY,@HStmt_W06572) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DatAltUsu], [DatAltFch], [DatModUsu], [DatModFch], [DatSTit], [DatTit] FROM "
                  cmdbuf = cmdbuf + "  [DATUTIL] (FASTFIRSTROW NOLOCK) WHERE ([DatTit] like ?) AND ([DatSTit] like ?) AND "
                  cmdbuf = cmdbuf + "  ([DatAltUsu] like ?) AND ([DatAltFch] >= ?) AND ([DatModUsu] like ?) AND ([DatModFch] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [DatTit], [DatSTit]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06572,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06572,9)
                  THISFORM.GX_DB_BindColsW06572_01 ()
                  THISFORM.GX_DB_BindParmW06572_01 ()
               ENDIF
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06572,1,PADR( TRIM(THISFORM.AV5C1964),20, '%'),LEN(PADR( TRIM(THISFORM.AV5C1964),20, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06572,2,PADR( TRIM(THISFORM.AV6C1965),40, '%'),LEN(PADR( TRIM(THISFORM.AV6C1965),40, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06572,3,PADR( TRIM(THISFORM.AV7C1967),10, '%'),LEN(PADR( TRIM(THISFORM.AV7C1967),10, '%')),0)
               AuxAV8C1968 = THISFORM.AV8C1968
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W06572,4,@AuxAV8C1968,0)
               THISFORM.AV8C1968 = AuxAV8C1968
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06572,5,PADR( TRIM(THISFORM.AV9C1969),10, '%'),LEN(PADR( TRIM(THISFORM.AV9C1969),10, '%')),0)
               AuxAV10C1970 = THISFORM.AV10C1970
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W06572,6,@AuxAV10C1970,0)
               THISFORM.AV10C1970 = AuxAV10C1970
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06572 = Gx_err
               THISFORM.GX_DB_GetW06572_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06572 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06572) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06572 = Gx_err
                  THISFORM.GX_DB_GetW06572_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06572 <> 101
               BRKVI92 = .F.
               THISFORM.A1967DatAl = THISFORM.Buf_W06572_1967DatAltUsu
               THISFORM.A1968DatAl = THISFORM.Buf_W06572_1968DatAltFch
               THISFORM.A1969DatMo = THISFORM.Buf_W06572_1969DatModUsu
               THISFORM.A1970DatMo = THISFORM.Buf_W06572_1970DatModFch
               THISFORM.A1965DatST = THISFORM.Buf_W06572_1965DatSTit
               THISFORM.A1964DatTi = THISFORM.Buf_W06572_1964DatTit
               GX_SFLOAD = 0
               THISFORM.U12VI92 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06572) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06572 = Gx_err
               THISFORM.GX_DB_GetW06572_01 ()
            ENDDO
         ENDIF
      ENDPROC
