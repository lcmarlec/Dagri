               THISFORM.A3555TraBa = AuxA3555TraBa
               AuxAV5C3559 = THISFORM.AV5C3559
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W12252,3,@AuxAV5C3559,0)
               THISFORM.AV5C3559 = AuxAV5C3559
               AuxAV6C3560 = THISFORM.AV6C3560
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W12252,4,@AuxAV6C3560,0)
               THISFORM.AV6C3560 = AuxAV6C3560
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W12252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12252 = Gx_err
               THISFORM.GX_DB_GetW12252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W12252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W12252 = Gx_err
                  THISFORM.GX_DB_GetW12252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W12252 <> 101
               BRKVY12 = .F.
               THISFORM.A3560TraBA = THISFORM.Buf_W12252_3560TraBAJFch
               THISFORM.A3559TraBA = THISFORM.Buf_W12252_3559TraBAJId
               GX_SFLOAD = 0
               THISFORM.U12VY12 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W12252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W12252 = Gx_err
               THISFORM.GX_DB_GetW12252_01 ()
            ENDDO
         ENDIF
      ENDPROC
