                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W10362,9)
                  THISFORM.GX_DB_BindColsW10362_01 ()
                  THISFORM.GX_DB_BindParmW10362_01 ()
               ENDIF
               AuxA3070CDCod = THISFORM.A3070CDCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10362,1,@AuxA3070CDCod,0)
               THISFORM.A3070CDCod = AuxA3070CDCod
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W10362,2,PADR( TRIM(THISFORM.AV5C3073),4, '%'),LEN(PADR( TRIM(THISFORM.AV5C3073),4, '%')),0)
               AuxAV6C3077 = THISFORM.AV6C3077
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10362,3,@AuxAV6C3077,0)
               THISFORM.AV6C3077 = AuxAV6C3077
               AuxAV7C3078 = THISFORM.AV7C3078
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W10362,4,@AuxAV7C3078,0)
               THISFORM.AV7C3078 = AuxAV7C3078
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W10362) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10362 = Gx_err
               THISFORM.GX_DB_GetW10362_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W10362 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10362) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W10362 = Gx_err
                  THISFORM.GX_DB_GetW10362_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W10362 <> 101
               BRKVSS2 = .F.
               THISFORM.A3077CdVta = THISFORM.Buf_W10362_3077CdVta
               THISFORM.A3078CdCmp = THISFORM.Buf_W10362_3078CdCmp
               THISFORM.A3074CdTip = THISFORM.Buf_W10362_3074CdTipDesc
               THISFORM.A3073CdTip = THISFORM.Buf_W10362_3073CdTip
               GX_SFLOAD = 0
               THISFORM.U12VSS2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W10362) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W10362 = Gx_err
               THISFORM.GX_DB_GetW10362_01 ()
            ENDDO
         ENDIF
      ENDPROC
