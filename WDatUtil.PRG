      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06562" , @HStmt_W06562 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDATUTIL","W06562","",GX_CURSOR_TYPE_READONLY,@HStmt_W06562) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [DatObs], [DatSTit], [DatTit] FROM [DATUTIL] (FASTFIRSTROW NOLOCK) WHERE [DatTit] "
                  cmdbuf = cmdbuf + "  >= ? ORDER BY [DatTit], [DatSTit]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06562,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06562,15)
                  THISFORM.GX_DB_BindColsW06562_01 ()
                  THISFORM.GX_DB_BindParmW06562_01 ()
               ENDIF
               AuxAV17Desde = THISFORM.AV17Desde
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06562,1,AuxAV17Desde,20,0)
               THISFORM.AV17Desde = AuxAV17Desde
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06562) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06562 = Gx_err
               THISFORM.GX_DB_GetW06562_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV27Pgmnam = "WDatUtil"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06562 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06562) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06562 = Gx_err
                  THISFORM.GX_DB_GetW06562_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06562 <> 101
               BRKVI82 = .F.
               THISFORM.A1966DatOb = Gx_lvchar_to_char( THISFORM.Buf_W06562_1966DatObs )
               THISFORM.A1965DatST = THISFORM.Buf_W06562_1965DatSTit
               THISFORM.A1964DatTi = THISFORM.Buf_W06562_1964DatTit
               GX_SFLOAD = 0
               THISFORM.U17VI82 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06562) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06562 = Gx_err
               THISFORM.GX_DB_GetW06562_01 ()
            ENDDO
         ENDIF
      ENDPROC
