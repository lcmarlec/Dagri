            * Create SubFile
            DO GX_SFNM WITH SCW656S11
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 3 , 4]

            GX_STRUCT[ 1 ,1]= "sA1964DatT"
