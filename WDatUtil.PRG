            GX_STRUCT[ 3 ,2]= "M"
            GX_STRUCT[ 3 ,3]= 8000
            GX_STRUCT[ 3 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW656S11 = GETE('z:\temp') + '\' + SCW656S11
            ENDIF
            CREATE DBF (SCW656S11) FROM ARRAY GX_STRUCT
            USE
            USE (SCW656S11) EXCLUSIVE ALIAS SCW656S11
         ENDIF
