      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04642" , @HStmt_W04642 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVAJU","W04642","",GX_CURSOR_TYPE_READONLY,@HStmt_W04642) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[DcVEntLgCo] AS DcVEntLgCo, T1.[EmpCod], T1.[DcVNroInt], T1.[DcVEntCod] "
                  cmdbuf = cmdbuf + "  AS DcVEntCod, T1.[DcVEntGruT] AS DcVEntGruT, T1.[DcVNroaf], T1.[DcVSucaf], T1.[DcVTipaf], "
                  cmdbuf = cmdbuf + "  T1.[DcVNetSld], T1.[DcVSig], T1.[DcvCtaCliC], T1.[DcVEst], T1.[DcvTipRed], T1.[DcvCotiz], "
                  cmdbuf = cmdbuf + "  T1.[DcVTotSld], T2.[EntLgDom] AS DcVEntLgDo, T1.[DcVTot], T1.[DcVNro], T1.[DcVSuc], "
                  cmdbuf = cmdbuf + "  T1.[DcVSer], T1.[DcVTip], T1.[DcVFch] FROM ([DCVENT] T1 (NOLOCK) LEFT JOIN [CLTES] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[DcVEntGruT] AND "
                  cmdbuf = cmdbuf + "  T2.[EntCod] = T1.[DcVEntCod] AND T2.[EntLgCod] = T1.[DcVEntLgCo]) WHERE (T1.[EmpCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[DcvCtaCliC] = ? and T1.[DcVEst] = 1) AND (T1.[DcVFch] >= ?) AND (T1.[DcVEntCod] "
                  cmdbuf = cmdbuf + "  > 0) AND (T1.[DcVEntGruT] = 'CL') ORDER BY T1.[EmpCod], T1.[DcvCtaCliC], T1.[DcVEst], "
                  cmdbuf = cmdbuf + "  T1.[DcVSuc], T1.[DcvTipRed] DESC, T1.[DcVFch], T1.[DcVNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W04642,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W04642,15)
                  THISFORM.GX_DB_BindColsW04642_01 ()
                  THISFORM.GX_DB_BindParmW04642_01 ()
               ENDIF
               AuxAV7Emprcod = THISFORM.AV7Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W04642,1,@AuxAV7Emprcod,0)
               THISFORM.AV7Emprcod = AuxAV7Emprcod
               AuxAV9Descli = THISFORM.AV9Descli
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W04642,2,@AuxAV9Descli,0)
               THISFORM.AV9Descli = AuxAV9Descli
               AuxAV15Desfch = THISFORM.AV15Desfch
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W04642,3,@AuxAV15Desfch,0)
               THISFORM.AV15Desfch = AuxAV15Desfch
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W04642) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W04642 = Gx_err
               THISFORM.GX_DB_GetW04642_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV34Pgmnam = "WDvAju"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W04642 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W04642) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W04642 = Gx_err
                  THISFORM.GX_DB_GetW04642_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W04642 <> 101
               BRKVCW2 = .F.
               THISFORM.AV30Afecta = SPACE(16)
               THISFORM.AV25Debe1 = 0.00
               THISFORM.AV23Debe = 0.00
               THISFORM.AV26Haber1 = 0.00
               THISFORM.AV24Haber = 0.00
