               THISFORM.A425DcVNro = THISFORM.Buf_W04642_425DcVNro
               THISFORM.A424DcVSuc = THISFORM.Buf_W04642_424DcVSuc
               THISFORM.A423DcVSer = THISFORM.Buf_W04642_423DcVSer
               THISFORM.A422DcVTip = THISFORM.Buf_W04642_422DcVTip
               THISFORM.A421DcVFch = THISFORM.Buf_W04642_421DcVFch
