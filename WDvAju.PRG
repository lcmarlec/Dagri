               THISFORM.A417DcVEnt = THISFORM.Buf_W04642_417DcVEntCod
               THISFORM.A416DcVEnt = THISFORM.Buf_W04642_416DcVEntGruT
               THISFORM.A429DcVNro = THISFORM.Buf_W04642_429DcVNroaf
               THISFORM.A428DcVSuc = THISFORM.Buf_W04642_428DcVSucaf
               THISFORM.A426DcVTip = THISFORM.Buf_W04642_426DcVTipaf
               THISFORM.A468DcVNet = THISFORM.Buf_W04642_468DcVNetSld
               THISFORM.A472DcVSig = THISFORM.Buf_W04642_472DcVSig
               THISFORM.A1473DcvCt = THISFORM.Buf_W04642_1473DcvCtaCliC
               THISFORM.A466DcVEst = THISFORM.Buf_W04642_466DcVEst
               THISFORM.A1208DcvTi = THISFORM.Buf_W04642_1208DcvTipRed
               THISFORM.A1428DcvCo = THISFORM.Buf_W04642_1428DcvCotiz
               THISFORM.A470DcVTot = THISFORM.Buf_W04642_470DcVTotSld
               THISFORM.A420DcVEnt = THISFORM.Buf_W04642_420DcVEntLgDo
