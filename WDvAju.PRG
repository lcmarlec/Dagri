            DO GX_CSC01
            IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W04643" , @HStmt_W04643 )
               Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WDVAJU","W04643","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W04643) ,  ,  ,  , CS_SQLSRV ,  )
