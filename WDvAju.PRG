               THISFORM.AV25Debe1 = 0
               THISFORM.AV24Haber = 0
               THISFORM.AV26Haber1 = THISFORM.A470DcVTot
            ENDIF
         ELSE
            IF THISFORM.A422DcVTip = "VALR"
               THISFORM.AV23Debe = THISFORM.A470DcVTot
               THISFORM.AV24Haber = 0
               THISFORM.AV25Debe1 = 0
               THISFORM.AV26Haber1 = 0
