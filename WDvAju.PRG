            ENDDO
            THISFORM.W04643 = Gx_err
            THISFORM.GX_DB_GetW04643_01 ()
            DO WHILE THISFORM.W04643 <> 101
               THISFORM.A858RCVNro = THISFORM.Buf_W04643_858RCVNroI
               THISFORM.A1198RCVNr = THISFORM.Buf_W04643_1198RCVNroCli
               THISFORM.A1468RCVOb = THISFORM.Buf_W04643_1468RCVObs
               THISFORM.AV29Opago = THISFORM.A1198RCVNr
