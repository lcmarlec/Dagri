      ***********************
      PROCEDURE U13V332
      ***********************

         LOCAL gx_old_event
         THISFORM.SetEvent( "LOAD" )
         * Load Routine
         DO GX_CSC01
         IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01113" , @HStmt_W01113 )
            Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODI5","W01113","",GX_CURSOR_TYPE_READONLY_FORFIRST,@HStmt_W01113) ,  ,  ,  , CS_SQLSRV ,  )
            cmdbuf = " SELECT [EmpCod], [EntCod], [EntGruTip], [EntRaz] FROM [ENTID] (NOLOCK) WHERE [EmpCod] "
            cmdbuf = cmdbuf + "  = ? and [EntGruTip] = 'PR' and [EntCod] = ? ORDER BY [EmpCod]  "
            THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01113,cmdbuf)
            THISFORM.GX_DB_BindColsW01113_01 ()
            THISFORM.GX_DB_BindParmW01113_01 ()
         ENDIF
         AuxA2EmpCod = THISFORM.A2EmpCod
         THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01113,1,@AuxA2EmpCod,0)
         THISFORM.A2EmpCod = AuxA2EmpCod
         AuxA773OprIFo = THISFORM.A773OprIFo
         THISFORM.Gx_err = GX_DB_SetLong( HStmt_W01113,2,@AuxA773OprIFo,0)
         THISFORM.A773OprIFo = AuxA773OprIFo
         Gx_eop = 1
         DO WHILE Gx_eop != 0
            Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01113) ,  ,  ,  , CS_SQLSRV ,  )
         ENDDO
         THISFORM.W01113 = Gx_err
         THISFORM.GX_DB_GetW01113_01 ()
         DO WHILE THISFORM.W01113 <> 101
            THISFORM.A120EntCod = THISFORM.Buf_W01113_120EntCod
            THISFORM.A150EntGru = THISFORM.Buf_W01113_150EntGruTip
            THISFORM.A153EntRaz = THISFORM.Buf_W01113_153EntRaz
            THISFORM.AV20Provee = THISFORM.A153EntRaz
            * Check if program is canceled.
            DO GX_RPTCW WITH "Cancela el programa (S/N)?" , "Programa cancelado por el usuario" , UserCancel
            IF UserCancel
               EXIT
            ENDIF
            * Exiting from a For First loop.
            EXIT
         ENDDO
         Gx_Err = Gx_odbc_mrc( GX_DB_SetClosable( HStmt_W01113) ,  ,  ,  , CS_SQLSRV ,  )
         IF THISFORM.cCW111S27 .GX_rec_loaded >= 10000
            DO GX_ERRMW WITH "Numero de lineas excedio el limite de 10000"
            GX_SFLOAD = 2
         ELSE
            THISFORM.cCW111S27 .GX_rec_loaded =  THISFORM.cCW111S27 .GX_rec_loaded + 1
            SELECT( THISFORM.cCW111S27 .GX_SfAlias)
            GX_SFLOAD = 1
            APPEND BLANK
            THISFORM.cCW111S27 .SaveTemp()
         ENDIF
         THISFORM.GX_in_event = .F.
         THISFORM.FormRefresh(.F., .F.)
         THISFORM.EndEvent()
      ENDPROC

