               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01112" , @HStmt_W01112 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WOPRODI5","W01112","",GX_CURSOR_TYPE_READONLY,@HStmt_W01112) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T3.[FamCod], T3.[FamSubCod], T3.[ArtCod], T1.[EmpCod], T1.[OPrFamCod], T1.[OprFamSubC], "
                  cmdbuf = cmdbuf + "  T1.[OprArtCod], T1.[OPrLot], T1.[OPrSLt], T1.[OprIFor1Pr], T1.[OprIForSN], T1.[OprILin], "
                  cmdbuf = cmdbuf + "  T4.[OPrRes] AS OPrRes, T1.[OpriLugCod], T1.[OprILotNro], T1.[OprICnt], T2.[ArtDsc] "
                  cmdbuf = cmdbuf + "  AS OprIArtDsc, T1.[OprIArtCod] AS OprIArtCod, T1.[OprIFamSub] AS OprIFamSub, T1.[OprIFamCod] "
                  cmdbuf = cmdbuf + "  AS OprIFamCod, T4.[OprPri], T5.[UsuNombre] AS OprResNom, T4.[OprHorIni], T4.[OPrForNro], "
                  cmdbuf = cmdbuf + "  T4.[OPrCnt], T3.[ArtDsc] FROM (((([OPRINS] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ARTICS] "
                  cmdbuf = cmdbuf + "  T2 (NOLOCK) ON T2.[EmpCod] = T1.[EmpCod] AND T2.[FamCod] = T1.[OprIFamCod] AND T2.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = T1.[OprIFamSub] AND T2.[ArtCod] = T1.[OprIArtCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[FamCod] = T1.[OPrFamCod] AND T3.[FamSubCod] "
                  cmdbuf = cmdbuf + "  = T1.[OprFamSubC] AND T3.[ArtCod] = T1.[OprArtCod]) LEFT JOIN [OPROD] T4 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T4.[EmpCod] = T1.[EmpCod] AND T4.[OPrFamCod] = T1.[OPrFamCod] AND T4.[OprFamSubC] "
                  cmdbuf = cmdbuf + "  = T1.[OprFamSubC] AND T4.[OprArtCod] = T1.[OprArtCod] AND T4.[OPrLot] = T1.[OPrLot] "
                  cmdbuf = cmdbuf + "  AND T4.[OPrSLt] = T1.[OPrSLt]) LEFT JOIN [USU002] T5 (NOLOCK) ON T5.[UsuCod] = T4.[OPrRes]) "
                  cmdbuf = cmdbuf + "  WHERE (T1.[EmpCod] = ? and T1.[OPrFamCod] = ? and T1.[OprFamSubC] = ? and T1.[OprArtCod] "
                  cmdbuf = cmdbuf + "  = ? and T1.[OPrLot] = ? and T1.[OPrSLt] = ?) AND (T1.[OprILin] <> 0) ORDER BY T1.[EmpCod], "
                  cmdbuf = cmdbuf + "  T1.[OPrFamCod], T1.[OprFamSubC], T1.[OprArtCod], T1.[OPrLot], T1.[OPrSLt], T1.[OprIFamCod], "
                  cmdbuf = cmdbuf + "  T1.[OprIFamSub], T1.[OprIArtCod], T1.[OprILin]  "
