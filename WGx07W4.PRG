               AuxA76BcoCta = THISFORM.A76BcoCta
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08192,2,@AuxA76BcoCta,0)
               THISFORM.A76BcoCta = AuxA76BcoCta
               AuxA2543SldEP = THISFORM.A2543SldEP
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08192,3,@AuxA2543SldEP,0)
               THISFORM.A2543SldEP = AuxA2543SldEP
               AuxA2544SldSe = THISFORM.A2544SldSe
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08192,4,@AuxA2544SldSe,0)
               THISFORM.A2544SldSe = AuxA2544SldSe
               AuxAV5C561 = THISFORM.AV5C561
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08192,5,@AuxAV5C561,0)
               THISFORM.AV5C561 = AuxAV5C561
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08192,6,PADR( TRIM(THISFORM.AV6C2545),4, '%'),LEN(PADR( TRIM(THISFORM.AV6C2545),4, '%')),0)
               AuxAV7C2546 = THISFORM.AV7C2546
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08192,7,@AuxAV7C2546,0)
               THISFORM.AV7C2546 = AuxAV7C2546
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08192 = Gx_err
               THISFORM.GX_DB_GetW08192_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08192 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08192) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08192 = Gx_err
                  THISFORM.GX_DB_GetW08192_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08192 <> 101
               BRKVMR2 = .F.
               THISFORM.A3440SldTp = THISFORM.Buf_W08192_3440SldTpoI
               THISFORM.A2546SldIm = THISFORM.Buf_W08192_2546SldImp
               THISFORM.A2545SldTp = THISFORM.Buf_W08192_2545SldTpo
               THISFORM.A561TraCod = THISFORM.Buf_W08192_561TraCod
               GX_SFLOAD = 0
               THISFORM.U12VMR2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08192) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08192 = Gx_err
               THISFORM.GX_DB_GetW08192_01 ()
            ENDDO
         ENDIF
      ENDPROC
