      PROCEDURE CreateTemp
         LOCAL SCW158S13
         SCW158S13 = ""
         IF USED( "SCW158S13" )
            SELECT SCW158S13
            SCW158S13 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW158S13
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "sA8ArtCprC"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA9ArtCprN"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA10ArtCpr"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 12
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA11ArtCpr"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 15
            GX_STRUCT[ 4 ,4]= 4

            IF '' <> GETE('z:\temp')
               SCW158S13 = GETE('z:\temp') + '\' + SCW158S13
            ENDIF
            CREATE DBF (SCW158S13) FROM ARRAY GX_STRUCT
            USE
            USE (SCW158S13) EXCLUSIVE ALIAS SCW158S13
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW158S13
         THIS.GX_SfAlias = "SCW158S13"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01582" , @HStmt_W01582 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WSKPRAR","W01582","",GX_CURSOR_TYPE_READONLY,@HStmt_W01582) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T1.[ArtCprGrT] AS ArtCprGrT, T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod], "
                  cmdbuf = cmdbuf + "  T3.[ArtDsc], T1.[ArtCprPrc], T1.[ArtCprArt], T2.[EntRaz] AS ArtCprNom, T1.[ArtCprCod] "
                  cmdbuf = cmdbuf + "  AS ArtCprCod FROM (([ARTICS1] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [ENTID] T2 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T2.[EmpCod] = T1.[EmpCod] AND T2.[EntGruTip] = T1.[ArtCprGrT] AND T2.[EntCod] "
                  cmdbuf = cmdbuf + "  = T1.[ArtCprCod]) LEFT JOIN [ARTICS] T3 (NOLOCK) ON T3.[EmpCod] = T1.[EmpCod] AND "
                  cmdbuf = cmdbuf + "  T3.[FamCod] = T1.[FamCod] AND T3.[FamSubCod] = T1.[FamSubCod] AND T3.[ArtCod] = "
                  cmdbuf = cmdbuf + "  T1.[ArtCod]) WHERE T1.[EmpCod] = ? and T1.[FamCod] = ? and T1.[FamSubCod] = ? and "
                  cmdbuf = cmdbuf + "  T1.[ArtCod] = ? ORDER BY T1.[EmpCod], T1.[FamCod], T1.[FamSubCod], T1.[ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01582,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01582,15)
                  THISFORM.GX_DB_BindColsW01582_01 ()
                  THISFORM.GX_DB_BindParmW01582_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01582,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01582,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01582,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01582,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01582 = Gx_err
               THISFORM.GX_DB_GetW01582_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV15Pgmnam = "WSKPrAr"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01582 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01582) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01582 = Gx_err
                  THISFORM.GX_DB_GetW01582_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01582 <> 101
               BRKV4E2 = .F.
               THISFORM.A7ArtCprGr = THISFORM.Buf_W01582_7ArtCprGrT
               THISFORM.A6ArtDsc = THISFORM.Buf_W01582_6ArtDsc
               THISFORM.A11ArtCprP = THISFORM.Buf_W01582_11ArtCprPrc
               THISFORM.A10ArtCprA = THISFORM.Buf_W01582_10ArtCprArt
               THISFORM.A9ArtCprNo = THISFORM.Buf_W01582_9ArtCprNom
               THISFORM.A8ArtCprCo = THISFORM.Buf_W01582_8ArtCprCod
               THISFORM.A9ArtCprNo = THISFORM.Buf_W01582_9ArtCprNom
               THISFORM.A6ArtDsc = THISFORM.Buf_W01582_6ArtDsc
               GX_SFLOAD = 0
               THISFORM.U15V4E2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01582) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01582 = Gx_err
               THISFORM.GX_DB_GetW01582_01 ()
            ENDDO
         ENDIF
      ENDPROC
