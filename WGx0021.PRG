      PROCEDURE CreateTemp
         LOCAL SCW168S20
         SCW168S20 = ""
         IF USED( "SCW168S20" )
            SELECT SCW168S20
            SCW168S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW168S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA3FamCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA4FamSubC"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 4
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA5ArtCod"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 4
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA17ArtNim"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA18ArtIva"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 1
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA28ArtVta"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 1
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW168S20 = GETE('z:\temp') + '\' + SCW168S20
            ENDIF
            CREATE DBF (SCW168S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW168S20) EXCLUSIVE ALIAS SCW168S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW168S20
         THIS.GX_SfAlias = "SCW168S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W01682" , @HStmt_W01682 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0021","W01682","",GX_CURSOR_TYPE_READONLY,@HStmt_W01682) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [ArtDsc], [ArtVta], [ArtIva], [ArtNim], [ArtCod], [FamSubCod], [FamCod] "
                  cmdbuf = cmdbuf + "  FROM [ARTICS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [FamCod] >= ? and [FamSubCod] "
                  cmdbuf = cmdbuf + "  >= ? and [ArtCod] >= ?) AND ([ArtDsc] like ?) AND ([ArtNim] like ?) AND ([ArtIva] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W01682,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W01682,9)
                  THISFORM.GX_DB_BindColsW01682_01 ()
                  THISFORM.GX_DB_BindParmW01682_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01682,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C3 = THISFORM.AV5C3
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01682,2,@AuxAV5C3,0)
               THISFORM.AV5C3 = AuxAV5C3
               AuxAV6C4 = THISFORM.AV6C4
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01682,3,@AuxAV6C4,0)
               THISFORM.AV6C4 = AuxAV6C4
               AuxAV7C5 = THISFORM.AV7C5
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01682,4,@AuxAV7C5,0)
               THISFORM.AV7C5 = AuxAV7C5
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01682,5,PADR( TRIM(THISFORM.AV8C6),50, '%'),LEN(PADR( TRIM(THISFORM.AV8C6),50, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W01682,6,PADR( TRIM(THISFORM.AV9C17),12, '%'),LEN(PADR( TRIM(THISFORM.AV9C17),12, '%')),0)
               AuxAV10C18 = THISFORM.AV10C18
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W01682,7,@AuxAV10C18,0)
               THISFORM.AV10C18 = AuxAV10C18
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W01682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01682 = Gx_err
               THISFORM.GX_DB_GetW01682_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W01682 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01682) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W01682 = Gx_err
                  THISFORM.GX_DB_GetW01682_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W01682 <> 101
               BRKV4O2 = .F.
               THISFORM.A6ArtDsc = THISFORM.Buf_W01682_6ArtDsc
               THISFORM.A28ArtVta = THISFORM.Buf_W01682_28ArtVta
               THISFORM.A18ArtIva = THISFORM.Buf_W01682_18ArtIva
               THISFORM.A17ArtNim = THISFORM.Buf_W01682_17ArtNim
               THISFORM.A5ArtCod = THISFORM.Buf_W01682_5ArtCod
               THISFORM.A4FamSubCo = THISFORM.Buf_W01682_4FamSubCod
               THISFORM.A3FamCod = THISFORM.Buf_W01682_3FamCod
               GX_SFLOAD = 0
               THISFORM.U12V4O2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W01682) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W01682 = Gx_err
               THISFORM.GX_DB_GetW01682_01 ()
            ENDDO
         ENDIF
      ENDPROC
