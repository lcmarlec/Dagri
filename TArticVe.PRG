         THISFORM.A8ArtCprCo = THISFORM.M8ArtCprCo
         THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .SaveTemp()
         THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
         Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
            Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .Refresh()
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.A7ArtCprGr = S7ArtCprGr
               THISFORM.A8ArtCprCo = S8ArtCprCo
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
            Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo .AND. S5ArtCod = THISFORM.A5ArtCod .AND. S7ArtCprGr = THISFORM.A7ArtCprGr
               Gx_fcond = Gx_fcond .AND. S8ArtCprCo = THISFORM.A8ArtCprCo
            ENDDO
            IF sf_err != 0
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .AppendRow()
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.A7ArtCprGr = S7ArtCprGr
               THISFORM.A8ArtCprCo = S8ArtCprCo
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A3FamCod = S3FamCod
         THISFORM.A4FamSubCo = S4FamSubCo
         THISFORM.A5ArtCod = S5ArtCod
         THISFORM.A7ArtCprGr = S7ArtCprGr
