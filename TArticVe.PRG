      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T035518" , @HStmt_T035518 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TARTICVE","T035518","",GX_CURSOR_TYPE_READONLY,@HStmt_T035518) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " SELECT [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCprGrT] AS ArtCprGrT, [ArtCprCod] "
                  cmdbuf = cmdbuf + "  AS ArtCprCod FROM [ARTICS1] (NOLOCK) WHERE [EmpCod] = ? AND [FamCod] = ? AND [FamSubCod] "
                  cmdbuf = cmdbuf + "  = ? AND [ArtCod] = ? ORDER BY [EmpCod], [FamCod], [FamSubCod], [ArtCod], [ArtCprGrT], "
                  cmdbuf = cmdbuf + "  [ArtCprCod]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T035518,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T035518,6)
                  THISFORM.GX_DB_BindColsT035518_01 ()
                  THISFORM.GX_DB_BindParmT035518_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T035518,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA3FamCod = THISFORM.A3FamCod
               Gx_err = GX_DB_SetInt( HStmt_T035518,2,@AuxA3FamCod,0)
               THISFORM.A3FamCod = AuxA3FamCod
               AuxA4FamSubCo = THISFORM.A4FamSubCo
               Gx_err = GX_DB_SetInt( HStmt_T035518,3,@AuxA4FamSubCo,0)
               THISFORM.A4FamSubCo = AuxA4FamSubCo
               AuxA5ArtCod = THISFORM.A5ArtCod
               Gx_err = GX_DB_SetInt( HStmt_T035518,4,@AuxA5ArtCod,0)
               THISFORM.A5ArtCod = AuxA5ArtCod
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T035518) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T035518 = Gx_err
               THISFORM.GX_DB_GetT035518_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T035518 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T035518) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T035518 = Gx_err
                  THISFORM.GX_DB_GetT035518_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T035518 <> 101
               BRK9V1 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT355Tb10.cCT355Pg85Tb10.cCT355S86.Columns(2).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T035518_2EmpCod = THISFORM.A2EmpCod .AND. THISFORM.Buf_T035518_5ArtCod = THISFORM.A5ArtCod .AND. THISFORM.Buf_T035518_4FamSubCod = THISFORM.A4FamSubCo .AND. THISFORM.Buf_T035518_3FamCod = THISFORM.A3FamCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T035518) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T035518 = Gx_err
               THISFORM.GX_DB_GetT035518_01 ()
            ENDDO
         ENDIF
      ENDPROC
