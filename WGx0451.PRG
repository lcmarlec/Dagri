      PROCEDURE CreateTemp
         LOCAL SCW1169S20
         SCW1169S20 = ""
         IF USED( "SCW1169S20" )
            SELECT SCW1169S20
            SCW1169S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW1169S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 6 , 4]

            GX_STRUCT[ 1 ,1]= "sA1306RINr"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 12
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1308RIFc"
            GX_STRUCT[ 2 ,2]= "D"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1309RITl"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 3
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1310RIEs"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 2
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA1312RILu"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 3
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "sA1318CRIC"
            GX_STRUCT[ 6 ,2]= "N"
            GX_STRUCT[ 6 ,3]= 3
            GX_STRUCT[ 6 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW1169S20 = GETE('z:\temp') + '\' + SCW1169S20
            ENDIF
            CREATE DBF (SCW1169S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW1169S20) EXCLUSIVE ALIAS SCW1169S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW1169S20
         THIS.GX_SfAlias = "SCW1169S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W11692" , @HStmt_W11692 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0451","W11692","",GX_CURSOR_TYPE_READONLY,@HStmt_W11692) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [RIObs], [CRICod], [RILugDde], [RIEst], [RITli], [RIFch], [RINroInt] "
                  cmdbuf = cmdbuf + "  FROM [REMINT] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [RINroInt] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([RIFch] >= ?) AND ([RITli] >= ?) AND ([RIEst] >= ?) AND ([RIObs] like ?) AND ([RILugDde] "
                  cmdbuf = cmdbuf + "  >= ?) ORDER BY [EmpCod], [RINroInt]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W11692,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W11692,9)
                  THISFORM.GX_DB_BindColsW11692_01 ()
                  THISFORM.GX_DB_BindParmW11692_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11692,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxAV5C1306 = THISFORM.AV5C1306
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W11692,2,@AuxAV5C1306,0)
               THISFORM.AV5C1306 = AuxAV5C1306
               AuxAV6C1308 = THISFORM.AV6C1308
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11692,3,@AuxAV6C1308,0)
               THISFORM.AV6C1308 = AuxAV6C1308
               AuxAV7C1309 = THISFORM.AV7C1309
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11692,4,@AuxAV7C1309,0)
               THISFORM.AV7C1309 = AuxAV7C1309
               AuxAV8C1310 = THISFORM.AV8C1310
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11692,5,@AuxAV8C1310,0)
               THISFORM.AV8C1310 = AuxAV8C1310
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11692,6,PADR( TRIM(THISFORM.AV9C1311),40, '%'),LEN(PADR( TRIM(THISFORM.AV9C1311),40, '%')),0)
               AuxAV10C1312 = THISFORM.AV10C1312
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11692,7,@AuxAV10C1312,0)
               THISFORM.AV10C1312 = AuxAV10C1312
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11692) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11692 = Gx_err
               THISFORM.GX_DB_GetW11692_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11692 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11692) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11692 = Gx_err
                  THISFORM.GX_DB_GetW11692_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11692 <> 101
               BRKVWH2 = .F.
               THISFORM.A1311RIObs = THISFORM.Buf_W11692_1311RIObs
               THISFORM.A1318CRICo = THISFORM.Buf_W11692_1318CRICod
               THISFORM.A1312RILug = THISFORM.Buf_W11692_1312RILugDde
               THISFORM.A1310RIEst = THISFORM.Buf_W11692_1310RIEst
               THISFORM.A1309RITli = THISFORM.Buf_W11692_1309RITli
               THISFORM.A1308RIFch = THISFORM.Buf_W11692_1308RIFch
               THISFORM.A1306RINro = THISFORM.Buf_W11692_1306RINroInt
               GX_SFLOAD = 0
               THISFORM.U12VWH2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11692) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11692 = Gx_err
               THISFORM.GX_DB_GetW11692_01 ()
            ENDDO
         ENDIF
      ENDPROC
