      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W09252" , @HStmt_W09252 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WHREQDOC","W09252","",GX_CURSOR_TYPE_READONLY,@HStmt_W09252) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT T2.[EntGruTip], T1.[EmpCod], T1.[DcCNroInt], T2.[DcCFec], T2.[DcCNro], T2.[DcCSuc], "
                  cmdbuf = cmdbuf + "  T2.[DccSer], T2.[DcCTip], T3.[EntRaz], T2.[EntCod], T1.[HdcDrObs], T1.[HdcDrFch], "
                  cmdbuf = cmdbuf + "  T1.[HdcDrUsu], T1.[HdcDrFH], T4.[DRDsc] AS DccDrDsc, T1.[dccDrcod] AS dccDrcod FROM "
                  cmdbuf = cmdbuf + "  ((([HDCOM5] T1 (FASTFIRSTROW NOLOCK) LEFT JOIN [DCCOM] T2 (NOLOCK) ON T2.[EmpCod] "
                  cmdbuf = cmdbuf + "  = T1.[EmpCod] AND T2.[DcCNroInt] = T1.[DcCNroInt]) LEFT JOIN [ENTID] T3 (NOLOCK) "
                  cmdbuf = cmdbuf + "  ON T3.[EmpCod] = T1.[EmpCod] AND T3.[EntGruTip] = T2.[EntGruTip] AND T3.[EntCod] "
                  cmdbuf = cmdbuf + "  = T2.[EntCod]) LEFT JOIN [DOCREQ] T4 (NOLOCK) ON T4.[DRCod] = T1.[dccDrcod]) WHERE "
                  cmdbuf = cmdbuf + "  (T1.[EmpCod] = ? and T1.[DcCNroInt] = ?) AND (T1.[dccDrcod] = ? or ? = 0) ORDER "
                  cmdbuf = cmdbuf + "  BY T1.[EmpCod], T1.[DcCNroInt], T1.[dccDrcod], T1.[HdcDrFH]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W09252,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W09252,14)
                  THISFORM.GX_DB_BindColsW09252_01 ()
                  THISFORM.GX_DB_BindParmW09252_01 ()
               ENDIF
               AuxAV8Emprcod = THISFORM.AV8Emprcod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09252,1,@AuxAV8Emprcod,0)
               THISFORM.AV8Emprcod = AuxAV8Emprcod
               AuxAV19Dccnro = THISFORM.AV19Dccnro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W09252,2,@AuxAV19Dccnro,0)
               THISFORM.AV19Dccnro = AuxAV19Dccnro
               AuxAV20Dccdrc = THISFORM.AV20Dccdrc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09252,3,@AuxAV20Dccdrc,0)
               THISFORM.AV20Dccdrc = AuxAV20Dccdrc
               AuxAV20Dccdrc = THISFORM.AV20Dccdrc
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W09252,4,@AuxAV20Dccdrc,0)
               THISFORM.AV20Dccdrc = AuxAV20Dccdrc
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W09252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09252 = Gx_err
               THISFORM.GX_DB_GetW09252_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV23Pgmnam = "WHReqDoc"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W09252 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09252) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W09252 = Gx_err
                  THISFORM.GX_DB_GetW09252_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W09252 <> 101
               BRKVPP2 = .F.
               THISFORM.A150EntGru = THISFORM.Buf_W09252_150EntGruTip
               THISFORM.A2EmpCod = THISFORM.Buf_W09252_2EmpCod
               THISFORM.A346DcCNro = THISFORM.Buf_W09252_346DcCNroInt
               THISFORM.A347DcCFec = THISFORM.Buf_W09252_347DcCFec
               THISFORM.A352DcCNro = THISFORM.Buf_W09252_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W09252_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W09252_349DccSer
               THISFORM.A348DcCTip = THISFORM.Buf_W09252_348DcCTip
               THISFORM.A153EntRaz = THISFORM.Buf_W09252_153EntRaz
               THISFORM.A120EntCod = THISFORM.Buf_W09252_120EntCod
               THISFORM.A2838HdcDr = THISFORM.Buf_W09252_2838HdcDrObs
               THISFORM.A2837HdcDr = THISFORM.Buf_W09252_2837HdcDrFch
               THISFORM.A2839HdcDr = THISFORM.Buf_W09252_2839HdcDrUsu
               THISFORM.A2836HdcDr = THISFORM.Buf_W09252_2836HdcDrFH
               THISFORM.A2833DccDr = THISFORM.Buf_W09252_2833DccDrDsc
               THISFORM.A2832dccDr = THISFORM.Buf_W09252_2832dccDrcod
               THISFORM.A150EntGru = THISFORM.Buf_W09252_150EntGruTip
               THISFORM.A347DcCFec = THISFORM.Buf_W09252_347DcCFec
               THISFORM.A352DcCNro = THISFORM.Buf_W09252_352DcCNro
               THISFORM.A350DcCSuc = THISFORM.Buf_W09252_350DcCSuc
               THISFORM.A349DccSer = THISFORM.Buf_W09252_349DccSer
               THISFORM.A348DcCTip = THISFORM.Buf_W09252_348DcCTip
               THISFORM.A120EntCod = THISFORM.Buf_W09252_120EntCod
               THISFORM.A153EntRaz = THISFORM.Buf_W09252_153EntRaz
               THISFORM.A2833DccDr = THISFORM.Buf_W09252_2833DccDrDsc
               GX_SFLOAD = 0
               THISFORM.U13VPP2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W09252) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W09252 = Gx_err
               THISFORM.GX_DB_GetW09252_01 ()
            ENDDO
         ENDIF
