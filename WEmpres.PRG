      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W00552" , @HStmt_W00552 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WEMPRES","W00552","",GX_CURSOR_TYPE_READONLY,@HStmt_W00552) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCui], [EmpNom], [EmpCod] FROM [EMPRES] (FASTFIRSTROW NOLOCK) ORDER BY "
                  cmdbuf = cmdbuf + "  [EmpCod]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W00552,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W00552,9)
                  THISFORM.GX_DB_BindColsW00552_01 ()
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W00552) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W00552 = Gx_err
               THISFORM.GX_DB_GetW00552_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.AV24Pgmnam = "WEmpres"
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W00552 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00552) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W00552 = Gx_err
                  THISFORM.GX_DB_GetW00552_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W00552 <> 101
               BRKV1J2 = .F.
               THISFORM.A576EmpCui = THISFORM.Buf_W00552_576EmpCui
               THISFORM.A68EmpNom = THISFORM.Buf_W00552_68EmpNom
               THISFORM.A2EmpCod = THISFORM.Buf_W00552_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U17V1J2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W00552) ,  ,  ,  , CS_SQLSRV ,  )
