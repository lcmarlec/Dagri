      PROCEDURE CreateTemp
         LOCAL SCW849S20
         SCW849S20 = ""
         IF USED( "SCW849S20" )
            SELECT SCW849S20
            SCW849S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW849S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2595R164"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 2
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2596R164"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 6
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2597R164"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 6
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA950RetNr"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW849S20 = GETE('z:\temp') + '\' + SCW849S20
            ENDIF
            CREATE DBF (SCW849S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW849S20) EXCLUSIVE ALIAS SCW849S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW849S20
         THIS.GX_SfAlias = "SCW849S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W08492" , @HStmt_W08492 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0860","W08492","",GX_CURSOR_TYPE_READONLY,@HStmt_W08492) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [RetNroI], [R164NroiIm], [RetNroLin], [R164Per], [R164EntCod], [R164EntGru], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [RET3164] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([R164EntGru] "
                  cmdbuf = cmdbuf + "  like ?) AND ([R164EntCod] >= ?) AND ([R164Per] >= ?) AND ([R164NroiIm] >= ?) AND "
                  cmdbuf = cmdbuf + "  ([RetNroI] >= ?) AND ([RetNroLin] >= ?) ORDER BY [EmpCod], [R164EntGru], [R164EntCod], "
                  cmdbuf = cmdbuf + "  [R164Per], [R164NroiIm]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W08492,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W08492,9)
                  THISFORM.GX_DB_BindColsW08492_01 ()
                  THISFORM.GX_DB_BindParmW08492_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08492,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W08492,2,PADR( TRIM(THISFORM.AV6C2595),2, '%'),LEN(PADR( TRIM(THISFORM.AV6C2595),2, '%')),0)
               AuxAV7C2596 = THISFORM.AV7C2596
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08492,3,@AuxAV7C2596,0)
               THISFORM.AV7C2596 = AuxAV7C2596
               AuxAV8C2597 = THISFORM.AV8C2597
               THISFORM.Gx_err = GX_DB_SetLong( HStmt_W08492,4,@AuxAV8C2597,0)
               THISFORM.AV8C2597 = AuxAV8C2597
               AuxAV9C2598 = THISFORM.AV9C2598
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08492,5,@AuxAV9C2598,0)
               THISFORM.AV9C2598 = AuxAV9C2598
               AuxAV10C937 = THISFORM.AV10C937
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W08492,6,@AuxAV10C937,0)
               THISFORM.AV10C937 = AuxAV10C937
               AuxAV11C950 = THISFORM.AV11C950
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W08492,7,@AuxAV11C950,0)
               THISFORM.AV11C950 = AuxAV11C950
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W08492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08492 = Gx_err
               THISFORM.GX_DB_GetW08492_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W08492 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08492) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W08492 = Gx_err
                  THISFORM.GX_DB_GetW08492_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W08492 <> 101
               BRKVNL2 = .F.
               THISFORM.A937RetNro = THISFORM.Buf_W08492_937RetNroI
               THISFORM.A2598R164N = THISFORM.Buf_W08492_2598R164NroiIm
               THISFORM.A950RetNro = THISFORM.Buf_W08492_950RetNroLin
               THISFORM.A2597R164P = THISFORM.Buf_W08492_2597R164Per
               THISFORM.A2596R164E = THISFORM.Buf_W08492_2596R164EntCod
               THISFORM.A2595R164E = THISFORM.Buf_W08492_2595R164EntGru
               THISFORM.A2EmpCod = THISFORM.Buf_W08492_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VNL2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W08492) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W08492 = Gx_err
               THISFORM.GX_DB_GetW08492_01 ()
            ENDDO
         ENDIF
      ENDPROC
