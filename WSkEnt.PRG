      PROCEDURE CreateTemp
         LOCAL SCW147S35
         SCW147S35 = ""
         IF USED( "SCW147S35" )
            SELECT SCW147S35
            SCW147S35 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW147S35
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 7 , 4]

            GX_STRUCT[ 1 ,1]= "VAV17Entco"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 6
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV31Entra"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 40
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV32Entcu"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 11
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV33Entte"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 40
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "VAV34Entfa"
            GX_STRUCT[ 5 ,2]= "C"
            GX_STRUCT[ 5 ,3]= 40
            GX_STRUCT[ 5 ,4]= 0

            GX_STRUCT[ 6 ,1]= "VAV26Entlo"
            GX_STRUCT[ 6 ,2]= "C"
            GX_STRUCT[ 6 ,3]= 40
            GX_STRUCT[ 6 ,4]= 0

            GX_STRUCT[ 7 ,1]= "VAV25Entin"
            GX_STRUCT[ 7 ,2]= "C"
            GX_STRUCT[ 7 ,3]= 40
            GX_STRUCT[ 7 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW147S35 = GETE('z:\temp') + '\' + SCW147S35
            ENDIF
            CREATE DBF (SCW147S35) FROM ARRAY GX_STRUCT
            USE
            USE (SCW147S35) EXCLUSIVE ALIAS SCW147S35
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW147S35
         THIS.GX_SfAlias = "SCW147S35"
      ENDPROC
