               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11322,3,PADR( TRIM(THISFORM.AV6C631),4, '%'),LEN(PADR( TRIM(THISFORM.AV6C631),4, '%')),0)
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W11322,4,PADR( TRIM(THISFORM.AV7C633),4, '%'),LEN(PADR( TRIM(THISFORM.AV7C633),4, '%')),0)
               AuxAV8C3324 = THISFORM.AV8C3324
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11322,5,@AuxAV8C3324,0)
               THISFORM.AV8C3324 = AuxAV8C3324
               AuxAV9C3325 = THISFORM.AV9C3325
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W11322,6,@AuxAV9C3325,0)
               THISFORM.AV9C3325 = AuxAV9C3325
               AuxAV10C3326 = THISFORM.AV10C3326
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W11322,7,@AuxAV10C3326,0)
               THISFORM.AV10C3326 = AuxAV10C3326
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W11322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11322 = Gx_err
               THISFORM.GX_DB_GetW11322_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W11322 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11322) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W11322 = Gx_err
                  THISFORM.GX_DB_GetW11322_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W11322 <> 101
               BRKVVG2 = .F.
               THISFORM.A3325PciEx = THISFORM.Buf_W11322_3325PciExD
               THISFORM.A3324PciEx = THISFORM.Buf_W11322_3324PciExFH
               THISFORM.A3326PciEx = THISFORM.Buf_W11322_3326PciExeP
               THISFORM.A633PciCod = THISFORM.Buf_W11322_633PciCod
               THISFORM.A631PaiCod = THISFORM.Buf_W11322_631PaiCod
               THISFORM.A166EntCui = THISFORM.Buf_W11322_166EntCui
               GX_SFLOAD = 0
               THISFORM.U12VVG2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W11322) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W11322 = Gx_err
               THISFORM.GX_DB_GetW11322_01 ()
            ENDDO
         ENDIF
      ENDPROC
