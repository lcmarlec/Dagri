      PROCEDURE FormDelete
         LOCAL Gx_open
         IF THISFORM.Gx_Mode = "DSP"
            RETURN
         ENDIF
         Gx_open = .F.
         DO CASE
            CASE THISFORM.GX_Curr_Level = 20
               IF THISFORM.GX_Mode = "INS"
                  THISFORM. cCT23A236 .SetFocus()
                  RETURN
               ENDIF
               DO CASE
                  CASE THISFORM.GX_Curr_Level = 20
                     THISFORM.SaveMode( "DLT" ,"")
               ENDCASE
               IF THISFORM.Amode
                  AuxA236AVCodA = THISFORM.A236AVCodA
                  Gx_err = GX_DB_SetLong( HStmt_T00233,1,@AuxA236AVCodA,0)
                  THISFORM.A236AVCodA = AuxA236AVCodA
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T00233) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T00233 = Gx_err
                  THISFORM.GX_DB_GetT00233_01 ()
                  THISFORM. cCT23A236 . ZM0N20 ( 0 )
               ENDIF
               Response = .F.
               THISFORM. DC0N20 ()
               THISFORM. cCT23A236 . ZM0N20 ( 0 )
               DO GX_CONFW WITH "Realmente desea eliminar estos datos? " , Response
               Gx_ucfrm  = .T.
               IF .NOT. Response
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0N20 ()
                  RETURN
               ENDIF
               IF ! THISFORM. cCT23A242 .CheckTables()
                  RETURN .F.
               ENDIF
               IF .not. THISFORM. DE0N20 ()
                  THISFORM.SaveMode( "UPD" ,"")
                  THISFORM. DC0N20 ()
                  RETURN
               ENDIF
               THISFORM.cCT23A236.UpdObj('DLT')
               THISFORM.FormRefresh( .F. , .T. )
               THISFORM.GX_after_trn = 1
               THISFORM.GX_atrn_mode = THISFORM.GX_mode
               IF THISFORM.GX_after_trn != 0
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00233) , "TDBAR000" )
                  Gx_odbc_rc( GX_DB_StmtClose( HStmt_T00232) , "TDBAR000" )
                  IF TYPE( "HConn_Default" ) = "N"
                     IF GXCONNECTED
                        Gx_Err = Gx_odbc_mrc( GX_DB_ConnCommit(HConn_Default) ,  ,  ,  , CS_SQLSRV , 0 )
                     ENDIF
                  ENDIF
                  THISFORM. cCT23A242 .AfterTrn()
                  IF THISFORM.GX_Exit_GotFocus
                     THISFORM.LockScreen = .F.
                     RETURN
                  ENDIF
                  THISFORM.GX_after_trn = 0
               ENDIF
               THISFORM.LoadObj(2)
               THISFORM.FormRefresh( .F. , .T. )
               IF THISFORM.AMode
                  THISFORM. cCT23A236 .SetFocus()
               ENDIF
               THISFORM.SetMode("EOF", "1" )
         ENDCASE
      ENDPROC

