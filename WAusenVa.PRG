      PROCEDURE CreateTemp
         LOCAL SCW843S21
         SCW843S21 = ""
         IF USED( "SCW843S21" )
            SELECT SCW843S21
            SCW843S21 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW843S21
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 4 , 4]

            GX_STRUCT[ 1 ,1]= "VAV38Fecha"
            GX_STRUCT[ 1 ,2]= "D"
            GX_STRUCT[ 1 ,3]= 8
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "VAV39Ok"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 1
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "VAV43Cauds"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 50
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "VAV46Auste"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 1
            GX_STRUCT[ 4 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW843S21 = GETE('z:\temp') + '\' + SCW843S21
            ENDIF
            CREATE DBF (SCW843S21) FROM ARRAY GX_STRUCT
            USE
            USE (SCW843S21) EXCLUSIVE ALIAS SCW843S21
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW843S21
         THIS.GX_SfAlias = "SCW843S21"
