                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TTBLOFE","T01877","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T01877) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [OFEGRP] ([EmpCod], [FamCod], [FamSubCod], [ArtCod], [OfeFDe], [EntLgGrpOf], "
                  cmdbuf = cmdbuf + "  [EntGruTip], [EntCod]) VALUES (?, ?, ?, ?, ?, ?, ?, ?) "
