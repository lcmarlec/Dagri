      PROCEDURE CreateTemp
         LOCAL SCW305S20
         SCW305S20 = ""
         IF USED( "SCW305S20" )
            SELECT SCW305S20
            SCW305S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW305S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA1068DcCc"
            GX_STRUCT[ 1 ,2]= "C"
            GX_STRUCT[ 1 ,3]= 1
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA1069dccc"
            GX_STRUCT[ 2 ,2]= "N"
            GX_STRUCT[ 2 ,3]= 3
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA1070dccc"
            GX_STRUCT[ 3 ,2]= "N"
            GX_STRUCT[ 3 ,3]= 10
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA1072dccC"
            GX_STRUCT[ 4 ,2]= "N"
            GX_STRUCT[ 4 ,3]= 12
            GX_STRUCT[ 4 ,4]= 2

            GX_STRUCT[ 5 ,1]= "sA1073dccC"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 12
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW305S20 = GETE('z:\temp') + '\' + SCW305S20
            ENDIF
            CREATE DBF (SCW305S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW305S20) EXCLUSIVE ALIAS SCW305S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW305S20
         THIS.GX_SfAlias = "SCW305S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W03052" , @HStmt_W03052 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX0372","W03052","",GX_CURSOR_TYPE_READONLY,@HStmt_W03052) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [EmpCod], [DcCNroInt], [dccchObs], [dccChNroI], [dccChImp], [dccchNro], [dccchCta], "
                  cmdbuf = cmdbuf + "  [DcCchTip] FROM [DCCOM4] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] = ? and [DcCNroInt] "
                  cmdbuf = cmdbuf + "  = ?) AND ([DcCchTip] like ?) AND ([dccchCta] >= ?) AND ([dccchNro] >= ?) AND ([dccchObs] "
                  cmdbuf = cmdbuf + "  like ?) AND ([dccChImp] >= ?) ORDER BY [EmpCod], [DcCNroInt], [DcCchTip], [dccchCta], "
                  cmdbuf = cmdbuf + "  [dccchNro]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W03052,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W03052,9)
                  THISFORM.GX_DB_BindColsW03052_01 ()
                  THISFORM.GX_DB_BindParmW03052_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03052,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03052,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03052,3,PADR( TRIM(THISFORM.AV5C1068),1, '%'),LEN(PADR( TRIM(THISFORM.AV5C1068),1, '%')),0)
               AuxAV6C1069 = THISFORM.AV6C1069
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W03052,4,@AuxAV6C1069,0)
               THISFORM.AV6C1069 = AuxAV6C1069
               AuxAV7C1070 = THISFORM.AV7C1070
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03052,5,@AuxAV7C1070,0)
               THISFORM.AV7C1070 = AuxAV7C1070
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W03052,6,PADR( TRIM(THISFORM.AV8C1071),30, '%'),LEN(PADR( TRIM(THISFORM.AV8C1071),30, '%')),0)
               AuxAV9C1072 = THISFORM.AV9C1072
               THISFORM.Gx_err = GX_DB_SetDouble( HStmt_W03052,7,@AuxAV9C1072,0)
               THISFORM.AV9C1072 = AuxAV9C1072
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W03052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03052 = Gx_err
               THISFORM.GX_DB_GetW03052_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W03052 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03052) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W03052 = Gx_err
                  THISFORM.GX_DB_GetW03052_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W03052 <> 101
               BRKV8H2 = .F.
               THISFORM.A1071dccch = THISFORM.Buf_W03052_1071dccchObs
               THISFORM.A1073dccCh = THISFORM.Buf_W03052_1073dccChNroI
               THISFORM.A1072dccCh = THISFORM.Buf_W03052_1072dccChImp
               THISFORM.A1070dccch = THISFORM.Buf_W03052_1070dccchNro
               THISFORM.A1069dccch = THISFORM.Buf_W03052_1069dccchCta
               THISFORM.A1068DcCch = THISFORM.Buf_W03052_1068DcCchTip
               GX_SFLOAD = 0
               THISFORM.U12V8H2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W03052) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W03052 = Gx_err
               THISFORM.GX_DB_GetW03052_01 ()
            ENDDO
         ENDIF
      ENDPROC
