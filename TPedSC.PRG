      FUNCTION SF_GOTO()
         LOCAL sf_err, GX_fcond, gxO_Area, gx_ORec
         gxO_Area = SELECT()
         sf_err = 0
         LOCAL S2EmpCod
         LOCAL S795PedFch
         LOCAL S797PedGru
         LOCAL S798PedEnt
         LOCAL S802PedSuc
         LOCAL S809PedSec
         LOCAL S1060PedIn
         LOCAL S3FamCod
         LOCAL S4FamSubCo
         LOCAL S5ArtCod
         S2EmpCod = THISFORM.A2EmpCod
         S795PedFch = THISFORM.A795PedFch
         S797PedGru = THISFORM.A797PedGru
         S798PedEnt = THISFORM.A798PedEnt
         S802PedSuc = THISFORM.A802PedSuc
         S809PedSec = THISFORM.A809PedSec
         S1060PedIn = THISFORM.A1060PedIn
         S3FamCod = THISFORM.A3FamCod
         S4FamSubCo = THISFORM.A4FamSubCo
         S5ArtCod = THISFORM.A5ArtCod
         THISFORM.A1060PedIn = THISFORM.M1060PedIn
         THISFORM.A3FamCod = THISFORM.M3FamCod
         THISFORM.A4FamSubCo = THISFORM.M4FamSubCo
         THISFORM.A5ArtCod = THISFORM.M5ArtCod
         THISFORM. cCT192S26 .SaveTemp()
         THISFORM. cCT192S26 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT192S26 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT192S26 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT192S26 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S795PedFch = THISFORM.A795PedFch .AND. S797PedGru = THISFORM.A797PedGru .AND. S798PedEnt = THISFORM.A798PedEnt .AND. S802PedSuc = THISFORM.A802PedSuc
         Gx_fcond = Gx_fcond .AND. S809PedSec = THISFORM.A809PedSec .AND. S1060PedIn = THISFORM.A1060PedIn .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
         Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT192S26 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT192S26 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S795PedFch = THISFORM.A795PedFch .AND. S797PedGru = THISFORM.A797PedGru .AND. S798PedEnt = THISFORM.A798PedEnt .AND. S802PedSuc = THISFORM.A802PedSuc
            Gx_fcond = Gx_fcond .AND. S809PedSec = THISFORM.A809PedSec .AND. S1060PedIn = THISFORM.A1060PedIn .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
            Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT192S26 .Refresh()
               THISFORM. cCT192S26 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A795PedFch = S795PedFch
               THISFORM.A797PedGru = S797PedGru
               THISFORM.A798PedEnt = S798PedEnt
               THISFORM.A802PedSuc = S802PedSuc
               THISFORM.A809PedSec = S809PedSec
               THISFORM.A1060PedIn = S1060PedIn
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT192S26 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT192S26 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S795PedFch = THISFORM.A795PedFch .AND. S797PedGru = THISFORM.A797PedGru .AND. S798PedEnt = THISFORM.A798PedEnt .AND. S802PedSuc = THISFORM.A802PedSuc
            Gx_fcond = Gx_fcond .AND. S809PedSec = THISFORM.A809PedSec .AND. S1060PedIn = THISFORM.A1060PedIn .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
            Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
            DO WHILE sf_err = 0 .and. !GX_fcond
               THISFORM. cCT192S26 .LoadRec(2, @sf_err)
               Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S795PedFch = THISFORM.A795PedFch .AND. S797PedGru = THISFORM.A797PedGru .AND. S798PedEnt = THISFORM.A798PedEnt .AND. S802PedSuc = THISFORM.A802PedSuc
               Gx_fcond = Gx_fcond .AND. S809PedSec = THISFORM.A809PedSec .AND. S1060PedIn = THISFORM.A1060PedIn .AND. S3FamCod = THISFORM.A3FamCod .AND. S4FamSubCo = THISFORM.A4FamSubCo
               Gx_fcond = Gx_fcond .AND. S5ArtCod = THISFORM.A5ArtCod
            ENDDO
            IF sf_err != 0
               THISFORM. cCT192S26 .AppendRow()
               THISFORM. cCT192S26 .GX_all_loaded = .T.
            ENDIF
            IF GX_fcond
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A795PedFch = S795PedFch
               THISFORM.A797PedGru = S797PedGru
               THISFORM.A798PedEnt = S798PedEnt
               THISFORM.A802PedSuc = S802PedSuc
               THISFORM.A809PedSec = S809PedSec
               THISFORM.A1060PedIn = S1060PedIn
               THISFORM.A3FamCod = S3FamCod
               THISFORM.A4FamSubCo = S4FamSubCo
               THISFORM.A5ArtCod = S5ArtCod
               RETURN .T.
            ENDIF
         ENDIF
         THISFORM.A2EmpCod = S2EmpCod
         THISFORM.A795PedFch = S795PedFch
         THISFORM.A797PedGru = S797PedGru
         THISFORM.A798PedEnt = S798PedEnt
         THISFORM.A802PedSuc = S802PedSuc
         THISFORM.A809PedSec = S809PedSec
         THISFORM.A1060PedIn = S1060PedIn
         THISFORM.A3FamCod = S3FamCod
         THISFORM.A4FamSubCo = S4FamSubCo
         THISFORM.A5ArtCod = S5ArtCod
         RETURN .F.
      ENDFUNC
