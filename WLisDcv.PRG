         ENDIF
         DO CASE
            CASE THISFORM.AV15Hasfch < THISFORM.AV14Desfch .OR. THISFORM.AV24Trans > THISFORM.AV14Desfch
               THISFORM.SaveTblPos()
               DO Werrores WITH "Rango de Fecha Inválido " , "R"
               GX_rploop = .T.
            CASE THISFORM.AV13Haspro < THISFORM.AV12Despro
               THISFORM.SaveTblPos()
               DO Werrores WITH "Rango de Clientes Inválido " , "R"
               GX_rploop = .T.
            CASE THISFORM.AV17Hasnro < THISFORM.AV16Desnro
               THISFORM.SaveTblPos()
               DO Werrores WITH "Rango de Número Inválido " , "R"
               GX_rploop = .T.
            OTHERWISE
               IF THISFORM.AV25Todos = "S"
                  THISFORM.AV26I = 0
                  DO WHILE THISFORM.AV26I < 16
                     THISFORM.AV26I = THISFORM.AV26I + 1
                     THISFORM.AV21Tipo[THISFORM.AV26I] = "S"
                  ENDDO
               ENDIF
               IF THISFORM.AV12Despro <> THISFORM.AV13Haspro .OR. THISFORM.AV13Haspro = 0
                  THISFORM.AV27Suc = 0
               ENDIF
               DO CASE
                  CASE THISFORM.AV20Estado = 9
                     THISFORM.SaveTblPos()
                     Aux0 = THISFORM.AV8Emprcod
                     Aux1 = THISFORM.AV7Fechasi
                     Aux2 = THISFORM.AV9Usuario
                     Aux3 = THISFORM.AV14Desfch
                     Aux4 = THISFORM.AV15Hasfch
                     Aux5 = THISFORM.AV16Desnro
                     Aux6 = THISFORM.AV17Hasnro
                     Aux7 = THISFORM.AV12Despro
                     Aux8 = THISFORM.AV18Desraz
                     Aux9 = THISFORM.AV13Haspro
                     Aux10 = THISFORM.AV19Hasraz
                     Aux11 = THISFORM.AV20Estado
                     Aux12 = THISFORM.AV27Suc
                     DIMENSION Aux13[16]
                     =ACOPY( THISFORM.AV21Tipo , Aux13 )
                     Aux14 = THISFORM.AV22Sucurs
                     Aux15 = THISFORM.AV29Vdrcod
                     Aux16 = THISFORM.AV24Trans
                     Aux17 = THISFORM.AV34Entcui
                     Aux18 = THISFORM.AV35Civcod
                     Aux19 = THISFORM.AV36Prvcod
                     Aux20 = THISFORM.Gxarchivo
                     Aux21 = THISFORM.AV38Cateiv
                     Aux22 = THISFORM.AV39Serie
