      PROCEDURE Load
         SET TALK OFF
         THISFORM.AddProps
         IF TYPE("GX_DSID") == "N"
            IF GX_DSID >= 0
               THISFORM.DataSessionId = GX_DSID
            ENDIF
         ENDIF
         SET SAFETY OFF
         SET BELL OFF
         SET REPROCESS TO 1
         IF SET("DATE") != "BRITISH"
            SET DATE BRITISH
         ENDIF
         SET EXACT ON
         SET CONFIRM ON
         DO GX_YrLmt WITH 19, 40
         IF SET("HOURS") != 24
            SET HOURS TO 24
         ENDIF
         SET READBORDER OFF
         IF SET("POINT") != "."
            SET POINT TO "."
            SET SEPARATOR TO ","
         ENDIF
         DO GX_DSSet
         THISFORM. AV8Emprcod = PAV8Emprcod
         THISFORM. AV7Fechasi = PAV7Fechasi
         THISFORM. AV9Usuario = PAV9Usuario
         THISFORM. AV31Vvdrco = PAV31Vvdrco
      ENDPROC
