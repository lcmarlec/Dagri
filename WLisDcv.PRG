      PROCEDURE NextInStructure
         LPARAMETER gx_FLvl
         DO CASE
            CASE gx_FLvl = 2
               gx_FLvlO = 7
            CASE gx_FLvl = 7
               gx_FLvlO = 1
            CASE gx_FLvl = 6
               gx_FLvlO = 5
            CASE gx_FLvl = 5
               gx_FLvlO = 4
            CASE gx_FLvl = 4
               gx_FLvlO = 3
            CASE gx_FLvl = 3
               gx_FLvlO = 2
