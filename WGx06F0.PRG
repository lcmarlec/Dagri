      PROCEDURE CreateTemp
         LOCAL SCW675S20
         SCW675S20 = ""
         IF USED( "SCW675S20" )
            SELECT SCW675S20
            SCW675S20 = DBF()
         ELSE
            * Create SubFile
            DO GX_SFNM WITH SCW675S20
            SELECT 0
            PRIVATE GX_STRUCT
            DIMENSION GX_STRUCT[ 5 , 4]

            GX_STRUCT[ 1 ,1]= "sA2EmpCod"
            GX_STRUCT[ 1 ,2]= "N"
            GX_STRUCT[ 1 ,3]= 4
            GX_STRUCT[ 1 ,4]= 0

            GX_STRUCT[ 2 ,1]= "sA2035HCam"
            GX_STRUCT[ 2 ,2]= "C"
            GX_STRUCT[ 2 ,3]= 8
            GX_STRUCT[ 2 ,4]= 0

            GX_STRUCT[ 3 ,1]= "sA2036HCam"
            GX_STRUCT[ 3 ,2]= "C"
            GX_STRUCT[ 3 ,3]= 19
            GX_STRUCT[ 3 ,4]= 0

            GX_STRUCT[ 4 ,1]= "sA2037HCam"
            GX_STRUCT[ 4 ,2]= "C"
            GX_STRUCT[ 4 ,3]= 30
            GX_STRUCT[ 4 ,4]= 0

            GX_STRUCT[ 5 ,1]= "sA2048HCam"
            GX_STRUCT[ 5 ,2]= "N"
            GX_STRUCT[ 5 ,3]= 4
            GX_STRUCT[ 5 ,4]= 0

            IF '' <> GETE('z:\temp')
               SCW675S20 = GETE('z:\temp') + '\' + SCW675S20
            ENDIF
            CREATE DBF (SCW675S20) FROM ARRAY GX_STRUCT
            USE
            USE (SCW675S20) EXCLUSIVE ALIAS SCW675S20
         ENDIF
         SET DELETE ON
         THIS.GX_SfName = SCW675S20
         THIS.GX_SfAlias = "SCW675S20"
      ENDPROC
      PROCEDURE LoadRec(Gx_CuOper, Gx_CuErr)
         PRIVATE Gx_SfLoad
         Gx_SfLoad = 0
         Gx_CuErr = 0
         DO CASE
            CASE GX_CUOPER = 1
               * First Record
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "W06752" , @HStmt_W06752 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"WGX06F0","W06752","",GX_CURSOR_TYPE_READONLY,@HStmt_W06752) ,  ,  ,  , CS_SQLSRV ,  )
                  cmdbuf = " SELECT [HCamVTV], [HCamHab], [HCamSeg], [HCamAnio], [HCamDsc], [HCamFch], [HCamPat], "
                  cmdbuf = cmdbuf + "  [EmpCod] FROM [CAMHIS] (FASTFIRSTROW NOLOCK) WHERE ([EmpCod] >= ?) AND ([HCamPat] "
                  cmdbuf = cmdbuf + "  like ?) AND ([HCamFch] >= ?) AND ([HCamDsc] like ?) AND ([HCamVTV] >= ?) AND ([HCamHab] "
                  cmdbuf = cmdbuf + "  >= ?) AND ([HCamSeg] >= ?) ORDER BY [EmpCod], [HCamPat], [HCamFch]  "
                  THISFORM.Gx_err = GX_DB_Set_StmtCmdText( HStmt_W06752,cmdbuf)
                  THISFORM.Gx_err = GX_DB_Set_StmtFetchSize( HStmt_W06752,9)
                  THISFORM.GX_DB_BindColsW06752_01 ()
                  THISFORM.GX_DB_BindParmW06752_01 ()
               ENDIF
               AuxAV5C2 = THISFORM.AV5C2
               THISFORM.Gx_err = GX_DB_SetInt( HStmt_W06752,1,@AuxAV5C2,0)
               THISFORM.AV5C2 = AuxAV5C2
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06752,2,PADR( TRIM(THISFORM.AV6C2035),8, '%'),LEN(PADR( TRIM(THISFORM.AV6C2035),8, '%')),0)
               AuxAV7C2036 = THISFORM.AV7C2036
               THISFORM.Gx_err = GX_DB_SetDateTime( HStmt_W06752,3,@AuxAV7C2036,0)
               THISFORM.AV7C2036 = AuxAV7C2036
               THISFORM.Gx_err = GX_DB_SetStr( HStmt_W06752,4,PADR( TRIM(THISFORM.AV8C2037),30, '%'),LEN(PADR( TRIM(THISFORM.AV8C2037),30, '%')),0)
               AuxAV9C2038 = THISFORM.AV9C2038
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06752,5,@AuxAV9C2038,0)
               THISFORM.AV9C2038 = AuxAV9C2038
               AuxAV10C2039 = THISFORM.AV10C2039
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06752,6,@AuxAV10C2039,0)
               THISFORM.AV10C2039 = AuxAV10C2039
               AuxAV11C2040 = THISFORM.AV11C2040
               THISFORM.Gx_err = GX_DB_SetDate( HStmt_W06752,7,@AuxAV11C2040,0)
               THISFORM.AV11C2040 = AuxAV11C2040
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_W06752) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06752 = Gx_err
               THISFORM.GX_DB_GetW06752_01 ()
               THIS.GX_CUPOS = 0
               THISFORM.Gx_err = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.W06752 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06752) ,  ,  ,  , CS_SQLSRV ,  )
                  ENDDO
                  THISFORM.W06752 = Gx_err
                  THISFORM.GX_DB_GetW06752_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.W06752 <> 101
               BRKVIR2 = .F.
               THISFORM.A2038HCamV = THISFORM.Buf_W06752_2038HCamVTV
               THISFORM.A2039HCamH = THISFORM.Buf_W06752_2039HCamHab
               THISFORM.A2040HCamS = THISFORM.Buf_W06752_2040HCamSeg
               THISFORM.A2048HCamA = THISFORM.Buf_W06752_2048HCamAnio
               THISFORM.A2037HCamD = THISFORM.Buf_W06752_2037HCamDsc
               THISFORM.A2036HCamF = THISFORM.Buf_W06752_2036HCamFch
               THISFORM.A2035HCamP = THISFORM.Buf_W06752_2035HCamPat
               THISFORM.A2EmpCod = THISFORM.Buf_W06752_2EmpCod
               GX_SFLOAD = 0
               THISFORM.U12VIR2 ()
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_W06752) ,  ,  ,  , CS_SQLSRV ,  )
               ENDDO
               THISFORM.W06752 = Gx_err
               THISFORM.GX_DB_GetW06752_01 ()
            ENDDO
         ENDIF
      ENDPROC
