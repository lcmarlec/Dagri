                  cmdbuf = cmdbuf + "  [DCCOM2] (NOLOCK) WHERE [EmpCod] = ? AND [DcCNroInt] = ? AND [DcCRORNroI] = ? ORDER "
                  cmdbuf = cmdbuf + "  BY [EmpCod], [DcCNroInt], [DcCRORNroI], [DcCRORLin]  "
                  Gx_err = GX_DB_Set_StmtCmdText( HStmt_T021216,cmdbuf)
                  Gx_err = GX_DB_Set_StmtFetchSize( HStmt_T021216,9)
                  THISFORM.GX_DB_BindColsT021216_01 ()
                  THISFORM.GX_DB_BindParmT021216_01 ()
               ENDIF
               AuxA2EmpCod = THISFORM.A2EmpCod
               Gx_err = GX_DB_SetInt( HStmt_T021216,1,@AuxA2EmpCod,0)
               THISFORM.A2EmpCod = AuxA2EmpCod
               AuxA346DcCNro = THISFORM.A346DcCNro
               Gx_err = GX_DB_SetDouble( HStmt_T021216,2,@AuxA346DcCNro,0)
               THISFORM.A346DcCNro = AuxA346DcCNro
               AuxA354DcCROR = THISFORM.A354DcCROR
               Gx_err = GX_DB_SetDouble( HStmt_T021216,3,@AuxA354DcCROR,0)
               THISFORM.A354DcCROR = AuxA354DcCROR
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T021216) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T021216 = Gx_err
               THISFORM.GX_DB_GetT021216_01 ()
               THIS.GX_CUPOS = 0
            CASE GX_CUOPER = 2
               * Next Record
               IF THISFORM.T021216 = 101
                  GX_CUERR = 100
               ELSE
                  Gx_eop = 1
                  DO WHILE Gx_eop != 0
                     Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T021216) ,  ,  ,  , CS_SQLSRV , 0 )
                  ENDDO
                  THISFORM.T021216 = Gx_err
                  THISFORM.GX_DB_GetT021216_01 ()
               ENDIF
         ENDCASE
         IF GX_CUERR = 0
            * Loop Forward until the first record to meet the criteria is found
            GX_CUERR = 100
            DO WHILE THISFORM.T021216 <> 101
               BRK5W35 = .F.
               THISFORM.GX_Refresh = 0
               THIS.LoadFromTbl()
               THISFORM.Gx_Refresh_grid_Att = .F.
               THISFORM. cCT212S2.Columns(1).Ctrl1 .LoadObj(2)
               THISFORM.Gx_Refresh_grid_Att = .T.
               THISFORM.GX_Refresh = 1
               IF THISFORM.Buf_T021216_346DcCNroInt = THISFORM.A346DcCNro .AND. THISFORM.Buf_T021216_2EmpCod = THISFORM.A2EmpCod
                  SELECT (THIS.GX_SFAlias)
                  GX_SFLoad = 1
                  APPEND BLANK
                  THIS.SaveTemp()
               ELSE
                  GX_SFLOAD = 0
               ENDIF
               THIS.GX_CUPOS = 0
               DO CASE
                  CASE GX_SFLOAD = 1
                     GX_CUERR = 0
                     EXIT
                  CASE GX_SFLOAD = 2
                     GX_CUERR = 100
                     EXIT
               ENDCASE
               IF UserCancel
                  EXIT
               ENDIF
               Gx_eop = 1
               DO WHILE Gx_eop != 0
                  Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchNext( HStmt_T021216) ,  ,  ,  , CS_SQLSRV , 0 )
               ENDDO
               THISFORM.T021216 = Gx_err
               THISFORM.GX_DB_GetT021216_01 ()
            ENDDO
         ENDIF
      ENDPROC
      PROCEDURE LoadFromTbl
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A359DcCROR"
            THISFORM.A359DcCROR = THISFORM.Buf_T021216_359DcCRORLin
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A364DcCObs"
            THISFORM.A364DcCObs = THISFORM.Buf_T021216_364DcCObsLin
         ENDIF
         IF THISFORM.GX_CF_Load_Enabled .or. THISFORM.GX_cursor != "THISFORM.A363DcCPrc"
            THISFORM.A363DcCPrc = THISFORM.Buf_T021216_363DcCPrc
         ENDIF
      ENDPROC
      PROCEDURE SaveTemp
         SELECT (THIS.GX_SfAlias)
         REPLACE sA364DcCOb WITH THISFORM.A364DcCObs
         REPLACE sA363DcCPr WITH THISFORM.A363DcCPrc
         REPLACE sA359DcCRO WITH THISFORM.A359DcCROR
