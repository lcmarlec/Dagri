         S359DcCROR = THISFORM.A359DcCROR
         THISFORM. cCT212S2 .SaveTemp()
         THISFORM. cCT212S2 .Refresh()
         * Search in Sub-File
         SELECT (THISFORM. cCT212S2 .GX_SfAlias)
         gx_ORec = RECNO()
         THISFORM.LockScreen = .T.
         THISFORM. cCT212S2 .SF( 8, @sf_err)     && GO TOP
         THISFORM. cCT212S2 .SF( 3, @sf_err)     && Read
         Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
         DO WHILE !GX_fcond .and. sf_err = 0
            THISFORM. cCT212S2 .SF( 9, @sf_err)     && SKIP
            IF sf_err = 0
               THISFORM. cCT212S2 .SF( 3, @sf_err)     && Read
            ENDIF
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
         ENDDO
         THISFORM.LockScreen = .f.
         IF GX_fcond					&& If found -> OK
            IF gx_ORec <> RECNO()
               THISFORM. cCT212S2 .Refresh()
               THISFORM. cCT212S2 .AfterRowColChange1()
               THISFORM.A2EmpCod = S2EmpCod
               THISFORM.A346DcCNro = S346DcCNro
               THISFORM.A354DcCROR = S354DcCROR
               THISFORM.A359DcCROR = S359DcCROR
               THISFORM.SaveMode( "UPD" ,"")
            ENDIF
            RETURN .T.
         ENDIF
         IF ! THISFORM. cCT212S2 .GX_all_loaded  && If aready loaded -> Not found
            * Search in file
            THISFORM. cCT212S2 .LoadRec(2, @sf_err)
            Gx_fcond = S2EmpCod = THISFORM.A2EmpCod .AND. S346DcCNro = THISFORM.A346DcCNro .AND. S354DcCROR = THISFORM.A354DcCROR .AND. S359DcCROR = THISFORM.A359DcCROR
