      FUNCTION CheckTables()
         LOCAL Gx_longc
         Gx_longc = .F.
         IF THISFORM.Gx_mode <> "INS"
            AuxA2EmpCod = THISFORM.A2EmpCod
            Gx_err = GX_DB_SetInt( HStmt_T02126,1,@AuxA2EmpCod,0)
            THISFORM.A2EmpCod = AuxA2EmpCod
            AuxA346DcCNro = THISFORM.A346DcCNro
            Gx_err = GX_DB_SetDouble( HStmt_T02126,2,@AuxA346DcCNro,0)
            THISFORM.A346DcCNro = AuxA346DcCNro
            Gx_eop = 1
            DO WHILE Gx_eop != 0
               Gx_Err = Gx_odbc_mrc( GX_DB_StmtFetchFirst( HStmt_T02126) ,  ,  ,  , CS_SQLSRV , 0 )
            ENDDO
            THISFORM.T02126 = Gx_err
            THISFORM.GX_DB_GetT02126_01 ()
            IF .NOT. THISFORM.T02126 <> 103
               DO GX_ERRMW WITH "DCCOM reservado por otro"
               RETURN .F.
            ENDIF
            Gx_longc = .F.
            IF THISFORM.T02126 = 101 .OR. THISFORM.Z347DcCFec <> THISFORM.Buf_T02126_347DcCFec
               Gx_longc = .T.
            ENDIF
            IF Gx_longc .OR. THISFORM.Z350DcCSuc <> THISFORM.Buf_T02126_350DcCSuc
               DO GX_ERRMW WITH "DCCOM fue modificada."
               RETURN .F.
            ENDIF
         ENDIF
         RETURN .T.
      ENDFUNC

      ***********************
      PROCEDURE WriteToTbl(Gx_Mode)
      ***********************


         DO CASE
            CASE Gx_mode = "INS"
               DO GX_CSC01
               IF .NOT. GX_DB_StmtIsDef( HConn_Default , "T021210" , @HStmt_T021210 )
                  Gx_Err = Gx_odbc_mrc( GX_DB_Declare_StmtEx( HConn_Default,"TDCCOBM","T021210","",GX_CURSOR_TYPE_FORUPDATE,@HStmt_T021210) ,  ,  ,  , CS_SQLSRV , 0 )
                  cmdbuf = " INSERT INTO [DCCOM] ([EmpCod], [DcCNroInt], [DcCFec], [EntCod], [EntGruTip], [DcCTip], "
                  cmdbuf = cmdbuf + "  [DccSer], [DcCSuc], [DcCNro], [DcCNroCtr], [DccGruCod], [DcCNet], [DcCTot], [DcCFV], "
                  cmdbuf = cmdbuf + "  [DcCEst], [DcCCtaCte], [DcCNetSld], [DcCTotSld], [DccFCo], [DccSig], [DcCCaiFv], "
                  cmdbuf = cmdbuf + "  [DccArtTot], [DccArtPen], [DccTipRed], [DccObs], [DccMesDde], [DccAniDDe], [DccMesHta], "
                  cmdbuf = cmdbuf + "  [DccAniHta], [DCCUsu], [DccCuoNro], [DccCuoAni], [DccCuoId], [DccAba], [DccEsp], "
                  cmdbuf = cmdbuf + "  [DccProtPen], [DCCTipCai], [DccNetOri], [DccCotiz], [DcCFecOri], [DccMoncod], [DccTotOri], "
                  cmdbuf = cmdbuf + "  [DccReqPen], [DccReqOk], [DccNroPro], [DccOrFal], [DccOrFch], [DccENI], [DccCaeAU], "
                  cmdbuf = cmdbuf + "  [DccCaeAF], [DCCImp], [DccCaeNro], [DccCaeVto], [DccCaeRta], [DccLeye], [DCCFchOfi]) "
                  cmdbuf = cmdbuf + "  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ' ', convert(int, 0), convert(int, 0), convert( "
